


translate japanese plot9_927be25d:


    npc40 "あら？金先生？どうされたんですか？"


translate japanese plot9_d6f21693:


    voice "voice/jinlaoshi_93.ogg"
    jinlaoshi "백 선생님, 학생을 찾으러 왔습니다."


translate japanese plot9_f8d4cdf9:


    voice "voice/tianqin_1993.ogg"
    tianqin "(체육 선생님……?)"


translate japanese plot9_5a96a737:


    "체육 교사가 갑자기 시험장에 나타나자, 라이라는 가슴이 철렁했다."


translate japanese plot9_b58115ab:


    "감독 교사와 체육 교사는 함께 응시생 명단을 뒤적이며, 도착한 학생들과 하나씩 대조했다."


translate japanese plot9_b776e680:


    voice "voice/npc40_05.ogg"
    npc40 "말씀하신 학생은……16번이네요."


translate japanese plot9_66236a28:


    voice "voice/npc40_06.ogg"
    npc40 "문 쪽 자리인데, 아무도 없네요?"


translate japanese plot9_1942e1df:


    voice "voice/jinlaoshi_94.ogg"
    jinlaoshi "아……그렇군요. 감사합니다, 백 선생님."


translate japanese plot9_ae8438ed:


    voice "voice/jinlaoshi_95.ogg"
    jinlaoshi "다른 데서 찾아보겠습니다."


translate japanese plot9_891aa398:


    voice "voice/jinlaoshi_96.ogg"
    jinlaoshi "으음……"


translate japanese plot9_5de8887f:


    voice "voice/tianqin_1994.ogg"
    tianqin "김 선생님——!"


translate japanese plot9_d751c45d:


    voice "voice/jinlaoshi_97.ogg"
    jinlaoshi "아, 어? 라이라?"


translate japanese plot9_23bf81e5:


    tianqin "誰か捜してるみたいですけど、何かあったんですか？"


translate japanese plot9_83cd6dda:


    voice "voice/jinlaoshi_98.ogg"
    jinlaoshi "응. 오늘 체육 특기생 종합시험이잖니? 학교 버스도 곧 체육 센터로 출발할 거야."


translate japanese plot9_631f0ccc:


    voice "voice/jinlaoshi_99.ogg"
    jinlaoshi "그런데 너희 반 체육 특기생이 아무도 안 왔어."


translate japanese plot9_aa4811a4:


    voice "voice/tianqin_1996.ogg"
    tianqin "응?"


translate japanese plot9_3ef69793:


    voice "voice/jinlaoshi_100.ogg"
    jinlaoshi "아키, 츠루기, 민영, 희진. 전부 없어."


translate japanese plot9_a8a3ebb7:


    voice "voice/jinlaoshi_101.ogg"
    jinlaoshi "연락이 안 갔나 싶었는데, 오늘은 월례 시험이라 시험장에 있을지도 모른다고 생각해서 찾아왔어."


translate japanese plot9_243b6cb5:


    voice "voice/jinlaoshi_102.ogg"
    jinlaoshi "그런데 시험장에도 없으니, 어디로 갔는지 모르겠구나."


translate japanese plot9_cc1be6e1:


    jinlaoshi "あの子たちの連絡先を知ってる？連絡がつくか試してみてくれない？"


translate japanese plot9_8d522c19:


    voice "voice/tianqin_1997.ogg"
    tianqin "전화해 볼게요."


translate japanese plot9_ec1faea5:


    "뚜……뚜……뚜……"


translate japanese plot9_165f180e:


    voice "voice/phone_01.ogg"
    "「전화를 받지 않습니다. 잠시 후 다시 걸어 주십시오……」"


translate japanese plot9_dab91118:


    voice "voice/tianqin_1998.ogg"
    tianqin "안 돼요. 안 받아요."


translate japanese plot9_92df5bbe:


    voice "voice/jinlaoshi_104.ogg"
    jinlaoshi "그렇구나…"


translate japanese plot9_4ea5ee3d:


    voice "voice/jinlaoshi_105.ogg"
    jinlaoshi "대체 어디 간 거야. 이렇게 중요한 날에."


translate japanese plot9_dafd5576:


    voice "voice/tianqin_1999.ogg"
    tianqin "잊었을 리는 없을 것 같아요. 며칠 전에 반장이 이번 체육 특기생 종합시험을 정말 중요하게 여긴다고 했거든요."


translate japanese plot9_df8d10ff:


    voice "voice/jinlaoshi_106.ogg"
    jinlaoshi "휴, 어쩔 수 없지. 난 먼저 돌아가서 인솔해야겠어."


translate japanese plot9_8a07241d:


    voice "voice/jinlaoshi_107.ogg"
    jinlaoshi "다른 선생님께 찾아봐 달라고 할 테니, 넌 교실로 돌아가 시험 준비하렴."


translate japanese plot9_3d696cac:


    voice "voice/tianqin_2000.ogg"
    tianqin "네……"


translate japanese plot9_8a73254b:


    "띠링——"


translate japanese plot9_294e9fa9:


    voice "voice/tianqin_2001.ogg"
    tianqin "(아, 반장한테 답장 왔나?)"


translate japanese plot9_7d6d80b7:


    voice "voice/tianqin_2002.ogg"
    tianqin "(어? 시노스한테서……)"


translate japanese plot9_18ac1927:


    "휴대폰 화면에 시노스가 방금 보낸 메시지가 떠 있었다."


translate japanese plot9_831b2777:


    voice "voice/cygnus_1119.ogg"
    cygnus 0101 "라이라."


translate japanese plot9_30652d3f:


    voice "voice/cygnus_1120.ogg"
    cygnus 0101 "중앙 공원 쪽에서 강한 마력의 파동이 느껴져."


translate japanese plot9_19745abd:


    voice "voice/cygnus_1121.ogg"
    cygnus 0104 "뭔가가 거목을 활성화했거나, 내 마도구가 나타난 걸지도 몰라."


translate japanese plot9_0099363a:


    voice "voice/cygnus_1122.ogg"
    cygnus 0104 "그쪽 상황을 보러 갈게."


translate japanese plot9_2c030ee8:


    voice "voice/cygnus_1123.ogg"
    cygnus "……이 정도면 됐나."


translate japanese plot9_96318fd9:


    "시노스는 베란다에서 거목 쪽을 바라보았다. 그곳에서 대단히 강한 마력의 파동이 느껴졌다. 예언이 맞아떨어진 듯했다."


translate japanese plot9_31c00f01:


    "집을 나서기 전, 시노스는 중앙 공원에 무슨 일이 일어났는지 보러 간다는 메시지를 라이라에게 보내기로 했다."


translate japanese plot9_95006945:


    voice "voice/blackcat_16.ogg"
    blackcat "냐하하. 결국 그 인간의 도움을 받는 거잖아."


translate japanese plot9_576c8ded:


    voice "voice/cygnus_1124.ogg"
    cygnus "입 다물어. 도와달라는 게 아니라, 지금 상황을 알려 준 것뿐이야."


translate japanese plot9_6b786eb6:


    voice "voice/blackcat_05.ogg"
    blackcat "냐~? 저 파동 좀 봐. 지금 네가 감당할 수 있겠어?"


translate japanese plot9_869609b1:


    voice "voice/blackcat_24.ogg"
    blackcat "방금 얻은 힘까지 합쳐도, 네 마력 수준을 훨씬 뛰어넘는 규모잖아."


translate japanese plot9_ade64e25:


    voice "voice/cygnus_1125.ogg"
    cygnus "그렇더라도……어떻게든 해결할 거야."


translate japanese plot9_667a6949:


    voice "voice/blackcat_15.ogg"
    blackcat "크크크, 정말 해결할 방법이 있기를 바라지."


translate japanese plot9_ede0d56e:


    voice "voice/cygnus_1126.ogg"
    cygnus "됐어. 쓸데없는 말 그만하고, 나가자."


translate japanese plot9_d433595e:


    voice "voice/cygnus_1127.ogg"
    cygnus "밖에서는 절대 모습을 드러내지 마."


translate japanese plot9_969cb53b:


    voice "voice/blackcat_04.ogg"
    blackcat "알았어."


translate japanese plot9_4e6cf176:


    voice "voice/cygnus_1128.ogg"
    cygnus "(중앙 공원은……저쪽이지.)"


translate japanese plot9_afe6e22f:


    voice "voice/tianqin_2003.ogg"
    tianqin "아사요!"


translate japanese plot9_5b2625df:


    voice "voice/cygnus_1129.ogg"
    cygnus "라이라?! 네가 왜 여기 있어?"


translate japanese plot9_fe83f986:


    tianqin "家から中央公園へ行くなら、ここを通ると思って待ってたの。"


translate japanese plot9_af5bcc4c:


    voice "voice/cygnus_1130.ogg"
    cygnus "오늘 시험 아니야?"


translate japanese plot9_403351f9:


    voice "voice/tianqin_2005.ogg"
    tianqin "그런 건 중요하지 않아!"


translate japanese plot9_8ef85be9:


    voice "voice/tianqin_2006.ogg"
    tianqin "지금 아주 불길한 예감이 들어."


translate japanese plot9_fd13ac88:


    voice "voice/cygnus_1131.ogg"
    cygnus "안 좋은 예감?"


translate japanese plot9_a34e89d4:


    voice "voice/tianqin_2007.ogg"
    tianqin "걸어가면서 얘기할게."


translate japanese plot9_7bf8425c:


    voice "voice/cygnus_1132.ogg"
    cygnus "그러니까 마도구와 관련된 학생들이 전부 사라졌다고?"


translate japanese plot9_8e12909a:


    voice "voice/tianqin_2008.ogg"
    tianqin "응."


translate japanese plot9_07d469a0:


    voice "voice/cygnus_1133.ogg"
    cygnus "몸이 안 좋아서 집에서 쉬는 건 아닐까?"


translate japanese plot9_3833b104:


    tianqin "全員揃って休むなんてありえないよ。今日はみんなにとって、すごく大事な日なのに…"


translate japanese plot9_e6d37fb3:


    "쾅——"


translate japanese plot9_d7fd51ae:


    "라이라의 말이 끝나자마자, 멀지 않은 중앙 공원에서 갑자기 굉음이 울렸다."


translate japanese plot9_ba0f8562:


    voice "voice/npc12_03.ogg"
    npc12 "으아아아!? 무슨 일이야?"


translate japanese plot9_2233f1ba:


    voice "voice/npc13_03.ogg"
    npc13 "지, 지진이야?"


translate japanese plot9_eedb93bb:


    "굉음과 함께 땅이 거세게 흔들렸다. 사람들은 놀라 소리를 지르며 바닥에 주저앉았다."


translate japanese plot9_240edb7d:


    voice "voice/tianqin_2010.ogg"
    tianqin "우왓! 왜 이러지?"


translate japanese plot9_fac2c34d:


    voice "voice/cygnus_1134.ogg"
    cygnus "중앙 공원 쪽에서……"


translate japanese plot9_f33784cf:


    "쿠웅——!" with Shake((0, 0, 0, 0), 0.5, dist=20)


translate japanese plot9_57405622:


    "중앙 공원 안에서 다시 굉음이 울렸다."


translate japanese plot9_ad648d85:


    "갑작스러운 이변에 주변 관광객들이 혼란에 빠졌다."


translate japanese plot9_d4ca797d:


    voice "voice/npc12_04.ogg"
    npc12 "이, 이게 무슨 일이야!?"


translate japanese plot9_aae8dcb6:


    voice "voice/npc13_04.ogg"
    npc13 "테, 테러야!?"


translate japanese plot9_596b8c20:


    voice "voice/npc12_05.ogg"
    npc12 "틀림없이 테러야!"


translate japanese plot9_ea3c7b93:


    "굉음과 진동 탓에, 사람들은 중앙 공원 안에서 폭발이 일어났다고 생각했다."


translate japanese plot9_93301450:


    voice "voice/npc12_06.ogg"
    npc12 "으아아아아——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot9_eea85647:


    "첫 비명이 방아쇠가 되어 「공포」라는 시한폭탄이 터졌다. 다음 순간 그것은 사람들 사이로 단숨에 퍼져 나갔다."


translate japanese plot9_4b30f686:


    voice "voice/npc13_05.ogg"
    npc13 "도망쳐——!"


translate japanese plot9_f3b9bc03:


    "무슨 일이 일어났는지 몰라도, 사람들은 본능에 이끌려 사방으로 흩어졌다."


translate japanese plot9_e4de2063:


    "모두 자기 몸을 지키려고 온 힘을 다해 달렸다. 남들보다 한 발짝이라도 늦을까 두려워하면서."


translate japanese plot9_ef356402:


    voice "voice/tianqin_2011.ogg"
    tianqin "대체 무슨 일이야?"


translate japanese plot9_9cc0193d:


    voice "voice/cygnus_1135.ogg"
    cygnus "대규모 마법 술식이 가동된 것 같아."


translate japanese plot9_f86fc8ca:


    voice "voice/cygnus_1136.ogg"
    cygnus "큰일이네."


translate japanese plot9_7801f885:


    voice "voice/tianqin_2012.ogg"
    tianqin "뭐가 큰일인데?"


translate japanese plot9_9ebed6bb:


    voice "voice/cygnus_1137.ogg"
    cygnus "「{a=dictionary:dict_entry_89}마나 충격{/a}」이 온다."


translate japanese plot9_cd7c6a43:


    voice "voice/tianqin_2013.ogg"
    tianqin "어?"


translate japanese plot9_956e33d8:


    "시노스가 설명할 틈도 없이, 그 「충격」이 찾아왔다."


translate japanese plot9_495a0fb4:


    "흩어져 달아나던 사람들이 갑자기 무더기로 길가에 쓰러지기 시작했다."


translate japanese plot9_028b56de:


    "아무 전조도 없이 의식이 뽑혀 나간 것처럼, 모두 그대로 기절했다."


translate japanese plot9_c86c41fb:


    voice "voice/cygnus_1138.ogg"
    cygnus "라이라!"


translate japanese plot9_4f127ac9:


    voice "voice/tianqin_2014.ogg"
    tianqin "어어!? 이번엔 또 왜 이래?"


translate japanese plot9_f00fce10:


    voice "voice/tianqin_2015.ogg"
    tianqin "왜 갑자기 다들 쓰러지는 거야!?"


translate japanese plot9_142ad3db:


    voice "voice/cygnus_1139.ogg"
    cygnus "너……괜찮아?"


translate japanese plot9_c8df5cb8:


    voice "voice/tianqin_2016.ogg"
    tianqin "어? 나도 쓰러졌어야 해?"


translate japanese plot9_295d87cd:


    "시노스는 라이라도 사람들처럼 쓰러질 거라고 생각했다. 하지만 그녀는 자신처럼 의식을 유지하고 있었다."


translate japanese plot9_2f95da4f:


    voice "voice/cygnus_1140.ogg"
    cygnus "설마 신경까지 보통 사람보다 몇 배는 질긴 건가……"


translate japanese plot9_32df08c6:


    tianqin "だから、何が起きたの！？"


translate japanese plot9_938527f2:


    voice "voice/cygnus_1141.ogg"
    cygnus "마법을 쓸 때는 소모된 마력 일부가 다시 마나로 바뀌어 대기로 돌아가."


translate japanese plot9_eb640489:


    voice "voice/cygnus_1142.ogg"
    cygnus "방금 가동된 대규모 술식이 바꿔 낸 마나의 양은 엄청났어."


translate japanese plot9_35e7f6d5:


    voice "voice/cygnus_1143.ogg"
    cygnus "마법이 완성되는 순간, 변환된 마나가 폭발의 충격파처럼 사방으로 빠르게 퍼진 거야."


translate japanese plot9_4fcb0ec7:


    cygnus "この世界の人間は、そんな量のマナに触れたことがない。だからすぐ「マナ酔い」を起こした。"


translate japanese plot9_5fe0eea6:


    voice "voice/tianqin_2018.ogg"
    tianqin "아! 마나 멀미라면 지난번에 말했던 그거……"


translate japanese plot9_6844199a:


    voice "voice/tianqin_2019.ogg"
    tianqin "……뭐였더라?"


translate japanese plot9_092a386c:


    voice "voice/cygnus_1145.ogg"
    cygnus "마나 때문에 생기는 실신이라고 생각해."


translate japanese plot9_99fe8af4:


    voice "voice/tianqin_2020.ogg"
    tianqin "그럼 어떻게 해야 깨어나게 할 수 있어?"


translate japanese plot9_456a085a:


    voice "voice/cygnus_1146.ogg"
    cygnus "그냥 두면 돼. 몸에 남은 마나가 대기로 돌아가면 곧 깨어날 거야."


translate japanese plot9_fe52a260:


    voice "voice/tianqin_2021.ogg"
    tianqin "휴……다행이다……"


translate japanese plot9_44f62bef:


    "거리에 있던 사람들은 모두 의식을 잃었다."


translate japanese plot9_c6cb057b:


    "달아나던 관광객, 길에서 미처 반응하지 못한 행인, 차 안의 운전자까지……주변에서 깨어 있는 사람은 시노스와 라이라뿐이었다."


translate japanese plot9_9a3dfdf9:


    voice "voice/tianqin_2022.ogg"
    tianqin "아침 정체 시간이라 다행이야. 아니었으면 큰 사고가 났을지도 몰라."


translate japanese plot9_aa55a92a:


    voice "voice/cygnus_1147.ogg"
    cygnus "적어도 이제 우리 앞을 막는 사람은 없네."


translate japanese plot9_7af00ba2:


    voice "voice/tianqin_2023.ogg"
    tianqin "응. 얼른 공원에 가서 무슨 일인지 보자."


translate japanese plot9_e47e74ac:


    nvlNone "공원에 들어가 익숙한 동작으로 바리케이드를 넘어,\n거목의 뿌리 위로 올라갔다."


translate japanese plot9_a0d69b89:


    nvlNone "뿌리를 따라 나아간다. 굉음이 난 곳까지 이제 곧 도착한다." (**end_page())


translate japanese plot9_e0cf18f9:


    nvl clear
    nvlNone "바로 거목 아래……" (**end_page())


translate japanese plot9_71e08e60:


    nvl clear
    voice "voice/tianqin_2024.ogg"
    nvl_tianqin_dialogue "…" (**end_page())


translate japanese plot9_3ef69793_1:


    nvl_teacher "아키, 츠루기, 민영, 희진. 전부 없어." (**end_page())


translate japanese plot9_5f53340e:


    nvlNone "체육 선생님에게 소식을 들었을 때부터 불길한 예감이 들었다."


translate japanese plot9_24a57c8e:


    nvlNone "반장……그리고 츠루기 일행이 모두 학교에 오지 않았다." (**end_page())


translate japanese plot9_1b8a9f2b:


    "体育生総合テストの結果は、これからの進学にも関わる。よほどの理由がない限り、休むはずがない。"


translate japanese plot9_c8b6e9e1:


    nvlNone "더 불안한 건 그 애들이 동시에 빠졌다는 점이었다." (**end_page())


translate japanese plot9_2cd28511:


    nvl clear
    nvlNone "그렇다면 가장 가능성 높은 상황은……" (**end_page())


translate japanese plot9_71e08e60_1:


    nvl clear
    voice "voice/tianqin_2025.ogg"
    nvl_tianqin_dialogue "…" (**end_page())


translate japanese plot9_9e49fd87:


    voice "voice/cygnus_1148.ogg"
    nvl_cygnus "라이라?"


translate japanese plot9_ca43c9e3:


    voice "voice/tianqin_2026.ogg"
    nvl_tianqin_dialogue "어?" (**end_page())


translate japanese plot9_844db18c:


    nvl clear
    voice "voice/cygnus_1149.ogg"
    nvl_cygnus "발걸음이 느려졌어."


translate japanese plot9_f9d892ea:


    voice "voice/tianqin_2027.ogg"
    nvl_tianqin_dialogue "어? 그래?" (**end_page())


translate japanese plot9_09abc93b:


    nvl clear
    voice "voice/cygnus_1150.ogg"
    nvl_cygnus "왜 그래? 안색이 이상해."


translate japanese plot9_ff2b9845:


    voice "voice/tianqin_2028.ogg"
    nvl_tianqin_dialogue "아니야, 나는…" (**end_page())


translate japanese plot9_ebd915f3:


    nvl clear
    voice "voice/tianqin_2029.ogg"
    nvl_tianqin_dialogue "……반장이랑 츠루기 애들이 걱정돼. 대체 무슨 일이 생긴 건지……"


translate japanese plot9_f13db893:


    voice "voice/tianqin_2030.ogg"
    nvl_tianqin_dialogue "메시지를 봤을 때, 그 애들이 시노스가 말한 일에 관련된 건 아닐까 생각했어." (**end_page())


translate japanese plot9_44fb88c9:


    nvl clear
    voice "voice/tianqin_2031.ogg"
    nvl_tianqin_dialogue "아주 안 좋은 예감이 들어……"


translate japanese plot9_3b7b6ce4:


    voice "voice/cygnus_1151.ogg"
    nvl_cygnus "그렇다면 더 빨리 움직여야 해." (**end_page())


translate japanese plot9_17d81a0a:


    nvl clear
    voice "voice/cygnus_1152.ogg"
    nvl_cygnus "지금 그 애들을 도울 가능성이 가장 큰 건 너와 나야."


translate japanese plot9_80e67b48:


    voice "voice/tianqin_2032.ogg"
    nvl_tianqin_dialogue "……응, 네 말이 맞아." (**end_page())


translate japanese plot9_a776be74:


    nvl clear
    voice "voice/tianqin_2033.ogg"
    nvl_tianqin_dialogue "더 꾸물거릴 수는 없지. 가자." (**end_page())


translate japanese plot9_99ef3251:


    nvlNone "시노스의 말은 모두 이해했다." (**end_page())


translate japanese plot9_f1c26692:


    nvl clear
    nvlNone "반장 일행은 학교에 가지 않고, 여기 중앙 공원에 있다."


translate japanese plot9_283bdb93:


    nvlNone "확실한 증거는 없지만……직감이 그렇게 말하고 있었다." (**end_page())


translate japanese plot9_0c9302b8:


    "私の勘はいつもよく当たる――きっと、この嫌な予感も。"


translate japanese plot9_aeca104d:


    nvlNone "아주 잠깐 떠오른 생각이\n어느새 마음속을 가득 채우고 있었다." (**end_page())


translate japanese plot9_31bb6622:


    nvl clear
    nvlNone "지금 내 기분을 정확하게 알고 있었다."


translate japanese plot9_765409b6:


    nvlNone "——나는 두려웠다. 도망치고 싶었다." (**end_page())


translate japanese plot9_f3236798:


    nvl clear
    nvlNone "생각했던 일이 현실이 될까 봐 두려워서\n불길한 상상으로부터 도망치고 싶었다." (**end_page())


translate japanese plot9_52bbb537:


    cygnus "바로 앞이야."


translate japanese plot9_9f81d5de:


    voice "voice/tianqin_2034.ogg"
    tianqin "그래."


translate japanese plot9_24b1c616:


    nvlNone "시노스가 앞을 가리켰다. 여러 나무뿌리가 서로 뒤엉켜 움푹 파인 공간을 이룬 곳이었다."


translate japanese plot9_43782128:


    nvlNone "外側の根は高く盛り上がり、近くまで行かなければ中はまるで見えない。"


translate japanese plot9_be9aa209:


    nvlNone "――人目を遮るには、これ以上ない場所だった。"


translate japanese plot9_d41d8cd9:


    voice "voice/jinlaoshi_108.ogg"


translate japanese plot9_crown_browse_dismissible_f5510fcd:


    voice "voice/tianqin_2035.ogg"
    tianqin "바……반장?"


translate japanese plot9_crown_browse_dismissible_5666b734:


    voice "voice/banzhang_373.ogg"
    banzhang2 "어머, 라이라 씨. 역시 와 주셨네요."


translate japanese plot9_crown_browse_dismissible_e322529d:


    voice "voice/banzhang_374.ogg"
    banzhang2 "옆에 있는 분은……"


translate japanese plot9_crown_browse_dismissible_126ed705:


    voice "voice/cygnus_1154.ogg"
    cygnus "크윽――!"


translate japanese plot9_crown_browse_dismissible_e5b71b52:


    "눈이 마주쳤을 뿐인데 강렬한 악의가 시노스에게 밀려왔다."


translate japanese plot9_crown_browse_dismissible_c9eeef65:


    "——【저쪽 세계｜에세리아】에서 다른 마녀와 마주쳤을 때와 같은 느낌이었다."


translate japanese plot9_crown_browse_dismissible_3aac465d:


    voice "voice/banzhang_375.ogg"
    banzhang2 "그렇군요……당신이 원래 주인이시군요?"


translate japanese plot9_crown_browse_dismissible_8903fcb3:


    "부서진 왕관이 더러운 빛을 반사했다. 눈앞의 모든 것을 더럽히려는 것 같았다."


translate japanese plot9_crown_browse_dismissible_274b77f3:


    "바로 이 왕관이 그녀에게 상식을 뛰어넘는 힘을 주었다."


translate japanese plot9_crown_browse_dismissible_59e3f716:


    voice "voice/cygnus_1155.ogg"
    cygnus "저 왕관이 내 마도구인가……"


translate japanese plot9_crown_browse_dismissible_cd5ed9c8:


    "시노스는 왕관에 응축된 막대한 마력을 느꼈다. 지금의 자신보다도 강한 마력일 것 같았다."


translate japanese plot9_60b1132b:


    banzhang2 "ごめんなさい。勝手にお借りしてしまって。"


translate japanese plot9_crown_browse_dismissible_daa2b22e:


    voice "voice/banzhang_377.ogg"
    banzhang2 "곧 돌려드릴게요."


translate japanese plot9_crown_browse_dismissible_4404c0f1:


    voice "voice/banzhang_378.ogg"
    banzhang2 "——모든 걸 정리한 뒤에 말이죠."


translate japanese plot9_crown_browse_dismissible_9a065c3f:


    voice "voice/tianqin_2036.ogg"
    tianqin "잠깐, 반장!"


translate japanese plot9_crown_browse_dismissible_99250960:


    voice "voice/banzhang_379.ogg"
    banzhang2 "왜 그러세요, 라이라 씨?"


translate japanese plot9_crown_browse_dismissible_82521de4:


    voice "voice/tianqin_2037.ogg"
    tianqin "……전부 네가 한 거야?"


translate japanese plot9_crown_browse_dismissible_190d79a5:


    voice "voice/banzhang_380.ogg"
    banzhang2 "「전부」라면 어느 걸 말씀하시는 걸까요? 괴롭힘? 장난?"


translate japanese plot9_crown_browse_dismissible_5dcd3e1f:


    voice "voice/banzhang_381.ogg"
    banzhang2 "아니면 저 세 사람의 몸속을 모조리 파낸 일 말인가요?"


translate japanese plot9_crown_browse_dismissible_c77ec7dd:


    voice "voice/tianqin_2038.ogg"
    tianqin "반장!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot9_crown_browse_dismissible_0c26d5b4:


    voice "voice/banzhang_382.ogg"
    banzhang2 "그렇게 당황하지 마세요, 라이라 씨."


translate japanese plot9_crown_browse_dismissible_62e102fb:


    voice "voice/banzhang_383.ogg"
    banzhang2 "흰쥐 일이라면, 네. 분명 제가 했어요."


translate japanese plot9_c9457573:


    banzhang2 "何と言えばいいのでしょう…最初は、少し懲らしめてあげるつもりだったんです。"


translate japanese plot9_crown_browse_dismissible_7dc9a6ba:


    voice "voice/banzhang_385.ogg"
    banzhang2 "그랬더니 이 왕관이 제 소원에 응해서, 꽤 과격한 장난을 쳐 주었어요."


translate japanese plot9_crown_browse_dismissible_238fa583:


    voice "voice/banzhang_386.ogg"
    banzhang2 "그 뒤에는 제가 바라는 대로 그 애들을 이런 모습으로 바꿔 주었죠."


translate japanese plot9_crown_browse_dismissible_1a051afc:


    voice "voice/tianqin_2039.ogg"
    tianqin "반장, 왜——!"


translate japanese plot9_crown_browse_dismissible_5e273c80:


    voice "voice/banzhang_387.ogg"
    banzhang2 "하지만 이 사람들은 아직 죽지 않았는걸요?"


translate japanese plot9_crown_browse_dismissible_c5a637c8:


    voice "voice/tianqin_2040.ogg"
    tianqin "뭐……"


translate japanese plot9_crown_browse_dismissible_fd557b36:


    "반장은 저쪽 세 사람을 가리켰다."


translate japanese plot9_crown_browse_dismissible_7503ea3e:


    "반장의 말대로였다. 상반신에는 빈 공간만 남았는데도, 희미한 신음이 여전히 들려왔다."


translate japanese plot9_crown_browse_dismissible_f3514ed3:


    voice "voice/banzhang_388.ogg"
    banzhang2 "제 덕분에 이런 모습이 되고도 살아 있을 수 있는 거예요."


translate japanese plot9_crown_browse_dismissible_04926dd8:


    voice "voice/banzhang_389.ogg"
    banzhang2 "라이라 씨는 모르셔도, 옆의 마녀라면 무슨 일이 벌어졌는지 아시겠죠?"


translate japanese plot9_crown_browse_dismissible_4d00796c:


    voice "voice/cygnus_1156.ogg"
    cygnus "……영혼을 육체에 묶어 둔 거야?"


translate japanese plot9_crown_browse_dismissible_13a18f55:


    voice "voice/banzhang_390.ogg"
    banzhang2 "네, 맞아요. 역시 마녀라서 알아보는 눈이 좋네요."


translate japanese plot9_crown_browse_dismissible_044b3d0e:


    voice "voice/cygnus_1157.ogg"
    cygnus "목적이 뭐야?"


translate japanese plot9_crown_browse_dismissible_d865b633:


    voice "voice/cygnus_1158.ogg"
    cygnus "내 마도구로 자신을 마나체로 바꿔서 영생을 얻으려는 거야?"


translate japanese plot9_crown_browse_dismissible_16b847a1:


    voice "voice/banzhang_391.ogg"
    banzhang2 "아니요. 저한테는 당신처럼 마법을 쓰는 재능은 없어요."


translate japanese plot9_crown_browse_dismissible_25ea3542:


    voice "voice/banzhang_392.ogg"
    banzhang2 "결국 우연히 당신의 왕관을 손에 넣어서, 마법의 극히 일부분만 알게 된 거예요."


translate japanese plot9_crown_browse_dismissible_5a5b2965:


    voice "voice/banzhang_393.ogg"
    banzhang2 "하지만 사람을 괴롭히는 데는 그 정도만으로도 충분하더라고요."


translate japanese plot9_8796cf3d:


    banzhang2 "魂をマナ体に変える。その過程が不完全なら、人はそのようになります。"


translate japanese plot9_crown_browse_dismissible_03adec01:


    voice "voice/cygnus_1159.ogg"
    cygnus "대체 뭘 하려는 거야?"


translate japanese plot9_crown_browse_dismissible_cc783f1d:


    voice "voice/banzhang_395.ogg"
    banzhang2 "알고 계세요?"


translate japanese plot9_crown_browse_dismissible_c494ba76:


    voice "voice/banzhang_396.ogg"
    banzhang2 "마나로 장기를 보충하고, 영혼을 이 불사의 육체에 붙들어 둘 수는 있어요."


translate japanese plot9_crown_browse_dismissible_d1b676fa:


    voice "voice/banzhang_397.ogg"
    banzhang2 "하지만 그 과정에서는 차라리 죽는 게 낫겠다 싶을 만큼 고통이 계속되거든요."


translate japanese plot9_crown_browse_dismissible_2a7dcdd6:


    voice "voice/banzhang_398.ogg"
    banzhang2 "제가 어떻게 아느냐면……"


translate japanese plot9_a02255af:


    ""


translate japanese plot9_073258a2:


    voice "voice/banzhang_399.ogg"
    banzhang2 0506 "저 자신이 그 무엇보다 확실한 증거니까요."


translate japanese plot9_crown_browse_dismissible_8ebe9591:


    voice "voice/cygnus_1160.ogg"
    cygnus "너——!"


translate japanese plot9_crown_browse_dismissible_f45ad4f2:


    "시노스의 머릿속에 떠오르는 것이 있었다."


translate japanese plot9_crown_browse_dismissible_36ab9f30:


    "뒤섞인 기억 속에서, 똑같은 상황을 마주친 적이 있었다."


translate japanese plot9_crown_browse_dismissible_886ac60a:


    "배를 갈라 내장을 바치는 이 참혹한 행위. 이것은 성수에 제물을 바치는 의식이었다."


translate japanese plot9_crown_browse_dismissible_414d0e33:


    "이 의식으로 성수를 「기쁘게」 하고, 자신의 소원을 들어주게 한다."


translate japanese plot9_crown_browse_dismissible_012487bf:


    "시노스는 자신과 성수 사이에 쉽게 설명할 수 없는 연결이 있다는 것을 알고 있었다."


translate japanese plot9_crown_browse_dismissible_d820033f:


    "지금까지 알게 된 기억을 이어 붙여 보면, 시노스도 이미 짐작할 수 있었다."


translate japanese plot9_crown_browse_dismissible_35f39d67:


    "——자신은 성수와 같은 근원에서 태어난 존재일지도 모른다."


translate japanese plot9_crown_browse_dismissible_b48e3aa2:


    "그렇다면 같은 의식이 시노스에게도 통할 수 있다."


translate japanese plot9_crown_browse_dismissible_6cf9bcf2:


    "눈앞의 소녀는 자신을 제물로 바치고, 그 대가로 시노스에게서 무언가를 「얻은」 것이다."


translate japanese plot9_crown_browse_dismissible_aaf30011:


    voice "voice/cygnus_1161.ogg"
    cygnus "——내 마도구와 거래한 거야?"


translate japanese plot9_crown_browse_dismissible_d33929b0:


    voice "voice/banzhang_400.ogg"
    banzhang2 "네, 맞아요."


translate japanese plot9_2583d653:


    banzhang2 "他人の力を借りるのですから、それなりの代償は必要でしょう？"


translate japanese plot9_crown_browse_dismissible_f61518a4:


    voice "voice/banzhang_402.ogg"
    banzhang2 "제 장기를 내놓고, 당신의 왕관에서 이 신비한 힘을 얻었어요."


translate japanese plot9_crown_browse_dismissible_25f7739c:


    voice "voice/banzhang_403.ogg"
    banzhang2 "그리고 그 힘으로 몸의 기능을 유지하고 있죠."


translate japanese plot9_crown_browse_dismissible_2e650f2f:


    voice "voice/banzhang_404.ogg"
    banzhang2 "정말 아팠어요……마법으로 고통을 덜어 내도 견딜 수 없을 만큼."


translate japanese plot9_crown_browse_dismissible_2c3d2e50:


    voice "voice/banzhang_405.ogg"
    banzhang2 "그래서 마침 잘됐죠. 이 고통은 저 세 사람을 괴롭히기에 딱 좋았거든요."


translate japanese plot9_crown_browse_dismissible_9def61d5:


    voice "voice/banzhang_406.ogg"
    banzhang2 "이 고통도, 이 절망도……그 사람들은 천천히, 충분히 맛봐야 해요."


translate japanese plot9_crown_browse_dismissible_897b38b0:


    voice "voice/tianqin_2041.ogg"
    tianqin "반장……"


translate japanese plot9_crown_browse_dismissible_20917cb2:


    voice "voice/tianqin_2042.ogg"
    tianqin "무슨 일이 있었던 거야? 왜 이렇게까지……"


translate japanese plot9_crown_browse_dismissible_c8f4f9c3:


    voice "voice/banzhang_407.ogg"
    banzhang2 "…"


translate japanese plot9_crown_browse_dismissible_7991b3cf:


    voice "voice/banzhang_408.ogg"
    banzhang2 "그러게요……어쩌다 이렇게 됐을까요……"


translate japanese plot9_crown_browse_dismissible_b8e56d97:


    voice "voice/cygnus_1162.ogg"
    cygnus "윽……!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot9_crown_browse_dismissible_7915715f:


    "왕관의 힘을 받은 반장의 몸에서 더욱 강한 마력이 쏟아져 나왔다."


translate japanese plot9_crown_browse_dismissible_95950eda:


    "격렬하게 흔들리는 감정이 그대로 힘이 되어 몸에서 흘러나오고 있었다."


translate japanese plot9_crown_browse_dismissible_dc2c1578:


    "보이지 않아야 할 마력이 검은 파도가 되어 반장에게서 흘러넘치고, 모든 것을 집어삼키는 듯했다."


translate japanese plot9_crown_browse_dismissible_1326a97b:


    "라이라와 시노스는 그녀의 영혼이 통곡하는 소리까지 들리는 것 같았다."


translate japanese plot9_crown_browse_dismissible_962ee854:


    voice "voice/tianqin_2043.ogg"
    tianqin "읏!"


translate japanese plot9_9a268a63:


    voice "voice/cygnus_1163.ogg"
    cygnus "정신 차려, 라이라!"


translate japanese plot9_crown_browse_dismissible_7514a37a:


    voice "voice/cygnus_1164.ogg"
    cygnus "저 애의 감정에 휩쓸리지 마!"


translate japanese plot9_crown_browse_dismissible_63994984:


    "그렇게 말한 시노스도, 반장에게서 터져 나오는 마력의 파동을 점점 견딜 수 없게 되었다."


translate japanese plot9_crown_browse_dismissible_8b9d1099:


    voice "voice/cygnus_1165.ogg"
    cygnus "큭……나까지……"


translate japanese plot9_0a16205c:


    "委員長の気持ちと一緒に、ばらばらになった記憶が頭の中に流れ込んでくる。"


translate japanese plot9_4c919c25:


    "一度にあまりにも多くのものを見せられ、全員の意識が途切れた。"


translate japanese plot9_442941ca:


    "…"


translate japanese plot9_574e5cd7:


    nvlNone "2년 전."


translate japanese plot9_5bdfc0d7:


    nvlNone "나는 긴장한 채 컴퓨터 앞에 앉아{p}성적 조회 사이트에 수험 번호를 몇 번이고 입력하고 있었다."


translate japanese plot9_4638fa69:


    nvlNone "화면에는 줄곧 「아직 성적을 확인할 수 없습니다」라고 떴다.{p}그래도 나는 아랑곳하지 않고 몇 번이고 같은 일을 반복했다."


translate japanese plot9_b12eef79:


    nvlNone "모두가 이렇게 긴장하는 것은{p}이 결과에 앞으로 3년 동안 다닐 고등학교가 달렸기 때문이었다."


translate japanese plot9_140f5e27:


    voice "voice/mama_24.ogg"
    nvl_mama "아키, 결과는 나왔니?"


translate japanese plot9_0aeed265:


    voice "voice/banzhang_409.ogg"
    nvl_yunqiu "아직 안 나왔어, 엄마."


translate japanese plot9_dc33b144:


    voice "voice/mama_25.ogg"
    nvl_mama "그래. 긴장하지 않아도 돼." (**end_page())


translate japanese plot9_20bf3de0:


    nvl clear
    voice "voice/mama_26.ogg"
    nvl_mama "어떤 결과가 나오든 침착하게 받아들이면 된단다."


translate japanese plot9_f57b1467:


    voice "voice/banzhang_410.ogg"
    nvl_yunqiu "응!" (**end_page())


translate japanese plot9_b7566518:


    nvlNone "엄마는 그렇게 말했지만, 사실은 나만큼 긴장하고 있다는 걸 알고 있었다."


translate japanese plot9_665da68e:


    nvlNone "하지만 나는 자신이 있었다."


translate japanese plot9_6a01da98:


    nvlNone "모범 답안이 나온 뒤로 여러 번 가채점을 해 보았다."


translate japanese plot9_f8eac424:


    nvlNone "그래도 조금 불안해지는 것은 어쩔 수 없었다."


translate japanese plot9_47365f98:


    nvlNone "이 시험에는 3년 동안의 노력이 맺혀 있었다.{p}중학교 시절의 모든 노력이 이 결과를 위한 것이었다고 해도 좋았다."


translate japanese plot9_5dfeb56b:


    nvlNone "이윽고 9시가 되었다."


translate japanese plot9_e943782c:


    voice "voice/nvlbanzhang_01.ogg"
    nvlNone "「후——」"


translate japanese plot9_4b3aa4d7:


    nvlNone "이번에는 늘 뜨던 메시지 대신 다음 화면으로 넘어갔다."


translate japanese plot9_9ea0ae75:


    nvlNone "나는 하얀 화면을 바라보며 숨을 죽이고\n결과가 나오기를 조용히 기다렸다."


translate japanese plot9_d6f6f866:


    nvlNone "10초……30초……1분……"


translate japanese plot9_63fa50b3:


    nvlNone "빨리……빨리 결과가 나와 줘……"


translate japanese plot9_565cef4d:


    nvlNone "초조함을 누르며 마음속으로 몇 번이고 되뇌었다."


translate japanese plot9_072ebe8d:


    nvlNone "그렇게 아마 몇 분이 지났을 무렵."


translate japanese plot9_92ad071d:


    nvlNone "「이런, 죄송합니다. 페이지에 오류가 발생했습니다.」"


translate japanese plot9_676eac92:


    voice "voice/banzhang_411.ogg"
    nvl_yunqiu "아, 뭐야——" (**end_page())


translate japanese plot9_4ffa8fcd:


    voice "voice/mama_27.ogg"
    nvl_mama "결과 나왔니?"


translate japanese plot9_74f66408:


    voice "voice/banzhang_412.ogg"
    nvl_yunqiu "아직. 확인하는 사람이 너무 많아서 사이트가 다운됐나 봐."


translate japanese plot9_1fb78d59:


    voice "voice/mama_28.ogg"
    nvl_mama "서두르지 않아도 돼. 결과가 어디 달아나는 것도 아니잖니." (**end_page())


translate japanese plot9_311c71fd:


    nvl clear
    voice "voice/mama_29.ogg"
    nvl_mama "과자라도 먼저 먹고 좀 쉬어."


translate japanese plot9_9170034e:


    voice "voice/banzhang_413.ogg"
    nvl_yunqiu "아니, 괜찮아."


translate japanese plot9_7e323504:


    voice "voice/banzhang_414.ogg"
    nvl_yunqiu "결과부터 확인하고 먹을게. 지금은 별로 입맛이 없어." (**end_page())


translate japanese plot9_53341e79:


    nvlNone "10분쯤 지나서야 성적 조회 페이지가 정상으로 돌아왔다."


translate japanese plot9_3bddc10c:


    nvlNone "나는 서둘러 수험 번호를 입력했다."


translate japanese plot9_cf5d408c:


    nvlNone "잠시 기다리자, 드디어 내 성적표가 나타났다."


translate japanese plot9_8edcec84:


    nvlNone "모든 과목의 점수가 예상보다 조금씩 높았다."


translate japanese plot9_94c6acd5:


    nvlNone "가슴에 줄곧 남아 있던 긴장과 불안이 사라지고,\n대신 기쁨과 흥분이 한꺼번에 솟아올랐다."


translate japanese plot9_afc5e3d5:


    voice "voice/banzhang_415.ogg"
    nvl_yunqiu "엄마! 결과 나왔어요!"


translate japanese plot9_35cabdb3:


    voice "voice/mama_30.ogg"
    nvl_mama "그래? 어떻게 됐니?"


translate japanese plot9_bde95ad3:


    voice "voice/banzhang_416.ogg"
    nvl_yunqiu "괜찮아요! 예상보다 훨씬 높아요!" (**end_page())


translate japanese plot9_f531073a:


    nvl clear
    voice "voice/mama_31.ogg"
    nvl_mama "응! 넌 잘할 줄 알았어."


translate japanese plot9_1f457149:


    voice "voice/mama_32.ogg"
    nvl_mama "이제 아키랑 엄마는 같은 학교 선후배네."


translate japanese plot9_73745ebf:


    voice "voice/banzhang_417.ogg"
    nvl_yunqiu "선배님, 잘 부탁드립니다!" (**end_page())


translate japanese plot9_a3fe08f7:


    nvl clear
    voice "voice/mama_33.ogg"
    nvl_mama "후후, 얘도 참." (**end_page())


translate japanese plot9_4e79a785:


    nvlNone "내가 가장 가고 싶었던 학교는 룽화시 제1고등학교다.\n줄여서 「룽화 1고」라고 불린다."


translate japanese plot9_3da4eed9:


    nvlNone "룽화 1고는 아시아 지구에서\n오래전부터 이름난 최상위권 진학 명문고다."


translate japanese plot9_06aa503e:


    nvlNone "이 고등학교에 들어가면{p}일류 대학에 한 발을 들여놓은 것이나 다름없다고\n말하는 사람도 많았다."


translate japanese plot9_d119be05:


    nvlNone "엄마는 언제나 나의 목표였다."


translate japanese plot9_f68841fc:


    nvlNone "나는 엄마와 단둘이 자랐다."


translate japanese plot9_560cbcb1:


    nvlNone "지금 돌이켜 보면,"


translate japanese plot9_f4b56bea:


    nvlNone "엄마는 혼자서 나를 여기까지 키워 주셨다."


translate japanese plot9_96801df8:


    nvlNone "엄마는 아주 강하고 일을 잘하는 사람이다."


translate japanese plot9_61e211a4:


    nvlNone "회사에서는 핵심 인력으로서, 실력과 일하는 태도로 모두의 존경을 받았다." (**end_page())


translate japanese plot9_bf3ef928:


    nvlNone "공부에 관해서는 한 번도 무리한 요구를 하지 않으셨다."


translate japanese plot9_50f276a8:


    nvlNone "하지만 사람으로서 중요한 것을 가르칠 때는 매우 엄격하셨다."


translate japanese plot9_76b03fbf:


    nvlNone "무엇이 옳고 무엇이 그른지,\n어떻게 생각해야 하는지를 가르쳐 주셨다." (**end_page())


translate japanese plot9_84793083:


    nvlNone "철이 든 뒤로 줄곧 엄마가 나의 목표였다."


translate japanese plot9_3b1599e9:


    nvlNone "그 뒤로는{p}사람으로서의 태도도, 공부도, 운동도……어느 하나 소홀히 하지 않았다."


translate japanese plot9_f09d2590:


    nvlNone "그리고 이제 엄마와 같은 고등학교에 합격했다."


translate japanese plot9_5c740870:


    nvlNone "이대로 열심히 하면, 엄마와 같은 대학에도 꼭 갈 수 있을 것이다."


translate japanese plot9_1bab3b79:


    nvlNone "고등학교 생활이 시작되자마자 상당한 압박감을 느꼈다."


translate japanese plot9_365cce6c:


    nvlNone "첫째는 늘 자신이 있던 성적이었다."


translate japanese plot9_b2d2443c:


    nvlNone "그래서 {a=dictionary:dict_entry_91}고입 시험{/a} 때도 룽화 1고에 합격할 자신이 있었다."


translate japanese plot9_69d9686d:


    nvlNone "하지만 룽화 1고는 최상위권 학교였다.{p}대부분의 학생이 공부를 잘했다."


translate japanese plot9_63a56b62:


    nvlNone "그것은 내게 큰 충격이었다."


translate japanese plot9_f90e9b8b:


    nvlNone "공부에는\n내가 생각했던 만큼 재능이 없다는 걸 알았다."


translate japanese plot9_5f354765:


    nvlNone "하지만 가장 괴로웠던 것은 그게 아니었다." (**end_page())


translate japanese plot9_39a9b118:


    nvlNone "같은 반 히나타 때문에 진짜 격차를 뼈저리게 느꼈다."


translate japanese plot9_96125e05:


    nvlNone "中学にも、そういう生徒はいくらでもいた。{p}むしろ、彼女のような人のほうが多いくらいだ。"


translate japanese plot9_71c80d73:


    nvlNone "でも、最初の試験結果が出たとき、\nヒナタへの見方はすべて変わった。"


translate japanese plot9_6b44c858:


    nvlNone "처음에는 운이 좋았을 뿐이라고 생각했다."


translate japanese plot9_2e33b61e:


    nvlNone "하지만 두 번째, 세 번째……"


translate japanese plot9_67911cfa:


    nvlNone "우리가 필사적으로 고민하는 고등학교 문제도{p}그녀에게는 초등학교 문제와 다르지 않은 듯했다."


translate japanese plot9_7670f92c:


    nvlNone "선생님들은 히나타의 답안지를 채점할 때면 평소보다 더 꼼꼼히 살폈다."


translate japanese plot9_84c9fb92:


    nvlNone "모범 답안과 거의 다르지 않은 답안 속에서,"


translate japanese plot9_ec2c22e9:


    nvlNone "나중에야 알았다."


translate japanese plot9_7e2ac492:


    nvlNone "히나타는 고등학교에 들어오기 전까지 학교에 다닌 적이 없었고\n줄곧 전문 과외 교육을 받아 왔다."


translate japanese plot9_17632bb6:


    nvlNone "돌이켜 보면,{p}예전에는 신문에서 「천재 아동」 기사를 자주 봤다."


translate japanese plot9_9e7c5fcb:


    nvlNone "ヒナタに会って、初めて分かった。{p}自分と、見下していた「天才児」の間に、どれだけ大きな差があるのか。"


translate japanese plot9_3977cf4b:


    nvlNone "그녀가 거기 있는 것만으로도 이런 말을 듣는 것 같았다——"


translate japanese plot9_e35c3a3b:


    nvlNone "히나타뿐만이 아니었다.\n그녀의 단짝 라이라 역시 사람 사이의 격차를 깨닫게 했다."


translate japanese plot9_26a4c393:


    nvlNone "학교생활만 놓고 보면 라이라는 히나타보다 더 심했다."


translate japanese plot9_5b649b75:


    nvlNone "그런데도{p}며칠만 혼자 공부하면 수업 진도를 따라잡았다."


translate japanese plot9_39f9546a:


    nvlNone "라이라의 성적은 히나타처럼 눈에 띄지는 않았다.{p}그래도 늘 상위권에 있었고\n내 컨디션이 나쁠 때는 나보다 높기도 했다." (**end_page())


translate japanese plot9_a7ac2dee:


    nvlNone "가까이 있는 그런 「괴물」들이 부러운 동시에 한숨이 나왔다——{p}아무리 애써도 손에 넣지 못하는 것은 정말 있다." (**end_page())


translate japanese plot9_d0e79b49:


    nvlNone "이 학교에는 그 밖에도 비슷하게 우수한 학생이 많았다."


translate japanese plot9_0f89f3cc:


    nvlNone "나는 어떻게 해야 할지 알 수 없게 되었다."


translate japanese plot9_6f00a936:


    nvlNone "고민. 방황. 이해할 수 없었다."


translate japanese plot9_b088f381:


    nvlNone "「뛰어난 나」가 「평범한 나」로 추락했다. 그 격차를 받아들일 수 없었다."


translate japanese plot9_d6f4c191:


    nvl_yunqiu "…" (**end_page())


translate japanese plot9_61009b52:


    voice "voice/mama_34.ogg"
    nvl_mama "아키?"


translate japanese plot9_ab2b7e48:


    voice "voice/banzhang_419.ogg"
    nvl_yunqiu "네? 엄마? 뭐 도와드릴까요?"


translate japanese plot9_5430feff:


    voice "voice/mama_35.ogg"
    nvl_mama "괜찮아. 저녁 준비는 다 했어." (**end_page())


translate japanese plot9_04ad2c8e:


    nvl clear
    voice "voice/mama_36.ogg"
    nvl_mama "요즘 기운이 없어 보이네. 무슨 일 있니?"


translate japanese plot9_79f496fc:


    voice "voice/banzhang_420.ogg"
    nvl_yunqiu "저기, 아무것도 아니에요, 엄마……"


translate japanese plot9_991b9303:


    voice "voice/mama_37.ogg"
    nvl_mama "얘기해 보렴. 학교에서 힘든 일이라도 있니?" (**end_page())


translate japanese plot9_5a5cad80:


    nvl clear
    voice "voice/banzhang_421.ogg"
    nvl_yunqiu "……네."


translate japanese plot9_0dd428c4:


    voice "voice/banzhang_422.ogg"
    nvl_yunqiu "중학교 때는 학년 3등 아래로 내려간 적이 없었어요."


translate japanese plot9_14077d6a:


    voice "voice/banzhang_423.ogg"
    nvl_yunqiu "그런데 고등학교에 와서는 50등 안에 드는 것도 너무 힘들어요." (**end_page())


translate japanese plot9_4cceff77:


    nvl clear
    voice "voice/banzhang_424.ogg"
    nvl_yunqiu "룽화 1고 학생들은 정말 대단하네요.\n역시 최상위권 진학 명문고예요."


translate japanese plot9_a9e46c72:


    voice "voice/banzhang_425.ogg"
    nvl_yunqiu "저도 열심히 공부하는데, 다른 애들을 이길 수가 없어요."


translate japanese plot9_7d2533ef:


    voice "voice/banzhang_426.ogg"
    nvl_yunqiu "그게 조금 힘들어서요……" (**end_page())


translate japanese plot9_33fc8abc:


    nvl clear
    voice "voice/mama_38.ogg"
    nvl_mama "비교할 상대를 잘못 골랐어, 아키."


translate japanese plot9_e72288ac:


    voice "voice/banzhang_427.ogg"
    nvl_yunqiu "응?"


translate japanese plot9_1d6f87c3:


    voice "voice/mama_39.ogg"
    nvl_mama "사람마다 잘하는 게 다르잖니?" (**end_page())


translate japanese plot9_22ef5a97:


    nvl clear
    voice "voice/mama_40.ogg"
    nvl_mama "공부 점수만으로 사람의 위아래를 정하다니, 너무 편협한 시각이야."


translate japanese plot9_c6621d1d:


    voice "voice/banzhang_428.ogg"
    nvl_yunqiu "엄마는 이해 못 하세요. 하지만……"


translate japanese plot9_f0f17a42:


    voice "voice/mama_41.ogg"
    nvl_mama "——하지만 학교는 「성적」으로 한 사람 한 사람을 평가하지. 그 말을 하고 싶은 거지?" (**end_page())


translate japanese plot9_d083e0a5:


    nvl clear
    voice "voice/banzhang_429.ogg"
    nvl_yunqiu "……네."


translate japanese plot9_25cef246:


    voice "voice/mama_42.ogg"
    nvl_mama "아키."


translate japanese plot9_d70bccc7:


    voice "voice/mama_43.ogg"
    nvl_mama "확실히 학교뿐만 아니라, 어른이 되어 사회에 나가서도 사람들은 각자의 「성적」을 평가받는단다." (**end_page())


translate japanese plot9_d81bdc29:


    nvl clear
    voice "voice/mama_44.ogg"
    nvl_mama "하지만 「학교 성적」만으로 그 사람이 무엇을 할 수 있는지 정할 수는 없어. 엄마도 회사에서 몇 번이고 그렇게 느꼈단다."


translate japanese plot9_ed3f8b22:


    voice "voice/mama_45.ogg"
    nvl_mama "일류 대학을 나오고, 공부하는 능력도 아주 뛰어난 사람이 있어." (**end_page())


translate japanese plot9_d7a64763:


    nvl clear
    voice "voice/mama_46.ogg"
    nvl_mama "하지만 스스로 생각하는 데 서툴러서, 언제까지고 성장하지 못한 채 매일 같은 일만 하게 되는 사람도 적지 않아." (**end_page())


translate japanese plot9_c03dbd71:


    nvl clear
    voice "voice/mama_47.ogg"
    nvl_mama "지금부터 할 말이 정답은 아닐지도 몰라. 그래도 엄마는 이렇게 생각해."


translate japanese plot9_6e29d9ae:


    voice "voice/mama_48.ogg"
    nvl_mama "「학업 능력」은 겉으로 보이는 것 가운데 하나일 뿐이야. 정말 중요한 건 그 사람의 「내면」과 「인간성」이란다."


translate japanese plot9_265c689b:


    voice "voice/banzhang_430.ogg"
    nvl_yunqiu "「내면」과 「인간성」……?" (**end_page())


translate japanese plot9_db4825c6:


    nvl clear
    voice "voice/mama_49.ogg"
    nvl_mama "아, 미안해. 좀 어렵게 말했네."


translate japanese plot9_5186a36a:


    voice "voice/mama_50.ogg"
    nvl_mama "쉽게 말하면."


translate japanese plot9_c78df301:


    voice "voice/mama_51.ogg"
    nvl_mama "항상 다른 사람과 비교하지 않아도 돼.\n계속 비교해 봤자 아키에게 도움이 되지 않는단다." (**end_page())


translate japanese plot9_b1677359:


    nvl clear
    voice "voice/mama_52.ogg"
    nvl_mama "정말 비교해야 할 상대는 어제까지의 너 자신뿐이야."


translate japanese plot9_73a67c7d:


    voice "voice/mama_53.ogg"
    nvl_mama "오늘 새로운 것을 하나라도 배웠는지."


translate japanese plot9_16ae4d2a:


    voice "voice/mama_54.ogg"
    nvl_mama "누군가와 이야기하며 새로운 생각을 깨달았는지." (**end_page())


translate japanese plot9_1de0a1a6:


    nvl clear
    voice "voice/mama_55.ogg"
    nvl_mama "책을 읽고 예전과 다른 생각을 할 수 있었는지."


translate japanese plot9_e998087d:


    voice "voice/mama_56.ogg"
    nvl_mama "하루하루 그렇게 자신에게 계속 물어보는 거야.\n그게 「생각한다」는 것이란다."


translate japanese plot9_c3cf406a:


    voice "voice/mama_57.ogg"
    nvl_mama "그렇게 지내다 보면\n자신이 조금씩 성장하고 있다는 걸 느끼게 될 거야." (**end_page())


translate japanese plot9_36df72b3:


    nvlNone "엄마의 말은 알 것 같기도, 모를 것 같기도 했다."


translate japanese plot9_c8ba7889:


    nvlNone "하지만 그 뒤로 마음이 훨씬 편해졌다."


translate japanese plot9_90298222:


    nvlNone "자신의 능력이 부족한 데서 도망쳤을 뿐이라고\n비웃는 사람도 있을 것이다."


translate japanese plot9_56a81530:


    nvlNone "하지만 한 발 물러서자, 내게도 다른 길이 있다는 것을 깨달았다."


translate japanese plot9_9f93df31:


    nvlNone "반장에 지원해서 반의 일을 성실히 해냈다."


translate japanese plot9_2f44ba59:


    nvlNone "운동에도 소질이 있었다.{p}선생님의 지도로 체육 특기생이 되었고\n언젠가는 선수가 될 수 있을지도 모른다고 생각했다." (**end_page())


translate japanese plot9_7a675086:


    nvlNone "엄마 말대로\n공부 말고도 내가 할 수 있는 일을 여러 가지 찾았다."


translate japanese plot9_e9708f41:


    nvlNone "成績ばかり見て勉強するのをやめ、前より広く周りを見られるようになった。"


translate japanese plot9_016ac07a:


    nvlNone "고등학교 생활의 출발은 순탄하지 않았다."


translate japanese plot9_f0ff8530:


    nvlNone "하지만 엄마와 이야기한 뒤, 갑자기 눈앞이 트이는 듯했다."


translate japanese plot9_ff4b7235:


    nvlNone "그런 일상이 완전히 뒤바뀐 것은 고등학교 1학년 후반이었다." (**end_page())


translate japanese plot9_211dbff3:


    nvlNone "그날 밤, 엄마는 혼자 많은 술을 마셨다."


translate japanese plot9_a79a236a:


    nvlNone "그토록 괴로운 표정을 짓는 엄마는 거의 본 적이 없었다."


translate japanese plot9_04b6fed3:


    voice "voice/banzhang_431.ogg"
    nvl_yunqiu "엄마, 이제 그만 마셔." (**end_page())


translate japanese plot9_0f0f1235:


    nvl clear
    voice "voice/mama_58.ogg"
    nvl_mama "……미안해, 아키."


translate japanese plot9_27676b56:


    voice "voice/mama_59.ogg"
    nvl_mama "오늘만은 혼자 마시게 해 줘." (**end_page())


translate japanese plot9_bd15c2c9:


    nvlNone "그날 엄마는 집에 있던 술을 거의 다 마셨다."


translate japanese plot9_d89ad0a4:


    nvlNone "맥주, 바이주, 와인……"


translate japanese plot9_bb89c11d:


    nvlNone "얼마나 마셨는지는 모르겠다.\n다만 끝내 취하시지는 않았다." (**end_page())


translate japanese plot9_4a2a8873:


    nvlNone "나중에야 직장 일 때문에 고민하고 계셨다는 걸 알았다."


translate japanese plot9_0f89e3e7:


    nvlNone "그런데 오히려 그 후배에게 모함을 당하고 말았다."


translate japanese plot9_a06280a9:


    nvlNone "그 실수는 갑자기 크게 부풀려져, 중대한 사고로 다뤄졌다."


translate japanese plot9_72bbfc47:


    nvlNone "하지만 엄마는 오래 낙담하지 않고, 곧 기운을 되찾으셨다."


translate japanese plot9_706c0e55:


    nvlNone "업무상의 문제 자체는 그리 큰 부담으로 느끼지 않으셨던 모양이다."


translate japanese plot9_34ccd569:


    nvlNone "엄마가 받아들일 수 없었던 것은 믿었던 후배가 그런 짓을 했다는 점이었다." (**end_page())


translate japanese plot9_10473ede:


    voice "voice/mama_60.ogg"
    nvl_mama "미안해, 아키."


translate japanese plot9_cc662cb7:


    voice "voice/mama_61.ogg"
    nvl_mama "얼마 전엔 일 생각만 하느라\n너를 제대로 돌봐 주지 못해서……"


translate japanese plot9_25649d9e:


    voice "voice/banzhang_432.ogg"
    nvl_yunqiu "괜찮아요, 엄마. 일이 힘드셨잖아요." (**end_page())


translate japanese plot9_b9a23a4f:


    nvl clear
    voice "voice/mama_62.ogg"
    nvl_mama "일이라……"


translate japanese plot9_665f34c3:


    voice "voice/mama_63.ogg"
    nvl_mama "회사 조사가 끝나면, 아마 엄마는 해고될 거야."


translate japanese plot9_def48d6f:


    voice "voice/banzhang_433.ogg"
    nvl_yunqiu "네……? 그렇게 큰일이에요……?" (**end_page())


translate japanese plot9_aaa8b015:


    nvl clear
    voice "voice/mama_64.ogg"
    nvl_mama "응. 아주 큰 과실로 다뤄지고 있거든."


translate japanese plot9_45e7a2fd:


    voice "voice/banzhang_434.ogg"
    nvl_yunqiu "꼭 알아주는 사람이 있을 거예요."


translate japanese plot9_3142f073:


    voice "voice/mama_65.ogg"
    nvl_mama "엄마는 괜찮아, 아키." (**end_page())


translate japanese plot9_21a9836c:


    nvl clear
    voice "voice/mama_66.ogg"
    nvl_mama "그렇게 걱정하지 마. 그만두게 돼도\n금세 다음 일을 찾을 테니까."


translate japanese plot9_24a39fcd:


    voice "voice/mama_67.ogg"
    nvl_mama "넌 학교 일만 생각해.\n엄마 때문에 공부에 지장이 생기지 않았으면 좋겠어."


translate japanese plot9_4d3bbc0c:


    voice "voice/banzhang_435.ogg"
    nvl_yunqiu "네, 엄마." (**end_page())


translate japanese plot9_45c98f4f:


    nvlNone "어째서 정직하고 착한 사람들만\n손해를 보는 걸까."


translate japanese plot9_fb360e3a:


    nvlNone "그 일이 계속 마음에 걸렸다."


translate japanese plot9_27454e97:


    nvlNone "勉強が遅れないようにはしていた。{p}でも心はいつも、お母さんのことでいっぱいだった。"


translate japanese plot9_d641811f:


    voice "voice/nvlbanzhang_02.ogg"
    nvlNone "「아——!」"


translate japanese plot9_35b390bc:


    nvlNone "오랫동안 고민한 끝에, 문득 한 가지 생각이 떠올랐다."


translate japanese plot9_9aa3f1d1:


    nvlNone "우리 반의 그 친구가 생각났다." (**end_page())


translate japanese plot9_0e43d4c5:


    nvlNone "그 생각이 나를 밑바닥까지 끌어내릴 줄은 몰랐다." (**end_page())


translate japanese plot9_692ae777:


    voice "voice/hecheng_140.ogg"
    nvl_hecheng "……그러니까 엄마가 직장에서 동료에게 모함을 당해서\n내가 도와줬으면 좋겠다는 거지?"


translate japanese plot9_3d9cf229:


    voice "voice/banzhang_436.ogg"
    nvl_yunqiu "네, 네……!"


translate japanese plot9_fe713cab:


    voice "voice/banzhang_437.ogg"
    nvl_yunqiu "엄마가 일하시는 곳이 츠루기 씨 가족의 회사라서……\n부탁드려 볼 수 있을까 해서요……" (**end_page())


translate japanese plot9_35c3f505:


    nvl clear
    nvlNone "츠루기."


translate japanese plot9_35cf69bc:


    nvlNone "같은 체육 특기생인 그녀가 마지막으로 기댈 곳으로 떠올랐다."


translate japanese plot9_c9e1da55:


    nvlNone "엄마가 일하는 회사는 츠루기 집안에서 운영하는 곳이었다." (**end_page())


translate japanese plot9_83e74b7c:


    nvlNone "기대는 거의 하지 않았다. 그래도 조금이나마 도와줄 수 있지 않을까 생각했다."


translate japanese plot9_8c8c70e2:


    nvlNone "막막한 나머지 무엇이든 붙잡으려 한다는 사실은 나도 알고 있었다." (**end_page())


translate japanese plot9_a168e2f2:


    voice "voice/hecheng_141.ogg"
    nvl_hecheng "……솔직히, 어려워." (**end_page())


translate japanese plot9_5a326b4d:


    nvl clear
    voice "voice/banzhang_438.ogg"
    nvl_yunqiu "어?"


translate japanese plot9_1161612c:


    voice "voice/hecheng_142.ogg"
    nvl_hecheng "우리 집 회사인 건 맞아."


translate japanese plot9_6773471e:


    voice "voice/hecheng_143.ogg"
    nvl_hecheng "하지만 내가 끼어들 수 있는 일은 아니야." (**end_page())


translate japanese plot9_fdcabca5:


    nvl clear
    voice "voice/banzhang_439.ogg"
    nvl_yunqiu "그렇군요…"


translate japanese plot9_1ed0fd15:


    voice "voice/hecheng_144.ogg"
    nvl_hecheng "그래도 엄마가 누군가에게 모함당했다고 확신한다면\n아무것도 못 하는 건 아니지."


translate japanese plot9_79e4a954:


    voice "voice/hecheng_145.ogg"
    nvl_hecheng "조금 밀어줄 수는 있어. 적어도\n누명은 쓰지 않도록 할 수 있을 것 같아." (**end_page())


translate japanese plot9_a95dac78:


    nvl clear
    voice "voice/banzhang_440.ogg"
    nvl_yunqiu "저, 정말요?"


translate japanese plot9_702353ee:


    voice "voice/hecheng_146.ogg"
    nvl_hecheng "아직 좋아하지 마. 엄마를 도와줄 수 있다고 약속할 수는 없어."


translate japanese plot9_1ab9c78e:


    voice "voice/hecheng_147.ogg"
    nvl_hecheng "내가 할 수 있는 범위에서 조금 움직여 볼 뿐이야." (**end_page())


translate japanese plot9_dbb4a648:


    nvl clear
    voice "voice/banzhang_441.ogg"
    nvl_yunqiu "감사해요! 그것만으로 충분해요!"


translate japanese plot9_8b6308d5:


    voice "voice/hecheng_148.ogg"
    nvl_hecheng "무슨 일이 있었는지 처음부터 전부 말해 봐." (**end_page())


translate japanese plot9_c23afbf1:


    nvlNone "아무 기대도 하지 않았는데, 작은 희망이 다시 켜지는 것 같았다."


translate japanese plot9_2ecc8e14:


    nvlNone "츠루기가 도와준다면\n엄마 상황도 조금은 나아질지 모른다." (**end_page())


translate japanese plot9_b660cd4a:


    nvlNone "그렇게 며칠이 지났다." (**end_page())


translate japanese plot9_2c24c1fc:


    nvlNone "퇴근한 엄마는\n얼마 전까지 어두웠던 표정이 거짓말처럼 환해져 있었다."


translate japanese plot9_72abe36a:


    nvlNone "말씀을 꺼내기도 전에 무슨 이야기를 할지 알았다."


translate japanese plot9_28044fca:


    voice "voice/mama_68.ogg"
    nvl_mama "아키, 회사 조사가 끝났어.\n엄마의 결백이 인정됐단다." (**end_page())


translate japanese plot9_4ee511d9:


    nvl clear
    voice "voice/mama_69.ogg"
    nvl_mama "계속 같은 회사에서 일할 수 있게 됐어."


translate japanese plot9_5406a311:


    voice "voice/banzhang_442.ogg"
    nvl_yunqiu "잘됐다, 엄마!"


translate japanese plot9_32ea7c85:


    voice "voice/banzhang_443.ogg"
    nvl_yunqiu "역시 옳은 사람을 나쁜 사람으로 몰아간 채 끝나지는 않는군요." (**end_page())


translate japanese plot9_9f34dd3e:


    nvl clear
    voice "voice/mama_70.ogg"
    nvl_mama "응. 세상에는 제대로 봐 주는 사람이 있는 법이야."


translate japanese plot9_f8a2e4c7:


    nvlNone "뒤에서 츠루기가 도와주었다는 걸 알고 있었다."


translate japanese plot9_5c04aaea:


    nvlNone "정말로 해고 직전에 있던 엄마를 구해 준 것이다." (**end_page())


translate japanese plot9_82fc6c27:


    nvlNone "물론 내가 한 일은 엄마에게 말할 수 없었다."


translate japanese plot9_00992f5f:


    nvlNone "엄마라면 절대 내 방식을 인정하지 않을 것이다."


translate japanese plot9_e301069d:


    nvlNone "알게 되면 그대로 회사를 그만둘지도 모른다. 그러면 아무 의미가 없어진다." (**end_page())


translate japanese plot9_5602e188:


    nvlNone "엄마가 바라던 방법은 아니어도\n나는 후회하지 않았다."


translate japanese plot9_a7bb6231:


    nvlNone "결국 엄마를 도울 수 있었다. 일자리도 잃지 않았다. 그것만으로 충분했다." (**end_page())


translate japanese plot9_bdf33a60:


    nvlNone "이 학교에 들어와 다행이라고 이토록 생각한 적은 없다. 시험 결과를 봤을 때보다 더 기뻤을지도 모른다."


translate japanese plot9_3b43013b:


    nvlNone "그리고 이때, 나는 사회의 축소판을 보았다."


translate japanese plot9_3b18c943:


    "鶴城にとっては、家の人にほんの少し話しただけだったのかもしれない。"


translate japanese plot9_ffd100dc:


    nvl clear
    nvlNone "하지만 그 짧은 말만으로 우리 모녀의 운명은 바뀌었다." (**end_page())


translate japanese plot9_238dc81b:


    nvl_yunqiu "저, 저기, 츠루기 씨!" (**end_page())


translate japanese plot9_7c6f297f:


    voice "voice/hecheng_149.ogg"
    nvl_hecheng "응?"


translate japanese plot9_ead8ea09:


    voice "voice/banzhang_445.ogg"
    nvl_yunqiu "정말 감사해요!"


translate japanese plot9_5cfafba0:


    voice "voice/banzhang_446.ogg"
    nvl_yunqiu "츠루기 씨가 도와주신 덕분에\n엄마의 일도 공정하게 조사받을 수 있었어요." (**end_page())


translate japanese plot9_87a5bd65:


    nvl clear
    voice "voice/hecheng_150.ogg"
    nvl_hecheng "아, 그 일……"


translate japanese plot9_329de089:


    voice "voice/hecheng_151.ogg"
    nvl_hecheng "별일 아니야. 말만 조금 했어."


translate japanese plot9_adb8aa11:


    voice "voice/banzhang_447.ogg"
    nvl_yunqiu "정말 감사드려요!" (**end_page())


translate japanese plot9_4f418b02:


    nvl clear
    voice "voice/hecheng_152.ogg"
    nvl_hecheng "그렇게까지 어려워할 것 없어. 같은 반 친구를 조금 도왔을 뿐이야."


translate japanese plot9_3273caab:


    voice "voice/hecheng_153.ogg"
    nvl_hecheng "앞으로 학교에서 반장한테 도움받을 일이 있을지도 모르니까."


translate japanese plot9_97390b46:


    voice "voice/banzhang_448.ogg"
    nvl_yunqiu "제가 할 수 있는 일이라면 뭐든 말씀하세요!" (**end_page())


translate japanese plot9_275f3298:


    voice "voice/hecheng_154.ogg"
    nvl_hecheng "후후, 알았어." (**end_page())


translate japanese plot9_7463cb55:


    nvlNone "그때의 나는 츠루기의 미소가 무슨 뜻인지 몰랐다."


translate japanese plot9_8cd455fa:


    nvlNone "차가워 보여도 사실은 다정한 사람이라고 생각했다. 그 미소도 친하게 지내자는 뜻인 줄 알았다." (**end_page())


translate japanese plot9_fb39ebaf:


    nvlNone "하지만 그때 아무것도 몰랐어도 상관없었다."


translate japanese plot9_e3031955:


    nvlNone "곧 알게 될 테니까……" (**end_page())


translate japanese plot9_7e242b43:


    nvl clear
    nvlNone "——츠루기의 본성을." (**end_page())


translate japanese plot9_0c615e4e:


    nvl_hecheng "반장, 주말 숙제 좀 빌려줘."


translate japanese plot9_b09c3cb9:


    voice "voice/banzhang_449.ogg"
    nvl_yunqiu "네? 츠루기 씨, 숙제 안 하셨어요?"


translate japanese plot9_d59823cd:


    voice "voice/hecheng_156.ogg"
    nvl_hecheng "주말에 집안 모임에 가느라 쓸 시간이 없었어." (**end_page())


translate japanese plot9_630eb7d5:


    nvl clear
    voice "voice/banzhang_450.ogg"
    nvl_yunqiu "그럼……일단 빌려드릴게요."


translate japanese plot9_9e26c83b:


    voice "voice/banzhang_451.ogg"
    nvl_yunqiu "하지만 전부 그대로 베끼지는 마세요. 선생님이 의심하시니까요."


translate japanese plot9_750702c2:


    voice "voice/hecheng_157.ogg"
    nvl_hecheng "알아." (**end_page())


translate japanese plot9_c3601b33:


    nvl clear
    nvlNone "츠루기가 거짓말한다는 건 알았지만, 그래도 숙제를 건넸다."


translate japanese plot9_69c2b357:


    nvlNone "도와주겠다고 약속했으니 자세히 물을 필요도 없다고 생각했다."


translate japanese plot9_3526d84b:


    nvlNone "츠루기는 이 학교의 대다수 학생과 달랐다." (**end_page())


translate japanese plot9_7b903e9e:


    nvl clear
    nvlNone "공부에는 의욕이 전혀 없었고, 성적도 늘 반에서 하위권이었다."


translate japanese plot9_10b9b9ba:


    nvlNone "그녀는 공부할 필요가 없었기 때문이다."


translate japanese plot9_ca989150:


    nvlNone "집안에서 학교에 거액을 기부했고\n그 덕분에 입학했다는 건 누구나 알았다." (**end_page())


translate japanese plot9_0bf5eb4b:


    nvlNone "이곳은 명문 고등학교다."


translate japanese plot9_19254bbd:


    nvlNone "그래서 츠루기처럼 집안의 힘으로 들어오는 학생도 자연스럽게 모인다."


translate japanese plot9_abda70f1:


    nvlNone "앞으로 대학 입시에서 아무리 낮은 점수를 받아도 큰돈을 내면 어떤 대학이든 들어갈 수 있다." (**end_page())


translate japanese plot9_58aabb03:


    nvl clear
    nvlNone "이 고등학교에 다니는 것도\n이력을 돋보이게 하려는 것뿐이었다." (**end_page())


translate japanese plot9_3fdfa21a:


    nvl_yunqiu "주말 숙제는 이 페이지부터 여기까지예요."


translate japanese plot9_3f764ae8:


    voice "voice/hecheng_158.ogg"
    nvl_hecheng "많네. 이런 걸 잘도 다 끝냈다."


translate japanese plot9_ebc5c05e:


    voice "voice/banzhang_453.ogg"
    nvl_yunqiu "그 정도는 아니에요. 쉬운 문제들뿐이니까요." (**end_page())


translate japanese plot9_7ba4f9d5:


    nvlNone "그 무렵부터 츠루기는 내게 여러 가지를 부탁하기 시작했다."


translate japanese plot9_69ba0567:


    nvlNone "츠루기일 때도 있었고, 늘 함께 다니는 두 사람일 때도 있었다." (**end_page())


translate japanese plot9_de9990c2:


    nvl_hecheng "반장. 훈련 끝나면\n내 물병을 교실로 가져다줘. 난 먼저 갈게."


translate japanese plot9_62a35b4b:


    voice "voice/banzhang_454.ogg"
    nvl_yunqiu "알았어요. 거기 놓아두세요." (**end_page())


translate japanese plot9_90f7a48f:


    nvl_student_a "반장, 반장. 이거 이 선생님께 가져다줄래?"


translate japanese plot9_0d91e068:


    voice "voice/xizhen_26.ogg"
    nvl_student_a "어제 손을 삐어서——"


translate japanese plot9_49a58530:


    voice "voice/banzhang_455.ogg"
    nvl_yunqiu "제가 옮길게요." (**end_page())


translate japanese plot9_c0ef75db:


    nvl_student_b "반장. 이따 휴게실 청소 좀 해 줄래?"


translate japanese plot9_5e4fe1f4:


    voice "voice/minying_18.ogg"
    nvl_student_b "츠루기가 불러서. 계속 기다리게 하기도 그렇잖아."


translate japanese plot9_4f626263:


    voice "voice/banzhang_456.ogg"
    nvl_yunqiu "알았어요. 저한테 맡기세요." (**end_page())


translate japanese plot9_8cfc9ec0:


    nvlNone "「반장——반장——」"


translate japanese plot9_442941ca_1:


    nvlNone "…" (**end_page())


translate japanese plot9_ce7fae5a:


    nvlNone "그렇게 나는 몇 번이고 「반장」이라\n불리며, 그때마다 부려졌다."


translate japanese plot9_f3614028:


    nvlNone "처음에는 그렇게 싫지 않았다.\n부탁받은 일도 어렵지 않았다."


translate japanese plot9_7e7bc6c2:


    nvlNone "시간을 조금 들이면 끝나는 일뿐이라\n쉽게 도와줄 수 있었다." (**end_page())


translate japanese plot9_ddf6a3aa:


    nvl clear
    nvlNone "바쁠 때는 거절하기도 했지만\n그 이상 뭐라고 하지는 않았다."


translate japanese plot9_3c6d318e:


    nvlNone "그날 전까지는——" (**end_page())


translate japanese plot9_6899821a:


    nvlNone "그날 체육 시간에도, 우리 체육 특기생은 평소처럼 운동장에서 몸을 풀고 있었다." (**end_page())


translate japanese plot9_806657c8:


    voice "voice/hecheng_160.ogg"
    nvl_hecheng "반장. 잠깐 와 봐."


translate japanese plot9_e3fabfe6:


    voice "voice/banzhang_457.ogg"
    nvl_yunqiu "네? 곧 수업인데요. 무슨 일이에요, 츠루기 씨?"


translate japanese plot9_134b1d41:


    voice "voice/hecheng_161.ogg"
    nvl_hecheng "……잠깐이면 돼. 금방 끝나." (**end_page())


translate japanese plot9_c75489cf:


    nvlNone "우리는 체육 특기생 휴게실로 돌아갔다." (**end_page())


translate japanese plot9_e5e252ea:


    nvlNone "츠루기는 잔뜩 굳은 얼굴이었다. 지금도 기분이 나쁜 듯했다."


translate japanese plot9_8a0fbba9:


    voice "voice/banzhang_458.ogg"
    nvl_yunqiu "츠루기 씨, 왜 그러세요?"


translate japanese plot9_55fa6b43:


    voice "voice/hecheng_162.ogg"
    nvl_hecheng "음……" (**end_page())


translate japanese plot9_8467fe21:


    nvl clear
    nvlNone "츠루기는 말없이 나를 바라보았다. 그녀에게서 풍기는 기운에 등골이 서늘해졌다."


translate japanese plot9_9174d5df:


    nvlNone "——지금은 내가 끼어들 때가 아니니, 조용히 있으라고. 그런 말을 듣는 것 같았다."


translate japanese plot9_52e8edff:


    voice "voice/hecheng_163.ogg"
    nvl_hecheng "반장……부탁이 하나 있는데." (**end_page())


translate japanese plot9_adb45442:


    nvl clear
    voice "voice/banzhang_459.ogg"
    nvl_yunqiu "저기, 뭔가요?"


translate japanese plot9_741e9480:


    voice "voice/hecheng_164.ogg"
    nvl_hecheng "……이따 체육 시험에서 조금만 힘을 빼 줄래?"


translate japanese plot9_5944e916:


    voice "voice/banzhang_460.ogg"
    nvl_yunqiu "어?" (**end_page())


translate japanese plot9_963c2b34:


    nvl clear
    voice "voice/hecheng_165.ogg"
    nvl_hecheng "이따 체육 특기생들 체육 시험이 있어. 모르는 건 아니지?"


translate japanese plot9_f6c50b59:


    voice "voice/banzhang_461.ogg"
    nvl_yunqiu "알아요. 하지만……"


translate japanese plot9_a0436384:


    voice "voice/banzhang_462.ogg"
    nvl_yunqiu "시험에서 일부러 힘을 빼는 건……좋지 않은 것 같은데요." (**end_page())


translate japanese plot9_0f9afe26:


    nvlNone "그 부탁을 받아들일 수는 없었다."


translate japanese plot9_4eec6dd7:


    nvlNone "이따 나오는 결과는 한 학기 전체 성적에 들어간다. 체육 특기생인 우리에게는 아주 중요한 시험이었다." (**end_page())


translate japanese plot9_806be72a:


    voice "voice/hecheng_166.ogg"
    nvl_hecheng "그렇게까지 봐줄 필요는 없어. 나보다 앞서지만 않으면 돼." (**end_page())


translate japanese plot9_e6d39b66:


    nvl clear
    voice "voice/banzhang_463.ogg"
    nvl_yunqiu "하, 하지만……"


translate japanese plot9_38995097:


    voice "voice/hecheng_167.ogg"
    nvl_hecheng "부탁할게, 반장. 이번 한 번만."


translate japanese plot9_b3a22baf:


    voice "voice/hecheng_168.ogg"
    nvl_hecheng "이번 시험은 내게 중요해. 부모님은 내가 반에서 1등 하는 걸 보고 싶어 하셔." (**end_page())


translate japanese plot9_e94bce72:


    nvl clear
    voice "voice/banzhang_464.ogg"
    nvl_yunqiu "하지만……"


translate japanese plot9_264bee73:


    voice "voice/banzhang_465.ogg"
    nvl_yunqiu "죄송해요, 츠루기 씨……이번에는 도와드릴 수 없어요."


translate japanese plot9_feefda25:


    voice "voice/banzhang_466.ogg"
    nvl_yunqiu "저도 이번 시험에서 좋은 결과를 내야 해요." (**end_page())


translate japanese plot9_da03e465:


    nvl clear
    voice "voice/banzhang_467.ogg"
    nvl_yunqiu "함께 최선을 다해서 달리면 안 될까요?" (**end_page())


translate japanese plot9_9a721a57:


    nvlNone "탁!"


translate japanese plot9_7808d5b8:


    nvlNone "메마른 소리가 났다. 무슨 소리인지 바로 알 수 없었다." (**end_page())


translate japanese plot9_34f99a3b:


    "そのあとで、左の頬が焼けるように痛み始めた。"


translate japanese plot9_f5751b1e:


    voice "voice/banzhang_468.ogg"
    nvl_yunqiu "네……? 츠루기 씨……?"


translate japanese plot9_2f67b2b3:


    voice "voice/hecheng_169.ogg"
    nvl_hecheng "됐어. 나보다 빨리 달린다고 자랑하고 싶은 거야?" (**end_page())


translate japanese plot9_6c12221d:


    nvl clear
    voice "voice/hecheng_170.ogg"
    nvl_hecheng "난 언제나 최선을 다해서 달려."


translate japanese plot9_2e6c748d:


    voice "voice/hecheng_171.ogg"
    nvl_hecheng "그래도 매번 네 성적이 나보다 위야. 난 줄곧 반에서 2등이고." (**end_page())


translate japanese plot9_6cf2c1b2:


    nvl clear
    voice "voice/hecheng_172.ogg"
    nvl_hecheng "몰랐어? 그런데 잘도 그런 말을 하네."


translate japanese plot9_d9ba6901:


    voice "voice/hecheng_173.ogg"
    nvl_hecheng "나한테 시비 거는 거야? 어!?" (**end_page())


translate japanese plot9_92ca8c0d:


    nvlNone "츠루기의 목소리는 점점 커졌다. 나는 겁먹은 햄스터처럼 구석에서 작게 웅크렸다."


translate japanese plot9_6c8448e9:


    voice "voice/banzhang_469.ogg"
    nvl_yunqiu "저, 저는……" (**end_page())


translate japanese plot9_04d47746:


    nvlNone "머릿속이 새하얘져 아무 말도 할 수 없었다."


translate japanese plot9_8120f330:


    nvlNone "말이 잇달아 쏟아져 들어와,\n무서워서 그 자리에 선 채 꼼짝도 할 수 없었다." (**end_page())


translate japanese plot9_a91311a7:


    nvl clear
    nvlNone "방금 맞은 따귀 때문에 무슨 일이 일어난 건지도 알 수 없게 되었다."


translate japanese plot9_6da26562:


    nvlNone "「왜 이런 짓을 하는 거야?」"


translate japanese plot9_392034ab:


    nvlNone "「우리 친구 아니었어?」" (**end_page())


translate japanese plot9_71d3e194:


    nvl clear
    nvlNone "「왜 날 때려?」"


translate japanese plot9_6d26df38:


    nvlNone "마음속에는 묻고 싶은 말이 가득했다. 하지만 단 한마디도 꺼낼 수 없었다."


translate japanese plot9_a2e1d0a7:


    nvl_hecheng "잘 들어. 난 너한테 부탁하는 게 아니야."


translate japanese plot9_a8cf60de:


    voice "voice/hecheng_175.ogg"
    nvl_hecheng "내 말대로 하기만 하면 돼."


translate japanese plot9_14994ff1:


    voice "voice/hecheng_176.ogg"
    nvl_hecheng "말했잖아——「제가 할 수 있는 거라면 뭐든 도와드릴게요」라고." (**end_page())


translate japanese plot9_a41fc8e4:


    voice "voice/hecheng_177.ogg"
    nvl_hecheng "안 그래?" (**end_page())


translate japanese plot9_49bad6f4:


    nvlNone "그 뒤{p}체육 시간에 무슨 일이 있었는지는 이제 잘 기억나지 않는다."


translate japanese plot9_029809a8:


    nvlNone "절대 잊을 수 없을 만한 일이었는데\n어째서인지 아주 먼 옛날처럼 느껴진다."


translate japanese plot9_6ee8badb:


    nvlNone "기억나는 것은 그 체육 시간에\n끔찍한 기록을 냈다는 것뿐이었다."


translate japanese plot9_b5b14c17:


    nvlNone "멍한 상태로 움직였으니 당연한 일이었다."


translate japanese plot9_0b635fbc:


    nvlNone "츠루기는 그 시험에서 체육 특기생 중 1등을 했다." (**end_page())


translate japanese plot9_bd2678cb:


    nvlNone "체육 선생님은 별로 신경 쓰지 않았다.{p}그날은 컨디션이 나빠\n평소 실력이 안 나왔을 뿐이라고 생각하신 모양이다."


translate japanese plot9_72fa3d4c:


    nvlNone "체육이 끝나자, 츠루기는 다시 나를 휴게실에 남게 했다." (**end_page())


translate japanese plot9_3e33d6bd:


    voice "voice/hecheng_178.ogg"
    nvl_hecheng "봐. 제대로 할 수 있잖아."


translate japanese plot9_471e741d:


    voice "voice/hecheng_179.ogg"
    nvl_hecheng "그렇다고 너무 힘을 빼지는 마.\n민영 애들보다 느리면 선생님이 의심하잖아?"


translate japanese plot9_6409d14f:


    voice "voice/hecheng_180.ogg"
    nvl_hecheng "다음에는 바로 내 뒤에서 달려. 반·장." (**end_page())


translate japanese plot9_65929921:


    nvl clear
    voice "voice/banzhang_470.ogg"
    nvl_yunqiu "히익!?"


translate japanese plot9_9ebff2b0:


    voice "voice/hecheng_181.ogg"
    nvl_hecheng "뭐야, 그렇게 무서워하지 마."


translate japanese plot9_db3fd9c9:


    voice "voice/hecheng_182.ogg"
    nvl_hecheng "뺨 아직 아파? 미안. 나도 그렇게 거칠게 굴고 싶지는 않았어." (**end_page())


translate japanese plot9_5950e4b9:


    nvl clear
    voice "voice/hecheng_183.ogg"
    nvl_hecheng "하지만 말로 납득시키려면 시간이 걸리니까. 이쪽이 더 빨라."


translate japanese plot9_7f846897:


    voice "voice/banzhang_471.ogg"
    nvl_yunqiu "마, 만지지 마세요……"


translate japanese plot9_9cfdfa92:


    nvlNone "내가 싫어해도 아무 의미 없었다." (**end_page())


translate japanese plot9_59ca9937:


    nvl clear
    nvlNone "츠루기는 어린아이를 대하듯 내 머리에 손을 얹고\n마음대로 머리카락을 헝클었다."


translate japanese plot9_84c150e7:


    voice "voice/hecheng_184.ogg"
    nvl_hecheng "그럼 앞으로도 잘 지내자, 반장?" (**end_page())


translate japanese plot9_7ec9fa09:


    nvlNone "그 뒤로 츠루기는 다른 사람들 앞에서는 나와 어울리지 않았다."


translate japanese plot9_7d89643f:


    nvlNone "다른 사람이 보기에는 갑자기 다투기라도 해서\n말을 하지 않는 것처럼 보였을 것이다."


translate japanese plot9_6165aa7a:


    nvlNone "숙제, 청소, 심부름……"


translate japanese plot9_4325bfd9:


    nvlNone "一度、本当の顔を見せてからは、さらにひどくなった。"


translate japanese plot9_f2ec322c:


    nvlNone "그때의 나는 아무 말 없이 전부 받아들였다."


translate japanese plot9_45fd53b6:


    nvlNone "줄곧 츠루기가 무서웠다."


translate japanese plot9_5985d798:


    nvlNone "먹잇감을 몰아붙이는 사냥꾼 같았다."


translate japanese plot9_ce54e9c0:


    nvlNone "내가 약하다는 것을 알아챈 순간부터{p}츠루기에게 나는 이미 도망칠 수 없는 먹잇감이었다."


translate japanese plot9_691012d2:


    nvlNone "귀찮은 일을 대신하는 것뿐이라면 그래도 견딜 수 있었다."


translate japanese plot9_aedd7992:


    nvlNone "하지만 츠루기는 그것으로 만족하지 않았다." (**end_page())


translate japanese plot9_520e7dff:


    voice "voice/minying_19.ogg"
    nvl_student_b "반장."


translate japanese plot9_17551996:


    voice "voice/banzhang_472.ogg"
    nvl_yunqiu "네……? 무슨 일이에요?"


translate japanese plot9_03b74cde:


    voice "voice/minying_20.ogg"
    nvl_student_b "말없이 따라와." (**end_page())


translate japanese plot9_65670197:


    nvl clear
    voice "voice/banzhang_473.ogg"
    nvl_yunqiu "……네. 알겠습니다." (**end_page())


translate japanese plot9_27fb6cbf:


    nvlNone "민영이 저렇게 말한다면, 츠루기가 나를 부르는 것이다."


translate japanese plot9_3bbcd165:


    nvlNone "나와 민영 사이에는 츠루기 말고 이야기할 것이 없었다."


translate japanese plot9_b7d24763:


    nvlNone "끌려간 곳은 운동장 구석이었다.\n원예부보다도 사람이 찾아오지 않는 곳이다." (**end_page())


translate japanese plot9_f3e021ad:


    voice "voice/hecheng_185.ogg"
    nvl_hecheng "아, 반장. 한참 기다렸어."


translate japanese plot9_d4719f01:


    voice "voice/banzhang_474.ogg"
    nvl_yunqiu "츠루기 씨……"


translate japanese plot9_4075645b:


    voice "voice/hecheng_186.ogg"
    nvl_hecheng "그러니까 그렇게 겁먹지 말라니까. 내가 무슨 엄청 나쁜 사람 같잖아." (**end_page())


translate japanese plot9_51e1fded:


    nvl clear
    voice "voice/hecheng_187.ogg"
    nvl_hecheng "지난번에는 나도 심했어."


translate japanese plot9_f81ec5fb:


    voice "voice/hecheng_188.ogg"
    nvl_hecheng "그래서 오늘은 더 친해지려고 데려온 거야."


translate japanese plot9_9aacecd8:


    voice "voice/hecheng_189.ogg"
    nvl_hecheng "봐——" (**end_page())


translate japanese plot9_9e33384e:


    nvlNone "츠루기가 가리킨 쪽을 보았다."


translate japanese plot9_c42f1c88:


    nvlNone "덤불 옆에 늙고 다리를 저는 떠돌이 개가 있었다."


translate japanese plot9_87a6f0e8:


    nvlNone "개는 몸을 웅크리고\n우리에게서 달아나듯 덤불 속으로 숨으려 했다."


translate japanese plot9_e12dc0bd:


    voice "voice/banzhang_475.ogg"
    nvl_yunqiu "츠루기 씨, 이건……"


translate japanese plot9_2bc71726:


    voice "voice/hecheng_190.ogg"
    nvl_hecheng "학교에 들어온 떠돌이 개야."


translate japanese plot9_ca98a949:


    voice "voice/hecheng_191.ogg"
    nvl_hecheng "이거 굉장히 위험하거든." (**end_page())


translate japanese plot9_c699f309:


    nvl clear
    voice "voice/hecheng_192.ogg"
    nvl_hecheng "아무 이유 없이 사람을 물고, 광견병에, 몸에 붙은 기생충까지……"


translate japanese plot9_d8f14f68:


    voice "voice/hecheng_193.ogg"
    nvl_hecheng "전부 학생들을 위험하게 만드는 것들이잖아. 안 그래?"


translate japanese plot9_ff60571f:


    voice "voice/hecheng_194.ogg"
    nvl_hecheng "다행히 누굴 해치기 전에 우리가 잡았지." (**end_page())


translate japanese plot9_f898cf1d:


    nvl clear
    voice "voice/hecheng_195.ogg"
    nvl_hecheng "이제 남은 건……" (**end_page())


translate japanese plot9_452afebf:


    nvlNone "휙——!"


translate japanese plot9_9a721a57_1:


    nvlNone "탁!"


translate japanese plot9_e19428fa:


    voice "voice/dog_01.ogg"
    nvlNone "「깨갱깨갱——!」" (**end_page())


translate japanese plot9_24e1f8a8:


    nvl clear
    nvlNone "츠루기는 긴 막대기를 두 손으로 쥐고 개를 향해 내리쳤다."


translate japanese plot9_90ffe4f8:


    nvlNone "막대기가 바람을 가르며 마른 소리를 냈다." (**end_page())


translate japanese plot9_e9fbf2d7:


    nvl_hecheng "후후…"


translate japanese plot9_82c6a7df:


    nvlNone "개가 애처롭게 울어도 츠루기는 멈추지 않았다."


translate japanese plot9_dde0d554:


    nvlNone "——오히려 웃고 있었다." (**end_page())


translate japanese plot9_2938a208:


    nvl clear
    voice "voice/hecheng_197.ogg"
    nvl_hecheng "아——위험한 걸 없애는 이 기분."


translate japanese plot9_9c2f6051:


    voice "voice/hecheng_198.ogg"
    nvl_hecheng "이보다 즐거운 일이 또 있을까?" (**end_page())


translate japanese plot9_8884f786:


    nvlNone "퍽! 퍽! 퍽!"


translate japanese plot9_8cc6f79c:


    nvlNone "츠루기는 연달아 몇 번이고 막대기를 내리쳤다.\n나는 겁에 질려 몇 번이고 뒷걸음질했다."


translate japanese plot9_600d75e5:


    voice "voice/dog_02.ogg"
    nvlNone "「끄응……」"


translate japanese plot9_b2f2a327:


    nvlNone "개의 울음은 점점 작아졌고\n대신 몸 안에서 낮게 끓는 듯한 신음이 들려왔다."


translate japanese plot9_1ba79944:


    nvlNone "이제 스스로 움직일 힘도 남아 있지 않았다." (**end_page())


translate japanese plot9_d8e0d73e:


    voice "voice/hecheng_199.ogg"
    nvl_hecheng "어머, 반장."


translate japanese plot9_fa6d1a08:


    voice "voice/hecheng_200.ogg"
    nvl_hecheng "무서워하지 않아도 돼. 모두를 위해\n위험한 걸 치우고 있을 뿐이니까."


translate japanese plot9_928dd485:


    voice "voice/hecheng_201.ogg"
    nvl_hecheng "이런 떠돌이 개가 밖에서 사람을 물면 큰일 나잖아." (**end_page())


translate japanese plot9_410737d4:


    nvl clear
    voice "voice/hecheng_202.ogg"
    nvl_hecheng "그렇지?"


translate japanese plot9_de644584:


    voice "voice/banzhang_476.ogg"
    nvl_yunqiu "츠루기 씨……저는……"


translate japanese plot9_c2f464a2:


    voice "voice/hecheng_203.ogg"
    nvl_hecheng "응? 설마……이 떠돌이 개가 불쌍하다고 생각해?" (**end_page())


translate japanese plot9_01b4c8a2:


    nvl clear
    nvlNone "츠루기가 전과 같은 눈으로 나를 바라보았다. 나는 다른 대답을 할 수 없었다."


translate japanese plot9_aa3346fa:


    voice "voice/banzhang_477.ogg"
    nvl_yunqiu "아, 아니에요, 츠루기 씨……그런 건……"


translate japanese plot9_2ea6eb54:


    voice "voice/hecheng_204.ogg"
    nvl_hecheng "그래. 그거면 돼. 그냥 떠돌이 개일 뿐이야." (**end_page())


translate japanese plot9_b5964864:


    nvl clear
    voice "voice/hecheng_205.ogg"
    nvl_hecheng "그럼 나머지는 너한테 맡길게. 자, 받아——"


translate japanese plot9_5944e916_1:


    voice "voice/banzhang_478.ogg"
    nvl_yunqiu "어?" (**end_page())


translate japanese plot9_4d6d9cf1:


    nvl clear
    nvlNone "무슨 일인지 이해하기도 전에, 츠루기가 손에 든 막대기를 던졌다."


translate japanese plot9_d0642c07:


    voice "voice/banzhang_479.ogg"
    nvl_yunqiu "뭐……" (**end_page())


translate japanese plot9_c91703bf:


    voice "voice/hecheng_206.ogg"
    nvl_hecheng "어라, 아직도 모르겠어?"


translate japanese plot9_b0201949:


    voice "voice/hecheng_207.ogg"
    nvl_hecheng "반장이라면 바로 알아챌 줄 알았는데." (**end_page())


translate japanese plot9_cad413ac:


    voice "voice/hecheng_208.ogg"
    nvl_hecheng "아니면——알면서 모르는 척하는 거야?"


translate japanese plot9_925d99b6:


    voice "voice/hecheng_209.ogg"
    nvl_hecheng "……이 개의 숨통을 끊어." (**end_page())


translate japanese plot9_e9205e05:


    nvl clear
    voice "voice/banzhang_480.ogg"
    nvl_yunqiu "아, 아니요……그건……"


translate japanese plot9_2e7779f8:


    voice "voice/banzhang_481.ogg"
    nvl_yunqiu "저는……할 수 없……" (**end_page())


translate japanese plot9_a788e49d:


    voice "voice/hecheng_210.ogg"
    nvl_hecheng "쉿. 그런 말은 듣고 싶지 않아."


translate japanese plot9_0e9bbbd9:


    voice "voice/hecheng_211.ogg"
    nvl_hecheng "어렵지 않잖아?" (**end_page())


translate japanese plot9_7bb79e6e:


    voice "voice/hecheng_212.ogg"
    nvl_hecheng "아니면 내가 손을 잡고 가르쳐 줄까?"


translate japanese plot9_53463d5d:


    voice "voice/hecheng_213.ogg"
    nvl_hecheng "자, 이렇게. 두 손으로 여길 잡아." (**end_page())


translate japanese plot9_7fb4cbf3:


    nvl clear
    voice "voice/hecheng_214.ogg"
    nvl_hecheng "그래, 꽉 잡고. 이러면 허리 힘을 쓸 수 있어."


translate japanese plot9_304fad5b:


    voice "voice/hecheng_215.ogg"
    nvl_hecheng "체육 선생님도 그러셨잖아? 허리 힘이 중요하다고." (**end_page())


translate japanese plot9_48cb398f:


    nvl clear
    voice "voice/banzhang_482.ogg"
    nvl_yunqiu "그만해요, 츠루기 씨……"


translate japanese plot9_dc11fadd:


    voice "voice/hecheng_216.ogg"
    nvl_hecheng "집중해! 딴생각하지 말고!" (**end_page()) with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot9_78238f2f:


    nvl clear
    voice "voice/banzhang_483.ogg"
    nvl_yunqiu "히익!"


translate japanese plot9_bca33a39:


    voice "voice/hecheng_217.ogg"
    nvl_hecheng "그래. 그대로 막대기를 들어." (**end_page())


translate japanese plot9_ce100a3a:


    nvl clear
    voice "voice/hecheng_218.ogg"
    nvl_hecheng "이 막대기는 우리한테 너무 가벼워서 힘을 싣기가 좀 어렵네."


translate japanese plot9_f11ce422:


    voice "voice/hecheng_219.ogg"
    nvl_hecheng "그래도 괜찮아. 아까,\n쥐약을 잔뜩 먹였거든. 이제 움직이지 못해." (**end_page())


translate japanese plot9_b6dbbf78:


    nvl clear
    voice "voice/hecheng_220.ogg"
    nvl_hecheng "자, 머리를 똑바로 노려, 알았지?"


translate japanese plot9_3aa403e2:


    voice "voice/hecheng_221.ogg"
    nvl_hecheng "다른 데 맞히면 한 번 더 해야 하니까." (**end_page())


translate japanese plot9_77de235a:


    nvl clear
    voice "voice/hecheng_222.ogg"
    nvl_hecheng "가능한 한 고통 없이, 한 번에 끝내 줘."


translate japanese plot9_229cfd3e:


    voice "voice/banzhang_484.ogg"
    nvl_yunqiu "못 해요……전 못 해요, 츠루기 씨……" (**end_page())


translate japanese plot9_4b8f12c4:


    voice "voice/hecheng_223.ogg"
    nvl_hecheng "응? 왜?"


translate japanese plot9_45d532d5:


    voice "voice/banzhang_485.ogg"
    nvl_yunqiu "못 하겠어요……" (**end_page())


translate japanese plot9_b0cb17c0:


    voice "voice/hecheng_224.ogg"
    nvl_hecheng "머리 위로 든 막대기를 내리치기만 하면 되는데?"


translate japanese plot9_b7148832:


    voice "voice/banzhang_486.ogg"
    nvl_yunqiu "저는……" (**end_page())


translate japanese plot9_858d28ab:


    nvl clear
    voice "voice/hecheng_225.ogg"
    nvl_hecheng "음……그럼 다르게 말해 볼게."


translate japanese plot9_38f0106d:


    voice "voice/hecheng_226.ogg"
    nvl_hecheng "엄마를 생각해 봐. 일하는 모습을——" (**end_page())


translate japanese plot9_7194d014:


    nvl clear
    voice "voice/hecheng_227.ogg"
    nvl_hecheng "그러면 머리가 조금은 돌아가지 않을까?" (**end_page())


translate japanese plot9_1ce475cc:


    nvlNone "——엄마!" (**end_page())


translate japanese plot9_e4f62951:


    nvl clear
    nvlNone "츠루기가 노골적으로 나를 협박한다는 걸 알았다."


translate japanese plot9_d99722d6:


    "でもお母さんのことを言われた途端、頭の動きが止まり、何も考えられなくなった。"


translate japanese plot9_5f562a57:


    nvlNone "퍽——"


translate japanese plot9_ab903524:


    nvlNone "마른 소리가 다시 울렸다." (**end_page())


translate japanese plot9_178bacde:


    nvl clear
    nvlNone "내 의지로 휘둘렀는지, 아니면 츠루기가 손을 잡고 억지로 휘두르게 했는지는 모르겠다."


translate japanese plot9_ea39d97d:


    nvlNone "어쨌든, 나는 막대기를 내리쳤다." (**end_page())


translate japanese plot9_8e752488:


    nvlNone "아까의 츠루기처럼\n거의 움직이지 못하는 개를 향해 막대기를 휘둘렀다."


translate japanese plot9_bce8fa21:


    nvlNone "막대기는 정확히 머리에 맞아, 개의 고통을 끝냈다." (**end_page())


translate japanese plot9_b4994460:


    voice "voice/hecheng_228.ogg"
    nvl_hecheng "봐. 잘할 수 있잖아."


translate japanese plot9_79863975:


    voice "voice/hecheng_229.ogg"
    nvl_hecheng "정확하게 머리를 맞혔네. 잘했어, 반장." (**end_page())


translate japanese plot9_3a1752b0:


    voice "voice/hecheng_230.ogg"
    nvl_hecheng "다시 봤어. 하하……하하하하……" (**end_page())


translate japanese plot9_997ccf5c:


    nvl clear
    nvlNone "츠루기는 망연자실한 채 볼품없이 서 있는 나와 방금 꺼진 생명을 보며 웃었다."


translate japanese plot9_87ed65c0:


    nvlNone "그런 웃음은 본 적이 없었다. 츠루기도\n저런 표정을 지을 수 있나 싶을 정도였다."


translate japanese plot9_719b30cb:


    nvlNone "나중에야 알았다. 마음 깊은 곳부터 충족되었을 때만\n그렇게 웃는다는 것을." (**end_page())


translate japanese plot9_b2cf5114:


    nvl clear
    nvlNone "아무것도 감추지 않은, 츠루기의 내면이 그대로 드러난 얼굴이었다." (**end_page())


translate japanese plot9_853f02e2:


    voice "voice/gt_12.ogg"
    nvl_npc14 "하하하하……"


translate japanese plot9_9ac360aa:


    nvlNone "옆에서 줄곧 말없던 민영과 희진도 웃었다."


translate japanese plot9_2e37b6cb:


    nvlNone "창백한 얼굴로 억지로 끔찍한 미소를 짓고 있었다." (**end_page())


translate japanese plot9_e8e0a2e7:


    nvl clear
    nvlNone "두려워도 츠루기에 맞춰 웃을 수밖에 없었던 것이다." (**end_page())


translate japanese plot9_a7d44c88:


    nvlNone "츠루기도 당연히 알고 있었다."


translate japanese plot9_ec011053:


    nvlNone "그저 모든 것을 즐기고 있었다."


translate japanese plot9_630e9d20:


    nvlNone "츠루기에게는 그런 「감정」이 모두 더없이 훌륭한 진수성찬이었다." (**end_page())


translate japanese plot9_e483347a:


    nvl clear
    nvlNone "곁의 두 「친구」가 자신을 두려워하는 마음조차도." (**end_page())


translate japanese plot9_fb0e5d9c:


    nvlNone "그때야 비로소 알았다."


translate japanese plot9_0ee10ef1:


    nvlNone "나도 민영 일행도 츠루기에게는 다를 것이 없었다."


translate japanese plot9_85ca3039:


    nvlNone "모두 츠루기의 먹잇감이었다." (**end_page())


translate japanese plot9_49199277:


    nvlNone "「우욱——콜록——!」"


translate japanese plot9_78f98a8c:


    nvlNone "몇 번이나 토했는지 이제 모르겠다."


translate japanese plot9_18f0a107:


    nvlNone "그 장면이 머릿속에서 몇 번이고 되풀이되었다. 지금도 그 막대기를 손에 쥐고 있는 것 같았다."


translate japanese plot9_4683836f:


    nvlNone "막대기를 휘두를 때 손에 느껴진 감각도, 바람을 가르던 마른 소리도."


translate japanese plot9_86a0a302:


    nvlNone "「우웩——콜록——!」"


translate japanese plot9_f049cfd7:


    voice "voice/nvlbanzhang_05.ogg"
    nvlNone "「하아……하아……하아……」"


translate japanese plot9_8c97f0e9:


    nvlNone "숨을 헐떡이며\n필사적으로 세면대에서 계속 얼굴을 씻었다."


translate japanese plot9_aa00f897:


    nvlNone "얼마나 지났는지 알 수 없었다."


translate japanese plot9_11ef1255:


    nvlNone "그제야 마음이 조금 진정되었다."


translate japanese plot9_6d110328:


    nvl_yunqiu "윽……" (**end_page())


translate japanese plot9_f6d4d463:


    voice "voice/mama_71.ogg"
    nvl_mama "아키, 괜찮니?"


translate japanese plot9_f0d2899d:


    voice "voice/banzhang_488.ogg"
    nvl_yunqiu "괜찮아, 엄마……생리 때문에 조금 속이 안 좋을 뿐이야……"


translate japanese plot9_4c9a155f:


    voice "voice/mama_72.ogg"
    nvl_mama "돌아와서 계속 화장실에 가잖니. 정말 괜찮아?" (**end_page())


translate japanese plot9_c50fbc55:


    nvl clear
    voice "voice/mama_73.ogg"
    nvl_mama "병원에 가는 게 좋지 않겠니?"


translate japanese plot9_14afd251:


    voice "voice/banzhang_489.ogg"
    nvl_yunqiu "괜찮아요, 엄마. 조금 쉬면 나을 거예요."


translate japanese plot9_1ea16f20:


    voice "voice/mama_74.ogg"
    nvl_mama "음……알았어." (**end_page())


translate japanese plot9_0503bdc2:


    nvl clear
    voice "voice/mama_75.ogg"
    nvl_mama "푹 쉬어. 그래도 나아지지 않으면,\n병원에 데려갈 테니까." (**end_page())


translate japanese plot9_8f211c2f:


    nvlNone "침대에 누워 늘 보던 천장을 바라보았다."


translate japanese plot9_e4cf8c95:


    nvlNone "왜일까."


translate japanese plot9_b43a903e:


    nvlNone "少し黄ばんだだけの天井さえ、今はとても怖く見えた。"


translate japanese plot9_0b8be8f6:


    voice "voice/nvlbanzhang_06.ogg"
    nvlNone "「진정해, 진정해……」"


translate japanese plot9_c83dfd08:


    nvlNone "정말 이상하다."


translate japanese plot9_6cdcf22a:


    nvlNone "「억지」와 「진정」은\n서로 정반대의 말이라고 생각했다."


translate japanese plot9_d5ae0d3b:


    nvlNone "그 뒤로 또 얼마나 지났는지 알 수 없었다."


translate japanese plot9_052b9a29:


    nvlNone "겨우 조금 졸음이 밀려왔다."


translate japanese plot9_4c4baab6:


    nvlNone "온종일 팽팽했던 마음이 아주 조금 풀렸다." (**end_page())


translate japanese plot9_3cdf39cc:


    nvlNone "그 뒤로도 츠루기는 종종 나를 자신의 「쇼」에 불렀다."


translate japanese plot9_b7d0bde0:


    nvlNone "작은 생명을 괴롭히는 일을 진심으로 즐겼다."


translate japanese plot9_3ffd3b06:


    nvlNone "막대기만이 아니라 여러 가지 칼로 고통을 주기도 했다."


translate japanese plot9_dec15ce3:


    nvlNone "몇 번이고, 몇 번이고." (**end_page())


translate japanese plot9_043b6f45:


    nvlNone "——그때마다 지독하게 속이 메스꺼워졌다." (**end_page())


translate japanese plot9_1b0bfa1d:


    nvlNone "민영과 희진도\n츠루기에 맞춰 웃는 척할 수밖에 없었다."


translate japanese plot9_7e423375:


    nvlNone "그런 때에만 츠루기는 진심으로 웃었다."


translate japanese plot9_379abbf6:


    nvlNone "생명을 해치는 즐거움. 사람을 괴롭히는 즐거움.\n해서는 안 되는 일을 하는 즐거움."


translate japanese plot9_c6f0b528:


    nvlNone "츠루기를 채워 주는 것은 그것뿐이었다." (**end_page())


translate japanese plot9_20594061:


    nvlNone "그런데 그 무렵 나는 이것이 괴롭힘이라는 것조차 깨닫지 못했다."


translate japanese plot9_bd9564e9:


    nvlNone "츠루기가 너무나 무서웠기 때문이다."


translate japanese plot9_591020d1:


    nvlNone "엄마의 일자리가 걱정돼 거역하지 못한 걸까."


translate japanese plot9_31a1bdbb:


    nvlNone "아니면 츠루기 집안의 힘이 무서웠던 걸까."


translate japanese plot9_c3cfa122:


    nvlNone "츠루기가 눈앞에 있기만 해도 판단할 수 없게 되었다."


translate japanese plot9_2e6eec7d:


    nvlNone "이윽고 츠루기는 내 주변에도 마수를 뻗기 시작했다."


translate japanese plot9_602b33a6:


    nvlNone "무슨 일이 있었는지는 모르지만, 느낄 수 있었다."


translate japanese plot9_69ef63b4:


    nvlNone "전에는 함께 웃고 떠들던 아이들도,"


translate japanese plot9_bb7862e6:


    nvlNone "이제 나를 보면 연신 시선을 피했다."


translate japanese plot9_c1d7cc90:


    nvlNone "곧 알았다. 틀림없이 츠루기가 모두를 협박했을 것이다."


translate japanese plot9_f98e1374:


    nvlNone "하지만 그것이야말로 츠루기가 바라던 일이었다."


translate japanese plot9_d55f37f0:


    nvlNone "반에서 나를 고립시키는 것. 그게 목적이었다."


translate japanese plot9_cd9cf47d:


    nvlNone "겉으로 보아서는 무슨 일이 일어나는지 알 수 없었다." (**end_page())


translate japanese plot9_8744989c:


    nvlNone "츠루기는 남의 눈에 띄지 않는 곳에서 움직이는 데 능숙했다.{p}조금씩 반 친구들의 관계까지 바꿔 나갔다."


translate japanese plot9_a67ef1fa:


    nvlNone "친구들뿐만이 아니었다. 내가 속한 원예부에도\n자주 나타나기 시작했다."


translate japanese plot9_d3fe5978:


    nvlNone "원예부는 운동장과 가깝다.{p}체육 특기생 훈련이 끝나면,\n츠루기 일행은 늘 이곳으로 왔다."


translate japanese plot9_30ce334b:


    nvlNone "원예부 친구들은 최대한 못 들은 척했다.{p}츠루기 일행이 없다고 생각하며 묵묵히 참았다."


translate japanese plot9_7eb9b5ae:


    nvlNone "식물까지 일부러 망가뜨리지는 않을까 걱정했다.{p}그런 일은 없었던 것만이 다행이었다."


translate japanese plot9_4065be1c:


    nvlNone "하지만 나 말고 다른 사람은 그 「쇼」에 불리지 않았다."


translate japanese plot9_af850761:


    voice "voice/nvlhengcheng_01.ogg"
    nvlNone "「반장은 날 배신하지 않으니까.」{p}「그래서 반장은 믿고 있어, 알지?」{p}「반장이라면 날 이해해 주겠지.」" (callback=nvl_page_voice, cb_page_voices=('voice/nvlhengcheng_01.ogg', 'voice/nvlhengcheng_02.ogg', 'voice/nvlhengcheng_03.ogg'))


translate japanese plot9_9bc4e491:


    nvlNone "하지만 나는 그런 변태적인 짓을 조금도 이해할 수 없었다."


translate japanese plot9_f2b79edb:


    nvlNone "그래도 츠루기 앞에서는 토하지 않고 아무 느낌 없는 척하며, 생명을 해치는 「쇼」를 계속 지켜보았다."


translate japanese plot9_8d857085:


    nvlNone "그래서 무슨 일이 있어도 참아야만 한다."


translate japanese plot9_a0017796:


    nvlNone "참아."


translate japanese plot9_9e7478e1:


    nvl_xiaoxia "반장, 그 사람들이 또 왔어……"


translate japanese plot9_fbd97ee1:


    voice "voice/xiaoxia_128.ogg"
    nvl_xiaoxia "이러다간 계속 동아리실을 제멋대로 쓰게 될 거야."


translate japanese plot9_fec4b8c2:


    voice "voice/banzhang_490.ogg"
    nvl_yunqiu "그럼… 오 선생님께 말씀드려 볼게." (**end_page())


translate japanese plot9_dee9adeb:


    nvl clear
    voice "voice/xiaoxia_129.ogg"
    nvl_xiaoxia "벌써 몇 번이나 말씀드렸어. 늘 한번 보러 오겠다고만 하시고,\n한 번도 와 주시질 않았어."


translate japanese plot9_577dc52e:


    voice "voice/xiaoxia_130.ogg"
    nvl_xiaoxia "하아… 다른 누가 좀 도와주면 좋을 텐데…"


translate japanese plot9_98bd68c7:


    voice "voice/banzhang_491.ogg"
    nvl_yunqiu "으음……" (**end_page())


translate japanese plot9_04fa8a26:


    nvl_tianqin_dialogue "반장, 반장——!" (**end_page())


translate japanese plot9_7b2d74b4:


    nvlNone "어째서인지 그때 떠오른 건 담임 선생님이 아니었다."


translate japanese plot9_a5e9c153:


    nvlNone "얼마 전 자기 출석 기록을 확인하러 왔던 라이라였다." (**end_page())


translate japanese plot9_2bde5f8a:


    voice "voice/banzhang_492.ogg"
    nvl_yunqiu "오늘 오후 체육 시간에 라이라 씨에게 도움을 부탁해 보면 어때?"


translate japanese plot9_92176bdf:


    voice "voice/xiaoxia_131.ogg"
    nvl_xiaoxia "어? 라이라한테? 도와줄까…?"


translate japanese plot9_cf1cdf2e:


    voice "voice/banzhang_493.ogg"
    nvl_yunqiu "응. 라이라 씨는 체육 수업을 안 들어도 되지만,\n그래도 운동장에는 나올 거예요."


translate japanese plot9_fca53865:


    voice "voice/banzhang_494.ogg"
    nvl_yunqiu "자유 시간이 되면,\n원예부에 와 달라고 부탁해 보는 건 어떨까요?" (**end_page())


translate japanese plot9_ddbce6ff:


    nvl clear
    voice "voice/banzhang_495.ogg"
    nvl_yunqiu "무슨 일이 있었는지 전부 얘기하지 않아도 되니까……그냥 원예부 일을 좀 도와 달라고만 하면 될 것 같아요."


translate japanese plot9_6b3dea11:


    voice "voice/xiaoxia_132.ogg"
    nvl_xiaoxia "하지만 라이라는… 불량 학생이잖아?"


translate japanese plot9_e007c789:


    voice "voice/xiaoxia_133.ogg"
    nvl_xiaoxia "정말 도와줄까요?" (**end_page())


translate japanese plot9_54189f2b:


    nvl clear
    voice "voice/banzhang_496.ogg"
    nvl_yunqiu "괜찮아요. 라이라 씨는 그냥 학교에 별로 오고 싶지 않은 것뿐이니까요."


translate japanese plot9_763e4939:


    voice "voice/banzhang_497.ogg"
    nvl_yunqiu "잘 부탁하면 분명 도와줄 거예요."


translate japanese plot9_9df544b6:


    voice "voice/banzhang_498.ogg"
    nvl_yunqiu "라이라 씨가 원예부에 있으면, 츠루기 일행도 아무것도 못 할 것 같아요." (**end_page())


translate japanese plot9_93eb8a75:


    nvl clear
    voice "voice/xiaoxia_134.ogg"
    nvl_xiaoxia "그럼 체육 시간에 물어볼게요…" (**end_page())


translate japanese plot9_2e1a8380:


    nvl_xiaoxia "잘됐네, 반장. 라이라가 도와주러 와 준 덕분에, 오늘 오후엔 츠루기 일행도 방해하러 오지 않았구나."


translate japanese plot9_e26e40e3:


    voice "voice/xiaoxia_136.ogg"
    nvl_xiaoxia "게다가 히나타도 불러 줬어. 앞으로 둘이서 원예부에 자주 오겠대!"


translate japanese plot9_c4815336:


    voice "voice/banzhang_499.ogg"
    nvl_yunqiu "그렇군요. 정말 잘됐네요." (**end_page())


translate japanese plot9_bf121633:


    nvl clear
    voice "voice/xiaoxia_137.ogg"
    nvl_xiaoxia "응!"


translate japanese plot9_49306e2d:


    nvlNone "문득 떠오른 생각이었는데, 생각보다 훨씬 잘 풀렸다."


translate japanese plot9_54c8da87:


    nvlNone "라이라가 편하게 말을 걸 수 있는 사람인 건 알고 있었다. 하지만 이렇게까지 성심성의껏 도와줄 줄은 몰랐다." (**end_page())


translate japanese plot9_a96eefcb:


    nvl clear
    voice "voice/banzhang_500.ogg"
    nvl_yunqiu "라이라 씨가 있으면 원예부 애들도 조금 안심하겠네요."


translate japanese plot9_14035ac5:


    voice "voice/xiaoxia_138.ogg"
    nvl_xiaoxia "저도 그렇게 생각해요. 게다가 라이라는 정말 대단해요. 오후 한나절 만에 화단의 흙을 전부 갈아 줬거든요."


translate japanese plot9_56f70615:


    voice "voice/xiaoxia_139.ogg"
    nvl_xiaoxia "덕분에 심는 작업도 훨씬 빨리 할 수 있게 됐어요." (**end_page())


translate japanese plot9_63c021fa:


    nvlNone "원예부에 라이라가 있으면,\n이제 츠루기 일행이 찾아올 걱정은 없을 것이다."


translate japanese plot9_e6001588:


    nvlNone "라이라에게는 사람을 끌어당기는 신기한 힘이 있었다.\n누구하고나 친해질 수 있는 것처럼 보였다."


translate japanese plot9_e0d6ae8e:


    nvlNone "공부를 중시하는 학교인데도,\n거의 매일 수업을 빼먹었으니,\n다들 그녀를 썩 좋게 보지는 않았다."


translate japanese plot9_bbdea523:


    nvlNone "그래도 그녀를 진짜 불량 학생이라고 생각하는 사람은 없었다."


translate japanese plot9_7298291e:


    nvlNone "라이라와 이야기하는 걸 싫어하는 사람도 없었다." (**end_page())


translate japanese plot9_29a2eb61:


    nvlNone "라이라가 사람을 끌어당기는 건 외모 때문이 아니었다. 더 깊은 곳에 있는 무언가 때문이었다."


translate japanese plot9_8e1ab33b:


    nvlNone "사람을 대하는 태도일까, 성격일까. 나도 잘 모르겠다."


translate japanese plot9_02366b6c:


    nvlNone "그 후로 라이라는 원예부 활동에 자주 오게 됐다."


translate japanese plot9_6a42b90b:


    nvlNone "입부할 생각은 없었던 것 같다.\n그래도 원예부를 위해 힘쓰는 일을 틈틈이 도와줬다."


translate japanese plot9_1f73a041:


    nvlNone "츠루기는 원예부에 다른 사람이 오는 게 무서웠던 게 아니다. 라이라만큼은 도무지 제 뜻대로 다룰 수 없었던 것이다."


translate japanese plot9_d17c6063:


    nvlNone "츠루기는 라이라의 그런 성격을 두려워했다."


translate japanese plot9_bc7b8b73:


    nvlNone "반에서도 츠루기는 늘 라이라와 조금 거리를 뒀다."


translate japanese plot9_b751b0f1:


    nvlNone "겉으로는 즐겁게 이야기해도,\n츠루기는 라이라를 몹시 경계했다."


translate japanese plot9_27978c3a:


    nvlNone "나는 그걸 눈치채고 있었던 걸지도 모른다." (**end_page())


translate japanese plot9_81dc0d23:


    nvlNone "하지만 츠루기는 나를 내버려 두지 않았다." (**end_page())


translate japanese plot9_92ab7d6d:


    nvlNone "그날 체육 특기생 훈련이 끝나자,\n츠루기는 또 나를 그곳으로 데려갔다."


translate japanese plot9_fb4c5b53:


    "またあの「ショー」を見せられると思った。でも着いた途端、三人に囲まれた。"


translate japanese plot9_b07dc9d6:


    voice "voice/hecheng_231.ogg"
    nvl_hecheng "이거, 네가 썼어?" (**end_page())


translate japanese plot9_63b2046f:


    nvl clear
    nvlNone "츠루기는 종이 한 장을 내 가슴에 대고, 그 위를 여러 번 세게 쳤다."


translate japanese plot9_33a72294:


    voice "voice/banzhang_501.ogg"
    nvl_yunqiu "이, 이건…"


translate japanese plot9_ff46a9b1:


    nvlNone "종이에 적힌 내용을 봤다——익명으로 쓴 고발문이었다." (**end_page())


translate japanese plot9_948334a5:


    nvl clear
    nvlNone "츠루기가 뒤에서 다른 학생들을 협박하고\n괴롭힌 일이 여러 가지 적혀 있었다."


translate japanese plot9_05082432:


    nvlNone "츠루기의 이름은 없었다. 하지만,\n그녀에게 괴롭힘을 당한 학생이라면 누구 이야기인지 알 터였다."


translate japanese plot9_392dc3a0:


    voice "voice/hecheng_232.ogg"
    nvl_hecheng "똑바로 물을게. 이거, 네가 썼어?" (**end_page())


translate japanese plot9_bc74c576:


    nvl clear
    voice "voice/banzhang_502.ogg"
    nvl_yunqiu "아니에요… 제가 쓴 게 아니에요…"


translate japanese plot9_36f8105d:


    nvlNone "선생님께 직접 전달됐어야 할 고발문이, 어째서인지 츠루기의 손에 들어가 있었다."


translate japanese plot9_369811eb:


    nvlNone "어디에도 이름은 없었다. 그런데도 츠루기는 이 편지를 몹시 신경 쓰고 있었다." (**end_page())


translate japanese plot9_c1112caa:


    nvl clear
    nvlNone "고분고분하던 「어린양」들 중에 반항하는 녀석이 나타났기 때문이다."


translate japanese plot9_7aa0c723:


    voice "voice/hecheng_233.ogg"
    nvl_hecheng "응… 나도 네가 쓴 건 아닐 거라고 생각했어."


translate japanese plot9_862a5d88:


    voice "voice/hecheng_234.ogg"
    nvl_hecheng "하지만 누가 썼는지는 알지?" (**end_page())


translate japanese plot9_20bda563:


    nvl clear
    voice "voice/hecheng_235.ogg"
    nvl_hecheng "그렇지? 반장."


translate japanese plot9_73fb1c7c:


    voice "voice/banzhang_503.ogg"
    nvl_yunqiu "아, 아니요. 저도 누가 썼는지는…"


translate japanese plot9_d5f22815:


    voice "voice/hecheng_236.ogg"
    nvl_hecheng "정・말・로?" (**end_page())


translate japanese plot9_09d50876:


    nvl clear
    voice "voice/banzhang_504.ogg"
    nvl_yunqiu "저, 정말 몰라요…"


translate japanese plot9_6e55689c:


    voice "voice/hecheng_237.ogg"
    nvl_hecheng "친하게 지내는 애 중 하나가 썼어?"


translate japanese plot9_2604593e:


    voice "voice/hecheng_238.ogg"
    nvl_hecheng "아니면 원예부의 그 겁쟁이들?" (**end_page())


translate japanese plot9_b7148832_1:


    nvl clear
    voice "voice/banzhang_505.ogg"
    nvl_yunqiu "저는……"


translate japanese plot9_682ce736:


    voice "voice/hecheng_239.ogg"
    nvl_hecheng "아아――그러고 보니."


translate japanese plot9_e1c943c2:


    voice "voice/hecheng_240.ogg"
    nvl_hecheng "요즘 라이라 그 녀석, 맨날 원예부에 있더라." (**end_page())


translate japanese plot9_5c131075:


    nvl clear
    voice "voice/hecheng_241.ogg"
    nvl_hecheng "들었어. 반장이 원예부에 와 달라고 부탁했다며?"


translate japanese plot9_1de8f01b:


    voice "voice/hecheng_242.ogg"
    nvl_hecheng "라이라를 이용해서 원예부 애들을 지켜 주려고 했어?"


translate japanese plot9_0ec2a1c0:


    voice "voice/hecheng_243.ogg"
    nvl_hecheng "아니면 이제 나 같은 건 안 무섭다고 생각한 거야?" (**end_page())


translate japanese plot9_e03f5aad:


    nvl clear
    voice "voice/banzhang_506.ogg"
    nvl_yunqiu "아, 아니…"


translate japanese plot9_7e4312f2:


    nvlNone "짝——!"


translate japanese plot9_8b7ab276:


    nvlNone "말을 끝내기도 전에 츠루기의 손바닥이 내 뺨으로 날아왔다." (**end_page())


translate japanese plot9_3b123a3d:


    nvl clear
    voice "voice/banzhang_507.ogg"
    nvl_yunqiu "윽……"


translate japanese plot9_d14f00cb:


    voice "voice/hecheng_244.ogg"
    nvl_hecheng "다음엔 잘 생각하고 대답해. 알았지, 반장?"


translate japanese plot9_03f2b7c1:


    voice "voice/hecheng_245.ogg"
    nvl_hecheng "…이 편지, 누가 썼어?" (**end_page())


translate japanese plot9_1a592c6c:


    nvl clear
    voice "voice/banzhang_508.ogg"
    nvl_yunqiu "정말… 몰라요…"


translate japanese plot9_7e4312f2_1:


    nvlNone "짝——!"


translate japanese plot9_1560f07d:


    voice "voice/banzhang_509.ogg"
    nvl_yunqiu "으윽――!" (**end_page())


translate japanese plot9_e8e35fd6:


    nvl clear
    voice "voice/hecheng_246.ogg"
    nvl_hecheng "왜 그렇게까지 감싸 줘? 반장."


translate japanese plot9_057d4959:


    voice "voice/hecheng_247.ogg"
    nvl_hecheng "걔들을 감싸서 너한테 무슨 이득이 있는데?"


translate japanese plot9_cfb9ac2e:


    voice "voice/banzhang_510.ogg"
    nvl_yunqiu "정말 몰라요…" (**end_page())


translate japanese plot9_77580098:


    nvl clear
    voice "voice/hecheng_248.ogg"
    nvl_hecheng "정말 아무것도 몰라?"


translate japanese plot9_e35384a9:


    voice "voice/banzhang_511.ogg"
    nvl_yunqiu "으… 저는…"


translate japanese plot9_1e7a4a46:


    voice "voice/hecheng_249.ogg"
    nvl_hecheng "하아… 반장은 거짓말을 참 못하네." (**end_page())


translate japanese plot9_5c51b8f5:


    nvl clear
    voice "voice/hecheng_250.ogg"
    nvl_hecheng "그렇구나. 집에서는 엄마 말 잘 듣는 착한 애겠지? 거짓말 같은 건 한 번도 해 본 적 없겠네."


translate japanese plot9_b7148832_2:


    voice "voice/banzhang_512.ogg"
    nvl_yunqiu "저는……"


translate japanese plot9_b0ade056:


    nvlNone "「엄마」라는 말을 듣자마자, 또 머릿속이 새하얘졌다." (**end_page())


translate japanese plot9_c5db3c06:


    voice "voice/hecheng_251.ogg"
    nvl_hecheng "더는 억지로 캐묻지 않을게. 그래, 네가 고르게 해 줄게."


translate japanese plot9_5f53c42d:


    voice "voice/hecheng_252.ogg"
    nvl_hecheng "누가 썼는지 네 입으로 말하든가. 아니면…"


translate japanese plot9_33474c85:


    voice "voice/hecheng_253.ogg"
    nvl_hecheng "이걸 먹어." (**end_page())


translate japanese plot9_65929921_1:


    nvl clear
    voice "voice/banzhang_513.ogg"
    nvl_yunqiu "히익!?"


translate japanese plot9_fd48f628:


    nvlNone "츠루기가 무언가를 내 발치로 차 보냈다. 나는 놀라서 몇 걸음이나 뒷걸음질쳤다."


translate japanese plot9_d046d66b:


    nvlNone "――손바닥만 한 흰쥐의 시체였다." (**end_page())


translate japanese plot9_dd1a6c27:


    nvl clear
    voice "voice/hecheng_254.ogg"
    nvl_hecheng "이게 뭔지는 알지?"


translate japanese plot9_252d0f4a:


    voice "voice/hecheng_255.ogg"
    nvl_hecheng "요즘 원예부에 자주 나오는 흰쥐.\n그런 지저분한 곳을 아주 좋아한다더라."


translate japanese plot9_47f32f72:


    voice "voice/hecheng_256.ogg"
    nvl_hecheng "누가 썼는지 순순히 말하든가, 이걸 먹든가." (**end_page())


translate japanese plot9_24c507f7:


    nvl clear
    voice "voice/hecheng_257.ogg"
    nvl_hecheng "원하는 쪽을 골라." (**end_page())


translate japanese plot9_55c54455:


    voice "voice/xizhen_27.ogg"
    nvl_student_a "하하, 츠루기 진짜 짓궂다. 이러면 못 고르잖아."


translate japanese plot9_6229464d:


    voice "voice/minying_21.ogg"
    nvl_student_b "맞아, 맞아. 반장 불쌍해." (**end_page())


translate japanese plot9_9b038494:


    voice "voice/hecheng_258.ogg"
    nvl_hecheng "응? 그래?"


translate japanese plot9_b5c33566:


    voice "voice/hecheng_259.ogg"
    nvl_hecheng "난 반장한테 똑같이 공평한 선택지를 두 개 준 건데?"


translate japanese plot9_04f5cdd7:


    voice "voice/hecheng_260.ogg"
    nvl_hecheng "다른 애들을 지켜 주고 싶다면,\n그럴 각오가 얼마나 돼 있는지 좀 볼까?" (**end_page())


translate japanese plot9_2bb57c33:


    nvlNone "발치로 굴러온 흰쥐를 보자, 눈앞이 흔들렸다."


translate japanese plot9_1c51ebd0:


    nvlNone "지금, 뭘 느끼고 있지?"


translate japanese plot9_214ba93f:


    nvlNone "무서운가? 두려운가?"


translate japanese plot9_be105a52:


    nvlNone "하지만 마음 밑바닥, 그 가장 깊은 곳에서,"


translate japanese plot9_6f117a0f:


    nvlNone "무언가가 거세게 꿈틀거리고 있었다."


translate japanese plot9_782c6422:


    nvlNone "그 감정을 몇 번이고 곱씹고 나서야 비로소 알았다." (**end_page())


translate japanese plot9_7affcce7:


    nvlNone "그때 머릿속에서 또 하나의 목소리가 들렸다."


translate japanese plot9_075ee47f:


    nvlNone "「█████。」"


translate japanese plot9_d6f4c191_1:


    nvl_yunqiu "…"


translate japanese plot9_1647d370:


    nvlNone "정신을 차리자, 나는 어째서인지 모르는 곳에 서 있었다."


translate japanese plot9_aad365ce:


    nvlNone "무너진 벽과 건물들. 전쟁이 끝난 뒤의 도시인 걸까." (**end_page())


translate japanese plot9_ddb29179:


    nvl clear
    nvlNone "나는 이곳에 있지 않다. 그런데도,\n줄곧 이곳에 있었던 듯한 느낌도 들었다." (**end_page())


translate japanese plot9_18f28878:


    voice "voice/banzhang_515.ogg"
    nvl_chronicle "자신을 억누를 필요는 없다."


translate japanese plot9_ece11c95:


    voice "voice/banzhang_516.ogg"
    nvl_chronicle "나는 너이고, 너는 나다." (**end_page())


translate japanese plot9_51715d15:


    nvlNone "마음속에 거대한 파도가 일어나, 생각할 힘을 마구 무너뜨렸다."


translate japanese plot9_34c23423:


    nvlNone "유혹하는 목소리가 머릿속에 날카롭게 울렸다."


translate japanese plot9_cd1dc86a:


    nvlNone "유혹하는 목소리가 머릿속에서 외쳤다." (**end_page())


translate japanese plot9_d590abe2:


    nvlNone "「나를 사냥해라,」{p}「나를 삼켜라,」{p}「나를 먹어 치워라,」{p}「나를 느껴라,」{p}「나를 빨아들여라,」{p}「나를 깨달아라.」"


translate japanese plot9_crown_browse_dismissible_e5e687f3:


    hecheng "하아――?"


translate japanese plot9_crown_browse_dismissible_e3fb31f6:


    voice "voice/minying_22.ogg"
    minying "우와… 반장, 진짜 먹는데!"


translate japanese plot9_crown_browse_dismissible_a5fbbd09:


    voice "voice/xizhen_28.ogg"
    xizhen "말도 안 돼! 빨리 영상 찍어!"


translate japanese plot9_crown_browse_dismissible_436635b0:


    voice "voice/xizhen_29.ogg"
    xizhen "먹었다가 토했다가, 역겨워. 아하하하하――"


translate japanese plot9_crown_browse_dismissible_c4275e99:


    voice "voice/minying_23.ogg"
    minying "우웩… 냄새. 용케도 먹네."


translate japanese plot9_crown_browse_dismissible_e3fb7e8c:


    voice "voice/minying_24.ogg"
    minying "아, 더는 못 보겠어. 난 저쪽에 있을게."


translate japanese plot9_crown_browse_dismissible_a04c73b7:


    voice "voice/minying_25.ogg"
    minying "반장, 진짜 역겨워."


translate japanese plot9_crown_browse_dismissible_2671e677:


    voice "voice/xizhen_30.ogg"
    xizhen "그러게, 그러게. 하하."


translate japanese plot9_crown_browse_dismissible_6c4de058:


    voice "voice/xizhen_31.ogg"
    xizhen "우웩~. 내장까지 다 먹어 버렸어."


translate japanese plot9_crown_browse_dismissible_f58bf347:


    voice "voice/xizhen_32.ogg"
    xizhen "앞으로 반장은 「흰쥐녀」라고 부르자."


translate japanese plot9_crown_browse_dismissible_65f1e8db:


    voice "voice/hecheng_262.ogg"
    hecheng "…"


translate japanese plot9_98bd68c7_1:


    voice "voice/banzhang_517.ogg"
    nvl_yunqiu "으음……"


translate japanese plot9_746f394e:


    nvlNone "집에 돌아오자마자 욕실로 뛰어들어,\n옷에 묻은 피와 토사물을 씻어 냈다." (**end_page())


translate japanese plot9_4b7c0e12:


    nvl clear
    nvlNone "엄마가 아직 돌아오지 않아서 다행이었다. 이런 모습을 보셨다면 뭐라고 설명해야 할지 몰랐을 것이다."


translate japanese plot9_0af47165:


    nvlNone "학교에서 어떻게 돌아왔는지도 기억나지 않는다. 길에서 마주친 사람들도 분명 이상한 눈으로 나를 봤겠지." (**end_page())


translate japanese plot9_53055ced:


    nvlNone "하지만 한 가지는 안다. 아무도 나를 도와주려 하지 않았다."


translate japanese plot9_fec374cc:


    voice "voice/banzhang_518.ogg"
    nvl_yunqiu "…이 핏자국, 안 지워지는 곳이 있어." (**end_page())


translate japanese plot9_85e7b944:


    nvlNone "마음은 이상할 만큼 고요했다."


translate japanese plot9_e6d43d78:


    "白ネズミを食べてから、自分の心の中に、もうひとり誰かが住んでいるように感じた。"


translate japanese plot9_83328f50:


    nvlNone "정확히 말하면 「의식」 속에 있는 거겠지." (**end_page())


translate japanese plot9_9b40b226:


    nvlNone "하지만 이제 아무래도 좋다."


translate japanese plot9_4c64aca0:


    nvlNone "이 세계에는 없는 지식이 머릿속으로 흘러들어 와,\n「시야」가 트이는 느낌이 들었다."


translate japanese plot9_79a63869:


    nvlNone "평소라면 믿을 수 없는 일인데도,\n지금의 나는 조금도 이상하다고 생각하지 않았다." (**end_page())


translate japanese plot9_6c5297c6:


    nvlNone "정말 마음에 병이라도 생긴 걸지도 모른다." (**end_page())


translate japanese plot9_bad6e688:


    voice "voice/banzhang_519.ogg"
    nvl_chronicle "다른 세계의 소녀여."


translate japanese plot9_dfff8e75:


    voice "voice/banzhang_520.ogg"
    nvl_yunqiu "읏――!?"


translate japanese plot9_c9997855:


    voice "voice/banzhang_521.ogg"
    nvl_chronicle "놀랄 필요는 없다." (**end_page())


translate japanese plot9_573c9e0e:


    nvl clear
    voice "voice/banzhang_522.ogg"
    nvl_chronicle "내 모습은 아직 완전하지 않다.\n나를 먹은 너만이 내가 있다는 것을 알 수 있지."


translate japanese plot9_df1744ec:


    voice "voice/banzhang_523.ogg"
    nvl_yunqiu "당신은… 그 흰쥐야?"


translate japanese plot9_4037cbf0:


    voice "voice/banzhang_524.ogg"
    nvl_chronicle "그렇기도 하고, 아니기도 하다." (**end_page())


translate japanese plot9_7ac7f0ad:


    nvl clear
    voice "voice/banzhang_525.ogg"
    nvl_chronicle "네가 「경계」를 깨뜨렸기에, 우리는 하나가 될 수 있었다."


translate japanese plot9_99f52741:


    nvlNone "그럼 나는 이미 미쳐 버린 거야?"


translate japanese plot9_6a58fef5:


    nvlNone "뭐, 됐어. 눈앞의 이것도 나 혼자 보고 있는 환상일지 몰라." (**end_page())


translate japanese plot9_8c53ed78:


    nvl clear
    nvlNone "정말 어떻게 돼 버린 거겠지."


translate japanese plot9_840c4ef6:


    voice "voice/banzhang_526.ogg"
    nvl_yunqiu "당신은 대체 뭐야?"


translate japanese plot9_a4063a84:


    voice "voice/banzhang_527.ogg"
    nvl_chronicle "누군가를 담는 그릇에 지나지 않는다." (**end_page())


translate japanese plot9_5d45dce6:


    nvl clear
    voice "voice/banzhang_528.ogg"
    nvl_chronicle "하지만 지금 너와 나는 이미 섞여 있다."


translate japanese plot9_6e16a85c:


    voice "voice/banzhang_529.ogg"
    nvl_chronicle "알 수 있을 것이다. 하나가 되었을 때,\n모든 개념이 네 마음에 새겨졌으니까."


translate japanese plot9_b63f5cba:


    voice "voice/banzhang_530.ogg"
    nvl_yunqiu "…왜 하필 나야?" (**end_page())


translate japanese plot9_0a74ba8d:


    nvl clear
    voice "voice/banzhang_531.ogg"
    nvl_chronicle "소녀여. 내가 너를 고른 게 아니다. 네가 나의 부름에 응한 것이다."


translate japanese plot9_de6dfd76:


    voice "voice/banzhang_532.ogg"
    nvl_yunqiu "당신은 뭘 원해?"


translate japanese plot9_59b23118:


    voice "voice/banzhang_533.ogg"
    nvl_chronicle "그건 네가 나에게 물을 일이 아니다." (**end_page())


translate japanese plot9_35a04e83:


    nvl clear
    voice "voice/banzhang_534.ogg"
    nvl_chronicle "너는 나이고, 나는 너다."


translate japanese plot9_bcefb09a:


    voice "voice/banzhang_535.ogg"
    nvl_chronicle "네가 필요로 하는 것이야말로 내가 바라는 것이다."


translate japanese plot9_48931962:


    voice "voice/banzhang_536.ogg"
    nvl_chronicle "자신의 마음을 따라, 자신을 해방해라." (**end_page())


translate japanese plot9_eb0cf954:


    voice "voice/banzhang_537.ogg"
    nvl_yunqiu "그렇지……"


translate japanese plot9_caed3b8c:


    voice "voice/banzhang_538.ogg"
    nvl_yunqiu "츠루기한테는 자기가 한 짓의 대가를 치르게 해야겠어." (**end_page())


translate japanese plot9_26f9ca20:


    voice "voice/minying_26.ogg"
    minying 0102 "꺄아아!!!"


translate japanese plot9_crown_browse_dismissible_dc6d7215:


    voice "voice/hecheng_263.ogg"
    hecheng 0104 "――！"


translate japanese plot9_f759a9ca:


    npc6 "うわ、気持ち悪い…"


translate japanese plot9_a80aadad:


    npc7 "何これ？いたずら？"


translate japanese plot9_ef9e03a9:


    npc8 "うわ、よくこんなことしたな…"


translate japanese plot9_442941ca_2:


    "…"


translate japanese plot9_b0723fac:


    nvlNone "나조차 무슨 일이 일어났는지 모르는 사이, 그 힘이 멋대로 움직였다."


translate japanese plot9_f49cb066:


    nvlNone "정신을 차려 보니 츠루기의 책상 안에,\n죽은 흰쥐가 몇 마리나 들어 있었다." (**end_page())


translate japanese plot9_6eb4e437:


    nvl clear
    nvlNone "비릿한 냄새가 교실에 퍼져, 좀처럼 사라지지 않았다."


translate japanese plot9_a9de7360:


    nvlNone "피해를 본 건 츠루기인데도,\n다들 이상한 것을 보듯 그녀를 쳐다봤다." (**end_page())


translate japanese plot9_f733f85e:


    nvl clear
    nvlNone "원래 츠루기를 싫어하던 학생들은\n이때다 싶어 떠들어 댔다."


translate japanese plot9_59ec8518:


    nvlNone "「흰쥐녀」." (**end_page())


translate japanese plot9_36c9dd24:


    nvlNone "그 세 사람이 내게 붙인 이름이, 이번에는 츠루기의 것이 됐다."


translate japanese plot9_2bb5c30f:


    "驚いた顔。心の揺れを隠し、何でもなかったふりをする様子。小さな変化まで、私には全部見えた。"


translate japanese plot9_70e8d22f:


    nvlNone "아아. 드디어 츠루기도 이 기분을 맛보게 했어."


translate japanese plot9_3a3a42d1:


    "絶頂の気持ちよさが身体中を走った。私が求めていたのは、これだったのだ。"


translate japanese plot9_dd8fa39a:


    nvl_hecheng "…네가 했지."


translate japanese plot9_047d46c4:


    voice "voice/banzhang_539.ogg"
    nvl_yunqiu "무슨 말씀이세요, 츠루기 씨?"


translate japanese plot9_b9c73f71:


    voice "voice/hecheng_265.ogg"
    nvl_hecheng "말 안 해도 알잖아?" (**end_page())


translate japanese plot9_b424a43b:


    nvl clear
    voice "voice/banzhang_540.ogg"
    nvl_yunqiu "네? 츠루기 씨가 무슨 말씀을 하시는지 정말 모르겠어요."


translate japanese plot9_4ee68097:


    voice "voice/hecheng_266.ogg"
    nvl_hecheng "…언제까지 모르는 척할 거야?"


translate japanese plot9_ce8cfd17:


    voice "voice/hecheng_267.ogg"
    nvl_hecheng "네가 인정하지 않아도 증거를 찾아낼 거야." (**end_page())


translate japanese plot9_c35eae5d:


    nvl clear
    voice "voice/hecheng_268.ogg"
    nvl_hecheng "두고 봐. 이대로 끝내진 않을 테니까." (**end_page())


translate japanese plot9_942e7ac4:


    nvlNone "츠루기는 그저 나를 겁주려던 게 아니었다. 누가 책상에 넣었는지 알아낼 방법을 정말로 갖고 있었다."


translate japanese plot9_fb48800f:


    nvlNone "집안의 힘을 쓰면,\n학교 CCTV를 확인하는 것쯤은 어렵지 않다."


translate japanese plot9_1877482f:


    nvlNone "――정말로 카메라에 무언가 찍혔다면 말이지만." (**end_page())


translate japanese plot9_9422b32e:


    nvl_chronicle "오랜만에 진심으로 즐긴 모양이군?"


translate japanese plot9_f4ffcafc:


    voice "voice/banzhang_542.ogg"
    nvl_yunqiu "무슨 일이 일어났는지는 모르겠어. 하지만,\n츠루기에게 쓴맛을 보여 줄 수 있었어."


translate japanese plot9_9be7a00c:


    voice "voice/banzhang_543.ogg"
    nvl_chronicle "이것이 【너｜나】의 힘이다." (**end_page())


translate japanese plot9_579f1a5d:


    nvl clear
    nvlNone "머릿속에 떠오른 지식으로 무슨 일이 일어났는지 생각했다."


translate japanese plot9_a7b49bed:


    voice "voice/banzhang_544.ogg"
    nvl_yunqiu "…현실을 바꿔 쓴 거야?"


translate japanese plot9_730c3fb2:


    voice "voice/banzhang_545.ogg"
    nvl_chronicle "이것은 「마법」이 탄생하기 전의 형태. 「마력」이 일으키는 「현상」이다." (**end_page())


translate japanese plot9_a2915a9e:


    nvl clear
    voice "voice/banzhang_546.ogg"
    nvl_chronicle "너의 감정은 너무나도 강하다. 아마 마녀라 해도, 네가 일으킨 「사상」을 똑같이 만들어 낼 수는 없을 것이다."


translate japanese plot9_252bdfc8:


    voice "voice/banzhang_547.ogg"
    nvl_chronicle "너와 내가 하나가 되었기에 태어난 「{a=dictionary:dict_entry_92}기적{/a}」이다."


translate japanese plot9_60cb474b:


    voice "voice/banzhang_548.ogg"
    nvl_yunqiu "마법…" (**end_page())


translate japanese plot9_deb84bb9:


    nvl clear
    nvlNone "지식은 머릿속에 있었지만, 모든 걸 이해할 수는 없었다."


translate japanese plot9_9ce84f28:


    voice "voice/banzhang_549.ogg"
    nvl_chronicle "그런 사소한 일을 왜 신경 쓰는 것이냐?"


translate japanese plot9_b486fb2b:


    voice "voice/banzhang_550.ogg"
    nvl_chronicle "자신의 마음을 따라, 하고 싶은 일을 하면 된다." (**end_page())


translate japanese plot9_96b8094a:


    nvl clear
    nvlNone "【그것｜나】에게는 정말로 그런 힘이 있는 듯했다. 지금의 내가 꿈을 꾸고 있는 건지조차 알 수 없게 됐다."


translate japanese plot9_9141ff84:


    voice "voice/banzhang_551.ogg"
    nvl_yunqiu "내가 하고 싶은 일…"


translate japanese plot9_bc634fa8:


    nvlNone "내 머릿속에 떠오른 건 츠루기가 갖고 있던 고발문이었다." (**end_page())


translate japanese plot9_4cb49ebd:


    nvl clear
    nvlNone "선생님께 전해졌어야 하는데, 어째서인지 츠루기에게 빼앗겨 버린 편지."


translate japanese plot9_86f92d9e:


    "あれが、無事に先生に届けば…"


translate japanese plot9_b950e9f5:


    voice "voice/banzhang_552.ogg"
    nvl_chronicle "그렇다면, 그것을 바꾸자." (**end_page())


translate japanese plot9_0eef8318:


    voice "voice/banzhang_553.ogg"
    nvl_yunqiu "…벌써 끝났어?"


translate japanese plot9_4ecf1264:


    voice "voice/banzhang_554.ogg"
    nvl_chronicle "…"


translate japanese plot9_766f8a96:


    nvlNone "오늘 아침에도 마찬가지였다." (**end_page())


translate japanese plot9_4397dbef:


    nvl clear
    nvlNone "내가 알아차리기도 전에, 【그것｜나】는 들어 본 적 없는 말을 중얼거리며,\n내 바람을 현실로 만들었다."


translate japanese plot9_513c4422:


    voice "voice/banzhang_555.ogg"
    nvl_yunqiu "…정말 실감이 안 나."


translate japanese plot9_aa1538f3:


    voice "voice/banzhang_556.ogg"
    nvl_chronicle "그것이 마법이다." (**end_page())


translate japanese plot9_7f2aefa4:


    nvl clear
    voice "voice/banzhang_557.ogg"
    nvl_chronicle "내가 태어난 세계에서는,\n네가 신기하게 여기는 일도 흔했다."


translate japanese plot9_14c1adfe:


    voice "voice/banzhang_558.ogg"
    nvl_yunqiu "당신이 있던 세계…" (**end_page())


translate japanese plot9_cda78f4c:


    nvl_yunqiu "으윽――!"


translate japanese plot9_d845571f:


    nvlNone "갑자기 머리가 심하게 아프더니, 어째서인지 라이라의 얼굴이 떠올랐다."


translate japanese plot9_9e8a2ac3:


    voice "voice/banzhang_560.ogg"
    nvl_yunqiu "…라이라?" (**end_page())


translate japanese plot9_946ecd48:


    voice "voice/banzhang_561.ogg"
    nvl_chronicle "그 소녀에게는 나와 같은 마력이 있다."


translate japanese plot9_a4042226:


    voice "voice/banzhang_562.ogg"
    nvl_yunqiu "왜?"


translate japanese plot9_49ce4b68:


    voice "voice/banzhang_563.ogg"
    nvl_chronicle "나의 원래 주인과 연관이 있을지도 모르지." (**end_page())


translate japanese plot9_96ce3335:


    nvl clear
    voice "voice/banzhang_564.ogg"
    nvl_yunqiu "…당신을 주인에게 돌려주는 게 좋을까?"


translate japanese plot9_57893bcc:


    voice "voice/banzhang_565.ogg"
    nvl_chronicle "왜 마음에도 없는 말을 하지?"


translate japanese plot9_e2b8ef78:


    voice "voice/banzhang_566.ogg"
    nvl_yunqiu "아니야, 나는…" (**end_page())


translate japanese plot9_ee6b8222:


    nvlNone "【그것｜나】 앞에서 숨겨 봐야 소용없다."


translate japanese plot9_8eddebc6:


    nvlNone "의미 없는 친절로,\n자신을 납득시키려 할 뿐이다."


translate japanese plot9_85fbc22a:


    nvlNone "마음 깊숙한 곳의 불꽃은 아직도 거세게 타오르고 있었다." (**end_page())


translate japanese plot9_159d0a21:


    nvl clear
    nvlNone "이 불이 꺼지기 전까지는 놓아줄 생각 따위 없다." (**end_page())


translate japanese plot9_bd0d2bc8:


    nvlNone "그 후, 고발 편지는 무사히 담임 선생님 손에 들어갔다."


translate japanese plot9_599a8327:


    nvlNone "학교는 학년 집회를 열었다. 하지만 학년부장이 일이 커지지 않도록 덮어서, 끝까지 사정을 알게 된 건 일부 선생님뿐이었다." (**end_page())


translate japanese plot9_528ced6d:


    nvlNone "그래도 츠루기는 눈치챘겠지. 자기가 갖고 있던 고발 편지가 갑자기 사라졌으니까."


translate japanese plot9_910377cb:


    nvlNone "아쉽게도 그날 츠루기는 결석했다. 그렇지 않았다면 어떤 표정을 지을지 보고 싶었다." (**end_page())


translate japanese plot9_fb6ef845:


    nvl clear
    nvlNone "당황하고, 겁을 먹었을까."


translate japanese plot9_d8a3de88:


    nvlNone "분명 재미있었겠지." (**end_page())


translate japanese plot9_fad1f251:


    nvlNone "늘 붙어 다니는 두 사람도 안색이 나빠져 있었다."


translate japanese plot9_bd07e86c:


    nvlNone "츠루기라는 뒷배를 더는 의지할 수 없을지도 모른다.\n두 사람도 그렇게 느꼈겠지." (**end_page())


translate japanese plot9_82d26aa5:


    nvlNone "그 후로 츠루기가 나를 불러내는 일은 없어졌다."


translate japanese plot9_94f702db:


    nvlNone "CCTV를 봐도 아무것도 찾지 못한 거겠지." (**end_page())


translate japanese plot9_3b4e5253:


    nvl clear
    nvlNone "하지만 그 정도로 포기할 리 없다."


translate japanese plot9_deb2578e:


    nvlNone "무언가를 꾸미고 있다." (**end_page())


translate japanese plot9_b9976aad:


    nvl clear
    nvlNone "아무도 볼 수 없는 곳에서,\n츠루기가 일으킨 폭풍은 아직도 계속되고 있었다." (**end_page())


translate japanese plot9_dc0e2d64:


    nvlNone "당분간은 그 세 사람도 조용히 지낼 줄 알았다."


translate japanese plot9_fe7b82b3:


    nvlNone "하지만 얼마 지나지 않아 아키나가 나를 찾아왔다." (**end_page())


translate japanese plot9_62eb1438:


    voice "voice/xiaoxia_140.ogg"
    nvl_xiaoxia "반장……"


translate japanese plot9_eeb2b3c1:


    voice "voice/banzhang_567.ogg"
    nvl_yunqiu "응? 무슨 일이야, 아키나?"


translate japanese plot9_476ee23a:


    voice "voice/xiaoxia_141.ogg"
    nvl_xiaoxia "츠루기 일행이 또 원예부를 방해하러 왔어…" (**end_page())


translate japanese plot9_f5614ec6:


    nvl clear
    voice "voice/banzhang_568.ogg"
    nvl_yunqiu "네? 츠루기는 결석했잖아요?"


translate japanese plot9_b4f816ce:


    voice "voice/xiaoxia_142.ogg"
    nvl_xiaoxia "아니, 츠루기 말고 희진이랑 민영이가…"


translate japanese plot9_5997ac37:


    voice "voice/banzhang_569.ogg"
    nvl_yunqiu "라이라 씨는 없었어?" (**end_page())


translate japanese plot9_c447f504:


    nvl clear
    voice "voice/xiaoxia_143.ogg"
    nvl_xiaoxia "라이라가 없는 때를 노려서 왔어요."


translate japanese plot9_e2d3c497:


    voice "voice/banzhang_570.ogg"
    nvl_yunqiu "……학년 집회가 끝난 지 얼마 안 됐는데, 벌써 왔다고?"


translate japanese plot9_b47a9561:


    voice "voice/xiaoxia_144.ogg"
    nvl_xiaoxia "응… 이제 어떻게 해야 할지 모르겠어요…" (**end_page())


translate japanese plot9_e130e195:


    nvl clear
    voice "voice/banzhang_571.ogg"
    nvl_yunqiu "…가요. 제가 이야기해 볼게요." (**end_page())


translate japanese plot9_6d12e8b4:


    nvl_yunqiu "당신들." (**end_page())


translate japanese plot9_6e7121c1:


    voice "voice/xizhen_33.ogg"
    nvl_student_a "…뭐야. 반장이네."


translate japanese plot9_c38e9e8f:


    voice "voice/xizhen_34.ogg"
    nvl_student_a "무슨 볼일인데?"


translate japanese plot9_809ad396:


    voice "voice/banzhang_573.ogg"
    nvl_yunqiu "그건 제가 묻고 싶네요. 여기서 뭘 하는 거죠?" (**end_page())


translate japanese plot9_9ab964a3:


    nvl clear
    voice "voice/xizhen_35.ogg"
    nvl_student_a "별거 아냐. 너희 보고 있으면 재밌어서 와 봤을 뿐이야."


translate japanese plot9_d6228e06:


    voice "voice/xizhen_36.ogg"
    nvl_student_a "그렇지, 민영아?"


translate japanese plot9_a38ee491:


    voice "voice/minying_27.ogg"
    nvl_student_b "맞아, 맞아. 반장하곤 상관없잖아." (**end_page())


translate japanese plot9_8708f58c:


    nvl clear
    voice "voice/banzhang_574.ogg"
    nvl_yunqiu "원예부 애들이 곤란해하는 거,\n모르겠어요? 여긴 당신들이 와도 되는 곳이 아니에요."


translate japanese plot9_7fbef05b:


    voice "voice/xizhen_37.ogg"
    nvl_student_a "환영받든 말든 우리랑 무슨 상관이야."


translate japanese plot9_94291882:


    voice "voice/xizhen_38.ogg"
    nvl_student_a "여긴 학교 애들 누구나 쓸 수 있는 곳이잖아. 얼마나 있든 우리 마음이지. 너희한텐 쫓아낼 권리 없어." (**end_page())


translate japanese plot9_d6f4c191_2:


    nvl clear
    voice "voice/banzhang_575.ogg"
    nvl_yunqiu "…" (**end_page())


translate japanese plot9_75bcbf06:


    voice "voice/xizhen_39.ogg"
    nvl_student_a "왜? 불만 있어? 있으면 지도 선생님한테 말하든가."


translate japanese plot9_4ab77e56:


    voice "voice/xizhen_40.ogg"
    nvl_student_a "방과 후에 선생님을 찾을 수 있다면 말이지. 하하."


translate japanese plot9_2897c5a0:


    voice "voice/banzhang_576.ogg"
    nvl_yunqiu "…알겠어요." (**end_page())


translate japanese plot9_2f708a9a:


    nvl clear
    voice "voice/xizhen_41.ogg"
    nvl_student_a "어?"


translate japanese plot9_11676251:


    voice "voice/banzhang_577.ogg"
    nvl_yunqiu "츠루기의 입장이 곤란해지니까 불안한 거군요?"


translate japanese plot9_d247bdc0:


    voice "voice/xizhen_42.ogg"
    nvl_student_a "크윽――!" (**end_page())


translate japanese plot9_52d7add0:


    nvl clear
    voice "voice/banzhang_578.ogg"
    nvl_yunqiu "학년 집회에서 하는 말을 듣고 무서워진 거죠?"


translate japanese plot9_8519842e:


    voice "voice/banzhang_579.ogg"
    nvl_yunqiu "츠루기가 얌전히 지내게 되면, 당신들도 마음대로 못 굴 테니까요."


translate japanese plot9_3d09c847:


    voice "voice/xizhen_43.ogg"
    nvl_student_a "너… 무슨 소리야!" (**end_page())


translate japanese plot9_eec8cae3:


    nvl clear
    voice "voice/banzhang_580.ogg"
    nvl_yunqiu "정곡을 찔렀나 보네요?"


translate japanese plot9_be7b8338:


    voice "voice/banzhang_581.ogg"
    nvl_yunqiu "얼른 선생님께 사실대로 말씀드리는 게 좋을 거예요."


translate japanese plot9_3b1a551e:


    voice "voice/banzhang_582.ogg"
    nvl_yunqiu "당신들이 한 짓은 언젠가 전부 드러나요. 그때는 쉽게 넘어갈 수 없을 테니까요." (**end_page())


translate japanese plot9_1c1f6a77:


    nvl clear
    voice "voice/xizhen_44.ogg"
    nvl_student_a "……선생님처럼 훈계하지 마. 역겨우니까."


translate japanese plot9_f73a9f4d:


    voice "voice/xizhen_45.ogg"
    nvl_student_a "두고 봐. 츠루기는 절대 널 용서하지 않을 거야." (**end_page())


translate japanese plot9_2b4da90b:


    nvl_yunqiu "후우――드디어 갔네요." (**end_page())


translate japanese plot9_a70321ff:


    voice "voice/xiaoxia_145.ogg"
    nvl_xiaoxia "대, 대단해요! 반장!"


translate japanese plot9_5944e916_2:


    voice "voice/banzhang_584.ogg"
    nvl_yunqiu "어?"


translate japanese plot9_7c5f5813:


    voice "voice/xiaoxia_146.ogg"
    nvl_xiaoxia "그 둘을 혼내서 돌려보내다니! 정말 멋있었어요!" (**end_page())


translate japanese plot9_b603bd67:


    nvl clear
    nvlNone "생각해 보면, 용기를 내 정면으로 그 애들에게 맞선 건 이번이 처음이었다."


translate japanese plot9_e3617807:


    nvlNone "몸이 아직도 조금 떨렸다. 흥분한 탓일까."


translate japanese plot9_2c76a597:


    voice "voice/banzhang_585.ogg"
    nvl_yunqiu "조금 심하게 말했을지도…" (**end_page())


translate japanese plot9_8cbbffeb:


    nvl clear
    voice "voice/xiaoxia_147.ogg"
    nvl_xiaoxia "그런 사람들한텐 예의 차릴 필요 없어!"


translate japanese plot9_d226dab4:


    voice "voice/xiaoxia_148.ogg"
    nvl_xiaoxia "나도 반장처럼 용기가 있으면 좋겠어."


translate japanese plot9_34a6c2d8:


    nvlNone "츠루기의 입지가 약해져서인지, 그 힘의 영향인지는 모르겠다." (**end_page())


translate japanese plot9_cc6afc22:


    nvl clear
    nvlNone "하지만 지금은 그 애들이 더는 무섭지 않다."


translate japanese plot9_a6a99f8c:


    voice "voice/banzhang_586.ogg"
    nvl_yunqiu "츠루기가 없으면 그 둘은 그저 호랑이 위세를 빌리는 여우일 뿐이에요."


translate japanese plot9_e800958d:


    voice "voice/banzhang_587.ogg"
    nvl_yunqiu "또 찾아오면, 이번에는 바로 선생님께 말씀드려요." (**end_page())


translate japanese plot9_07f3729f:


    nvl clear
    voice "voice/banzhang_588.ogg"
    nvl_yunqiu "츠루기도 지금은 문제를 일으키고 싶지 않을 거예요. 그 둘과는 상관없다고 하겠죠. 그렇게 되면 그 둘은 정말로 기댈 곳이 없어져요."


translate japanese plot9_5c715228:


    voice "voice/xiaoxia_149.ogg"
    nvl_xiaoxia "응! 알겠어요!" (**end_page())


translate japanese plot9_b0f44639:


    nvlNone "츠루기가 우리에게 다가오지 않게 되면서,\n학교에서의 일상은 마침내 제자리로 돌아왔다."


translate japanese plot9_ef01dbf5:


    nvlNone "나도, 괴롭힘을 당하던 다른 애들도, 드디어 숨을 돌릴 수 있었다." (**end_page())


translate japanese plot9_4fc56800:


    nvl clear
    nvlNone "줄곧 머리 위를 덮었던 먹구름이 걷힌 것 같았다. 학교에 가는 일도 이제는 그렇게까지 싫지 않았다."


translate japanese plot9_fba6998d:


    nvlNone "다만…" (**end_page())


translate japanese plot9_72494f44:


    nvl clear
    nvlNone "츠루기가 이대로 포기할 것 같지는 않다."


translate japanese plot9_b44917d1:


    nvlNone "희진의 말대로――나를 용서할 리 없다." (**end_page())


translate japanese plot9_93791959:


    nvl clear
    nvlNone "분명 보이지 않는 곳에서 무언가를 꾸미고 있을 것이다."


translate japanese plot9_2167087c:


    nvlNone "그것만큼은 알았다. 나는 츠루기를 잘 알고 있었으니까." (**end_page())


translate japanese plot9_6c47f38b:


    nvl clear
    nvlNone "가장 싫어하는 상대를 가장 잘 알고 있다. 아이러니라고밖에 할 말이 없었다." (**end_page())


translate japanese plot9_6189b4a4:


    nvlNone "하지만 이제 무섭지 않다."


translate japanese plot9_6590c32d:


    nvlNone "무슨 짓을 해도, 뜻대로 하게 두지 않겠어." (**end_page())


translate japanese plot9_2946eb3a:


    voice "voice/banzhang_589.ogg"
    nvl_chronicle "바로 그렇다."


translate japanese plot9_febc11db:


    voice "voice/banzhang_590.ogg"
    nvl_yunqiu "어?"


translate japanese plot9_e7fbfb8a:


    voice "voice/banzhang_591.ogg"
    nvl_chronicle "네게 부족한 것은 그들에게 벌을 내릴 힘이다." (**end_page())


translate japanese plot9_09c0311a:


    nvl clear
    voice "voice/banzhang_592.ogg"
    nvl_chronicle "억울함도 분노도, 모조리 쏟아 내라."


translate japanese plot9_4a30e715:


    voice "voice/banzhang_593.ogg"
    nvl_yunqiu "그런 걸까……"


translate japanese plot9_f9248f96:


    voice "voice/banzhang_594.ogg"
    nvl_yunqiu "이게 정말 내가 하고 싶은 일일까…?" (**end_page())


translate japanese plot9_0e6558ca:


    nvl clear
    voice "voice/banzhang_595.ogg"
    nvl_chronicle "자신감을 갖고 고개를 들어라."


translate japanese plot9_5c13a027:


    voice "voice/banzhang_596.ogg"
    nvl_chronicle "너를 괴롭힌 자들은 이미 두려워하기 시작했다."


translate japanese plot9_b3b938b1:


    voice "voice/banzhang_597.ogg"
    nvl_yunqiu "지금 츠루기는 아무 짓도 안 해. 아직 흰쥐 일로 머리가 복잡한 걸까." (**end_page())


translate japanese plot9_9767422f:


    nvl clear
    voice "voice/banzhang_598.ogg"
    nvl_yunqiu "하지만 희진이랑 민영이는 분명 또 방해하러 올 거야…"


translate japanese plot9_e7d666ee:


    voice "voice/banzhang_599.ogg"
    nvl_chronicle "답은 이미 알고 있지 않느냐?"


translate japanese plot9_e2ef6e58:


    voice "voice/banzhang_600.ogg"
    nvl_yunqiu "…몇 번을 말해도 모른다면, 내가 경고할 거야." (**end_page())


translate japanese plot9_aaa626c0:


    nvl clear
    voice "voice/banzhang_601.ogg"
    nvl_yunqiu "하지만 그 전에… 하나 하고 싶은 게 있어."


translate japanese plot9_a5964f3e:


    voice "voice/banzhang_602.ogg"
    nvl_yunqiu "라이라랑… 이야기해 보고 싶어." (**end_page())


translate japanese plot9_0e8c6cc0:


    nvlNone "학년 집회가 끝난 뒤,\n라이라는 줄곧 괴롭힘의 진상을 알아내려 했다."


translate japanese plot9_09b58737:


    nvlNone "수업을 빼먹는 것까지 그만두고,\n교실에서 괴롭힘과 관련된 단서를 찾으려 했다."


translate japanese plot9_5a9d4bbf:


    nvlNone "우리는 라이라가 해 준 일을 전부 보고 있었다.{p}그런데도 진실을 말할 용기는 내지 못했다."


translate japanese plot9_f0f4e88c:


    nvlNone "츠루기 일행은 우리가 뭘 하는지 늘 지켜보고 있었다."


translate japanese plot9_e0babc84:


    nvlNone "그 결과――"


translate japanese plot9_f2b0b376:


    nvlNone "돕고 싶은 사람은 도움이 필요한 사람을 찾지 못한다."


translate japanese plot9_6c5d9663:


    nvlNone "도움이 필요한 사람은 도와주려는 사람에게 손을 뻗지 못한다." (**end_page())


translate japanese plot9_d46caa24:


    nvlNone "하지만 라이라의 노력이 의미 없었던 건 아니다."


translate japanese plot9_62a922d0:


    nvlNone "라이라의 눈에는 츠루기가 괴롭힘을 당하는 것처럼 보였다."


translate japanese plot9_dd882fae:


    nvlNone "생각했던 방향과는 달랐다.{p}그래도 나쁜 일은 아니었다."


translate japanese plot9_7c701aa1:


    nvlNone "라이라가 움직일 때마다 츠루기 일행은 크게 경계했고, 전보다 제멋대로 굴기 어려워졌다."


translate japanese plot9_80af454f:


    nvlNone "동시에 나는 여태껏 겪어 본 적 없을 만큼 깊이 갈등하기 시작했다."


translate japanese plot9_d38ae9c9:


    nvlNone "마음 깊은 곳에서는 내가 한 짓이 옳다고 생각되지 않았다."


translate japanese plot9_027ca7a5:


    nvlNone "내가 싫어하던 상대와 똑같은 모습이 된 것 같았다."


translate japanese plot9_e67051bf:


    nvlNone "그런 내가 되고 싶지는 않았다."


translate japanese plot9_bb9c4f7f:


    nvlNone "하지만 달리 할 수 있는 일도 별로 없었다.{p}내가 뭘 하고 싶은지도 이제 잘 모르겠다." (**end_page())


translate japanese plot9_703ddb1f:


    nvlNone "어째서인지 그때, 또 라이라가 떠올랐다."


translate japanese plot9_517bd2a4:


    nvlNone "라이라를 향한 어떤 마음이 진짜 나를 일깨운 건지도 모르겠다."


translate japanese plot9_2449a59e:


    nvlNone "憧れていたのか。それとも、前に助けを求められなかったことを、やり直したかったのか。"


translate japanese plot9_a09c62cb:


    nvl clear
    nvlNone "라이라와 이야기하며 내 마음을 확인하고 싶었다."


translate japanese plot9_693ff60e:


    nvl_yunqiu "저, 저기!" (**end_page())


translate japanese plot9_d743d714:


    voice "voice/tianqin_2045.ogg"
    nvl_tianqin_dialogue "어?"


translate japanese plot9_d8f27562:


    voice "voice/tianqin_2046.ogg"
    nvl_tianqin_dialogue "어? 반장이네. 무슨 일이야?"


translate japanese plot9_3e64467c:


    voice "voice/tianqin_2047.ogg"
    nvl_tianqin_dialogue "아—— 원예부에서 도와줄 일이 있어?" (**end_page())


translate japanese plot9_c733dfa9:


    nvl clear
    voice "voice/banzhang_604.ogg"
    nvl_yunqiu "아, 아니에요!"


translate japanese plot9_4ada3357:


    voice "voice/banzhang_605.ogg"
    nvl_yunqiu "오늘은……체육 특기생 훈련을 쉬었어요."


translate japanese plot9_6e8e2411:


    voice "voice/tianqin_2048.ogg"
    nvl_tianqin_dialogue "어? 왜? 몸이 안 좋아?" (**end_page())


translate japanese plot9_7cf0b376:


    nvl clear
    voice "voice/banzhang_606.ogg"
    nvl_yunqiu "아니에요! 몸 상태는 좋아요……"


translate japanese plot9_322f7c4a:


    voice "voice/banzhang_607.ogg"
    nvl_yunqiu "그냥……"


translate japanese plot9_371d2a6c:


    voice "voice/tianqin_2049.ogg"
    nvl_tianqin_dialogue "그냥……?" (**end_page())


translate japanese plot9_be80186f:


    nvl clear
    voice "voice/banzhang_608.ogg"
    nvl_yunqiu "오늘 방과 후에 같이 놀러 가도 될까요?"


translate japanese plot9_ea1039f6:


    voice "voice/tianqin_2050.ogg"
    nvl_tianqin_dialogue "어?" (**end_page())


translate japanese plot9_b3791f18:


    nvlNone "내가 먼저 라이라에게 같이 가자고 하는 날이 올 줄은 나도 상상하지 못했다."


translate japanese plot9_d003ec61:


    nvlNone "라이라 일행도 놀랐다. 하지만 이내,\n싫은 기색 없이 내 제안을 받아 줬다."


translate japanese plot9_be727c51:


    voice "voice/tianqin_2051.ogg"
    nvl_tianqin_dialogue "반장은 어디 가고 싶은 데 있어? 나도 히나타도 같이 가 줄게." (**end_page())


translate japanese plot9_8fa041d5:


    nvl clear
    voice "voice/banzhang_609.ogg"
    nvl_yunqiu "딱히 없어요."


translate japanese plot9_35f3f766:


    voice "voice/banzhang_610.ogg"
    nvl_yunqiu "그런데 두 분은 방과 후에 보통 어디에 가세요?"


translate japanese plot9_82b8d4ce:


    voice "voice/banzhang_611.ogg"
    nvl_yunqiu "두 분이 평소에 어떻게 지내는지 저도 한번 경험해 보고 싶어요." (**end_page())


translate japanese plot9_e3ed69ce:


    nvl clear
    voice "voice/tianqin_2052.ogg"
    nvl_tianqin_dialogue "에이, 우리 그렇게 성실한 학생은 아닌데? 별로 좋은 데는 안 갈지도 몰라."


translate japanese plot9_cde94e70:


    voice "voice/yangxi_728.ogg"
    nvl_yangxi "오해할 만한 말 하지 마."


translate japanese plot9_363f054d:


    voice "voice/tianqin_2053.ogg"
    nvl_tianqin_dialogue "반장이 같이 가도 괜찮을까 걱정돼서 한 말이지――" (**end_page())


translate japanese plot9_7c995566:


    nvl clear
    voice "voice/banzhang_612.ogg"
    nvl_yunqiu "괜찮아요. 꼭 데려가 주세요."


translate japanese plot9_9e48a80d:


    voice "voice/tianqin_2054.ogg"
    nvl_tianqin_dialogue "으음, 그렇다면 우리가 제일 자주 가는 곳은 역시 거기겠네." (**end_page())


translate japanese plot9_07c38fbc:


    voice "voice/yangxi_729.ogg"
    nvl_yangxi "시간 보내기엔 거기가 최고지." (**end_page())


translate japanese plot9_78e26cc5:


    nvl_tianqin_dialogue "짜잔. 도착했어."


translate japanese plot9_dac1bc9a:


    voice "voice/banzhang_613.ogg"
    nvl_yunqiu "여기, 오락실이죠…?"


translate japanese plot9_2026347f:


    voice "voice/banzhang_614.ogg"
    nvl_yunqiu "저희가 들어가도 되나요?" (**end_page())


translate japanese plot9_9914364c:


    nvl clear
    voice "voice/tianqin_2056.ogg"
    nvl_tianqin_dialogue "괜찮아, 괜찮아! 우리 이제 들어가도 되는 나이야!"


translate japanese plot9_e9533a51:


    voice "voice/banzhang_615.ogg"
    nvl_yunqiu "그런가요? 왠지 긴장되네요."


translate japanese plot9_f59c6434:


    voice "voice/tianqin_2057.ogg"
    nvl_tianqin_dialogue "자자, 긴장하지 마. 아무 일도 없을 테니까." (**end_page())


translate japanese plot9_3fe521cd:


    nvl clear
    voice "voice/tianqin_2058.ogg"
    nvl_tianqin_dialogue "요즘은 다들 스마트폰으로 게임해서, 여기 가게도 힘들거든. 우리가 오면 오히려 반가워하실걸."


translate japanese plot9_afb30c9a:


    voice "voice/banzhang_616.ogg"
    nvl_yunqiu "확실히 그래 보이네요…"


translate japanese plot9_7b012dea:


    nvlNone "오락실 안은 조용했고, 손님이 앉아 있는 기계도 몇 대 없었다." (**end_page())


translate japanese plot9_2c8d599f:


    nvl clear
    nvlNone "전기 요금을 아끼느라 켜 놓은 기계도 많지 않았다. 입구에 앉은 주인도 기운 없이 스마트폰을 보고 있었다."


translate japanese plot9_52093715:


    voice "voice/tianqin_2059.ogg"
    nvl_tianqin_dialogue "동전 사 올게. 둘은 먼저 마음에 드는 데 앉아 있어." (**end_page())


translate japanese plot9_e6c33257:


    nvlNone "라이라 일행은 오랫동안,\n나와 함께 아케이드 게임을 해 줬다."


translate japanese plot9_c52a1839:


    nvlNone "이런 게임은 처음이라,\n두 사람이 조작법을 천천히 알려 줬다." (**end_page())


translate japanese plot9_6a68981c:


    nvl clear
    nvlNone "게임에는 별로 관심이 없었기에,\n조금 해 보고 끝낼 줄 알았다."


translate japanese plot9_8e6eaaee:


    nvlNone "하지만 신기하게도, 무척 재미있었다." (**end_page())


translate japanese plot9_4ac2272c:


    nvl clear
    nvlNone "나는 금세 화면 속 승부에 푹 빠졌다."


translate japanese plot9_7c0c70dd:


    voice "voice/banzhang_617.ogg"
    nvl_yunqiu "이 게임, 재미있네요." (**end_page())


translate japanese plot9_5e89e56b:


    voice "voice/tianqin_2060.ogg"
    nvl_tianqin_dialogue "반장, 잘하네. 격투 게임에 재능 있는 거 아냐?" (**end_page())


translate japanese plot9_34db7f6b:


    nvlNone "내 안의 지기 싫어하는 성격이\n고개를 든 걸지도 모른다." (**end_page())


translate japanese plot9_32fffdcf:


    nvl clear
    nvlNone "기계 앞에 앉으니,\n어떻게든 라이라를 이기고 싶어졌다."


translate japanese plot9_f86ed476:


    nvlNone "나도 라이라에게 뒤지지 않는다는 걸 보여 주고 싶었다." (**end_page())


translate japanese plot9_3d3e59fd:


    nvl clear
    nvlNone "즐거워하는 라이라에게 이끌려,\n나까지 푹 빠져들었다."


translate japanese plot9_ceb52b0c:


    nvlNone "내게 이렇게\n승부욕이 강한 면이 있을 줄은 몰랐다." (**end_page())


translate japanese plot9_a8f823e6:


    nvl clear
    nvlNone "입학한 지 얼마 안 됐을 때, 주변 애들의 성적이 나보다 좋아서 필사적으로 공부하던 때와 같았다."


translate japanese plot9_852939c2:


    nvlNone "지금은 라이라를 이기고 싶다." (**end_page())


translate japanese plot9_28146b19:


    nvlNone "오락실에서 한참 놀고,\n집에 도착한 건 평소보다 훨씬 늦은 시간이었다."


translate japanese plot9_468d90a4:


    voice "voice/banzhang_618.ogg"
    nvl_yunqiu "미안해, 엄마. 늦게 들어와서…" (**end_page())


translate japanese plot9_96bbdafb:


    nvlNone "하지만 집 안에서는 대답이 없었다."


translate japanese plot9_0e8e28f7:


    voice "voice/banzhang_619.ogg"
    nvl_yunqiu "오늘도 야근이신가…" (**end_page())


translate japanese plot9_572f979f:


    nvl clear
    nvlNone "회사 문제가 마무리된 뒤로,\n엄마가 야근하는 날은 전보다 늘어났다."


translate japanese plot9_3a70a324:


    nvlNone "겉으로는 이미 끝난 일이었다." (**end_page())


translate japanese plot9_cbc862cb:


    nvl clear
    nvlNone "엄마를 모함한 후배는 해고됐다. 그래도 회사에는 아직 문제가 남아 있었다."


translate japanese plot9_e085161e:


    nvlNone "그 후배와 친했던 직원들은\n엄마를 대하는 태도가 확 달라졌다." (**end_page())


translate japanese plot9_396703b0:


    nvl clear
    nvlNone "그 때문에 엄마가 해야 하는 일은\n전보다 늘어났다."


translate japanese plot9_546d0bce:


    voice "voice/banzhang_620.ogg"
    nvl_yunqiu "너무 무리하지 않으셨으면 좋겠는데…" (**end_page())


translate japanese plot9_0a54ef65:


    nvl clear
    nvlNone "잘못한 사람은 사라졌다. 그런데도 착한 사람이 고통을 떠안고 있다."


translate japanese plot9_36b17b32:


    nvlNone "왜 늘 이런 식이 되는 걸까." (**end_page())


translate japanese plot9_d38fea16:


    nvlNone "그 후 이틀 동안, 방과 후 체육 특기생 훈련을 빠졌다."


translate japanese plot9_f4bf8ac5:


    nvlNone "츠루기 일행을 만나기 싫었던 걸지도 모른다. 아니면 아직 내 답을 찾지 못해서였을까."


translate japanese plot9_1c98025b:


    nvlNone "일상에서 조금 벗어나 생각을 정리하고 싶었다." (**end_page())


translate japanese plot9_b1174d08:


    voice "voice/tianqin_2061.ogg"
    nvl_tianqin_dialogue "노래방 갈래?"


translate japanese plot9_64a4e187:


    voice "voice/yangxi_730.ogg"
    nvl_yangxi "노래방이라…"


translate japanese plot9_47ba29dd:


    voice "voice/tianqin_2062.ogg"
    nvl_tianqin_dialogue "응. 생각해 보니까 노래하러 안 간 지 꽤 됐잖아." (**end_page())


translate japanese plot9_09a5a029:


    nvl clear
    voice "voice/yangxi_731.ogg"
    nvl_yangxi "그러고 보니……정말 안 간 지 꽤 됐네."


translate japanese plot9_420cefd1:


    voice "voice/tianqin_2063.ogg"
    nvl_tianqin_dialogue "그렇지!"


translate japanese plot9_940179a4:


    voice "voice/banzhang_621.ogg"
    nvl_yunqiu "그런데…… 노래방은 저희 나이에도 들어갈 수 있나요?" (**end_page())


translate japanese plot9_7e7b807a:


    nvl clear
    voice "voice/tianqin_2064.ogg"
    nvl_tianqin_dialogue "괜찮아, 반장."


translate japanese plot9_67f4090f:


    voice "voice/tianqin_2065.ogg"
    nvl_tianqin_dialogue "우리가 가는 곳은 이상한 사람들이 모이는 가게가 아니야.\n우리도 들어갈 수 있어."


translate japanese plot9_caa72a51:


    voice "voice/banzhang_622.ogg"
    nvl_yunqiu "그, 그런가요?" (**end_page())


translate japanese plot9_cfbed9bb:


    nvl clear
    voice "voice/tianqin_2066.ogg"
    nvl_tianqin_dialogue "가 보면 알아." (**end_page())


translate japanese plot9_1dd0814f:


    nvlNone "방과 후에는 라이라 일행을 따라다니며 함께 시간을 보냈다."


translate japanese plot9_b5bfbbcc:


    nvlNone "둘과 함께라면 매일 오가던 등하굣길도 재미있게 보였다."


translate japanese plot9_9fbd527f:


    nvlNone "학교 근처의 길도 가게도, 둘은 모르는 게 없었다." (**end_page())


translate japanese plot9_3bd92a96:


    nvl clear
    nvlNone "나는 매일 지나다니면서도 지금껏 아무것도 보지 못했다."


translate japanese plot9_bfc34424:


    nvlNone "내게 이 길에 있는 건 학교와 집뿐이었다." (**end_page())


translate japanese plot9_6b409273:


    voice "voice/tianqin_2067.ogg"
    nvl_tianqin_dialogue "노래방 가기 전에 저 가게 잠깐 보고 가자!"


translate japanese plot9_ad2a82fa:


    voice "voice/tianqin_2068.ogg"
    nvl_tianqin_dialogue "재미있어 보이는 장난감이 들어왔대!" (**end_page())


translate japanese plot9_7b470fd1:


    nvl clear
    voice "voice/yangxi_732.ogg"
    nvl_yangxi "그래? 노래방 예약은 괜찮아?"


translate japanese plot9_4a27a332:


    voice "voice/tianqin_2069.ogg"
    nvl_tianqin_dialogue "괜찮아, 괜찮아. 우리 거기 단골이잖아."


translate japanese plot9_3221b44f:


    voice "voice/tianqin_2070.ogg"
    nvl_tianqin_dialogue "벌써 예약 시간을 늦춰 뒀어." (**end_page())


translate japanese plot9_784dfa68:


    nvl clear
    nvlNone "라이라는 늘 즉흥적으로, 계획과는 다른 일을 시작한다."


translate japanese plot9_44d64f00:


    nvlNone "원래라면 십몇 분이면 갈 길인데, 벌써 삼십 분째 걷고 있다."


translate japanese plot9_ab500bec:


    nvlNone "도중에 신기한 걸 발견할 때마다 라이라가 한눈을 팔며 들르는 바람에, 시간이 한참 걸리고 말았다." (**end_page())


translate japanese plot9_49e095a0:


    voice "voice/tianqin_2071.ogg"
    nvl_tianqin_dialogue "반장, 가자. 저 가게 같이 구경하자."


translate japanese plot9_586f2265:


    voice "voice/banzhang_623.ogg"
    nvl_yunqiu "네!" (**end_page())


translate japanese plot9_bbed72b2:


    nvlNone "평소의 나라면,\n이렇게 계획이 바뀌는 걸 좋아하지 않았을 것이다." (**end_page())


translate japanese plot9_21e13650:


    nvl clear
    nvlNone "하지만 라이라와 함께라면 다른 곳에서 시간을 조금 보내도, 어째서인지 전혀 신경 쓰이지 않았다." (**end_page())


translate japanese plot9_c8264fa9:


    nvlNone "그녀를 따라 걷다 보니, 어지러웠던 생각도 조금 가라앉았다."


translate japanese plot9_8bb420d6:


    nvlNone "아마 나는 라이라를 동경했던 것이다." (**end_page())


translate japanese plot9_8fa0a9f8:


    nvl clear
    nvlNone "자유롭고 제멋대로지만, 해야 할 때는 진지하고, 옳은 일을 소중히 여긴다." (**end_page())


translate japanese plot9_1d2c69cb:


    nvl clear
    nvlNone "라이라를 보고 있으면 엄마가 떠올랐다." (**end_page())


translate japanese plot9_3abab6a3:


    nvl clear
    nvlNone "그래서 나는 유독 라이라에게 이끌렸던 걸지도 모른다."


translate japanese plot9_2d35df26:


    nvlNone "엄마에게 품었던 마음을 그녀에게도 겹쳐 보고 있었던 거겠지." (**end_page())


translate japanese plot9_8882b5c7:


    nvlNone "그녀처럼 되고 싶다. 그녀를 이기고 싶다."


translate japanese plot9_31cc13be:


    nvlNone "만약 라이라가 나라면 어떻게 할까?" (**end_page())


translate japanese plot9_a070b52e:


    nvl clear
    nvlNone "그렇게 생각하기 시작했다." (**end_page())


translate japanese plot9_1c0ad1f6:


    nvl_chronicle "왜 망설이지?"


translate japanese plot9_b7148832_3:


    voice "voice/banzhang_625.ogg"
    nvl_yunqiu "나는……"


translate japanese plot9_70c271b8:


    voice "voice/banzhang_626.ogg"
    nvl_chronicle "왜 주저하지?" (**end_page())


translate japanese plot9_5087c391:


    nvlNone "【그것｜나】의 목소리를 듣자마자, 싫은 기억이 몇 번이고 되살아났다."


translate japanese plot9_bb94e880:


    nvlNone "츠루기, 희진, 민영." (**end_page())


translate japanese plot9_ad28f99f:


    nvlNone "가라앉았던 마음이 다시 거세게 요동쳤다. 역시, 아직은 놓아줄 수 없다."


translate japanese plot9_ebae25be:


    nvlNone "하지만 어쩌면…" (**end_page())


translate japanese plot9_379cba16:


    nvl_chronicle "그들이 남긴 상처는 사라지지 않는다."


translate japanese plot9_c17793bf:


    voice "voice/banzhang_628.ogg"
    nvl_chronicle "그렇다면 벌을 내려라." (**end_page())


translate japanese plot9_22f5a912:


    nvlNone "마력으로 만들어진 피가,\n희진과 민영의 사물함에 흩뿌려졌다." (**end_page())


translate japanese plot9_1c9beba9:


    nvlNone "하지만 이제 복수했을 때의 쾌감은 없었다." (**end_page())


translate japanese plot9_ee613b62:


    nvl clear
    nvlNone "라이라라면……분노에 휩쓸려,\n이런 짓은 하지 않겠지."


translate japanese plot9_4c930516:


    nvlNone "이제 이 힘에 의지해서는 안 된다." (**end_page())


translate japanese plot9_4f5d8abf:


    nvl clear
    nvlNone "나는 당신이 아니야. 당신도 내가 아니고."


translate japanese plot9_e57d259d:


    nvlNone "그것이 내 답이었다." (**end_page())


translate japanese plot9_fedc9327:


    nvlNone "주말이 끝나고 학교에 도착하자마자,\n아키나에게 메시지가 왔다."


translate japanese plot9_143bcf70:


    voice "voice/xiaoxia_150.ogg"
    nvl_xiaoxia "원예부 화단이 망가졌어요!" (**end_page())


translate japanese plot9_79168e22:


    nvlNone "원예부에 도착하니, 눈앞이 엉망진창이었다."


translate japanese plot9_677a9a10:


    nvlNone "아키나와 다른 부원들이 망가진 화단을 치우고 있었다. 슬픈 표정을 감추지 못하고 있었다." (**end_page())


translate japanese plot9_62eb1438_1:


    voice "voice/xiaoxia_151.ogg"
    nvl_xiaoxia "반장……"


translate japanese plot9_84abd99f:


    voice "voice/banzhang_629.ogg"
    nvl_yunqiu "…너무해요."


translate japanese plot9_22668c7f:


    nvlNone "아무도 입 밖에 내지는 않았다. 하지만 누가 한 짓인지는 알고 있었다." (**end_page())


translate japanese plot9_45a2e31f:


    nvl clear
    voice "voice/xiaoxia_152.ogg"
    nvl_xiaoxia "반장, 어떻게 해야 해…?"


translate japanese plot9_d063863a:


    voice "voice/xiaoxia_153.ogg"
    nvl_xiaoxia "이대로는 더 이상 안 돼…"


translate japanese plot9_b74126e6:


    voice "voice/banzhang_630.ogg"
    nvl_yunqiu "알아." (**end_page())


translate japanese plot9_8fddb64f:


    nvl clear
    voice "voice/banzhang_631.ogg"
    nvl_yunqiu "다들 먼저 치우고 있어요. 저는 지금 가서 담임 선생님께 전부 말씀드릴게요."


translate japanese plot9_4438ef4a:


    nvlNone "원예부 애들은 아무 잘못도 없다. 츠루기 일행은,\n나에게 복수하려고 이곳을 망가뜨린 것이다." (**end_page())


translate japanese plot9_55763a41:


    nvlNone "왜 이제 와서,\n이런 짓을 했는지는 모르겠다."


translate japanese plot9_aaa59467:


    nvlNone "하지만 다음에 뭘 해야 할지는 알고 있었다."


translate japanese plot9_ee79f383:


    nvlNone "지금의 나는 더는 그 애들이 무섭지 않다." (**end_page())


translate japanese plot9_82849164:


    voice "voice/xiaoxia_154.ogg"
    nvl_xiaoxia "잠깐, 반장!"


translate japanese plot9_6b8a8a1a:


    voice "voice/banzhang_632.ogg"
    nvl_yunqiu "왜 그래, 아키나?"


translate japanese plot9_d4f4f4ee:


    voice "voice/xiaoxia_155.ogg"
    nvl_xiaoxia "…역시 그만두는 게 나을지도 몰라." (**end_page())


translate japanese plot9_febc11db_1:


    nvl clear
    voice "voice/banzhang_633.ogg"
    nvl_yunqiu "어?"


translate japanese plot9_5ae28041:


    voice "voice/xiaoxia_156.ogg"
    nvl_xiaoxia "아니… 아무것도 아니에요…"


translate japanese plot9_331444ae:


    voice "voice/xiaoxia_157.ogg"
    nvl_xiaoxia "선생님께 말씀드리고 와 줄래요…?" (**end_page())


translate japanese plot9_814022b5:


    nvl clear
    voice "voice/banzhang_634.ogg"
    nvl_yunqiu "…괜찮아요. 이번에야말로 끝낼 거예요. 이제 도망치지 않을 테니까요."


translate japanese plot9_ff084962:


    voice "voice/banzhang_635.ogg"
    nvl_yunqiu "담임 선생님께 전부 말씀드릴게요. 그러면,\n여러분도 사실대로 말해 줬으면 해요."


translate japanese plot9_c4b4ce9b:


    voice "voice/xiaoxia_158.ogg"
    nvl_xiaoxia "응. 알겠어요…" (**end_page())


translate japanese plot9_1640a03a:


    nvl clear
    nvlNone "역시 아키나는 나를 가장 잘 이해하고 있었다."


translate japanese plot9_615ca44d:


    nvlNone "그 일들에 내가 관련돼 있다는 걸 이미 눈치챘을지도 모른다."


translate japanese plot9_0962ae31:


    voice "voice/banzhang_636.ogg"
    nvl_yunqiu "그럼 다녀올게요. 다들 당분간 조심해요." (**end_page())


translate japanese plot9_0fdbb651:


    nvlNone "담임 선생님께 원예부에서 일어난 일을 말씀드렸다."


translate japanese plot9_9ae42bac:


    nvlNone "그뿐만이 아니었다. 츠루기가 우리를 괴롭혀 온 일도."


translate japanese plot9_b8f7a6b0:


    nvlNone "원예부를 제멋대로 쓴 일. 동물을 괴롭힌 일. 우리에게 무리한 일을 시키고 비웃은 일. 모두 담임 선생님께 털어놓았다." (**end_page())


translate japanese plot9_538c5a52:


    nvl clear
    voice "voice/banzhuren_180.ogg"
    nvl_teacher "츠루기였구나…"


translate japanese plot9_d083e0a5_1:


    voice "voice/banzhang_637.ogg"
    nvl_yunqiu "네……"


translate japanese plot9_ee6a3400:


    voice "voice/banzhuren_181.ogg"
    nvl_teacher "그 고발 편지는 네가 썼니?" (**end_page())


translate japanese plot9_7557ab00:


    nvl clear
    voice "voice/banzhang_638.ogg"
    nvl_yunqiu "아니요. 저는 아니에요…"


translate japanese plot9_ea7bfcb9:


    voice "voice/banzhang_639.ogg"
    nvl_yunqiu "아마……아키나가 쓴 것 같아요. 오래전부터 츠루기 일행이 하는 짓을 못마땅해했거든요."


translate japanese plot9_ee73f01a:


    voice "voice/banzhuren_182.ogg"
    nvl_teacher "그… 혹시 증거로 찍어 둔 건 있니?" (**end_page())


translate japanese plot9_7b6c26e9:


    nvl clear
    voice "voice/banzhuren_183.ogg"
    nvl_teacher "예를 들면 츠루기가 동물을 해치는 장면이라든가."


translate japanese plot9_3e2ab2a2:


    voice "voice/banzhang_640.ogg"
    nvl_yunqiu "없어요… 그때는 츠루기가 무서워서…"


translate japanese plot9_615dbd46:


    voice "voice/banzhuren_184.ogg"
    nvl_teacher "그렇겠지. 많이 힘들었겠다." (**end_page())


translate japanese plot9_4bfee33c:


    nvl clear
    voice "voice/banzhang_641.ogg"
    nvl_yunqiu "죄송해요……"


translate japanese plot9_d60e1ab7:


    voice "voice/banzhuren_185.ogg"
    nvl_teacher "아키. 네가 사과할 일이 아니야."


translate japanese plot9_8547ffe4:


    voice "voice/banzhuren_186.ogg"
    nvl_teacher "이렇게 말해 준 것만으로도 정말 대단한 거야." (**end_page())


translate japanese plot9_2e8a806a:


    nvl clear
    voice "voice/banzhuren_187.ogg"
    nvl_teacher "사과해야 할 건 선생님이야.\n알아차리지 못한 건 전부 내 책임이니까."


translate japanese plot9_5386b060:


    voice "voice/banzhuren_188.ogg"
    nvl_teacher "아키, 정말 미안해."


translate japanese plot9_3aa838ec:


    voice "voice/banzhang_642.ogg"
    nvl_yunqiu "선생님……" (**end_page())


translate japanese plot9_301b08e5:


    nvl clear
    voice "voice/banzhuren_189.ogg"
    nvl_teacher "안심하렴. 이제 아무도 너희를 해치지 못하게 할게."


translate japanese plot9_dfa21069:


    voice "voice/banzhuren_190.ogg"
    nvl_teacher "다만 당장 모든 걸 끝내기는 어려워."


translate japanese plot9_ac9df666:


    voice "voice/banzhuren_191.ogg"
    nvl_teacher "원예부 애들하고도 한 명씩 이야기하고,\n그다음에 학교에 알려야 해." (**end_page())


translate japanese plot9_908d4fde:


    nvl clear
    voice "voice/banzhuren_192.ogg"
    nvl_teacher "그동안 학교를 조금 쉴래?"


translate japanese plot9_9d4d1c1e:


    voice "voice/banzhang_643.ogg"
    nvl_yunqiu "아니요, 선생님. 이제 괜찮아요."


translate japanese plot9_81551c0c:


    voice "voice/banzhang_644.ogg"
    nvl_yunqiu "지금은 츠루기 일행이 무섭지 않아요. 저쪽도,\n이제 저한텐 아무 짓도 못 할 것 같아요." (**end_page())


translate japanese plot9_dee9b259:


    nvl clear
    voice "voice/banzhang_645.ogg"
    nvl_yunqiu "게다가 이번 주 목요일에는 체육 특기생 종합시험이 있어요. 좋은 성적을 낼 기회를 놓치고 싶지 않아요."


translate japanese plot9_ac758437:


    voice "voice/banzhuren_193.ogg"
    nvl_teacher "알겠어. 나중에 김 선생님하고도 이 일을 상의해 볼게."


translate japanese plot9_39577964:


    voice "voice/banzhuren_194.ogg"
    nvl_teacher "체육 시험과 월례 시험이 끝나면, 다음 주에 네 어머니와 츠루기 부모님을 학교로 모시고 이 일에 관해 이야기하자." (**end_page())


translate japanese plot9_16712c94:


    nvl clear
    voice "voice/banzhuren_195.ogg"
    nvl_teacher "며칠 안에 아키 너도 어머니께 말씀드려 두렴." (**end_page())


translate japanese plot9_7af76e49:


    nvlNone "담임 선생님께서 약속해 주셔서, 이제 그렇게까지 걱정되지는 않았다."


translate japanese plot9_ec3969cc:


    nvlNone "담임 선생님은 책임감을 갖고 움직여 주는 분이다. 좀 더 일찍 말씀드렸다면 이 지경까지는 오지 않았을지도 모른다." (**end_page())


translate japanese plot9_068c6979:


    nvl clear
    nvlNone "그 후 며칠 동안도 츠루기 일행은 아무 짓도 하지 않았다."


translate japanese plot9_efab001d:


    nvlNone "나는 평소처럼 공부하고 훈련하며 다가오는 시험을 준비했다." (**end_page())


translate japanese plot9_dcf2d652:


    nvl clear
    nvlNone "시간이 예전으로 돌아간 것 같았다.\n나와 츠루기가 엮일 일도 더는 없었다." (**end_page())


translate japanese plot9_8e73a7c7:


    nvlNone "하지만 며칠이 지나도록 엄마에게는 말하지 못했다."


translate japanese plot9_2b9ab0ab:


    nvlNone "어떻게 말해야 할지, 여전히 망설여졌다." (**end_page())


translate japanese plot9_0741f2c2:


    nvl_yunqiu "엄마… 아직인가?"


translate japanese plot9_8c8d3d79:


    nvlNone "훈련을 마치고, 나는 학교를 나섰다."


translate japanese plot9_fbfadefc:


    nvlNone "오늘은 엄마가 내일 있을 체육 시험을 응원할 겸, 밖에서 뭘 좀 먹자고 하셨다." (**end_page())


translate japanese plot9_8ba33075:


    nvl clear
    nvlNone "일 때문에 늦으시는 것 같아, 약속 장소에서 조금 기다리기로 했다."


translate japanese plot9_838baaa9:


    nvlNone "잠시 후, 길 건너편에 몇 사람이 있다는 걸 알아차렸다." (**end_page())


translate japanese plot9_9964b1a9:


    voice "voice/banzhang_647.ogg"
    nvl_yunqiu "츠루기 일행… 왜 여기에?"


translate japanese plot9_42079db7:


    nvlNone "츠루기네 집은 이 근처가 아니었을 텐데. 왜 갑자기 마주친 건지 알 수 없었다." (**end_page())


translate japanese plot9_767007cb:


    nvlNone "길 반대편으로 옮겨, 생각할 겨를도 없이 세 사람을 피했다." (**end_page())


translate japanese plot9_54485710:


    nvl clear
    nvlNone "이제 무섭지는 않다. 그래도 엮이고 싶지는 않았다." (**end_page())


translate japanese plot9_43f8f55c:


    voice "voice/mama_76.ogg"
    nvl_mama "아키――!"


translate japanese plot9_de6ae0ee:


    voice "voice/banzhang_648.ogg"
    nvl_yunqiu "엄마, 여기!"


translate japanese plot9_0dd4b09d:


    voice "voice/mama_77.ogg"
    nvl_mama "미안해. 많이 기다렸지?" (**end_page())


translate japanese plot9_c0a00f17:


    nvl clear
    voice "voice/mama_78.ogg"
    nvl_mama "회사에 일이 좀 생겨서 늦어 버렸네."


translate japanese plot9_2c3792b7:


    voice "voice/banzhang_649.ogg"
    nvl_yunqiu "아니에요. 저도 방금 왔어요."


translate japanese plot9_480a2d2e:


    voice "voice/mama_79.ogg"
    nvl_mama "그럼 먼저 밥 먹을까? 아니면 좀 둘러볼까?" (**end_page())


translate japanese plot9_639dd5db:


    nvl clear
    voice "voice/banzhang_650.ogg"
    nvl_yunqiu "있잖아, 엄마. 나…"


translate japanese plot9_f3cf3b95:


    voice "voice/mama_80.ogg"
    nvl_mama "응?"


translate japanese plot9_9829deda:


    voice "voice/banzhang_651.ogg"
    nvl_yunqiu "그 전에 하고 싶은 말이 있어…" (**end_page())


translate japanese plot9_f632ce30:


    nvl clear
    nvlNone "꺼내려던 말을, 입 밖에 내기 직전에 삼켰다."


translate japanese plot9_55c9ed36:


    voice "voice/mama_81.ogg"
    nvl_mama "왜 그래?"


translate japanese plot9_63552565:


    nvlNone "엄마는 내 손을 잡고, 내가 무언가 말하기 어려워한다는 걸 알아차리셨다." (**end_page())


translate japanese plot9_8c5f137f:


    nvl clear
    nvlNone "그 눈빛에 용기를 얻어, 전부 이야기하기로 마음먹었다."


translate japanese plot9_bd4c71ee:


    voice "voice/banzhang_652.ogg"
    nvl_yunqiu "사실, 학교에서…"


translate japanese plot9_b4f18104:


    voice "voice/mama_82.ogg"
    nvl_mama "아키!!!" (what_prefix="{w=0.94}「", what_slow_cps=0, **end_page())


translate japanese plot9_cd5f4c48:


    nvlNone "차의 브레이크 소리를 알아차렸을 때는 이미 늦었다."


translate japanese plot9_b338e0bb:


    nvlNone "차가 곧장 나를 향해 달려오고 있었다." (**end_page())


translate japanese plot9_d6674e10:


    nvl clear
    nvlNone "나는 움직일 수 없었다. 전원이 꺼진 로봇처럼,\n그 자리에 얼어붙었다."


translate japanese plot9_9117cba1:


    nvlNone "아주 짧은 순간, 머릿속이 새하얘졌다." (**end_page())


translate japanese plot9_cdcb3d29:


    nvlNone "그때 엄마가 내 손을 놓았다."


translate japanese plot9_4c4423d4:


    nvlNone "내 어깨에 손을 얹고, 힘껏 밀었다." (**end_page())


translate japanese plot9_24292db1:


    nvlNone "쿵――"


translate japanese plot9_ebf7b546:


    nvlNone "몇 걸음이나 비틀거리다 도로의 난간에 부딪혔다." (**end_page())


translate japanese plot9_442941ca_3:


    nvlNone "…"


translate japanese plot9_030168bb:


    "大きな音がした。その直後、激しい耳鳴りが始まった。"


translate japanese plot9_442941ca_4:


    nvl clear
    nvlNone "…" (**end_page())


translate japanese plot9_7c4ef1f7:


    nvlNone "눈을 떴다."


translate japanese plot9_98ea808f:


    nvlNone "누군가 달리고 있었다." (**end_page())


translate japanese plot9_dff8bb20:


    nvlNone "누군가 나를 향해 무언가를 외치고 있었다."


translate japanese plot9_14cff9db:


    nvlNone "보이는데도, 알 수 없었다." (**end_page())


translate japanese plot9_afee7076:


    nvlNone "분명히 보이는데."


translate japanese plot9_a7e74adb:


    voice "voice/banzhang_653.ogg"
    nvl_yunqiu "어… 엄마?" (**end_page())


translate japanese plot9_d385a23a:


    nvlNone "몸을 지탱해 일어나, 앞으로 걸었다."


translate japanese plot9_4becf891:


    nvlNone "엄마가 거기 쓰러져 있었다." (**end_page())


translate japanese plot9_6517981e:


    nvl clear
    nvlNone "엄마가 나를 보고 있었다."


translate japanese plot9_d6f4c191_3:


    voice "voice/banzhang_654.ogg"
    nvl_yunqiu "…" (**end_page())


translate japanese plot9_c69f740c:


    nvlNone "무릎을 꿇고 손을 뻗었다."


translate japanese plot9_2264efd1:


    nvlNone "하지만 중간에 멈췄다. 만질 수 없었다." (**end_page())


translate japanese plot9_ae00f039:


    nvlNone "만지면 안 돼. 만지면 진짜가 되어 버려."


translate japanese plot9_331cbf23:


    nvlNone "엄마의 입이 조금씩 움직이고 있었다." (**end_page())


translate japanese plot9_1d46cf9e:


    nvlNone "하지만 뭐라고 하시는지 들리지 않는다."


translate japanese plot9_2dcb88c5:


    nvlNone "가까이 가고 싶다. 제대로 듣고 싶다. 하지만 다리가 움직이지 않았다." (**end_page())


translate japanese plot9_eaea687b:


    nvlNone "누군가 달려왔다."


translate japanese plot9_62dede21:


    nvlNone "많은 사람들. 점점 더 늘어난다." (**end_page())


translate japanese plot9_68886794:


    nvl clear
    nvlNone "엄마 상태를 살피는 사람. 전화하는 사람. 사진이나 영상을 찍는 사람."


translate japanese plot9_368fe6bc:


    nvlNone "누군가 나를 일으켜 옆으로 데려갔다." (**end_page())


translate japanese plot9_816f5ac4:


    nvl clear
    voice "voice/banzhang_655.ogg"
    nvl_yunqiu "자… 잠깐만."


translate japanese plot9_a034217f:


    nvlNone "엄마는 아직 저기에 있어." (**end_page())


translate japanese plot9_dc730b56:


    nvl clear
    nvlNone "많은 사람이 엄마를 둘러싸고 있었다."


translate japanese plot9_7bc2b335:


    nvlNone "엄마가 보이지 않게 됐다." (**end_page())


translate japanese plot9_9c85849d:


    nvlNone "그때, 시야 끝에 무언가가 들어왔다."


translate japanese plot9_d7235316:


    nvlNone "길 건너편에서 강렬한 기척이 내 시선을 잡아끌었다." (**end_page())


translate japanese plot9_a4ea3ef5:


    nvlNone "츠루기 일행이었다." (**end_page())


translate japanese plot9_66e05926:


    nvlNone "츠루기는 사람들 틈에 있지 않았다." (**end_page())


translate japanese plot9_f7629d51:


    nvl clear
    nvlNone "그저 길 건너에 서 있었다. 다가오지도, 돌아가려 하지도 않은 채."


translate japanese plot9_b3e8dfdb:


    nvlNone "――기다리고 있었다." (**end_page())


translate japanese plot9_fc0adc81:


    nvl clear
    nvlNone "내가 알아차리기를 기다리고 있었다."


translate japanese plot9_ad7dfcda:


    nvlNone "내가 알아차릴 걸 알고 있었다." (**end_page())


translate japanese plot9_4b3054a5:


    nvl clear
    nvlNone "숨으려 하지도 않고, 재미있다는 듯 나를 보고 있었다."


translate japanese plot9_c11fdc64:


    nvlNone "오랫동안 기다리던 일이 마침내 일어났다는 얼굴로." (**end_page())


translate japanese plot9_a8753091:


    nvlNone "왜 츠루기가 여기에 있지?" (**end_page())


translate japanese plot9_066e96d4:


    nvlNone "왜 요즘은 아무 짓도 안 했지?" (**end_page())


translate japanese plot9_381ad37d:


    nvlNone "츠루기가 한 거야? 이게 복수야?" (**end_page())


translate japanese plot9_f64ac47b:


    nvlNone "왜 엄마야?" (**end_page())


translate japanese plot9_01fbbb20:


    nvlNone "왜?" (**end_page())


translate japanese plot9_8eb41367:


    p9_why_narrator "[p9_why_page('왜？')]{nw}" (**end_page(ctc_displayable="plot8_white_ctc_end"))


translate japanese plot9_8f4d772e:


    chroniclenameless "かわいそうな少女よ。"


translate japanese plot9_crown_browse_dismissible_d6f4c191:


    voice "voice/banzhang_657.ogg"
    yunqiu "…"


translate japanese plot9_0878c5fc:


    chroniclenameless2 "分かってる。"


translate japanese plot9_crown_browse_dismissible_67f260fe:


    voice "voice/banzhang_659.ogg"
    chroniclenameless2 "그렇다면, 전부 부숴 버리자."

translate japanese strings:


    old "{glitch=10}{color=#FFFFFF}{b}记忆的碎片{/b}{/color}{/glitch}"
    new "{glitch=10}{color=#FFFFFF}{b}기억의 조각{/b}{/color}{/glitch}"

translate japanese strings:

    old "班长的记忆碎片随着她的情感一并涌入了脑内。"
    new "반장의 감정과 함께, 산산이 흩어진 기억이 머릿속으로 흘러들었다."

    old "过量的信息让所有人都失去了意识。"
    new "한꺼번에 너무 많은 것을 본 탓에, 모두의 의식이 끊어졌다."

    old "班长展示了自己的上半身，"
    new "반장은 자신의 상반신을 드러냈다."

    old "那里和鹤城她们一样，只剩下一个空洞。"
    new "그곳에도 츠루기 일행처럼 텅 빈 구멍만 남아 있었다."


translate japanese plot9_965cbe6b:

    nvlNone "——시선을 가리기에는 이보다 좋은 곳이 없었다." (**end_page())


translate japanese plot9_d8b25fbf:

    nvlNone "바깥쪽 뿌리는 서로 얽혀 높이 솟아 있었으므로\n가까이 가지 않으면 안쪽은 전혀 보이지 않았다."


translate japanese plot9_593324c6:

    nvl clear
    nvlNone "체육 특기생 종합시험 결과는 앞으로의 진학에도 영향을 준다. 어지간한 이유가 아니면 빠질 리가 없다."


translate japanese plot9_542ab937:

    nvl clear
    nvlNone "내 직감은 언제나 잘 맞는다——분명 이 불길한 예감도."


translate japanese plot9_crown_browse_dismissible_488448b0:

    nvlNone "중학교에도 그런 학생은 얼마든지 있었다.{p}오히려 그녀 같은 사람이 더 많을 정도였다."


translate japanese plot9_crown_browse_dismissible_3330e68f:

    nvlNone "하지만 첫 시험 결과가 나왔을 때\n히나타를 보는 내 시선은 완전히 바뀌었다."


translate japanese plot9_crown_browse_dismissible_83e5f8cd:

    nvlNone "히나타를 만나고서야 깨달았다.{p}나와, 내가 얕보던 「천재 아동」\n사이에 얼마나 큰 격차가 있는지를."


translate japanese plot9_crown_browse_dismissible_bdbb9e25:

    nvlNone "성적만 보고 공부하는 걸 그만두고,\n전보다 넓게 주변을 볼 수 있게 되었다."


translate japanese plot9_crown_browse_dismissible_fe68c1b2:

    nvl clear
    nvlNone "그러고 나서 왼쪽 뺨에 타는 듯한 통증이 퍼지기 시작했다." (**end_page())


translate japanese plot9_crown_browse_dismissible_fba5a8d1:

    nvlNone "한 번 본모습을 드러낸 뒤로는 더욱 심해졌다."


translate japanese plot9_crown_browse_dismissible_99a1e5fe:

    nvlNone "하지만 엄마 이야기를 듣는 순간, 머리가 멈추고 아무 생각도 할 수 없었다." (**end_page())


translate japanese plot9_crown_browse_dismissible_ce1c6eb7:

    nvlNone "조금 누렇게 바랜 천장마저 지금은 너무 무서워 보였다." (**end_page())


translate japanese plot9_crown_browse_dismissible_a2cd47d4:

    nvlNone "또 그 「쇼」를 보여 주려는 줄 알았다.\n하지만 도착하자마자 세 사람에게 둘러싸였다."


translate japanese plot9_crown_browse_dismissible_80c8dde7:

    nvlNone "흰쥐를 먹은 뒤로, 마음속에 다른 누군가가 살고 있는 것 같았다."


translate japanese plot9_7daa9463:

    nvlNone "절정에 이른 쾌감이 온몸을 내달렸다. 내가 원했던 건 바로 이거였구나." (**end_page())


translate japanese plot9_crown_browse_dismissible_223c8a74:

    nvlNone "그게 무사히 선생님께 전해진다면…"


translate japanese plot9_crown_browse_dismissible_078af44e:

    nvlNone "동경했던 걸까. 아니면,\n전에 도움을 청하지 못했던 일을 다시 해 보고 싶었던 걸까." (**end_page())


translate japanese plot9_crown_browse_dismissible_5d501b02:

    nvlNone "커다란 소리가 났다. 그 직후, 귀가 심하게 울리기 시작했다." (**end_page())


translate japanese plot9_crown_browse_dismissible_50619731:

    nvlNone "츠루기로서는\n집안사람에게 아주 잠깐 이야기했을 뿐일지도 모른다." (**end_page())


translate japanese plot9_crown_browse_dismissible_673d4dbb:

    nvlNone "공부가 뒤처지지 않도록 노력하고 있었다.{p}하지만 마음은 언제나\n엄마 일로 가득했다."


translate japanese plot9_crown_browse_dismissible_37be70e9:

    nvlNone "놀란 얼굴. 동요를 감추고 아무 일 없었던 척하는 모습. 작은 변화까지 전부 내 눈에 들어왔다." (**end_page())


translate japanese plot9_43c21218:


    voice "voice/npc40_03.ogg"
    npc40 "어? 김 선생님? 여긴 어쩐 일이세요?"



translate japanese plot9_aec09416:


    voice "voice/tianqin_1995.ogg"
    tianqin "학생을 찾고 계신 것 같던데, 무슨 일 있나요?"



translate japanese plot9_4368d3a5:


    voice "voice/jinlaoshi_103.ogg"
    jinlaoshi "연락처 있니? 연락이 되는지 한번 봐 줄래?"



translate japanese plot9_1fdc9c93:


    voice "voice/tianqin_2004.ogg"
    tianqin "집에서 중앙 공원으로 가려면 여길 지날 것 같아서 기다리고 있었어."



translate japanese plot9_af2b043e:


    voice "voice/tianqin_2009.ogg"
    tianqin "아니, 전부 결석했을 리 없어. 오늘은 그 애들한테 아주 중요한 날이야……"



translate japanese plot9_b4ba4439:


    voice "voice/tianqin_2017.ogg"
    tianqin "대체 무슨 일이야!"



translate japanese plot9_e330eee5:


    voice "voice/cygnus_1144.ogg"
    cygnus "이 세계 사람들은 이렇게 많은 마나를 접한 적이 없으니, 곧바로 「마나 멀미」 상태에 빠진 거지."



translate japanese plot9_crown_browse_dismissible_d7c58a21:


    voice "voice/banzhang_376.ogg"
    banzhang2 "죄송해요. 멋대로 빌려 버려서."



translate japanese plot9_crown_browse_dismissible_2c12592b:


    voice "voice/banzhang_384.ogg"
    banzhang2 "뭐라고 하면 좋을까요……처음에는 조금 혼내 주려고 했을 뿐이에요."



translate japanese plot9_crown_browse_dismissible_c3ed141e:


    voice "voice/banzhang_394.ogg"
    banzhang2 "영혼을 마나체로 바꾸는 거예요. 그 과정이 불완전하면 사람은 저렇게 돼요."



translate japanese plot9_crown_browse_dismissible_6f6e662b:


    voice "voice/banzhang_401.ogg"
    banzhang2 "남의 힘을 빌리려면 그만한 대가는 필요하겠죠?"



translate japanese plot9_crown_browse_dismissible_f552268a:


    voice "voice/banzhang_658.ogg"
    chroniclenameless "알고 있다."


translate japanese plot9_e078c497:


    nvlNone "「으, 징그러워…」{p}「이게 뭐야? 장난이야?」{p}「우와, 어떻게 이런 짓을…」{p}「……」" (**end_page())



translate japanese plot9_crown_browse_dismissible_7373326a:


    chroniclenameless "가엾은 소녀여."

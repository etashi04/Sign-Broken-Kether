


translate japanese plot5_56aa567c:



    voice "voice/cygnus_592.ogg"
    cygnus "이제 슬슬 시간이 됐나."


translate japanese plot5_b600e214:


    "라이라는 시노스와 오늘 방과 후에 학교로 가서 마도구의 단서를 찾기로 약속했다."


translate japanese plot5_4563895c:


    "시노스가 벽시계를 보니 어느새 라이라의 수업이 끝날 시간이었다."


translate japanese plot5_8885bc26:



    voice "voice/cygnus_593.ogg"
    cygnus "좋아, 나가자."


translate japanese plot5_1f8d7af9:



    voice "voice/cygnus_594.ogg"
    cygnus "（라이라가 근처 다과점에서 기다린다고 했지…）"


translate japanese plot5_69281466:



    voice "voice/cygnus_595.ogg"
    cygnus "（다과점이라…）"


translate japanese plot5_ce48b8b7:



    voice "voice/jiaozi_08.ogg"
    jiaozi "멍멍——!"


translate japanese plot5_7adf2c37:


    "시노스가 아파트 건물에서 나오자 입구에 있던 자오쯔가 곧장 달려왔다."


translate japanese plot5_989c0fd8:



    voice "voice/cygnus_596.ogg"
    cygnus "자오쯔, 미안해. 지금은 같이 놀러 갈 수 없어."


translate japanese plot5_8e82a85b:



    voice "voice/jiaozi_02.ogg"
    jiaozi "멍…"


translate japanese plot5_1f6a4f81:


    "자오쯔는 말을 알아들은 듯 풀이 죽어 고개를 숙였다."


translate japanese plot5_822f8b5a:


    "그러면서도 시노스의 뒤를 따라 아파트 밖으로 뛰어나왔다."


translate japanese plot5_bc01ce5e:



    voice "voice/cygnus_597.ogg"
    cygnus "다과점……"


translate japanese plot5_ca3de3bb:



    voice "voice/cygnus_598.ogg"
    cygnus "다과점은 어떤 곳일까?"


translate japanese plot5_391a2265:


    "시노스는 인터넷에서 찾아본 정보를 바탕으로 「다과점」이 디저트 가게 같은 곳이리라 짐작했다."


translate japanese plot5_436a3ad8:


    "근처 동네를 한 바퀴 돌았지만 디저트 가게처럼 보이는 곳은 찾지 못했다."


translate japanese plot5_020e7c2d:



    voice "voice/cygnus_599.ogg"
    cygnus "라이라한테 좀 더 자세히 물어볼걸……"


translate japanese plot5_db43e6c3:



    voice "voice/jiaozi_23.ogg"
    jiaozi 0102 "멍멍― 멍―!"


translate japanese plot5_293cdd20:



    voice "voice/cygnus_600.ogg"
    cygnus "응? 자오쯔, 왜 따라왔어?"


translate japanese plot5_ce48b8b7_1:



    voice "voice/jiaozi_24.ogg"
    jiaozi "멍멍——!"


translate japanese plot5_3e15a54e:


    "자오쯔는 시노스 앞으로 다가와 두 바퀴 빙빙 돌더니 혀를 내밀고 그녀를 바라보았다."


translate japanese plot5_603390e1:



    voice "voice/cygnus_601.ogg"
    cygnus "이건…… 따라오라는 뜻이야?"


translate japanese plot5_6e041d2a:



    voice "voice/jiaozi_20.ogg"
    jiaozi 0102 "멍멍——!"


translate japanese plot5_14145d4d:


    "자오쯔는 시노스를 데리고 느긋하게 근처를 돌아다녔다."


translate japanese plot5_6324fbe3:


    "시노스는 잠깐 한눈을 팔다 자오쯔를 따라 낯선 거리까지 와 버렸다."


translate japanese plot5_f15e62ca:



    voice "voice/cygnus_602.ogg"
    cygnus "（어!? 여긴 어디지…）" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_c4ab3c67:



    voice "voice/cygnus_603.ogg"
    cygnus "（자오쯔는!?）"


translate japanese plot5_b224e720:



    voice "voice/npc3_09.ogg"
    npc48 "얘야, 혹시… 길을 잃었니?"


translate japanese plot5_3ca0c727:



    voice "voice/cygnus_604.ogg"
    cygnus "아, 아뇨……"


translate japanese plot5_be5c2a1c:


    "시노스가 돌아보니 앞치마를 두른 이십 대쯤의 여성이 서 있었다."


translate japanese plot5_bc5c4857:



    voice "voice/cygnus_605.ogg"
    cygnus "（지금은 도움을 거절할 때가 아니야. 길을 물어보는 게 낫겠지.）"


translate japanese plot5_9f67bacb:



    voice "voice/cygnus_606.ogg"
    cygnus "음…… 저기, 언니. 길 좀 물어봐도 될까요?"


translate japanese plot5_45469ba4:



    voice "voice/npc34_01.ogg"
    npc34 "어머, 어디 가려고 그러니?"


translate japanese plot5_ac0d54e9:



    voice "voice/cygnus_607.ogg"
    cygnus "다과점을 찾고 있어요. 이 근처에 있을 텐데……"


translate japanese plot5_1bd85107:



    voice "voice/npc34_02.ogg"
    npc34 "어? 이 근처 다과점을 찾는구나. 그럼 아마 내가 일하는 가게일 거야."


translate japanese plot5_daacfa5d:



    voice "voice/cygnus_608.ogg"
    cygnus "어?"


translate japanese plot5_ab4215d4:


    "시노스는 그렇게 무척이나 싹싹한 언니의 손에 이끌려 가게로 들어갔다."


translate japanese plot5_c4e6aff2:


    "일본풍의 작은 가게였고, 「다과점」이라는 특징에도 확실히 맞았다."


translate japanese plot5_0ef3a741:


    "그런데 시노스는 왜 아까 이곳을 찾지 못했을까?"


translate japanese plot5_43cee4e6:


    "가게 이름과 간판이 너무 독특해서 도무지 다과를 파는 곳으로 보이지 않았기 때문이다."


translate japanese plot5_65ee036d:


    "그 이름은 바로——"


translate japanese plot5_0335d426:


    centertext "{size=72}「돼지 지옥」{/size}"


translate japanese plot5_cb8c50bd:



    voice "voice/cygnus_609.ogg"
    cygnus "（영문도 모른 채 가게로 끌려 들어와 버렸네…）"


translate japanese plot5_ccb45246:



    voice "voice/cygnus_610.ogg"
    cygnus "（…잠깐!）"


translate japanese plot5_0a3b99c6:



    voice "voice/tianqin_994.ogg"
    tianqin "시노스, 꼭 조심해야 해."


translate japanese plot5_5c0ec2dd:



    voice "voice/tianqin_995.ogg"
    tianqin "이 세상에는 나쁜 마음을 먹은 사람도 많거든."


translate japanese plot5_054978cf:


    "시노스는 문득 라이라가 전에 했던 말을 떠올렸다."


translate japanese plot5_933e5a2d:


    "그 순간 시노스는 경계하기 시작했다."


translate japanese plot5_703aec18:



    voice "voice/cygnus_611.ogg"
    cygnus "（라이라가 늘 주변을 경계하라고 했는데. 이 요리사, 설마 나쁜 사람은…）"


translate japanese plot5_6a4a151f:



    voice "voice/cygnus_612.ogg"
    cygnus "（인터넷에서 그런 얘기를 봤어. 이 세상에는 사람을 가게로 데려간 다음 억지로 돈을 내게 하는 악덕 가게도 있다던데…）"


translate japanese plot5_2ee85b81:



    voice "voice/chef_01.ogg"
    chef "얘야, 뭐 좀 먹을래?"


translate japanese plot5_4d247f13:



    voice "voice/cygnus_613.ogg"
    cygnus "감사하지만 돈을 안 가져와서 괜찮아요."


translate japanese plot5_d0228a23:



    voice "voice/cygnus_614.ogg"
    cygnus "（아무튼, 일단 내 의사를 확실히 밝혀야 해!）"


translate japanese plot5_ec72d1e4:



    voice "voice/chef_02.ogg"
    chef "어머, 돈은 안 받아. 언니가 사 주는 거야."


translate japanese plot5_90ceda7d:



    voice "voice/cygnus_615.ogg"
    cygnus "그, 그래도 괜찮아요. 지금은 배가 안 고파서……"


translate japanese plot5_67b53d2e:



    voice "voice/chef_03.ogg"
    chef "아이, 그렇게 사양하지 않아도 돼."


translate japanese plot5_63382e5d:


    "시노스는 낯선 언니를 잔뜩 경계했다."


translate japanese plot5_a4836eb8:


    "그러면서도 어쩐지 익숙한 느낌이 들었다. 이 붙임성 좋은 성격이 누군가와 꽤 닮아 있었다."


translate japanese plot5_940a5f18:



    voice "voice/chef_04.ogg"
    chef "자, 메뉴 여기 있어."


translate japanese plot5_7cd99965:


    "메뉴판을 손에 떠밀리듯 받아 들자, 시노스도 더는 거절할 수 없었다."


translate japanese plot5_d7fb1170:



    voice "voice/cygnus_616.ogg"
    cygnus "그, 그럼……"


translate japanese plot5_6cfebfc8:


    "시노스는 메뉴판을 훑어보았다. 온통 아기자기한 과자 사진이었다."


translate japanese plot5_8cc42f73:


    "가격은 저렴했지만 무슨 함정이 있을까 봐 많이 주문할 엄두는 나지 않았다."


translate japanese plot5_772435f0:



    voice "voice/cygnus_617.ogg"
    cygnus "그럼…… 이걸로 할게요……"


translate japanese plot5_f74889b8:



    voice "voice/chef_05.ogg"
    chef "어! {a=dictionary:dict_entry_60}딸기 양갱{/a}? 알겠어."


translate japanese plot5_5cec441a:



    voice "voice/chef_06.ogg"
    chef "안목이 좋네. 그게 우리 가게 대표 메뉴거든."


translate japanese plot5_b992777e:



    voice "voice/cygnus_618.ogg"
    cygnus "아…… 네……"


translate japanese plot5_138e6938:


    "안목의 문제는 아니었다. 딸기 양갱이 메뉴판에서 가장 눈에 띄는 곳에 있어서 골랐을 뿐이었다."


translate japanese plot5_d41d8cd9:


    voice "voice/chef_07.ogg"


translate japanese plot5_cf8746ac:


    chef "기다렸지? 주문한 딸기 양갱이야."


translate japanese plot5_8f2184de:


    "점장은 곧 분홍색 양갱 한 접시를 가져왔다. 함께 나온 것은 {a=dictionary:dict_entry_61}삼색 경단{/a} 세 꼬치였다."


translate japanese plot5_d41d8cd9_1:


    voice "voice/cygnus_619.ogg"


translate japanese plot5_c09a461a:


    cygnus "어? 저는 이것만 주문했는데……"


translate japanese plot5_2b038893:



    voice "voice/chef_08.ogg"
    chef "그건 내가 주는 거야. 양갱 하나만 먹기엔 좀 허전하잖아."


translate japanese plot5_b0b4212c:



    voice "voice/chef_09.ogg"
    chef "한창 클 나이니까 많이 먹어."


translate japanese plot5_8477acf1:



    voice "voice/cygnus_620.ogg"
    cygnus "가, 감사합니다……"


translate japanese plot5_ebf4b36a:



    voice "voice/cygnus_621.ogg"
    cygnus "（전부 {a=dictionary:dict_entry_59}이스트국{/a}의 과자네… 여기서 보게 될 줄은 몰랐어.）"


translate japanese plot5_0c1cbc66:


    "시노스에게 눈앞의 다과가 아주 낯선 것은 아니었다. 원래 살던 세계에서도 비슷한 것을 만드는 곳이 있었다."


translate japanese plot5_9295ca63:



    voice "voice/cygnus_622.ogg"
    cygnus "먹어 볼까……"


translate japanese plot5_e5a1f07b:


    "（우물우물.）"


translate japanese plot5_7d435c3a:



    voice "voice/cygnus_623.ogg"
    cygnus "――!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_02458364:



    voice "voice/cygnus_624.ogg"
    cygnus "（윽…!?）"


translate japanese plot5_8961d93d:



    voice "voice/cygnus_625.ogg"
    cygnus "（이게… 어떻게 된 거지…）"


translate japanese plot5_9670c2b7:


    "겉으로 보기에는 특별할 것 없는 다과였다."


translate japanese plot5_ba23029e:


    "하지만 가장 중요한 맛이 무척 이상했다."


translate japanese plot5_5dfbe4fc:


    "달콤해야 할 딸기 양갱은 입에 넣자 먼저 시고 떫은 맛이 났고, 한참 뒤에야 은은한 단맛이 올라왔다."


translate japanese plot5_ea2f2a06:


    "삼색 경단은 더 이상했다. 입에 넣으니 쓰고 매운맛이 났다."


translate japanese plot5_6fbb68a3:


    "쓰고 매운 경단을 몇 번이나 씹다 보니, 쓴맛에 혀가 저릿해진 탓인지 차츰 은은한 짠맛까지 느껴졌다."


translate japanese plot5_f4d3a330:



    voice "voice/chef_10.ogg"
    chef "맛이 어때?"


translate japanese plot5_ccada395:



    voice "voice/cygnus_626.ogg"
    cygnus "아, 그게… 꽤 맛있었어요…"


translate japanese plot5_0137a1d2:



    voice "voice/chef_11.ogg"
    chef "마음에 든다니 다행이네."


translate japanese plot5_09c8a843:


    "시노스는 솔직한 감상을 차마 입 밖으로 내지 못했다."


translate japanese plot5_2e97e97d:


    "눈앞의 다과 두 접시는 이 언니가 공짜로 준 것이었다. 호의를 무시할 수는 없었다."


translate japanese plot5_c75c7f73:


    "삼키지 못할 정도는 아니지만, 아무래도 맛이…"


translate japanese plot5_cfe37a09:



    voice "voice/chef_12.ogg"
    chef "그럼 더 만들어 줄까?"


translate japanese plot5_2483b9f4:



    voice "voice/cygnus_627.ogg"
    cygnus "아뇨, 괜찮아요! 여기서 사람만 기다리면 돼요." with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_0947ea0a:



    voice "voice/chef_13.ogg"
    chef "그래? 그럼 천천히 먹으렴. 방해 안 할게."


translate japanese plot5_abe4e94e:



    voice "voice/cygnus_628.ogg"
    cygnus "네, 고마워요."


translate japanese plot5_0fd8455d:



    voice "voice/cygnus_629.ogg"
    cygnus "（이상하네… 왜 이런 맛이지…）"


translate japanese plot5_be036e2e:



    voice "voice/cygnus_630.ogg"
    cygnus "（이 세상 과자는 다 이런가? 아니면 이 가게만 이런 걸까?）"


translate japanese plot5_8a60daa7:


    "시노스는 혼란스러웠다. 평소 라이라의 요리를 먹을 때는 이 세계의 식문화가 원래 세계보다 훨씬 발달한 것처럼 느껴졌다. 하지만 이 가게의 맛은 그녀의 미각을 원래 세계로 되돌려 놓았다."


translate japanese plot5_e45b03ce:



    voice "voice/cygnus_631.ogg"
    cygnus "으음……"


translate japanese plot5_891c0b32:


    "그러다 시노스는 가게에 자신 말고 다른 손님이 없다는 사실을 깨달았다."


translate japanese plot5_6711c7a8:


    "직원도 아까 그 언니뿐이었다."


translate japanese plot5_de053b13:


    "이 가게의 음식 맛에 문제가 있다는 방증인 듯했다."


translate japanese plot5_d013598e:



    voice "voice/cygnus_632.ogg"
    cygnus "（그렇다면… 저 요리사가 여기 점장인가?）"


translate japanese plot5_9673929f:



    voice "voice/tianqin_996.ogg"
    tianqin "안녕하세요——!"


translate japanese plot5_ff9e3e15:



    voice "voice/chef_14.ogg"
    chef "어? 라이라? 학교 끝났어?"


translate japanese plot5_2c36993b:



    voice "voice/tianqin_997.ogg"
    tianqin "네, 오는 길에 뭐 좀 먹으려고요."


translate japanese plot5_18c53c65:



    voice "voice/tianqin_998.ogg"
    tianqin "여기 저 기다리는 작은 애 없어요?"


translate japanese plot5_ce0ccd3d:



    voice "voice/chef_15.ogg"
    chef "아, 그 애가 기다리던 사람이 너였구나. 저쪽에 있어."


translate japanese plot5_4925ae12:



    voice "voice/cygnus_633.ogg"
    cygnus "여기야."


translate japanese plot5_78e7075b:



    voice "voice/tianqin_999.ogg"
    tianqin "아, 시노……"


translate japanese plot5_94e50923:


    "라이라가 입에 올리려던 이름은 시노스의 매서운 눈총에 다시 목구멍 안으로 삼켜졌다."


translate japanese plot5_061b99da:


    "공공장소에서 마녀의 진명을 드러내는 것은 금기였다."


translate japanese plot5_6e808294:



    voice "voice/tianqin_1000.ogg"
    tianqin "크흠——! 아사요." with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_84b105ae:



    voice "voice/cygnus_634.ogg"
    cygnus "응."


translate japanese plot5_bd7e637a:



    voice "voice/chef_16.ogg"
    chef "한참 기다리더라. 어서 가 봐."


translate japanese plot5_4c41d419:



    voice "voice/cygnus_635.ogg"
    cygnus "늦었잖아."


translate japanese plot5_0f00a6d4:



    voice "voice/tianqin_1001.ogg"
    tianqin "미안, 미안—— 학교에서 볼일이 좀 있어서."


translate japanese plot5_0c26c549:



    voice "voice/cygnus_636.ogg"
    cygnus "그럼 이제 출발할까?"


translate japanese plot5_6f70b0da:



    voice "voice/tianqin_1002.ogg"
    tianqin "아직 안 돼. 학교 문 닫을 시간이 안 돼서 학생들이 많이 남아 있거든."


translate japanese plot5_d0513439:



    voice "voice/cygnus_637.ogg"
    cygnus "그럼 언제 가는데?"


translate japanese plot5_c2a32ec5:



    voice "voice/tianqin_1003.ogg"
    tianqin "어디 보자……"


translate japanese plot5_ff8c24f4:



    voice "voice/tianqin_1004.ogg"
    tianqin "한 시간쯤 뒤?"


translate japanese plot5_f48fb40d:



    voice "voice/cygnus_638.ogg"
    cygnus "그럼 그때 불러 줘. 난 일단 집에…"


translate japanese plot5_61a34563:



    voice "voice/tianqin_1005.ogg"
    tianqin "잠깐, 잠깐, 잠깐——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_3bf6205e:



    voice "voice/cygnus_639.ogg"
    cygnus "왜 그래?"


translate japanese plot5_631a5e81:



    voice "voice/tianqin_1006.ogg"
    tianqin "서둘러 돌아가지 마. 저녁은 여기서 먹자."


translate japanese plot5_f533bb9b:



    voice "voice/cygnus_640.ogg"
    cygnus "여기서?"


translate japanese plot5_8e12909a:



    voice "voice/tianqin_1007.ogg"
    tianqin "응."


translate japanese plot5_e45b03ce_1:



    voice "voice/cygnus_641.ogg"
    cygnus "으음……"


translate japanese plot5_c4b5d634:


    "방금 먹었던 음식이 떠올라 시노스는 여기서 저녁을 먹고 싶지 않았다."


translate japanese plot5_d8aaad46:



    voice "voice/tianqin_1008.ogg"
    tianqin "음~? 표정을 보니 점장님이 뭐 좀 주셨구나?"


translate japanese plot5_4540da67:



    voice "voice/cygnus_642.ogg"
    cygnus "응…"


translate japanese plot5_12652d09:



    voice "voice/tianqin_1009.ogg"
    tianqin "맛은 어땠어?"


translate japanese plot5_22d2e1fc:



    voice "voice/cygnus_643.ogg"
    cygnus "어……"


translate japanese plot5_5dbd3aab:


    "시노스는 대답 대신 고개를 저었다. 차마 말하기 힘들다는 표정이었다."


translate japanese plot5_a407b245:



    voice "voice/tianqin_1010.ogg"
    tianqin "헤헤, 괜찮아. 주문은 나한테 맡겨."


translate japanese plot5_3e898b71:



    voice "voice/tianqin_1011.ogg"
    tianqin "점장님! 주문할게요——!"


translate japanese plot5_443c1297:



    voice "voice/chef_17.ogg"
    chef "갈게."


translate japanese plot5_5438d394:


    "잠시 후 점장이 라이라가 주문한 음식을 가져왔다."


translate japanese plot5_1bd13d68:


    "아까 같은 다과가 아니라 양이 푸짐한 라멘이었다."


translate japanese plot5_af3b8662:


    "아무리 봐도 다과점에서 나올 법한 음식은 아니었다."


translate japanese plot5_92fc5ae1:



    voice "voice/cygnus_644.ogg"
    cygnus "（이것도 이스트국의 요리와 아주 비슷하네.）"


translate japanese plot5_1811487b:



    voice "voice/cygnus_645.ogg"
    cygnus "（그런데 맛은…）"


translate japanese plot5_ed3a30bd:


    "아까 다과에 한 번 당한 시노스는 눈앞의 라멘이 의심스러웠다."


translate japanese plot5_1c6716ea:



    voice "voice/tianqin_1012.ogg"
    tianqin "이건 라멘이라고 해."


translate japanese plot5_e42f9588:



    voice "voice/cygnus_646.ogg"
    cygnus "내 세…… 고향에도 비슷한 음식이 있어."


translate japanese plot5_a1d6e93b:



    voice "voice/tianqin_1013.ogg"
    tianqin "그래? 그럼 여기 것도 먹어 봐. 정말 맛있어."


translate japanese plot5_e45b03ce_2:



    voice "voice/cygnus_647.ogg"
    cygnus "으음……"


translate japanese plot5_eb7ed85b:


    "시노스는 라멘 위에 뜬 기름만 빤히 바라보며 좀처럼 젓가락을 들지 않았다."


translate japanese plot5_bdac47e0:



    voice "voice/tianqin_1014.ogg"
    tianqin "아, 너무 느끼해 보여? 좀 담백한 걸로 바꿔 줄까?"


translate japanese plot5_6ee07c16:



    voice "voice/cygnus_648.ogg"
    cygnus "아니, 괜찮아."


translate japanese plot5_f8621409:



    voice "voice/cygnus_649.ogg"
    cygnus "（맛없으면 미각을 차단하면 돼!）"


translate japanese plot5_234ee7a7:


    "중대한 결심이라도 한 듯, 시노스는 깊게 숨을 들이쉬고 마침내 젓가락을 들어 면을 한입 후루룩 먹었다."


translate japanese plot5_7d435c3a_1:



    voice "voice/cygnus_650.ogg"
    cygnus "――!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_58da4c4d:



    voice "voice/cygnus_651.ogg"
    cygnus "（이, 이건…!）"


translate japanese plot5_ca8eb236:



    voice "voice/cygnus_652.ogg"
    cygnus "（아까 다과랑 완전히 달라!）"


translate japanese plot5_4eccfc3c:



    voice "voice/cygnus_653.ogg"
    cygnus "（면발의 단단함이 절묘하고, 국물 맛도 굉장히 진해.）"


translate japanese plot5_bc1b8065:



    voice "voice/cygnus_654.ogg"
    cygnus "（고기와 기름, 마늘의 풍미가 어우러져서 면에 고스란히 배어 있어.）"


translate japanese plot5_c677b19d:



    voice "voice/tianqin_1015.ogg"
    tianqin "어때? 맛 괜찮지?"


translate japanese plot5_9385f357:



    voice "voice/cygnus_655.ogg"
    cygnus "응, 정말 맛있어……"


translate japanese plot5_c100ee07:



    voice "voice/tianqin_1016.ogg"
    tianqin "아까 다과랑은 다르지?"


translate japanese plot5_e213f373:



    voice "voice/cygnus_656.ogg"
    cygnus "응, 확실히 차이가 크네."


translate japanese plot5_c33a2561:



    voice "voice/tianqin_1017.ogg"
    tianqin "아까 먹기 망설인 것도 이해해. 점장님은 항상 다과만 공짜로 주시거든."


translate japanese plot5_b79bcd81:



    voice "voice/tianqin_1018.ogg"
    tianqin "여긴 라멘이 제일 맛있어."


translate japanese plot5_e7dcd2f2:



    voice "voice/cygnus_657.ogg"
    cygnus "그런데 아까 메뉴판에는 라멘이 없었는데……"


translate japanese plot5_2bb846fd:



    voice "voice/tianqin_1019.ogg"
    tianqin "있어, 있어. 자, 여기."


translate japanese plot5_39c615ea:


    "라이라가 메뉴판 뒷면의 눈에 잘 띄지 않는 구석을 가리켰다. 작게 라멘 메뉴가 적혀 있었다."


translate japanese plot5_0fabb995:


    "꼼꼼히 살펴보지 않으면 아예 눈에 들어오지도 않을 위치였다."


translate japanese plot5_11706f46:


    "사진마저 없었으니 시노스가 이런 국수 요리를 판다는 걸 알 리 없었다."


translate japanese plot5_378a6daf:



    voice "voice/cygnus_658.ogg"
    cygnus "라멘은 왜 이렇게 꼭꼭 숨겨 놨지?"


translate japanese plot5_68aed34f:



    voice "voice/chef_18.ogg"
    chef "여긴 다과점이니까."


translate japanese plot5_fbc7a5ff:



    voice "voice/cygnus_659.ogg"
    cygnus "네!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_cd915dee:


    "어느새 점장이 시노스 옆에 나타나 있었다."


translate japanese plot5_777ddaa8:


    "얼굴에는 여전히 웃음이 가득했지만, 온몸에서 강한 압박감이 뿜어져 나왔다."


translate japanese plot5_88cbf5b4:



    voice "voice/chef_19.ogg"
    chef "여기는 다과점이야. 라멘은 부업일 뿐이란다."


translate japanese plot5_26f55c54:



    voice "voice/cygnus_660.ogg"
    cygnus "아, 네, 그렇군요…… 죄송해요……"


translate japanese plot5_d84464c5:


    "점장은 더 말하지 않았지만, 그 분위기만으로도 방금 질문이 위험했다는 것을 알 수 있었다."


translate japanese plot5_7e38b21a:



    voice "voice/tianqin_1020.ogg"
    tianqin "참, 점장님. 어린애 겁주지 마세요."


translate japanese plot5_1a4f2a1e:



    voice "voice/chef_20.ogg"
    chef "응? 사실대로 말했을 뿐인데?"


translate japanese plot5_be085c16:



    voice "voice/cygnus_661.ogg"
    cygnus "굉장한 기백이야. 완전히 압도당했어……"


translate japanese plot5_e1ce43cd:



    voice "voice/tianqin_1021.ogg"
    tianqin "아하하, 원래 저런 분이셔."


translate japanese plot5_48344822:



    voice "voice/tianqin_1022.ogg"
    tianqin "아무리 다과점이라고 고집하셔도 단골들은 라멘만 시키거든."


translate japanese plot5_cf05b842:



    voice "voice/tianqin_1023.ogg"
    tianqin "가게 이름도 딱 라멘집 이름이잖아."


translate japanese plot5_72e9c036:



    voice "voice/tianqin_1024.ogg"
    tianqin "「돼지 지옥」이라니—— 아무리 봐도 다과점 이름은 아니지. 하하."


translate japanese plot5_7d2ece84:



    voice "voice/chef_21.ogg"
    chef "응?"


translate japanese plot5_22af639c:



    voice "voice/tianqin_1025.ogg"
    tianqin "크흠——! 아무것도 아니에요!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_624714e6:



    voice "voice/tianqin_1026.ogg"
    tianqin "점장님, 한 그릇 더 주세요."


translate japanese plot5_fd708974:



    voice "voice/cygnus_662.ogg"
    cygnus "어? 벌써 다 먹었어?"


translate japanese plot5_4a3c5b26:


    "시노스가 고개를 들어 보니 라이라 앞의 그릇은 이미 비어 있었다. 정작 자신은 이제 한입 먹었을 뿐이었다."


translate japanese plot5_7d8d8c9d:



    voice "voice/tianqin_1027.ogg"
    tianqin "네가 고민하는 동안 난 벌써 절반 넘게 먹었거든."


translate japanese plot5_0a8559cd:


    "쿵——" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_050c3b66:


    "점장이 금세 새 라멘 한 그릇을 가져왔다."


translate japanese plot5_e43cf9b3:


    "아까 것보다도 큰 그릇이었다. 위에 올린 숙주는 작은 산처럼 수북했다."


translate japanese plot5_a90504a0:



    voice "voice/tianqin_1028.ogg"
    tianqin "잘 먹겠습니다."


translate japanese plot5_e91f96fc:



    voice "voice/cygnus_663.ogg"
    cygnus "몇 번을 봐도 네 식사량은 놀라워……"


translate japanese plot5_1cf0690b:



    voice "voice/tianqin_1029.ogg"
    tianqin "으! 난 그냥 남들보다 조금 더 먹는 것뿐이야."


translate japanese plot5_0f014090:



    voice "voice/cygnus_664.ogg"
    cygnus "（절대로 「조금」이 아니야.）"


translate japanese plot5_b7bdf8c7:



    voice "voice/tianqin_1030.ogg"
    tianqin "넌 천천히 먹어. 아직 시간 많으니까 서두를 것 없어."


translate japanese plot5_a26379e4:



    voice "voice/chef_22.ogg"
    chef "라이라, 이것도 이따 먹으렴."


translate japanese plot5_3efb781f:


    "점장이 산더미 같은 딸기 양갱을 가져와 라이라 앞에 내려놓았다."


translate japanese plot5_af1fd877:


    "시노스가 조금 전 맛본 가게 대표 메뉴, 시고 떫은 딸기 양갱이었다."


translate japanese plot5_f506f21d:



    voice "voice/tianqin_1031.ogg"
    tianqin "네!? 잠깐만요, 점장님. 저 좀 배부른데……"


translate japanese plot5_91a255de:



    voice "voice/chef_23.ogg"
    chef "응? {cps=*0.15}다·먹·어·야·지?{/cps}"


translate japanese plot5_3d696cac:



    voice "voice/tianqin_1032.ogg"
    tianqin "네…"


translate japanese plot5_d9ce3e70:



    voice "voice/cygnus_665.ogg"
    cygnus "（엄청난 압박감이야. 라이라까지 꼼짝 못 하게 하다니…）"


translate japanese plot5_279cbea2:


    "마침내 라이라는 딸기 양갱을 전부 먹어 치웠다."


translate japanese plot5_835fe652:


    "다만 얼굴을 잔뜩 찡그리고 있어 꽤나 괴로워 보였다."


translate japanese plot5_de99813b:



    voice "voice/tianqin_1033.ogg"
    tianqin "배불러, 배불러. 이젠 정말 아무것도 먹기 싫어…… 여러모로……"


translate japanese plot5_7a6b7a9e:



    voice "voice/cygnus_666.ogg"
    cygnus "나도 배불러."


translate japanese plot5_86857ec2:



    voice "voice/tianqin_1034.ogg"
    tianqin "음—— 시간도 됐으니 가자."


translate japanese plot5_4e419eda:



    voice "voice/tianqin_1035.ogg"
    tianqin "점장님! 계산할게요!"


translate japanese plot5_bbee86e4:


    "라이라는 시노스를 데리고 학교 쪽으로 향했고, 거리에는 밤의 내음이 퍼져 갔다."


translate japanese plot5_11423d78:


    "학교에 도착했을 때는 달이 하늘 높이 떠 있었다."


translate japanese plot5_f0c1bfe8:


    "하지만 라이라는 정문 앞에서 멈추지 않고 그대로 지나쳐 학교 옆으로 돌아갔다."


translate japanese plot5_e099bf6e:



    voice "voice/cygnus_667.ogg"
    cygnus "교문은 이쪽 아니야?"


translate japanese plot5_bc82ffc6:



    voice "voice/tianqin_1036.ogg"
    tianqin "정문 말고 다른 입구로 들어갈 거야."


translate japanese plot5_1d39ce53:



    voice "voice/cygnus_668.ogg"
    cygnus "왜?"


translate japanese plot5_5174498b:



    voice "voice/tianqin_1037.ogg"
    tianqin "밤에 학교에 아무도 없다고 해도 마음대로 들어갈 수는 없거든."


translate japanese plot5_43ec929b:



    voice "voice/cygnus_669.ogg"
    cygnus "그러니까…… 결국 몰래 들어가야 하는 거네?"


translate japanese plot5_284b3e5d:



    voice "voice/tianqin_1038.ogg"
    tianqin "맞아. 외부인은 출입 금지라서 넌 들키면 바로 쫓겨날걸."


translate japanese plot5_81fafb69:



    voice "voice/tianqin_1039.ogg"
    tianqin "하지만 밤이면 괜찮아. 다들 집에 가고 경비원 한두 분만 남거든."


translate japanese plot5_17b29afa:



    voice "voice/cygnus_670.ogg"
    cygnus "그 사람들이 순찰도 해? 마법으로 먼저 전부 재울까?"


translate japanese plot5_f5562e3b:



    voice "voice/tianqin_1040.ogg"
    tianqin "진정해. 던전 공략하는 것도 아니잖아!"


translate japanese plot5_71ed9443:



    voice "voice/tianqin_1041.ogg"
    tianqin "경비원은 가끔 한 바퀴 도실 뿐이니까 우릴 발견하지 못할 거야."


translate japanese plot5_13dfb05d:



    voice "voice/tianqin_1042.ogg"
    tianqin "그래도 너무 소란을 피우면 안 돼. 그분들이 오시면 귀찮아지니까."


translate japanese plot5_88f1437e:



    voice "voice/cygnus_671.ogg"
    cygnus "꽤 잘 아네."


translate japanese plot5_b6695013:



    voice "voice/tianqin_1043.ogg"
    tianqin "어, 그건 내가 가끔 밤에 학교에 오니까……"


translate japanese plot5_1d39ce53_1:



    voice "voice/cygnus_672.ogg"
    cygnus "왜?"


translate japanese plot5_01d7f089:



    voice "voice/tianqin_1044.ogg"
    tianqin "으! 비밀——!"


translate japanese plot5_1f85eb43:



    voice "voice/yangxi_267.ogg"
    yangxi "으… 너무 많이 먹었어…"


translate japanese plot5_01ac4f58:



    voice "voice/yangxi_268.ogg"
    yangxi "저 가게, 소짜랑 대짜 양을 헷갈린 거 아니야……?"


translate japanese plot5_3abfbe95:



    voice "voice/yangxi_269.ogg"
    yangxi "음……?"


translate japanese plot5_d06eca39:



    voice "voice/yangxi_270.ogg"
    yangxi "……라이라? 저쪽엔 왜 가지?"


translate japanese plot5_0ca0fe6a:



    voice "voice/yangxi_271.ogg"
    yangxi "옆에 있는 사람은 또 누구고……?"


translate japanese plot5_21dbbb1f:



    voice "voice/tianqin_1045.ogg"
    tianqin "여기야."


translate japanese plot5_d911a9da:


    "라이라는 시노스를 학교의 외진 구석으로 데려갔다. 시노스의 키를 거의 넘길 만큼 높은 관목 때문에 밖에서는 학교 울타리조차 보이지 않았다."


translate japanese plot5_3c28f4ff:



    voice "voice/tianqin_1046.ogg"
    tianqin "바짝 따라와."


translate japanese plot5_f99c8340:



    voice "voice/cygnus_673.ogg"
    cygnus "잠깐——"


translate japanese plot5_e81ef07e:


    "시노스의 말이 끝나기도 전에 라이라는 손을 잡고 덤불 속으로 들어갔다."


translate japanese plot5_6ec67b37:


    "부스럭부스럭——"


translate japanese plot5_5206df51:


    "라이라는 앞장서 길을 내며 관목과 작은 나무의 날카로운 가지들을 손으로 꺾었다. 뒤따르는 시노스가 긁히지 않도록 하려는 것이었다."


translate japanese plot5_91f1031f:


    "시노스는 라이라가 왜 갑자기 자신을 덤불 속으로 데려가는지 몰랐지만, 지금은 그 손을 꼭 잡고 따라갈 수밖에 없었다."


translate japanese plot5_0e00b4bf:


    "덤불 깊숙이 들어갈수록 가로등 빛이 희미해졌다."


translate japanese plot5_57b1cd16:


    "칠팔 미터쯤 들어가자 시노스는 발밑의 길을 겨우 분간할 수 있을 정도였다."


translate japanese plot5_57094df9:



    voice "voice/tianqin_1047.ogg"
    tianqin "여기."


translate japanese plot5_6192f951:


    "라이라는 어둠 속에서 이리저리 더듬고 겹겹이 우거진 가지와 잎을 헤친 끝에 학교 울타리를 찾아냈다."


translate japanese plot5_4da3fb6e:


    "비에 녹슨 철제 울타리는 무성한 관목에 밀려 구멍이 나 있었다. 이것이 라이라가 말한 「다른 입구」였다."


translate japanese plot5_5d518ce8:



    voice "voice/tianqin_1048.ogg"
    tianqin "이 틈으로 들어가면 학교야."


translate japanese plot5_5af7c237:



    voice "voice/tianqin_1049.ogg"
    tianqin "이렇게, 쏙…… 들어…… 가면……!"


translate japanese plot5_d10da901:


    "철제 울타리에는 제법 큰 틈이 있었지만, 관목이 무성하게 자란 탓에 라이라가 비집고 들어가기는 쉽지 않았다."


translate japanese plot5_59746876:



    voice "voice/tianqin_1050.ogg"
    tianqin "어? 요즘 너무 먹었나…… 지난번에는 쉽게 들어갔는데……"


translate japanese plot5_83aad477:



    voice "voice/tianqin_1051.ogg"
    tianqin "자—— 힘을 줘서——!"


translate japanese plot5_f8a0e5e3:



    voice "voice/tianqin_1052.ogg"
    tianqin "얍!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot5_f86ab591:


    "라이라는 한참 애쓴 끝에 겨우 틈을 통과했다. 덕분에 틈도 꽤 넓어졌다."


translate japanese plot5_f962e894:



    voice "voice/cygnus_674.ogg"
    cygnus "으음——"


translate japanese plot5_d9ed6f9d:


    "시노스는 라이라와 달리 가볍게 울타리를 통과했다."


translate japanese plot5_ba681a29:


    "울타리 너머에도 빽빽한 관목 덤불이 있었다."


translate japanese plot5_364bd385:


    "교정 구석이라 관리하는 사람이 좀처럼 손대지 않아 식물들이 제멋대로 자라고 있었다."


translate japanese plot5_bed907f4:


    "울타리를 넘은 뒤에도 라이라는 시노스의 손을 꼭 잡은 채 앞을 가로막은 가지를 헤치며 길을 냈다."


translate japanese plot5_a472d4f4:



    voice "voice/tianqin_1053.ogg"
    tianqin "와, 봄이 지나니까 식물이 너무 빨리 자라네."


translate japanese plot5_b90ebdec:



    voice "voice/tianqin_1054.ogg"
    tianqin "시노스, 따라올 수 있겠어?"


translate japanese plot5_c56e43b6:



    voice "voice/cygnus_675.ogg"
    cygnus "괜찮아. 계속 가."


translate japanese plot5_d799ec47:


    "마침내 라이라가 얽힌 가지로 이루어진 마지막 장막을 헤치자, 두 사람은 덤불 밖으로 빠져나왔다."


translate japanese plot5_84f86867:



    voice "voice/gt.ogg"
    npc14 "푸하——!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot5_af8286c3:


    "머리카락이며 얼굴, 옷까지 나뭇잎과 잔가지투성이가 되어 꼴이 말이 아니었다."


translate japanese plot5_f6a478fc:



    voice "voice/cygnus_676.ogg"
    cygnus "후, 후…… 여긴 어디야?"


translate japanese plot5_70531133:



    voice "voice/tianqin_1055.ogg"
    tianqin "운동장. 체육 수업 하는 곳이야."


translate japanese plot5_fb634268:



    voice "voice/cygnus_677.ogg"
    cygnus "체육 수업?"


translate japanese plot5_b399975d:



    voice "voice/tianqin_1056.ogg"
    tianqin "어…… 몸을 단련하는 수업."


translate japanese plot5_94f12f24:



    voice "voice/cygnus_678.ogg"
    cygnus "아, 네가 평소 집에서 운동하는 것처럼?"


translate japanese plot5_a84d8790:



    voice "voice/tianqin_1057.ogg"
    tianqin "어—— 비, 비슷해……!"


translate japanese plot5_e52c8c1d:


    "운동장은 아주 조용했다. 아침에 학생들이 힘들다고 아우성치던 소리가 사라지자 라이라와 시노스도 자신도 모르게 목소리를 낮췄다."


translate japanese plot5_bb874776:


    "학교는 밤에 개방하지 않아 교내 조명도 모두 꺼져 있었다."


translate japanese plot5_75722c07:


    "운동장에 불빛이 있는 곳은 달리기 트랙 출발점의 가로등 하나뿐이었다. 경비원 순찰용으로 켜 둔 모양이었다."


translate japanese plot5_d2411d0d:



    voice "voice/tianqin_1058.ogg"
    tianqin "어디부터 조사할까?"


translate japanese plot5_5905dc1b:



    voice "voice/cygnus_679.ogg"
    cygnus "네가 학교에서 가장 오래 머무는 곳부터 가 보자."


translate japanese plot5_cdf1d0c2:



    voice "voice/tianqin_1059.ogg"
    tianqin "그럼 내가 수업 듣는 곳이네."


translate japanese plot5_c03561b2:


    "밤의 교사에는 복도등도 당연히 꺼져 있었다."


translate japanese plot5_1796154d:


    "복도 끝마다 전등 스위치가 있었지만, 켜면 경비원의 눈에 띌 테니 손댈 수 없었다."


translate japanese plot5_cd0be64f:


    "라이라도 지나가는 경비원에게 불빛이 보이지 않도록 스마트폰을 주머니에 넣었다."


translate japanese plot5_3930a464:


    "주변에 불빛은 거의 없었지만, 아까 운동장을 가로지르는 동안 눈이 어둠에 익숙해져 달빛에 의지해 발밑을 겨우 분간할 수 있었다."


translate japanese plot5_e43582b2:



    voice "voice/tianqin_1060.ogg"
    tianqin "어때? 여기가 내가 수업 듣는 건물이야."


translate japanese plot5_ae196e5e:



    voice "voice/tianqin_1061.ogg"
    tianqin "이 근처에 있어?"


translate japanese plot5_936c4298:



    voice "voice/cygnus_680.ogg"
    cygnus "…"


translate japanese plot5_857b22bf:



    voice "voice/cygnus_681.ogg"
    cygnus "마력이 느껴지지 않아. 좀 더 안쪽으로 데려가 줄래?"


translate japanese plot5_6aa016f0:



    voice "voice/tianqin_1062.ogg"
    tianqin "음—— 그럼 우리 교실로 가 보자."


translate japanese plot5_d18c9b0d:



    voice "voice/cygnus_682.ogg"
    cygnus "（…）"


translate japanese plot5_3f2cdd04:



    voice "voice/cygnus_683.ogg"
    cygnus "（여긴 교실이 전부 비슷하게 생겼네.）"


translate japanese plot5_0c98390d:


    "교탁, 칠판, 책상…… 교실마다 배치가 거의 같았다."


translate japanese plot5_e5faa225:


    "이 건물에는 층마다 이런 교실이 네 개씩 있었다. 꼭 복사해서 붙여 넣은 듯한 모습에 시노스는 미로에 들어온 듯한 기분이 들었다."


translate japanese plot5_7a3c8163:


    "학생들이 책상 위에 둔 책들만 달랐다. 그 덕분에 서로 다른 교실임을 알아볼 수 있었다."


translate japanese plot5_fcb547fe:



    voice "voice/tianqin_1063.ogg"
    tianqin "도착했어. 여기가 우리 교실이야."


translate japanese plot5_b435eead:


    "라이라가 3층의 두 번째 교실 앞에 멈춰 섰다."


translate japanese plot5_d32aaeeb:


    "다른 교실과 마찬가지로 특별할 것은 없었다."


translate japanese plot5_aa946ecb:



    voice "voice/cygnus_684.ogg"
    cygnus "너희는 평소에 이런 데서 공부해?"


translate japanese plot5_29f8f319:



    voice "voice/tianqin_1064.ogg"
    tianqin "응."


translate japanese plot5_936c4298_1:



    voice "voice/cygnus_685.ogg"
    cygnus "…"


translate japanese plot5_3d5fa2ef:



    voice "voice/tianqin_1065.ogg"
    tianqin "왜 그래?"


translate japanese plot5_a77ad70b:



    voice "voice/cygnus_686.ogg"
    cygnus "좀 더 특별할 줄 알았는데……"


translate japanese plot5_ef1eccce:


    "너무 평범했다."


translate japanese plot5_273ec0d2:


    "현대 사회를 접하며 수많은 충격을 받은 시노스였지만, 이곳은 그저 생기 없게만 느껴졌다."


translate japanese plot5_6618d564:



    voice "voice/cygnus_687.ogg"
    cygnus "이 세상에서 네 또래 애들이 매일 이런 곳에서 그 오랜 시간을 공부한다니 잘 상상이 안 돼."


translate japanese plot5_59029c9c:



    voice "voice/tianqin_1066.ogg"
    tianqin "학교가 원래 이렇게 재미없는 곳이야."


translate japanese plot5_91210ac5:



    voice "voice/cygnus_688.ogg"
    cygnus "네가 왜 맨날 땡땡이치는지 알 것도 같아."


translate japanese plot5_94a6b764:



    voice "voice/tianqin_1067.ogg"
    tianqin "그렇지!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_08612358:



    voice "voice/cygnus_689.ogg"
    cygnus "아무튼 먼저 마법으로 네 교실을 탐지해 볼게."


translate japanese plot5_720aaabf:



    voice "voice/cygnus_690.ogg"
    cygnus "（탐지 마법, 전개.）"


translate japanese plot5_2c7b07b8:


    "시노스가 몸속의 마력을 움직이기 시작했다."


translate japanese plot5_bd135aa2:


    "마력은 몸에서 바깥으로 흘러나와 희미한 형광빛을 내뿜으며, 그녀의 윤곽마저 그 빛깔로 물들였다."


translate japanese plot5_22c369d0:



    voice "voice/tianqin_1068.ogg"
    tianqin 0113 "와, 예쁘다."


translate japanese plot5_7939dcb6:


    "옅은 은빛이 시노스를 감싸더니 곧 교실 전체로 퍼져 나갔다. 방출된 마력은 교실 구석구석에 스며들었다."


translate japanese plot5_7d435c3a_2:



    voice "voice/cygnus_691.ogg"
    cygnus "――!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_34d4dd74:



    voice "voice/cygnus_692.ogg"
    cygnus "（반응이 있었어!?）"


translate japanese plot5_936c4298_2:



    voice "voice/cygnus_693.ogg"
    cygnus "…"


translate japanese plot5_b77c019f:



    voice "voice/cygnus_694.ogg"
    cygnus "（음… 그런데 너무 약해…）"


translate japanese plot5_528f8125:



    voice "voice/tianqin_1069.ogg"
    tianqin "어때? 찾았어?"


translate japanese plot5_424c31b5:



    voice "voice/cygnus_695.ogg"
    cygnus "응, 반응은 있어. 남아 있는 마력의 농도가 아주 낮긴 하지만."


translate japanese plot5_3dcdeb13:



    voice "voice/tianqin_1070.ogg"
    tianqin "어!? 그럼 시노스의 그 「마 뭐시기 구」가 정말 우리 반에 있는 거야?"


translate japanese plot5_a38cfb40:



    voice "voice/cygnus_696.ogg"
    cygnus "마도구야."


translate japanese plot5_860d096b:


    "시노스는 탐지 마법의 세기를 높였지만, 교실에 남은 극히 희박한 마력의 흔적만 포착할 수 있었다."


translate japanese plot5_3b16a1f8:



    voice "voice/cygnus_697.ogg"
    cygnus "음…… 남은 마력의 농도가 너무 낮아."


translate japanese plot5_03a58b53:



    voice "voice/cygnus_698.ogg"
    cygnus "마도구가 여기 있다면 바로 감지할 수 있을 텐데."


translate japanese plot5_3e972a3d:



    voice "voice/cygnus_699.ogg"
    cygnus "그런데 남아 있는 마력의 주파수가 나와 거의 같아. 내 마도구가 남긴 흔적이 틀림없어……"


translate japanese plot5_ffafaff9:



    voice "voice/tianqin_1071.ogg"
    tianqin "어…… 그러니까 네가 잃어버린 마도구가 교실에 있었던 적이 있다는 거지?"


translate japanese plot5_0e561fd1:



    voice "voice/cygnus_700.ogg"
    cygnus "응, 바로 그거야."


translate japanese plot5_613c875f:



    voice "voice/cygnus_701.ogg"
    cygnus "여기 있는 누군가가 내 마도구를 가져갔을 가능성이 커."


translate japanese plot5_4b9b3a5a:



    voice "voice/tianqin_1072.ogg"
    tianqin "와…… 정말 우리 반이었구나. 덕분에 찾을 범위가 확 줄었네."


translate japanese plot5_9db5b7a3:



    voice "voice/tianqin_1073.ogg"
    tianqin "시노스, 마도구가 정확히 어디 있었는지도 알 수 있어?"


translate japanese plot5_cbc084a3:



    voice "voice/cygnus_702.ogg"
    cygnus "어려워. 남은 마력이 교실 전체에 퍼져 있어서 정확한 위치를 알아내기는 힘들 것 같아."


translate japanese plot5_2146b3d7:



    voice "voice/cygnus_703.ogg"
    cygnus "그래도…… 한번 해 볼게."


translate japanese plot5_1f1018ec:


    "밑져야 본전이라는 생각으로 시노스는 마력의 출력을 더 높였다."


translate japanese plot5_f8a15870:


    "아주 간단한 마법이었지만 마나가 부족한 이 세상에서는 그래도 적지 않은 마력이 소모되었다."


translate japanese plot5_936c4298_3:



    voice "voice/cygnus_704.ogg"
    cygnus "…"


translate japanese plot5_84b22e83:



    voice "voice/cygnus_705.ogg"
    cygnus "——찾았어!"


translate japanese plot5_06e6b2d0:



    voice "voice/tianqin_1074.ogg"
    tianqin 0102 "오오!? 어디, 어디?"


translate japanese plot5_72547f86:


    "시노스는 교실의 어느 책상 앞으로 가서 그 책상을 가볍게 두드렸다."


translate japanese plot5_fc01d12b:



    voice "voice/cygnus_706.ogg"
    cygnus "여기야. 남은 마력의 농도가 다른 곳보다 조금 높아."


translate japanese plot5_e71fd9a0:



    voice "voice/tianqin_1075.ogg"
    tianqin "아—— 여기구나……"


translate japanese plot5_2faca237:


    "시노스가 그 책상을 가리키기 전부터 라이라는 어렴풋이 짐작하고 있었다."


translate japanese plot5_49e1e9be:


    "우연 같기도, 필연 같기도 했다."


translate japanese plot5_1c06ee97:


    "——그곳은 츠루기의 자리였다."


translate japanese plot5_8eea2014:



    voice "voice/cygnus_707.ogg"
    cygnus "왜 그래? 이 책상 주인한테 무슨 일이라도 있어?"


translate japanese plot5_d6166a75:



    voice "voice/tianqin_1076.ogg"
    tianqin "음—— 말하자면 길어."


translate japanese plot5_647423f2:


    "라이라는 반에서 있었던 일을 시노스에게 숨김없이 이야기했다."


translate japanese plot5_d8a9ca36:


    "츠루기에 관한 일, 범인에 관한 일, 담임이 라이라에게 부탁한 일…"


translate japanese plot5_5c71059b:



    voice "voice/cygnus_708.ogg"
    cygnus "그런 일이 있었구나."


translate japanese plot5_e80dd26a:



    voice "voice/cygnus_709.ogg"
    cygnus "（어쩐지 요 며칠 기분이 가라앉아 있더니, 이런 일을 생각하고 있었구나…）"


translate japanese plot5_3ba82f83:



    voice "voice/tianqin_1077.ogg"
    tianqin "그럼 츠루기가 네 물건을 가져간 걸까……"


translate japanese plot5_01b01c06:



    voice "voice/cygnus_710.ogg"
    cygnus "아니, 아직 단정할 수 없어."


translate japanese plot5_18b2ed82:



    voice "voice/cygnus_711.ogg"
    cygnus "여기에 남은 마력이 내 마도구와 관련된 건 맞아."


translate japanese plot5_6f207c38:



    voice "voice/cygnus_712.ogg"
    cygnus "네 얘기를 듣고 새로운 가능성이 떠올랐어."


translate japanese plot5_cbc06cbc:



    voice "voice/cygnus_713.ogg"
    cygnus "어쩌면…… 누군가 내 마도구를 써서 그 흰쥐들을 이 책상 안으로 옮긴 걸지도 몰라."


translate japanese plot5_3bed4659:



    voice "voice/tianqin_1078.ogg"
    tianqin "어? 남들은 네 마도구 못 쓴다며?"


translate japanese plot5_41fed036:



    voice "voice/cygnus_714.ogg"
    cygnus "보통은 불가능해. 하지만 지금 봐서는…… 내 마도구를 가져간 사람이 그걸 썼을 가능성이 커."


translate japanese plot5_07ff5ce9:



    voice "voice/cygnus_715.ogg"
    cygnus "그 사람은 네가 말한, 괴롭히는 범인일 거야."


translate japanese plot5_22399c3b:



    voice "voice/cygnus_716.ogg"
    cygnus "우연히 손에 넣은 힘을 제멋대로 악용했다… 그렇게 생각하는 편이 말이 되겠지."


translate japanese plot5_98c74f5a:



    voice "voice/tianqin_1079.ogg"
    tianqin "그렇다면… 우리 반에 츠루기한테 그런 짓을 할 배짱이 있는 사람은 없을 것 같은데."


translate japanese plot5_3a7f4830:



    voice "voice/tianqin_1080.ogg"
    tianqin "하지만 마법을 쓸 수 있다면…… 남들이 눈치 못 채게 자기 행동을 감출 수 있겠네."


translate japanese plot5_e6ef28c9:


    "시노스의 말을 들으니 사건의 윤곽이 조금 잡히는 듯했다."


translate japanese plot5_15612fa9:



    voice "voice/cygnus_717.ogg"
    cygnus "여기서 추측만 해 봐야 소용없어. 단서가 더 필요해."


translate japanese plot5_05d88cee:



    voice "voice/tianqin_1081.ogg"
    tianqin "그럼 이제 어떻게 할까?"


translate japanese plot5_a5bfa5d0:



    voice "voice/cygnus_718.ogg"
    cygnus "그렇다면…"


translate japanese plot5_928b9924:



    voice "voice/cygnus_719.ogg"
    cygnus "일단 모든 교실을 이런 식으로 조사해 보자. 뭔가 더 찾을 수도 있어."


translate japanese plot5_faa90580:



    voice "voice/tianqin_1082.ogg"
    tianqin "전부?"


translate japanese plot5_61500f12:



    voice "voice/cygnus_720.ogg"
    cygnus "응, 당연히 전부지."


translate japanese plot5_f1be06ca:



    voice "voice/tianqin_1083.ogg"
    tianqin "この校舎だけで二十の教室以上あるよ？ 隣の校舎も含めたら、だいたい四十の教室くらい…"


translate japanese plot5_0435c16d:



    voice "voice/tianqin_1084.ogg"
    tianqin "그걸 전부 조사한다고?"


translate japanese plot5_59a7580e:



    voice "voice/cygnus_721.ogg"
    cygnus "물론이지. 어떤 가능성도 놓쳐선 안 돼."


translate japanese plot5_af22cbb5:



    voice "voice/cygnus_722.ogg"
    cygnus "가능하면 선생님들 교무실까지 조사하고 싶어."


translate japanese plot5_6a84c121:



    voice "voice/tianqin_1085.ogg"
    tianqin "그거 큰일이네."


translate japanese plot5_89bb7c3d:



    voice "voice/tianqin_1086.ogg"
    tianqin "난 괜찮은데, 넌 버틸 수 있겠어?"


translate japanese plot5_5a56a832:



    voice "voice/cygnus_723.ogg"
    cygnus "탐지 마법만 쓰는 거니까 저장해 둔 마력으로 충분할 거야."


translate japanese plot5_d5b890ea:



    voice "voice/tianqin_1087.ogg"
    tianqin "시노스가 괜찮다면 가자."


translate japanese plot5_939e236b:


    "시노스와 라이라는 학교에서 단서를 더 찾을 수 있기를 바라며 교실과 교무실을 하나씩 돌아다녔다."


translate japanese plot5_64b36bc3:


    "그러는 동안 둘은 아무 말도 하지 않았다. 기묘할 만큼 긴 침묵이 이어졌다."


translate japanese plot5_da424e58:


    "조용한 데 익숙한 시노스는 괜찮았지만, 라이라는 조금 괴로웠다."


translate japanese plot5_9bc31572:



    voice "voice/tianqin_1088.ogg"
    tianqin "저기……"


translate japanese plot5_7a6d0fd7:


    "결국 침묵을 먼저 깬 것은 라이라였다."


translate japanese plot5_c85a0735:



    voice "voice/cygnus_724.ogg"
    cygnus "왜?"


translate japanese plot5_a811fa5e:



    voice "voice/tianqin_1089.ogg"
    tianqin "네가 원래 살던 세상에서는 다들 너처럼 마법을 써?"


translate japanese plot5_721e010a:



    voice "voice/cygnus_725.ogg"
    cygnus "꼭 그렇진 않아. 보통 마법을 능숙하게 쓰는 건 마법사뿐이야."


translate japanese plot5_f72dc8a4:



    voice "voice/cygnus_726.ogg"
    cygnus "하지만 대부분의 모험가는 간단한 {a=dictionary:dict_entry_62}마법{/a} 정도는 쓸 줄 알아. 마물을 자주 토벌하니까 그런 마법이 크게 도움이 될 때가 많거든."


translate japanese plot5_ca83d4b3:



    voice "voice/tianqin_1090.ogg"
    tianqin "마물은 위험한 생물이야?"


translate japanese plot5_97c1daca:



    voice "voice/cygnus_727.ogg"
    cygnus "음…… 그렇게 생각해도 돼."


translate japanese plot5_2cab042e:



    voice "voice/cygnus_728.ogg"
    cygnus "다른 존재에게 중립적이거나 우호적인 마물도 있지만, 대체로 상당히 위험해."


translate japanese plot5_f3f16333:



    voice "voice/cygnus_729.ogg"
    cygnus "마나에서 태어나니까 일종의 「왜곡」이라고 봐도 돼. 마나를 지나치게 흡수한 생물이 변해서 마물이 되는 경우도 있어."


translate japanese plot5_7b294348:



    voice "voice/cygnus_730.ogg"
    cygnus "하지만 그 밖의 마물은 대부분 어디서 생겨나는지 아직 정확히 몰라… 마나의 농도가 충분히 높으면 그곳에서 마물이 나타나."


translate japanese plot5_a999e58a:



    voice "voice/tianqin_1091.ogg"
    tianqin "음…… 이것도 「왜곡」이구나……"


translate japanese plot5_d086b557:



    voice "voice/tianqin_1092.ogg"
    tianqin "그럼 시노스의 마도구도 마물을 만들어 내거나 해?"


translate japanese plot5_926316c8:



    voice "voice/cygnus_731.ogg"
    cygnus "나도 그게 걱정이야…… 아직은 확실히 말할 수 없지만."


translate japanese plot5_f5a95573:



    voice "voice/cygnus_732.ogg"
    cygnus "그런 일이 생기기 전에 되찾을 수 있으면 좋겠어."


translate japanese plot5_c45152aa:



    voice "voice/tianqin_1093.ogg"
    tianqin "헤헤, 마물이 나오면 내가 전부 때려눕힐게."


translate japanese plot5_227ff7b8:



    voice "voice/cygnus_733.ogg"
    cygnus "마물은 평범한 사람에게는 무척 위험해. 이 세상에서도 「총기」 정도는 있어야 상대할 수 있을걸."


translate japanese plot5_1def1c34:



    voice "voice/cygnus_734.ogg"
    cygnus "정말 마주치면 얼른 도망쳐."


translate japanese plot5_e9b02450:



    voice "voice/tianqin_1094.ogg"
    tianqin "ふふん、私を甘く見ないでよ。私だって…"


translate japanese plot5_c0ff9543:



    voice "voice/tianqin_1095.ogg"
    tianqin "으음……"


translate japanese plot5_99ff2fe9:


    "말하던 라이라가 갑자기 입을 다물었다."


translate japanese plot5_c85a0735_1:



    voice "voice/cygnus_735.ogg"
    cygnus "왜?"


translate japanese plot5_26a3dc21:



    voice "voice/tianqin_1096.ogg"
    tianqin "아무것도 아냐."


translate japanese plot5_6ba26f97:


    "그 순간 라이라의 얼굴에 복잡한 표정이 떠올랐다. 그리고 더는 아무 말도 하지 않았다."


translate japanese plot5_b68df258:



    voice "voice/cygnus_736.ogg"
    cygnus "（…이상하네.）"


translate japanese plot5_978f8377:


    "라이라가 무슨 생각을 했는지 알 수 없었던 시노스는 속으로 중얼거리고는 다시 입을 다물었다."


translate japanese plot5_44243871:


    "그 뒤로 꼬박 이십 분 동안 라이라는 아무 말도 하지 않았다."


translate japanese plot5_c0a60984:


    "그저 조용히 시노스를 따라다니며 다음 교실로 안내할 뿐이었다."


translate japanese plot5_720aaabf_1:



    voice "voice/cygnus_737.ogg"
    cygnus "（탐지 마법, 전개.）"


translate japanese plot5_936c4298_4:



    voice "voice/cygnus_738.ogg"
    cygnus "…"


translate japanese plot5_25c60c0b:



    voice "voice/cygnus_739.ogg"
    cygnus "여기도 없어. 다음으로 가자."


translate japanese plot5_1c765695:


    "처음의 침묵과는 달리 분위기가 무척 어색해졌다."


translate japanese plot5_409d56a6:


    "시노스에게는 이 정도로 조용한 게 편했지만, 라이라가 갑자기 말이 없어지니 아무래도 분위기가 이상했다."


translate japanese plot5_936c4298_5:



    voice "voice/cygnus_740.ogg"
    cygnus "…"


translate japanese plot5_6f192bcd:



    voice "voice/cygnus_741.ogg"
    cygnus "저기……"


translate japanese plot5_53ab553d:


    "이번에는 시노스가 침묵을 깰 차례였다."


translate japanese plot5_f0e2e7e7:



    voice "voice/tianqin_1097.ogg"
    tianqin "응?"


translate japanese plot5_f44c3d04:



    voice "voice/cygnus_742.ogg"
    cygnus "그 다과점에서 만나자고 한 건 왜였어?"


translate japanese plot5_b1275dbb:



    voice "voice/cygnus_743.ogg"
    cygnus "거기 점장이랑 친해?"


translate japanese plot5_70674a5a:



    voice "voice/tianqin_1098.ogg"
    tianqin "아, 그게……"


translate japanese plot5_1fb2814a:



    voice "voice/tianqin_1099.ogg"
    tianqin "사실 그 가게, 우리 집 가게라고 할 수 있거든."


translate japanese plot5_c4c3679a:



    voice "voice/cygnus_744.ogg"
    cygnus "어?"


translate japanese plot5_6b65bfbc:


    "시노스는 조금 놀랐다."


translate japanese plot5_d0bde2f8:


    "그저 아무 말이라도 해서 라이라가 입을 열게 할 생각이었기 때문이다."


translate japanese plot5_8315636e:



    voice "voice/cygnus_745.ogg"
    cygnus "잠깐, 그러면…… 아까 그 점장이 네 어머니야?"


translate japanese plot5_0329fc21:



    voice "voice/tianqin_1100.ogg"
    tianqin "아, 아니야. 그분은 임시로 맡아 주시는 점장님이야."


translate japanese plot5_edc76c90:



    voice "voice/tianqin_1101.ogg"
    tianqin "진짜 사장님은 요즘 여행 중이시라 그분한테 가게를 잠깐 맡기셨거든."


translate japanese plot5_9aba9559:



    voice "voice/cygnus_746.ogg"
    cygnus "그러니까…… 네 어머니가 거기 사장님이라는 거야?"


translate japanese plot5_0b2beb2c:



    voice "voice/tianqin_1102.ogg"
    tianqin 0102 "응, 날 키워 주신 분이야."


translate japanese plot5_936c4298_6:



    voice "voice/cygnus_747.ogg"
    cygnus "…"


translate japanese plot5_0955f97d:


    "시노스는 자신의 대화가 어째서인지 자꾸 곤란한 방향으로 흐른다는 사실을 다시금 깨달았다."


translate japanese plot5_7df66b6e:


    "분위기를 띄우려 했을 뿐인데, 하필이면 더 어색해질 만한 화제를 골라 버렸다."


translate japanese plot5_60ab248b:



    voice "voice/tianqin_1103.ogg"
    tianqin "어? 얘기 안 했었나?"


translate japanese plot5_d722fe45:



    voice "voice/cygnus_748.ogg"
    cygnus "……안 했어."


translate japanese plot5_80cdaeb8:


    "시노스는 고개를 저었다. 라이라가 자신을 집으로 데려온 날부터, 그 집에서 다른 사람을 본 적은 없었다."


translate japanese plot5_4250fe46:


    "그래서 무심코 라이라가 혼자 산다고 단정하고 있었다. 왜 혼자 사는지까지는 생각해 본 적이 없었다."


translate japanese plot5_113afd61:


    "이 세상에 온 뒤로 자기 일에만 매달려 라이라에 대해서는 제대로 알지 못했다는 사실이 조금 부끄러웠다."


translate japanese plot5_6c591dd7:



    voice "voice/tianqin_1104.ogg"
    tianqin "아…… 정말 그런 얘기는 안 했던 것 같네. 마침 잘됐으니까 얘기해 줄게."


translate japanese plot5_64c6314d:



    voice "voice/tianqin_1105.ogg"
    tianqin "사실 나한테는 언니도 있어."


translate japanese plot5_4f1b9b22:



    voice "voice/cygnus_749.ogg"
    cygnus "어? 정말?"


translate japanese plot5_a077bfd3:



    voice "voice/tianqin_1106.ogg"
    tianqin "정말이야. 요즘 수련하러 가 있어서 집에 안 들어오는 것뿐이야."


translate japanese plot5_27e64608:



    voice "voice/cygnus_750.ogg"
    cygnus "（수련?）"


translate japanese plot5_19c53f69:


    "라이라의 입에서 또 생소한 말이 튀어나오자 시노스는 잠깐 멍해졌다."


translate japanese plot5_bb7d8d73:


    "하지만 라이라가 말을 이으려는 것 같아 일단 궁금증은 접어 두기로 했다."


translate japanese plot5_68d5e84d:



    voice "voice/tianqin_1107.ogg"
    tianqin "えーと、どこから話せばいいかな…"


translate japanese plot5_7cb3a89c:



    voice "voice/tianqin_1108.ogg"
    tianqin "우리 집은 사정이 좀 복잡해. 난 부모님을 본 적이 없고, 철들 무렵부터 늘 언니랑 함께였어……"


translate japanese plot5_5e81f546:



    voice "voice/cygnus_751.ogg"
    cygnus "아, 미안……"


translate japanese plot5_d347f904:



    voice "voice/cygnus_752.ogg"
    cygnus "말하기 싫으면 다른 얘기 하자."


translate japanese plot5_c9765273:



    voice "voice/tianqin_1109.ogg"
    tianqin "괜찮아. 다 지난 일이야. 이젠 신경 안 써."


translate japanese plot5_bf67cd77:



    voice "voice/tianqin_1110.ogg"
    tianqin 0101 "난 어릴 때부터 언니랑 둘이 의지하며 살았어."


translate japanese plot5_987899de:



    voice "voice/tianqin_1111.ogg"
    tianqin "사장님이 의지할 곳 없는 우리를 보고 거둬 주셨거든."


translate japanese plot5_0a0a0069:



    voice "voice/tianqin_1112.ogg"
    tianqin 0102 "지금 우리가 사는 집도 사실 사장님이 살게 해 주신 거야."


translate japanese plot5_e187e467:



    voice "voice/tianqin_1113.ogg"
    tianqin "나랑 언니가 어릴 때는 계속 우리를 돌봐 주셨어."


translate japanese plot5_e85f49cf:



    voice "voice/tianqin_1114.ogg"
    tianqin "우리가 다 자란 뒤에야 안심하고 따로 살게 해 주셨지."


translate japanese plot5_a8dd268a:



    voice "voice/cygnus_753.ogg"
    cygnus "그러니까 네 은인이구나……"


translate japanese plot5_c98e42d6:


    "시노스는 한 번도 만난 적 없는 사장님을 조금 알 것 같았다. 라이라에게는 어머니나 다름없는 존재인 모양이었다."


translate japanese plot5_a24d893d:



    voice "voice/tianqin_1115.ogg"
    tianqin "응, 우리한테는 정말 큰 은인이셔."


translate japanese plot5_94d929cd:



    voice "voice/tianqin_1116.ogg"
    tianqin "우리를 늘 친자식처럼 대해 주셨어. 따로 살기로 했을 땐 한참 우시기도 했고."


translate japanese plot5_6f51c261:



    voice "voice/cygnus_754.ogg"
    cygnus "실례가 될지도 모르지만 물어봐도 돼?"


translate japanese plot5_f0e2e7e7_1:



    voice "voice/tianqin_1117.ogg"
    tianqin "응?"


translate japanese plot5_16f796dc:



    voice "voice/cygnus_755.ogg"
    cygnus "네 부모님은…… 무슨 일이 있었던 거야?"


translate japanese plot5_7b5df4a6:



    voice "voice/tianqin_1118.ogg"
    tianqin "아—— 그 얘기……"


translate japanese plot5_21b958bf:


    "라이라는 조금 망설였다. 이제 신경 쓰지 않는다고 말은 했어도, 가족 이야기는 역시 그녀의 약한 부분을 건드렸다."


translate japanese plot5_6b85b868:



    voice "voice/cygnus_756.ogg"
    cygnus "미안, 너무 실례되는 질문이었나……"


translate japanese plot5_1203cad8:



    voice "voice/tianqin_1119.ogg"
    tianqin "아냐. 나도 가끔은 누군가한테 털어놓고 싶어."


translate japanese plot5_100a9ade:



    voice "voice/tianqin_1120.ogg"
    tianqin 0105 "私の父は…私が生まれて間もなく、事故で亡くなったらしいんだ。"


translate japanese plot5_d3c0dc26:



    voice "voice/tianqin_1121.ogg"
    tianqin "난 전혀 기억이 없고, 그때 언니도 아직 철들기 전이었어."


translate japanese plot5_b446ef2d:



    voice "voice/tianqin_1122.ogg"
    tianqin "사장님 말로는 아빠가 큰돈을 남겨 주셨대. 우리 둘을 다 키울 만큼."


translate japanese plot5_13db73bb:



    voice "voice/tianqin_1123.ogg"
    tianqin 0103 "그런데 엄마가 그 일로 충격을 크게 받아서 정신적으로 많이 불안하셨나 봐."


translate japanese plot5_4f0ac645:



    voice "voice/tianqin_1124.ogg"
    tianqin "그 뒤에 아마 정신적인 발작을 일으켰는지 행방불명이 되셨어. 나랑 언니만 남았지."


translate japanese plot5_df9039da:



    voice "voice/tianqin_1125.ogg"
    tianqin "女将さんはその時にこの話を聞いて、私たち姉妹の面倒を見始めてくれたの。"


translate japanese plot5_22d2e1fc_1:



    voice "voice/cygnus_757.ogg"
    cygnus "어……"


translate japanese plot5_d01d1dc1:


    "라이라의 집안 사정은 더는 복잡하다는 말만으로 표현할 수 없었다."


translate japanese plot5_cc8a5594:


    "너무나도 무거웠다."


translate japanese plot5_f997ca23:



    voice "voice/cygnus_758.ogg"
    cygnus "괜히 미안하네……"


translate japanese plot5_19968eb1:



    voice "voice/tianqin_1126.ogg"
    tianqin "괜찮아. 이젠 신경 안 쓴다니까. 얘기하니까 나도 좀 후련해."


translate japanese plot5_4ea6974b:



    voice "voice/tianqin_1127.ogg"
    tianqin "이런 얘기는…… 아무한테나 털어놓을 수도 없거든."


translate japanese plot5_8059dad4:


    "무거운 이야기였지만, 라이라는 털어놓고 나자 확실히 평소의 모습을 되찾았다."


translate japanese plot5_e268c51f:



    voice "voice/tianqin_1128.ogg"
    tianqin "자—— 계속 찾아보자."


translate japanese plot5_84b105ae_1:



    voice "voice/cygnus_759.ogg"
    cygnus "응."


translate japanese plot5_e219da38:


    "두 사람은 각 층의 긴 복도를 따라 교실을 꼼꼼히 조사하며 마력 반응이 더 있는지 찾았다."


translate japanese plot5_6d4bcd11:


    "하지만 얼마 지나지 않아 새로운 문제가 생겼다."


translate japanese plot5_0f9cfb71:



    voice "voice/cygnus_760.ogg"
    cygnus "후…… 후…… 하아……"


translate japanese plot5_68a87284:



    voice "voice/tianqin_1129.ogg"
    tianqin "저기…… 잠깐 쉴까?"


translate japanese plot5_7fbae548:



    voice "voice/cygnus_761.ogg"
    cygnus "하아… 괜찮아… 계속하자…"


translate japanese plot5_7ec8c734:


    "라이라의 걱정은 옳았다. 탐지 마법을 연달아 강하게 사용한 시노스는 숨이 턱까지 차서 계단을 오르는 것조차 힘겨워했다."


translate japanese plot5_46c4549d:


    "마력으로 이루어진 몸은 음식을 먹지 않아도 되지만, 반대로 마력이 줄면 즉시 몸에 무력감이 찾아왔다."


translate japanese plot5_e316ce96:



    voice "voice/cygnus_762.ogg"
    cygnus "（마력이 이렇게 심하게 소모될 줄은…）"


translate japanese plot5_2fc30f14:



    voice "voice/tianqin_1130.ogg"
    tianqin "아직 교실이 한참 남았어. 일단 좀 쉬는 게 어때?"


translate japanese plot5_b47481a6:



    voice "voice/cygnus_763.ogg"
    cygnus "아냐, 계속 가자…… 금방 괜찮아질 거야……"


translate japanese plot5_58db8181:


    "라이라의 안내로 두 사람은 교사 두 동의 교실과 교무실 대부분을 조사했다."


translate japanese plot5_29c42476:


    "하지만 라이라의 교실을 제외하면 어디에서도 마력의 흔적은 발견되지 않았다."


translate japanese plot5_a1412a8e:



    voice "voice/tianqin_1131.ogg"
    tianqin "시노스, 괜찮아?"


translate japanese plot5_9ae389c8:



    voice "voice/cygnus_764.ogg"
    cygnus "앞으로…… 몇 군데나 남았어……?"


translate japanese plot5_c98c00ff:



    voice "voice/tianqin_1132.ogg"
    tianqin "교무실까지 합치면…… 아홉 군데쯤 남은 것 같아."


translate japanese plot5_ef7fa26a:



    voice "voice/cygnus_765.ogg"
    cygnus "계속하자……"


translate japanese plot5_79e6d2c1:



    voice "voice/tianqin_1133.ogg"
    tianqin "무리하지 마! 조금 쉬어도 괜찮잖아."


translate japanese plot5_059c904c:



    voice "voice/tianqin_1134.ogg"
    tianqin "오늘 밤에 다 못 해도 내일 밤에 또 오면 되지."


translate japanese plot5_de660a88:



    voice "voice/cygnus_766.ogg"
    cygnus "아니, 되도록 빨리 끝내고 싶어…"


translate japanese plot5_33cbdfa4:



    voice "voice/cygnus_767.ogg"
    cygnus "내일 마력의 흔적이 사라지면 단서가 더 줄어들어……"


translate japanese plot5_6d070fd2:



    voice "voice/cygnus_768.ogg"
    cygnus "게다가 정말 내 마도구를 쓸 수 있는 사람이 있을지도 모르잖아."


translate japanese plot5_79507944:


    "시노스는 이를 악물고 버티려 했다. 하룻밤조차 허비하고 싶지 않았다."


translate japanese plot5_40705926:


    "자신의 힘, 잃어버린 기억, 이 세상의 비밀…… 답을 찾아야 할 문제가 너무 많았다. 더 지체하고 싶지 않았다."


translate japanese plot5_ce3729eb:


    "어떤 단서든 시노스는 온 힘을 다해 붙잡을 생각이었다."


translate japanese plot5_c0ff9543_1:



    voice "voice/tianqin_1135.ogg"
    tianqin "으음……"


translate japanese plot5_bea92e4e:


    "라이라는 시노스가 조금 생각에 사로잡혀 있다는 걸 알았다. 하지만 동시에 지금 그녀의 처지와 마음도 이해했다."


translate japanese plot5_dc01edbf:


    "지금 자신이 할 수 있는 일은 그녀와 함께하는 것뿐이었다."


translate japanese plot5_988f021b:



    voice "voice/cygnus_769.ogg"
    cygnus "가자. 남은 교실을 전부 조사하자."


translate japanese plot5_33462765:



    voice "voice/tianqin_1136.ogg"
    tianqin "여기가 마지막 교실이야."


translate japanese plot5_17a141df:


    "시노스는 의지로 버티며 다시 탐지 마법을 작동시켰다."


translate japanese plot5_77a2d486:



    voice "voice/cygnus_770.ogg"
    cygnus "（탐지 마법, 전개.）"


translate japanese plot5_90338b77:


    "익숙한 빛이 시노스를 감쌌지만, 처음보다 훨씬 희미했다."


translate japanese plot5_71e08e60:



    voice "voice/tianqin_1137.ogg"
    tianqin "…"


translate japanese plot5_ae16dd8f:


    "라이라는 시노스가 당장이라도 쓰러질까 봐 긴장한 채 옆에서 지켜보았다."


translate japanese plot5_16cfb2e0:


    "한참 뒤 시노스를 감싼 빛이 서서히 사라졌다. 라이라는 이곳의 조사도 끝났음을 알았다."


translate japanese plot5_152aeafa:



    voice "voice/tianqin_1138.ogg"
    tianqin "어때?"


translate japanese plot5_b5570128:



    voice "voice/cygnus_771.ogg"
    cygnus "……역시 없어."


translate japanese plot5_6faf7afe:


    "시노스가 고개를 저었다. 마지막 교실에도 예상대로 마력 반응은 없었다."


translate japanese plot5_3e2427b0:


    "오늘 밤만 벌써 몇 번이나 반복한 광경인지 몰랐다. 그래도 시노스는 끝까지 모든 교실을 조사했다."


translate japanese plot5_0fa40753:



    voice "voice/tianqin_1139.ogg"
    tianqin "그렇구나… 고생했어, 시노스."


translate japanese plot5_df5c1c56:



    voice "voice/cygnus_772.ogg"
    cygnus "좀 힘들긴 하네……"


translate japanese plot5_ada5bbd9:



    voice "voice/cygnus_773.ogg"
    cygnus "후…… 결국 네 교실에만 마력 반응이 있었어."


translate japanese plot5_fe2cd46f:



    voice "voice/tianqin_1140.ogg"
    tianqin "시노스 짱이 예상한 대로이긴 한 거지?"


translate japanese plot5_f1394eba:



    voice "voice/cygnus_774.ogg"
    cygnus "予想通りではあるが…今は予想外の収穫が欲しいところだ。"


translate japanese plot5_18c45f16:



    voice "voice/cygnus_775.ogg"
    cygnus "그리고 그렇게 부르지 마."


translate japanese plot5_7ce21ba5:



    voice "voice/tianqin_1141.ogg"
    tianqin "뜻밖의 수확이라……"


translate japanese plot5_c0ff9543_2:



    voice "voice/tianqin_1142.ogg"
    tianqin "으음……"


translate japanese plot5_79e6ac34:



    voice "voice/tianqin_1143.ogg"
    tianqin "아——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_7f898aee:


    "문득 라이라의 머릿속에 생각이 떠올랐다."


translate japanese plot5_1d3836fb:



    voice "voice/tianqin_1144.ogg"
    tianqin "맞다, 데려가 보고 싶은 곳이 있어."


translate japanese plot5_7fc63063:



    voice "voice/cygnus_776.ogg"
    cygnus "응?"


translate japanese plot5_21dbbb1f_1:



    voice "voice/tianqin_1145.ogg"
    tianqin "여기야."


translate japanese plot5_0cf922d8:



    voice "voice/cygnus_777.ogg"
    cygnus "여기는……"


translate japanese plot5_b917893a:



    voice "voice/tianqin_1146.ogg"
    tianqin "전에 내가 원예부 얘기한 거 기억해?"


translate japanese plot5_5ce88870:



    voice "voice/cygnus_778.ogg"
    cygnus "아, 너한테 꽃을 줬다는……"


translate japanese plot5_25690191:



    voice "voice/tianqin_1147.ogg"
    tianqin "맞아! 여기가 원예부 활동하는 곳이야. 그 꽃도 여기서 키운 거고."


translate japanese plot5_74af49a8:



    voice "voice/cygnus_779.ogg"
    cygnus "그렇구나…… 그런데 왜 데려온 거야?"


translate japanese plot5_bb073ce8:



    voice "voice/tianqin_1148.ogg"
    tianqin "음…… 사실 요즘 여기 흰쥐가 많이 나타나거든."


translate japanese plot5_c348afd2:



    voice "voice/cygnus_780.ogg"
    cygnus "흰쥐? 네가 말한 그 책상 속에 있었다는……?"


translate japanese plot5_3214ba56:



    voice "voice/tianqin_1149.ogg"
    tianqin "응, 그 흰쥐."


translate japanese plot5_2417f39d:



    voice "voice/tianqin_1150.ogg"
    tianqin "좀 이상하잖아. 야생 흰쥐는 드문데 요즘 왜 이렇게 많이 나오는지 모르겠어."


translate japanese plot5_c6c8ff3f:



    voice "voice/tianqin_1151.ogg"
    tianqin "이 쥐들이 츠루기 일과 관련 있는지는 나도 몰라. 그냥 그런 예감이 들어서……"


translate japanese plot5_bd7a73b9:



    voice "voice/cygnus_781.ogg"
    cygnus "여기 있는 흰쥐가 내 마도구랑 관련 있다고 생각하는 거야?"


translate japanese plot5_17ef5a92:



    voice "voice/tianqin_1152.ogg"
    tianqin "응, 무슨 관계가 있을지도 몰라."


translate japanese plot5_f237720b:



    voice "voice/cygnus_782.ogg"
    cygnus "음, 알겠어. 다시 마법으로 탐색해 볼게."


translate japanese plot5_63e163c5:



    voice "voice/tianqin_1153.ogg"
    tianqin "부탁해."


translate japanese plot5_0f3c75d4:



    voice "voice/cygnus_783.ogg"
    cygnus "（탐지 마법, 전개.）"


translate japanese plot5_399f749d:


    "희미한 마법의 빛이 시노스 주위로 퍼지며, 근처의 마력과 관련된 모든 흔적을 탐지했다."


translate japanese plot5_936c4298_7:



    voice "voice/cygnus_784.ogg"
    cygnus "…"


translate japanese plot5_7d435c3a_3:



    voice "voice/cygnus_785.ogg"
    cygnus "――!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_152aeafa_1:



    voice "voice/tianqin_1154.ogg"
    tianqin "어때?"


translate japanese plot5_a3a702ff:



    voice "voice/cygnus_786.ogg"
    cygnus "마력 반응이 있어…… 게다가——"


translate japanese plot5_20682a96:



    voice "voice/tianqin_1155.ogg"
    tianqin "어!? 시노스, 어디 가?"


translate japanese plot5_b4796764:



    voice "voice/cygnus_787.ogg"
    cygnus 0104 "따라와, 라이라!"


translate japanese plot5_67ab2247:



    voice "voice/cygnus_788.ogg"
    cygnus "여기야!"


translate japanese plot5_cd7c6a43:



    voice "voice/tianqin_1156.ogg"
    tianqin "뭐가?"


translate japanese plot5_28c083a2:


    "시노스는 라이라를 더 외진 구석으로 데려갔다. 그곳에서는 더 강한 마력의 흐름이 느껴졌다."


translate japanese plot5_4a570454:



    voice "voice/cygnus_789.ogg"
    cygnus "내 마도구가…… 여기에 있었어."


translate japanese plot5_cf507a60:



    voice "voice/tianqin_1157.ogg"
    tianqin "어!? 정말?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_14c8f744:



    voice "voice/cygnus_790.ogg"
    cygnus "間違いない。ここにはかなり強い魔力反応がある。魔力の周波数も私と一致している。"


translate japanese plot5_d8a82b86:


    npc46 "찍찍——"


translate japanese plot5_71232d45:


    "멀지 않은 덤불에서 바스락거리는 소리가 났다. 하얀 그림자 몇 개가 어둠 속을 스치더니 안전한 구석에 숨어 두 사람을 지켜보았다."


translate japanese plot5_0968116e:



    voice "voice/tianqin_1158.ogg"
    tianqin "으악! 흰쥐가 아직 남아 있어!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_e45b03ce_3:



    voice "voice/cygnus_791.ogg"
    cygnus "으음……"


translate japanese plot5_ad3cfc35:


    "시노스는 즉시 탐지 마법을 펼쳐 조금 떨어진 흰쥐들을 향해 쏘아 보냈다."


translate japanese plot5_69e7464b:



    voice "voice/cygnus_792.ogg"
    cygnus "역시… 이 흰쥐들도 내 마력을 내뿜고 있어."


translate japanese plot5_35665093:



    voice "voice/tianqin_1159.ogg"
    tianqin "어!? 정말 네 마도구랑 관련된 거야?"


translate japanese plot5_9b843135:



    voice "voice/cygnus_793.ogg"
    cygnus "단순히 관련이 있는 정도가 아닐지도 몰라. 내 마도구로 만들어 낸 것일 수도 있어……"


translate japanese plot5_82bd6ebc:



    voice "voice/cygnus_794.ogg"
    cygnus "봐. 바닥에 마법진 흔적도 있잖아."


translate japanese plot5_a6d17493:


    "시노스가 바닥에 소량의 마력을 불어넣자 잠들어 있던 세 겹의 문양이 동시에 빛나며, 마법진에 희미한 빛이 감돌았다."


translate japanese plot5_c0163301:



    voice "voice/tianqin_1160.ogg"
    tianqin "와! 정말이네!"


translate japanese plot5_0488457a:



    voice "voice/cygnus_795.ogg"
    cygnus "좌표가 이렇게 크게 어긋났다니… 역시 내 표류 마법은 실패했던 모양이야…"


translate japanese plot5_d8286a88:



    voice "voice/tianqin_1161.ogg"
    tianqin "잠깐, 그럼…… 우리 반에서 일어난 일도 너랑 관련이 있는 거네?"


translate japanese plot5_106c1720:



    voice "voice/cygnus_796.ogg"
    cygnus "그럴 가능성이 크다고 생각해. 그러면 네 교실에 남은 마력도 설명이 되니까."


translate japanese plot5_5d89b640:



    voice "voice/cygnus_797.ogg"
    cygnus "내 생각에는 네 반 학생 중 누군가가 여기서 내 마도구를 주워 우연히 작동시킨 것 같아."


translate japanese plot5_2c8b17d0:



    voice "voice/cygnus_798.ogg"
    cygnus "그리고 그 힘으로 흰쥐를 잔뜩 만들어서 그 책상에 넣은 거지. 그래서 책상에서도 마력의 흔적이 감지된 거야."


translate japanese plot5_0dcdc30f:



    voice "voice/tianqin_1162.ogg"
    tianqin "음…… 그렇구나……"


translate japanese plot5_f414083d:


    "사건의 윤곽이 조금씩 드러나며 처음의 추측도 점차 확인되었다. 누군가 시노스의 마도구로 나쁜 짓을 하고 있었다."


translate japanese plot5_38679469:



    voice "voice/tianqin_1163.ogg"
    tianqin "그런데 왜 흰쥐였을까? 마법까지 쓰면서."


translate japanese plot5_94e28364:



    voice "voice/cygnus_799.ogg"
    cygnus "내 추측으로는 그 사람이 내 마도구로 할 수 있는 게 흰쥐를 만들어 내는 정도뿐이었던 것 같아."


translate japanese plot5_c9048f88:



    voice "voice/cygnus_800.ogg"
    cygnus "엄밀히 말해 마법이 뭔지도 모르는 사람은 내 마도구를 쓸 수 없어…… 우연히 내 마도구로 이런 왜곡을 일으킨 거지."


translate japanese plot5_6fb2570f:



    voice "voice/cygnus_801.ogg"
    cygnus "솔직히 내 마도구를 이런 데 쓰는 사람이 있을 줄은 몰랐어……"


translate japanese plot5_99a6439f:



    voice "voice/tianqin_1164.ogg"
    tianqin "그럼…… 츠루기 책상에 흰쥐를 넣은 사람만 찾으면 네 마도구도 찾을 수 있겠네?"


translate japanese plot5_4586f3b1:



    voice "voice/cygnus_802.ogg"
    cygnus "응, 그게 방금 우리가 내린 추론과 더 잘 맞아……"


translate japanese plot5_cffcce73:



    voice "voice/cygnus_803.ogg"
    cygnus "――!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot5_eb816679:


    "시노스의 말이 채 끝나기 전에 두 사람의 발밑이 격렬하게 흔들렸다."


translate japanese plot5_3d7f846b:



    voice "voice/tianqin_1165.ogg"
    tianqin "조심해!"


translate japanese plot5_22c51d0c:


    "시노스는 휘청거리며 넘어질 뻔했지만, 다행히 라이라가 제때 붙잡았다."


translate japanese plot5_ab34db2d:



    voice "voice/tianqin_1166.ogg"
    tianqin "괜찮아?"


translate japanese plot5_43102435:



    voice "voice/cygnus_804.ogg"
    cygnus "……난 괜찮아."


translate japanese plot5_bdf7851a:



    voice "voice/tianqin_1167.ogg"
    tianqin "무슨 일이야? 지진인가?"


translate japanese plot5_b0c04138:


    "시노스는 바닥의 마법진을 돌아보았다. 방금 불어넣은 마력이 사라지지 않고 남아 있었다."


translate japanese plot5_b101402b:


    "오히려 마법진의 빛은 점점 밝아졌다."


translate japanese plot5_1e90df4d:



    voice "voice/cygnus_805.ogg"
    cygnus 0104 "（큰일이야, 함정――）"


translate japanese plot5_e0bb39c7:



    voice "voice/tianqin_1168.ogg"
    tianqin 0109 "으아아——!"


translate japanese plot5_9e4551bd:


    "시노스가 미처 경고하기도 전에 마법진에서 눈부신 빛이 터져 나왔다."


translate japanese plot5_bf7fea7b:


    "그리고 두 사람은 그 하얀 빛 속으로 사라졌다."


translate japanese plotbattle_8de9cfd7:


    voice "voice/blackcat_34.ogg"
    nvlNone "「……일어……」" with Shake((0, 0, 0, 0), 0.28, dist=2)


translate japanese plotbattle_210516aa:


    voice "voice/blackcat_33.ogg"
    nvlNone "「……일어…… 일어나……」" with Shake((0, 0, 0, 0), 0.38, dist=4)


translate japanese plotbattle_1b28720d:


    voice "voice/blackcat_31.ogg"
    nvlNone "「빨리 일어나! 바보야!」" (**end_page()) with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plotbattle_d41d8cd9:


    nvl clear


translate japanese plotbattle_eaf065a8:



    voice "voice/cygnus_00806.ogg"
    nvlNone "「으——」"


translate japanese plotbattle_34d1b4d2:


    nvlNone "머리는 깨질 듯 아팠고,\n눈꺼풀도 무거워 도무지 눈을 뜰 엄두가 나지 않았다."


translate japanese plotbattle_5bfbc53a:


    nvlNone "복슬복슬한 무언가가 몇 번이고 내 얼굴을 두드리고 있었다. 한참 뒤에야 나는 천천히 눈을 떴다."


translate japanese plotbattle_20660252:


    nvlNone "나는 내 몸 위에 앉아 있는 시커멓고 복슬복슬한 것을 바라보았다."


translate japanese plotbattle_cae44bdf:



    voice "voice/blackcat_32.ogg"
    blackcat "일어나, 일어나. 빨리 일어나——"


translate japanese plotbattle_46dc40a6:



    voice "voice/cygnus_806.ogg"
    cygnus "여기는…… 어디야……"


translate japanese plotbattle_0902129a:



    voice "voice/blackcat_02.ogg"
    blackcat "그건 내가 묻고 싶다냥!"


translate japanese plotbattle_da79e71b:



    voice "voice/blackcat_06.ogg"
    blackcat "이 몸이 눈 좀 붙였다 일어나니 어디로 데려온 거냐."


translate japanese plotbattle_7833449a:



    voice "voice/cygnus_807.ogg"
    cygnus "내 옷이 왜——"


translate japanese plotbattle_f2174e7f:



    voice "voice/blackcat_19.ogg"
    blackcat "후훗, 그야 당연히 이 몸이 갈아입혀 줬지."


translate japanese plotbattle_4f0aae47:



    voice "voice/blackcat_04.ogg"
    blackcat "어서 이 몸에게 감사하거라."


translate japanese plotbattle_d41d8cd9_1:


    voice "voice/cygnus_808.ogg"


translate japanese plotbattle_ac4a2605:


    cygnus "……쓸데없는 짓을."


translate japanese plotbattle_6e5c6cbb:


    nvlNone "나는 몸을 일으켜 지금 상황을 파악하려 했다."


translate japanese plotbattle_5e275ebc:


    nvlNone "멍한 머리를 흔든 뒤,\n주변을 살피며 기억의 마지막 조각을 떠올렸다."


translate japanese plotbattle_f60842bd:


    nvlNone "그때 내가 생각했던 것은……" (**end_page())


translate japanese plotbattle_72b22b7f:



    voice "voice/cygnus_809.ogg"
    cygnus "함정……"


translate japanese plotbattle_5401cb56:



    voice "voice/blackcat_09.ogg"
    blackcat "뭐!?"


translate japanese plotbattle_93d51d0b:


    nvlNone "그래, 이 공간은……"


translate japanese plotbattle_e6cd0bd6:


    nvlNone "함정이다."


translate japanese plotbattle_2a470451:


    nvlNone "그 마법진의 정체는,\n마력을 감지하는 함정이었다."


translate japanese plotbattle_a69fbc9c:


    nvlNone "그런데도 나는 거기에 새겨진 명문을 제대로 읽지 않고, 경솔하게 마력을 흘려 넣어 버렸다."


translate japanese plotbattle_1eaf9304:


    nvlNone "마치 {a=dictionary:dict_entry_44}{font=SourceHanSerifSC-Regular.otf}제 발로 새 잡는 덫{/font}{/a}에 뛰어든 꼴이었다."


translate japanese plotbattle_ce491503:


    nvlNone "하지만 이제는 그래서는 안 된다."


translate japanese plotbattle_b81762b2:


    nvlNone "마력이 부족한 지금의 나는 너무나 약하다."


translate japanese plotbattle_2e4fc243:


    nvlNone "나와 노리는 조심스럽게 주변을 살폈다."


translate japanese plotbattle_c041fc5e:


    nvlNone "주위에는 얼음 기둥과 얼음 결정밖에 없었다.\n아무래도 얼음에 갇힌 유적인 것 같았다."


translate japanese plotbattle_f38a3062:


    nvlNone "모든 것이 영원히 얼어붙은 듯했고, 두꺼운 얼음층 너머로 겨우 안을 들여다볼 수 있을 뿐이었다."


translate japanese plotbattle_bfc80ab6:


    nvlNone "머릿속에 어렴풋한 짐작이 떠올랐다."


translate japanese plotbattle_72a00a06:


    nvlNone "나는 탐지 마법으로 주변을 한 차례 살폈고, 돌아온 정보는 그 추측을 더욱 뒷받침했다."


translate japanese plotbattle_91929eb4:


    nvlNone "이 유적은 실물이 아니라 마력으로 만들어진 결계였다."


translate japanese plotbattle_29b8434e:


    nvlNone "즉, 우리는 아직 그 마법진 안에 있었다."


translate japanese plotbattle_11ccba9e:



    voice "voice/blackcat_03.ogg"
    blackcat "눈치챘지?"


translate japanese plotbattle_c56108cd:



    voice "voice/cygnus_810.ogg"
    cygnus "……내가 만든 공간이야. 그 마법진은 내가 남긴 거였어."


translate japanese plotbattle_be06e7a8:



    voice "voice/blackcat_14.ogg"
    blackcat "그래. 여긴 네가 마도구를 보관하려고 만든 곳 같구나."


translate japanese plotbattle_9da13c6b:


    "나는 다시 마법으로 유적을 탐지했지만, 유적을 이루는 마력 외에는 눈에 띄는 것이 없었다."


translate japanese plotbattle_944cd6a7:



    voice "voice/cygnus_811.ogg"
    cygnus "……물건은 여기 없어."


translate japanese plotbattle_cdf5cfc4:



    voice "voice/blackcat_16.ogg"
    blackcat "역시 누가 가져갔구나. 냐하하——"


translate japanese plotbattle_53299c48:



    voice "voice/blackcat_30.ogg"
    blackcat "아야——!"


translate japanese plotbattle_7fb17d64:


    "나는 노리의 머리를 한 대 쥐어박으며 짜증을 풀었다."


translate japanese plotbattle_608b30cc:


    nvlNone "그러니까 나는 누군가 마도구를 가져가지 못하도록 안전장치를 하나 더 마련해 둔 것이다."


translate japanese plotbattle_12f621fa:


    nvlNone "바로 이 마법진 속 공간."


translate japanese plotbattle_faa61fa9:


    nvlNone "그 마법진에 새겨진 명문을 자세히 읽지는 않았지만, 아무 마력이나 흡수하는 것은 아닐 것이다."


translate japanese plotbattle_77619937:


    nvlNone "내 주파수와 일치하는 마력만이,\n그 마법진을 작동시킬 수 있다."


translate japanese plotbattle_67c3890d:


    nvlNone "아마 내가 대륙을\n모험하다가 찾아갔던 유적 가운데 하나일 것이다."


translate japanese plotbattle_c2491f56:


    nvlNone "기억을 완전히 잃었던 시절의 나라면,\n아마 이곳이 어딘지 알아보지 못했을 것이다."


translate japanese plotbattle_080e326f:


    nvlNone "하지만 아주 운이 좋다고 해야 할지, 나쁘다고 해야 할지."


translate japanese plotbattle_05450eef:


    nvlNone "하필이면 이 기억이 되살아나 있었다."


translate japanese plotbattle_fbf6becc:


    nvlNone "바닥에는 얼어붙은 돌조각도 여럿 보였다. 용사가 맨주먹으로 해치운 그레임의 잔해였다."


translate japanese plotbattle_9c66bd98:


    nvlNone "어째서 모든 것이 얼어붙어 있는가 하면."


translate japanese plotbattle_e1512607:



    voice "voice/cygnus_812.ogg"
    cygnus "가자."


translate japanese plotbattle_6b8c3833:



    voice "voice/blackcat_05.ogg"
    blackcat "어디 가? 출구를 찾았어?"


translate japanese plotbattle_23ec6c6a:



    voice "voice/blackcat_03.ogg"
    blackcat "야!"


translate japanese plotbattle_64699d64:


    "나는 노리에게 대꾸하지 않고 곧장 유적 안쪽으로 걸어갔다."


translate japanese plotbattle_6faa23c3:


    nvlNone "내 추측이 맞는다면."


translate japanese plotbattle_7cce44a1:


    nvlNone "「나」라면 반드시 유적 깊숙한 곳에 물건을 둘 것이다."


translate japanese plotbattle_a005f7ae:


    nvlNone "즉, 기억 속에서 「마나 결정」이 있던 자리다."


translate japanese plotbattle_f4887c59:


    nvlNone "그런데 어째서인지 가슴 깊은 곳이 술렁거린다."


translate japanese plotbattle_4f39909b:


    nvlNone "또 뭔가 놓친 게 있는 걸까?"


translate japanese plotbattle_f68b1381:


    nvlNone "나는 걸어가며 생각을 정리했다."


translate japanese plotbattle_4e367de4:


    nvlNone "유적 깊숙이 들어갈수록 그레임의 잔해도 늘어났다."


translate japanese plotbattle_d5c33b69:


    nvlNone "오는 길에는 아무런 장애물도 없었다."


translate japanese plotbattle_1c1bd351:


    nvlNone "하지만 마음속 불안은 사라질 기미가 없었다."


translate japanese plotbattle_0952a220:


    nvlNone "내가 너무 깊이 생각하는 걸까?"


translate japanese plotbattle_cf7175c9:



    voice "voice/blackcat_07.ogg"
    blackcat 0104 "흐음~ 여기냐?"


translate japanese plotbattle_75276f80:



    voice "voice/cygnus_813.ogg"
    cygnus 0201 "…"


translate japanese plotbattle_0312f5e9:


    "어느새 노리와 함께 유적 가장 깊숙한 곳에 도착했다."


translate japanese plotbattle_18a73dfc:


    "주변의 얼어붙은 책장들을 보니 한때 이곳이 마녀 공방의 핵심 구역이었음을 어렵지 않게 짐작할 수 있었다."


translate japanese plotbattle_0c25a2ca:


    "하지만 지금은 그레임의 파편이 널린 얼음방일 뿐이었다."


translate japanese plotbattle_11bd3c82:



    voice "voice/blackcat_35.ogg"
    blackcat "영차——!"


translate japanese plotbattle_9c58bb47:


    "노리는 가볍게 뛰어 방 중앙의 낮은 기둥 위에 올라탔다."


translate japanese plotbattle_7c64aaab:


    "이 기둥은 원래 공방 전체를 움직이는 핵심 장치, 이를테면 마법석 같은 것을 놓는 곳이었을 터였다. 그것이 공방의 심장 역할을 했을 것이다."


translate japanese plotbattle_b388d097:


    "나중에 나와 용사가 왔을 때, 이곳에 마나 결정이 맺혔다."


translate japanese plotbattle_5526a3f8:


    "그러니 이 공간에 마도구를 보관한 「나」도, 틀림없이 이 낮은 기둥 위에 마도구를 놓았을 것이다."


translate japanese plotbattle_8d772829:



    voice "voice/cygnus_814.ogg"
    cygnus "역시 없네……"


translate japanese plotbattle_788e4e7e:


    "하지만 지금 기둥 위는 텅 비어 있었다."


translate japanese plotbattle_c494800b:


    "멍청한 고양이 한 마리만 거드름을 피우며 앉아 있었다."


translate japanese plotbattle_8c05c7b2:



    voice "voice/blackcat_15.ogg"
    blackcat "냐하하, 네 보물창고는 도둑 하나도 못 막는구나——"


translate japanese plotbattle_e22fa1d9:



    voice "voice/blackcat_11.ogg"
    blackcat "냐앗!"


translate japanese plotbattle_e1512607_1:



    voice "voice/cygnus_815.ogg"
    cygnus "가자."


translate japanese plotbattle_756e3570:


    nvlNone "여기 없다면 되찾으면 된다."


translate japanese plotbattle_a6765df2:


    nvlNone "{size=72}{space=204}콰앙——!!!{/size}"


translate japanese plotbattle_6c2be6fc:


    nvlNone "갑자기 엄청난 굉음이 울려 퍼졌다."


translate japanese plotbattle_eea593d8:



    voice "voice/blackcat_13.ogg"
    blackcat "우오오——!?"


translate japanese plotbattle_163c9200:



    voice "voice/cygnus_816.ogg"
    cygnus 0204 "노리, 네 아래!"


translate japanese plotbattle_abdfb353:


    "노리가 앉은 낮은 기둥을 보니 어느새 마법진이 펼쳐져 있었다."


translate japanese plotbattle_771b8c5d:



    voice "voice/blackcat_28.ogg"
    blackcat "으악!"


translate japanese plotbattle_afe726e2:


    "깜짝 놀란 노리가 다시 뛰어올라 내 곁으로 돌아왔다."


translate japanese plotbattle_d41d8cd9_2:


    nvl clear


translate japanese plotbattle_384eb829:


    nvlNone "{size=44}쿠구구——{/size}"


translate japanese plotbattle_13a34ba1:


    nvlNone "바닥의 진동은 멎을 기미가 없었다."


translate japanese plotbattle_60fadbf3:


    nvlNone "얼음층도 흔들리며 갈라지기 시작했다."


translate japanese plotbattle_8dd34478:



    voice "voice/cygnus_00816.ogg"
    nvlNone "「…저건」"


translate japanese plotbattle_9e715be7:


    nvlNone "나는 흔들림을 견디며 간신히 자세를 바로잡고 마법진을 살폈다."


translate japanese plotbattle_c67e46e2:


    nvlNone "마법진 가장 안쪽에는 전송 마법이 새겨져 있었다."


translate japanese plotbattle_cd816e39:


    nvlNone "하지만 단순한 전이 마법이라면."


translate japanese plotbattle_d2ea4bf7:


    nvlNone "이렇게 큰 소동이 일어나지는 않는다."


translate japanese plotbattle_4abcbc5d:


    nvlNone "마법진을 그린 방식을 보니 틀림없이 내가 만든 것이었다."


translate japanese plotbattle_0070452f:


    nvlNone "그래서 새겨진 문자가 뜻하는 바도 쉽게 알 수 있었다."


translate japanese plotbattle_57c49cc8:


    nvlNone "「응집」, 「구조체」, 「파수」, 「자율형」……"


translate japanese plotbattle_67c6fa67:


    nvlNone "{size=44}쿠구구——!{/size}" with Shake((0, 0, 0, 0), 0.8, dist=10)


translate japanese plotbattle_694eb26d:


    nvlNone "점점 더 많은 얼음이 마법진으로 모여들었다."


translate japanese plotbattle_dc59fa6d:


    nvlNone "그 얼음들은 원래 얼어붙은 그레임의 잔해였다."


translate japanese plotbattle_b9acd1bc:


    nvlNone "끼기긱————"


translate japanese plotbattle_50b6dc96:


    nvlNone "거대한 얼음 덩어리들이 맞물리며 하나의 형태를 이루어 갔다."


translate japanese plotbattle_d3c1fe00:


    nvlNone "그리고 최악의 형태가 모습을 드러냈다."


translate japanese plotbattle_0645baaa:


    nvlNone "분명한 지시가 머릿속에 떠올랐고, 나는 곧바로 가장 강력한 형태로 바꾸었다."


translate japanese plotbattle_c357eaee:


    nvlNone "마녀로서의 감인가. 아니면 마법을 속속들이 알기에 드는 직감인가."


translate japanese plotbattle_a06c07b8:


    nvlNone "반쯤 몸에 밴 동작으로 오른손을 들어 올렸다.\n노리는 것은 저 돌기둥의 마법진."


translate japanese plotbattle_d41d8cd9_3:


    voice "voice/cygnus_00817.ogg"


translate japanese plotbattle_ae339503:


    nvlNone "「탄식 깃든 유령의 불꽃이여――」" (ctc=None)


translate japanese plotbattle_d369965a:


    nvlNone "첫 영창과 동시에,\n손바닥에서 거대한 진홍빛 마법진이 펼쳐졌다."


translate japanese plotbattle_8e4eaf18:


    nvlNone "……하지만 그 순간, 나는 아주 잠깐 망설였다."


translate japanese plotbattle_eec7b290:


    nvlNone "「얼마나 많은 마력을 쏟아부어야 하지.」"


translate japanese plotbattle_73835176:


    nvlNone "마력이 이렇게 부족했던 적은 한 번도 없었다."


translate japanese plotbattle_b1294578:


    nvlNone "하물며 「전력을 다해 마법을 쏘는」 일은 경험해 본 적도 없다."


translate japanese plotbattle_081e9c62:


    nvlNone "그 찰나의 망설임이 술식의 전개를 조금 늦췄다."


translate japanese plotbattle_4ec4fbe9:


    nvlNone "나는 곧 「힘을 남겨 두자」고 생각한 게 얼마나 어리석었는지 깨달았다."


translate japanese plotbattle_4a159516:


    nvlNone "끼기기기기기긱————!" with Shake((0, 0, 0, 0), 3.0, dist=5)


translate japanese plotbattle_5581a051:


    nvlNone "――!"


translate japanese plotbattle_194edb78:


    nvlNone "내 어리석음을 욕할 시간도 없었다."


translate japanese plotbattle_6cf0904b:


    nvlNone "나는 이 술식을 알고 있기에,\n방금 그 순간이 유일한 기회였다는 것도 알았다."


translate japanese plotbattle_d41d8cd9_4:


    voice "voice/cygnus_00818.ogg"


translate japanese plotbattle_1757e0a7:


    nvlNone "「……태양을 쏘는 맹렬한 기세로, 세 발의 화살이여——!」" (ctc=None)


translate japanese plotbattle_d41d8cd9_5:


    voice "voice/cygnus_00819.ogg"


translate japanese plotbattle_bd30270f:


    nvlNone "「穿陽灼矢・参！」" (ctc=None)


translate japanese plotbattle_d41d8cd9_6:


    nvl clear


translate japanese plotbattle_cb09ee4d:


    nvlNone "후욱——!"


translate japanese plotbattle_e7dc6b0e:


    nvlNone "영창을 마치자 오른손의 마법진이 손쇠뇌의 형태를 취하며 작열하는 투사체 세 개를 쏘아 냈다."


translate japanese plotbattle_d018bf7d:


    nvlNone "원래는 화살 아홉 발을 쏘는 섬멸 마법이었다."


translate japanese plotbattle_8fbf17e9:


    nvlNone "그렇게 했는데도 화살의 크기는 예상보다 훨씬 작았다."


translate japanese plotbattle_4449fa19:


    nvlNone "오늘 탐지 마법을 너무 많이 쓴 걸까.\n마력은 생각보다 훨씬 바닥나 있었다."


translate japanese plotbattle_2668005f:


    nvlNone "쾅――!"


translate japanese plotbattle_8a4f3f4e:


    nvlNone "첫 번째 작열의 화살이 명중했다."


translate japanese plotbattle_7c702958:


    nvlNone "세 화살에는 각각 연소, 충격, 관통이라는 세 가지 성질을 부여했다."


translate japanese plotbattle_0e5e7ca7:


    nvlNone "첫 번째는 연소였다."


translate japanese plotbattle_a0da5bb9:


    nvlNone "쾅――!!"


translate japanese plotbattle_0e05158f:


    nvlNone "곧이어 충격 효과를 지닌 두 번째 화살이 날아갔다."


translate japanese plotbattle_0dc8b7f1:


    nvlNone "명중하는 순간 거대한 충격이 표면의 얼음을 뚫고, 첫 번째보다 더 격렬한 소리를 울렸다."


translate japanese plotbattle_0ed4ff7b:


    nvlNone "그리고―― 마지막 한 발."


translate japanese plotbattle_87e8b6e3:


    nvlNone "앞의 두 발은 바깥 얼음을 부수어 이 세 번째를 위한 길을 열었을 뿐이다."


translate japanese plotbattle_527c0ed4:


    nvlNone "나는 남은 마력을 거의 전부 마지막 화살에 압축해 넣었다."


translate japanese plotbattle_2dcdd4ed:


    nvlNone "그 화살을 더욱 날카로운 형태로 빚고, 비행 궤도 위의 마법진 세 개를 통과시켜 위력을 강화했다."


translate japanese plotbattle_3b72c6c4:


    nvlNone "콰앙――!!!"


translate japanese plotbattle_4f5ee90c:


    nvlNone "세 번째 작열의 화살이 정확히 명중했다."


translate japanese plotbattle_09133cd5:



    voice "voice/cygnus_00820.ogg"
    nvlNone "「으——!」"


translate japanese plotbattle_c1de8f6e:



    voice "voice/cygnus_00821.ogg"
    nvlNone "「……해치웠나.」"


translate japanese plotbattle_491d30bf:


    nvlNone "몰아치는 수증기에 모자가 날아갈 것 같아 한 손으로 눌러 썼다."


translate japanese plotbattle_8f422523:


    nvlNone "…"


translate japanese plotbattle_7dacb0c3:


    nvlNone "넘실거리는 수증기 외에는 얼음방 전체가 고요해졌다. 바닥의 진동도 멎었다."


translate japanese plotbattle_e6288e4f:


    nvlNone "해치웠다―― 그렇게 생각했다."


translate japanese plotbattle_0468d605:


    nvlNone "하지만 마음속 위기감은 여전히 사라지지 않았다."


translate japanese plotbattle_38025bb3:


    nvlNone "끼기기기기기긱————!"


translate japanese plotbattle_1fe088d1:


    nvlNone "굉음과 함께 거대한 얼음 두 덩어리가 수증기를 갈랐다."


translate japanese plotbattle_61193c19:


    nvlNone "정확히 말하면 더는 얼음 덩어리가 아니었다——{p}얼음으로 이루어진 거대한 두 손이었다."


translate japanese plotbattle_da2bc129:



    voice "voice/cygnus_00822.ogg"
    nvlNone "「역시 {a=dictionary:dict_entry_46}{font=SourceHanSerifSC-Regular.otf}『그레임 구축술』{/font}{/a}이었나……」"


translate japanese plotbattle_2c265569:


    nvlNone "나는 그리 놀라지 않았다.{p}마법진에 새겨진 명문의 구절과 전개될 때의 움직임으로,\n거의 확신하고 있었기 때문이다."


translate japanese plotbattle_dad3e774:


    nvlNone "다만 이 그레임이 형체를 갖추기도 전에 내 공격을 정면으로 맞고도 쓰러지지 않은 것은 예상 밖이었다."


translate japanese plotbattle_f427177b:


    nvlNone "그래도 방금 마법 공격 덕분에\n얼음에 감싸여 있던 그레임의 핵이 완전히 드러나 있었다."


translate japanese plotbattle_5cf6682b:


    nvlNone "세 번째 화살이 조금만 더 깊이 닿았다면 그걸로 끝났을 것이다."


translate japanese plotbattle_15985b22:



    nvl clear
    nvlNone "이윽고 수증기가 걷히고 그레임이 모습을 드러냈다. 곧바로 내 존재를 포착했다."


translate japanese plotbattle_a56d3430:


    nvlNone "지성이 없는 그것은 「나」가\n마법진에 새긴 명령만 충실히 실행한다."


translate japanese plotbattle_20768316:


    nvlNone "끼가각————!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plotbattle_e396eabe:


    nvlNone "그레임은 한순간도 지체하지 않고 곧장 내게 덤벼들었다."


translate japanese plotbattle_e67cdb4b:



    voice "voice/cygnus_00823.ogg"
    nvlNone "「쳇……!」"


translate japanese plotbattle_7db329fa:


    nvlNone "「내」가 이렇게 강하다는 사실이 이토록 원망스러운 건 처음일지도 모른다."


translate japanese plotbattle_68da1158:


    nvlNone "하지만 눈앞의 그레임은 핵이 드러나 있었다."


translate japanese plotbattle_ec2b3de2:


    nvlNone "심지어 그 위에 생긴 균열까지 보였다."


translate japanese plotbattle_8cf1a2fb:


    nvlNone "마법을 한 발만 더 맞히면 핵을 완전히 부술 수 있을 것이다."


translate japanese plotbattle_098652ce:


    nvlNone "나는 오른손을 들고,\n검지와 중지 끝에 불꽃빛 마법진을 펼쳐 다가오는 그레임의 핵을 겨누었다."


translate japanese plotbattle_931e0631:


    nvlNone "마법 한 발이면 된다."


translate japanese plotbattle_76ed4b9b:


    nvlNone "나는 몸속의 마력을 끌어내 검지와 중지 앞에 조금 커다란 불덩이를 응집시켰다."


translate japanese plotbattle_c4205c9c:


    nvlNone "――!!"


translate japanese plotbattle_4419c6cf:


    nvlNone "하지만 불덩이를 손끝에서 쏘아 보내는 순간, 갑자기 강한 현기증이 몰려왔다."


translate japanese plotbattle_21fccf02:


    nvlNone "현기증은 조준 중이던 마법에도 영향을 미쳤고,{p}불덩이의 궤도가 살짝 위로 틀어졌다."


translate japanese plotbattle_919e75fe:


    nvlNone "「으, 마력이 부족해……!」"


translate japanese plotbattle_46c1f8e8:


    nvlNone "오늘 밤 탐지 마법을 너무 많이 썼다."


translate japanese plotbattle_f58260fd:


    nvlNone "게다가 아까 작열의 화살로{p}남은 마력마저 거의 다 써 버렸다. 지금은 형태조차 유지할 수 없는 지경이다."


translate japanese plotbattle_ea410f2e:


    nvlNone "마지막으로 화구술을 쏜 순간,\n마력 부족의 부작용이 마침내 드러났다."


translate japanese plotbattle_c72caae1:


    nvlNone "큰일이다. 화구를 한 발 더 쏴야 한다."


translate japanese plotbattle_0de1e2aa:


    nvlNone "그렇게 생각하고 있는데도,\n손끝에는 더 이상 불씨 하나 모이지 않았다."


translate japanese plotbattle_e1d9cd42:


    nvlNone "고개를 들자 거대한 팔이,\n이미 내 머리 바로 위까지 치켜들려 있었다."


translate japanese plotbattle_c8c5467f:


    nvlNone "숨 한 번 쉬는 사이에 나는 산산이 으깨지겠지."


translate japanese plotbattle_d52d7a9d:


    nvlNone "지금 나는 어떤 표정을 짓고 있을까."


translate japanese plotbattle_159c6c58:


    nvlNone "마나도 없는 이세계에서 자기 마법에 죽는다니."


translate japanese plotbattle_53bf30ab:


    nvlNone "세상에 이보다 멍청한 마녀가 또 있을까?"


translate japanese plotbattle_eb181acd:



    voice "voice/cygnus_00826.ogg"
    nvlNone "「멈춰.」"


translate japanese plotbattle_f5ef8942:


    nvlNone "나는 마음속으로 그렇게 외치며,\n이 명령이 그레임에게 닿기를 바랐다."


translate japanese plotbattle_0f52e148:


    nvlNone "물론 알고 있다. 그런 명령은 닿지 않는다. 이 그레임에는 자율 행동 논리를 새겨 넣었으니까."


translate japanese plotbattle_35c3c163:


    nvlNone "그런데도 나는 마음속으로 계속 되뇌었다."


translate japanese plotbattle_eb181acd_1:



    voice "voice/cygnus_00827.ogg"
    nvlNone "「멈춰.」"


translate japanese plotbattle_7cfc5c57:


    nvlNone "나는 원래 죽음을 앞둔 순간이면."


translate japanese plotbattle_31c20100:


    nvlNone "잃어버린 기억이 주마등처럼 되살아날 거라고 생각했다."


translate japanese plotbattle_d2b9562a:


    nvlNone "아아——"


translate japanese plotbattle_21eae240:


    nvlNone "마지막 순간에 내가 생각하는 건 라이라구나."


translate japanese plotbattle_95026ce2:


    nvlNone "그 애도 이 결계에 끌려 들어온 건 아닐까…"


translate japanese plotbattle_6bea9a37:


    nvlNone "그 애에게는 몇 번이나 도움을 받았다.{p}내 탓에 위험한 일을 겪게 했다면――\n분명 죽어서도 후회가 남을 것이다."


translate japanese plot5_rescue_shout_first_d41d8cd9:


    nvl clear


translate japanese plot5_rescue_shout_first_f9fdd25c:


    nvlNone "누군가 나를 부른 것 같았다."


translate japanese plot5_rescue_shout_first_335ec922:


    nvlNone "굉음이 한 차례 울린 뒤, 모든 것이 고요해졌다."


translate japanese plot5_rescue_shout_first_ef00c9d2:


    nvlNone "내 목숨은 그렇게 끝났다."


translate japanese plot5_rescue_shout_first_aa2f0b02:


    nvlNone "고통도, 감각도 없었다."


translate japanese plot5_rescue_shout_first_8f422523:


    nvlNone "…"


translate japanese plot5_rescue_shout_first_8f422523_1:


    nvlNone "…"


translate japanese plot5_rescue_shout_first_112616ce:


    nvlNone "무사한 건가…?"


translate japanese plot5_rescue_shout_first_74f0077b:


    nvlNone "나는 천천히 눈을 떴다. 그곳에는 낯익은 뒷모습이 내 앞을 가로막고 있었다."


translate japanese plot5_rescue_shout_first_7ac7106b:


    nvlNone "거대한 그림자가 우리를 덮고, 그레임의 커다란 팔이,\n머리 위에서 딱 멈춰 있었다."


translate japanese plot5_rescue_shout_first_9e681de3:


    nvlNone "「괜찮아? 시노스?」"


translate japanese plot5_rescue_shout_first_a67a4d6a:


    nvlNone "그 애가 내게 물었다. 나는 순간,\n뭐라고 대답해야 할지 알 수 없었다."


translate japanese plot5_rescue_shout_first_86c3294f:



    voice "voice/cygnus_00828.ogg"
    nvlNone "「라이라…… 너……」"


translate japanese plot5_rescue_shout_first_fecfbb30:


    nvlNone "라이라가 정말로 그레임의 거대한 주먹을 떠받치고 있었다."


translate japanese plot5_rescue_shout_first_1c0786e4:


    nvlNone "라이라는 한 손을 떼어 뒤로 힘껏 밀며, 나를 그레임의 팔이 닿는 범위 밖으로 밀어냈다."


translate japanese plot5_rescue_shout_first_a4e1caeb:


    nvlNone "균형을 잃고 뒤로 넘어가는 나를 다른 두 손이 받아 주었다."


translate japanese plot5_rescue_shout_first_d16be61c:



    voice "voice/yangxi_00267.ogg"
    nvlNone "「응.」" (**end_page())


translate japanese plot5_rescue_shout_first_300bedb3:


    nvlNone "뒤를 돌아보니 모르는 사람이었다."


translate japanese plot5_rescue_shout_first_4c112f80:


    nvlNone "나는 그 애를 보고, 그 애는 나를 보았다."


translate japanese plot5_rescue_shout_first_8f0b4a45:



    voice "voice/cygnus_00830.ogg"
    nvlNone "「……이건 또 무슨 일이야.」"


translate japanese plot5_rescue_shout_first_84c45057:


    nvlNone "이제는 대체 무슨 상황인지 잘 모르겠다."


translate japanese plot5_rescue_shout_first_be12b036:


    nvlNone "아니면 사실 나는 이미 죽은 걸까?"


translate japanese plot5_battle_twenty_minutes_earlier_6cf5272b:



    voice "voice/tianqin_1169.ogg"
    tianqin "푸하……"


translate japanese plot5_battle_twenty_minutes_earlier_f8fc97d0:



    voice "voice/tianqin_1170.ogg"
    tianqin "머리 아파…… 여긴 어디지……"


translate japanese plot5_battle_twenty_minutes_earlier_b24e5e23:



    voice "voice/yangxi_272.ogg"
    yangxi "으음……"


translate japanese plot5_battle_twenty_minutes_earlier_6433bc09:



    voice "voice/tianqin_1171.ogg"
    tianqin "어! 히나타, 네가 왜 여기 있어!"


translate japanese plot5_battle_twenty_minutes_earlier_4fdce95c:



    voice "voice/yangxi_273.ogg"
    yangxi "연기를 하려면 좀 그럴듯하게 해. 내가 뒤따라오는 거 진작 알았잖아."


translate japanese plot5_battle_twenty_minutes_earlier_ada5c5a0:



    voice "voice/tianqin_1172.ogg"
    tianqin "아, 아하하. 들켰네."


translate japanese plot5_battle_twenty_minutes_earlier_2e82c018:



    voice "voice/yangxi_274.ogg"
    yangxi "그래서? 한밤중에 학교엔 왜 왔어?"


translate japanese plot5_battle_twenty_minutes_earlier_11460f69:



    voice "voice/yangxi_275.ogg"
    yangxi "아까 네 옆에 있던 사람은 누구고?"


translate japanese plot5_battle_twenty_minutes_earlier_fb67098a:



    voice "voice/tianqin_1173.ogg"
    tianqin "맞다, 시노스는!"


translate japanese plot5_battle_twenty_minutes_earlier_e87ba0fe:



    voice "voice/tianqin_1174.ogg"
    tianqin "아——!!"


translate japanese plot5_battle_twenty_minutes_earlier_d13cc643:



    voice "voice/yangxi_276.ogg"
    yangxi "（흐음? 그 사람 이름이 시노스구나…）"


translate japanese plot5_battle_twenty_minutes_earlier_19da944b:



    voice "voice/yangxi_277.ogg"
    yangxi "――!"


translate japanese plot5_battle_twenty_minutes_earlier_cfb9fd3c:


    "라이라가 {glitch=5}{color=#7393B3}{b}「시노스」{/b}{/color}{/glitch}라는 이름을 인식했을 때와 같았다."


translate japanese plot5_battle_twenty_minutes_earlier_796a0dca:


    "히나타가 「이름」과 「인물」을 연결한 순간, 전류가 온몸을 흐르는 듯했다."


translate japanese plot5_battle_twenty_minutes_earlier_5cd0a1f9:



    voice "voice/yangxi_278.ogg"
    yangxi "시노스라……"


translate japanese plot5_battle_twenty_minutes_earlier_1be57070:



    voice "voice/tianqin_1175.ogg"
    tianqin "아와와와!!"


translate japanese plot5_battle_twenty_minutes_earlier_72555230:



    voice "voice/tianqin_1176.ogg"
    tianqin "그 이름 절대로 말하고 다니면 안 돼!"


translate japanese plot5_battle_twenty_minutes_earlier_8e54e1f6:



    voice "voice/yangxi_279.ogg"
    yangxi "뭐?"


translate japanese plot5_battle_twenty_minutes_earlier_e31a5dca:



    voice "voice/tianqin_1177.ogg"
    tianqin "아, 아무튼 말하지 마!"


translate japanese plot5_battle_twenty_minutes_earlier_941855f9:



    voice "voice/yangxi_280.ogg"
    yangxi "무슨 말인지 모르겠네… 그래서 여긴 어디야?"


translate japanese plot5_battle_twenty_minutes_earlier_e9334c6f:



    voice "voice/yangxi_281.ogg"
    yangxi "아까 그 하얀 빛은 또 뭐고?"


translate japanese plot5_battle_twenty_minutes_earlier_8631bf49:



    voice "voice/tianqin_1178.ogg"
    tianqin "어, 아, 아마 무슨 마법……?"


translate japanese plot5_battle_twenty_minutes_earlier_6bb45606:



    voice "voice/yangxi_282.ogg"
    yangxi "뭐?"


translate japanese plot5_battle_twenty_minutes_earlier_c09a3a61:



    voice "voice/tianqin_1179.ogg"
    tianqin "어, 마, 마법 말이야!"


translate japanese plot5_battle_twenty_minutes_earlier_cc0e4f23:



    voice "voice/tianqin_1180.ogg"
    tianqin "ヒナタだっていつも『月の美少女』見てるでしょ！ あれに出てくる子たちが使うやつ――"


translate japanese plot5_battle_twenty_minutes_earlier_69d4508e:


    "탁!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot5_battle_twenty_minutes_earlier_93384efa:


    "히나타가 두 손으로 라이라의 볼을 감쌌다."


translate japanese plot5_battle_twenty_minutes_earlier_1294e491:



    voice "voice/tianqin_1181.ogg"
    tianqin 0109 "히, 히나타?"


translate japanese plot5_battle_twenty_minutes_earlier_d454d1bf:



    voice "voice/yangxi_283.ogg"
    yangxi 0107 "정신 차려, 정신 차려."


translate japanese plot5_battle_twenty_minutes_earlier_713f4701:



    voice "voice/tianqin_1182.ogg"
    tianqin 0112 "우오오오!?"


translate japanese plot5_battle_twenty_minutes_earlier_28fec0b3:



    voice "voice/yangxi_284.ogg"
    yangxi ""


translate japanese plot5_battle_twenty_minutes_earlier_ae942c43:



    voice "voice/tianqin_1183.ogg"
    tianqin "아, 아니라니까! 진심이야!"


translate japanese plot5_battle_twenty_minutes_earlier_fd83e3c4:



    voice "voice/tianqin_1184.ogg"
    tianqin "「마법」이라는 게 정말로 있어!"


translate japanese plot5_battle_twenty_minutes_earlier_ee92ac8d:



    voice "voice/yangxi_285.ogg"
    yangxi "……정말 머리를 부딪쳤나 보네."


translate japanese plot5_battle_twenty_minutes_earlier_2f98a411:



    voice "voice/tianqin_1185.ogg"
    tianqin "그만, 그만! 머리 좀 그만 흔들어!"


translate japanese plot5_battle_twenty_minutes_earlier_6d93281f:



    voice "voice/tianqin_1186.ogg"
    tianqin "더 흔들면 뇌가 전부 뒤섞이겠어."


translate japanese plot5_battle_twenty_minutes_earlier_a3e8d607:



    voice "voice/yangxi_286.ogg"
    yangxi "그럼 똑바로 설명해. 대체 무슨 일이야?"


translate japanese plot5_battle_twenty_minutes_earlier_d1ab929f:



    voice "voice/tianqin_1187.ogg"
    tianqin "어…… 일단 걸으면서 얘기하자."


translate japanese plot5_battle_twenty_minutes_earlier_c3b8e7ae:



    voice "voice/tianqin_1188.ogg"
    tianqin "지금은 시노스를 찾는 게 먼저야."


translate japanese plot5_battle_twenty_minutes_earlier_2c1964ff:


    "라이라는 더 숨길 이유가 없었다. 그동안 있었던 일을 한꺼번에 히나타에게 털어놓았다."


translate japanese plot5_battle_twenty_minutes_earlier_8f1f7135:


    "오히려 계속 말하고 싶어 견딜 수 없어, 히나타에게 이야기할 기회를 찾고 있었다고도 할 수 있다."


translate japanese plot5_battle_twenty_minutes_earlier_3ae9146f:


    "그 기회가 이런 상황에서 올 줄은 몰랐지만."


translate japanese plot5_battle_twenty_minutes_earlier_7d69c0bd:



    voice "voice/yangxi_287.ogg"
    yangxi "잠깐, 잠깐, 잠깐! 그렇게 아무렇지도 않게 빨리 말하지 마!"


translate japanese plot5_battle_twenty_minutes_earlier_bd018c69:



    voice "voice/yangxi_288.ogg"
    yangxi "이세계?? 마법?? 마녀?? 대체 무슨 말이야???"


translate japanese plot5_battle_twenty_minutes_earlier_0454a785:



    voice "voice/tianqin_1189.ogg"
    tianqin "아, 그러니까 말했잖아."


translate japanese plot5_battle_twenty_minutes_earlier_532b069d:



    voice "voice/tianqin_1190.ogg"
    tianqin "이세계랑 마법은 정말로 있다고."


translate japanese plot5_battle_twenty_minutes_earlier_d3eead3c:



    voice "voice/yangxi_289.ogg"
    yangxi "違う！ それ、そんな雑にまとめていい話じゃないでしょ！？"


translate japanese plot5_battle_twenty_minutes_earlier_370c6823:



    voice "voice/yangxi_290.ogg"
    yangxi "으음——"


translate japanese plot5_battle_twenty_minutes_earlier_b3121a14:


    "고작 십여 분 사이 히나타의 얼굴에는 당혹감과 놀라움, 동요가 차례로 떠올랐다."


translate japanese plot5_battle_twenty_minutes_earlier_d1c3b76c:


    "마지막으로 남은 것은 이 공허한 표정이었다."


translate japanese plot5_battle_twenty_minutes_earlier_9d8ee542:



    voice "voice/yangxi_291.ogg"
    yangxi "하아—— 아니…… 넌 라이라니까…… 라이라가 하는 말이니까……"


translate japanese plot5_battle_twenty_minutes_earlier_6393c794:



    voice "voice/yangxi_292.ogg"
    yangxi "이상한 건 오히려 나일지도……"


translate japanese plot5_battle_twenty_minutes_earlier_fb3c823c:



    voice "voice/tianqin_1191.ogg"
    tianqin "아이, 아니라니까!"


translate japanese plot5_battle_twenty_minutes_earlier_64d05c52:



    voice "voice/tianqin_1192.ogg"
    tianqin "나도 받아들이는 데 한참 걸렸어!"


translate japanese plot5_battle_twenty_minutes_earlier_e8ad1cf1:



    voice "voice/yangxi_293.ogg"
    yangxi "そうかな。あんた、けっこうこういうこと楽しんでそうだけど。"


translate japanese plot5_battle_twenty_minutes_earlier_0483bbb2:



    voice "voice/tianqin_1193.ogg"
    tianqin "어? 그, 그렇게 티 나? 아하하——"


translate japanese plot5_battle_twenty_minutes_earlier_0699b167:



    voice "voice/yangxi_294.ogg"
    yangxi "하아——"


translate japanese plot5_battle_twenty_minutes_earlier_7a7d5fb5:


    "히나타는 체념하듯 한숨을 내쉬었다."


translate japanese plot5_battle_twenty_minutes_earlier_676c76f6:



    voice "voice/yangxi_295.ogg"
    yangxi "난 너처럼 이런 일을 덥석 받아들이지는 못하겠어."


translate japanese plot5_battle_twenty_minutes_earlier_50a4a88d:



    voice "voice/yangxi_296.ogg"
    yangxi "그래도 꿈이 아니라면……"


translate japanese plot5_battle_twenty_minutes_earlier_2d8b9e62:



    voice "voice/yangxi_297.ogg"
    yangxi "…"


translate japanese plot5_battle_twenty_minutes_earlier_44a44cc1:



    voice "voice/tianqin_1194.ogg"
    tianqin "아야, 아야야!!"


translate japanese plot5_battle_twenty_minutes_earlier_aaf1fa4b:



    voice "voice/yangxi_298.ogg"
    yangxi "나 정말 꿈꾸는 거 아니지?"


translate japanese plot5_battle_twenty_minutes_earlier_d04f8889:



    voice "voice/tianqin_1195.ogg"
    tianqin "네 꿈 확인하는데 왜 내 볼을 꼬집어!"


translate japanese plot5_battle_twenty_minutes_earlier_bc2c4659:



    voice "voice/tianqin_1196.ogg"
    tianqin "아파, 아파——!"


translate japanese plot5_battle_twenty_minutes_earlier_b535922b:



    voice "voice/yangxi_299.ogg"
    yangxi "꿈이 아니면 됐어."


translate japanese plot5_battle_twenty_minutes_earlier_d5b68460:


    "히나타는 눈을 감고 한참 생각에 잠겼다."


translate japanese plot5_battle_twenty_minutes_earlier_0e955bda:


    "십여 분 만에 자신의 세계관이 완전히 뒤집혔다."


translate japanese plot5_battle_twenty_minutes_earlier_e9ea134a:


    "안 믿을 수도 없었다. 아니, 정확히 말하면 지금 상황이 그 사실들을 억지로 머릿속에 집어넣고 있었다."


translate japanese plot5_battle_twenty_minutes_earlier_0f6b7986:


    "지금 자신이 본래 상상조차 못 했을 상황에 놓여 있으니까."


translate japanese plot5_battle_twenty_minutes_earlier_e629c9cd:



    voice "voice/yangxi_300.ogg"
    yangxi "에휴, 됐다."


translate japanese plot5_battle_twenty_minutes_earlier_fce295df:


    "결국 그녀는 평소의 이성을 내려놓고 생각하기를 포기했다."


translate japanese plot5_battle_twenty_minutes_earlier_7c01dba1:



    voice "voice/yangxi_301.ogg"
    yangxi "つまり、あんたと一緒にいた子を見つければ、帰れるってこと？"


translate japanese plot5_battle_twenty_minutes_earlier_522a94be:



    voice "voice/tianqin_1197.ogg"
    tianqin "어, 아, 아마도?"


translate japanese plot5_battle_twenty_minutes_earlier_2d8b9e62_1:



    voice "voice/yangxi_302.ogg"
    yangxi "…"


translate japanese plot5_battle_twenty_minutes_earlier_8547461e:



    voice "voice/tianqin_1198.ogg"
    tianqin "나도 이제 어떻게 해야 할지 모르겠어."


translate japanese plot5_battle_twenty_minutes_earlier_a6b28e7b:



    voice "voice/tianqin_1199.ogg"
    tianqin "너무 갑자기 생긴 일이라……"


translate japanese plot5_battle_twenty_minutes_earlier_2d8b9e62_2:



    voice "voice/yangxi_303.ogg"
    yangxi "…"


translate japanese plot5_battle_twenty_minutes_earlier_ecd9f0b1:


    "확실히 이 이상 라이라를 탓할 수는 없었다. 그래 봤자 애꿎은 사람에게 화풀이하는 꼴이었다."


translate japanese plot5_battle_twenty_minutes_earlier_224eb74f:


    "지금 상황은 라이라가 어찌할 수 있는 일이 아니었으니까."


translate japanese plot5_battle_twenty_minutes_earlier_38c5c9af:


    "탓할 거라면 줄곧 두 사람의 뒤를 따라온 자신을 탓해야 했다."


translate japanese plot5_battle_twenty_minutes_earlier_e31375fd:



    voice "voice/yangxi_304.ogg"
    yangxi "가자."


translate japanese plot5_battle_twenty_minutes_earlier_9e0fc59f:


    "눈앞의 통로는 끝이 없는 듯했다."


translate japanese plot5_battle_twenty_minutes_earlier_746103ed:


    "둘은 계속 다른 갈림길로 들어갔지만, 어째서인지 결국 출발점으로 돌아왔다."


translate japanese plot5_battle_twenty_minutes_earlier_d41d8cd9:


    voice "voice/tianqin_1200.ogg"


translate japanese plot5_battle_twenty_minutes_earlier_1fa9e1e5:


    tianqin "아까 앞으로 갔잖아? 왜 또 여기야……"


translate japanese plot5_battle_twenty_minutes_earlier_d199fd03:



    voice "voice/yangxi_305.ogg"
    yangxi "고리 모양으로 이어진 걸지도 몰라."


translate japanese plot5_battle_twenty_minutes_earlier_2c810f75:



    voice "voice/tianqin_1201.ogg"
    tianqin "아! 그렇네!"


translate japanese plot5_battle_twenty_minutes_earlier_fe9649fb:



    voice "voice/yangxi_306.ogg"
    yangxi "하지만…… 네가 말한 「마법」이 장난을 치고 있을 가능성도 있다고 생각해."


translate japanese plot5_battle_twenty_minutes_earlier_a786b7bc:



    voice "voice/yangxi_307.ogg"
    yangxi "아까 지나온 갈림길은 다 똑똑히 기억해. 공간 구조가 맞아떨어지지 않아……"


translate japanese plot5_battle_twenty_minutes_earlier_694d78a7:



    voice "voice/tianqin_1202.ogg"
    tianqin "그럼…… 길을 잃게 하는 결계!?"


translate japanese plot5_battle_twenty_minutes_earlier_d705e827:



    voice "voice/yangxi_308.ogg"
    yangxi "いっそ通路を全部壊して貫通させたら？ それも一つの解法だと思う。"


translate japanese plot5_battle_twenty_minutes_earlier_fe13fa3f:



    voice "voice/tianqin_1203.ogg"
    tianqin "에—— 그건 엄청 힘들 것 같아——"


translate japanese plot5_battle_twenty_minutes_earlier_083c0e0d:


    "쾅――!"


translate japanese plot5_battle_twenty_minutes_earlier_a3a05cd7:


    "멀지 않은 곳에서 연달아 굉음이 울렸다."


translate japanese plot5_battle_twenty_minutes_earlier_e6b16361:



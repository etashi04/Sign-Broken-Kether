


translate japanese plot8_65f3396d:


    "주말 아침."


translate japanese plot8_0f1e9eb5:


    "커튼 사이로 스며든 옅은 아침 햇살이 이불 속 마녀에게 더없이 포근한 기분을 안겨 주었다."


translate japanese plot8_73d17b2f:


    "새들의 지저귐도 딱 알맞았다. 잠을 방해하기는커녕, 이대로 재워 주는 자장가 같았다."


translate japanese plot8_ce02f795:



    voice "voice/cygnus_987.ogg"
    cygnus "후……"


translate japanese plot8_4b82ec4d:


    "벌써 아침을 먹을 시간이었다. 그래도 마녀는 이 호사스러운 잠을 조금만 더 누리고 싶었다."


translate japanese plot8_c5d23450:


    "몸에 꼭 맞는 매트리스와 부드러운 베개가 마녀의 몸을 포근하게 받쳐 주었다."


translate japanese plot8_67393421:


    "모두 그녀가 원래 살던 세계에서는 누릴 수 없었던 것들이었다."


translate japanese plot8_c1a2c873:


    "모든 게 더없이 좋았다. 평소 자신을 안고 자는 베개처럼 쓰던 사람마저 지금은 침대에 없었으니까."


translate japanese plot8_efe4eb8f:


    "하지만……"


translate japanese plot8_14e1ad47:



    voice "voice/tianqin_1785.ogg"
    tianqin "うおおおおお――ファイト――！"


translate japanese plot8_bd808d4c:


    "라이라가 일어난 뒤로 거실에서 줄곧 시끄러운 소리가 들려왔다."


translate japanese plot8_b929462d:


    "함께 사는 사람이 무슨 이유에선지 오늘은 아침부터 유난히 들떠 있었다."


translate japanese plot8_69f867f3:


    "아니, 「들떠 있다」로는 부족하다. 「날뛰고 있다」고 하는 편이 더 가까웠다."


translate japanese plot8_a7664a46:



    voice "voice/cygnus_988.ogg"
    cygnus "으으……!"


translate japanese plot8_6851c802:


    "잠에서 깬 짜증을 꾹 누르며, 시노스는 침대에서 나와 라이라가 뭘 하는지 보러 갔다."


translate japanese plot8_dae9c448:


    "거실 탁자에는 교과서가 펼쳐져 있었고, 흰색과 갈색, 회색 시험지가 산더미처럼 쌓여 있었다. 어느 것이나 깨알 같은 문제로 빽빽했다."


translate japanese plot8_8cdf044e:


    "라이라는 탁자에 머리를 박을 듯 앉아 교과서를 헤엄치듯 넘기며, 다음 주 월례 시험에 나올 내용을 허겁지겁 공부하고 있었다."


translate japanese plot8_743412db:



    voice "voice/cygnus_989.ogg"
    cygnus "뭐 하는 거야……"


translate japanese plot8_d895f43b:


    "시노스로서는 이래도 말을 꽤 부드럽게 한 셈이었다."


translate japanese plot8_d3384ab5:


    "상대가 다른 사람이었다면 분명 이렇게 말했을 것이다——「아침부터 뭘 그렇게 떠드는 거야!」"


translate japanese plot8_aea55542:



    voice "voice/tianqin_1786.ogg"
    tianqin "오! 일어났어, 시노스!"


translate japanese plot8_74c4b2d5:



    voice "voice/tianqin_1787.ogg"
    tianqin "아침은 다 해 놨으니까 주방에 가서 먹어!"


translate japanese plot8_06b58e7d:



    voice "voice/tianqin_1788.ogg"
    tianqin "이번 주말에는 방해하지 마, 시노스. 나, 이 문제집을 전부 다 풀 거니까!"


translate japanese plot8_faebe7b3:



    voice "voice/cygnus_990.ogg"
    cygnus "하아…"


translate japanese plot8_9058f668:



    voice "voice/cygnus_991.ogg"
    cygnus "(대체 누가 누굴 방해하는 건데……)"


translate japanese plot8_5eb24891:


    "딩동——"


translate japanese plot8_15a2543a:



    voice "voice/cygnus_992.ogg"
    cygnus "응?"


translate japanese plot8_d8bc7e5a:



    voice "voice/tianqin_1789.ogg"
    tianqin "오! 구세주가 왔다!"


translate japanese plot8_3d7d7989:



    voice "voice/tianqin_1790.ogg"
    tianqin "시노스——문 좀 열어 줘——"


translate japanese plot8_30c27dd7:



    voice "voice/cygnus_993.ogg"
    cygnus "그래, 그래……"


translate japanese plot8_c778918d:



    voice "voice/yangxi_595.ogg"
    yangxi "좋은 아침."


translate japanese plot8_c337133b:



    voice "voice/cygnus_994.ogg"
    cygnus "(……안대?)"


translate japanese plot8_227ccff3:



    voice "voice/cygnus_995.ogg"
    cygnus "……여긴 왜 왔어?"


translate japanese plot8_ebb09905:



    voice "voice/yangxi_596.ogg"
    yangxi "친한 친구 집에 오는 게 뭐 별일이야?"


translate japanese plot8_58a835d0:



    voice "voice/cygnus_996.ogg"
    cygnus "네가 그렇게 먼저 찾아오는 성격은 아니지 않아……?"


translate japanese plot8_05cb356b:


    voice "voice/tianqin_1791.ogg"
    tianqin 0310 "히나타——와서 문제 푸는 거 가르쳐 줘——!"


translate japanese plot8_34a46cfd:



    voice "voice/yangxi_597.ogg"
    yangxi "거봐."


translate japanese plot8_67343c35:



    voice "voice/cygnus_997.ogg"
    cygnus "하아——"


translate japanese plot8_fc6dad5a:



    voice "voice/tianqin_1792.ogg"
    tianqin "우오오오——!"


translate japanese plot8_b22facc8:



    voice "voice/yangxi_598.ogg"
    yangxi "제법인데. 벌써 문제를 풀고 있었네."


translate japanese plot8_03ac0dec:



    voice "voice/cygnus_998.ogg"
    cygnus "아침부터 시끄러워 죽겠어……"


translate japanese plot8_32d37a5a:



    voice "voice/yangxi_599.ogg"
    yangxi "라이라는 아마 한 달에 한 번쯤은 주말에 저럴걸."


translate japanese plot8_9af73cdc:



    voice "voice/cygnus_999.ogg"
    cygnus "「월례 시험」인가 하는 걸 준비하는 거였지?"


translate japanese plot8_84bde17a:



    voice "voice/yangxi_600.ogg"
    yangxi "응, 잘 아네."


translate japanese plot8_15bbb53b:



    voice "voice/cygnus_1000.ogg"
    cygnus "어젯밤에 라이라한테 조금 들었어."


translate japanese plot8_67753620:



    voice "voice/yangxi_601.ogg"
    yangxi "1차 월례 시험, 중간고사, 2차 월례 시험, 기말고사. 우리 학교는 한 학기에 큰 시험이 이렇게 네 번 있어."


translate japanese plot8_75b0004a:



    voice "voice/yangxi_602.ogg"
    yangxi "来週は今学期二回目の月例テスト。だから今週末は、ライラ恒例の勉強日ってわけ。"


translate japanese plot8_d87bfa74:



    voice "voice/yangxi_603.ogg"
    yangxi "뭐, 복습이라기보다는 예습에 가깝지만."


translate japanese plot8_7f3bbbbd:



    voice "voice/yangxi_604.ogg"
    yangxi "얘 학교에서는 교과서를 거의 안 보거든. 수업 중에도 책만 책상에 펴 놓고 보는 척할 뿐이야."


translate japanese plot8_dace8e46:



    voice "voice/cygnus_1001.ogg"
    cygnus "……공부는 정말 괜찮은 거야?"


translate japanese plot8_1364cb08:



    voice "voice/yangxi_605.ogg"
    yangxi "뭐, 우등생이라고는 못 해도 제대로 공부하면 평균보다 조금 높은 점수는 받을 수 있어."


translate japanese plot8_9bafc45e:



    voice "voice/yangxi_606.ogg"
    yangxi "この二日で、どれだけ身につくか次第だね。"


translate japanese plot8_6bfbb3a5:


    tianqin 0309 "ヒナタちゃーん、そこでシノスちゃんと内緒話してないでよ！"


translate japanese plot8_f74f5ad3:



    voice "voice/tianqin_1794.ogg"
    tianqin "이리 와서 중요한 부분에 표시해 줘. 그리고 이 문제도 가르쳐 줘——!"


translate japanese plot8_32e38daf:



    voice "voice/yangxi_607.ogg"
    yangxi "하아, 일하러 가야겠네."


translate japanese plot8_8451d2ed:



    voice "voice/cygnus_1002.ogg"
    cygnus "어……너도 고생이네."


translate japanese plot8_d5e7769e:



    voice "voice/yangxi_608.ogg"
    yangxi "여기 A점에서 이쪽으로 보조선을 하나 그어 봐……"


translate japanese plot8_8648fb9e:



    voice "voice/yangxi_609.ogg"
    yangxi "이러면 문제가 훨씬 잘 보이지?"


translate japanese plot8_fb195447:



    voice "voice/tianqin_1795.ogg"
    tianqin "오~ 이렇게 푸는 거였구나."


translate japanese plot8_f7581243:


    "타닥타닥타닥타닥——"


translate japanese plot8_fc5ba30c:


    "시노스는 뒤에서 벌어지는 공부 모임에는 아랑곳하지 않고, 컴퓨터 앞에 몸을 웅크리고 앉아 키보드를 두드리기 시작했다."


translate japanese plot8_d9c532d4:


    "勉強する二人とシノスは、お互いの邪魔をしない。リビングには妙なバランスができていた。"


translate japanese plot8_d1f9f429:


    "두 시간 뒤——"


translate japanese plot8_019a0a6d:



    voice "voice/tianqin_1796.ogg"
    tianqin "よし、数学はこれでおしまい！"


translate japanese plot8_da616e71:



    voice "voice/yangxi_610.ogg"
    yangxi "벌써 좋아하지 말고, 모의고사 한 회 더 풀어 봐. 아직 모르는 부분이 있나 보게."


translate japanese plot8_c36bd41d:



    voice "voice/tianqin_1797.ogg"
    tianqin "식은 죽 먹기지, 식은 죽 먹기. 15분이면 끝나."


translate japanese plot8_f7581243_1:


    "타닥타닥타닥타닥——"


translate japanese plot8_a694a5c2:


    "두 시간이 지났지만 시노스는 여전히 컴퓨터 앞에 꼼짝 않고 앉아, 검색해서 나온 여러 영상을 무표정하게 보고 있었다."


translate japanese plot8_1accad8f:



    voice "voice/yangxi_611.ogg"
    yangxi "(평소에도 저래?)"


translate japanese plot8_e33e66e2:



    voice "voice/tianqin_1798.ogg"
    tianqin "(응?)"


translate japanese plot8_259695c3:



    voice "voice/tianqin_1799.ogg"
    tianqin "(아, 시노스 말이야? 평소에도 저래.)"


translate japanese plot8_c4933b71:



    voice "voice/yangxi_612.ogg"
    yangxi "（まるで無職の引きこもりじゃん。）"


translate japanese plot8_97bcccf7:



    voice "voice/tianqin_1800.ogg"
    tianqin "(그러게 말이야——)"


translate japanese plot8_bac3e90d:



    voice "voice/cygnus_1003.ogg"
    cygnus "저기, 다 들리거든."


translate japanese plot8_9f8bf2a1:



    voice "voice/cygnus_1004.ogg"
    cygnus "오해하지 마. 컴퓨터로 이 세계에 관한 정보를 찾고 있을 뿐이야."


translate japanese plot8_8e41e3b6:



    voice "voice/tianqin_1801.ogg"
    tianqin "그래도 계속 화면만 보고 있는 건 안 좋아. 눈에 나쁘잖아."


translate japanese plot8_d6a3c34a:



    voice "voice/cygnus_1005.ogg"
    cygnus "문제없어. 내 몸은 그 정도로 영향을 받지 않아."


translate japanese plot8_e31f6a5c:



    voice "voice/tianqin_1802.ogg"
    tianqin "으음——그래도 인터넷에만 빠져 있는 건 별로 안 좋아."


translate japanese plot8_5aeadbde:



    voice "voice/tianqin_1803.ogg"
    tianqin "시노스도 바깥세상을 좀 더 접해야지."


translate japanese plot8_772e8288:



    voice "voice/cygnus_1006.ogg"
    cygnus "(시끄러워……)"


translate japanese plot8_083ca97c:



    voice "voice/yangxi_613.ogg"
    yangxi "(네가 엄마냐.)"


translate japanese plot8_a28eab2e:



    voice "voice/tianqin_1804.ogg"
    tianqin "맞다. 마침 냉장고에 식재료가 떨어졌으니까, 시노스, 히나타랑 같이 마트 좀 다녀와 줄래?"


translate japanese plot8_9cc08c75:



    voice "voice/cygnus_1007.ogg"
    cygnus "뭐?"


translate japanese plot8_f9c34e34:



    voice "voice/yangxi_614.ogg"
    yangxi "싫어. 네가 살 건 네가 가서 사."


translate japanese plot8_f0c533f0:



    voice "voice/tianqin_1805.ogg"
    tianqin "부탁이야, 좀 도와줘! 난 여기서 다음 과목도 공부해야 하거든."


translate japanese plot8_6d0062df:



    voice "voice/tianqin_1806.ogg"
    tianqin "필요한 건 이 종이에 써 놨어. 잘못 사 오지 말고!"


translate japanese plot8_df08814d:



    voice "voice/yangxi_615.ogg"
    yangxi "안 간다니까——"


translate japanese plot8_37344216:



    voice "voice/cygnus_1008.ogg"
    cygnus "잠깐——이 영상 아직 다 못 봤어——"


translate japanese plot8_0af4795b:



    voice "voice/tianqin_1807.ogg"
    tianqin "ほらほら、遅くなったら、スーパーの新鮮な食材が売り切れちゃうよ。"


translate japanese plot8_47f2bffd:


    "쾅——"


translate japanese plot8_539868ea:


    "라이라는 두 사람의 반대를 들은 체도 않고, 괴력으로 가볍게 둘을 밖으로 몰아냈다."


translate japanese plot8_936c4298:



    voice "voice/cygnus_1009.ogg"
    cygnus "…"


translate japanese plot8_2d8b9e62:



    voice "voice/yangxi_616.ogg"
    yangxi "…"


translate japanese plot8_59c773cb:


    "ライラのお節介で、少し変わった二人組が街へ出ることになった。"


translate japanese plot8_7c3217ca:


    "마트에 가는 동안 두 사람 모두 상대와 말을 섞을 생각이 전혀 없었다."


translate japanese plot8_46f38d28:


    "라이라와는 달리, 두 사람은 말을 하지 않아도 어색하지 않았다."


translate japanese plot8_bd6ed892:


    "오히려 조용히 있을 수 있는 편이 두 사람에게는 편했다."


translate japanese plot8_12a9a9fd:



    voice "voice/cygnus_1010.ogg"
    cygnus "(그 영상 아직 다 못 봤는데……)"


translate japanese plot8_db563d77:



    voice "voice/yangxi_617.ogg"
    yangxi "(귀찮은 일만 떠넘기고……)"


translate japanese plot8_0a0a51ef:


    "두 사람 모두 라이라가 왜 갑자기 자신들을 쫓아냈는지 잘 알고 있었다."


translate japanese plot8_20629423:


    "두 사람의 경계를 풀고 조금 더 친하게 지내게 하고 싶은 모양이었다."


translate japanese plot8_b6961eea:


    "히나타는 누군가 특정한 사람과 친해지라고 하면 마음 깊은 곳에서부터 거부감이 들었다."


translate japanese plot8_cfef432d:


    "시노스가 이세계에서 왔다는 사실에는 흥미가 있었다. 하지만 시노스는 라이라처럼 말을 붙이기 편한 상대가 아니었다."


translate japanese plot8_3cbe8aa8:


    "호기심보다 마음의 벽이 더 높고 단단했다."


translate japanese plot8_a4d10477:


    "시노스 쪽은 더더욱 그랬다."


translate japanese plot8_b596b155:


    "평소라면 라이라 이외의 사람에게 먼저 말을 거는 일은 거의 없었다."


translate japanese plot8_53e8e7dc:


    "히나타가 라이라의 단짝이고, 학교에서 그날 밤을 함께 보낸 상대인데도 시노스는 여전히 경계하고 있었다."


translate japanese plot8_c89d73db:


    "히나타에게서는 자신과 같은 냄새가 난다."


translate japanese plot8_48c46be9:


    "히나타가 저쪽 세계에서 태어났다면 마녀가 되어, 언젠가 자신과 부딪쳤을지도 모른다."


translate japanese plot8_8c31bafc:


    "자석의 같은 극끼리 밀어내듯, 닮은 사람들은 서로 반발하는 것인지도 모른다."


translate japanese plot8_d49b0875:


    "마트에서 나온 두 사람은 식재료가 든 커다란 봉투를 들고, 아무 말 없이 상점가를 천천히 걸었다."


translate japanese plot8_1412bfbb:


    "이대로 아무 일도 일어나지 않는다면, 둘이 공유하는 침묵은 집에 돌아갈 때까지 이어졌을 것이다."


translate japanese plot8_6b54e44f:


    "아무 일도 일어나지 않았다면……"


translate japanese plot8_59abc6c1:


    npc36 "ねえ――そこのお二人さーん――"


translate japanese plot8_e2e6d936:


    voice "voice/gt_08.ogg"
    npc14 "——!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_9f4bdda1:


    "건물 사이 골목에서 쩌렁쩌렁한 목소리가 들려와 두 사람을 불러 세웠다."


translate japanese plot8_1a520cbb:


    voice "voice/flame_47.ogg"
    npc36 "너희 말이야. 잠깐 이리 와 줄 수 있어?"


translate japanese plot8_78e0ff28:



    voice "voice/yangxi_618.ogg"
    yangxi "누구야?"


translate japanese plot8_5d136d6a:


    voice "voice/flame_48.ogg"
    npc36 "긴장하지 마. 네 옆에 있는 사람을 한번 만나고 싶을 뿐이야."


translate japanese plot8_a0a03d10:



    voice "voice/cygnus_1011.ogg"
    cygnus "나……?"


translate japanese plot8_acaf3124:


    "히나타는 시노스에게 고개를 저었다. 위험한 속임수일지도 모른다는 뜻이었다."


translate japanese plot8_ddaa1309:



    voice "voice/cygnus_1012.ogg"
    cygnus "(으음……)"


translate japanese plot8_d757b893:


    "하지만 시노스는 골목 깊숙한 곳에서 심상치 않은 기운을 느끼고 있었다."


translate japanese plot8_43b73095:



    voice "voice/cygnus_1013.ogg"
    cygnus "(마력의 냄새가 나……)"


translate japanese plot8_2ba13e17:



    voice "voice/cygnus_1014.ogg"
    cygnus "날 만나고 싶으면 네가 나와야 하는 거 아니야?"


translate japanese plot8_921ca316:



    voice "voice/cygnus_1015.ogg"
    cygnus "왜 안에 숨어서 수상하게 굴어?"


translate japanese plot8_3aee564b:


    voice "voice/flame_49.ogg"
    npc36 "나도……좀 복잡한 사정이 있어서 그래!"


translate japanese plot8_8b2b4bf9:


    voice "voice/flame_50.ogg"
    npc36 "아무튼 잠깐 이리 와 줄 수 있을까——"


translate japanese plot8_54e2c445:


    voice "voice/flame_51.ogg"
    npc36 "——「{a=dictionary:dict_entry_81}새벽과 밤의 대마녀{/a}」."


translate japanese plot8_3678852b:



    voice "voice/cygnus_1016.ogg"
    cygnus "…!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_8b1ec772:


    "자신의 이명을 듣자마자 시노스는 망설임 없이 골목으로 들어가려 했다. 히나타가 뒤에서 황급히 붙잡았다."


translate japanese plot8_d7fdf68c:



    voice "voice/yangxi_619.ogg"
    yangxi "잠깐, 진정부터 해."


translate japanese plot8_fc07ddae:



    voice "voice/cygnus_1017.ogg"
    cygnus "진정하고 있어."


translate japanese plot8_dbd7bf5f:



    voice "voice/yangxi_620.ogg"
    yangxi "전혀 아니거든."


translate japanese plot8_b35acfa5:



    voice "voice/yangxi_621.ogg"
    yangxi "먼저 라이라를 부르는 게 좋겠어. 혹시 상대가……"


translate japanese plot8_23413c30:


    voice "voice/flame_52.ogg"
    npc36 "아이, 걱정하지 마. 너희를 해치지 않아. 내 이명을 걸고 맹세할게."


translate japanese plot8_896de43b:


    voice "voice/flame_53.ogg"
    npc36 "그러니까 둘이 함께 이리 와 줄래?"


translate japanese plot8_3c00095b:


    voice "voice/flame_54.ogg"
    npc36 "한 사람만 밖에 남았다가 여기가 들통나면 곤란하거든."


translate japanese plot8_b78b0791:


    voice "voice/flame_55.ogg"
    npc36 "그리고 말이야, 오래 기다려 줄 수는 없어."


translate japanese plot8_936c4298_1:



    voice "voice/cygnus_1018.ogg"
    cygnus "…"


translate japanese plot8_7eb9438c:



    voice "voice/cygnus_1019.ogg"
    cygnus "들어가자."


translate japanese plot8_6b711b4f:



    voice "voice/yangxi_622.ogg"
    yangxi "하지만…"


translate japanese plot8_cb8f3af3:



    voice "voice/cygnus_1020.ogg"
    cygnus "괜찮아. 위험해지면 전력을 다해서 널 데리고 나갈게."


translate japanese plot8_9ef8efdd:



    voice "voice/cygnus_1021.ogg"
    cygnus "그때는 라이라를 부르러 가."


translate japanese plot8_9a165000:



    voice "voice/yangxi_623.ogg"
    yangxi "……알았어."


translate japanese plot8_16fb7bbc:



    voice "voice/yangxi_624.ogg"
    yangxi "으악……왜 이렇게 어두워?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_c61a6bbd:


    "골목으로 접어들자, 히나타는 이유도 모른 채 눈앞이 갑자기 캄캄해지는 것을 느꼈다."


translate japanese plot8_5f57a8f1:


    "마치 햇빛이 이 골목에는 닿지 않는 것처럼, 한밤중에 있는 듯한 착각이 들었다."


translate japanese plot8_e45b03ce:



    voice "voice/cygnus_1022.ogg"
    cygnus "으음……"


translate japanese plot8_dfa9cf01:


    "시노스도 같은 것을 느꼈다. 그녀의 머릿속에 비슷한 효과를 내는 마법 몇 가지가 즉시 떠올랐다."


translate japanese plot8_8c0f8e1c:


    "하지만 물러서지는 않았다. 여기서는 위험한 기운이 느껴지지 않았기 때문이다."


translate japanese plot8_75317feb:


    "어둠에 눈이 조금 익고 나서야 두 사람은 주변을 알아볼 수 있었다."


translate japanese plot8_e8acaa49:


    "골목 끝에 누군가가 쪼그려 앉아, 분필을 들고 바닥에 무언가를 그리고 있었다."


translate japanese plot8_ba0d5f8c:


    voice "voice/flame_56.ogg"
    npc37 "아——미안, 미안. 내 쪽으로 조금만 더 와 줄 수 있어?"


translate japanese plot8_996f722b:


    voice "voice/gt_09.ogg"
    npc14 "…"


translate japanese plot8_355fcc27:


    "그 말을 듣고 두 사람은 앞으로 한 발짝 다가갔다."


translate japanese plot8_dea3b396:


    voice "voice/flame_57.ogg"
    npc37 "아, 그래그래. 거기면 돼."


translate japanese plot8_f1143d27:


    voice "voice/flame_58.ogg"
    npc37 "아직 걱정되면 거기 서 있어도 괜찮아."


translate japanese plot8_0bc9636b:



    voice "voice/yangxi_625.ogg"
    yangxi "응? 바닥에 그린 건 뭐야?"


translate japanese plot8_d42bbadd:



    voice "voice/cygnus_1023.ogg"
    cygnus "걱정하지 마. 다른 사람들이 자연스럽게 이곳을 피하게 하는 {a=dictionary:dict_entry_83}결계 마법{/a}이야."


translate japanese plot8_b70031f0:



    voice "voice/cygnus_1024.ogg"
    cygnus "이 어둠도 결계가 빛을 왜곡해서 생기는 거야."


translate japanese plot8_39224bf5:


    voice "voice/flame_59.ogg"
    npc37 "역시 대마녀네. 단번에 알아보다니."


translate japanese plot8_f27eca4b:



    voice "voice/cygnus_1025.ogg"
    cygnus "……아부는 됐어. 용건이나 말해."


translate japanese plot8_db3a271e:


    voice "voice/flame_60.ogg"
    npc37 "아이, 서두르지 마."


translate japanese plot8_23f6a4de:


    voice "voice/flame_61.ogg"
    npc37 "먼저 결계를 완전히 가동해 두자. 그편이 안심되니까."


translate japanese plot8_6ce99535:


    "상대가 손을 흔들자, 땅에 그려진 복잡한 도형이 은은하게 빛났다."


translate japanese plot8_e09c6cd3:


    "마법진의 중심에서 무언가가 퍼져 나와 그 자리에 있는 세 사람을 감싸기 시작했다."


translate japanese plot8_d3251009:


    npc37 "ごめんなさいね～、こんな慌ただしい会い方しかできなくて。"


translate japanese plot8_5f139d69:



    voice "voice/cygnus_1026.ogg"
    cygnus "본론부터 말해. 넌 누구야?"


translate japanese plot8_0a0bffdc:


    voice "voice/flame_63.ogg"
    npc37 "으음, 나도 딱딱한 인사는 좋아하지 않거든."


translate japanese plot8_de9e8c16:


    voice "voice/flame_64.ogg"
    npc37 "내 마력에도 한계가 있으니까. 이 결계는 오래 못 버텨."


translate japanese plot8_010cf238:


    voice "voice/flame_65.ogg"
    npc37 "일단 자기소개부터 할게."


translate japanese plot8_0156fb20:



    voice "voice/flame_66.ogg"
    ataset "난 「화염무의 마녀」야. 그냥 「화염무」라고 불러."


translate japanese plot8_493338e9:



    voice "voice/cygnus_1027.ogg"
    cygnus "계속 여기서 날 기다린 거야?"


translate japanese plot8_29d8f6ab:



    voice "voice/flame_67.ogg"
    ataset "그럴 리가. 우연히 마주쳐서 불렀을 뿐이야."


translate japanese plot8_d25f12fc:



    voice "voice/flame_68.ogg"
    ataset "널 찾은 건 저쪽에서 누가 전해 달라는 말이 있어서야. 크흠——"


translate japanese plot8_b4abc234:



    voice "voice/flame_69.ogg"
    ataset "다음 「순」의 넷째 날 아침. 반드시■■■."


translate japanese plot8_a85a3de2:



    voice "voice/flame_70.ogg"
    ataset "그다음 ■■■■■, ■■ 때, ■■■■■■."


translate japanese plot8_4eef398b:



    voice "voice/cygnus_1028.ogg"
    cygnus "이건……"


translate japanese plot8_abe40414:



    voice "voice/yangxi_626.ogg"
    yangxi "(……무슨 말을 하는 거야?)"


translate japanese plot8_173dd1c7:


    "눈앞의 마녀가 하는 말이 갑자기 알아들을 수 없게 변했다."


translate japanese plot8_e3ec698d:


    "목에서는 분명 소리가 나오고 있었지만, 히나타도 시노스도 무슨 말인지 구분할 수 없었다."


translate japanese plot8_092ad4e6:



    voice "voice/flame_71.ogg"
    ataset "아, 정말! 역시 제대로 말로 옮길 수가 없나."


translate japanese plot8_7466ddc3:



    voice "voice/cygnus_1029.ogg"
    cygnus "{a=dictionary:dict_entry_84}별 읽기{/a}야?"


translate japanese plot8_00ed1be4:



    voice "voice/flame_72.ogg"
    ataset "응. 그것도 가장 높은 단계의——"


translate japanese plot8_f224ab00:



    voice "voice/flame_73.ogg"
    ataset "今の私の力じゃ、「長老」の伝言を伝えられないんだ…"


translate japanese plot8_25c9b8ba:



    voice "voice/flame_74.ogg"
    ataset "嫌だよ。頭では意味が分かっているのに、どうしても口に\n出せないなんて――"


translate japanese plot8_7eda8011:



    voice "voice/flame_75.ogg"
    ataset "젠장, 한 번 더 해석해 볼게!"


translate japanese plot8_19e01461:



    voice "voice/cygnus_1030.ogg"
    cygnus "(어쩐지 누구랑 좀 닮았는데……)"


translate japanese plot8_1994964c:



    voice "voice/yangxi_627.ogg"
    yangxi "(얘도 라이라 같은 부류구나……)"


translate japanese plot8_8b85df7a:



    voice "voice/flame_76.ogg"
    ataset "크흠——!"


translate japanese plot8_b6978637:



    voice "voice/flame_77.ogg"
    ataset "次旬、四日目の朝！　必ず――■■■■■！！" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_a939c75c:



    voice "voice/flame_78.ogg"
    ataset "か・な・ら・ず――■■！" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_12179c6e:



    voice "voice/flame_79.ogg"
    ataset "■■■！　■■■■…――備えておけ。" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_885107c0:


    "하얀 마녀는 띄엄띄엄 말을 쥐어짜 냈다. 머릿속에 떠오른 것을 전하려고 온 힘을 다하고 있었다."


translate japanese plot8_52116526:



    voice "voice/flame_80.ogg"
    ataset "아, 더는 못 하겠어. 내 힘으로 해독할 수 있는 건 여기까지야."


translate japanese plot8_9e2d0dee:



    voice "voice/cygnus_1031.ogg"
    cygnus "왜 이런 걸 알려 주는 거야?"


translate japanese plot8_4030c3b8:



    voice "voice/flame_81.ogg"
    ataset "장로가 이 별 읽기를 너에게 전하라고 했어."


translate japanese plot8_0e54fdd6:



    voice "voice/cygnus_1032.ogg"
    cygnus "「장로」?"


translate japanese plot8_821dcf1c:



    voice "voice/flame_82.ogg"
    ataset "あららっ――それすら忘れたんだ。長老の読みは本当に当たってたんだね。"


translate japanese plot8_b78f34ac:



    voice "voice/flame_83.ogg"
    ataset "네 오랜 친구야. 나를 이 세계로 인도한 것도 그 사람이야."


translate japanese plot8_936c4298_2:



    voice "voice/cygnus_1033.ogg"
    cygnus "…"


translate japanese plot8_cdc43b4c:


    "눈앞의 마녀가 말하는 「오랜 친구」가 누군지 시노스는 전혀 짐작할 수 없었다."


translate japanese plot8_2118ecef:



    voice "voice/cygnus_1034.ogg"
    cygnus "그 밖에 뭘 알고 있지?"


translate japanese plot8_80f957a5:



    voice "voice/flame_84.ogg"
    ataset "없어. 장로도 내게 많은 걸 알려 주진 않았거든."


translate japanese plot8_e45b03ce_1:



    voice "voice/cygnus_1035.ogg"
    cygnus "으음……"


translate japanese plot8_fe87e9fd:



    voice "voice/flame_85.ogg"
    ataset "정말이야! 지금 날 묶어 놓고 이상한 마법으로 입을 열게 해도, 알아낼 건 없을 거야."


translate japanese plot8_6bef0a54:



    voice "voice/flame_86.ogg"
    ataset "하지만 분명히 말할 수 있는 건, 난 네 적이 아니라는 거야……적어도 지금은."


translate japanese plot8_f8f0ce56:



    voice "voice/flame_87.ogg"
    ataset "力を取り戻すまでは、できるだけ生き延びてほしい。"


translate japanese plot8_77430ce6:



    voice "voice/cygnus_1036.ogg"
    cygnus "너……내 마도구를 노리는 거야……?"


translate japanese plot8_ffc1448a:



    voice "voice/flame_88.ogg"
    ataset "으음——그렇다고 할 수도 있지만, 꼭 그런 것만도 아니야."


translate japanese plot8_25340402:



    voice "voice/cygnus_1037.ogg"
    cygnus "그래. 그렇다면……"


translate japanese plot8_d08e55af:



    voice "voice/cygnus_1038.ogg"
    cygnus "역시 적이잖아." with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_6a69b96a:



    voice "voice/flame_89.ogg"
    ataset "잠깐, 잠깐!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_8b0b4fc9:



    voice "voice/flame_90.ogg"
    ataset "방금 말했잖아! 네 적이 아니라니까!"


translate japanese plot8_d9fe3b9e:



    voice "voice/cygnus_1039.ogg"
    cygnus "「지금은」이라고 했을 뿐이지. 언젠가는 내 앞을 가로막는 거 아니야?"


translate japanese plot8_f4eb45dc:



    voice "voice/flame_91.ogg"
    ataset "……그럴 수도 있지만, 꼭 그렇게 된다는 법은 없지."


translate japanese plot8_6074b266:



    voice "voice/flame_92.ogg"
    ataset "さっきも言った通り、私は長老の導きに従って動いているの。"


translate japanese plot8_1ad3a2a1:



    voice "voice/flame_93.ogg"
    ataset "네가 마도구를 되찾고 나면 어떤 변화가 생길지 보고 싶어."


translate japanese plot8_fe9b2843:



    voice "voice/flame_94.ogg"
    ataset "그때가 되면 결정할 거야. 널 도울지, 아니면……"


translate japanese plot8_deb301b2:



    voice "voice/flame_95.ogg"
    ataset "죽일지."


translate japanese plot8_ebe60049:



    voice "voice/cygnus_1040.ogg"
    cygnus "……영문을 모르겠네. 그게 목적이라면 내 앞에 나타나면 안 됐을 텐데."


translate japanese plot8_4817f4d5:



    voice "voice/flame_96.ogg"
    ataset "으음~ 물론 알고 있어."


translate japanese plot8_eb53d2f2:



    voice "voice/flame_97.ogg"
    ataset "네가 힘을 되찾으면 나한테는 훨씬 까다로워지겠지."


translate japanese plot8_78ff4c6d:



    voice "voice/flame_98.ogg"
    ataset "하지만 그래도 당분간은 지켜볼 생각이야."


translate japanese plot8_b96ab391:



    voice "voice/flame_99.ogg"
    ataset "그게 장로의 뜻이기도 하고."


translate japanese plot8_936c4298_3:



    voice "voice/cygnus_1041.ogg"
    cygnus "…"


translate japanese plot8_74e5f891:


    "알 수 없었다."


translate japanese plot8_9a47f258:


    "시노스는 눈앞의 마녀가 무슨 생각을 하는지 알아내려 했다. 하지만 전혀 알 수 없었다."


translate japanese plot8_e685fcde:


    "마녀끼리는 크든 작든 힘을 겨루는 법이다. 특히 「지금」 같은 상황에서는."


translate japanese plot8_edfa006a:


    "상대가 무슨 말을 하든, 오랫동안 몸에 밴 사고방식 때문에 아무래도 그녀를 적으로 보게 된다."


translate japanese plot8_a9dcd0b8:


    "그런데……무의식중에는 어째서인지 상대를 유난히 신뢰하고 있었다."


translate japanese plot8_701d83c1:


    "지금 시노스는 자신의 본능과 마음속 깊은 곳에서 솟는 신뢰 사이에서 흔들리고 있었다."


translate japanese plot8_a58374bb:



    voice "voice/flame_100.ogg"
    ataset "아사요. 지금 너한테는 마력이 그리 많이 남아 있지 않은 것 같은데?"


translate japanese plot8_0a26409c:



    voice "voice/flame_101.ogg"
    ataset "마나가 전혀 없는 이 세계에서, 날 상대하느라 마력을 낭비할 필요는 없어."


translate japanese plot8_6f6f54cc:



    voice "voice/flame_102.ogg"
    ataset "게다가 지금 내가 너보다 약할 거라고 생각하지도 않고?"


translate japanese plot8_4a6253a4:



    voice "voice/flame_103.ogg"
    ataset "——그리고 나한테는 아주 강한 동료도 있거든."


translate japanese plot8_9cc08c75_1:



    voice "voice/cygnus_1042.ogg"
    cygnus "뭐?"


translate japanese plot8_b57bb634:



    voice "voice/flame_104.ogg"
    ataset "그 동료는 나보다 네 힘을 훨씬 잘 알아……"


translate japanese plot8_f25fdf96:



    voice "voice/flame_105.ogg"
    ataset "너희 사이에 무슨 일이 있었는지는 모르겠지만, 너한테 강한 집착을 보이더라."


translate japanese plot8_349a27d8:



    voice "voice/flame_106.ogg"
    ataset "네가 나를 상대하느라 마력을 소모하면, 그 애는 좋아 죽겠지?"


translate japanese plot8_f8b74d96:



    voice "voice/cygnus_1043.ogg"
    cygnus "……왜 그런 말을 해 주는 거야? 너희 동료 아니야?"


translate japanese plot8_2c03b937:



    voice "voice/flame_107.ogg"
    ataset "……정말 철저하게 기억을 잃었구나."


translate japanese plot8_eb8d5d8a:



    voice "voice/cygnus_1044.ogg"
    cygnus "너하고 나는 예전에……어떤 사이였어?"


translate japanese plot8_9d73b63a:



    voice "voice/flame_108.ogg"
    ataset "글쎄~"


translate japanese plot8_48ef4d52:



    voice "voice/flame_109.ogg"
    ataset "난 그냥 네가 기억을 잃은 게 꼭 나쁜 일만은 아니라고 생각해."


translate japanese plot8_d24379fa:



    voice "voice/flame_110.ogg"
    ataset "백지가 된 「네」가 앞으로의 길을 선택하면 돼."


translate japanese plot8_9a518cfc:



    voice "voice/cygnus_1045.ogg"
    cygnus "나는……"


translate japanese plot8_fddb63b7:



    voice "voice/npc23_03.ogg"
    npc23 "이 배신자……"


translate japanese plot8_7756d2df:



    voice "voice/cygnus_1046.ogg"
    cygnus "설마 너……"


translate japanese plot8_09440f99:



    voice "voice/flame_111.ogg"
    ataset "さて、話せるのはここまで。そろそろ時間だ。"


translate japanese plot8_2241762e:



    voice "voice/flame_112.ogg"
    ataset "앞으로 일어날 일에 빈틈없이 대비해 둬, 아사요."


translate japanese plot8_f662f8ce:



    voice "voice/cygnus_1047.ogg"
    cygnus "자, 잠깐! 아직 물어볼 게……"


translate japanese plot8_7dd8c3f0:



    voice "voice/flame_113.ogg"
    ataset "다음에 만날 때는 날 모르는 척해 줘."


translate japanese plot8_a9935dde:



    voice "voice/flame_114.ogg"
    ataset "그럼, 안녕~."


translate japanese plot8_d144aebc:



    voice "voice/cygnus_1048.ogg"
    cygnus "야!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_4f747790:



    voice "voice/yangxi_628.ogg"
    yangxi "윽……!"


translate japanese plot8_a7d6e6fe:


    "어두운 골목에 갑자기 환한 불꽃이 터져 나왔다. 눈부신 빛에 시노스와 히나타는 눈을 감을 수밖에 없었다."


translate japanese plot8_fe84a187:


    "다시 눈을 떴을 때, 하얀 마녀는 이미 사라지고 없었다."


translate japanese plot8_b080083c:



    voice "voice/yangxi_629.ogg"
    yangxi "사라졌어?"


translate japanese plot8_2903b001:



    voice "voice/cygnus_1049.ogg"
    cygnus "전이 마법인가……"


translate japanese plot8_264ba6e1:



    voice "voice/yangxi_630.ogg"
    yangxi "어떡할 거야? 쫓아갈 거야?"


translate japanese plot8_efa1460e:



    voice "voice/cygnus_1050.ogg"
    cygnus "아니, 지금 나한테는 그럴 능력이 없어……"


translate japanese plot8_1627ca39:



    voice "voice/yangxi_631.ogg"
    yangxi "그럼 이제……?"


translate japanese plot8_51fa008c:



    voice "voice/cygnus_1051.ogg"
    cygnus "……라이라가 부탁한 물건부터 집에 가져다주자."


translate japanese plot8_b9ebe474:



    voice "voice/tianqin_1808.ogg"
    tianqin "뭐——!? 다른 마녀를 만났다고?"


translate japanese plot8_0e360109:



    voice "voice/cygnus_1052.ogg"
    cygnus "응. 「화염무」의 마녀라고 하더군……"


translate japanese plot8_8d79cb4d:



    voice "voice/yangxi_632.ogg"
    yangxi "몸에서 불이 나오는, 너 같은 여장부였어."


translate japanese plot8_82b88027:



    voice "voice/tianqin_1809.ogg"
    tianqin "나 같다고?"


translate japanese plot8_89351c9f:



    voice "voice/yangxi_633.ogg"
    yangxi "너 같은 바보."


translate japanese plot8_09987b09:



    voice "voice/tianqin_1810.ogg"
    tianqin "아, 좀! 중요한 얘기 할 때는 놀리지 마!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_48c43b80:



    voice "voice/tianqin_1811.ogg"
    tianqin "둘 다 괜찮아? 악의가 있는 건 아니었어?"


translate japanese plot8_3a9fc8d5:



    voice "voice/cygnus_1053.ogg"
    cygnus "별다른 일은 없었어. 뭔가 전하려고 날 불러 세운 모양이야……"


translate japanese plot8_bda48a74:


    "시노스는 방금 있었던 일을 라이라에게 이야기했다."


translate japanese plot8_cdfaeff9:



    voice "voice/tianqin_1812.ogg"
    tianqin "어——? 다음 순의 넷째 날……?"


translate japanese plot8_547ba563:



    voice "voice/tianqin_1813.ogg"
    tianqin "그게 무슨 뜻이야?"


translate japanese plot8_c498a734:



    voice "voice/cygnus_1054.ogg"
    cygnus "아마……「다음 주 목요일」이라는 뜻일 거야."


translate japanese plot8_7476388d:



    voice "voice/cygnus_1055.ogg"
    cygnus "저쪽 세계에서는 한 달을 세 개의 {a=dictionary:dict_entry_85}「순」{/a}으로 나눴어."


translate japanese plot8_96e97bfd:



    voice "voice/cygnus_1056.ogg"
    cygnus "그 애의 감각을 이쪽에 대입하면, 이 세계의 「주」에 해당할 거야."


translate japanese plot8_aecc7346:



    voice "voice/tianqin_1814.ogg"
    tianqin "오~ 신기하다——"


translate japanese plot8_7c32f302:



    voice "voice/tianqin_1815.ogg"
    tianqin "그러니까 다음 주 목요일에 무슨 일이 생길 거라고 알려 주러 온 거네?"


translate japanese plot8_2278af6c:



    voice "voice/cygnus_1057.ogg"
    cygnus "말하는 걸로 봐서는 그래."


translate japanese plot8_39f45858:



    voice "voice/cygnus_1058.ogg"
    cygnus "내 친구에게서 별 읽기를 전해 달라는 부탁을 받았대. 하지만 그 내용을 정확히 말로 옮기지는 못했어."


translate japanese plot8_93346226:



    voice "voice/cygnus_1059.ogg"
    cygnus "별 읽기를 전문으로 하는 마녀는 드물거든……"


translate japanese plot8_b69544c9:



    voice "voice/tianqin_1816.ogg"
    tianqin "잠깐. 그 「별 읽기」라는 게 뭐야?"


translate japanese plot8_69b4cfad:



    voice "voice/cygnus_1060.ogg"
    cygnus "「별 읽기」는 별의 움직임에서 무언가를 읽어 내고, 미래에 관한 말로 풀어내는 거야."


translate japanese plot8_d203a418:



    voice "voice/cygnus_1061.ogg"
    cygnus "별 읽기 학파의 마법사는 높은 단계의 별 읽기에서 미래를 알아낼 수도 있대……그것도 소문일 뿐이지만."


translate japanese plot8_2758bcd6:



    voice "voice/tianqin_1817.ogg"
    tianqin "되게 멋있다!"


translate japanese plot8_53801459:



    voice "voice/yangxi_634.ogg"
    yangxi "그냥 점치는 거 아니야?"


translate japanese plot8_a4d7bc29:



    voice "voice/cygnus_1062.ogg"
    cygnus "정확한 설명은 아니지만, 그렇게 이해해도 돼."


translate japanese plot8_ca445f5d:



    voice "voice/cygnus_1063.ogg"
    cygnus "결국 알아낼 수 있는 건 「미래에 대한 조언」 정도야."


translate japanese plot8_64732dff:



    voice "voice/cygnus_1064.ogg"
    cygnus "게다가 별 읽기를 전해 받아도 별에 관한 지식이 없으면 그 내용을 해독하거나 다른 사람에게 전달할 수도 없어."


translate japanese plot8_5c9f87f7:



    voice "voice/cygnus_1065.ogg"
    cygnus "아까가 바로 그런 경우였어."


translate japanese plot8_b4abc234_1:



    voice "voice/flame_115.ogg"
    ataset "다음 「순」의 넷째 날 아침. 반드시■■■."


translate japanese plot8_a85a3de2_1:



    voice "voice/flame_116.ogg"
    ataset "그다음 ■■■■■, ■■ 때, ■■■■■■."


translate japanese plot8_b7eda11d:



    voice "voice/cygnus_1066.ogg"
    cygnus "별 읽기에 담긴 내용을 알아도, 우리에게 말해 줄 수는 없는 거지."


translate japanese plot8_e3144883:



    voice "voice/yangxi_635.ogg"
    yangxi "그 「별 읽기」라는 거, 무녀의 신탁이랑 별로 다를 게 없지 않아?"


translate japanese plot8_b0eaa983:



    voice "voice/tianqin_1818.ogg"
    tianqin "시노스네 세계에는 진짜 마법이 있으니까, 수상쩍은 점보다는 믿을 만하지 않을까?"


translate japanese plot8_ef1bf276:



    voice "voice/cygnus_1067.ogg"
    cygnus "어쨌든 그 알 수 없는 여자는 무슨 목적이 있어서 내게 빚을 지우러 온 모양이야."


translate japanese plot8_25b059d1:



    voice "voice/cygnus_1068.ogg"
    cygnus "하지만 그 태도로 봐서는……저쪽 세계에서 나를 알았던 건 확실해. 사이도 그리 나쁘지 않았을 거야."


translate japanese plot8_6f1833aa:



    voice "voice/cygnus_1069.ogg"
    cygnus "그런 얘기를 들었으니, 나도 제대로 준비해 둬야겠어."


translate japanese plot8_febbb3ef:



    voice "voice/tianqin_1819.ogg"
    tianqin "나도 도울게. 그날 수업은 빼먹으면 되지."


translate japanese plot8_c490d9b6:



    voice "voice/yangxi_636.ogg"
    yangxi "바보야, 목요일은 월례 시험이잖아. 유급하고 싶어?"


translate japanese plot8_dac1b6db:



    voice "voice/tianqin_1820.ogg"
    tianqin "아, 그러네!"


translate japanese plot8_037619ae:



    voice "voice/cygnus_1070.ogg"
    cygnus "まだ時間はある。私一人でも対処できるはずだ。"


translate japanese plot8_9b4fb1bf:



    voice "voice/cygnus_1071.ogg"
    cygnus "그때까지 마력을 모으고, 미리 술식을 준비해 두면 큰 문제는 안 될 거야."


translate japanese plot8_0125d0e8:



    voice "voice/cygnus_1072.ogg"
    cygnus "어쨌든 여긴 마나가 없는 세계야. 다른 마녀라도 그 제약은 똑같이 받을 거야."


translate japanese plot8_5b1cbb5f:



    voice "voice/tianqin_1821.ogg"
    tianqin "으음——무리하지 마, 알았지?"


translate japanese plot8_8713faf1:



    voice "voice/tianqin_1822.ogg"
    tianqin "도움이 필요하면 휴대폰으로 연락해."


translate japanese plot8_acca7180:



    voice "voice/cygnus_1073.ogg"
    cygnus "응, 그럴게."


translate japanese plot8_1188cca2:


    "꼬르르르르——"


translate japanese plot8_8e892d9a:



    voice "voice/tianqin_1823.ogg"
    tianqin "あはは、ごめん。二人が買い物から戻るのを待ってたら、お腹空いちゃって。"


translate japanese plot8_ccbd8068:



    voice "voice/tianqin_1824.ogg"
    tianqin "점심은 어떻게 할까? 히나타, 나가서 먹을래?"


translate japanese plot8_e617de01:



    voice "voice/yangxi_637.ogg"
    yangxi "뭐? 내가 마트에서 그렇게 큰 식재료 봉투를 들어다 줬는데, 이제 와서 밖에서 먹자고?" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_d2f502df:



    voice "voice/yangxi_638.ogg"
    yangxi "今日ちゃんとごちそうを作ってくれないなら、もう二度と勉強は見ないから。"


translate japanese plot8_c4e36b2a:



    voice "voice/tianqin_1825.ogg"
    tianqin "알았어, 알았어. 그냥 네 의견도 들어 보려고 한 거야~"


translate japanese plot8_2e2276fd:



    voice "voice/flame_117.ogg"
    ataset "나~ 왔어."


translate japanese plot8_2aaf016e:



    voice "voice/hunter_58.ogg"
    monolith "또 어디 갔다 왔어?"


translate japanese plot8_c3c8003c:



    voice "voice/flame_118.ogg"
    ataset "응? 점심 먹으러 갔지."


translate japanese plot8_2a1a67e2:



    voice "voice/flame_119.ogg"
    ataset "그 카레집에 사람이 엄청 많아서, 한참 줄 서서 기다린 뒤에야 먹었다니까."


translate japanese plot8_7c4cb46c:



    voice "voice/hunter_59.ogg"
    monolith "……아무 데나 돌아다니지 마. 남들 눈에 띄면 곤란해."


translate japanese plot8_2b3e415d:



    voice "voice/flame_120.ogg"
    ataset "알았어, 알았어."


translate japanese plot8_fa1cc6bd:



    voice "voice/hunter_60.ogg"
    monolith "밥은 배달시켜 먹으면 되잖아."


translate japanese plot8_32d505a2:



    voice "voice/flame_121.ogg"
    ataset "질렸단 말이야~"


translate japanese plot8_2c5b2860:



    voice "voice/flame_122.ogg"
    ataset "여기 온 지 거의 2주가 됐는데, 맨날 햇빛도 안 드는 이 작은 방에 틀어박혀 배달 음식만 먹었잖아?"


translate japanese plot8_5e1564e9:



    voice "voice/hunter_61.ogg"
    monolith "불평은 그만해."


translate japanese plot8_a10edb62:



    voice "voice/hunter_62.ogg"
    monolith "일은 끝냈어?"


translate japanese plot8_8ec3c14d:



    voice "voice/flame_123.ogg"
    ataset "응, 다 끝냈어."


translate japanese plot8_bf3754bc:



    voice "voice/flame_124.ogg"
    ataset "이제 다음 순의 넷째 날까지 기다리면 돼."


translate japanese plot8_e938d9d3:



    voice "voice/hunter_63.ogg"
    monolith "이 세계에서는 「순」이 아니라 7일 단위인 「주」를 써."


translate japanese plot8_a19d4de4:



    voice "voice/flame_125.ogg"
    ataset "아——아직 머릿속에서 안 바뀌었네."


translate japanese plot8_5a1962af:



    voice "voice/flame_126.ogg"
    ataset "7일이 한 주기라니……왜 이렇게 이상하게 나누는 거야?"


translate japanese plot8_c2f30325:



    voice "voice/flame_127.ogg"
    ataset "게다가 달마다 길이도 조금씩 다르잖아. 이 세계 달력은 참 이상해."


translate japanese plot8_3f9dfdaf:



    voice "voice/hunter_64.ogg"
    monolith "「과학」의 하나라고 생각해 둬."


translate japanese plot8_2f37e2c8:



    voice "voice/flame_128.ogg"
    ataset "이것도 과학이구나……"


translate japanese plot8_6a0f79b5:



    voice "voice/hunter_65.ogg"
    monolith "……쓸데없는 말은 안 했겠지?"


translate japanese plot8_7345be0b:



    voice "voice/flame_129.ogg"
    ataset "안 했어, 안 했어. 그냥 덫만 놓고 왔지."


translate japanese plot8_8a3d26e2:



    voice "voice/hunter_66.ogg"
    monolith "——내가 모르는 틈에 쓸데없는 짓 할 생각은 마."


translate japanese plot8_fa823dc4:



    voice "voice/flame_130.ogg"
    ataset "알았어. 그렇게 의심하지 마."


translate japanese plot8_e26dff53:



    voice "voice/flame_131.ogg"
    ataset "우리가 함께한 세월이 얼마인데."


translate japanese plot8_cbec7ced:



    voice "voice/hunter_67.ogg"
    monolith "그걸 알고 있다면 됐어."


translate japanese plot8_fdf7d4f9:



    voice "voice/flame_132.ogg"
    ataset "(으음~ 낯익은 얼굴을 또 만나게 될 줄은 몰랐네——)"


translate japanese plot8_75650fa8:



    voice "voice/flame_133.ogg"
    ataset "(우연인가?　아니……저건 인형일까……)"


translate japanese plot8_3fa68aad:



    voice "voice/flame_134.ogg"
    ataset "(아, 몰라! 내가 할 수 있는 건 여기까지야.)"


translate japanese plot8_36df7eb7:



    voice "voice/flame_135.ogg"
    ataset "(이제 네 선택에 달렸어, 아사요.)"


translate japanese plot8_0af32278:


    "시간은 어느새 오후가 되었다."


translate japanese plot8_378bae77:



    voice "voice/tianqin_1826.ogg"
    tianqin "이러면……생물도 끝났어!"


translate japanese plot8_7e7ac55c:



    voice "voice/yangxi_639.ogg"
    yangxi "으으……"


translate japanese plot8_031ba266:


    "과목별 교과서와 문제집, 시험지가 탁자에 몇 겹씩 쌓여 있었다. 탁자에는 라이라가 문제를 푸는 자리만 겨우 비어 있었다."


translate japanese plot8_0cf8413f:


    "라이라는 아침부터 쉬지 않고 문제를 풀었고, 옆에 앉은 히나타는 답을 맞춰 보고 설명을 해 주면서 자기 복습도 하고 있었다."


translate japanese plot8_e2dcf46f:


    "두 사람 다 수업을 자주 빼먹지만, 히나타는 평소에도 공부를 제대로 한다. 반면 라이라는 완전히 밑바닥부터 「복습」을 시작하고 있었다."


translate japanese plot8_266c5418:


    "그녀는 이 짧은 주말 동안 다른 사람들의 한 달 치 진도를 따라잡아야 했다."


translate japanese plot8_426c6bd7:



    voice "voice/tianqin_1827.ogg"
    tianqin "남은 건 과학이랑 세계어, 역사인가……"


translate japanese plot8_2346a993:



    voice "voice/yangxi_640.ogg"
    yangxi "안 되겠다……머리가 좀 어지러워."


translate japanese plot8_3a61fb46:



    voice "voice/tianqin_1828.ogg"
    tianqin "좀 쉬고 와. 난 세계어 문제부터 풀게."


translate japanese plot8_6b0d1344:



    voice "voice/yangxi_641.ogg"
    yangxi "그래."


translate japanese plot8_e330d62f:



    voice "voice/cygnus_1074.ogg"
    cygnus "한 달 치를 이틀 만에 외우는 게 그렇게 힘들면, 평소에 주말 몇 번에 나눠서 공부하면 되잖아."


translate japanese plot8_cc9700f6:



    voice "voice/tianqin_1829.ogg"
    tianqin "후후, 잘 모르는구나, 시노스."


translate japanese plot8_9cc08c75_2:



    voice "voice/cygnus_1075.ogg"
    cygnus "뭐?"


translate japanese plot8_c069abfa:



    voice "voice/tianqin_1830.ogg"
    tianqin "인간은 말이지, 마감이 코앞에 닥쳐야 비로소 평소의 몇 배나 되는 힘을 낼 수 있는 거야."


translate japanese plot8_40bf7ed3:



    voice "voice/tianqin_1831.ogg"
    tianqin "공부 시간을 한계까지 줄여서 시험 직전의 마지막 주말에 전부 몰아 복습하는 거야. 이게 바로 공부법의 왕도라고!"


translate japanese plot8_8dc1ed98:



    voice "voice/cygnus_1076.ogg"
    cygnus "……이해할 수가 없어."


translate japanese plot8_5d6f7399:



    voice "voice/yangxi_642.ogg"
    yangxi "후……"


translate japanese plot8_571a0ec3:


    "방 안을 채운 공부 분위기에 머리가 지끈해진 히나타는, 기분을 풀려고 베란다로 나가 신선한 공기를 마셨다."


translate japanese plot8_89144386:


    "재미로 책을 읽어도 몇 시간씩 계속 읽다 보면 집중력이 흐트러지는 법이다. 하물며 공부는 무척 피곤한 일이었다."


translate japanese plot8_8d8373e0:


    "하지만 라이라는 전혀 그런 기색이 없었다. 오히려 이제 막 발동이 걸렸다고 해도 될 정도였다."


translate japanese plot8_d8fdb5ad:



    voice "voice/yangxi_643.ogg"
    yangxi "(얘는 정말 공부할 머리는 좋은데, 공부를 싫어해서 탈이야.)"


translate japanese plot8_8f25dda6:



    voice "voice/yangxi_644.ogg"
    yangxi "(나도 그런 말 할 자격은 없지만.)"


translate japanese plot8_2858bc32:



    voice "voice/yangxi_645.ogg"
    yangxi "아아——피곤해——"


translate japanese plot8_936c4298_4:



    voice "voice/cygnus_1077.ogg"
    cygnus "…"


translate japanese plot8_3288d604:



    voice "voice/yangxi_646.ogg"
    yangxi "왜? 너도 쉬러 왔어?"


translate japanese plot8_84b105ae:



    voice "voice/cygnus_1078.ogg"
    cygnus "응."


translate japanese plot8_b1d445db:


    "「저런 상태」의 라이라와 같은 방에 있고 싶지 않아서, 시노스도 베란다로 도망쳐 나왔다."


translate japanese plot8_6852ca7d:


    "아침의 일을 겪으면서, 두 사람의 거리는 조금 가까워져 있었다."


translate japanese plot8_e15c3fae:



    voice "voice/cygnus_1079.ogg"
    cygnus "뭘 먹는 거야?"


translate japanese plot8_97d5e18f:



    voice "voice/yangxi_647.ogg"
    yangxi "괴상한 맛 막대사탕."


translate japanese plot8_cc2b8b26:



    voice "voice/cygnus_1080.ogg"
    cygnus "괴상한 맛 사탕……?"


translate japanese plot8_ac6f840a:



    voice "voice/yangxi_648.ogg"
    yangxi "먹어 볼래?"


translate japanese plot8_e03c72f2:


    "히나타는 반쯤 장난으로 막대사탕을 시노스의 입가에 내밀었다."


translate japanese plot8_d4175564:



    voice "voice/cygnus_1081.ogg"
    cygnus "그럼 사양하지 않을게."


translate japanese plot8_59bb4cc3:



    voice "voice/yangxi_649.ogg"
    yangxi "잠깐——" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_fd180892:


    "시노스는 망설이지도 않고 히나타가 들고 있던 막대사탕을 입에 물었다."


translate japanese plot8_b814c27a:


    "히나타도 시노스가 농담인 줄 모를 거라고는 생각하지 못했다."


translate japanese plot8_248e28f6:


    "히나타가 정신을 차렸을 때는 이미 시노스가 막대사탕의 맛을 천천히 음미하고 있었다."


translate japanese plot8_e9e6aead:



    voice "voice/cygnus_1082.ogg"
    cygnus "음……사탕인데 시고 떫네. 별로 맛있지는 않아."


translate japanese plot8_5b14420e:



    voice "voice/cygnus_1083.ogg"
    cygnus "방금 뭐라고 하려던 거야?"


translate japanese plot8_23f218c7:



    voice "voice/yangxi_650.ogg"
    yangxi "됐어, 아무것도 아니야."


translate japanese plot8_0f5fc937:



    voice "voice/yangxi_651.ogg"
    yangxi "(문화 차이인가……얘는 현대 사회에서 사람 사이에 지켜야 할 거리를 모르는구나.)"


translate japanese plot8_793ec2cb:



    voice "voice/cygnus_1084.ogg"
    cygnus "그나저나……라이라는 오늘 왜 속옷만 입고 있어?"


translate japanese plot8_3e1fa79e:



    voice "voice/yangxi_652.ogg"
    yangxi "이제 와서 묻는 거야? 난 너랑 살 때도 늘 저러는 줄 알았는데."


translate japanese plot8_8a5d65ee:



    voice "voice/cygnus_1085.ogg"
    cygnus "아니……오늘만 그래."


translate japanese plot8_011e71e4:



    voice "voice/yangxi_653.ogg"
    yangxi "라이라는 사실 「나체족」이거든."


translate japanese plot8_f4384029:



    voice "voice/cygnus_1086.ogg"
    cygnus "「나체족」?"


translate japanese plot8_4e96bd3c:



    voice "voice/yangxi_654.ogg"
    yangxi "그러니까 지금 모습이 「평소의 라이라」라는 거야."


translate japanese plot8_6f62619d:



    voice "voice/cygnus_1087.ogg"
    cygnus "속옷만 입고 있는 걸 좋아한다는 거야……?"


translate japanese plot8_d5c9b6ff:



    voice "voice/yangxi_655.ogg"
    yangxi "그것도 얌전한 편이지. 아무도 없으면 아예 안 입어."


translate japanese plot8_7e28bf84:



    voice "voice/cygnus_1088.ogg"
    cygnus "뭐——!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_17289bd8:



    voice "voice/cygnus_1089.ogg"
    cygnus "(이 세계에는 아직 내가 이해할 수 없는 생각이 너무 많아……)"


translate japanese plot8_c248414a:


    nvlNone "탁——타닥——탁!"


translate japanese plot8_d81f550e:


    nvlNone "이른 아침부터 여관 밖에서 끊임없이 소음이 들려왔다."


translate japanese plot8_69af4878:


    nvlNone "청각이 지나치게 예민한 탓에 그 소음은 유독 귀를 찔렀다."


translate japanese plot8_8ba9019b:



    voice "voice/equinox_125.ogg"
    nvlNone "하……" (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_cc774ee2:


    nvl clear
    nvlNone "이불 속에서 몇 번이고 뒤척이다가, 포기하고 일어나기로 했다." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_f41d6532:


    keeko "헤이——얍!"


translate japanese plot8_ee8bbbc8:



    voice "voice/dorothea_48.ogg"
    dorothea "오, 잘한다, 잘해."


translate japanese plot8_14464b47:



    voice "voice/keemi_06.ogg"
    keemi "언니는 정말 강해……"


translate japanese plot8_5e2126e9:



    voice "voice/keeko_15.ogg"
    keeko "거기 서서 구경만 하지 말고, 빨리 나랑 같이 연습하자."


translate japanese plot8_51bd46e6:



    voice "voice/keemi_07.ogg"
    keemi "으, 응!"


translate japanese plot8_892d9e46:


    nvlNone "술집의 두 아이는 요 며칠 어디서 구했는지 모를 검과 방패를 들고 이른 아침부터 찾아와 도로시아에게 훈련을 받고 있었다."


translate japanese plot8_c995d832:


    nvlNone "시험 이야기는 도로시아가 얼버무렸지만, 지금 두 사람은 기술을 하나라도 배우려는 생각으로 머릿속이 가득한 모양이었다." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_0c797c48:


    nvl_equinox "흐……하암——졸려——"


translate japanese plot8_a12d619e:



    voice "voice/dorothea_49.ogg"
    nvl_dorothea "오? 일어났어?" (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_7a8d90fe:



    voice "voice/equinox_127.ogg"
    nvl_equinox "응."


translate japanese plot8_6ad7a4f1:



    voice "voice/dorothea_50.ogg"
    nvl_dorothea "우리 때문에 깬 거야?"


translate japanese plot8_0f37cc8f:



    voice "voice/equinox_128.ogg"
    nvl_equinox "알면 됐어."


translate japanese plot8_c895af1a:



    voice "voice/dorothea_51.ogg"
    nvl_dorothea "미안하다니까. 애들이 너무 기운이 넘쳐서, 끝내 거절을 못 했지 뭐야——" (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_7cc83cd0:



    voice "voice/equinox_129.ogg"
    nvl_equinox "용……걔는 어디 있어?"


translate japanese plot8_61efec8c:



    voice "voice/dorothea_52.ogg"
    nvl_dorothea "자기가 한 번 더 조사하러 가겠다고 했어."


translate japanese plot8_97d0beca:



    voice "voice/equinox_130.ogg"
    nvl_equinox "알았어." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_317f1e2b:


    nvlNone "우리는 며칠째 이 마을에 머무르며 구석구석까지 훤히 파악했다."


translate japanese plot8_c77834df:


    nvlNone "하지만 「열쇠」의 흔적은 끝내 찾지 못했다." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_b74e42d9:


    nvlNone "그 시체가 우리에게 남은 마지막 단서가 되었다."


translate japanese plot8_90dadf02:


    nvlNone "비슷한 사건이 이어질 줄 알았다. 하지만 그 뒤로 마을에서는 비슷한 일이 단 한 번도 일어나지 않았다."


translate japanese plot8_53ab4bfa:


    nvlNone "범인은 우리를 눈치채고 잠시 손을 거둔 듯했다." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_71a96c8a:


    nvl clear
    nvlNone "그래도 나는 내 예감을 믿었다. 「열쇠」에 뒤틀린 인간이 그렇게까지 제정신을 유지할 리가 없다."


translate japanese plot8_d11d308b:


    nvlNone "머지않아 반드시 꼬리를 드러낼 것이다." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_a0cab8ef:



    voice "voice/keeko_16.ogg"
    nvl_keeko "왕언니! 거기서 농땡이 피우지 마!"


translate japanese plot8_a563d2ad:



    voice "voice/keeko_17.ogg"
    nvl_keeko "빨리 계속하자!"


translate japanese plot8_e195a1e8:



    voice "voice/dorothea_53.ogg"
    nvl_dorothea "알았어, 알았어. 지금 갈게."


translate japanese plot8_69fe0664:



    voice "voice/equinox_131.ogg"
    nvl_equinox "저 꼬맹이들이랑 저렇게 잘 어울리는 것도 참 대단해……" (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_3721dced:



    voice "voice/champion_85.ogg"
    nvl_champion "좋은 아침."


translate japanese plot8_cc7775a0:



    voice "voice/equinox_132.ogg"
    nvl_equinox "돌아왔어? 뭘 좀 알아냈어?"


translate japanese plot8_42630688:



    voice "voice/champion_86.ogg"
    nvl_champion "아니."


translate japanese plot8_ce1c2add:



    voice "voice/equinox_133.ogg"
    nvl_equinox "아쉽네." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_6082a10c:



    voice "voice/champion_87.ogg"
    nvl_champion "그래."


translate japanese plot8_d6801cd7:


    nvlNone "용사는 더 이상 아무 말도 하지 않고 내 옆에 앉았다. 둘이서 조금 떨어진 곳에서 떠드는 도로시아와 아이들을 바라보았다."


translate japanese plot8_71af9421:



    voice "voice/equinox_134.ogg"
    nvl_equinox "너도 다른 호칭을 하나 정할 생각 없어?" (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_d474f70b:



    voice "voice/champion_88.ogg"
    nvl_champion "왜? 너희 마녀들처럼 하라고?"


translate japanese plot8_2bb68cce:



    voice "voice/equinox_135.ogg"
    nvl_equinox "아니. 「용사」는 이름보다는 칭호에 어울리지 않아?"


translate japanese plot8_3a2e444e:



    voice "voice/champion_89.ogg"
    nvl_champion "아니. 난 용사잖아." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_b0b0fbb5:


    nvlNone "이 사람, 날 놀리는 건가?"


translate japanese plot8_c6efcb56:


    nvlNone "처음 만났을 때부터 그녀는 줄곧 자신을 「용사」라고 부르게 했다."


translate japanese plot8_30aa55a7:


    nvlNone "그래서 나도 도로시아도 아직 본명을 모른다." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_5bee96fa:



    nvl clear
    voice "voice/equinox_136.ogg"
    nvl_equinox "불편하잖아. 지금도 네 정체가 들키면 안 되는데……"


translate japanese plot8_806f6035:



    voice "voice/champion_90.ogg"
    nvl_champion "난 상관없어. 굳이 정체를 숨길 생각도 없고."


translate japanese plot8_006ec1e0:



    voice "voice/equinox_137.ogg"
    nvl_equinox "(이 녀석——!)" (ctc="ctc_end", ctc_position="fixed", what_prefix="", what_suffix="")


translate japanese plot8_facade21:



    voice "voice/champion_91.ogg"
    nvl_champion "내 이름이 그렇게 궁금해?"


translate japanese plot8_ceb69772:



    voice "voice/champion_92.ogg"
    nvl_champion "네 본명과 맞바꾼다면 가르쳐 줄게."


translate japanese plot8_3c8645cd:



    voice "voice/equinox_138.ogg"
    nvl_equinox "그런 뜻이 아니라, 다른 호칭을 정하라는 말일 뿐이야……"


translate japanese plot8_cb5078e7:



    voice "voice/champion_93.ogg"
    nvl_champion "그렇다면 「용사」면 됐어." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_2bb59a3e:


    nvlNone "용사는 전에 나를 놀렸을 때와 똑같이 짓궂게 웃었다."


translate japanese plot8_2b5a4252:


    nvlNone "우리가 이름을 물을 때마다\n그녀는 늘 이렇게 웃어넘겼고, 결국 유야무야되었다."


translate japanese plot8_9b05f027:



    voice "voice/equinox_139.ogg"
    nvl_equinox "(휴, 몰라. 좋을 대로 하라지.)" (ctc="ctc_end", ctc_position="fixed", what_prefix="", what_suffix="")


translate japanese plot8_753cdde3:



    voice "voice/keemi_08.ogg"
    keemi "꺅——!"


translate japanese plot8_b9f0ea96:



    voice "voice/keemi_09.ogg"
    keemi "아파……"


translate japanese plot8_5cf43193:


    "도로시아 쪽에서는 언니가 또 동생을 이겼다."


translate japanese plot8_779eb24d:


    "동생이 언니에게 맞아 나뒹구는 모습을 벌써 몇 번째 보는 건지 모르겠다."


translate japanese plot8_1008ffbb:



    voice "voice/keeko_18.ogg"
    keeko "치미, 빨리 일어나."


translate japanese plot8_6818187a:



    voice "voice/keemi_10.ogg"
    keemi "언니……조금만 쉬게 해 줘……"


translate japanese plot8_8a812ae1:



    voice "voice/keeko_19.ogg"
    keeko "에휴, 왜 또 쉬겠다는 거야. 참 약하네."


translate japanese plot8_f79379f3:



    voice "voice/dorothea_54.ogg"
    dorothea "그렇게 서두를 필요 없어."


translate japanese plot8_9e62536c:



    voice "voice/dorothea_55.ogg"
    dorothea "치코, 이번에는 내가 상대해 줄게. 치미는 옆에서 쉬고 있어."


translate japanese plot8_69e845bf:



    voice "voice/keeko_20.ogg"
    keeko "바라던 바야!"


translate japanese plot8_e98cd3ea:



    voice "voice/keemi_11.ogg"
    keemi "그, 그럼 나 잠깐 쉬고 올게……"


translate japanese plot8_457dff59:


    nvl_keemi "후——"


translate japanese plot8_6a2dcf2a:


    nvlNone "동생은 분한 듯 우리 쪽으로 걸어와,\n나와 용사 옆에 털썩 주저앉았다."


translate japanese plot8_b539589c:


    nvlNone "요 며칠 지켜보니 자매 사이에서는 언제나 언니가 이끈다는 걸 알 수 있었다."


translate japanese plot8_951f91f7:


    nvlNone "성격도 신체 능력도 언니 쪽이 동생보다 위였다." (**end_page())


translate japanese plot8_e46e808f:


    "도로시아 쪽으로 다시 눈을 돌리자, 치코는 벌써 공격 자세를 잡고 있었다."


translate japanese plot8_172d1f63:



    voice "voice/keeko_21.ogg"
    keeko "이얍——!"


translate japanese plot8_d5dd9526:



    voice "voice/dorothea_56.ogg"
    dorothea "어이쿠, 위험해라."


translate japanese plot8_273fe2f7:


    "도로시아는 장난하듯 치코의 공격을 가볍게 피했다."


translate japanese plot8_ae87f112:


    "하지만 치코는 물러서지 않고 뒤쫓으며, 손에 든 날 없는 검을 마구 휘둘렀다."


translate japanese plot8_c1f3cd55:



    voice "voice/dorothea_57.ogg"
    dorothea "아."


translate japanese plot8_9be629b9:


    "마구잡이로 쏟아지는 공격에도 도로시아는 당황하지 않았다. 목검으로 모든 공격을 흘려보냈다."


translate japanese plot8_496fab69:



    voice "voice/champion_94.ogg"
    nvl_champion "저건……내 검술?"


translate japanese plot8_585acd34:



    voice "voice/equinox_140.ogg"
    nvl_equinox "도로시아의 배우는 능력은 좀 믿기 힘들 정도지."


translate japanese plot8_1c9be37d:



    voice "voice/champion_95.ogg"
    nvl_champion "난 검을 몇 번 쓰지도 않았는데……"


translate japanese plot8_4365586c:



    voice "voice/equinox_141.ogg"
    nvl_equinox "어떤 기술이든 한 번만 보면 배울 수 있거든." (**end_page())


translate japanese plot8_b15423af:



    voice "voice/champion_96.ogg"
    nvl_champion "그건 너무 반칙 아니야?"


translate japanese plot8_ee537a95:


    nvlNone "최강의 용사라고 불리는 사람에게 그런 말을 할 자격이 있는지는 모르겠다."


translate japanese plot8_c59b2fc6:


    nvlNone "하지만 도로시아의 힘이 다른 사람들에게는\n월등하게 느껴진다는 것도 분명했다." (**end_page())


translate japanese plot8_3536db2c:



    voice "voice/keeko_22.ogg"
    keeko "후, 후, 후……"


translate japanese plot8_a0b15c8b:



    voice "voice/keeko_23.ogg"
    keeko "윽, 전혀 맞질 않아……"


translate japanese plot8_e7974c57:



    voice "voice/dorothea_58.ogg"
    dorothea "치코, 그렇게 공격하면 안 돼. 무기를 마구 휘두르면 금세 체력이 바닥나."


translate japanese plot8_cba188ca:



    voice "voice/dorothea_59.ogg"
    dorothea "이렇게 해야지."


translate japanese plot8_bc20be3c:


    "도로시아는 공격 자세로 바꾼 뒤 재빨리 앞으로 한 걸음 내디디며, 치코를 향해 목검을 휘둘렀다."


translate japanese plot8_ee24c4f8:



    voice "voice/keeko_24.ogg"
    keeko "으악!"


translate japanese plot8_0e7a755e:


    "탁!"


translate japanese plot8_c46a7305:


    "도로시아의 목검이 빠르고 정확하게 치코의 방패를 때렸다."


translate japanese plot8_f27eb7f3:


    "강한 충격에 밀린 치코는 몇 걸음이나 뒤로 비틀거리다가 그대로 바닥에 엉덩방아를 찧었다."


translate japanese plot8_69e07668:



    voice "voice/keeko_25.ogg"
    keeko "아야야……"


translate japanese plot8_9e129e53:



    voice "voice/dorothea_60.ogg"
    dorothea "미안해, 치코! 힘을 너무 줬어!"


translate japanese plot8_63c51217:



    voice "voice/keeko_26.ogg"
    keeko "괜찮아! 왕언니가 검을 휘두르는 기세에 놀랐을 뿐이야."


translate japanese plot8_86a02b40:



    voice "voice/keeko_27.ogg"
    keeko "왕언니 정말 대단해."


translate japanese plot8_594d0aba:



    voice "voice/dorothea_61.ogg"
    dorothea "헤헤, 별거 아니야. 너도 나중에는 할 수 있어."


translate japanese plot8_81700711:


    nvlNone "하지만 옆에서 보면 도로시아가 어린아이를 괴롭히는 것으로밖에 보이지 않는다."


translate japanese plot8_5fc2d5f4:



    voice "voice/champion_97.ogg"
    nvl_champion "검도 제대로 배우지 않은 아이를 상대로 검술을 쓰다니,\n좀 어른답지 못하지 않아?"


translate japanese plot8_342d3210:



    voice "voice/equinox_142.ogg"
    nvl_equinox "동감이야." (**end_page())


translate japanese plot8_8b4ee4c7:


    "치코는 땅에서 일어나 몸에 묻은 먼지를 털며, 방금 본 공격을 머릿속에서 되새겼다."


translate japanese plot8_5d840dd7:



    voice "voice/keeko_28.ogg"
    keeko "이렇게 하는 건가……"


translate japanese plot8_cf6ccec8:


    "그녀는 도로시아의 자세를 따라 하며, 방금 그 강력한 일격을 재현하려 했다."


translate japanese plot8_770324ab:



    voice "voice/keeko_29.ogg"
    keeko "영차——!"


translate japanese plot8_30b50c41:



    voice "voice/dorothea_62.ogg"
    dorothea "——!"


translate japanese plot8_48c87826:


    "치코의 목검이 도로시아를 향했다. 날 없는 검이 공기를 가르며 날카로운 소리를 냈다."


translate japanese plot8_94cdaf00:


    "쐐액——"


translate japanese plot8_b6aa6140:


    "도로시아는 본능적으로 위협을 느끼고, 나무 방패로 치코의 공격을 막았다."


translate japanese plot8_6741819a:


    "무겁고 날카로운 참격이 나무 방패에 깊은 자국을 남겼다."


translate japanese plot8_43b3d39d:



    voice "voice/keeko_30.ogg"
    keeko "해, 해냈다!"


translate japanese plot8_bd58916c:



    voice "voice/dorothea_63.ogg"
    dorothea "오! 치코, 너 정말 재능이 있구나."


translate japanese plot8_1f7ab7c0:


    nvlNone "조금 떨어져 있던 나와 용사도 그 광경을 보았다."


translate japanese plot8_32a08bab:



    voice "voice/equinox_143.ogg"
    nvl_equinox "방금 저건——!"


translate japanese plot8_3494ab1f:



    voice "voice/equinox_144.ogg"
    nvl_equinox "봤어? 저 꼬맹이한테도 너랑 같은……"


translate japanese plot8_9cb8ef4e:



    voice "voice/champion_98.ogg"
    nvl_champion "응, 느꼈어." (**end_page())


translate japanese plot8_c53ee10d:



    nvl clear
    voice "voice/champion_99.ogg"
    nvl_champion "아직 아주 약하지만, 분명 같은 근원에서 나온 힘이야."


translate japanese plot8_4454f161:



    voice "voice/champion_100.ogg"
    nvl_champion "정말 모험가에 잘 맞을지도 모르겠네." (**end_page())


translate japanese plot8_30b351f2:



    voice "voice/keemi_13.ogg"
    keemi "언니 정말 대단해……"


translate japanese plot8_90ed4840:



    voice "voice/champion_101.ogg"
    champion "너도 언니처럼 되고 싶어?"


translate japanese plot8_f08e788a:



    voice "voice/keemi_14.ogg"
    keemi "아, 아니……나는……"


translate japanese plot8_4297773c:


    "그에 비해 옆에서 쉬는 동생에게는 같은 재능이 있는 것 같지 않았다."


translate japanese plot8_3220bded:


    "어쩌면 이 아이는 모험가가 될 생각도 없는데, 언니에게 억지로 끌려온 것인지도 몰랐다."


translate japanese plot8_c62eb276:



    voice "voice/keemi_15.ogg"
    nvl_keemi "나는……"


translate japanese plot8_bbfe2c10:



    voice "voice/keemi_16.ogg"
    nvl_keemi "……언니를 뛰어넘고 싶어요."


translate japanese plot8_b4d42a96:



    voice "voice/keemi_17.ogg"
    nvl_keemi "모험가만 되려는 게 아니에요. 모험가보다 더 강한 용사가 될 거예요!" (ctc="ctc_end", ctc_position="fixed") with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_a603f744:



    voice "voice/equinox_145.ogg"
    nvl_equinox "뭐!?"


translate japanese plot8_46bb5d65:



    voice "voice/champion_102.ogg"
    nvl_champion "후후."


translate japanese plot8_1df91ba4:


    nvlNone "언니의 움직임을 보고 동생은 풀이 죽기는커녕, 오히려 승부욕에 불이 붙었다." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_883f3b75:


    nvl clear
    nvlNone "모험가는 그렇다 쳐도, 용사 본인 앞에서 「용사가 되고 싶다」는 말을 들으니 용사도 그만 웃고 말았다." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_be3d8270:



    voice "voice/keemi_18.ogg"
    keemi "어! 제, 제 생각이 이상한가요?"


translate japanese plot8_09e5d358:



    voice "voice/champion_103.ogg"
    champion "아니, 아주 훌륭한 꿈이야."


translate japanese plot8_18e0db4f:



    voice "voice/champion_104.ogg"
    champion "내가 가르쳐 줄게. 언니를 이기는 방법을."


translate japanese plot8_a551ff46:


    "용사는 치미를 조금 떨어진 곳으로 데려가 언니의 움직임을 자세히 관찰하게 하면서, 언니를 이기기 위한 작전을 여러 가지 가르쳐 주기 시작했다."


translate japanese plot8_67f6efc4:



    voice "voice/champion_105.ogg"
    champion "잘 봤지? 언니의 가장 큰 약점은 바로 저거야."


translate japanese plot8_3e83137a:



    voice "voice/champion_106.ogg"
    champion "공격할 때 반드시 빈틈이 크게 드러나. 방어에 집중하면 그 빈틈을 잡을 기회가 생길 거야."


translate japanese plot8_11065bbd:



    voice "voice/champion_107.ogg"
    champion "바로 그 순간, 발밑을 노려."


translate japanese plot8_49c134d9:



    voice "voice/keemi_19.ogg"
    keemi "아, 알겠어요!"


translate japanese plot8_9f637458:



    voice "voice/champion_108.ogg"
    champion "가 봐. 다시 한번 도전해 봐."


translate japanese plot8_3e357747:



    voice "voice/keemi_20.ogg"
    keemi "네!"


translate japanese plot8_401307a8:



    voice "voice/equinox_146.ogg"
    nvl_equinox "정말, 아이들을 상대로 참 별 생각을 다 하네."


translate japanese plot8_73d643fb:



    voice "voice/champion_109.ogg"
    nvl_champion "뭐 어때. 나중에 정말 모험가가 돼서 우리 동료가 될지도 모르잖아."


translate japanese plot8_75c04993:



    voice "voice/champion_110.ogg"
    nvl_champion "……게다가 저 아이의 마음에 감동했거든.\n조금쯤은 도와주고 싶어." (**end_page())


translate japanese plot8_68fbb13f:



    voice "voice/equinox_147.ogg"
    nvl_equinox "마지막 말이 진심이겠지."


translate japanese plot8_77914239:



    voice "voice/champion_111.ogg"
    nvl_champion "글쎄." (**end_page())


translate japanese plot8_ac882302:



    voice "voice/keemi_21.ogg"
    keemi "어, 언니!"


translate japanese plot8_bd819898:



    voice "voice/keeko_31.ogg"
    keeko "응? 치미, 다 쉬었어?"


translate japanese plot8_09ee32fa:



    voice "voice/keemi_22.ogg"
    keemi "응! 다시 대련하자!"


translate japanese plot8_3572c9d3:



    voice "voice/keeko_32.ogg"
    keeko "좋아. 이번에는 울지 않도록 해."


translate japanese plot8_cb5af89d:



    voice "voice/keemi_23.ogg"
    keemi "어, 언니야말로!"


translate japanese plot8_59111ae4:


    "두 꼬맹이는 목검과 나무 방패를 들고 다시 대련을 시작했다."


translate japanese plot8_ef643c1e:


    "치미는 용사의 지시대로 움직여 곧 반격할 기회를 잡았고, 마침내 언니를 쓰러뜨렸다."


translate japanese plot8_0194c426:



    voice "voice/keeko_33.ogg"
    keeko "읏!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_f0f252aa:



    voice "voice/keemi_24.ogg"
    keemi "해, 해냈다! 내가 이겼어!"


translate japanese plot8_301342b1:



    voice "voice/keeko_34.ogg"
    keeko "제법인데. 그렇다고 쉽게 졌다고 할 줄 알아?"


translate japanese plot8_48ad22c0:


    "바닥에 쓰러진 언니는 금세 일어나 반격했다."


translate japanese plot8_11414c65:


    "지고도 풀죽지 않고, 곧바로 방금의 실패를 발판으로 삼으려 하고 있었다."


translate japanese plot8_c278689c:


    "妹が勇者から教わったことはすぐに通じなくなり、姉がまた有利になった。"


translate japanese plot8_4e82583a:



    voice "voice/champion_112.ogg"
    nvl_champion "언니가 정말 대단하네. 벌써 적응하다니."


translate japanese plot8_b9bacedd:



    voice "voice/equinox_148.ogg"
    nvl_equinox "자매인데도 재능 차이가 이렇게나 나는구나."


translate japanese plot8_35873497:



    voice "voice/champion_113.ogg"
    nvl_champion "안 되겠다. 조금 더 가르쳐 줘야겠어."


translate japanese plot8_66040c89:



    voice "voice/champion_114.ogg"
    nvl_champion "치미——잠깐 다시 와 봐!" (**end_page())


translate japanese plot8_7b9ee484:



    voice "voice/equinox_149.ogg"
    nvl_equinox "하아——"


translate japanese plot8_127509b2:


    nvlNone "용사까지 저 꼬맹이들에게 이토록 마음을 쓰는 이유를 알 수 없었다."


translate japanese plot8_f1265d61:


    nvlNone "어쩌면 본인 말대로 저 꼬맹이 때문에 마음이 움직였는지도 모른다." (**end_page())


translate japanese plot8_1184e43a:


    nvlNone "그 뒤 용사에게 가르침을 받은 동생은\n마침내 언니와 맞설 수 있게 되었다."


translate japanese plot8_bf605344:


    nvlNone "그래도 아무리 봐도\n모험가에 어울리는 건 동생보다 언니 쪽이었다."


translate japanese plot8_0c9da081:


    nvlNone "우리 셋은 마치 {a=dictionary:dict_entry_87}{font=SourceHanSerifSC-Regular.otf}용사 훈련소{/font}{/a}의 교관처럼, 두 아이가 목검과 나무 방패로 하루 종일 맞붙는 모습을 지켜보았다." (**end_page())


translate japanese plot8_5511e86a:


    "월요일 아침."


translate japanese plot8_ebc1d5dc:


    "주말은 눈 깜짝할 사이에 지나갔다. 이틀 동안 몰아붙인 복습 덕분에, 라이라는 정말 이틀 만에 한 달 치 진도를 따라잡았다."


translate japanese plot8_4612e7d0:


    "다만 옆에서 끊임없이 문제를 설명해 준 히나타는 그만큼 고생해야 했다."


translate japanese plot8_c4933976:



    voice "voice/tianqin_1832.ogg"
    tianqin "예에에~ 좋은 아침——!"


translate japanese plot8_f6f801e7:



    voice "voice/yangxi_656.ogg"
    yangxi "좋은 아침……우웩!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_92d96fc9:



    voice "voice/tianqin_1833.ogg"
    tianqin "어? 히나타, 어디 아파?"


translate japanese plot8_791db550:



    voice "voice/yangxi_657.ogg"
    yangxi "미안. 지금은 교과서랑 네 얼굴만 봐도 토할 것 같아……"


translate japanese plot8_84811b06:



    voice "voice/tianqin_1834.ogg"
    tianqin "ひどい！今までだって何度も一緒に試験勉強したじゃん！"


translate japanese plot8_5f43beec:



    voice "voice/yangxi_658.ogg"
    yangxi "끝날 때마다 토할 것 같거든."


translate japanese plot8_feb9cda9:



    voice "voice/tianqin_1835.ogg"
    tianqin "히나타～!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_8d576df6:


    "시험 주간이 되자 반 분위기는 평소보다 눈에 띄게 팽팽해졌다."


translate japanese plot8_297ddb05:


    "장난치며 떠드는 소리는 줄고, 대신 자기 책상에서 복습하거나 문제를 푸는 학생이 늘었다."


translate japanese plot8_9142be54:


    "성적순으로 등수를 매기니, 여기 앉아 있는 모든 친구가 경쟁 상대였다."


translate japanese plot8_3565d83b:


    "모두가 그 사실을 의식하는 순간, 반 전체의 분위기는 한없이 무거워졌다."


translate japanese plot8_b291d991:



    voice "voice/tianqin_1836.ogg"
    tianqin "에휴, 정말 싫은 분위기야."


translate japanese plot8_1769147d:



    voice "voice/yangxi_659.ogg"
    yangxi "동감이야."


translate japanese plot8_f4c05c67:



    voice "voice/npc6_19.ogg"
    npc6 "また月例テストかぁ。嫌だな。"


translate japanese plot8_499fb736:



    voice "voice/npc7_15.ogg"
    npc7 "기운 빠지는 소리 그만하고, 얼른 문제나 풀어."


translate japanese plot8_c60432cd:



    voice "voice/npc6_20.ogg"
    npc6 "이미 주말 내내 공부했단 말이야!"


translate japanese plot8_e7963a14:



    voice "voice/npc6_21.ogg"
    npc6 "問題解きすぎて、頭がパンクしそう…"


translate japanese plot8_d0f750d1:



    voice "voice/npc7_16.ogg"
    npc7 "아, 그 얘기는 그만하고."


translate japanese plot8_d8298756:



    voice "voice/npc7_17.ogg"
    npc7 "「그 얘기」 들었어?"


translate japanese plot8_293da4e4:



    voice "voice/npc6_22.ogg"
    npc6 "어? 무슨 일?"


translate japanese plot8_b9f229a3:



    voice "voice/npc7_18.ogg"
    npc7 "진짜? 단체 채팅방 안 봤어?"


translate japanese plot8_c6aaec3b:



    voice "voice/npc6_23.ogg"
    npc6 "아휴, 주말에 그걸 볼 시간이 어디 있었어. 대체 무슨 일인데?"


translate japanese plot8_c3c1d58a:



    voice "voice/npc7_19.ogg"
    npc7 "鶴城が家の力を使って、週末に大勢の私立探偵を学校へ入れて調べさせたらしいよ…"


translate japanese plot8_afeba38c:



    voice "voice/npc7_20.ogg"
    npc7 "二日かけて、校内を隅々まで調べ回ったんだって。"


translate japanese plot8_b97aa8f4:



    voice "voice/npc6_24.ogg"
    npc6 "えっ！？本当に？じゃあ、私の机も触られたってこと？" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_5eb9f561:



    voice "voice/npc7_21.ogg"
    npc7 "決まっているでしょう。今日来たら、机の位置がずれてたって人もたくさんいる…"


translate japanese plot8_3371ef0f:



    voice "voice/npc6_25.ogg"
    npc6 "흰쥐 같은 애, 진짜 징그러워……"


translate japanese plot8_e39f93c1:



    voice "voice/npc6_26.ogg"
    npc6 "집에 돈 좀 있다고 마음대로 하네."


translate japanese plot8_b06bd920:



    voice "voice/npc7_22.ogg"
    npc7 "그러게. 분명 교장이 뒤를 봐준 거겠지. 학교에 사람을 들여서 멋대로 굴게 하다니."


translate japanese plot8_5e1957ea:



    voice "voice/tianqin_1837.ogg"
    tianqin "으……!"


translate japanese plot8_96150ea6:



    voice "voice/yangxi_660.ogg"
    yangxi "（まあ、鶴城ならやりそうなこと。）"


translate japanese plot8_cf888514:



    voice "voice/tianqin_1838.ogg"
    tianqin "(히나타!)"


translate japanese plot8_f353c8d5:



    voice "voice/yangxi_661.ogg"
    yangxi "(사실대로 말했을 뿐이야.)"


translate japanese plot8_a2392d56:



    voice "voice/yangxi_662.ogg"
    yangxi "(그래도 이것도 소문일 뿐이겠지.)"


translate japanese plot8_ee8d7dd1:



    voice "voice/yangxi_663.ogg"
    yangxi "(아무리 그래도 학교에서 그렇게까지 마음대로 하게 두겠어.)"


translate japanese plot8_2eec052b:



    voice "voice/tianqin_1839.ogg"
    tianqin "(하아, 솔직하게 우리 도움을 받아 주면 좋을 텐데……)"


translate japanese plot8_549b4e67:



    voice "voice/npc7_23.ogg"
    npc7 "그리고 원예부에도 무슨 일이 났대."


translate japanese plot8_50424ad2:



    voice "voice/npc6_27.ogg"
    npc6 "어? 원예부?"


translate japanese plot8_433c5e87:



    voice "voice/npc7_24.ogg"
    npc7 "있잖아, 운동장 구석에 있는……"


translate japanese plot8_a1182b2f:



    voice "voice/npc6_28.ogg"
    npc6 "아, 꽃이랑 풀 심는 동아리?"


translate japanese plot8_7f11e738:



    voice "voice/npc6_29.ogg"
    npc6 "에이, 그런 작은 동아리에서 뭔 일이 나든 무슨 상관이야. 부원도 별로 없잖아."


translate japanese plot8_1dc42f7e:



    voice "voice/npc6_30.ogg"
    npc6 "むしろ、どうして学校があんな部活を残してるのか聞きたいくらい。学校の予算の無駄じゃない？"


translate japanese plot8_d5c0c71f:



    voice "voice/npc7_25.ogg"
    npc7 "하하, 그러게."


translate japanese plot8_790a88a0:



    voice "voice/tianqin_1840.ogg"
    tianqin "으으!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_80f16bc0:



    voice "voice/yangxi_664.ogg"
    yangxi "(진정해.)"


translate japanese plot8_df90387b:



    voice "voice/tianqin_1841.ogg"
    tianqin "(괜찮아. 아주 침착해.)"


translate japanese plot8_94844d0c:



    voice "voice/yangxi_665.ogg"
    yangxi "(금방이라도 달려들 것처럼 보이는데……)"


translate japanese plot8_e65d124d:



    voice "voice/tianqin_1842.ogg"
    tianqin "(어떻게 화가 안 나겠어!)"


translate japanese plot8_69b1c4a4:



    voice "voice/tianqin_1843.ogg"
    tianqin "(그런데……원예부에 무슨 일이 났다는데?)"


translate japanese plot8_62fcb1db:



    voice "voice/yangxi_666.ogg"
    yangxi "(이따 가 보자. 우리도 며칠째 얼굴 안 비췄잖아.)"


translate japanese plot8_f9b8cb25:



    voice "voice/tianqin_1844.ogg"
    tianqin "(좋아! 나도 교실에 있기 싫어.)"


translate japanese plot8_71e08e60:



    voice "voice/tianqin_1845.ogg"
    tianqin "…"


translate japanese plot8_49e917bc:



    voice "voice/yangxi_667.ogg"
    yangxi "쯧……"


translate japanese plot8_373bf3d1:



    voice "voice/xiaoxia_96.ogg"
    xiaoxia "…"


translate japanese plot8_a060e4a7:



    voice "voice/tianqin_1846.ogg"
    tianqin "아키나, 무슨 일이야?"


translate japanese plot8_b0390fe6:



    voice "voice/xiaoxia_97.ogg"
    xiaoxia "저도……잘 모르겠어요……"


translate japanese plot8_35ea3cc9:


    "아키나는 당황해서 어떻게 해야 할지 모르는 듯했다."


translate japanese plot8_01f52fa1:


    "朝一番に園芸部へ来た生徒から連絡を受け、彼女はすぐ学校へ駆けつけた。"


translate japanese plot8_0e93fff4:


    "하지만 원예부의 처참한 모습은 그녀가 상상했던 것보다 훨씬 심각했다."


translate japanese plot8_5dc38199:


    "화단은 모조리 악의적으로 파헤쳐져 있었다. 식물은 뿌리째 뽑히거나 줄기가 꺾여, 무사한 것은 거의 한 포기도 없었다."


translate japanese plot8_2b16428e:


    "동아리실 자물쇠도 억지로 뜯겨 있었고, 안에 있던 원예 도구는 모두 망가져 있었다. 얼마 되지 않는 동아리 회비까지 도둑맞았다."


translate japanese plot8_5853c1bc:



    voice "voice/tianqin_1847.ogg"
    tianqin "너무하잖아."


translate japanese plot8_196736cf:



    voice "voice/yangxi_668.ogg"
    yangxi "이번 주말에 일어난 일이야?"


translate japanese plot8_f09a14a3:



    voice "voice/xiaoxia_98.ogg"
    xiaoxia "모……모르겠어요……"


translate japanese plot8_50f87d4b:



    voice "voice/yangxi_669.ogg"
    yangxi "(완전히 동요하고 있어.)"


translate japanese plot8_10578db2:



    voice "voice/tianqin_1848.ogg"
    tianqin "아키나, 선생님께는 말씀드렸어?"


translate japanese plot8_7c72accb:



    voice "voice/xiaoxia_99.ogg"
    xiaoxia "반장이 선생님께 보고하러 가겠다고 했어요……"


translate japanese plot8_ff3b3be2:



    voice "voice/tianqin_1849.ogg"
    tianqin "반장이 왔었구나……"


translate japanese plot8_b6051265:



    voice "voice/xiaoxia_100.ogg"
    xiaoxia "네……체육 특기생은 아침 훈련이 있어서, 벌써 여기 와서 무슨 일이 있었는지 보고 갔어요……"


translate japanese plot8_c0ff9543:



    voice "voice/tianqin_1850.ogg"
    tianqin "으음……"


translate japanese plot8_4b88372c:



    voice "voice/tianqin_1851.ogg"
    tianqin "아키나, 저쪽에서 잠깐 얘기할 수 있을까?"


translate japanese plot8_fba1cdae:


    "라이라는 아키나를 동아리실 옆으로 데려갔다. 다른 사람들에게 이야기가 들리지 않는 곳이었다."


translate japanese plot8_6a3d3271:



    voice "voice/tianqin_1852.ogg"
    tianqin "아키나, 진정하고 나한테 얘기해 줄 수 있어?"


translate japanese plot8_373bf3d1_1:



    voice "voice/xiaoxia_101.ogg"
    xiaoxia "…"


translate japanese plot8_71d2b1b6:



    voice "voice/tianqin_1853.ogg"
    tianqin "누군가한테 괴롭힘을 당하고 있어?"


translate japanese plot8_a487ef6a:



    voice "voice/xiaoxia_102.ogg"
    xiaoxia "저는……"


translate japanese plot8_c8b05b36:



    voice "voice/xiaoxia_103.ogg"
    xiaoxia "……아, 아니……저는……"


translate japanese plot8_43716d4b:



    voice "voice/xiaoxia_104.ogg"
    xiaoxia "……아무한테도 괴롭힘을 당하지 않아요."


translate japanese plot8_bbf32c99:



    voice "voice/tianqin_1854.ogg"
    tianqin "아키나, 괜찮아. 어려운 일이 있으면 나한테 말해 봐."


translate japanese plot8_cf753d71:



    voice "voice/tianqin_1855.ogg"
    tianqin "내가 도와줄게."


translate japanese plot8_b852c505:



    voice "voice/xiaoxia_105.ogg"
    xiaoxia "아무한테도 괴롭힘을 당하지 않아요……"


translate japanese plot8_050cc2ea:



    voice "voice/tianqin_1856.ogg"
    tianqin "아키나……"


translate japanese plot8_4db4ad58:



    voice "voice/yangxi_670.ogg"
    yangxi "라이라."


translate japanese plot8_18b74d96:



    voice "voice/tianqin_1857.ogg"
    tianqin "응……알았어."


translate japanese plot8_0e055ee7:



    voice "voice/tianqin_1858.ogg"
    tianqin "何かあったら連絡して。私にできることなら、何でもするから。"


translate japanese plot8_373bf3d1_2:



    voice "voice/xiaoxia_106.ogg"
    xiaoxia "…"


translate japanese plot8_f192fe82:



    voice "voice/tianqin_1859.ogg"
    tianqin "가자, 히나타."


translate japanese plot8_0586323a:



    voice "voice/yangxi_671.ogg"
    yangxi "응."


translate japanese plot8_8c35a6b0:



    voice "voice/tianqin_1860.ogg"
    tianqin "아키나가 말하려 하지 않네."


translate japanese plot8_b012b255:



    voice "voice/yangxi_672.ogg"
    yangxi "……협박을 당하는 것 같아."


translate japanese plot8_207973bc:



    voice "voice/yangxi_673.ogg"
    yangxi "그리고 아까 원예부 분위기도……"


translate japanese plot8_7d8c447b:



    voice "voice/yangxi_674.ogg"
    yangxi "네가 아키나만 따로 데리고 나갔을 때, 모두 우리 쪽을 보고 있었어."


translate japanese plot8_f1727088:



    voice "voice/yangxi_675.ogg"
    yangxi "무슨 일이 있었는지 모두 아는 것 같았어. 모르고 있는 건 우리뿐이야……"


translate japanese plot8_8cfa57cb:



    voice "voice/tianqin_1861.ogg"
    tianqin "설마 우리가 원예부에 오기 전부터……"


translate japanese plot8_235ee8e0:



    voice "voice/xiaoxia_107.ogg"
    xiaoxia "라이라 씨!"


translate japanese plot8_5d2cabe1:



    voice "voice/tianqin_1862.ogg"
    tianqin "아키나? 왜 그래?"


translate japanese plot8_1407c210:



    voice "voice/xiaoxia_108.ogg"
    xiaoxia "저기, 반장이랑 선생님이 꼭 해결해 주실 테니까요……"


translate japanese plot8_41fecdf8:



    voice "voice/xiaoxia_109.ogg"
    xiaoxia "もう…助けていただかなくても大丈夫です。園芸部にも…来ないでください…"


translate japanese plot8_bf901d71:



    voice "voice/tianqin_1863.ogg"
    tianqin "……응, 알았어."


translate japanese plot8_bd33ff0e:



    voice "voice/xiaoxia_110.ogg"
    xiaoxia "……죄송해요."


translate japanese plot8_17adc0c7:



    voice "voice/tianqin_1864.ogg"
    tianqin "하아……"


translate japanese plot8_257b6638:



    voice "voice/yangxi_676.ogg"
    yangxi "이제 확실하지? 우린 완전히 배제됐어."


translate japanese plot8_03a7c137:



    voice "voice/tianqin_1865.ogg"
    tianqin "아키나는 우릴 걱정해서 그렇게 말한 거겠지."


translate japanese plot8_9ee13a5d:



    voice "voice/yangxi_677.ogg"
    yangxi "아니. 우리가 만만한 상대였다면, 진작 저쪽에서 우리를 건드렸겠지."


translate japanese plot8_855d1c5b:



    voice "voice/yangxi_678.ogg"
    yangxi "누군가 원예부를 압박해서, 이런 식으로 우리가 원예부에 가까이 가지 못하게 하려는 거야."


translate japanese plot8_d5554ce7:



    voice "voice/tianqin_1866.ogg"
    tianqin "쳇, 약한 사람한테만 강한 것들."


translate japanese plot8_5940f1ad:



    voice "voice/yangxi_679.ogg"
    yangxi "あの眼鏡は？まだ持ってる？"


translate japanese plot8_e17cb9af:



    voice "voice/yangxi_680.ogg"
    yangxi "지금 뭔가 보일지도 모르잖아."


translate japanese plot8_30fdb590:



    voice "voice/tianqin_1867.ogg"
    tianqin "맞다. 깜빡했네."


translate japanese plot8_a4c2c91a:


    "라이라가 안경을 쓰자, 렌즈에 마법의 빛이 비치기 시작했다."


translate japanese plot8_977fadb6:



    voice "voice/yangxi_681.ogg"
    yangxi "……그거 꽤 눈에 띄네. 앞으로 다른 사람이 있으면 조심해서 써."


translate japanese plot8_059c054f:



    voice "voice/tianqin_1868.ogg"
    tianqin "어? 그래?"


translate japanese plot8_6eafdc4b:



    voice "voice/yangxi_682.ogg"
    yangxi "자, 지금이라도 무슨 단서가 없는지 둘러보자."


translate japanese plot8_c6c82895:



    voice "voice/yangxi_683.ogg"
    yangxi "한번 원예부를 떠나면, 다음에는 쉽게 돌아올 수 없을 거야."


translate japanese plot8_e34d4792:



    voice "voice/tianqin_1869.ogg"
    tianqin "응. 알았어."


translate japanese plot8_c0ff9543_1:



    voice "voice/tianqin_1870.ogg"
    tianqin "으음……"


translate japanese plot8_06ed34c0:


    "라이라는 원예부 주변을 한 바퀴 돌며, 눈을 가늘게 뜨고 망가진 것들을 하나하나 살폈다."


translate japanese plot8_bc5625cb:


    "화단, 자물쇠, 원예 도구……"


translate japanese plot8_abbdfee5:



    voice "voice/yangxi_684.ogg"
    yangxi "뭐 좀 알아냈어?"


translate japanese plot8_08e5d6f6:



    voice "voice/tianqin_1871.ogg"
    tianqin "아니, 없어……"


translate japanese plot8_6dac5de8:



    voice "voice/tianqin_1872.ogg"
    tianqin "여기에는 마력의 빛이 전혀 보이지 않아."


translate japanese plot8_da2e7244:



    voice "voice/yangxi_685.ogg"
    yangxi "안경이 고장 난 거 아니야?"


translate japanese plot8_3347dee6:



    voice "voice/tianqin_1873.ogg"
    tianqin "그럴 리 없어. 시노스가 매일 확인해 주니까……문제없을 거야."


translate japanese plot8_25cee5d9:



    voice "voice/yangxi_686.ogg"
    yangxi "그렇다는 건……"


translate japanese plot8_1727dff9:



    voice "voice/tianqin_1874.ogg"
    tianqin "……츠루기 때와는 다른 사람이야?"


translate japanese plot8_4c5afd41:



    voice "voice/yangxi_687.ogg"
    yangxi "아니……아직 확신할 수는 없어. 같은 사람일 가능성도 남아 있어."


translate japanese plot8_961845e6:



    voice "voice/yangxi_688.ogg"
    yangxi "다만 지금으로선, 츠루기를 괴롭힌 사람과 원예부를 망가뜨린 사람은……서로 다른 사람일 가능성이 더 높아 보여."


translate japanese plot8_ad0c4151:



    voice "voice/tianqin_1875.ogg"
    tianqin "괴롭히는 사람……아니, 괴롭힘 사건이 하나가 아니라는 거야?"


translate japanese plot8_96b3d47a:



    voice "voice/yangxi_689.ogg"
    yangxi "응, 그럴 수도 있어."


translate japanese plot8_3db3d12f:



    voice "voice/yangxi_690.ogg"
    yangxi "눈앞의 일과 우리가 조사하는 건 아마 별개의 사건일 거야."


translate japanese plot8_5265e2db:



    voice "voice/tianqin_1876.ogg"
    tianqin "정말 이런 일이 있을 수가 있나……"


translate japanese plot8_166a661b:



    voice "voice/tianqin_1877.ogg"
    tianqin "이 학교에서 이렇게 대놓고 괴롭히다니……"


translate japanese plot8_9db5dc9c:



    voice "voice/yangxi_691.ogg"
    yangxi "그러고 보니 작년에도 체육 특기생들 사이에서 괴롭힘이 있었다는 소문이 있었지."


translate japanese plot8_47a62fd3:



    voice "voice/tianqin_1878.ogg"
    tianqin "응? 그건 뭐야?"


translate japanese plot8_36ec7783:



    voice "voice/yangxi_692.ogg"
    yangxi "체육 특기생 한 명이 실종됐다는 얘기 있었잖아. 아직도 못 찾았대."


translate japanese plot8_1e92888a:



    voice "voice/yangxi_693.ogg"
    yangxi "다른 체육 특기생들에게 괴롭힘을 당한 뒤 사라졌다더라."


translate japanese plot8_acaf96a3:



    voice "voice/tianqin_1879.ogg"
    tianqin "뭐? 그런 일도 있었어?"


translate japanese plot8_94a329c7:



    voice "voice/yangxi_694.ogg"
    yangxi "学校が大金を払って、その生徒の保護者と話をつけたって噂。全部口止めされたから、ほとんど表には出なかった。"


translate japanese plot8_b78b5af4:



    voice "voice/yangxi_695.ogg"
    yangxi "그때는 나도 반신반의했는데, 지금은……"


translate japanese plot8_2450fdfc:



    voice "voice/yangxi_696.ogg"
    yangxi "이렇게 직접 보고 나니 그 소문도 사실이었던 건 아닐까 싶어."


translate japanese plot8_a7e860d2:



    voice "voice/yangxi_697.ogg"
    yangxi "내 생각엔……이 학교에는 이런 일이 계속 있었던 것 같아."


translate japanese plot8_dea42098:



    voice "voice/yangxi_698.ogg"
    yangxi "ただ、関係する情報は全部揉み消されて、今回はたまたま私たちが出くわしただけ。"


translate japanese plot8_f645a318:



    voice "voice/tianqin_1880.ogg"
    tianqin "으음……우선 담임 선생님께 말씀드리러 가자."


translate japanese plot8_19503d3d:



    voice "voice/tianqin_1881.ogg"
    tianqin "아무것도 안 할 수는 없으니까……"


translate japanese plot8_f9d54bac:



    voice "voice/yangxi_699.ogg"
    yangxi "응. 선생님 생각도 들어 보자."


translate japanese plot8_b7a541bb:



    voice "voice/yangxi_700.ogg"
    yangxi "이제부터는 우리가 끼어들 수 있는 일도 아니니까."


translate japanese plot8_abcdec8c:



    voice "voice/banzhang_341.ogg"
    banzhang "선생님, 그럼 전 돌아가 볼게요."


translate japanese plot8_010d5300:



    voice "voice/banzhuren_143.ogg"
    banzhuren "……응."


translate japanese plot8_77bcddef:



    voice "voice/banzhuren_144.ogg"
    banzhuren "아키, 며칠 쉬는 게 어떻겠니?"


translate japanese plot8_47f1c866:



    voice "voice/banzhang_342.ogg"
    banzhang "아니에요……선생님, 전 괜찮아요."


translate japanese plot8_4981f721:



    voice "voice/banzhang_343.ogg"
    banzhang "그리고 곧 체육 특기생 종합시험이 있어서, 조금 더 연습해 두고 싶어요……"


translate japanese plot8_19eec06e:



    voice "voice/banzhuren_145.ogg"
    banzhuren "알았다. 나머지는 내게 맡기렴."


translate japanese plot8_ff45dd52:



    voice "voice/banzhuren_146.ogg"
    banzhuren "무리는 하지 말고."


translate japanese plot8_d7580173:



    voice "voice/banzhang_344.ogg"
    banzhang "……네."


translate japanese plot8_36923c65:



    voice "voice/banzhang_345.ogg"
    banzhang "…"


translate japanese plot8_749d8050:



    voice "voice/tianqin_1882.ogg"
    tianqin "아, 반장."


translate japanese plot8_08a29d9e:



    voice "voice/banzhang_346.ogg"
    banzhang "라이라 씨…"


translate japanese plot8_c7fe9f8d:



    voice "voice/tianqin_1883.ogg"
    tianqin "담임 선생님 뵈러 왔어?"


translate japanese plot8_8b3655c4:



    voice "voice/banzhang_347.ogg"
    banzhang "네. 보고드릴 일이 조금 있어서요……"


translate japanese plot8_a7cf7c80:



    voice "voice/tianqin_1884.ogg"
    tianqin "그게……원예부 일이야?"


translate japanese plot8_d7580173_1:



    voice "voice/banzhang_348.ogg"
    banzhang "……네."


translate japanese plot8_1632379a:



    voice "voice/banzhang_349.ogg"
    banzhang "죄송해요……먼저 갈게요."


translate japanese plot8_4edad6a0:



    voice "voice/tianqin_1885.ogg"
    tianqin "자, 잠깐! 반장——"


translate japanese plot8_005bb89b:



    voice "voice/tianqin_1886.ogg"
    tianqin "반장!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_299a9502:



    voice "voice/banzhang_350.ogg"
    banzhang "……라이라 씨."


translate japanese plot8_10e0a85c:



    voice "voice/tianqin_1887.ogg"
    tianqin "대체……무슨 일이야?"


translate japanese plot8_13155c41:



    voice "voice/banzhang_351.ogg"
    banzhang "저는……"


translate japanese plot8_1b16c74a:



    voice "voice/banzhang_352.ogg"
    banzhang "――知っていることは、すべて担任先生に話しました。"


translate japanese plot8_18275ae7:



    voice "voice/tianqin_1888.ogg"
    tianqin "그럼……"


translate japanese plot8_46ca1c0e:



    voice "voice/banzhang_353.ogg"
    banzhang "라이라 씨, 정말 감사했어요."


translate japanese plot8_ab7c953c:



    voice "voice/banzhang_354.ogg"
    banzhang "당신이 없었다면 전 용기를 내지 못했을 거예요."


translate japanese plot8_897b38b0:



    voice "voice/tianqin_1889.ogg"
    tianqin "반장……"


translate japanese plot8_db5d8a34:



    voice "voice/banzhang_355.ogg"
    banzhang "라이라 씨의 말을 듣고 처음으로 스스로 나설 수 있었어요."


translate japanese plot8_5b06fcef:



    voice "voice/banzhang_356.ogg"
    banzhang "라이라 씨가 정말 부러워요."


translate japanese plot8_68db8536:



    voice "voice/banzhang_357.ogg"
    banzhang "늘 자신의 생각을 끝까지 지키시잖아요. 우리 엄마처럼……"


translate japanese plot8_efee6000:



    voice "voice/banzhang_358.ogg"
    banzhang "아, 죄송해요. 또 혼자 이상한 말을 해 버렸네요."


translate japanese plot8_3c4cb8cc:



    voice "voice/tianqin_1890.ogg"
    tianqin "아니야. 난 그냥 대체 무슨 일이 있었는지 알고 싶을 뿐이야."


translate japanese plot8_9022983c:



    voice "voice/tianqin_1891.ogg"
    tianqin "반장, 나도 돕게 해 줘."


translate japanese plot8_440d009f:



    voice "voice/banzhang_359.ogg"
    banzhang "괜찮아요, 라이라 씨."


translate japanese plot8_fb2fd596:



    voice "voice/banzhang_360.ogg"
    banzhang "이번에는 제 힘으로……더는 라이라 씨에게 기대면 안 돼요."


translate japanese plot8_897b38b0_1:



    voice "voice/tianqin_1892.ogg"
    tianqin "반장……"


translate japanese plot8_6ddc7a7d:



    voice "voice/banzhang_361.ogg"
    banzhang "걱정하지 마세요, 라이라 씨."


translate japanese plot8_fa099cac:



    voice "voice/banzhang_362.ogg"
    banzhang "담임 선생님이 꼭 잘 해결해 주실 거예요."


translate japanese plot8_8601e349:



    voice "voice/banzhuren_147.ogg"
    banzhuren "으음——"


translate japanese plot8_c9dfd57b:



    voice "voice/banzhuren_148.ogg"
    banzhuren "(일이 이렇게 될 줄은 몰랐는데.)"


translate japanese plot8_b914c047:



    voice "voice/tianqin_1893.ogg"
    tianqin "선생님."


translate japanese plot8_ff44ccf6:



    voice "voice/banzhuren_149.ogg"
    banzhuren "왔구나."


translate japanese plot8_484b6e64:



    voice "voice/tianqin_1894.ogg"
    tianqin "방금 반장이랑 마주쳤어요."


translate japanese plot8_9135fa42:



    voice "voice/banzhuren_150.ogg"
    banzhuren "응, 원예부 일로 나한테 얘기하러 왔어."


translate japanese plot8_0829467c:



    voice "voice/tianqin_1895.ogg"
    tianqin "역시 그랬구나……"


translate japanese plot8_e657a10a:



    voice "voice/banzhuren_151.ogg"
    banzhuren "너도 벌써 알아?"


translate japanese plot8_eb9d5ddf:



    voice "voice/tianqin_1896.ogg"
    tianqin "방금 원예부에 다녀왔어요."


translate japanese plot8_3d5d30fc:



    voice "voice/banzhuren_152.ogg"
    banzhuren "그렇구나……"


translate japanese plot8_232007bf:



    voice "voice/banzhuren_153.ogg"
    banzhuren "옥상에 가서 얘기하자."


translate japanese plot8_4119ac4d:



    voice "voice/banzhuren_154.ogg"
    banzhuren "하아——"


translate japanese plot8_7b30254e:


    "옥상에 도착하자마자 담임은 곧장 그 「흡연 구역」으로 향했다."


translate japanese plot8_35110b39:


    "뒤에 선 라이라는 신경도 쓰지 않은 채, 라이터와 담배를 꺼내 거리낌 없이 한 개비에 불을 붙였다."


translate japanese plot8_d58380e7:



    voice "voice/tianqin_1897.ogg"
    tianqin "ゴホッ、ゴホッ！屋上へ来ていきなり吸わないでくださいよ！" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_377a4a03:



    voice "voice/banzhuren_155.ogg"
    banzhuren "널 배려해서 오늘은 여성용 담배로 골랐는데."


translate japanese plot8_c4a60a08:



    voice "voice/tianqin_1898.ogg"
    tianqin "안 피우는 사람한테는 다 똑같잖아요……"


translate japanese plot8_1c9d0be4:



    voice "voice/banzhuren_156.ogg"
    banzhuren "그럼, 한 대 할래?"


translate japanese plot8_d5288b7b:



    voice "voice/tianqin_1899.ogg"
    tianqin "그만, 그만! 제 마음속 선생님 이미지를 더 망가뜨리지 마세요——"


translate japanese plot8_fbab3251:



    voice "voice/banzhuren_157.ogg"
    banzhuren "어차피 넌 날 훌륭한 선생님으로 생각하지도 않잖아."


translate japanese plot8_316e9518:



    voice "voice/tianqin_1900.ogg"
    tianqin "すごく機嫌悪そうですね。委員長から何を聞いたのですか？"


translate japanese plot8_746e61d2:



    voice "voice/banzhuren_158.ogg"
    banzhuren "이거 한 대만 다 피우게 해 줘. 생각을 좀 정리해야겠어."


translate japanese plot8_4f1e1ea9:



    voice "voice/tianqin_1901.ogg"
    tianqin "うぅ…分かった。"


translate japanese plot8_364ae786:


    "담임은 옥상 철망에 기대 담배를 피우며 학교를 내려다보았다."


translate japanese plot8_e4db8122:


    "옥상에서는 아래쪽 운동장 전체와, 더 멀리 있는 원예부까지 보였다."


translate japanese plot8_bd3f97a3:


    "평소라면 이토록 대놓고 담배를 문 채 이곳에 기대 서 있지는 않았을 것이다."


translate japanese plot8_88b5ef8b:


    "손에 든 담배가 다 탈 때까지 담임은 줄곧 말이 없었다. 그러고 나서야 라이라에게 말을 걸었다."


translate japanese plot8_b640befd:



    voice "voice/banzhuren_159.ogg"
    banzhuren "委員長は、知っていることを全部話してくれた…"


translate japanese plot8_9dc95fcc:



    voice "voice/banzhuren_160.ogg"
    banzhuren "——원예부 일도, 괴롭힘에 관한 일도."


translate japanese plot8_f2acba73:



    voice "voice/tianqin_1902.ogg"
    tianqin "——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_b6efb130:



    voice "voice/tianqin_1903.ogg"
    tianqin "츠루기를 괴롭히는 사람과 원예부를 망가뜨린 사람이 같은 사람이에요?"


translate japanese plot8_06096900:



    voice "voice/banzhuren_161.ogg"
    banzhuren "멋대로 단정하지 마."


translate japanese plot8_7324c104:



    voice "voice/banzhuren_162.ogg"
    banzhuren "꽤 복잡한 일이야. 원예부 학생들에게도 확인해야 해."


translate japanese plot8_0bd932e7:



    voice "voice/tianqin_1904.ogg"
    tianqin "복잡하다고요? 대체 누구길래……"


translate japanese plot8_74352c91:



    voice "voice/banzhuren_163.ogg"
    banzhuren "지금은 단정할 수 없어."


translate japanese plot8_7fb6f1f9:



    voice "voice/banzhuren_164.ogg"
    banzhuren "그러니까 원예부 학생들부터 만나서 물어봐야 해."


translate japanese plot8_f9efdd15:



    voice "voice/tianqin_1905.ogg"
    tianqin "그럼……츠루기와는 얘기해 보셨어요?"


translate japanese plot8_71ade427:



    voice "voice/banzhuren_165.ogg"
    banzhuren "그 애는……지난주에 얘기하러 갔지만, 역시 아무 말도 하려 하지 않았어."


translate japanese plot8_68bfbb95:



    voice "voice/tianqin_1906.ogg"
    tianqin "그렇구나…"


translate japanese plot8_27f673e1:



    voice "voice/tianqin_1907.ogg"
    tianqin "それなら、私が園芸部を手伝います！"


translate japanese plot8_2631a36f:



    voice "voice/banzhuren_166.ogg"
    banzhuren "아니, 이 일은 네가 신경 쓰지 않아도 돼."


translate japanese plot8_09f5c41d:



    voice "voice/banzhuren_167.ogg"
    banzhuren "학교에는 이미 보고했어. 조사 결과가 나올 때까지 원예부는 활동을 잠시 중단할 거야."


translate japanese plot8_d5287449:



    voice "voice/tianqin_1908.ogg"
    tianqin "하지만 학교가……"


translate japanese plot8_e85cc5bc:



    voice "voice/banzhuren_168.ogg"
    banzhuren "괜찮아. 안심해."


translate japanese plot8_b5072733:


    "라이라가 무슨 말을 하려는지 눈치챈 담임은 그녀의 말을 끊었다."


translate japanese plot8_74741319:



    voice "voice/banzhuren_169.ogg"
    banzhuren "教師としての誇りに懸けて、こんな行為を見過ごしはしない。"


translate japanese plot8_90e3d645:



    voice "voice/banzhuren_170.ogg"
    banzhuren "가해자들은 엄하게 처벌해서 퇴학시킬 거야."


translate japanese plot8_ef8b4ea3:



    voice "voice/banzhuren_171.ogg"
    banzhuren "다른 학교에서도 다시는 받아 주지 못하게 할 거고."


translate japanese plot8_697ca976:



    voice "voice/tianqin_1909.ogg"
    tianqin "선생님……"


translate japanese plot8_f1372030:



    voice "voice/banzhuren_172.ogg"
    banzhuren "내게 맡겨. 원래 이런 일은 우리 선생들이 해야 하는 거야."


translate japanese plot8_745e11db:



    voice "voice/banzhuren_173.ogg"
    banzhuren "다만 아직 이해가 안 되는 부분이 있어서, 섣불리 움직일 수는 없어."


translate japanese plot8_ea75ec24:



    voice "voice/tianqin_1910.ogg"
    tianqin "네——? 아직도 이해가 안 되는 게 있어요?"


translate japanese plot8_d0499e79:



    voice "voice/banzhuren_174.ogg"
    banzhuren "……지금껏 한 번도 거짓말을 하지 않은 아이가 갑자기 거짓말을 한다는 건, 좀처럼 있을 수 없는 일이야."


translate japanese plot8_7d9fa3c8:



    voice "voice/tianqin_1911.ogg"
    tianqin "어? 무슨 뜻이에요?"


translate japanese plot8_e39d73dd:



    voice "voice/banzhuren_175.ogg"
    banzhuren "그게 내가 이해하지 못하는 부분이지."


translate japanese plot8_869d1a74:



    voice "voice/tianqin_1912.ogg"
    tianqin "모르겠어요——그게 이 일들과 관계가 있어요?"


translate japanese plot8_91ff3f76:



    voice "voice/banzhuren_176.ogg"
    banzhuren "있지. 아주 깊은 관계가."


translate japanese plot8_6c5cd0f3:



    voice "voice/banzhuren_177.ogg"
    banzhuren "하지만 그것도 네가 고민할 일은 아니야."


translate japanese plot8_72133260:



    voice "voice/tianqin_1913.ogg"
    tianqin "그러면——제가 도와드릴 일은 없나요?"


translate japanese plot8_18308534:



    voice "voice/banzhuren_178.ogg"
    banzhuren "돕고 싶으면 열심히 복습해서 이번 주 월례 시험이나 잘 봐."


translate japanese plot8_7e6a9e00:



    voice "voice/banzhuren_179.ogg"
    banzhuren "성적만 올려 줘도 정말 큰 도움이 되겠어."


translate japanese plot8_de152327:



    voice "voice/tianqin_1914.ogg"
    tianqin "에이——"


translate japanese plot8_7774dac5:


    "한편, 라이라의 집."


translate japanese plot8_54006137:


    "아침 명상을 막 끝낸 시노스는 베란다에 서서, 아래로 오가는 사람들을 내려다보고 있었다."


translate japanese plot8_51f144eb:



    voice "voice/cygnus_1090.ogg"
    cygnus "목요일인가……"


translate japanese plot8_b1d39e17:


    "이 세계에 차츰 적응하고 있어서인지, 시노스는 명상으로 마력을 회복하는 효율이 꽤 높아졌음을 느꼈다."


translate japanese plot8_a167aa4b:


    "순조롭게 진행된다면 이번 주 목요일, 즉 며칠 뒤에는 상당한 양의 마력을 몸 안에 비축할 수 있을 것이다."


translate japanese plot8_9bb5fb9b:


    "전성기에는 한참 못 미치지만, 적어도 자신을 지킬 기본적인 힘은 갖추게 된다."


translate japanese plot8_4ebe7cf3:



    voice "voice/blackcat_04.ogg"
    blackcat "냐하하~ 안절부절못하는 꼴 좀 봐——"


translate japanese plot8_d289cb74:



    voice "voice/cygnus_1091.ogg"
    cygnus "……넌 왜 또 나왔어? 부르지도 않았는데."


translate japanese plot8_b441ffea:



    voice "voice/blackcat_13.ogg"
    blackcat "이 몸은 평범한 사역마가 아니거든. 마음대로 오갈 수 있지——"


translate japanese plot8_66d7a765:



    voice "voice/cygnus_1092.ogg"
    cygnus "설마 내 몸에 술식을 남겨 두고 몰래 마력을 빨아들이는 건 아니겠지?"


translate japanese plot8_5b07ffe2:


    "시노스는 양손으로 노리의 앞다리와 뒷다리를 각각 잡아, 몸을 길게 늘인 뒤 자세히 살펴보았다."


translate japanese plot8_68543787:



    voice "voice/blackcat_104.ogg"
    blackcat "うわあっ――！やめろ！早く下ろせ！　セクハラだぞ！" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_219dac29:



    voice "voice/cygnus_1093.ogg"
    cygnus "음……정말 별문제는 없네."


translate japanese plot8_48677c13:


    "시노스는 노리를 꼼꼼히 검사하고 나서야 놓아주었다."


translate japanese plot8_7983519d:



    voice "voice/blackcat_02.ogg"
    blackcat "흥! 이 몸은 내 고귀한 마력을 쓴다! 네 마력 따위를 훔쳐 쓰겠냐!"


translate japanese plot8_38c39cde:



    voice "voice/cygnus_1094.ogg"
    cygnus "노리."


translate japanese plot8_cc543cd0:



    voice "voice/blackcat_09.ogg"
    blackcat "응, 냐?"


translate japanese plot8_7bbd8c47:



    voice "voice/cygnus_1095.ogg"
    cygnus "네가 보기에 난 어떤 사람이야?"


translate japanese plot8_5a2591d8:



    voice "voice/blackcat_05.ogg"
    blackcat "그건 왜 물어?"


translate japanese plot8_6fec0d89:



    voice "voice/cygnus_1096.ogg"
    cygnus "그냥……궁금해서 물어본 거야."


translate japanese plot8_c21da2fa:



    voice "voice/blackcat_19.ogg"
    blackcat "냐하——하긴, 아무것도 기억 못 하니까."


translate japanese plot8_f90464d4:



    voice "voice/blackcat_13.ogg"
    blackcat "이 몸이 곰곰이 생각해 주마. 널 어떻게 말하면 좋을지——"


translate japanese plot8_de99cb18:



    voice "voice/blackcat_15.ogg"
    blackcat "아, 맞다. 넌 유난히 열받게 하는 녀석이야."


translate japanese plot8_f5cd7a1b:



    voice "voice/cygnus_1097.ogg"
    cygnus "뭐?"


translate japanese plot8_c38c2194:



    voice "voice/blackcat_111.ogg"
    blackcat "いてっ――！" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_bc9daf10:


    "시노스는 가차 없이 노리의 이마에 딱밤을 먹였다."


translate japanese plot8_ae6fdd61:



    voice "voice/blackcat_22.ogg"
    blackcat "왜 그래! 이 몸은 사실대로 말했을 뿐인데!"


translate japanese plot8_729913ff:



    voice "voice/cygnus_1098.ogg"
    cygnus "좀 더 구체적으로 말해."


translate japanese plot8_49e39765:



    voice "voice/blackcat_24.ogg"
    blackcat "뭐!? 귀찮게 구는 녀석이네!"


translate japanese plot8_86f6ef03:



    voice "voice/blackcat_06.ogg"
    blackcat "넌 말이다……마녀치고는 드물게 외부인들과도 제대로 대화할 줄 아는 편이었어. 에세리아에서도 나름대로 공적을 남겼지."


translate japanese plot8_4bfb34ca:



    voice "voice/blackcat_13.ogg"
    blackcat "친하게 지내는 모험가도 꽤 있어서, 녀석들의 의뢰를 자주 도와줬었지."


translate japanese plot8_a4b996ad:



    voice "voice/blackcat_14.ogg"
    blackcat "하지만 남한테 살갑게 구는 성격이라고는 못 하겠네……늘 뚱한 표정이었거든."


translate japanese plot8_c3276e0c:



    voice "voice/blackcat_04.ogg"
    blackcat "지금보다 백 배쯤 잘난 체하고, 게다가 엄청나게 제멋대로였지만 말이야. 냐하하!"


translate japanese plot8_4540da67:



    voice "voice/cygnus_1099.ogg"
    cygnus "응……"


translate japanese plot8_fcf3094a:


    "노리의 말을 들어 보니, 예전의 자신은 그렇게까지 지독한 마녀는 아니었던 모양이다."


translate japanese plot8_d3ac91b7:


    "오히려 마녀치고는 꽤 괜찮은 편이었다."


translate japanese plot8_ef2c07a8:


    "이는 용사와 함께 여행하던 기억 속의 「자신」과도 들어맞았다."


translate japanese plot8_185ac062:


    "그렇다면 그 끔찍한 기억은 대체 뭐였을까?"


translate japanese plot8_6a4cdb9d:


    "자신에게 무슨 일이 일어났는지 생각하면 할수록 알 수 없어졌다."


translate japanese plot8_69df4a93:



    voice "voice/cygnus_1100.ogg"
    cygnus "(됐어. 그만 생각하자.)"


translate japanese plot8_46f85916:



    voice "voice/cygnus_1101.ogg"
    cygnus "(일단 이번 주 목요일에 대비해야겠어.)"


translate japanese plot8_4263085f:


    "오후, 방과 후."


translate japanese plot8_31100624:



    voice "voice/npc6_31.ogg"
    npc6 "はぁ…一日中、復習だった…"


translate japanese plot8_739d5738:



    voice "voice/npc7_26.ogg"
    npc7 "우리 반도 그래. 체육 시간까지 생물 선생님한테 뺏겼다니까."


translate japanese plot8_4a6d956a:



    voice "voice/npc6_32.ogg"
    npc6 "뭐? 수업 시간을 막 뺏어도 돼? 교육위원회에 신고라도 하면……"


translate japanese plot8_50da65b4:



    voice "voice/npc7_27.ogg"
    npc7 "누가 신고하겠어. 우리 반 진도가 늦은 게 문제지."


translate japanese plot8_21fdcfb2:



    voice "voice/npc6_33.ogg"
    npc6 "우리 이번 주 체육 수업도 뺏기는 거 아냐?"


translate japanese plot8_e8c41dae:



    voice "voice/npc7_28.ogg"
    npc7 "그건 모르지."


translate japanese plot8_32beae24:



    voice "voice/npc7_29.ogg"
    npc7 "でも体育より、教室で授業を受ける方が楽じゃん！"


translate japanese plot8_a94bd55e:



    voice "voice/npc8_02.ogg"
    npc8 "어——새 영화 개봉했네. 보러 갈래?"


translate japanese plot8_c90ec3d3:



    voice "voice/npc9_02.ogg"
    npc9 "다음 주에 보자. 이번 주에는 일찍 집에 가서 복습해야 해."


translate japanese plot8_9cf41d4f:



    voice "voice/npc8_03.ogg"
    npc8 "あんたが真面目に勉強？優等生ぶっちゃって！"


translate japanese plot8_95af6606:



    voice "voice/npc9_03.ogg"
    npc9 "前の試験がひどすぎたんだよ！次も駄目なら、父さんに家庭教師つけられる！"


translate japanese plot8_d5041108:



    voice "voice/npc8_04.ogg"
    npc8 "와, 그건 좀 끔찍하다. 그럼 월례 시험 끝나고 보러 가자."


translate japanese plot8_577c0d18:



    voice "voice/npc9_04.ogg"
    npc9 "좋아."


translate japanese plot8_179ac0f8:


    "하교 시간이 되자 시험 준비로 팽팽했던 분위기도 조금 풀렸다. 학생들은 평소처럼 웃고 떠들며 학교를 나섰다."


translate japanese plot8_c46a9543:


    "원예부에서 일어난 사건은 이미 학교 안에 퍼져 있었지만, 대부분의 학생에게는 아무런 영향도 없었다."


translate japanese plot8_fdab53b6:


    "관심 밖의 동아리에서 무슨 일이 벌어지든 대수롭지 않았다. 오늘에서야 원예부라는 동아리가 있다는 사실을 안 학생도 많았다."


translate japanese plot8_7ae7ae7d:


    "でも園芸部の生徒たちにとって、今日の出来事は忘れられないほどつらいものだった。"


translate japanese plot8_51c2a584:



    voice "voice/tianqin_1915.ogg"
    tianqin "하아——"


translate japanese plot8_3bda2210:



    voice "voice/yangxi_701.ogg"
    yangxi "설마 또 원예부로 돌아가거나 하지는 마."


translate japanese plot8_2c4fccae:



    voice "voice/tianqin_1916.ogg"
    tianqin "안 가! 내가 더 할 수 있는 일이 없나 생각했을 뿐이야."


translate japanese plot8_d94970d2:



    voice "voice/yangxi_702.ogg"
    yangxi "너무 고민하지 말고 담임 선생님께 맡겨."


translate japanese plot8_b89a1df2:



    voice "voice/yangxi_703.ogg"
    yangxi "원예부 애들은 우리 앞에선 더 입을 열기 힘들 거야."


translate japanese plot8_d00cbcae:



    voice "voice/tianqin_1917.ogg"
    tianqin "그렇겠지……"


translate japanese plot8_d53441fd:



    voice "voice/yangxi_704.ogg"
    yangxi "이제 어디 놀러 갈래? 나 오늘은 시간 많아."


translate japanese plot8_12cb73a1:



    voice "voice/tianqin_1918.ogg"
    tianqin "아, 미안. 오늘은 일찍 돌아갈게."


translate japanese plot8_be33824a:



    voice "voice/yangxi_705.ogg"
    yangxi "왜? 집에 무슨 일 있어?"


translate japanese plot8_efe758b7:



    voice "voice/tianqin_1919.ogg"
    tianqin "아니, 그냥 일찍 가서 복습 좀 하려고."


translate japanese plot8_29deae11:



    voice "voice/yangxi_706.ogg"
    yangxi "오늘 해가 동쪽에서 제대로 뜬 거 맞지?"


translate japanese plot8_993c0987:



    voice "voice/tianqin_1920.ogg"
    tianqin "너무해! 나도 열심히 공부할 때가 있거든!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_2408818f:



    voice "voice/yangxi_707.ogg"
    yangxi "한 학기에 대략 네 번 정도?"


translate japanese plot8_dbde225c:



    voice "voice/tianqin_1921.ogg"
    tianqin "어……그 정도지."


translate japanese plot8_305534bb:



    voice "voice/npc3_14.ogg"
    npc3 "저기, 실례합니다——"


translate japanese plot8_2cb4131e:



    voice "voice/tianqin_1922.ogg"
    tianqin "어?"


translate japanese plot8_43b7af21:


    "라이라는 고개를 돌렸다. 단정하고 야무진 차림의 여성이 말을 걸고 있었다."


translate japanese plot8_6d5b35a2:


    voice "voice/npc3_15.ogg"
    mama3 "라이라 씨, 맞죠?"


translate japanese plot8_f6867a6d:



    voice "voice/tianqin_1923.ogg"
    tianqin "네, 맞아요! 저한테 무슨 일이세요?"


translate japanese plot8_a22486d3:



    voice "voice/mama_01.ogg"
    mama "아키 엄마예요. 그 아이가 사진을 보여 준 적이 있어요."


translate japanese plot8_bfbef9c0:



    voice "voice/tianqin_1924.ogg"
    tianqin "아! 안녕하세요! 반장 데리러 오셨어요?"


translate japanese plot8_a2c14749:



    voice "voice/mama_02.ogg"
    mama "네. 오늘 마침 시간이 나서 데리러 왔어요."


translate japanese plot8_0edb9537:



    voice "voice/tianqin_1925.ogg"
    tianqin "반장은 오늘 반 일을 좀 처리해야 해서, 금방 나오지는 못할 거예요."


translate japanese plot8_5a964856:



    voice "voice/mama_03.ogg"
    mama "そうでしたか。今日は体育生の練習が早く終わると聞いて、早めに連れて帰れると思っていたんです。"


translate japanese plot8_9759d1ac:



    voice "voice/tianqin_1926.ogg"
    tianqin "うーん…最近、委員長は忙しいですからね。今日は時間通りに帰れないかも。"


translate japanese plot8_71d325d1:



    voice "voice/mama_04.ogg"
    mama "알겠어요. 여기서 기다릴게요."


translate japanese plot8_eb287654:



    voice "voice/mama_05.ogg"
    mama "そういえば、私も普段は残業ばかりで、あの子には夕食まで一人で済ませてもらっていて…"


translate japanese plot8_2c3de1fa:


    mama "本当に情けないです。あの子を十分に気にかけてあげられなくて。"


translate japanese plot8_8c1d3d77:



    voice "voice/tianqin_1927.ogg"
    tianqin "아니에요, 아니에요! 아주머니, 그렇게 말씀하지 마세요."


translate japanese plot8_7f8fd5f3:



    voice "voice/tianqin_1928.ogg"
    tianqin "반장이 늘 얘기해요. 어머니가 자기 목표라고요!"


translate japanese plot8_021a1c92:



    voice "voice/mama_07.ogg"
    mama "そう…あの子が、そんなことを…"


translate japanese plot8_71946a45:



    voice "voice/mama_08.ogg"
    mama "少し前までずっと思い詰めた様子だったから、きちんと話を聞いてあげられなかったんじゃないかと心配していたんです。"


translate japanese plot8_f524d478:



    voice "voice/mama_09.ogg"
    mama "그런데 요즘은 집에서 라이라 씨 얘기를 자주 해요. 친한 친구가 되었다고요."


translate japanese plot8_1f9fcf21:



    voice "voice/mama_10.ogg"
    mama "それからは、ずいぶん明るくなりました。それは多分ライラさんのおかげです。"


translate japanese plot8_e1a640a5:



    voice "voice/tianqin_1929.ogg"
    tianqin "いやあ、そんな。褒めすぎですよ。"


translate japanese plot8_7906f18d:



    voice "voice/tianqin_1930.ogg"
    tianqin "며칠 전에 친구랑 같이 반장을 이 근처로 데리고 나왔거든요. 아마 그게 기분 전환이 된 것 같아요."


translate japanese plot8_fda4461f:



    voice "voice/mama_11.ogg"
    mama "네. 먼저 불러 준 덕분이지요."


translate japanese plot8_b6eb9031:



    voice "voice/mama_12.ogg"
    mama "그 아이는 어릴 때부터 수줍음이 많아서……"


translate japanese plot8_8974aaa3:


    "라이라와 반장 어머니의 이야기는 금세 활기를 띠었다."


translate japanese plot8_1e245ee4:


    "二人に共通する話題は委員長だ。話すことも、当然彼女のことばかりになる。"


translate japanese plot8_a9761731:



    voice "voice/yangxi_708.ogg"
    yangxi "(얼마나 오래 얘기할 셈이지?)"


translate japanese plot8_d02f85ff:


    "라이라가 대화에 푹 빠진 것을 보고, 히나타는 그녀를 두고 혼자 상점가의 밀크티 가게로 향했다."


translate japanese plot8_2ba3783f:


    "15분 뒤——"


translate japanese plot8_bd4033a8:



    voice "voice/yangxi_709.ogg"
    yangxi "뭐야? 아직도 얘기해?"


translate japanese plot8_70bfcdc0:


    "상점가에서 밀크티를 사서 돌아와 보니, 라이라는 아직도 반장 어머니와 즐겁게 이야기에 열중하고 있었다."


translate japanese plot8_93632d81:



    voice "voice/yangxi_710.ogg"
    yangxi "못 말리겠네. 나 먼저 마신다."


translate japanese plot8_a10b9236:


    "대인 관계에서 히나타와 라이라는 정반대의 성격이었다."


translate japanese plot8_72f0970a:


    "히나타는 이런 교류를 귀찮게 여겨, 되도록 피하려고 한다."


translate japanese plot8_7b8bbf62:


    "하지만 라이라는 다르다. 흥미가 생기면 상대가 누구든 먼저 말을 건다."


translate japanese plot8_305522ab:


    "타고난 뛰어난 친화력 덕에, 상대가 누구든 금세 이야기에 꽃이 피었다."


translate japanese plot8_c638662b:



    voice "voice/yangxi_711.ogg"
    yangxi "대체 언제까지 얘기하는 거야——"


translate japanese plot8_38205dfb:



    voice "voice/tianqin_1931.ogg"
    tianqin "오——반장이 집에서는 그렇구나……"


translate japanese plot8_6c4558ce:



    voice "voice/mama_13.ogg"
    mama "의외죠?"


translate japanese plot8_4b3de37f:



    voice "voice/tianqin_1932.ogg"
    tianqin "정말 생각도 못 했어요."


translate japanese plot8_8776259f:


    "두 사람은 십여 분이나 이야기를 나눴지만, 반장에 관한 화제는 여전히 끝날 기미가 없었다."


translate japanese plot8_9deb3b33:



    voice "voice/mama_14.ogg"
    mama "라이라 씨, 한 가지 더 부탁드려도 될까요?"


translate japanese plot8_3d40263f:



    voice "voice/tianqin_1933.ogg"
    tianqin "네! 제가 할 수 있는 거라면 뭐든 말씀해 주세요."


translate japanese plot8_1c1b2996:



    voice "voice/mama_15.ogg"
    mama "아키는 제 기분을 너무 신경 써서, 힘든 일이 있어도 아무 말도 안 해 줘요."


translate japanese plot8_7408c626:



    voice "voice/mama_16.ogg"
    mama "あの子が落ち込んでいる時は、どうか声をかけて、話を聞いていただけないのでしょうか。"


translate japanese plot8_b84fabd2:



    voice "voice/mama_17.ogg"
    mama "家では毎日笑顔を見せてくれるから、本当は無理をしているのか、私には分からない時があって…"


translate japanese plot8_b49278c8:



    voice "voice/mama_18.ogg"
    mama "でも、ライラさんになら、あの子も話を話せると思います。"


translate japanese plot8_9bf0371b:



    voice "voice/tianqin_1934.ogg"
    tianqin "걱정 마세요. 반장이랑 많이 얘기할게요."


translate japanese plot8_2aa37698:



    voice "voice/tianqin_1935.ogg"
    tianqin "그리고 반장 잘 지내니까, 너무 걱정하지 마세요."


translate japanese plot8_1b60f853:



    voice "voice/mama_19.ogg"
    mama "네. 그렇게 말해 주니 조금 안심이 되네요."


translate japanese plot8_7d50cbd6:


    banzhang "어? 엄마랑……라이라 씨?"


translate japanese plot8_0258685b:



    voice "voice/tianqin_1936.ogg"
    tianqin "아, 반장!"


translate japanese plot8_7c644d3e:



    voice "voice/mama_20.ogg"
    mama "아키."


translate japanese plot8_fbf88c7e:



    voice "voice/banzhang_364.ogg"
    banzhang "엄마, 여긴 어쩐 일이야?"


translate japanese plot8_8d20c28b:



    voice "voice/banzhang_365.ogg"
    banzhang "그리고 라이라 씨도……"


translate japanese plot8_90d87277:



    voice "voice/mama_21.ogg"
    mama "今日は早く仕事を上がれたから、学校まで迎えに来たの。"


translate japanese plot8_805911c8:



    voice "voice/mama_22.ogg"
    mama "마침 라이라를 만나서 잠깐 얘기했어."


translate japanese plot8_5f5048a3:



    voice "voice/tianqin_1937.ogg"
    tianqin "헤헤."


translate japanese plot8_b48fb39b:



    voice "voice/banzhang_366.ogg"
    banzhang "엄마, 라이라 씨에게 이상한 얘기는 안 하셨죠?"


translate japanese plot8_f5374652:



    voice "voice/mama_23.ogg"
    mama "아니, 그냥 공부 얘기만 조금 했어."


translate japanese plot8_f7253d75:



    voice "voice/banzhang_367.ogg"
    banzhang "으으……그런가요……"


translate japanese plot8_83c73dfb:



    voice "voice/banzhang_368.ogg"
    banzhang "라이라 씨, 이번 주말에는 제대로 복습하셨죠?"


translate japanese plot8_3817df28:



    voice "voice/tianqin_1938.ogg"
    tianqin "물론이지. 이번 시험에서는 내가 너보다 잘 볼지도 몰라!"


translate japanese plot8_223c4505:



    voice "voice/banzhang_369.ogg"
    banzhang "그건 다음 시험까지 기다리셔야겠네요."


translate japanese plot8_c05be88c:



    voice "voice/banzhang_370.ogg"
    banzhang "이번 월례 시험은 체육 특기생은 안 봐요. 마침 체육 시험이랑 겹치거든요."


translate japanese plot8_2a90a6aa:



    voice "voice/tianqin_1939.ogg"
    tianqin "에이, 그런 게 어디 있어?"


translate japanese plot8_56828797:



    voice "voice/tianqin_1940.ogg"
    tianqin "좋겠다. 나도 체육 특기생 하고 싶어졌어."


translate japanese plot8_22450c7c:



    voice "voice/banzhang_371.ogg"
    banzhang "후후, 그럼 먼저 갈게요."


translate japanese plot8_4b245e01:



    voice "voice/banzhang_372.ogg"
    banzhang "시험 잘 보세요, 라이라 씨."


translate japanese plot8_445c59be:



    voice "voice/tianqin_1941.ogg"
    tianqin "うん。委員長も体育テスト、頑張ってね。"


translate japanese plot8_a3c3042b:



    voice "voice/tianqin_1942.ogg"
    tianqin "하아……"


translate japanese plot8_dd7d8dd2:



    voice "voice/tianqin_1943.ogg"
    tianqin "（やっぱり、聞けなかったな…）"


translate japanese plot8_aca7ad48:



    voice "voice/yangxi_712.ogg"
    yangxi "얘기 끝났어?"


translate japanese plot8_b9bb806d:



    voice "voice/tianqin_1944.ogg"
    tianqin "응, 끝났어."


translate japanese plot8_45eafdb9:



    voice "voice/tianqin_1945.ogg"
    tianqin "……어? 밀크티 마셔? 내 건?"


translate japanese plot8_3de0b002:



    voice "voice/yangxi_713.ogg"
    yangxi "네 건 안 샀어."


translate japanese plot8_047ccc9a:



    voice "voice/tianqin_1946.ogg"
    tianqin "거짓말! 그거 분명 두 잔째잖아. 봉투도 두 잔짜리고!"


translate japanese plot8_a00b4957:



    voice "voice/yangxi_714.ogg"
    yangxi "아……그런가?"


translate japanese plot8_bb22b291:



    voice "voice/tianqin_1947.ogg"
    tianqin "모른 척해도 소용없어! 한 잔 더 사러 같이 가!"


translate japanese plot8_e4d261b6:



    voice "voice/yangxi_715.ogg"
    yangxi "그래, 그래……"


translate japanese plot8_f0ae321f:



    voice "voice/npc38_01.ogg"
    npc38 "——현재 길드에서 가장 우선적으로 해결해야 할 의뢰입니다."


translate japanese plot8_d2911660:



    voice "voice/npc38_02.ogg"
    npc38 "긴급 의뢰라 보수도 다른 의뢰의 두 배예요."


translate japanese plot8_ab7b736d:



    voice "voice/npc38_03.ogg"
    npc38 "물론 사고를 일으킨 사람이 누구인지 밝혀 주시면, 보수는 더 올려 드릴 수도 있습니다."


translate japanese plot8_640deb3b:



    voice "voice/npc38_04.ogg"
    npc38 "거리가 좀 머니 이 지도를 가져가세요."


translate japanese plot8_39b1c2bb:



    voice "voice/dorothea_64.ogg"
    dorothea "오, 고마워!"


translate japanese plot8_1c8748e5:



    voice "voice/dorothea_65.ogg"
    dorothea "와, 지도로 보니 정말 좀 머네."


translate japanese plot8_71c1c8c2:



    voice "voice/npc38_05.ogg"
    npc38 "정말 죄송해요! 이 마을에는 상주하는 모험가가 없어서, 계속 해결하지 못한 의뢰거든요……"


translate japanese plot8_fb46af82:



    voice "voice/npc38_06.ogg"
    npc38 "지금은 마을에서 살인 사건까지 일어나 다들 겁에 질려 있어요. 경비병들도 점점 일손이 부족해졌고요."


translate japanese plot8_b452fb65:



    voice "voice/npc38_07.ogg"
    npc38 "괜찮으시다면 저희를 도와주세요."


translate japanese plot8_506a50e8:



    voice "voice/dorothea_66.ogg"
    dorothea "괜찮아. 우리에게 맡겨."


translate japanese plot8_80244274:



    voice "voice/npc38_08.ogg"
    npc38 "정말 감사합니다."


translate japanese plot8_d274e8d0:



    voice "voice/npc38_09.ogg"
    npc38 "보급품이 필요하시면 마을 남쪽 잡화점에서 사세요. 주인이 할인해 드릴 거예요."


translate japanese plot8_95f6bc98:



    voice "voice/dorothea_67.ogg"
    dorothea "그건 괜찮아. 가지고 있는 걸로 충분할 거야."


translate japanese plot8_b1be559c:



    voice "voice/dorothea_68.ogg"
    dorothea "그나저나 이 의뢰 말고, 마을 근처에 다른 이상한 일은 없었어?"


translate japanese plot8_0603d863:



    voice "voice/npc38_10.ogg"
    npc38 "음——그러고 보니……"


translate japanese plot8_996f722b_1:


    voice "voice/gt_10.ogg"
    nvl_npc14 "…"


translate japanese plot8_8d3887ed:


    nvlNone "나와 용사는 모험가 길드 밖에서\n도로시아가 의뢰 수속을 마치기를 기다리고 있었다."


translate japanese plot8_f4440b3b:


    "面倒が嫌いな私たちは、自分からギルドへ行くことはほとんどない。"


translate japanese plot8_00b8c7b0:


    nvl clear
    nvlNone "다행히 도로시아는 사람 상대하는 데 능숙하다.\n이 「중책」은 자연스레 그녀에게 맡기게 되었다."


translate japanese plot8_f8e05e9c:


    nvlNone "도로시아에게는 묘한 친근함이 있어서,\n상대가 누구든 금세 대화를 시작할 수 있다." (**end_page())


translate japanese plot8_27adac91:


    nvl clear
    nvlNone "그런 성격 덕에 예상치 못한 정보를 얻는 일도 적지 않았다." (**end_page())


translate japanese plot8_87e355ac:



    voice "voice/dorothea_69.ogg"
    dorothea "다녀왔어."


translate japanese plot8_8cbd85a2:



    voice "voice/champion_115.ogg"
    champion "뭐 알아낸 거 있어?"


translate japanese plot8_b4a7bd1f:



    voice "voice/dorothea_70.ogg"
    dorothea "음……아니. 아무도 맡으려 하지 않는 의뢰 하나만 받았어."


translate japanese plot8_1585c092:



    voice "voice/champion_116.ogg"
    champion "무슨 의뢰인데? 까다로운 마물이 나타났어?"


translate japanese plot8_929db017:



    voice "voice/dorothea_71.ogg"
    dorothea "아니. 의뢰 장소가 꽤 멀어서 아무도 안 맡는 거야."


translate japanese plot8_1faf36b5:


    "도로시아는 방금 받은 지도를 펼쳐 한쪽 구석을 가리켰다."


translate japanese plot8_c0f116db:



    voice "voice/dorothea_72.ogg"
    dorothea "여기로 가서 길을 막은 큰 바위를 치워 달래. 산적이 굴려 내린 모양이야."


translate japanese plot8_88b87e6c:



    voice "voice/champion_117.ogg"
    champion "정말 멀긴 머네."


translate japanese plot8_fe3b08ef:



    voice "voice/equinox_150.ogg"
    equinox 0401 "「열쇠」와는 별 관계없는 의뢰 같네."


translate japanese plot8_35f45477:



    voice "voice/equinox_151.ogg"
    equinox 0401 "이제 어떻게 할까? 일단 왕도에 돌아가고, 여기는 다른 용사 파티에 맡길까?"


translate japanese plot8_37e572c2:



    voice "voice/champion_118.ogg"
    champion "응, 나도 그렇게 생각했어."


translate japanese plot8_b188cadc:



    voice "voice/champion_119.ogg"
    champion "여기 있어도 단서를 못 찾으니, 일단 왕도에 돌아가서 새 정보가 있나 보자."


translate japanese plot8_59e2d0a5:



    voice "voice/dorothea_73.ogg"
    dorothea "그럼 이 의뢰는? 가서 취소할까?"


translate japanese plot8_d5fd7a5a:



    voice "voice/champion_120.ogg"
    champion "……아니, 다녀오자. 길드에서도 그렇게 부탁하잖아."


translate japanese plot8_92645968:



    voice "voice/champion_121.ogg"
    champion "서두르면 하루 만에 왕복할 수 있어."


translate japanese plot8_32522e33:



    voice "voice/champion_122.ogg"
    champion "괜찮지, 아사요?"


translate japanese plot8_c40eda5d:



    voice "voice/equinox_152.ogg"
    equinox 0401 "네가 대장이니 네 뜻에 따를게."


translate japanese plot8_2a99d96f:



    voice "voice/champion_123.ogg"
    champion "가기 싫으면 여기 남아 있어도 괜찮아."


translate japanese plot8_18678aa9:


    nvlNone "그렇게 먼 곳까지 따라갈 생각은 없었다. 하지만 두 사람이 사라지면 그 아이들이 내게 들러붙을 것이다."


translate japanese plot8_19db80f0:


    nvlNone "아무리 생각해도, 둘을 따라가는 편이 나았다."


translate japanese plot8_a10de5c9:



    voice "voice/equinox_153.ogg"
    nvl_equinox "역시 같이 갈게." (**end_page())


translate japanese plot8_8f00fb39:



    voice "voice/equinox_154.ogg"
    nvl_equinox "쳇——!"


translate japanese plot8_05ff00ef:


    nvlNone "마을을 나와 숲에 들어섰을 때, 문득 위화감을 느꼈다." (**end_page())


translate japanese plot8_26c1a351:



    voice "voice/champion_124.ogg"
    nvl_champion "왜 그래?"


translate japanese plot8_07ae00ef:



    voice "voice/equinox_155.ogg"
    nvl_equinox "아니……아무것도 아냐."


translate japanese plot8_843d0787:


    nvlNone "뒤돌아서 탐지 마법으로 뒤쪽 마을을 한 차례 살폈다. 하지만 아무것도 발견하지 못했다." (**end_page())


translate japanese plot8_c75955d8:



    nvl clear
    voice "voice/equinox_156.ogg"
    nvl_equinox "(착각인가……)" (what_prefix="", what_suffix="", **end_page())


translate japanese plot8_3f2953d4:


    nvlNone "두 시간 뒤."


translate japanese plot8_30477504:



    voice "voice/equinox_157.ogg"
    nvl_equinox "후, 후, 후……"


translate japanese plot8_0c942bcf:


    nvlNone "나는 후회했다."


translate japanese plot8_6f20cd2f:


    nvlNone "용사 일행을 따라오기보다는 마을에 남아 있어야 했다." (**end_page())


translate japanese plot8_096f2014:


    nvl clear
    nvlNone "하루 만에 마을로 돌아올 수 있도록,\n마을을 나선 뒤 한 번도 쉬지 않고 발길을 재촉하고 있었다."


translate japanese plot8_50edee55:


    nvlNone "별것 아닐 줄 알았는데,\n아무래도 내 체력을 과대평가한 모양이다." (**end_page())


translate japanese plot8_27c50f89:



    voice "voice/dorothea_74.ogg"
    nvl_dorothea "업어 줄까?"


translate japanese plot8_bd7504d9:



    voice "voice/equinox_158.ogg"
    nvl_equinox "후, 하……저리 가……"


translate japanese plot8_7ecf2506:


    nvlNone "예전의 나라면 아무 생각 없이 도로시아의 등에 올라탔을 것이다." (**end_page())


translate japanese plot8_4f5818f0:


    nvl clear
    nvlNone "하지만 다른 사람……특히 용사 앞에서 그런 부탁을 하기에는 너무 부끄럽다."


translate japanese plot8_ec4996ac:


    nvlNone "아무리 그래도 그런 모습을 남에게 보이기는 너무 부끄러웠다."


translate japanese plot8_34e0ef20:



    voice "voice/equinox_159.ogg"
    nvl_equinox "후——다음, 다음에는 꼭 마차를 탈 거야……" (**end_page())


translate japanese plot8_ec98278e:



    voice "voice/dorothea_75.ogg"
    nvl_dorothea "용사——우리 좀 쉴까?"


translate japanese plot8_0a6694ce:



    voice "voice/dorothea_76.ogg"
    nvl_dorothea "계속 가면 아사요가 못 따라오겠어."


translate japanese plot8_5d4635f7:



    voice "voice/champion_125.ogg"
    nvl_champion "그럼 잠깐 쉬자." (**end_page())


translate japanese plot8_08bcae37:



    voice "voice/equinox_160.ogg"
    nvl_equinox "후——"


translate japanese plot8_1b451452:


    nvlNone "내 체력으로는 괴물처럼 기운이 넘치는 저 두 사람을 따라갈 수 있을 리가 없다."


translate japanese plot8_35c9a0a5:


    nvlNone "쉬는 동안 회복 마법을 걸어\n서둘러 두 다리의 피로를 풀었다." (**end_page())


translate japanese plot8_cb8b526f:


    voice "voice/champion_126.ogg"
    nvl_champion "으음……"


translate japanese plot8_50bd4a1b:


    nvlNone "용사는 내 옆에 앉아\n깃펜을 쥔 채 빈 양피지를 앞에 두고 머리를 싸매고 있었다."


translate japanese plot8_b281d011:


    voice "voice/equinox_161.ogg"
    nvl_equinox "{a=dictionary:dict_entry_86}용사부{/a}에 낼 보고서?" (**end_page())


translate japanese plot8_668efdd0:



    nvl clear
    voice "voice/champion_127.ogg"
    nvl_champion "응. 왕도로 돌아가게 되고서야 겨우 생각났어."


translate japanese plot8_c8f64637:



    voice "voice/equinox_162.ogg"
    nvl_equinox "대충 아무거나 써서\n끝내면 돼."


translate japanese plot8_bc4689b9:



    voice "voice/champion_128.ogg"
    nvl_champion "나도 그렇게 생각했는데, 하루하루 기록이 필요한 모양이야."


translate japanese plot8_7a41d737:



    voice "voice/equinox_163.ogg"
    nvl_equinox "……일기처럼?" (**end_page())


translate japanese plot8_7048e19b:



    voice "voice/champion_129.ogg"
    nvl_champion "응."


translate japanese plot8_85558c6d:



    voice "voice/equinox_164.ogg"
    nvl_equinox "그런데 밀린 게 며칠 치야?" (**end_page())


translate japanese plot8_5167056f:



    nvl clear
    voice "voice/champion_130.ogg"
    nvl_champion "왕도를 떠난 뒤 지금까지……서너 순 정도 됐을 거야."


translate japanese plot8_83b8349f:



    voice "voice/equinox_165.ogg"
    nvl_equinox "그거 지옥이네." (**end_page())


translate japanese plot8_1abc52dd:



    voice "voice/champion_131.ogg"
    nvl_champion "아아——"


translate japanese plot8_fb1de674:


    nvlNone "용사는 머리를 긁적이며 고민에 빠졌다."


translate japanese plot8_bf6d29d5:


    nvlNone "하루를 한 문장으로 때운다고 해도, 서른,\n마흔 날 치를 몰아서 쓰기는 힘들다." (**end_page())


translate japanese plot8_3f77a07f:


    nvl clear
    nvlNone "게다가 이번에는 「최강의 용사」가 나섰는데도 아무런 성과가 없다. 돌아가면 용사부에서 호되게 추궁을 당할 것이다." (**end_page())


translate japanese plot8_d538b878:


    voice "voice/champion_132.ogg"
    nvl_champion "보고서를 다 쓰면 그 꼬맹이들한테 훈련소 추천서도 써 줘야 하는데……"


translate japanese plot8_8b2a132a:


    voice "voice/champion_133.ogg"
    nvl_champion "뭘 먹고 있어?"


translate japanese plot8_56778ba4:


    nvlNone "내가 뭔가 씹는 걸 눈치채고 용사가 흥미롭다는 듯 물었다." (**end_page())


translate japanese plot8_53dc0f8a:


    nvl clear
    nvlNone "——물론 그녀에게 보여 주려고 일부러 그러고 있었다."


translate japanese plot8_ed29aa6f:


    voice "voice/equinox_166.ogg"
    nvl_equinox "박하콩."


translate japanese plot8_03d105b9:


    voice "voice/equinox_167.ogg"
    nvl_equinox "마을을 나올 때 잡화점에서 보여서 한 병 사 뒀어."


translate japanese plot8_d2fe4931:


    voice "voice/champion_134.ogg"
    nvl_champion "그게 뭔데?" (**end_page())


translate japanese plot8_8d5f9d78:


    voice "voice/equinox_168.ogg"
    nvl_equinox "용사는 박하콩 몰라?"


translate japanese plot8_7aaabf7c:


    voice "voice/champion_135.ogg"
    nvl_champion "응——?"


translate japanese plot8_7be70634:


    nvlNone "병에서 박하콩 몇 알을 손바닥에 덜었다. 용사는 초록색 콩을\n신기하다는 듯 바라보았다. 아무래도 정말 모르는 모양이다." (**end_page())


translate japanese plot8_85acc2e2:


    voice "voice/equinox_169.ogg"
    nvl_equinox "마법사들이 자주 먹는 간식이야. 잠을 깨워 주지."


translate japanese plot8_ee4c6abe:


    voice "voice/champion_136.ogg"
    nvl_champion "오……이런 건 처음 보네." (**end_page())


translate japanese plot8_5af8b296:


    voice "voice/equinox_170.ogg"
    nvl_equinox "(좋아, 걸려들었어.)" (what_prefix="", what_suffix="")


translate japanese plot8_b42c1d34:


    nvlNone "웃음이 터질 것 같은 걸 필사적으로 참으며, 용사를 조금 더 꾀어 보았다." (**end_page())


translate japanese plot8_878d112b:


    voice "voice/equinox_171.ogg"
    nvl_equinox "먹어 볼래?" (**end_page())


translate japanese plot8_6561c4eb:


    nvlNone "그때 근처에서 망을 보던 도로시아가\n갑자기 뒤를 돌아보았다."


translate japanese plot8_a276f3f7:


    voice "voice/dorothea_77.ogg"
    nvl_dorothea "아니, 아사요! 용사한테 이상한 거 가르치지 마!" (**end_page()) with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_040efa40:


    voice "voice/dorothea_78.ogg"
    nvl_dorothea "용사, 그건 별로\n좋은 게 아니야."


translate japanese plot8_397abab8:


    voice "voice/dorothea_79.ogg"
    nvl_dorothea "버릇이 돼서 계속 먹다가 몸을 망친 사람도 많거든." (**end_page())


translate japanese plot8_7317b39a:


    voice "voice/equinox_172.ogg"
    nvl_equinox "과장이야. 그렇게 쉽게\n중독되지는 않아."


translate japanese plot8_5aecf9ce:


    voice "voice/champion_137.ogg"
    nvl_champion "으음——" (**end_page())


translate japanese plot8_fc01aedb:


    nvlNone "결국 용사는 호기심에 지고, 내 손에서 박하콩 몇 알을 받아 갔다."


translate japanese plot8_81334816:


    voice "voice/dorothea_80.ogg"
    nvl_dorothea "하아——" (**end_page())


translate japanese plot8_02707e7f:


    nvl clear
    nvlNone "말려도 소용없다는 걸 알고 도로시아는 포기한 듯 고개를 저었다." (**end_page())


translate japanese plot8_c6351c20:


    voice "voice/champion_138.ogg"
    nvl_champion "으——! 써! 매워!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_07539d68:


    voice "voice/equinox_173.ogg"
    nvl_equinox "후후." (**end_page())


translate japanese plot8_35d99da7:


    nvl clear
    nvlNone "처음 먹는 사람은 누구나 그 독특한 맛에 놀란다. 용사의 표정이 변하는 모습을 흥미롭게 바라보았다." (**end_page())


translate japanese plot8_4fe4a197:


    nvl clear
    voice "voice/champion_139.ogg"
    nvl_champion "고추랑 여주를 한꺼번에 입에 쑤셔 넣은 것 같아……!"


translate japanese plot8_0ed915c9:


    voice "voice/champion_140.ogg"
    nvl_champion "마법사들은 이렇게 자극적인 걸 간식으로 먹는구나." (**end_page())


translate japanese plot8_6c4cb3b6:


    nvl clear
    voice "voice/equinox_174.ogg"
    nvl_equinox "응. 강한 맛이 머리를 맑게 하고, 생각도 정리하기 쉽게 해 줘.\n마법을 쓸 때 도움이 되지." (**end_page())


translate japanese plot8_84dc90cc:


    nvl clear
    voice "voice/equinox_175.ogg"
    nvl_equinox "참고로\n이건 마력 회복제의 재료이기도 해." (**end_page())


translate japanese plot8_5f8c9ffe:


    voice "voice/champion_141.ogg"
    nvl_champion "그 말을 듣고 보니,\n이 자극 덕분에 머리가 완전히 맑아진 것 같네……" (**end_page())


translate japanese plot8_69467b6f:


    nvl clear
    voice "voice/champion_142.ogg"
    nvl_champion "음, 한 줌 더 줄 수 있어?"


translate japanese plot8_b7587b31:


    voice "voice/dorothea_81.ogg"
    nvl_dorothea "잠깐, 용사! 중독되기 쉽다고 방금 말했잖아!" (**end_page())


translate japanese plot8_c83e48b1:


    nvl clear
    voice "voice/champion_143.ogg"
    nvl_champion "괜찮아. 조절할 수 있어." (**end_page())


translate japanese plot8_0b327f5c:


    nvl clear
    voice "voice/dorothea_82.ogg"
    nvl_dorothea "하아……이름만 보면 무해한 콩 같지만, 다른 이름은 「악마의 씨앗」이라고." (**end_page())


translate japanese plot8_02dcc891:


    nvl clear
    voice "voice/dorothea_83.ogg"
    nvl_dorothea "이스트국에서는 금지 품목으로 지정되기까지 했어."


translate japanese plot8_3aad5417:


    voice "voice/champion_144.ogg"
    nvl_champion "괜찮아. 그냥 신기해서 맛만 보는 거야." (**end_page())


translate japanese plot8_b6515602:


    nvl clear
    voice "voice/equinox_176.ogg"
    nvl_equinox "후후…"


translate japanese plot8_04bc2ec4:


    voice "voice/dorothea_84.ogg"
    nvl_dorothea "정말, 무슨 짓을 한 거야!" (**end_page()) with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot8_2f5d662b:


    nvl clear
    voice "voice/equinox_177.ogg"
    nvl_equinox "걱정 마. 쟤는 용사잖아."


translate japanese plot8_faeb6230:


    voice "voice/equinox_178.ogg"
    nvl_equinox "이깟 간식 조금 먹는다고 죽기라도 하겠어?" (**end_page())


translate japanese plot8_537a7307:


    nvl clear
    voice "voice/dorothea_85.ogg"
    nvl_dorothea "에휴, 나중에 무슨 일 생겨도 난 몰라." (**end_page())


translate japanese plot8_0c2c4cc0:


    nvlNone "우리의 이동 속도는 예상보다 조금 빨랐다."


translate japanese plot8_4805ead8:


    nvlNone "나 때문에 도중에 몇 번 쉬었지만, 그래도 해가 꼭 머리 위에 왔을 무렵에는 의뢰 장소에 도착해 있었다." (**end_page())


translate japanese plot8_6d1240fc:



    voice "voice/dorothea_86.ogg"
    nvl_dorothea "도착했어——!"


translate japanese plot8_8f369f64:



    voice "voice/equinox_179.ogg"
    nvl_equinox "후——드디어 왔네——"


translate japanese plot8_e556cee1:


    nvlNone "헐떡이며 앞을 보았다. 의뢰에 적힌 대로 두 마을을 잇는 산길이 거대한 바위에 막혀 있었다." (**end_page())


translate japanese plot8_f1c02039:


    nvl clear
    nvlNone "바위뿐 아니라 함께 쓸려 내려온 흙도 잔뜩 쌓여 있었다."


translate japanese plot8_014cbbf5:


    nvlNone "땅에는 사람의 발자국과 발굽 자국도 많이 남아 있었다. 운 나쁜 상인 일행이 여기까지 와서야 통과할 수 없다는 걸 깨달았을 것이다."


translate japanese plot8_9f357443:



    voice "voice/dorothea_87.ogg"
    nvl_dorothea "엄——청 큰 바위네!" (**end_page())


translate japanese plot8_a0174fe3:



    voice "voice/equinox_180.ogg"
    nvl_equinox "근처에 매복은 없어?"


translate japanese plot8_4cc804fd:



    voice "voice/dorothea_88.ogg"
    nvl_dorothea "올라가서 볼게." (**end_page())


translate japanese plot8_04c5e99c:



    voice "voice/dorothea_89.ogg"
    nvl_dorothea "영차——" (**end_page())


translate japanese plot8_12e977c0:


    nvlNone "도로시아는 단숨에 나무에 올라\n높은 가지 위에서 공기 중의 냄새를 구별했다." (**end_page())


translate japanese plot8_3ecb826d:


    nvlNone "곧 도로시아가 나무에서 뛰어내렸다." (**end_page())


translate japanese plot8_ac32acdc:



    voice "voice/equinox_181.ogg"
    nvl_equinox "산적은?"


translate japanese plot8_94c6e868:



    voice "voice/dorothea_90.ogg"
    nvl_dorothea "없어. 근처에서 사람 냄새는 안 나."


translate japanese plot8_fb049e20:


    nvlNone "지금까지의 경험으로 보면, 이 바위는 지나가는 상인 일행을 막으려고 누군가 일부러 놓았을 것이다." (**end_page())


translate japanese plot8_b4ca9378:


    nvl clear
    nvlNone "그렇다면 산적의 거점도 근처에 있을 것이다. 하지만 도로시아는 그럴듯한 냄새를 맡지 못했다."


translate japanese plot8_e878d242:


    nvlNone "그 밖에는 머리 좋은 마물이 놓은 함정이라고밖에 생각할 수 없었다."


translate japanese plot8_515e5d28:



    voice "voice/equinox_182.ogg"
    nvl_equinox "마물 냄새는?" (**end_page())


translate japanese plot8_7c19966b:



    voice "voice/dorothea_91.ogg"
    nvl_dorothea "그것도 없어."


translate japanese plot8_90ae72b7:



    voice "voice/equinox_183.ogg"
    nvl_equinox "음……그거 참 이상하네."


translate japanese plot8_6215f27a:



    voice "voice/equinox_184.ogg"
    nvl_equinox "우리가 올 걸 알고 먼저 달아난 것도 아닌가."


translate japanese plot8_761a8de9:



    voice "voice/dorothea_92.ogg"
    nvl_dorothea "근처에는 싸운 흔적도 없어." (**end_page())


translate japanese plot8_4c654563:



    voice "voice/dorothea_93.ogg"
    nvl_dorothea "얼마 전에 비가 와서 바위가 저절로 굴러떨어진 걸 수도 있지 않을까?"


translate japanese plot8_f25c61ca:



    voice "voice/dorothea_94.ogg"
    nvl_dorothea "의뢰를 낸 상인 일행도 산적에게 습격당했다는 말은 안 했잖아."


translate japanese plot8_866f7989:



    voice "voice/equinox_185.ogg"
    nvl_equinox "저절로 굴러떨어진 건가……"


translate japanese plot8_34d1ef9c:


    nvlNone "나는 바위가 굴러온 흔적을 살펴보았지만, 정말 별다른 발견은 없었다." (**end_page())


translate japanese plot8_8b7bd292:


    nvl clear
    nvlNone "그런데도 산길 한가운데에 딱 멈춰 있었다.\n그것만으로도 충분히 수상했다."


translate japanese plot8_d7615840:



    voice "voice/champion_145.ogg"
    nvl_champion "저, 저기——"


translate japanese plot8_5f88c21b:



    voice "voice/champion_146.ogg"
    nvl_champion "잠깐 기다려 줄래? 좀 쉬고 싶어." (**end_page())


translate japanese plot8_55cae311:


    nvlNone "용사가 쉬자고 하는 건 드문 일이었다. 나와 도로시아는 놀라서 뒤돌아보았다."


translate japanese plot8_d4a6c3c0:


    nvlNone "용사의 뺨은 부자연스러울 만큼 붉게 물들었는데, 입술은 창백하게 질려 있었다." (**end_page())


translate japanese plot8_e0cf4536:



    voice "voice/dorothea_95.ogg"
    dorothea "왜 그래, 용사? 몸이 안 좋아?"


translate japanese plot8_5ddc4731:



    voice "voice/champion_147.ogg"
    champion "갑자기 가슴이 두근거리고 온몸에 힘이 안 들어가. 어지럽고 속도 좀 메스꺼워."


translate japanese plot8_526c0bb4:



    voice "voice/champion_148.ogg"
    champion "아무래도……아픈 것 같아."


translate japanese plot8_9846264a:


    "용사는 자신이 하는 말을 스스로도 믿기 어렵다는 듯했다."


translate japanese plot8_5a5a23d1:


    "용사의 힘으로 가호를 받는 그녀에게 「병」이란 이미 아득한 기억 같은 것이었다."


translate japanese plot8_b4487f5a:


    voice "voice/gt_11.ogg"
    npc14 "아——!"


translate japanese plot8_727828fc:


    "나와 도로시아는 동시에 원인을 떠올렸다."


translate japanese plot8_a9afdabc:



    voice "voice/dorothea_96.ogg"
    dorothea "아까 용사한테 박하콩을 얼마나 준 거야?"


translate japanese plot8_2c9deb60:



    voice "voice/equinox_186.ogg"
    equinox 0406 "두 줌밖에 안 줬는데……"


translate japanese plot8_9379aa32:



    voice "voice/equinox_187.ogg"
    equinox 0406 "용사가 여기에 약할 줄은 몰랐어."


translate japanese plot8_211ccf96:



    voice "voice/champion_149.ogg"
    champion "으——머리 어지러워. 토할 것 같아——"


translate japanese plot8_c3a3f69e:



    voice "voice/dorothea_97.ogg"
    dorothea "어서 치료해 줘."


translate japanese plot8_78dba573:



    voice "voice/equinox_188.ogg"
    equinox 0401 "알았어, 알았어."


translate japanese plot8_cf2174df:


    "나는 지팡이로 용사를 살짝 두드리고, 가장 기초적인 치유 마법을 걸었다."


translate japanese plot8_2921cbff:



    voice "voice/champion_150.ogg"
    champion "후, 훨씬 나아졌네……"


translate japanese plot8_1ecb0313:



    voice "voice/champion_151.ogg"
    champion "방금은 무슨 일이야? 왜 갑자기 그렇게 힘들어졌지……"


translate japanese plot8_686a2cd1:



    voice "voice/equinox_189.ogg"
    equinox 0406 "아……그건 박하콩의 부작용이야. 마나 멀미 같은 거지."


translate japanese plot8_b8c72567:



    voice "voice/equinox_190.ogg"
    equinox 0410 "보통 마법사는 마법으로 부작용을 없애거든. 용사의 힘이 상쇄해 줄 거라고 생각했는데, 안 되는구나……"


translate japanese plot8_04b42a1d:



    voice "voice/champion_152.ogg"
    champion "이게 그렇게 강했어? 정말 기절할 뻔했는데."


translate japanese plot8_c7cb66d5:



    voice "voice/equinox_191.ogg"
    equinox 0406 "어……용사는 이거에 내성이 많이 약하네."


translate japanese plot8_f068a11e:



    voice "voice/equinox_192.ogg"
    equinox 0406 "보통이라면 이 정도 먹어도 아무렇지 않을 텐데."


translate japanese plot8_e852e7b5:


    "우연한 계기로 용사의 약점을 하나 발견했다. 용사의 힘도 만능은 아닌 모양이다."


translate japanese plot8_0acbd8a7:



    voice "voice/dorothea_98.ogg"
    dorothea "흥흥, 용사도 이제 무서운 줄 알겠지?"


translate japanese plot8_b024accb:



    voice "voice/dorothea_99.ogg"
    dorothea "작아도 부작용은 치명적이야. 다음에 누가 줘도, 잘 생각해 보고 입에 넣으라고."


translate japanese plot8_6a1e0cdc:



    voice "voice/champion_153.ogg"
    champion "응, 괜찮아. 이젠 어느 정도까지 먹어도 되는지 알았어."


translate japanese plot8_256c2978:



    voice "voice/champion_154.ogg"
    champion "다음에 먹을 때는 조심할게."


translate japanese plot8_8a952492:



    voice "voice/dorothea_100.ogg"
    dorothea "또 먹을 생각이야!?"


translate japanese plot8_173ff2bd:



    voice "voice/champion_155.ogg"
    champion "됐어, 이제 별문제 없어. 얼른 일 끝내고 돌아가자."


translate japanese plot8_416a3cef:



    voice "voice/champion_156.ogg"
    champion "둘 다 물러나."


translate japanese plot8_205fb3d9:


    "용사가 뒤로 물러나라는 손짓을 하자, 우리는 순순히 따랐다."


translate japanese plot8_9d31bad0:


    "그녀는 혼자 앞으로 나서더니 두 손으로 거대한 바위를 짚었다."


translate japanese plot8_419f58de:



    voice "voice/champion_157.ogg"
    champion 0304 "영——차——!"


translate japanese plot8_77061595:


    "쿠구구궁——"


translate japanese plot8_b1115a4d:


    "용사가 힘을 주자, 거대한 바위가 통째로 흙 속에서 들려 올라왔다."


translate japanese plot8_15a6e9a5:


    "그러더니 솜뭉치라도 안아 든 것처럼, 산 아래로 가볍게 던져 버렸다."


translate japanese plot8_15f78618:


    "콰앙!!"


translate japanese plot8_94ee7065:


    "땅에 떨어진 거대한 바위가 굉음을 냈다. 발밑의 땅까지 흔들렸다."


translate japanese plot8_f806ecef:



    voice "voice/dorothea_101.ogg"
    nvl_dorothea "오——역시 용사야. 단번에 끝냈네."


translate japanese plot8_13154f7e:



    voice "voice/equinox_193.ogg"
    nvl_equinox "정말 괴물이네……"


translate japanese plot8_87084acc:



    voice "voice/champion_158.ogg"
    nvl_champion "아사요. 남은 흙더미는 마법으로 치울 수 있어?\n저 바위처럼 산기슭으로 떨어뜨리면 돼." (**end_page())


translate japanese plot8_d96d432c:



    voice "voice/equinox_194.ogg"
    nvl_equinox "응, 나머지는 나한테 맡겨." (ctc="ctc_end", ctc_position="fixed")


translate japanese plot8_ef7e1e08:


    nvlNone "우리가 마을 밖 숲에 돌아왔을 때는 이미 해 질 무렵이었다."


translate japanese plot8_c5835d3c:


    nvlNone "용사가 예상한 대로 하루 안에 왕복했다." (**end_page())


translate japanese plot8_e0538c33:


    nvlNone "——결국은 야영하고 싶지 않았기 때문이다."


translate japanese plot8_f55cc34e:


    nvlNone "마을에 돌아가 쉴 수만 있다면, 우리는 있는 힘껏 서둘러 걸었다." (**end_page())


translate japanese plot8_d5263f4c:



    voice "voice/dorothea_102.ogg"
    nvl_dorothea "후——오늘은 아무것도 안 하고 걷기만 한 기분이네."


translate japanese plot8_6e936b73:



    voice "voice/equinox_195.ogg"
    nvl_equinox "길드 의뢰가 다 그렇지. 대부분 심부름이야."


translate japanese plot8_69f7474b:



    voice "voice/dorothea_103.ogg"
    nvl_dorothea "위험하고 교활한 마물이랑 한판 싸울 수 있을 줄 알았는데!"


translate japanese plot8_65d88ce8:



    voice "voice/champion_159.ogg"
    nvl_champion "아무 일도 없는 게 가장 좋은 거 아니야?" (**end_page())


translate japanese plot8_fb648238:



    voice "voice/dorothea_104.ogg"
    nvl_dorothea "아이, 용사는 몰라——"


translate japanese plot8_6b5460b7:



    voice "voice/dorothea_105.ogg"
    nvl_dorothea "——!"


translate japanese plot8_4768ab94:



    voice "voice/dorothea_106.ogg"
    nvl_dorothea "(킁킁.)" (what_prefix="", what_suffix="")


translate japanese plot8_9844ed64:



    voice "voice/equinox_196.ogg"
    nvl_equinox "왜 그래?" (**end_page())


translate japanese plot8_0854592b:



    voice "voice/dorothea_107.ogg"
    nvl_dorothea "마물이랑 유황 냄새……"


translate japanese plot8_88eb56df:



    voice "voice/dorothea_108.ogg"
    nvl_dorothea "아니, 뭔가 타고 있어!"


translate japanese plot8_ef01a68d:



    voice "voice/dorothea_109.ogg"
    nvl_dorothea "마을 쪽이야!" (**end_page())


translate japanese plot8_1c47c953:


    nvlNone "화요일 아침."


translate japanese plot8_08df03e7:



    voice "voice/nvlnpc_01.ogg"
    nvlNone "「아——월례 시험이 또 하루 가까워졌어——」"


translate japanese plot8_cc8fb113:



    voice "voice/nvlnpc_02.ogg"
    nvlNone "「으으, 이번 수학은 정말 안 될지도 몰라.」{p}「교과서를 읽어도 머릿속에 하나도 안 들어와.」" (callback=nvl_page_voice, cb_next_voice="voice/nvlnpc_03.ogg")


translate japanese plot8_77913eb1:



    voice "voice/nvlnpc_04.ogg"
    nvlNone "「지난번에도 그렇게 말했잖아! 결국 잘 봤으면서!」"


translate japanese plot8_cb2cbbfb:


    nvlNone "나는 학교가 싫다."


translate japanese plot8_bca326bb:


    nvlNone "기분 탓일까, 아니면 몸이 정말 거부하는 걸까."


translate japanese plot8_673958c6:


    nvlNone "어지럽고 구역질까지 치밀어 올랐다."


translate japanese plot8_37b4f8d1:


    nvlNone "심장이 쿵쿵 계속 울리고,{p}위를 세게 비트는 듯한 통증이 몰려왔다."


translate japanese plot8_0cfdfdcc:


    nvlNone "하지만 가야만 한다."


translate japanese plot8_1a6cd1a5:


    nvlNone "몸이 안 좋다는 말은\n할머니에게도 담임 선생님에게도 꺼낼 용기가 없었다."


translate japanese plot8_d5791026:


    nvlNone "게다가 이번 주에는 중요한 월례 시험이 있다.{p}학교를 쉴 수는 없다."


translate japanese plot8_689e3617:


    nvlNone "내 성적은……몸 상태만큼이나 좋지 않다."


translate japanese plot8_88834df0:


    nvlNone "그렇게 생각하니 위가 더 아파졌다."


translate japanese plot8_a1ee7397:


    nvlNone "그래도 가야만 한다."


translate japanese plot8_d6463b84:



    voice "voice/nvlnpc_06.ogg"
    nvlNone "「안녕.」"


translate japanese plot8_5c442210:



    voice "voice/nvlnpc_07.ogg"
    nvlNone "「좋은 아침——.」"


translate japanese plot8_d66ef529:



    voice "voice/nvlnpc_08.ogg"
    nvlNone "「어젯밤에 그 드라마 봤어?」" (**end_page())


translate japanese plot8_c916f38d:



    nvl clear
    voice "voice/nvlnpc_09.ogg"
    nvlNone "「안 봤어. 그거 좀 무서워서\n주말 아침에 보려고.」{p}「게다가 이번 주는 월례 시험이잖아?\n밤에 공부 안 해도 돼?」" (callback=nvl_page_voice, cb_next_voice="voice/nvlnpc_10.ogg")


translate japanese plot8_6d05c427:


    nvlNone "친구들이 나누는 대화조차 내 귀에는 유난히 시끄럽다."


translate japanese plot8_9bd00d3e:


    nvlNone "하지만 그들 눈에 비친 나도 분명 마찬가지일 것이다."


translate japanese plot8_296a04cc:


    nvlNone "성적은 중하위권, 성격은 내성적."


translate japanese plot8_ad63c0f8:


    nvlNone "그런 나는 반에서 존재감이 거의 없다."


translate japanese plot8_04387016:


    nvlNone "「학교에 가는 건 벌칙 게임이지.」"


translate japanese plot8_b2104550:


    nvlNone "저쪽에서 이야기하던 아이들이 농담처럼 그렇게 말했다."


translate japanese plot8_68d00eba:


    nvlNone "유토리 교육, 유토리 교육, 유토리 교육."


translate japanese plot8_70f0ebf0:


    nvlNone "내가 학교에 다니기 시작할 무렵에는 이미 시작되어 있던 교육 방침."


translate japanese plot8_64836e0c:


    nvlNone "수업, 숙제, 쪽지 시험, 실험, 체육, 시험……"


translate japanese plot8_335da973:


    nvlNone "학교에 들어서는 순간,{p}사방에서 압박이 밀려와,{p}숨조차 쉴 수 없을 것만 같았다."


translate japanese plot8_7f63d240:


    nvlNone "하지만 예전에는 이렇지 않았다."


translate japanese plot8_f3ad0586:


    nvlNone "적어도 그때는 학교가 싫지 않았다."


translate japanese plot8_febd334b:


    nvlNone "원예부 친구들은 대부분 나와 성격이 비슷했다."


translate japanese plot8_92355d29:


    nvlNone "우리는 학교 한구석에 식물을 심었다."


translate japanese plot8_2d77df81:


    nvlNone "무럭무럭 자라는 모습을 볼 때마다\n가슴속에 작은 성취감이 싹텄다."


translate japanese plot8_f5ca490d:


    nvlNone "분명 우리는 그 식물에 자기 자신을 겹쳐 보고 있었을 것이다."


translate japanese plot8_653992a6:


    nvlNone "과거로 돌아가고 싶다."


translate japanese plot8_fa3dcec5:


    nvlNone "아직 학교가 이토록 싫지 않았을 때로."


translate japanese plot8_932b81a6:


    nvlNone "나는 창밖으로 시선을 돌렸다."


translate japanese plot8_c0c61540:


    nvlNone "나비 한 마리가 걱정도 없이 날아다닌다."


translate japanese plot8_67dce77f:


    nvlNone "꽃들 사이로. 하늘 저편으로."


translate japanese plot8_d3f9c2c8:


    nvlNone "아마 그 자유로움을 동경하는 것이겠지."


translate japanese plot8_5b9d5725:


    nvlNone "그 애가 있었을 때는 나에게도 그런 시절이 있었다."


translate japanese plot8_829a7ee3:


    nvlNone "그런 어리석은 망상이 머릿속에서 몇 번이고 울려 퍼졌다."


translate japanese plot8_cb3c2196:


    nvlNone "과거로 돌아갈 수 있다면……"


translate japanese plot8_f8970d6b:



    voice "voice/nvlnpc_12.ogg"
    nvlNone "「에휴——오후에는 체육이네.」"


translate japanese plot8_30395bb9:



    voice "voice/nvlnpc_13.ogg"
    nvlNone "「어? 5반은 체육 시간 생물 선생님한테 뺏겼다던데.」{p}「우리는 왜 하는 거야?」" (callback=nvl_page_voice, cb_next_voice="voice/nvlnpc_14.ogg")


translate japanese plot8_e054e413:



    voice "voice/nvlnpc_15.ogg"
    nvlNone "「저쪽은 진도가 늦어서\n체육 한 시간을 돌렸대.」"


translate japanese plot8_2aad00ce:


    nvlNone "체육 수업."


translate japanese plot8_ccacaa04:


    nvlNone "그 말만 들어도 등골이 떨리고 몸이 차가워졌다."


translate japanese plot8_c5f7b6e1:


    nvlNone "원예부가 그런 일을 겪은 건 내가 그 아이에게 거역했기 때문이다."


translate japanese plot8_9ab62d6b:


    nvlNone "선생님께 드린 편지가……어찌 된 일인지\n그 아이 손에 넘어가 버렸다."


translate japanese plot8_44da11be:


    nvlNone "아니다. 그 편지를 내가 썼다는 건\n벌써 진작 들켰다."


translate japanese plot8_259ee4c1:


    nvlNone "그녀가 보복하고 싶은 대상은 나뿐이다."


translate japanese plot8_ad7f3b9f:


    nvlNone "그리고 체육 시간은 그녀의 무대다."


translate japanese plot8_06f0ac4d:


    nvlNone "머릿속에 줄곧 안개가 낀 채로,\n어느새 오후 체육 시간이 되어 있었다."


translate japanese plot8_678cf0e9:


    nvlNone "나는 몽롱한 상태로 친구들을 따라 운동장에 나와 있었다." (**end_page())


translate japanese plot8_974c7f74:



    voice "voice/jinlaoshi_85.ogg"
    nvl_teacher "준비——!"


translate japanese plot8_5d1c4163:



    voice "voice/jinlaoshi_86.ogg"
    nvl_teacher "출발!" (**end_page())


translate japanese plot8_33330eb5:



    nvl clear
    voice "voice/npc6_34.ogg"
    nvl_student_a "또 200미터를 달려야 해——"


translate japanese plot8_81c79223:



    voice "voice/npc7_30.ogg"
    nvl_student_b "선생님! 며칠 뒤면 월례 시험인데요!"


translate japanese plot8_7d41df1e:



    voice "voice/npc6_35.ogg"
    nvl_student_a "좀 편하게 해 주세요." (**end_page())


translate japanese plot8_fdadd3f3:



    nvl clear
    voice "voice/jinlaoshi_87.ogg"
    nvl_teacher "알았다. 오늘 체육은 훈련량을 조금 줄일게."


translate japanese plot8_1b530f19:



    voice "voice/npc29_05.ogg"
    nvl_students "만세——" (**end_page())


translate japanese plot8_87ba9ff8:



    nvl clear
    voice "voice/jinlaoshi_88.ogg"
    nvl_teacher "긴장 풀지는 마! 꾀를 부리면\n원래 훈련량대로 시킬 테니까."


translate japanese plot8_7ebdbb07:



    voice "voice/npc29_06.ogg"
    nvl_students "네에——" (**end_page())


translate japanese plot8_03681c8f:


    nvlNone "이제는 모두가 무슨 말을 하는지도 알 수 없었다."


translate japanese plot8_47775e57:


    nvlNone "나는 그저 본능에 이끌려 다른 애들을 따라 달리기 트랙에 올라섰다."


translate japanese plot8_7cd8fa2a:


    nvlNone "마음속에는 두려움만 남았다." (**end_page())


translate japanese plot8_86aab1d3:


    nvlNone "곧 내 차례가 되어 출발선에 섰다."


translate japanese plot8_744a2a11:



    voice "voice/jinlaoshi_89.ogg"
    nvl_teacher "다음 조, 준비——!"


translate japanese plot8_5d1c4163_1:



    voice "voice/jinlaoshi_90.ogg"
    nvl_teacher "출발!" (**end_page())


translate japanese plot8_73d1bcf5:



    voice "voice/xiaoxia_111.ogg"
    plot8_pov_reaction "어?" (**end_page())


translate japanese plot8_ad64cca6:


    nvlNone "이유는 알 수 없었다."


translate japanese plot8_f8ab388b:



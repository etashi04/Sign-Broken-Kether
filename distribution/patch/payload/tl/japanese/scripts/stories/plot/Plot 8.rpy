translate japanese plot8_e21cbaad:


    nvl clear
    nvlNone "이런 광경을 보고도 도로시아는 포기하려 하지 않았다."


translate japanese plot8_2151df3a:


    nvlNone "불길 너머에서 대답이 돌아오리라 믿으며, 몇 번이고 아이들의 이름을 계속 불렀다."


translate japanese plot8_9db80d55:


    nvlNone "하지만 돌아오는 것은 썩은 고기 냄새와 탄내뿐이었다." (**end_page())


translate japanese plot8_452d0b39:


    nvlNone "우리는 주변을 샅샅이 찾았지만, 생존자는 한 명도 없었다."


translate japanese plot8_93e06201:


    nvlNone "마을 한복판에는\n장기가 도려내진 시체가 겹겹이 쌓여 있었다."


translate japanese plot8_49d92371:


    nvlNone "이곳에서 무슨 의식이 치러졌던 것 같았다." (**end_page())


translate japanese plot8_d81cfdd5:



    voice "voice/dorothea_118.ogg"
    nvl_dorothea "우리가 늦은 걸까……"


translate japanese plot8_f8feb5b9:



    voice "voice/equinox_213.ogg"
    nvl_equinox "아니, 일부러 우릴 딴 데로 보낸 거야." (**end_page())


translate japanese plot8_da4dd580:



    voice "voice/npc38_11.ogg"
    nvl_npc38 "현재 길드에서 가장 우선적으로 해결해야 할 의뢰입니다."


translate japanese plot8_640deb3b_1:



    voice "voice/npc38_12.ogg"
    nvl_npc38 "거리가 좀 머니 이 지도를 가져가세요."


translate japanese plot8_71c1c8c2_1:



    voice "voice/npc38_13.ogg"
    nvl_npc38 "정말 죄송해요! 이 마을에는 상주하는 모험가가 없어서, 계속 해결하지 못한 의뢰거든요……" (**end_page())


translate japanese plot8_ad7af207:



    voice "voice/dorothea_119.ogg"
    nvl_dorothea "그럼 아침에 길드 사람이 나한테 거짓말을 했다는 거야?"


translate japanese plot8_9a5695be:



    voice "voice/equinox_214.ogg"
    nvl_equinox "그뿐만이 아니야. 우리가 이 마을에 오기 전부터 전부 꾸며져 있었어."


translate japanese plot8_a7ba7d4a:



    voice "voice/equinox_215.ogg"
    nvl_equinox "……나를 이 마을로 불러들인 것 자체가\n함정일지도 몰라." (**end_page())


translate japanese plot8_a85b59a9:



    voice "voice/champion_166.ogg"
    champion "잠깐. 앞에 뭔가 있어."


translate japanese plot8_8666aea9:



    voice "voice/dorothea_120.ogg"
    dorothea "내가 볼게!"


translate japanese plot8_b810e95a:



    voice "voice/equinox_216.ogg"
    equinox 0406 "잠깐, 도로시아! 무작정 가지 마!"


translate japanese plot8_8ba0a510:



    voice "voice/equinox_217.ogg"
    equinox 0406 "쳇, 말도 안 들어."


translate japanese plot8_cf386a6f:



    voice "voice/champion_167.ogg"
    champion "가자. 생존자일지도 몰라."


translate japanese plot8_1e8ded68:



    voice "voice/equinox_218.ogg"
    equinox 0406 "……알겠어."


translate japanese plot8_3df92bdb:


    nvlNone "앞쪽에 사람의 그림자가 보이자, 우리 셋은 급히 달려갔다."


translate japanese plot8_9380e20a:


    nvlNone "하지만 예상대로 이 마을에 생존자는 없었다."


translate japanese plot8_3efe25dc:



    voice "se155.ogg"
    nvl_npc3 "끄으으으——"


translate japanese plot8_2b01487f:


    nvlNone "우리 앞에 있는 것은 인간도 마물도 아니었다." (**end_page())


translate japanese plot8_d7acbc08:


    nvl clear
    nvlNone "장기가 모두 도려내졌는데도\n계속 움직이는 시체 무리였다."


translate japanese plot8_7f8e6ea5:


    nvlNone "목에서 새어 나오는 비명에는 견딜 수 없는 고통이 배어 있었다. 듣는 우리까지 가슴이 아팠다."


translate japanese plot8_74d973a0:


    nvlNone "영혼이 몸에 묶여 죽지도 살지도 못한 채, 불타는 곳을 배회하고 있었다." (**end_page())


translate japanese plot8_a1b9b35b:


    nvlNone "희미하게 남은 이목구비만이 그들 역시 이 마을에서 살던 사람들이었음을 알려 주었다." (**end_page())


translate japanese plot8_2bd6e6cc:



    voice "voice/dorothea_121.ogg"
    dorothea "너무 잔인해……"


translate japanese plot8_e48fefd5:



    voice "voice/champion_168.ogg"
    champion "……이 사람들, 마물이야?"


translate japanese plot8_5798a59f:



    voice "voice/equinox_219.ogg"
    equinox 0406 "……엄밀히 말하면 아니야."


translate japanese plot8_f52b24e5:



    voice "voice/equinox_220.ogg"
    equinox 0406 "영혼이 육체에 단단히 묶여 있어. 이런 모습이 되고도 아직 죽지 못한 거야……"


translate japanese plot8_201ef687:



    voice "voice/equinox_221.ogg"
    equinox 0406 "이게 【그것｜성수】의 권능이야……"


translate japanese plot8_77dd6554:



    voice "voice/npc3_17.ogg"
    nvl_npc3 "끄, 끄으——!"


translate japanese plot8_827056df:


    nvlNone "곧 살아 움직이는 시체들이 우리를 알아차렸다."


translate japanese plot8_0759deba:


    nvlNone "죽을 수도 없는 그들은 산 사람의 기운을 갈망했다." (**end_page())


translate japanese plot8_962e5f0f:



    voice "voice/equinox_222.ogg"
    nvl_equinox "용사, 저 사람들을 해방해 줘." (**end_page())


translate japanese plot8_55e556e7:



    nvl clear
    voice "voice/equinox_223.ogg"
    nvl_equinox "네 힘이라야 완전한 안식으로 돌려보낼 수 있어."


translate japanese plot8_6082a10c_1:



    voice "voice/champion_169.ogg"
    nvl_champion "응." (**end_page())


translate japanese plot8_40fbce59:


    nvlNone "용사는 더 이상 아무 말도 하지 않고,\n평소에는 뽑지 않는 {rb}검{/rb}{rt}{size=13}「용사의 성물」{/size}{/rt}을 칼집에서 뽑았다."


translate japanese plot8_aad6409a:


    nvlNone "칼날이 뿜어내는 밝은 회색빛은\n이 지옥에서 유일하게 마음을 편안하게 해 주는 빛이었다." (**end_page())


translate japanese plot8_f9961af1:


    nvl clear
    nvlNone "그녀는 죄 없는 사람들이 더는 고통받게 하고 싶지 않았을 것이다."


translate japanese plot8_d8671616:


    nvlNone "어쩌면 이것이 그녀 나름의 애도였을지도 모른다." (**end_page())


translate japanese plot8_0dca2130:



    nvl clear
    voice "voice/npc3_18.ogg"
    nvl_npc3 "크아아——"


translate japanese plot8_df55e97c:


    nvlNone "시체들이 파도처럼 끊임없이 용사를 향해 밀려왔다."


translate japanese plot8_f2ff9207:


    nvlNone "걸려 넘어지고 서로를 짓밟으면서도, 그들은 걸음을 멈추지 않았다." (**end_page())


translate japanese plot8_07b181ce:


    plot8_champion_caption "용사는 그저 길 한가운데 조용히 서서\n그들이 칼날이 닿는 범위 안으로 들어오기를 기다렸다." (split_lines=True)


translate japanese plot8_26f6470b:


    plot8_champion_caption "50미터, 20미터, 5미터……"


translate japanese plot8_9f7886e0:


    plot8_champion_caption "시체의 손이 그녀에게 닿기 직전,\n용사의 검이 휘둘러졌다." (split_lines=True, centered=True)


translate japanese plot8_9735f4da:



    voice "voice/champion_170.ogg"
    plot8_white_champion "편히 잠들어." (**end_page(ctc_displayable="plot8_white_ctc_end"))


translate japanese plot8_9c36bb9b:


    plot8_white_narrator "가볍게 한 번 휘둘렀을 뿐인데, 막대한 혼돈의 힘이 칼날을 따라 터져 나왔다."


translate japanese plot8_e6ff64ba:


    plot8_white_narrator "집, 불길, 잘린 팔다리……"


translate japanese plot8_688d3f33:


    plot8_white_narrator "검광에 닿는 것은 무엇이든 소리 없이 사라져 갔다." (**end_page(ctc_displayable="plot8_white_ctc_end"))


translate japanese plot8_30408fdf:


    plot8_white_narrator "그 끔찍한 모습으로 변한 사람들도 탁한 빛 속으로 사라졌다." (**end_page(ctc_displayable="plot8_white_ctc_end"))


translate japanese plot8_bf3f472e:



    voice "voice/equinox_224.ogg"
    nvl_equinox "……수고했어."


translate japanese plot8_ccfeacb0:



    voice "voice/champion_171.ogg"
    nvl_champion "아까…"


translate japanese plot8_136afc23:



    voice "voice/champion_172.ogg"
    nvl_champion "아까 맨 앞에 계셨던 아주머니, 아침에 나한테 사과를 주셨는데……"


translate japanese plot8_d7375900:



    voice "voice/champion_173.ogg"
    nvl_champion "결국 아무도 구하지 못했어." (**end_page())


translate japanese plot8_3001b486:



    nvl clear
    voice "voice/equinox_225.ogg"
    nvl_equinox "……가자. 안쪽에는 생존자가 있을지도 몰라."


translate japanese plot8_3fb804bd:


    nvlNone "나 자신도 그 말을 믿지는 않았다. 하지만 용사에게 무슨 말을 건네야 할지 알 수 없었다." (**end_page())


translate japanese plot8_04bc3b7d:


    voice "voice/keemi_25.ogg"
    nvl_keemi "언니——!!!" (**end_page())


translate japanese plot8_c6d1afad:



    voice "voice/equinox_226.ogg"
    equinox 0404 "방금 목소리는——!"


translate japanese plot8_50e0e419:


    "너무나 익숙한 목소리가 귀에 들려왔다."


translate japanese plot8_54b959de:


    "기적인가?"


translate japanese plot8_745259e0:


    "나조차 그런 생각을 할 수밖에 없었다."


translate japanese plot8_0ffd05a7:



    voice "voice/champion_174.ogg"
    champion 0304 "바로 앞이야!"


translate japanese plot8_15193c58:


    "우리 셋은 온 힘을 다해 목소리가 들려온 쪽으로 달려갔다."


translate japanese plot8_a7abd011:


    nvlNone "——그날 아침." (**end_page())


translate japanese plot8_a138a181:



    voice "voice/keeko_35.ogg"
    nvl_keeko "치미, 일어날 시간이야."


translate japanese plot8_0558c52e:



    voice "voice/keemi_26.ogg"
    nvl_keemi "음……언니."


translate japanese plot8_14d5d88d:


    nvlNone "나는 눈을 비비며 침대에서 몸을 일으켰다."


translate japanese plot8_272763ed:



    voice "voice/keeko_36.ogg"
    nvl_keeko "오늘도 대련해야지!" (**end_page())


translate japanese plot8_3e357747_1:



    nvl clear
    voice "voice/keemi_27.ogg"
    nvl_keemi "응!"


translate japanese plot8_ab8d72cb:


    nvlNone "언니의 말을 듣자 정신이 번쩍 들었다."


translate japanese plot8_e61a2642:



    voice "voice/keeko_37.ogg"
    nvl_keeko "서둘러. 계속 꾸물거리면 안 기다린다."


translate japanese plot8_feed9da0:



    voice "voice/keemi_28.ogg"
    nvl_keemi "응——! 지금 씻으러 갈게!" (**end_page())


translate japanese plot8_2d85d6df:


    nvl clear
    nvlNone "요즘은 정말 즐겁다."


translate japanese plot8_b152e8ca:


    nvlNone "매일 왕언니를 찾아가 검술을 배울 수 있으니까."


translate japanese plot8_3a34b238:


    nvlNone "우리를 쫓아내지 않은 모험가는 왕언니들이 처음이었다."


translate japanese plot8_605c8f09:


    nvlNone "계속 마을에 있어 주면 좋을 텐데." (**end_page())


translate japanese plot8_e3048e1e:



    voice "voice/keeko_38.ogg"
    nvl_keeko "뭐!? 왕언니들이 의뢰를 하러 밖에 나갔다고요?"


translate japanese plot8_32d6530f:



    voice "voice/npc38_14.ogg"
    nvl_npc38 "그렇단다. 계속 맡을 사람이 없던 의뢰가 있었는데,\n마침 그 사람들이 맡아 주었어."


translate japanese plot8_852e1d7f:



    voice "voice/keeko_39.ogg"
    nvl_keeko "아! 알았으면 우리도 따라갔을 텐데!" (**end_page())


translate japanese plot8_93d411a1:



    nvl clear
    voice "voice/npc38_15.ogg"
    nvl_npc38 "후후, 그분들이 맡은 임무는 아주 위험해. 너희 같은 아이들이 끼어들 수 있는 일이 아니란다."


translate japanese plot8_f29d5fdb:



    voice "voice/npc38_16.ogg"
    nvl_npc38 "너희 자매는 마을에서 얌전히 돌아오길 기다리렴."


translate japanese plot8_46080897:



    voice "voice/keeko_40.ogg"
    nvl_keeko "어쩔 수 없네. 모험가니까." (**end_page())


translate japanese plot8_a55eb32e:


    nvl clear
    nvlNone "언니는 한숨을 쉬었다. 하지만 목소리는 즐거워 보였다."


translate japanese plot8_92193286:


    nvlNone "물론 나도 그런 모험가를 동경했다."


translate japanese plot8_85a9b825:


    nvlNone "언젠가 우리도 왕언니처럼 여기서 길드의 의뢰를 받는 날이 올까." (**end_page())


translate japanese plot8_fd147046:



    voice "voice/keeko_41.ogg"
    nvl_keeko "치미, 가자. 우리끼리 먼저 연습하자!"


translate japanese plot8_10c1feea:



    voice "voice/keemi_29.ogg"
    nvl_keemi "응, 언니!" (**end_page())


translate japanese plot8_7b4da1c6:


    nvlNone "나와 언니는 술집 밖 공터에서 대련을 시작했다."


translate japanese plot8_aa6aec52:


    nvlNone "왕언니들이 우리에게 검술을 가르쳐 주던 곳이기도 했다." (**end_page())


translate japanese plot8_85263005:



    voice "voice/keeko_42.ogg"
    nvl_keeko "받아라! 얍!"


translate japanese plot8_0a435203:



    voice "voice/keemi_30.ogg"
    nvl_keemi "으악!"


translate japanese plot8_cdb028af:


    nvlNone "언니는 몸을 낮추더니, 목검으로 아래에서 초승달 모양을 그리며 올려 베었다." (**end_page())


translate japanese plot8_a025be75:


    nvl clear
    nvlNone "언니의 공격을 막으려 했지만\n내가 중심을 잃고 엉덩방아를 찧었다."


translate japanese plot8_0c33cbdc:



    voice "voice/keeko_43.ogg"
    nvl_keeko "치미, 괜찮아?"


translate japanese plot8_a01867b5:



    voice "voice/keemi_31.ogg"
    nvl_keemi "괜찮아……조금 피곤해. 잠깐 쉴래." (**end_page())


translate japanese plot8_505fa5ea:



    voice "voice/keeko_44.ogg"
    nvl_keeko "헤헤, 이걸로 10 대 6이네."


translate japanese plot8_1db1b4dd:


    nvlNone "나는 거친 숨을 몰아쉬며 바닥에 앉아 쉬었다."


translate japanese plot8_2553a81f:


    nvlNone "언니는 조금도 지치지 않은 듯 몇 번이고 허공에 검을 휘둘렀다." (**end_page())


translate japanese plot8_ea256b7b:



    voice "voice/keemi_32.ogg"
    nvl_keemi "언니는 정말 대단해."


translate japanese plot8_0a732678:



    voice "voice/keeko_45.ogg"
    nvl_keeko "아니야. 치미 네가 더 빨리 늘고 있어."


translate japanese plot8_62effe84:



    voice "voice/keeko_46.ogg"
    nvl_keeko "전에는 날 거의 못 이겼잖아. 이젠 나랑 대등하게 겨루는데." (**end_page())


translate japanese plot8_aac01573:



    nvl clear
    voice "voice/keemi_33.ogg"
    nvl_keemi "아냐. 난 아직 멀었어."


translate japanese plot8_fa1f1ec5:


    nvlNone "언니에게 칭찬을 듣자, 나는 쑥스러워 머리를 긁적였다."


translate japanese plot8_fbac2816:


    nvlNone "하지만 체력도 싸우는 방법도 언니에게는 아직 전혀 못 미친다는 걸 알고 있다." (**end_page())


translate japanese plot8_ee15e6dc:



    voice "voice/champion_175.ogg"
    nvl_champion "힘으로 이길 수 없다면 머리를 써!"


translate japanese plot8_8821ca7f:


    nvlNone "용사 언니가 가르쳐 준 말이 머릿속에 떠올랐다."


translate japanese plot8_bbd952fb:



    voice "voice/champion_176.ogg"
    nvl_champion "싸움은 검을 휘두르는 힘만 겨루는 게 아니야."


translate japanese plot8_4296394c:



    voice "voice/champion_177.ogg"
    nvl_champion "상대가 너보다 강하면 머리를 써야 해." (**end_page())


translate japanese plot8_bec90f64:



    nvl clear
    voice "voice/champion_178.ogg"
    nvl_champion "상대의 습관과 약점을 찾아내. 거기에 승리할 기회가 있어." (**end_page())


translate japanese plot8_79f539f7:


    nvlNone "하지만 언니에게 그 사람이 용사라는 사실은 말하지 않았다."


translate japanese plot8_5cdc78a2:


    nvlNone "큰 모자 언니가 하는 말을\n우연히 들었을 뿐이었으니까."


translate japanese plot8_4f681f82:


    nvlNone "용사가 나만 특별히 봐주며 가르쳐 줬다는 걸 알면\n언니도 분명 부러워할 것이다." (**end_page())


translate japanese plot8_ef56bdec:



    voice "voice/keeko_47.ogg"
    nvl_keeko "치미! 다 쉬었어?"


translate japanese plot8_c2f952a8:



    voice "voice/keemi_34.ogg"
    nvl_keemi "응! 계속하자!"


translate japanese plot8_8e146f22:


    nvlNone "왕언니들은 언니에게 용사가 될 자질이 있다고 했다."


translate japanese plot8_a8c5a26e:


    nvlNone "동생인 나에게도 그런 소질이 있을까?" (**end_page())


translate japanese plot8_00ad198e:


    nvlNone "그 뒤로도 언니와 몇 차례 더 대련했다."


translate japanese plot8_e94b4eef:


    nvlNone "그래도 왕언니들은 좀처럼 돌아오지 않았다."


translate japanese plot8_9e078fc0:



    voice "voice/keeko_48.ogg"
    nvl_keeko "왕언니들, 늦네~."


translate japanese plot8_1d196f43:



    voice "voice/keemi_35.ogg"
    nvl_keemi "분명 아주 힘든 의뢰일 거야." (**end_page())


translate japanese plot8_84e0fd04:



    voice "voice/keeko_49.ogg"
    nvl_keeko "마물 토벌일까? 아니면 던전 탐험?"


translate japanese plot8_92121caf:


    nvlNone "언니와 나는 그들이 맡은 의뢰가 무엇일지 추측했다."


translate japanese plot8_be92df6f:


    nvlNone "모험가 이야기가 나오면 언니의 눈은 언제나 즐거운 듯 반짝인다." (**end_page())


translate japanese plot8_9402585a:



    nvl clear
    voice "voice/keemi_36.ogg"
    nvl_keemi "던전 탐험이면 며칠 동안 못 돌아올 수도 있어."


translate japanese plot8_a2f8a799:



    voice "voice/keeko_50.ogg"
    nvl_keeko "그렇겠네. 어쩌면 한 순 내내 못 돌아올지도 몰라."


translate japanese plot8_bbf94dac:



    voice "voice/npc38_17.ogg"
    nvl_npc38 "걱정 마. 며칠 안에 돌아오실 거야."


translate japanese plot8_5a13a9a3:


    nvlNone "어느새 접수원이 우리 쪽으로 다가왔다." (**end_page())


translate japanese plot8_0c951986:



    nvl clear
    voice "voice/npc38_18.ogg"
    nvl_npc38 "그분들께는 어려운 임무가 아니거든."


translate japanese plot8_196208da:



    voice "voice/keeko_51.ogg"
    nvl_keeko "후——다행이다."


translate japanese plot8_7d0a6c64:



    voice "voice/npc38_19.ogg"
    nvl_npc38 "아직도 검술 연습 중이니?"


translate japanese plot8_f1ba1a04:



    voice "voice/keeko_52.ogg"
    nvl_keeko "네! 왕언니가 어제 내 준 숙제예요." (**end_page())


translate japanese plot8_37bc4e36:



    nvl clear
    voice "voice/npc38_20.ogg"
    nvl_npc38 "열심이구나. 나도 모험가였을 때가 생각나네."


translate japanese plot8_f1418043:



    voice "voice/npc38_21.ogg"
    nvl_npc38 "그때는 나도 여러 기술을 열심히 갈고닦았거든."


translate japanese plot8_16f250d4:



    voice "voice/npc38_22.ogg"
    nvl_npc38 "자물쇠 따기, 함정 해제 같은 것들. 그리고……"


translate japanese plot8_22713a03:


    nvlNone "이야기를 나누는 사이 어느새 접수원은 바로 눈앞까지 다가와 있었다." (**end_page())


translate japanese plot8_95504368:


    nvlNone "그런데 오늘은……어딘가 이상했다."


translate japanese plot8_af2331d8:


    nvlNone "언니와 몇 번이고 대련한 덕분에\n접수원에게서 무언가 불길한 기운이 느껴졌다——" (**end_page())


translate japanese plot8_32ad0e08:


    plot8_whiz_nvl "휙!" (**end_page())


translate japanese plot8_7439fa41:



    voice "voice/keemi_37.ogg"
    nvl_keemi "읏!?"


translate japanese plot8_00979b84:


    nvlNone "생각하기 전에 몸이 먼저 움직였다.\n다가오는 위험을 목검으로 황급히 막아 냈다."


translate japanese plot8_7e4312f2:


    nvlNone "쩍——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_7be5210b:


    nvlNone "손안에서 갑자기 무게가 사라졌다." (**end_page())


translate japanese plot8_673b3523:


    nvl clear
    nvlNone "시선을 옮기고 나서야, 목검이 두 동강 난 것을 알았다."


translate japanese plot8_095cdff5:



    voice "voice/keeko_53.ogg"
    nvl_keeko "치미!"


translate japanese plot8_168a93fa:


    nvlNone "언니는 곧바로 나를 자기 뒤로 끌어당기고 나무 방패를 들었다." (**end_page())


translate japanese plot8_08ed4b94:



    nvl clear
    voice "voice/keeko_54.ogg"
    nvl_keeko "이봐, 당신!"


translate japanese plot8_dca11b50:


    nvlNone "그제야 접수원에게서 느꼈던 기운이 무엇인지 알았다."


translate japanese plot8_6b6b4dc2:


    nvlNone "——공격의 기척. 그것도 진심으로 나를 죽이려는 기척이었다." (**end_page())


translate japanese plot8_dfe922b0:


    nvl clear
    nvl_npc38 "어머? 이상하네. 팔 하나쯤은 베어 낼 수 있을 줄 알았는데……내가 무뎌졌나."


translate japanese plot8_9807269c:


    nvlNone "접수원은 손안에서 단검을 빙글빙글 돌리고 있었다.\n칼날이 무서운 빛을 반사했다."


translate japanese plot8_de8e4880:


    nvlNone "그제야 머릿속에 혼란이 밀려왔다."


translate japanese plot8_8a09f0f1:


    nvlNone "왜 날 공격하지? 나 죽는 건가? 많이 아프겠지?" (**end_page())


translate japanese plot8_3bf7ec06:


    nvl clear
    nvlNone "끔찍한 생각만 차례차례 떠올라\n아무것도 생각할 수 없게 되어 갔다."


translate japanese plot8_85ff1698:


    nvlNone "곧 머릿속이 새하얘졌다."


translate japanese plot8_2c81714c:



    voice "voice/npc38_24.ogg"
    nvl_npc38 "그렇게 겁먹지 마. 죽이러 온 건 아니야." (**end_page())


translate japanese plot8_4373a643:



    voice "voice/npc38_25.ogg"
    nvl_npc38 "다만 충고해 두려고. 앞으로 일어날 일은 전부, 너희가 동경하는 모험가들 탓이란다."


translate japanese plot8_536bfa62:



    voice "voice/keemi_38.ogg"
    nvl_keemi "어……?"


translate japanese plot8_31636b94:


    nvlNone "푸욱——!" (**end_page())


translate japanese plot8_1e2120f3:


    nvl clear
    nvlNone "나도 언니도 그 말뜻을 이해하기 전에, 접수원은 단검을 자기 가슴에 찔러 넣었다."


translate japanese plot8_233501a8:



    voice "voice/npc38_26.ogg"
    nvl_npc38 "자, 똑똑히 지켜봐." (**end_page())


translate japanese plot8_52bdb448:


    nvlNone "그렇게 말하고는 단검을 쥔 채\n자기 가슴을 아래로 갈랐다."


translate japanese plot8_4d7ab5c1:


    nvlNone "뿜어져 나온 피가 나와 언니의 얼굴에 튀고, 접수원의 배 안에 있던 것들이 바닥으로 쏟아졌다." (**end_page())


translate japanese plot8_9e4ae552:


    nvlNone "동시에 마을 곳곳에서 잇달아 고함이 들려오기 시작했다."


translate japanese plot8_9235fe09:


    nvlNone "도움을 청하는 소리. 비명. 고함. 울부짖음."


translate japanese plot8_32661bd8:


    nvlNone "지옥의 막이 올랐다." (**end_page())


translate japanese plot8_06fe33d4:


    nvlNone "나와 언니는 마구간 다락의 장롱 속에 숨어 있었다."


translate japanese plot8_12f0bcba:


    nvlNone "어떻게 여기까지 왔는지 이미 기억나지 않았다. 오는 내내 언니가 내 손을 끌었던 것 같았다." (**end_page())


translate japanese plot8_c2d18a94:


    nvl clear
    nvlNone "마을 사람들은 모두 미쳐 버린 듯했다."


translate japanese plot8_55aecc98:


    nvlNone "농기구를 휘둘러 사람을 죽이는 사람. 작은 칼로 자기 목숨을 끊는 사람."


translate japanese plot8_87578201:


    nvlNone "누군가는 자신을 지키려다 사람을 죽인 뒤, 또 다른 사람에게 죽임을 당했다."


translate japanese plot8_19d46389:


    nvlNone "모두 나와 언니에게 익숙한 얼굴이었다."


translate japanese plot8_061d673e:


    nvlNone "이런 광경은 악몽에서도 본 적이 없었다." (**end_page())


translate japanese plot8_d045b9be:


    voice "voice/keemi_39.ogg"
    nvl_keemi "흑흑……"


translate japanese plot8_4cb12a7a:


    voice "voice/keeko_55.ogg"
    nvl_keeko "무서워하지 마, 치미. 여기까지는 못 찾아와."


translate japanese plot8_63c50cf7:


    nvlNone "언니는 놀라울 만큼 침착했다."


translate japanese plot8_8c97b602:


    nvlNone "아니, 내 앞이라 억지로 태연한 척하고 있었던 것이다." (**end_page())


translate japanese plot8_fafb4d9f:


    nvl clear
    nvlNone "그 사실을 깨닫자 나도 흐느낌을 삼켰다."


translate japanese plot8_9026a95f:


    nvlNone "조금씩 진정하고 나서야, 지금 벌어지는 일이 두려워지기 시작했다."


translate japanese plot8_078ce800:


    voice "voice/keemi_40.ogg"
    nvl_keemi "엄마는 괜찮겠지……?"


translate japanese plot8_86d14240:


    voice "voice/keeko_56.ogg"
    nvl_keeko "괜찮을 거야. 엄마는 강하잖아." (**end_page())


translate japanese plot8_a0e1a090:


    nvlNone "차츰 장롱 속 어둠에 눈이 익었다."


translate japanese plot8_585f9ec5:


    "薄暗がりの中でお互いの顔が見えるようになり、ようやく少しだけ安心できた。"


translate japanese plot8_ec3d54f6:


    nvlNone "바로 그때 왼손에 둔한 통증이 느껴졌다."


translate japanese plot8_73ba40ef:



    voice "voice/keemi_41.ogg"
    nvl_keemi "윽——"


translate japanese plot8_3f7fcb44:



    voice "voice/keeko_57.ogg"
    nvl_keeko "왜 그래?"


translate japanese plot8_e12f1328:



    voice "voice/keemi_42.ogg"
    nvl_keemi "나, 왼손이 아파……"


translate japanese plot8_3c196cf7:


    nvlNone "왼손을 내밀어 보니 소매가 이미 피로 붉게 물들어 있었다." (**end_page())


translate japanese plot8_5d29a269:



    voice "voice/keeko_58.ogg"
    nvl_keeko "베인 것 같아."


translate japanese plot8_feb78cab:



    voice "voice/keemi_43.ogg"
    nvl_keemi "아까 공격을 막을 때……"


translate japanese plot8_c10b6d8b:



    voice "voice/keeko_59.ogg"
    nvl_keeko "가만히 있어. 내가 도와줄게." (**end_page())


translate japanese plot8_7c47da59:


    nvl clear
    nvlNone "어둠 속에서 언니는 자기 옷자락을 찢어 내 왼손에 감아 주었다."


translate japanese plot8_f91b565c:



    voice "voice/keeko_60.ogg"
    nvl_keeko "응, 이러면 피가 멎을 거야."


translate japanese plot8_bd3d9a08:



    voice "voice/keemi_44.ogg"
    nvl_keemi "고마워, 언니……" (**end_page())


translate japanese plot8_079cb345:


    nvlNone "마구간 밖에서는 이따금 격렬하게 싸우는 소리가 들려왔다."


translate japanese plot8_b99b4c59:


    nvlNone "그중에는 나와 언니도\n알아들을 수 있는 경비병들의 목소리가 여럿 섞여 있었다."


translate japanese plot8_ead5bf74:


    nvlNone "하지만 곧 우리는 경비병들이 다른 사람을 지키러 온 게 아님을 알아차렸다." (**end_page())


translate japanese plot8_56a59b7a:



    nvl clear
    voice "voice/keeko_61.ogg"
    nvl_keeko "윽. 아까 따라 나가지 않아서 다행이야."


translate japanese plot8_a856e6d1:



    voice "voice/keeko_62.ogg"
    nvl_keeko "경비병들까지 사람을 죽이다니……대체 무슨 일이지?"


translate japanese plot8_bd46b997:



    voice "voice/keemi_45.ogg"
    nvl_keemi "전쟁일지도……아니면 사람의 생각을 조종하는 마물이 쳐들어왔거나……" (**end_page())


translate japanese plot8_17f8340c:



    voice "voice/keemi_46.ogg"
    nvl_keemi "{a=dictionary:dict_entry_88}식심마{/a} 같은 거……"


translate japanese plot8_686598a8:


    nvlNone "나는 조심스럽게 내 짐작을 말했다."


translate japanese plot8_6b077b0e:



    voice "voice/keeko_63.ogg"
    nvl_keeko "그런 마물이라면 왕언니들이 물리칠 수 있을까." (**end_page())


translate japanese plot8_7c5a4523:



    nvl clear
    voice "voice/keemi_47.ogg"
    nvl_keemi "괜찮을 거야……그 사람들한테는 용사가 있으니까."


translate japanese plot8_1d0e104a:



    voice "voice/keeko_64.ogg"
    nvl_keeko "어?"


translate japanese plot8_43a4407e:



    voice "voice/keemi_48.ogg"
    nvl_keemi "아, 나, 나를 가르쳐 준 언니가 용사야."


translate japanese plot8_94ab0ec9:



    voice "voice/keeko_65.ogg"
    nvl_keeko "뭐? 그 사람 정말 용사야?" (**end_page())


translate japanese plot8_b029db1a:



    nvl clear
    voice "voice/keemi_49.ogg"
    nvl_keemi "응. 큰 모자 언니가 하는 말을 우연히 들었어."


translate japanese plot8_1bc12a31:



    voice "voice/keeko_66.ogg"
    nvl_keeko "그렇다면 그 사람들이 돌아올 때까지만 버티면……"


translate japanese plot8_cb4540cc:


    nvlNone "접수원의 말대로라면 왕언니들이 간 곳은 그렇게 멀지 않을 것이다." (**end_page())


translate japanese plot8_0e08441e:


    nvl clear
    nvlNone "언니와 내가 계속 마구간에 숨어 있으면\n그들이 돌아올 때까지 무사히 버틸 수 있을 것이다."


translate japanese plot8_9abe8cbb:


    nvlNone "하지만…… 접수원은 정말 우리를 속이고 있는 게 아닐까."


translate japanese plot8_76b5eac7:



    voice "voice/keeko_67.ogg"
    nvl_keeko "아무튼 일단 좀 쉬자." (**end_page())


translate japanese plot8_f603ad3f:



    nvl clear
    voice "voice/keeko_68.ogg"
    nvl_keeko "무슨 일이 생기면 내가 깨워 줄게."


translate japanese plot8_c4342b28:



    voice "voice/keemi_50.ogg"
    nvl_keemi "……응."


translate japanese plot8_0675a5e1:


    nvlNone "이런 상황에서 제대로 쉴 수 있을 것 같지는 않았다." (**end_page())


translate japanese plot8_64ef3a7a:


    nvl clear
    nvlNone "그래도 마음속으로는 언니의 생각에 동의했다. 도움을 기다리는 지금은 체력을 남겨 두는 게 가장 중요하니까." (**end_page())


translate japanese plot8_a47a5204:


    voice "voice/keeko_69.ogg"
    nvl_keeko "……치미……일어……"


translate japanese plot8_2542d84a:


    voice "voice/keeko_70.ogg"
    nvl_keeko "치미, 일어나." (**end_page())


translate japanese plot8_edd836c9:



    voice "voice/keemi_51.ogg"
    nvl_keemi "음……?"


translate japanese plot8_f96cf971:


    nvlNone "장롱 속이 너무 어두워서인지,\n나는 어느새 잠들어 버렸다." (**end_page())


translate japanese plot8_45b7e736:



    voice "voice/keemi_52.ogg"
    nvl_keemi "지금 몇 시야……?"


translate japanese plot8_94831163:



    voice "voice/keeko_71.ogg"
    nvl_keeko "오후가 됐을 거야. 아까 몰래 문을 조금 열고 밖을 봤어."


translate japanese plot8_25ec65a9:



    voice "voice/keemi_53.ogg"
    nvl_keemi "그렇구나……" (**end_page())


translate japanese plot8_a68cec5f:


    nvl clear
    nvlNone "나는 마음속으로 조금 안도했다. 마구간에 숨어 있으면 안전한 모양이었다."


translate japanese plot8_b4178b1a:



    voice "voice/keeko_72.ogg"
    nvl_keeko "엄마를 찾으러 가고 싶어."


translate japanese plot8_cfcc41da:



    voice "voice/keemi_54.ogg"
    nvl_keemi "뭐!? 그, 그건 너무 위험하잖아?" (**end_page())


translate japanese plot8_af25a12a:



    voice "voice/keeko_73.ogg"
    nvl_keeko "마을 소동은 이제 가라앉았을 거야. 이쪽 길로 술집에 돌아가면……"


translate japanese plot8_28890719:


    nvlNone "언니가 허공에 지도를 그리듯 손가락을 움직였다. 어두워서 보이지 않아도 어느 길을 말하는지는 알았다." (**end_page())


translate japanese plot8_8ab53844:


    nvl clear
    nvlNone "마을 뒷산을 크게 돌아가는, 버려진 옛길이었다. 멀리 돌아가는 길이라 거의 아무도 다니지 않는다."


translate japanese plot8_fe7e7c69:



    voice "voice/keemi_55.ogg"
    nvl_keemi "하지만…"


translate japanese plot8_62b80d6d:



    voice "voice/keeko_74.ogg"
    nvl_keeko "괜찮아. 술집에 잠깐 가 보기만 할게." (**end_page())


translate japanese plot8_bb7db0e4:



    nvl clear
    voice "voice/keeko_75.ogg"
    nvl_keeko "위험하면 바로 돌아올게."


translate japanese plot8_7ab148c2:



    voice "voice/keemi_56.ogg"
    nvl_keemi "그렇다면……"


translate japanese plot8_3b6ceb0f:


    nvlNone "나는 언니의 고집을 꺾을 수 없었다.\n언니는 하기로 마음먹은 일은 반드시 했다." (**end_page())


translate japanese plot8_8568df73:


    nvl clear
    nvlNone "게다가 지금은 정말 어른의 도움이 필요했다."


translate japanese plot8_4c1bde95:



    voice "voice/keeko_76.ogg"
    nvl_keeko "걱정 마. 여기는 안전하니까 계속 숨어 있기만 하면 돼."


translate japanese plot8_423a063b:



    voice "voice/keeko_77.ogg"
    nvl_keeko "엄마를 만나면 이쪽으로 데려올게."


translate japanese plot8_476fe554:



    voice "voice/keemi_57.ogg"
    nvl_keemi "그럼 조심해, 언니……" (**end_page())


translate japanese plot8_30b05e46:



    nvl clear
    voice "voice/keeko_78.ogg"
    nvl_keeko "응, 금방 다녀올게."


translate japanese plot8_67c0df5f:


    nvlNone "언니는 살며시 장롱 문을 열고 틈으로 마구간 주변을 엿보았다."


translate japanese plot8_74884295:


    voice "voice/keeko_79.ogg"
    nvl_keeko "응, 괜찮을 것 같아." (**end_page())


translate japanese plot8_e1894fd8:


    nvlNone "근처에 사람 기척이 없다는 걸 확인한 뒤, 몰래 사다리를 내려갔다." (**end_page())


translate japanese plot8_9faafd64:


    nvlNone "언니가 사라지자\n장롱 안에는 나 혼자만 남았다."


translate japanese plot8_b0b2281e:


    nvlNone "지금 생각하면, 나도 함께 나갔어야 했다."


translate japanese plot8_b8d2fafc:


    nvlNone "아마 무서웠던 것 같다. 갑자기 모든 게 변해 버렸다는 사실을 아직 받아들이지 못하고 있었다."


translate japanese plot8_39b657a2:


    nvlNone "나와 언니는 언제까지나 함께 있어야 했는데." (**end_page())


translate japanese plot8_2fe532ee:



    nvl clear
    voice "voice/keemi_58.ogg"
    nvl_keemi "으음……"


translate japanese plot8_01842ec0:


    nvlNone "어두운 장롱 속에서 나는 또 깜빡 잠이 들었다." (**end_page())


translate japanese plot8_d7f17eb7:


    nvlNone "얼마나 지났을까.\n타닥타닥 터지는 소리에 겨우 눈을 떴다."


translate japanese plot8_c6d105ca:


    voice "voice/keemi_59.ogg"
    nvl_keemi "어!?"


translate japanese plot8_805d4653:


    voice "voice/keemi_60.ogg"
    nvl_keemi "(언니가 아직 안 돌아왔나?)" (what_prefix="", what_suffix="")


translate japanese plot8_fe67c2d6:


    nvlNone "나는 급히 눈을 뜨고 장롱 문을 밀었다." (**end_page())


translate japanese plot8_ee38bfbf:


    nvlNone "몇 번이고 밀려오는 불길의 파도가 이 작은 마을을 집어삼키고 있었다."


translate japanese plot8_34f49362:


    nvlNone "어디서나 탄내가 나고,\n불에 탄 집이 무너지는 소리가 곳곳에서 들려왔다."


translate japanese plot8_73ba188e:


    nvlNone "다행히 불길이 마구간으로 옮겨붙으려는\n바로 그 순간에 눈을 떴다."


translate japanese plot8_cb6edd3a:


    nvlNone "나는 서둘러 사다리를 내려가 마구간 밖으로 뛰쳐나갔다." (**end_page())


translate japanese plot8_c4dcb1ff:


    nvl clear
    voice "voice/keemi_61.ogg"
    nvl_keemi "언니!! 어디 있어!?" (**end_page())


translate japanese plot8_d0677183:


    nvlNone "그런데 밖으로 조금 달려 나가자마자 언니를 발견했다." (**end_page())


translate japanese plot8_5f1127ae:


    voice "voice/keemi_62.ogg"
    nvl_keemi "언니……?"


translate japanese plot8_4de33dd2:


    nvlNone "착각할 리 없었다. 언니의 옷을 입고 있었다."


translate japanese plot8_c78adc02:


    voice "voice/keemi_63.ogg"
    nvl_keemi "다, 다친 거야……?" (**end_page())


translate japanese plot8_afe213df:



    voice "voice/keeko_80.ogg"
    nvl_keeko2 "——치……치미……"


translate japanese plot8_7c268f8b:


    nvlNone "그것은 뒤돌아보며 목구멍 깊은 곳에서 신음하듯 내 이름을 불렀다."


translate japanese plot8_9bf579b4:


    nvlNone "하지만 다음 순간, 내게 덮쳐 왔다." (**end_page())


translate japanese plot8_bbdf0987:



    voice "voice/keemi_64.ogg"
    keemi "어, 언니, 안 돼——"


translate japanese plot8_8b169519:



    voice "voice/keemi_65.ogg"
    keemi "나야! 치미라고!"


translate japanese plot8_b7ca6665:



    voice "voice/keeko_81.ogg"
    keeko2 0106 "그르——!"


translate japanese plot8_60cb7170:



    voice "voice/keemi_66.ogg"
    keemi "헉——!"


translate japanese plot8_2e2ddb8a:


    "분명 이것은 더 이상 치미가 알던 언니가 아니었다."


translate japanese plot8_d25c14b6:


    "다른 시체들과 마찬가지로, 그저 남의 생명을 탐하는 시체일 뿐이었다."


translate japanese plot8_0ba1c0a1:



    voice "voice/keemi_67.ogg"
    keemi "어, 언니, 그러지 마……"


translate japanese plot8_5d517a53:



    voice "voice/keeko_82.ogg"
    keeko2 0106 "끄——아……으……"


translate japanese plot8_30461b66:


    "그것은 누구도 알아보지 못했다. 친동생조차도."


translate japanese plot8_1763cf43:


    "그저 눈앞의 생명체의 배를 갈라 자신과 똑같은 모습으로 바꾸려 하고 있었다."


translate japanese plot8_22f1b2d3:



    voice "voice/keeko_83.ogg"
    keeko2 0106 "크아!!!!"


translate japanese plot8_d62966d8:



    voice "voice/champion_179.ogg"
    champion 0304 "치미!!"


translate japanese plot8_470de847:


    nvlNone "절체절명의 순간, 용사의 검광이 다시 번쩍였다." (**end_page())


translate japanese plot8_ceb2d625:


    nvl clear
    nvlNone "서걱——!" (**end_page())


translate japanese plot8_2831c306:


    nvl clear
    nvlNone "용사는 망설이지 않았다——상대가\n생전에 자신을 따랐던 아이일지라도."


translate japanese plot8_a84d3bf9:


    nvlNone "이미 이렇게 된 이상, 어떤 감정도 도움이 되지 않았다." (**end_page())


translate japanese plot8_d3694182:


    nvl clear
    nvlNone "검은 쉽게 그 목을 베었다. 하지만 그 한 번의 일격이 얼마나 무거웠는지는 용사만이 알 것이다." (**end_page())


translate japanese plot8_6786b65e:


    nvlNone "머리 없는 시신이 동생 앞에서 천천히 쓰러졌다." (**end_page())


translate japanese plot8_449d2782:



    voice "voice/keemi_68.ogg"
    nvl_keemi "아, 아아……"


translate japanese plot8_33e5bbee:



    voice "voice/keemi_69.ogg"
    nvl_keemi "아아아아——!!!" (**end_page())


translate japanese plot8_4cb0c892:



    voice "voice/champion_180.ogg"
    nvl_champion "괜찮아, 치미. 이제 괜찮아."


translate japanese plot8_b6916162:



    voice "voice/keemi_70.ogg"
    nvl_keemi "아, 아니, 언니, 난……" (**end_page())


translate japanese plot8_bfee6c4d:


    nvl clear
    nvlNone "눈앞에서 벌어진 일은 동생이 감당하기에 너무나 무거웠다."


translate japanese plot8_a2d8969d:


    nvlNone "발밑까지 굴러온 언니의 머리를 멍하니 바라보며, 어찌해야 할지도 모른 채 있었다." (**end_page())


translate japanese plot8_46622907:


    nvl clear
    nvlNone "공포도, 놀라움도, 슬픔도……울부짖을 수조차 없었다."


translate japanese plot8_bc47dc56:


    nvlNone "영영 깨어날 수 없는 악몽 같았다." (**end_page())


translate japanese plot8_f7505f4c:



    nvl clear
    voice "voice/champion_181.ogg"
    nvl_champion "괜찮아. 우리가 있잖아. 이제 괜찮아……"


translate japanese plot8_a8eedbec:



    voice "voice/keemi_71.ogg"
    nvl_keemi "나, 나는……" (**end_page())


translate japanese plot8_c5236cb0:


    nvlNone "용사는 치미를 품에 끌어안고\n몇 번이고 다정하게 달래는 것밖에 할 수 없었다."


translate japanese plot8_c72ef47d:


    nvlNone "하지만 무슨 말을 해도 소용없다는 걸 알고 있었다. 눈앞에서 벌어진 일을 이해하는 순간, 이 아이의 마음은 분명 무너지고 말 것이다." (**end_page())


translate japanese plot8_edbcb1f5:



    voice "voice/equinox_227.ogg"
    nvl_equinox "잠들어." (what_style="plot8_pov_reaction_text", **end_page())


translate japanese plot8_2733094a:


    nvlNone "나는 손가락을 튕겨 마법으로 치미를 잠들게 했다.\n치미는 용사의 품 안에서 조용히 눈을 감았다." (**end_page())


translate japanese plot8_1589e46e:



    voice "voice/champion_182.ogg"
    nvl_champion "아사요!"


translate japanese plot8_0fae523e:



    voice "voice/equinox_228.ogg"
    nvl_equinox "네가 달랠 수 있는 상태가 아니야, 용사."


translate japanese plot8_cdbab5fe:



    voice "voice/champion_183.ogg"
    nvl_champion "그렇다고 이렇게 거칠게 재우다니……" (**end_page())


translate japanese plot8_283dac34:



    voice "voice/equinox_229.ogg"
    nvl_equinox "다른 방법이 있어? 달래 가며 이 지옥에서 데리고 나갈 생각이야?"


translate japanese plot8_9d28c46c:



    voice "voice/champion_184.ogg"
    nvl_champion "…"


translate japanese plot8_1d5a59c2:



    voice "voice/champion_185.ogg"
    nvl_champion "젠장……" (**end_page())


translate japanese plot8_4388fe50:



    voice "voice/equinox_230.ogg"
    nvl_equinox "가자. 이 아이는 살아남았어.\n그것만으로도 기적이야."


translate japanese plot8_2eced99b:



    voice "voice/equinox_231.ogg"
    nvl_equinox "이 이상 아이가 감당할 수 없는 걸\n짊어지게 하지 마." (**end_page())


translate japanese plot8_d8a689b0:


    nvlNone "싸움은 아침까지 이어졌다."


translate japanese plot8_6380f4da:


    nvlNone "마법의 비로 불은 모두 껐다. 하지만 마을은 이미 불에 타 무너져, 남은 것이라곤 잔해뿐이었다."


translate japanese plot8_bc745e84:


    nvlNone "우리 일행은 꼬박 하룻밤을 들여 마을의 마물을 모두 토벌했다." (**end_page())


translate japanese plot8_cc6c2153:



    voice "voice/dorothea_122.ogg"
    nvl_dorothea "다 끝났어?"


translate japanese plot8_30c090ff:



    voice "voice/equinox_232.ogg"
    nvl_equinox "응. 탐지 마법으로 여러 번 살펴봤어. 근처에 마물은 없을 거야."


translate japanese plot8_14adcb64:



    voice "voice/dorothea_123.ogg"
    nvl_dorothea "드디어 다 치웠네……" (**end_page())


translate japanese plot8_57aefe6b:


    nvl clear
    nvlNone "도로시아는 한숨을 쉬며 옆의 잔해 더미 위에 털썩 앉았다."


translate japanese plot8_540a171c:


    nvlNone "그 얼굴에 드러난 것은 피로보다는, 소중한 무언가를 잃고 마음에 구멍이 뚫린 듯한 상실감이었다."


translate japanese plot8_08a29e4f:



    voice "voice/dorothea_124.ogg"
    nvl_dorothea "우리가 더 일찍 알아챘더라면……" (**end_page())


translate japanese plot8_01e514c3:


    nvlNone "오는 도중 며칠이나 발이 묶였던 게 떠오른 모양이다. 몹시 분하다는 듯 얼굴을 일그러뜨리고 있었다."


translate japanese plot8_3249b755:



    voice "voice/equinox_233.ogg"
    nvl_equinox "며칠 일찍 도착했더라도 아마 결과는 달라지지 않았을 거야."


translate japanese plot8_3af4e881:



    voice "voice/equinox_234.ogg"
    nvl_equinox "내가 성수의 힘을 너무 얕봤어……" (**end_page())


translate japanese plot8_01642034:



    voice "voice/champion_186.ogg"
    nvl_champion "다녀왔어."


translate japanese plot8_c45e7441:



    voice "voice/equinox_235.ogg"
    nvl_equinox "네 쪽 마물도 다 처리했어?"


translate japanese plot8_f731ff94:



    voice "voice/champion_187.ogg"
    nvl_champion "응. 「열쇠」는 찾았어?"


translate japanese plot8_14ec8a28:



    voice "voice/equinox_236.ogg"
    nvl_equinox "여기 있어." (**end_page())


translate japanese plot8_ed000349:


    nvlNone "주머니에서 짙은 붉은색 결정을 꺼냈다.\n이번 일의 목적이자 모든 일의 원흉이다."


translate japanese plot8_43592cba:



    voice "voice/champion_188.ogg"
    nvl_champion "마나 결정이랑 비슷하게 생겼네……" (**end_page())


translate japanese plot8_239ac140:



    voice "voice/equinox_237.ogg"
    nvl_equinox "겉모습은 비슷해도, 안에 담긴 힘은 차원이 달라."


translate japanese plot8_713aecac:



    voice "voice/equinox_238.ogg"
    nvl_equinox "너도 알 수 있을 거야."


translate japanese plot8_8b7249e6:



    voice "voice/champion_189.ogg"
    nvl_champion "응……아주 불쾌한 기운이 느껴져." (**end_page())


translate japanese plot8_9ed2dc2b:



    nvl clear
    voice "voice/equinox_239.ogg"
    nvl_equinox "이 「기운」이 마을 주민들을 침식한 거야."


translate japanese plot8_af9451fd:



    voice "voice/equinox_240.ogg"
    nvl_equinox "봉인 마법을 여러 겹 걸어 뒀어. 지금은 더 이상 바깥에 영향을 미칠 수 없어."


translate japanese plot8_13e9e030:



    voice "voice/champion_190.ogg"
    nvl_champion "어떻게 처리할 거야?" (**end_page())


translate japanese plot8_aa5f8a31:



    nvl clear
    voice "voice/equinox_241.ogg"
    nvl_equinox "흡수할 거야. 원래 내 몸의 일부였으니까."


translate japanese plot8_eac27bad:



    voice "voice/champion_191.ogg"
    nvl_champion "……제어할 수 있겠어?"


translate japanese plot8_528cb135:



    voice "voice/champion_192.ogg"
    nvl_champion "아사요마저 그 힘에 삼켜지지는 않았으면 해."


translate japanese plot8_c8f57195:



    voice "voice/equinox_242.ogg"
    nvl_equinox "나도 확신은 없어서, 네가 돌아오길 기다리고 있었어." (**end_page())


translate japanese plot8_59dc82a4:



    nvl clear
    voice "voice/champion_193.ogg"
    nvl_champion "……알았어. 아사요 생각대로 해."


translate japanese plot8_4e2db43d:



    voice "voice/champion_194.ogg"
    nvl_champion "더는 검을 뽑게 하지 마. 나도 지쳤으니까."


translate japanese plot8_c80818a7:



    voice "voice/equinox_243.ogg"
    nvl_equinox "응, 고마워." (**end_page())


translate japanese plot8_488ca615:


    nvlNone "용사가 돌아오기를 기다린 건, 결정을 흡수하는 데 실패했을 때 나를 처리할 수 있는 사람이 필요했기 때문이다."


translate japanese plot8_148ac6a2:


    nvlNone "원래라면 이렇게 위험한 행동은 하지 않았을 것이다. 하지만……" (**end_page())


translate japanese plot8_efc5db23:


    nvlNone "나는 깊이 숨을 들이마시고, 결정을 가슴속에 묻어 넣었다." (**end_page())


translate japanese plot8_73d42ed9:



    voice "voice/equinox_244.ogg"
    nvl_equinox "윽……!"


translate japanese plot8_3c20dfc2:


    nvlNone "지난번보다 훨씬 격렬한 마력이 해일처럼 결정에서 뿜어져 나와, 순식간에 온몸으로 퍼졌다." (**end_page())


translate japanese plot8_afe0bc92:


    nvl clear
    nvlNone "잇달아 넘쳐 나오는 마력이 내 한계를 억지로 뚫고, 몸을 안쪽에서 찢어 놓으려 한다."


translate japanese plot8_0889ab62:



    voice "voice/equinox_245.ogg"
    nvl_equinox "커헉!!"


translate japanese plot8_7615dd6a:


    nvlNone "온몸의 구멍에서 액체가 흘러나왔다. 하지만 피는 아니다. 지나치게 짙어진 마력이 액체가 된 것이다." (**end_page())


translate japanese plot8_abbecf85:



    voice "voice/dorothea_125.ogg"
    nvl_dorothea "아사요!"


translate japanese plot8_0fd9f958:


    nvlNone "두 동료가 내 상태를 몹시 걱정하고 있다는 걸 알았다."


translate japanese plot8_38a4ccf7:


    nvlNone "간신히 한 손을 저어 두 사람에게 아직 괜찮다는 뜻을 전했다." (**end_page())


translate japanese plot8_ee80c275:


    nvlNone "이제 도로시아의 힘에는 기댈 수 없다. 이번에는 오직 내 힘으로 몸속에서 날뛰는 마력을 가라앉혀야 한다."


translate japanese plot8_41be4e1e:


    nvlNone "지난번의 경험 덕분에, 마력을 다루는 솜씨는 훨씬 섬세해졌다." (**end_page())


translate japanese plot8_0bf7ce24:


    nvlNone "쓸 수 있는 마력을 모두 모아 가슴의 결정을 억눌렀다. 그런 다음 몸속에서 어지럽게 흐르는 마력을 조금씩 정돈해 갔다."


translate japanese plot8_37c556e8:


    nvlNone "길고 고통스러운 시간이 이어진다. 이것은 나 혼자만의 싸움이다." (**end_page())


translate japanese plot8_083c4960:


    nvlNone "얼마나 지났는지 모른다. 마침내 몸속 마력이 안정되었다." (**end_page())


translate japanese plot8_e2ac6c64:


    nvlNone "눈을 뜨자 두 동료는 여전히 긴장한 채 나를 바라보고 있었다."


translate japanese plot8_30f7dc1a:



    voice "voice/equinox_246.ogg"
    nvl_equinox "이젠 괜찮아……억누르는 데 성공했어."


translate japanese plot8_125dcf1d:


    nvlNone "나 자신도 알아듣지 못할 만큼 작은 목소리였다. 하지만 두 사람의 얼굴에서 긴장이 풀리는 걸 보고 제대로 전해졌다는 걸 알았다." (**end_page())


translate japanese plot8_9c581a35:



    nvl clear
    voice "voice/dorothea_126.ogg"
    nvl_dorothea "정말 놀랐잖아……"


translate japanese plot8_522cbe74:



    voice "voice/champion_195.ogg"
    nvl_champion "후……"


translate japanese plot8_93d33b53:



    voice "voice/equinox_247.ogg"
    nvl_equinox "미안해. 걱정하게 했네." (**end_page())


translate japanese plot8_ec12497a:


    nvl clear
    nvlNone "법의로 얼굴을 닦았다. 아직 피부에 남은 액체 마력이\n가랑비 속에서 옅은 푸른빛을 내고 있었다."


translate japanese plot8_f060a8b1:



    voice "voice/champion_196.ogg"
    nvl_champion "밖으로 가자. 사람들이 기다리고 있어." (**end_page())


translate japanese plot8_8619438e:


    nvlNone "마을에서 멀지 않은 숲에 임시 야영지를 마련했다."


translate japanese plot8_924ad2fb:


    nvlNone "살아남은 다섯, 여섯 사람이 불 꺼진 모닥불 주위에 모여, 불안하게 주변을 둘러보고 있었다."


translate japanese plot8_53cd2718:


    nvlNone "우리가 돌아오는 걸 보자\n모두의 굳은 표정이 조금 누그러졌다." (**end_page())


translate japanese plot8_ee6f8e64:



    voice "voice/npc39_01.ogg"
    npc39 "모험가님……"


translate japanese plot8_e6291212:



    voice "voice/champion_197.ogg"
    champion "미안해. 다른 생존자는 찾지 못했어……"


translate japanese plot8_895dccac:



    voice "voice/npc39_02.ogg"
    npc39 "아닙니다. 사과하실 필요 없어요."


translate japanese plot8_026f9a1f:



    voice "voice/npc39_03.ogg"
    npc39 "여러분이 아니었다면 저희는 진작……"


translate japanese plot8_3c53a77f:


    "이 몇 명이 우리가 밤새 찾아낸 생존자였다."


translate japanese plot8_f26c3019:


    "그 지옥에서 살아남은, 마을에서도 몇 안 되는 운 좋은 사람들이었다."


translate japanese plot8_bd4e3abb:


    "하지만 치미처럼 그들 역시 갑작스러운 재앙을 아직 받아들이지 못하고 있었다."


translate japanese plot8_2200f0eb:



    voice "voice/champion_198.ogg"
    champion "치미는?"


translate japanese plot8_d7d8eadb:



    voice "voice/npc39_04.ogg"
    npc39 "방금 일어났어요. 저쪽에 있어요."


translate japanese plot8_4d14882b:


    "생존자가 야영지 반대편을 가리켰다."


translate japanese plot8_8903b03f:



    voice "voice/champion_199.ogg"
    champion "지금은 푹 쉬어. 이제 안전한 곳까지 우리가 데려갈게."


translate japanese plot8_fa9057ef:



    voice "voice/npc39_05.ogg"
    npc39 "모험가님……정말 감사합니다……"


translate japanese plot8_01ba6656:



    voice "voice/keemi_72.ogg"
    keemi 0106 "…"


translate japanese plot8_932919d5:



    voice "voice/champion_200.ogg"
    champion 0301 "치미……"


translate japanese plot8_3d5ec668:



    voice "voice/keemi_73.ogg"
    keemi 0106 "용사님……"


translate japanese plot8_451b09fe:



    voice "voice/champion_201.ogg"
    champion 0306 "미안해……내가……"


translate japanese plot8_044f4c3e:



    voice "voice/keemi_74.ogg"
    keemi 0106 "용사님은 사과하실 필요 없어요. 저를 구하려고 언니를 베신 거잖아요."


translate japanese plot8_2a4c86d1:



    voice "voice/champion_202.ogg"
    champion 0306 "그때 언니는 이미 마물이 되어 있었어. 베지 않았다면 치미까지……"


translate japanese plot8_ef0efc26:



    voice "voice/keemi_75.ogg"
    keemi 0106 "알아요. 하지만……"


translate japanese plot8_0988f307:



    voice "voice/keemi_76.ogg"
    keemi 0106 "……언니는 그때 제 이름을 불렀어요."


translate japanese plot8_bf65f9df:



    voice "voice/keemi_77.ogg"
    keemi 0106 "저도 그런 언니와 함께 죽는 편이 나았을지도 몰라요……"


translate japanese plot8_932919d5_1:



    voice "voice/champion_203.ogg"
    champion 0306 "치미……"


translate japanese plot8_3f653981:



    voice "voice/keemi_78.ogg"
    keemi 0106 "죄송해요, 용사님……"


translate japanese plot8_e5a0b838:



    voice "voice/keemi_79.ogg"
    keemi 0106 "지금은……용사님을 보고 싶지 않아요."


translate japanese plot8_b826624b_1:



    voice "voice/equinox_248.ogg"
    nvl_equinox "…"


translate japanese plot8_14523b97:



    voice "voice/equinox_249.ogg"
    nvl_equinox "(이걸로 괜찮았던 걸까……)" (what_prefix="", what_suffix="", **end_page())


translate japanese plot8_da008095:



    voice "voice/champion_204.ogg"
    nvl_champion "여기 앉아도 돼?"


translate japanese plot8_034fc8ee:



    voice "voice/equinox_250.ogg"
    nvl_equinox "마음대로 해."


translate japanese plot8_32f205da:



    voice "voice/champion_205.ogg"
    nvl_champion "뭘 쓰고 있어?" (**end_page(ctc_displayable="ctc_end_portrait_right"))


translate japanese plot8_3a868eda:



    voice "voice/equinox_251.ogg"
    nvl_equinox "「열쇠」를 흡수할 때의 느낌과\n봉인 마법 개선안."


translate japanese plot8_43162c6e:



    voice "voice/champion_206.ogg"
    nvl_champion "그렇구나……"


translate japanese plot8_eefc3445:


    nvlNone "용사가 무슨 말을 하고 싶은지 알고 있었다." (**end_page(ctc_displayable="ctc_end_portrait_left"))


translate japanese plot8_b47621da:


    nvl clear
    nvlNone "하지만 나 역시 본능적으로 그 화제를 피하고 있었다."


translate japanese plot8_f227390d:


    nvlNone "「열쇠」는 손에 넣었다. 하지만\n이걸 승리라고 부를 수는 없다."


translate japanese plot8_816cdf6b:


    nvlNone "마을 하나가 멸망한 끝에 남은,\n너무나 쓰디쓴 결과였다."


translate japanese plot8_0ca70a5f:


    nvlNone "나도……아니, 우리도\n이 패배를 인정하고 싶지 않았다." (**end_page(ctc_displayable="ctc_end_portrait_left"))


translate japanese plot8_e05ff541:



    voice "voice/champion_207.ogg"
    nvl_champion "무력감인가……"


translate japanese plot8_6cad3ddf:


    nvlNone "용사는 내가 무슨 생각을 하는지 눈치챘는지도 모른다. 아니, 그녀도 같은 마음이었을 것이다."


translate japanese plot8_0b4ef901:



    voice "voice/champion_208.ogg"
    nvl_champion "이 대륙에서 가장 강한 모험가인데도, 그들을 구할 수 없었다니……" (**end_page(ctc_displayable="ctc_end_portrait_right"))


translate japanese plot8_f1aeb7f5:



    voice "voice/equinox_252.ogg"
    nvl_equinox "용사. 나도 분해. 하지만 우리가 모든 사람을 구할 수는 없어."


translate japanese plot8_296c52ce:



    voice "voice/equinox_253.ogg"
    nvl_equinox "이런 일은……\n앞으로의 여정에서도 몇 번이고 일어나."


translate japanese plot8_867ab2cc:



    voice "voice/equinox_254.ogg"
    nvl_equinox "네가 구한 사람조차 널 원망할 수 있어."


translate japanese plot8_6ca69d2d:



    voice "voice/equinox_255.ogg"
    nvl_equinox "우리는……모두를 구할 수 없으니까." (**end_page(ctc_displayable="ctc_end_portrait_left"))


translate japanese plot8_e7406ee1:



    voice "voice/champion_209.ogg"
    nvl_champion "그렇지……"


translate japanese plot8_f51afb89:



    voice "voice/champion_210.ogg"
    nvl_champion "그래도, 누군가에게 원망을 받더라도, 난 구하는 걸 포기하지 않겠어."


translate japanese plot8_c8b8bbcf:



    voice "voice/champion_211.ogg"
    nvl_champion "무슨 일이 있든 모두를 구하려 할 거야……"


translate japanese plot8_4497420e:



    voice "voice/champion_212.ogg"
    nvl_champion "그게 내 역할이니까." (**end_page(ctc_displayable="ctc_end_portrait_right"))


translate japanese plot8_8dbda1e0:



    voice "voice/equinox_256.ogg"
    nvl_equinox "후……"


translate japanese plot8_3485e574:



    voice "voice/champion_213.ogg"
    nvl_champion "왜? 내가 너무 순진한 것 같아?"


translate japanese plot8_0541579d:



    voice "voice/equinox_257.ogg"
    nvl_equinox "그럴 리가. 예전에 비슷한 말을 해 준 사람이 생각났을 뿐이야." (**end_page(ctc_displayable="ctc_end_portrait_right"))


translate japanese plot8_a0fc3fab:



    nvl clear
    voice "voice/equinox_258.ogg"
    nvl_equinox "앞으로 뭐가 기다릴지는 몰라.\n그래도 적어도 첫걸음은 내디뎠어."


translate japanese plot8_874fb243:



    voice "voice/champion_214.ogg"
    nvl_champion "응……"


translate japanese plot8_4ca5c2e1:



    voice "voice/champion_215.ogg"
    nvl_champion "다음에는……이런 결과로 끝나게 둘 수 없어." (**end_page(ctc_displayable="ctc_end_portrait_right"))


translate japanese plot8_46541ac1:



    voice "voice/champion_216.ogg"
    nvl_champion "아사요, 나랑 같이 그 「나무」를 없애 버리자."


translate japanese plot8_834b5ccc:



    voice "voice/equinox_259.ogg"
    nvl_equinox "나와 도로시아가 널 따라가는 이유가 그거잖아?" (**end_page(ctc_displayable="ctc_end_portrait_right"))


translate japanese plot8_7cdaebaa:


    nvlNone "용사와 나는 웃는지 우는지도 알 수 없는 엉망인 표정을 지었다. 슬픔과 스스로에 대한 조소가 섞인 얼굴이었다." (**end_page())


translate japanese plot8_c70e4381:


    nvl clear
    nvlNone "둘이서 이 패배를 삼켰다. 그 고통 깊숙이 남은 것은——"


translate japanese plot8_d1a4a053:


    nvlNone "결심."


translate japanese plot8_88a5bd2a:


    nvlNone "——그래도 우리는 앞으로 나아간다." (**end_page())


translate japanese plot8_72cdcb74:


    nvlNone "이때부터 우리는 서로를 진정한 「동료」로\n바라보기 시작했다." (**end_page())


translate japanese plot8_b32a257f:



    voice "voice/cygnus_1102.ogg"
    cygnus "으……음……"


translate japanese plot8_e97e030c:


    "꿈속에서 풀려난 기억은 점점 또렷해졌다. 모든 세부 사항을 정확하게 떠올릴 수 있었다."


translate japanese plot8_41b0670e:


    "강렬한 감정도 함께 지금의 몸으로 전해졌다."


translate japanese plot8_7b0de048:


    "분함, 울분, 결심, 그리고……"


translate japanese plot8_c3c37a09:



    voice "voice/cygnus_1103.ogg"
    cygnus "이건! 으——!"


translate japanese plot8_660a0bba:


    "거대한 힘이 몸 안으로 밀려들어, 시노스는 순간 강한 현기증을 느꼈다."


translate japanese plot8_09ac5cf6:



    voice "voice/cygnus_1104.ogg"
    cygnus "마나 멀미……인가……"


translate japanese plot8_20eb7bde:


    "시노스가 그 힘을 가다듬자, 가슴팍에서 짙은 붉은색 결정이 조금씩 형태를 이루었다."


translate japanese plot8_8b50ab86:



    voice "voice/cygnus_1105.ogg"
    cygnus 0304 "「열쇠」!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_55c9efcc:



    voice "voice/blackcat_14.ogg"
    blackcat 0102 "오호! 그걸 어디서 구했어?"


translate japanese plot8_62e06524:


    "시노스도 의아하기는 마찬가지였다."


translate japanese plot8_0e62dd74:



    voice "voice/cygnus_1106.ogg"
    cygnus "(설마……기억이 돌아오면서 힘도 함께 돌아오는 건가……)"


translate japanese plot8_fd44697b:



    voice "voice/blackcat_18.ogg"
    blackcat "냐하하, 그 힘이 있으면 오늘 무슨 일을 만나도 겁날 게 없겠네."


translate japanese plot8_4f8debd3:



    voice "voice/cygnus_1107.ogg"
    cygnus "시끄러워!"


translate japanese plot8_a172b294:



    voice "voice/blackcat_22.ogg"
    blackcat "아야!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot8_dcee69c5:



    voice "voice/tianqin_1965.ogg"
    tianqin "으아——! 어느새 월례 시험 날이네……"


translate japanese plot8_0f2192f8:


    "방에서 상태를 가다듬은 시노스도 밖으로 나왔다."


translate japanese plot8_9f8ae0ed:


    "오늘을 위해 할 수 있는 준비는 모두 해 두었다. 그 이상한 마녀의 예언이 어디까지 맞을지는 모른다. 그래도 정말 무슨 일이 일어날지도 몰랐다."


translate japanese plot8_4db6b6ee:



    voice "voice/tianqin_1966.ogg"
    tianqin "시노스 짱."


translate japanese plot8_f4d16350:



    voice "voice/cygnus_1108.ogg"
    cygnus "이름에 짱 좀 붙이지 마."


translate japanese plot8_3bf6205e:



    voice "voice/cygnus_1109.ogg"
    cygnus "왜 그래?"


translate japanese plot8_48d9d8cf:



    voice "voice/tianqin_1967.ogg"
    tianqin "긴장돼?"


translate japanese plot8_fcc70232:



    voice "voice/cygnus_1110.ogg"
    cygnus "아니."


translate japanese plot8_48e65031:



    voice "voice/tianqin_1968.ogg"
    tianqin "오? 자신 있나 보네."


translate japanese plot8_c4665e75:



    voice "voice/cygnus_1111.ogg"
    cygnus "내 능력 밖의 일이 생긴다면, 아무리 걱정해도 소용없어."


translate japanese plot8_dae97b00:



    voice "voice/cygnus_1112.ogg"
    cygnus "반대로 내가 처리할 수 있는 일이라면, 더더욱 걱정할 필요가 없지."


translate japanese plot8_c4ac495c:



    voice "voice/tianqin_1969.ogg"
    tianqin "그런 식으로 생각하다니, 뭐랄까……달관했네."


translate japanese plot8_ebe3076d:



    voice "voice/cygnus_1113.ogg"
    cygnus "칭찬하는 거야?"


translate japanese plot8_fbd72e74:



    voice "voice/tianqin_1970.ogg"
    tianqin "응, 물론이지!"


translate japanese plot8_41668012:



    voice "voice/tianqin_1971.ogg"
    tianqin "아무튼 내 도움이 필요하면 바로 전화해."


translate japanese plot8_2334068b:



    voice "voice/cygnus_1114.ogg"
    cygnus "알아. 그런데 오늘 시험 봐야 하지 않아?"


translate japanese plot8_c76a622d:



    voice "voice/tianqin_1972.ogg"
    tianqin "그런 시험보다 시노스가 훨씬 중요하지."


translate japanese plot8_74071a79:



    voice "voice/cygnus_1115.ogg"
    cygnus "……알았어. 필요하면 연락할게."


translate japanese plot8_c500467b:



    voice "voice/cygnus_1116.ogg"
    cygnus "라이라."


translate japanese plot8_f0e2e7e7_1:



    voice "voice/tianqin_1973.ogg"
    tianqin "응?"


translate japanese plot8_a7da469c:


    voice "voice/cygnus_1117.ogg"
    cygnus "(시험 잘 봐.)"


translate japanese plot8_b942db9a:



    voice "voice/tianqin_1974.ogg"
    tianqin "어? 뭐라고 했어?"


translate japanese plot8_69732057:



    voice "voice/cygnus_1118.ogg"
    cygnus "아무것도 아니야. 어서 학교나 가."


translate japanese plot8_d5b30a0e:



    voice "voice/tianqin_1975.ogg"
    tianqin "어어——?"


translate japanese plot8_b06a4aa3:



    voice "voice/npc6_36.ogg"
    npc6 "흐아아암――"


translate japanese plot8_40f982a8:



    voice "voice/npc7_31.ogg"
    npc7 "와, 다크서클 심하다. 늦게까지 복습했어?"


translate japanese plot8_1e20bf8b:



    voice "voice/npc6_37.ogg"
    npc6 "말도 마. 어젯밤에는 거의 못 잤어……"


translate japanese plot8_4cd3880a:



    voice "voice/npc6_38.ogg"
    npc6 "試験前はいつもこう。教科書も頭に入らないし、プレッシャーがすごくて。"


translate japanese plot8_8718f53f:



    voice "voice/npc7_32.ogg"
    npc7 "아이, 그러면 실력 발휘하기도 힘들잖아."


translate japanese plot8_6cf89fdb:



    voice "voice/npc6_39.ogg"
    npc6 "에휴, 운에 맡겨야지."


translate japanese plot8_8f8df60b:



    voice "voice/npc6_40.ogg"
    npc6 "今回、試験会場どこ？"


translate japanese plot8_abeaa5aa:



    voice "voice/npc7_33.ogg"
    npc7 "생물 실험실 C."


translate japanese plot8_f53a67ef:



    voice "voice/npc6_41.ogg"
    npc6 "와, 최악이네. 생물 실험실은 이상한 냄새가 나잖아——"


translate japanese plot8_510d9e59:



    voice "voice/npc7_34.ogg"
    npc7 "前の試験で失敗したから。仕方ないよ。"


translate japanese plot8_c00fd07c:



    voice "voice/npc7_35.ogg"
    npc7 "이번에는 등수 올려서 꼭 빠져나갈 거야!"


translate japanese plot8_aa1ee43f:


    "시험 당일이 되자 교실의 공기는 지난 며칠보다 조금 가벼워져 있었다."


translate japanese plot8_9b17ac77:


    "이제 시험을 위해 뭔가 해 보려 해도 늦었다."


translate japanese plot8_72ca5a8f:


    "자신만만해 보이는 사람도 있었고, 운에 맡기겠다는 사람도 있었다."


translate japanese plot8_625557e2:


    "교실은 이미 시험용으로 재배치되어, 남는 책상과 의자는 복도로 나가 있었다."


translate japanese plot8_eb09b52f:


    "원래 마흔 명 넘는 학생이 들어가던 교실에는 이제 책걸상 스무 벌만 남아 있었다. 몇몇 학생은 선 채로 이야기를 나눴다."


translate japanese plot8_5ebcd0f6:


    "대부분의 학생은 이미 자기 시험장으로 향한 뒤였다."


translate japanese plot8_b765d7f8:


    "시험장 배정은 지난 시험 등수에 따라 이루어졌다."


translate japanese plot8_09ba72c2:


    "成績のいい生徒は一組の教室に入り、そこから順位順に二組、三組、四組へと分けられる。"


translate japanese plot8_13340c54:


    "각 교실은 정규 시험장 형태로 배치되어, 응시생 간격을 확보하려고 일부 책걸상을 복도로 옮겼다."


translate japanese plot8_e5461c3b:


    "그러니 모든 학생이 교실에서 시험을 볼 수는 없었다. 성적이 낮은 학생은 화학실이나 생물실 같은 실험실에 배정되었다."


translate japanese plot8_85921349:


    "もちろん、実験室は机も椅子も、教室ほど居心地がよくない。"


translate japanese plot8_6e84c747:


    "하지만 그것 역시 학교의 의도였다. 중위권 이상의 학생만 교실에서 시험을 볼 수 있게 한 것이다."


translate japanese plot8_9d4b97fe:



    voice "voice/tianqin_1976.ogg"
    tianqin "좋은 아침."


translate japanese plot8_1265d8d3:



    voice "voice/yangxi_716.ogg"
    yangxi "안녕."


translate japanese plot8_370c6823:



    voice "voice/yangxi_717.ogg"
    yangxi "으음——"


translate japanese plot8_60317b7c:



    voice "voice/tianqin_1977.ogg"
    tianqin "왜 그렇게 빤히 봐?"


translate japanese plot8_ff3a07d5:



    voice "voice/tianqin_1978.ogg"
    tianqin "내 안색이 안 좋아?"


translate japanese plot8_7d44f96f:



    voice "voice/yangxi_718.ogg"
    yangxi "알고 있으면 됐어."


translate japanese plot8_1910ea8d:



    voice "voice/tianqin_1979.ogg"
    tianqin "시험이잖아? 게다가 첫 시간부터 제일 약한 수학이란 말이야."


translate japanese plot8_27ec9d28:



    voice "voice/yangxi_719.ogg"
    yangxi "반대로 생각하면, 가장 큰 고비부터 넘기니 그 뒤로는 훨씬 편하잖아?"


translate japanese plot8_e97e299c:



    voice "voice/tianqin_1980.ogg"
    tianqin "난 제일 어려운 건 마지막에 남기는 편이거든——"


translate japanese plot8_eaf809ff:



    voice "voice/yangxi_720.ogg"
    yangxi "너 지난 시험 몇 등이었지?"


translate japanese plot8_deb0acc0:



    voice "voice/tianqin_1981.ogg"
    tianqin "아마 30등쯤이었던 것 같은데."


translate japanese plot8_01ded8e1:



    voice "voice/yangxi_721.ogg"
    yangxi "그럼 우리 시험장은 둘 다 옆 건물이겠네."


translate japanese plot8_b20fbd80:



    voice "voice/yangxi_722.ogg"
    yangxi "もう行く？　向こうのほうが静かなはず。"


translate japanese plot8_33080567:



    voice "voice/tianqin_1982.ogg"
    tianqin "음——시작까지 아직 한 시간 남았네."


translate japanese plot8_30894a36:



    voice "voice/tianqin_1983.ogg"
    tianqin "그래도 좋아. 어차피 어디 앉아서 교과서랑 문제집 좀 볼 거였으니까."


translate japanese plot8_a6fd26eb:



    voice "voice/yangxi_723.ogg"
    yangxi "이제 와서 뭘 해도 늦었는데?"


translate japanese plot8_a97a4e9f:



    voice "voice/tianqin_1984.ogg"
    tianqin "알아! 마지막으로 한 번 더 보고 다시 외우려는 것뿐이야!"


translate japanese plot8_e3d410fa:


    "두 사람은 시험장 교실 앞에 도착했다. 자기 반보다 확실히 훨씬 조용했다."


translate japanese plot8_0723c0e3:



    voice "voice/tianqin_1985.ogg"
    tianqin "우등생들은 여전히 조용하네."


translate japanese plot8_83864725:



    voice "voice/yangxi_724.ogg"
    yangxi "난 조용한 곳을 찾고 있었으니 딱 좋네."


translate japanese plot8_bb9a3ec5:


    "라이라와 히나타가 교실에 들어서자, 금세 다른 학생들의 시선이 쏠렸다."


translate japanese plot8_ad376e57:


    "다만 대부분의 시선은 히나타를 향하고 있었다."


translate japanese plot8_e705ae79:


    "입학한 뒤 지금까지, 히나타는 모든 시험에서 학년 1등이었다. 여기 있는 누구나 언젠가 넘어서고 싶어 하는 상대였다."


translate japanese plot8_f161b403:



    voice "voice/tianqin_1986.ogg"
    tianqin "다들 너만 보는데."


translate japanese plot8_d1755021:



    voice "voice/yangxi_725.ogg"
    yangxi "쳐다보는 것밖에 못 하니까."


translate japanese plot8_900c6c6e:



    voice "voice/tianqin_1987.ogg"
    tianqin "방심하지 마. 이번에는 1등 못 할지도 모르잖아?"


translate japanese plot8_cb3a03ae:



    voice "voice/yangxi_726.ogg"
    yangxi "상상은 자유지."


translate japanese plot8_51dc37a0:



    voice "voice/tianqin_1988.ogg"
    tianqin "쳇~ 잘난 척은."


translate japanese plot8_4232fff5:


    "ヒナタは毎回、二位に大きな差をつけていた。当日の調子で順位が変わるようなレベルではない。"


translate japanese plot8_3e1a5a05:


    "모든 지식을 자기 것으로 만든 그녀는, 물으면 무슨 답이든 돌아오는 살아 있는 참고서 같았다."


translate japanese plot8_c7875a45:



    voice "voice/tianqin_1989.ogg"
    tianqin "じゃ、私は自分の試験会場に行くね。"


translate japanese plot8_0e497159:



    voice "voice/tianqin_1990.ogg"
    tianqin "끝나고 얘기하자."


translate japanese plot8_0586323a_1:



    voice "voice/yangxi_727.ogg"
    yangxi "응."


translate japanese plot8_1f98f563:



    voice "voice/tianqin_1991.ogg"
    tianqin "(음……이번 월례 시험 수학 범위는 문제없겠지.)"


translate japanese plot8_a20a4683:



    voice "voice/tianqin_1992.ogg"
    tianqin "(이상한 문제만 안 나오면 좋겠다.)"


translate japanese plot8_f8b348d5:


    "시험장에 도착한 라이라는 시험 전 마지막 준비를 하며 조금 긴장하기 시작했다."


translate japanese plot8_31cf3ba8:


    "시험 시작 15분 전, 감독 교사가 시험지를 들고 들어왔다."


translate japanese plot8_7f199517:


    "학생들도 복습용 교재를 정리해 복도로 내놓은 책상 위에 놓았다."


translate japanese plot8_fa3848b2:



    voice "voice/npc40_01.ogg"
    npc40 "시험과 관계없는 물건은 교실 밖으로 가져다 놓으세요. 곧 시험을 시작하겠습니다."


translate japanese plot8_c0596e55:



    voice "voice/npc40_02.ogg"
    npc40 "첫 시간은 수학입니다. 시험 시간은 오전 9시부터 11시 30분까지입니다."


translate japanese plot8_a748824d:


    "감독 교사는 칠판에 과목과 시험 시간을 적었다. 이제 시작 시간을 기다리는 일만 남았다."


translate japanese plot8_d79917ce:


    "시작까지 10분……5분……"


translate japanese plot8_163cdc1f:


    "시험 전 아무것도 하지 않고 기다리는 시간은 유난히 길었다. 모두의 팽팽한 신경을 조금씩 깎아 먹었다."


translate japanese plot8_288eb964:


    "마침내 감독 교사가 시험지 봉투를 열었다. 시험장의 모든 학생이 교사의 손에 들린 두툼한 시험지 뭉치를 뚫어지게 바라보았다."


translate japanese plot8_24ac5d8b:


    "그런데 바로 그때, 이 시험장에 있을 사람이 아닌 누군가가 나타났다."


translate japanese plot8_63c2bfa2:



    voice "voice/jinlaoshi_91.ogg"
    jinlaoshi "백 선생님!"


translate japanese plot8_43c21218:



    voice "voice/npc40_03.ogg"
    npc40 "어? 김 선생님? 여긴 어쩐 일이세요?"


translate japanese plot8_27021ab7:



    voice "voice/jinlaoshi_92.ogg"
    jinlaoshi "백 선생님, 학생을 찾으러 왔습니다."

translate japanese strings:


    old "{glitch=10}{color=#FFFFFF}{b}{font=SourceHanSerifSC-Heavy.otf}彻骨的记忆{/font}{/b}{/color}{/glitch}"
    new "{glitch=10}{color=#FFFFFF}{b}{font=SourceHanSerifSC-Heavy.otf}뼈에 사무치는 기억{/font}{/b}{/color}{/glitch}"


    old "{glitch=10}{color=#FFFFFF}{b}{font=SourceHanSerifSC-Heavy.otf}勇者的记忆{/font}{/b}{/color}{/glitch}"
    new "{glitch=10}{color=#FFFFFF}{b}{font=SourceHanSerifSC-Heavy.otf}용사의 기억{/font}{/b}{/color}{/glitch}"


translate japanese plot8_3e7418f7:

    nvlNone "남들이 보면 「겉돈다」고 할 만큼 올곧은 그 성격이 원예부의 우리를 지켜 주었다."


translate japanese plot8_1f5b027c:

    nvlNone "그녀의 얼굴에 쓸쓸한 기색이 잠깐 비쳤지만\n곧 표정을 추슬렀다."


translate japanese plot8_c5dfd9c0:

    nvlNone "귀찮은 걸 싫어하는 우리는 먼저 길드에 가는 일이 거의 없었다." (**end_page())


translate japanese plot8_e5f96175:

    nvlNone "어둠 속에서 서로의 모습이 보이고 나서야, 마음이 조금 놓였다." id plot8_e5f96175 (**end_page())


translate japanese plot8_26ef1e55:


    voice "voice/tianqin_1785.ogg"
    tianqin "우오오오오——파이팅——!" with Shake((0, 0, 0, 0), 0.5, dist=5)



translate japanese plot8_0dce0351:


    voice "voice/yangxi_602.ogg"
    yangxi "다음 주가 이번 학기 2차 월례 시험이야. 그러니까 이번 주말이 라이라의 정기 공부일인 셈이지."



translate japanese plot8_755dbf73:


    voice "voice/yangxi_606.ogg"
    yangxi "이 이틀 동안 얼마나 머리에 넣느냐에 달렸지."



translate japanese plot8_ebe7eba7:


    voice "voice/tianqin_1793.ogg"
    tianqin 0309 "히나타——거기서 시노스랑 귓속말만 하지 말고!"



translate japanese plot8_a6eae8b7:


    "공부하는 두 사람과 그녀는 서로를 방해하지 않았다. 거실에는 묘한 균형이 생겨났다."



translate japanese plot8_9eeb3694:


    voice "voice/tianqin_1796.ogg"
    tianqin "좋아, 수학은 이걸로 끝!"



translate japanese plot8_36183067:


    voice "voice/yangxi_612.ogg"
    yangxi "(완전 백수 집순이네.)"



translate japanese plot8_f3997f33:


    voice "voice/tianqin_1807.ogg"
    tianqin "아이, 어서 가 봐. 늦게 가면 신선한 재료는 사람들이 다 사 간단 말이야!"



translate japanese plot8_6e6d1aab:


    "라이라의 오지랖 덕에 조금 별난 두 사람이 함께 거리로 나서게 되었다."



translate japanese plot8_95170394:


    voice "voice/flame_46.ogg"
    npc36 "이봐——거기 두 사람——"



translate japanese plot8_06c7344c:


    voice "voice/flame_62.ogg"
    npc37 "정말 미안해. 지금 상황에서는 이렇게 급하게 만날 수밖에 없네."



translate japanese plot8_08b7c41d:


    voice "voice/flame_73.ogg"
    ataset "지금 내 힘으로는 「장로」의 전언을 전달할 수가 없네……"



translate japanese plot8_9ad3bdce:


    voice "voice/flame_74.ogg"
    ataset "이런 느낌 정말 싫어. 머릿속으로는 분명히 뜻을 아는데, 말로 꺼낼 수가\n없다니——"



translate japanese plot8_b90ae4b2:


    voice "voice/flame_77.ogg"
    ataset "다음 「순」의 넷째 날 아침!　반드시——■■■■■!!"



translate japanese plot8_345a3fdf:


    voice "voice/flame_78.ogg"
    ataset "반·드·시——■■!"



translate japanese plot8_ac5cd87b:


    voice "voice/flame_79.ogg"
    ataset "■■■!　■■■■……——대비해 둬."



translate japanese plot8_57e52b3b:


    voice "voice/flame_82.ogg"
    ataset "어머나——그것까지 잊었구나. 장로의 예측이 정말 맞았네."



translate japanese plot8_5ab43379:



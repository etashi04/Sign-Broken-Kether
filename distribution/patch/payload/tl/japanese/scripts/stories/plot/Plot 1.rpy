


translate japanese plot1_8f422523:


    nvlNone "……"


translate japanese plot1_e0c08164:


    nvlNone "누군가의 변덕으로,\n우연히 만난 행상인들을 돕는 바람에,"


translate japanese plot1_f67db9e2:


    nvlNone "오늘도 해가 지기 전에 마을에 도착하지 못했다."


translate japanese plot1_4fe5b79f:


    voice "voice/equinox_0001.ogg"
    nvlNone "「……이게 몇 번째야?」{p}투덜거리는 목소리와 함께 눈앞의 모닥불이 성가시게 타닥타닥 튀었다." (callback=nvl_page_voice, cb_page_voices=('voice/equinox_0001.ogg', None))


translate japanese plot1_dcb37f66:


    nvlNone "그 보상이라도 하려는 건지, 도로시아는 특제 요리를 냄비 가득 만들어 주었다."


translate japanese plot1_dff5b215:


    nvlNone "계속 젓다 보니 냄비에서 묘한 향기가 피어오르기 시작했다."


translate japanese plot1_139495c8:


    nvlNone "「……이게 뭐야? 정말 먹어도 돼?」{p}하고 묻자," (callback=nvl_page_voice, cb_page_voices=('voice/equinox_0002.ogg', None))


translate japanese plot1_f7541655:


    voice "voice/dorothea_0002.ogg"
    nvlNone "「이스트국 요리야～」{p}도로시아가 태평하게 대답했다." (callback=nvl_page_voice, cb_page_voices=('voice/dorothea_0002.ogg', None))


translate japanese plot1_2e222df8:


    nvlNone "그녀의 믿기 힘들 만큼 커다란 가방에는 늘 본 적도 없는 조미료가 가득 들어 있었다."


translate japanese plot1_c2746333:


    nvlNone "「좋은 냄새…… 벌써 밥 먹을 시간이야?」{p}마차 안에서 짐을 정리하던 용사가 냄새에 이끌려 얼굴을 내밀었다." (callback=nvl_page_voice, cb_page_voices=('voice/champion_0001.ogg', None))


translate japanese plot1_bbcdc5ed:


    voice "voice/dorothea_0003.ogg"
    nvlNone "「헤헤, 곧 다 돼～」{p}도로시아가 대답했다." (callback=nvl_page_voice, cb_page_voices=('voice/dorothea_0003.ogg', None))


translate japanese plot1_eaff1fb3:


    nvlNone "그녀는 배낭에서 우리의 식기를 전부 꺼내 모닥불 옆에 놓았다."


translate japanese plot1_589be38f:


    voice "voice/champion_0002.ogg"
    nvlNone "「이건 어떻게 먹어?」{p}용사가 물었다." (callback=nvl_page_voice, cb_page_voices=('voice/champion_0002.ogg', None))


translate japanese plot1_876e566e:


    voice "voice/dorothea_0004.ogg"
    nvlNone "「음…… 이스트국 사람들은 밥과 함께 먹는대.」"


translate japanese plot1_0c6e5f6f:


    voice "voice/equinox_0003.ogg"
    nvlNone "「그런데 쌀은 안 가져왔잖아?」"


translate japanese plot1_c234794a:


    voice "voice/dorothea_0005.ogg"
    nvlNone "「괜찮아. 빵이랑 먹어도 똑같아!」"


translate japanese plot1_cc5a78af:


    voice "voice/equinox_0004.ogg"
    nvlNone "「……그 가방에는 대체 뭐가 들어 있는 거야.」{p}나는 눈살을 찌푸렸다." (callback=nvl_page_voice, cb_page_voices=('voice/equinox_0004.ogg', None))


translate japanese plot1_7f2c3478:


    voice "voice/dorothea_0006.ogg"
    nvlNone "「헤헤, 비밀～」"


translate japanese plot1_697a7f7f:


    nvlNone "밥을 곁들이지 않아도 황금빛 요리는 아주 맛있었다."


translate japanese plot1_a0d1a292:


    nvlNone "돌처럼 딱딱하던 빵도 수프를 머금고 부드러워지며, 완전히 다른 요리처럼 변해 갔다."


translate japanese plot1_4b4503e2:


    voice "voice/equinox_0005.ogg"
    nvlNone "「더는 못 먹겠어.」{p}나는 그릇을 옆에 내려놓았다." (callback=nvl_page_voice, cb_page_voices=('voice/equinox_0005.ogg', None))


translate japanese plot1_bd1f099d:


    voice "voice/dorothea_0007.ogg"
    nvlNone "「맛은 어땠어?」{p}도로시아가 내게 물었다." (callback=nvl_page_voice, cb_page_voices=('voice/dorothea_0007.ogg', None))


translate japanese plot1_748ef3a4:


    voice "voice/dorothea_0008.ogg"
    nvlNone "「거짓말, 평소보다 훨씬 많이 먹었으면서.」{p}도로시아가 뿌루퉁하게 입을 내밀었다." (callback=nvl_page_voice, cb_page_voices=('voice/dorothea_0008.ogg', None))


translate japanese plot1_0bcdb71a:


    voice "voice/dorothea_00009.ogg"
    nvlNone "「뭐!? 밥도 내가 했는데 설거지까지 하라고?」{p}도로시아가 항의했다." (callback=nvl_page_voice, cb_page_voices=('voice/dorothea_00009.ogg', None))

translate japanese plot1_aa30653c:


    voice "voice/dorothea_0010.ogg"
    nvlNone "「마법으로 후딱 씻으면 되잖아!」"


translate japanese plot1_37478993:


    voice "voice/dorothea_0011.ogg"
    nvlNone "「미, 미안하다니까! 설거지는 내가 할게!」" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot1_da618f41:


    nvlNone "약점을 찔린 도로시아는 곧바로 백기를 들었다."


translate japanese plot1_4a91f2d9:


    voice "voice/dorothea_0012.ogg"
    nvlNone "「용사는? 배불리 먹었어?」{p}도로시아가 물었다." (callback=nvl_page_voice, cb_page_voices=('voice/dorothea_0012.ogg', None))


translate japanese plot1_b0056ac4:


    nvlNone "「용사……?」"

translate japanese plot1_844aa35c:


    nvlNone "もう一度呼びかけると、彼女はようやく我に返った。"

translate japanese plot1_6cd35217:


    voice "voice/champion_00004.ogg"
    nvlNone "「미, 미안. 이 수프가 너무 맛있어서.」"



translate japanese plot1_ef88f7b7:


    voice "voice/champion_0004.ogg"
    nvlNone "「……한 그릇 더 먹어도 돼? 빵도 조금 더.」"


translate japanese plot1_876b1044:


    nvlNone "용사는 도로시아의 요리 맛에 완전히 마음을 빼앗겨 버렸다."


translate japanese plot1_443b1dce:


    nvlNone "……앞으로의 여행이 조금 걱정된다."


translate japanese plot1_0d1e7cc0:


    nvlNone "ドロシアが勇者にもう一杯スープをよそい、\n勇者は再びその黄金色の料理に夢中になった。"


translate japanese plot1_7b6f67fd:


    voice "voice/dorothea_0016.ogg"
    nvlNone "「잠깐! 왜 그렇게 멀리 떨어져서 자! 같이 자고 싶은데!」"


translate japanese plot1_4db4618f:


    voice "voice/equinox_0012.ogg"
    nvlNone "「やだ！絶対やだ！」" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot1_a1e3e043:


    voice "voice/equinox_0013.ogg"
    nvlNone "「매번 네 허벅지 때문에 깨거나,\n얼굴을 손바닥으로 얻어맞잖아!」"


translate japanese plot1_aa723939:


    voice "voice/dorothea_0017.ogg"
    nvlNone "「오, 오늘은 절대 안 그런다니까!」"


translate japanese plot1_51ceb5fa:


    voice "voice/equinox_0014.ogg"
    nvlNone "「그걸 믿으라고! 밖에서 자는 게 낫겠다!」"


translate japanese plot1_428a9dda:


    voice "voice/champion_0005.ogg"
    nvlNone "「그럼 내가 도로시아랑 이쪽에서 잘까?」{p}잠자리를 놓고 실랑이하는 우리를 보며 용사가 끼어들었다." (callback=nvl_page_voice, cb_page_voices=('voice/champion_0005.ogg', None))


translate japanese plot1_b9273715:


    voice "voice/equinox_0015.ogg"
    nvlNone "「……정말 괜찮겠어?」"


translate japanese plot1_e8c60ca9:


    voice "voice/champion_0006.ogg"
    nvlNone "「네가 밖에서 자는 건 왠지 보고만 있을 수 없어서.」{p}용사는 간단히 답했다." (callback=nvl_page_voice, cb_page_voices=('voice/champion_0006.ogg', None))

translate japanese plot1_468f1040:


    voice "voice/equinox_0016.ogg"
    nvlNone "「……그럼 그러든가.」{p}나는 한숨을 내쉬었다." (callback=nvl_page_voice, cb_page_voices=('voice/equinox_0016.ogg', None))

translate japanese plot1_7c5433e2:


    voice "voice/equinox_0017.ogg"
    nvlNone "「미리 말해 두는데, 잠버릇이 악마 수준이야.」"



translate japanese plot1_e4fffb6a:


    voice "voice/champion_0007.ogg"
    nvlNone "「아사요, 다른 세계에 흘러 들어가는 걸 생각해 본 적 있어?」{p}꾸벅꾸벅 졸려던 내게 용사가 불쑥 물었다." (callback=nvl_page_voice, cb_page_voices=('voice/champion_0007.ogg', None))


translate japanese plot1_2cf207bf:


    voice "voice/equinox_0018.ogg"
    nvlNone "「……그건 갑자기 왜 물어?」"


translate japanese plot1_c6328913:


    nvlNone "「아, 그런 목숨 아까운 줄 모르는 사람들 말이지.」"


translate japanese plot1_d1605ba1:


    nvlNone "갑작스러운 질문에 나도 모르게 눈을 깜박였다."


translate japanese plot1_875d75ce:


    nvlNone "뭐, 숨길 만한 이야기도 아니다.\n그래서 솔직하게 내 생각을 말해 주기로 했다."


translate japanese plot1_f6ba6cd2:


    voice "voice/champion_0009.ogg"
    nvlNone "「……그렇구나」{p}용사의 목소리는 어딘가 아쉬워 보였다.\n아무래도 기대하던 대답은 아니었던 모양이다." (callback=nvl_page_voice, cb_page_voices=('voice/champion_0009.ogg', None))


translate japanese plot1_cfa09bf2:


    voice "voice/equinox_0022.ogg"
    nvlNone "「용사는 이세계에 관심이 있어?」"


translate japanese plot1_9eb2132b:


    voice "voice/champion_0010.ogg"
    nvlNone "「이상해?」"


translate japanese plot1_5a6768e0:


    nvlNone "「……아마 그렇겠지.」{p}용사는 작게 중얼거리며,\n도로시아의 팔을 조용히 그 애의 이불로 돌려놓았다." (callback=nvl_page_voice, cb_page_voices=('voice/champion_0011.ogg', None))


translate japanese plot1_15bb417d:


    nvlNone "나는 어렴풋이 용사의 마음을 짐작하고 있었다."


translate japanese plot1_ae09011d:


    voice "voice/equinox_0024.ogg"
    nvlNone "「그럼 넌 어떤 세계를 동경하는데?」{p}그 말에 맞춰 나는 반대로 되물었다." (callback=nvl_page_voice, cb_page_voices=('voice/equinox_0024.ogg', None))


translate japanese plot1_e8767fd7:


    voice "voice/champion_0012.ogg"
    nvlNone "「……글쎄.」"


translate japanese plot1_12fabf7b:


    voice "voice/equinox_0025.ogg"
    nvlNone "「어? 왜?」"


translate japanese plot1_ea87a73e:


    voice "voice/champion_0014.ogg"
    nvlNone "「마나가 없으면 마물도 생겨나지 않잖아?」{p}단순하지만 곧은 대답이었다." (callback=nvl_page_voice, cb_page_voices=('voice/champion_0014.ogg', None))


translate japanese plot1_98237d48:


    nvlNone "「그래도 돼. 그런 힘은 필요 없으니까.」"


translate japanese plot1_6d3aea2a:


    nvlNone "용사는 조금 지긋지긋하다는 듯 눈을 내리깔았다."

translate japanese plot1_3c2bcc1d:


    nvlNone "누구나 부러워하는 그 힘도 용사에게는 그저 무거운 짐인 듯했다."


translate japanese plot1_46597205:


    voice "voice/equinox_0028.ogg"
    nvlNone "「……그래.」"


translate japanese plot1_c9662475:


    nvlNone "마력이 없는 세계는 어떤 모습일까? 상상만 해도 등골이 서늘했다."


translate japanese plot1_d7d60849:


    nvlNone "마녀인 우리에게는 마법을 빼앗긴 세계다."


translate japanese plot1_2b933d6c:


    cygnusnameless2 "……새근, 새근."


translate japanese plot1_631b6872:


    "소녀는 조용히 잠에 빠져들었다. 저렇게 평온하게 잠든 게 대체 얼마 만일까."


translate japanese plot1_90b81be7:


    "だが、無情にも初夏の陽光が、薄いカーテンを透かして彼女の瞼を照らす。"


translate japanese plot1_bf21548f:



    voice "voice/cygnus_05.ogg"
    cygnusnameless2 "으음……"


translate japanese plot1_c8514468:


    "그 빛이 소녀의 꿈속을 천천히 흔들었다."


translate japanese plot1_037a59aa:



    voice "voice/cygnus_06.ogg"
    cygnusnameless2 "으음…… 으으……"


translate japanese plot1_afc958dc:


    "탁!" with Shake((0, 0, 0, 0), 1, dist=5)


translate japanese plot1_e34bf34a:



    voice "voice/cygnus_07.ogg"
    cygnusnameless "痛っ……！"


translate japanese plot1_8dba33e0:


    "결국 꿈은 현실의 충격에 무너져 내리고, 소녀는 마지못해 눈을 떴다."


translate japanese plot1_76146f2e:


    "彼女の頬には、誰かの手が当たっている。その手の主――彼女の夢を粉々にした犯人は、今まさに隣で気持ちよさそうに眠っていた。"


translate japanese plot1_0a28d146:



    voice "voice/tianqin_116.ogg"
    tianqin "후…… 새근……"


translate japanese plot1_5cc58591:



    voice "voice/cygnus_08.ogg"
    cygnusnameless "——!?"


translate japanese plot1_d7ede8e9:



    voice "voice/cygnus_09.ogg"
    cygnusnameless "（잠들어 버렸나……?）"


translate japanese plot1_332ec571:



    voice "voice/cygnus_10.ogg"
    cygnusnameless "（여기…… 어디지……）"


translate japanese plot1_41db083d:


    "화낼 틈도 없이, 잠에서 깬 소녀는 곧바로 상황을 파악하기 시작했다."


translate japanese plot1_49f0c3f2:



    voice "voice/cygnus_11.ogg"
    cygnusnameless "（내가…… 왜 여기에……）"


translate japanese plot1_8e4324bb:


    "うっすらとした記憶をたどると、意識を失う前にこの人物に助けてもらったようだ、という感覚があった。"


translate japanese plot1_3963e4fe:



    voice "voice/cygnus_12.ogg"
    cygnusnameless "……"


translate japanese plot1_fc264989:


    "……뭔가 이상해."


translate japanese plot1_fde0e916:


    "눈앞의 풍경은 소녀의 상식을 가볍게 넘어섰다. 본 적 없는 방 구조와 무슨 재질인지 알 수 없는 옷장, 그 위에는 기묘한 모양의 기계가 있었다."


translate japanese plot1_1370ce55:



    voice "voice/cygnus_13.ogg"
    cygnusnameless 0705 "…이건 대체…"


translate japanese plot1_5fec5390:


    "무엇을 봐도 처음 보는 것뿐이라, 마치 이세계에 길을 잘못 든 것 같았다."


translate japanese plot1_5b4287b5:



    voice "voice/cygnus_14.ogg"
    cygnusnameless "으으——……!"


translate japanese plot1_5c4c1092:


    "그보다 심각한 건 머릿속이 새하얗다는 사실이었다. 누군가가 기억을 억지로 뜯어 간 듯한 느낌이었다."


translate japanese plot1_0707e6f8:



    voice "voice/cygnus_15.ogg"
    cygnusnameless "（기억…… 상실? 머리가 아파…… 아무것도 생각이 안 나……）"


translate japanese plot1_a101c42b:



    voice "voice/cygnus_16.ogg"
    cygnusnameless "（……일단 몸 상태부터 회복해야겠어.）"


translate japanese plot1_ec51f245:



    voice "voice/cygnus_17.ogg"
    cygnusnameless "——"


translate japanese plot1_d35cf3f1:


    "소녀는 작게 숨을 들이마시고 중얼거리듯 소리를 내 보았다――그러자 뜻밖의 사실을 발견했다."


translate japanese plot1_8bf562eb:



    voice "voice/cygnus_18.ogg"
    cygnusnameless "……이 세계는 대체 어떻게 된 거지……"


translate japanese plot1_9fe139a0:



    voice "voice/tianqin_117.ogg"
    tianqin "うむむ…"


translate japanese plot1_70abd046:



    voice "voice/tianqin_118.ogg"
    tianqin "후아, 푹 잠들었네……"


translate japanese plot1_00ca35bd:



    voice "voice/tianqin_119.ogg"
    tianqin "어? 일어났어?"


translate japanese plot1_84c3a666:



    voice "voice/cygnus_19.ogg"
    cygnusnameless "!?"


translate japanese plot1_d200aa42:



    voice "voice/tianqin_120.ogg"
    tianqin "미안해. 어디 사는지 몰라서 일단 우리 집에 데려왔어."


translate japanese plot1_48d32094:



    voice "voice/tianqin_121.ogg"
    tianqin "밤도 늦었고, 여자애 혼자 공원에서 자면 위험하잖아."


translate japanese plot1_3963e4fe_1:



    voice "voice/cygnus_20.ogg"
    cygnusnameless "……"


translate japanese plot1_8a063818:



    voice "voice/tianqin_122.ogg"
    tianqin "왜 그래? 어디 불편해?"


translate japanese plot1_55cc272f:



    voice "voice/cygnus_21.ogg"
    cygnusnameless "내 몸 위에 얹은 네 허벅지부터 치워 주면 꽤 편해질 것 같아."


translate japanese plot1_c75df52a:



    voice "voice/tianqin_123.ogg"
    tianqin "앗, 미, 미안!"


translate japanese plot1_002aca79:


    "――치이이이이."


translate japanese plot1_a9cfad7a:


    "프라이팬에서 기름이 튀는 소리가 나더니, 곧 베이컨의 고소한 냄새가 방 안 가득 퍼졌다."


translate japanese plot1_00701c18:



    voice "voice/tianqin_124.ogg"
    tianqin "후후후…"


translate japanese plot1_3963e4fe_13:



    voice "voice/cygnus_22.ogg"
    cygnusnameless "……"


translate japanese plot1_939b6009:


    "天琴は朝食の準備をしながら、少女をリビングに一人残していた。"


translate japanese plot1_39665204:


    "소녀는 눈을 크게 뜨고 주위를 살폈다. 침실과 마찬가지로 거실에 놓인 물건들도 처음 보는 것뿐이었다."


translate japanese plot1_53e17128:


    "눈앞의 모든 것이 너무도 낯설었다."


translate japanese plot1_4b507afa:



    voice "voice/tianqin_125.ogg"
    tianqin "아침 다 됐어. 조금이라도 먹어 볼래?"


translate japanese plot1_3963e4fe_14:



    voice "voice/cygnus_23.ogg"
    cygnusnameless "……"


translate japanese plot1_e1e109d3:


    "자신을 부른다는 걸 알아차린 소녀는 얌전히 식탁에 앉았다."


translate japanese plot1_243e419d:



    voice "voice/tianqin_126.ogg"
    tianqin "몸은 어때? 아직 불편해?"


translate japanese plot1_808b100e:



    voice "voice/cygnus_24.ogg"
    cygnusnameless "머리가…… 조금 아파……"


translate japanese plot1_4dbb6c3a:



    voice "voice/tianqin_127.ogg"
    tianqin "어, 우리 집 침대가 익숙하지 않아서 그런가."


translate japanese plot1_3963e4fe_15:



    voice "voice/cygnus_25.ogg"
    cygnusnameless "……"


translate japanese plot1_67643adc:



    voice "voice/tianqin_128.ogg"
    tianqin "저기, 공원에서 쓰러진 이유는 묻지 않을게…… 그래도 무리하지 마."


translate japanese plot1_b9728f49:



    voice "voice/tianqin_129.ogg"
    tianqin "누구나 말하고 싶지 않은 일은 있으니까."


translate japanese plot1_dcc93c92:



    voice "voice/tianqin_130.ogg"
    tianqin "그래도 어디 더 아픈 데가 있으면 꼭 말해 줘. 알았지?"


translate japanese plot1_d39e5340:



    voice "voice/cygnus_26.ogg"
    cygnusnameless "…고마워. 괜찮아."


translate japanese plot1_4e202ccc:



    voice "voice/tianqin_131.ogg"
    tianqin "다행이다. 그럼 아침 먹을까?"


translate japanese plot1_20df3431:


    "라이라가 준비한 아침은 전부 자신이 좋아하는 음식이었다."


translate japanese plot1_59b9b9fb:


    "식탁에는 토스트, 지글거리는 베이컨과 소시지, 폭신한 스크램블에그와 신선한 양상추가 놓여 있었다. 꼭 웨스트 지방의 아침 식사 같았다."


translate japanese plot1_48499d34:



    voice "voice/cygnus_27.ogg"
    cygnusnameless "（이건…… 빵이랑 달걀……?）"


translate japanese plot1_e631bb7c:



    voice "voice/cygnus_28.ogg"
    cygnusnameless "（소시지……?）"


translate japanese plot1_d2df0928:



    voice "voice/cygnus_29.ogg"
    cygnusnameless "（먹는 건 별로 다르지 않은 것 같네……）"


translate japanese plot1_31d8b5eb:


    "少女は皿の上を観察し終えると、天琴のほうに目を向けた。"


translate japanese plot1_f2c11f09:


    "그 앞에는 토스트와 베이컨, 스크램블에그가 겹겹이 쌓인 「음식의 산」이 있었다."


translate japanese plot1_beff9eec:



    voice "voice/cygnus_30.ogg"
    cygnusnameless "（저렇게 많이!?）" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot1_4bf1536f:



    voice "voice/tianqin_132.ogg"
    tianqin "아! 모자라면 내 거 좀 덜어 먹어도 돼."


translate japanese plot1_a661047e:



    voice "voice/cygnus_31.ogg"
    cygnusnameless "추, 충분해……"


translate japanese plot1_2c285f9a:



    voice "voice/cygnus_32.ogg"
    cygnusnameless "…많이 먹었네."


translate japanese plot1_d1562187:



    voice "voice/tianqin_133.ogg"
    tianqin "에이～ 아주 조금만 먹을 수 있다니까."


translate japanese plot1_414411a9:



    voice "voice/cygnus_33.ogg"
    cygnusnameless "（이 세계 사람들은 다 대식가인가?）"


translate japanese plot1_9c521e58:



    voice "voice/tianqin_134.ogg"
    tianqin "그럼 난 학교 다녀올게. 다 먹으면 그릇은 그냥 놔둬."


translate japanese plot1_560f6e9d:



    voice "voice/tianqin_135.ogg"
    tianqin "집에 가고 싶으면 그냥 나가도 돼. 문은 자동으로 잠기니까 걱정하지 말고."


translate japanese plot1_c614b2d6:



    voice "voice/tianqin_136.ogg"
    tianqin "아——! 쫓아내는 건 아니야. 아직 몸이 안 좋으면 여기서 더 쉬어도 괜찮아."


translate japanese plot1_59786e6f:



    voice "voice/tianqin_137.ogg"
    tianqin "でも、家族には電話した方がいいと思う。心配してるかもしれないし。"


translate japanese plot1_e34bcdeb:


    "라이라는 거실 구석에 놓인 전화를 가리켰다."


translate japanese plot1_b849b50b:



    voice "voice/cygnus_34.ogg"
    cygnusnameless "…알았어."


translate japanese plot1_251cf9e3:


    "라이라는 이것저것 잔뜩 늘어놓았지만, 소녀는 알아듣지 못한 듯했다."


translate japanese plot1_acc25d12:


    "자동 잠금? 전화? 그런 말은 소녀의 지식 속에 존재하지 않았다."


translate japanese plot1_2eaf5dc1:


    "그래도 표정에는 드러내지 않고 조용히 고개만 끄덕였다."


translate japanese plot1_e1ed3a66:



    voice "voice/tianqin_138.ogg"
    tianqin "그럼 나 먼저 간다."


translate japanese plot1_9e5fa099:


    "탕." with Shake((0, 0, 0, 0), 0.5, dist=7)


translate japanese plot1_fb305dac:


    "ドアが閉まり、少女は一人残された。"


translate japanese plot1_c209dfc1:


    "普通なら、見知らぬ少女を家に連れて帰るなんてあり得ない。ましてや、一人きりにしておくなんて。"


translate japanese plot1_a16377cf:


    "하지만 라이라에게 다른 속셈은 없었다. 곤경에 처한 아이를 그냥 내버려 둘 수 없었을 뿐이다."


translate japanese plot1_10e5ba5c:


    "라이라는 그렇게 대범한 성격이었다."


translate japanese plot1_13b3098c:


    cygnusnameless "으…"


translate japanese plot1_2511860f:



    voice "voice/cygnus_36.ogg"
    cygnusnameless "（학교…?）"


translate japanese plot1_cd0fcdb6:



    voice "voice/cygnus_37.ogg"
    cygnusnameless "（그럼 이 세계에도 서당이나 학원 같은 조직이 있나?）"


translate japanese plot1_a143939b:



    voice "voice/cygnus_38.ogg"
    cygnusnameless "（여기는 대체……）"


translate japanese plot1_3963e4fe_16:



    voice "voice/cygnus_39.ogg"
    cygnusnameless "……"


translate japanese plot1_d90dbed8:



    voice "voice/cygnus_40.ogg"
    cygnusnameless "（정보를 더 모아야겠어……）"


translate japanese plot1_bf4e90e4:


    "이곳은 소녀가 알던 세계가 아니었다."


translate japanese plot1_6a0b11ef:


    "기억은 잃었어도 「상식」만은 기억했다. 하지만 이 세계에서는 그 상식이 전혀 통하지 않았다."


translate japanese plot1_4bac9f6d:


    "그리고 무엇보다도――"








translate japanese plot1_370c7713:


    "だから、彼女は自由に魔法を使えないのだ。"


translate japanese plot1_4cffdd2a:



    voice "voice/tianqin_139.ogg"
    tianqin "안녀엉, 좋은 아치임!"


translate japanese plot1_1265d8d3:



    voice "voice/yangxi_32.ogg"
    yangxi "안녕."


translate japanese plot1_738833b6:



    voice "voice/hecheng_01.ogg"
    hecheng "어머, 드문 일이네. 라이라가 등교를 다 하고."


translate japanese plot1_5e530772:



    voice "voice/tianqin_140.ogg"
    tianqin "출석률이 모자랄 것 같아서……."


translate japanese plot1_4cc31435:



    voice "voice/hecheng_02.ogg"
    hecheng "오, 그런 데만 위기감이 있구나."


translate japanese plot1_270752af:



    voice "voice/hecheng_03.ogg"
    hecheng "네가 유급하면 내년에는 우리가 선배야."


translate japanese plot1_40ca87ec:



    voice "voice/tianqin_141.ogg"
    tianqin "야, 재수 없는 소리 하지 마!"


translate japanese plot1_80eeb56c:



    voice "voice/minying_01.ogg"
    minying "저기, 츠루기 씨. 체육 선생님이 찾으세요."


translate japanese plot1_749aac08:



    voice "voice/hecheng_04.ogg"
    hecheng "알았어. 바로 갈게."


translate japanese plot1_22b5d498:



    voice "voice/hecheng_05.ogg"
    hecheng "ごめん、もうすぐ{a=dictionary:dict_entry_25}体育生{/a}の朝練始まるから、お先に"


translate japanese plot1_2185fdd5:



    voice "voice/tianqin_142.ogg"
    tianqin "응, 다녀와."


translate japanese plot1_183dfefc:



    voice "voice/tianqin_143.ogg"
    tianqin "헤헤～"


translate japanese plot1_358fc1b6:



    voice "voice/yangxi_33.ogg"
    yangxi "무슨 좋은 일 있어? 그렇게 싱글벙글하게."


translate japanese plot1_7b0e683f:



    voice "voice/tianqin_144.ogg"
    tianqin "별건 아니고～ 어젯밤에 좀."


translate japanese plot1_5c1d6af8:



    voice "voice/tianqin_145.ogg"
    tianqin "있잖아——"


translate japanese plot1_442941ca:


    "……"


translate japanese plot1_e59178c8:


    "……라이라는 어젯밤 있었던 일을 모두 이야기했다."


translate japanese plot1_8e54e1f6:



    voice "voice/yangxi_34.ogg"
    yangxi "……뭐?"


translate japanese plot1_a413fc68:



    voice "voice/yangxi_35.ogg"
    yangxi "그러니까 모르는 애를 집에 재워 줬다는 거야?"


translate japanese plot1_a6aa57a9:



    voice "voice/tianqin_146.ogg"
    tianqin "응."


translate japanese plot1_508cfbb0:



    voice "voice/yangxi_36.ogg"
    yangxi "너 말이야……"


translate japanese plot1_c6a33b6d:



    voice "voice/yangxi_37.ogg"
    yangxi "그런 상황이면 아무리 그래도 경찰에 먼저 신고해야지."


translate japanese plot1_d06ceeb9:



    voice "voice/yangxi_38.ogg"
    yangxi "자칫하면 유괴로 오해받을 수도 있는 일이라고?"


translate japanese plot1_888d8e16:



    voice "voice/tianqin_147.ogg"
    tianqin "그 정도는 아니잖아!"


translate japanese plot1_26e9f663:



    voice "voice/yangxi_39.ogg"
    yangxi "네가 너무 태평한 거야."


translate japanese plot1_a4d83a0a:



    voice "voice/tianqin_148.ogg"
    tianqin "그치만 그 애, 몸이 안 좋아 보였단 말이야. 잠깐 돌봐 준 것뿐이야."


translate japanese plot1_b7cdb358:



    voice "voice/yangxi_40.ogg"
    yangxi "세상이 그렇게 간단하지는 않아……"


translate japanese plot1_585ac022:


    "히나타의 말은 옳았다. 뒤집어 보면 지극히 상식적인 생각이라고도 할 수 있었다."


translate japanese plot1_d6281cc4:


    "それより陽汐が気にしていたのは、もしその子の身に何かあれば、すべての責任が天琴にのしかかるという点だった。"


translate japanese plot1_8f22079f:



    voice "voice/tianqin_149.ogg"
    tianqin "괜찮아, 괜찮아. 잠깐 쉬게 해 주는 것뿐이니까."


translate japanese plot1_072fe2fa:



    voice "voice/yangxi_41.ogg"
    yangxi "……위기감이라곤 없네. 정말이지."


translate japanese plot1_b03180ef:



    voice "voice/yangxi_42.ogg"
    yangxi "그나저나, 다른 얘긴데."


translate japanese plot1_2e5fc667:



    voice "voice/yangxi_43.ogg"
    yangxi "그래서—— 오늘은 왜 수업 안 빼먹었어?"


translate japanese plot1_5f463a4c:



    voice "voice/yangxi_44.ogg"
    yangxi "이따 네가 제일 싫어하는 수학 시간이잖아. 당연히 빠질 줄 알았는데?"


translate japanese plot1_7ce51253:



    voice "voice/tianqin_150.ogg"
    tianqin "아, 맞다! 까먹었다."


translate japanese plot1_3ee93c78:



    voice "voice/tianqin_151.ogg"
    tianqin "오늘은 반장이랑 출석 기록 맞춰 보러 온 거였지!"


translate japanese plot1_04fa8a26:



    voice "voice/tianqin_152.ogg"
    tianqin "반장, 반장!"


translate japanese plot1_36923c65:



    voice "voice/banzhang_01.ogg"
    banzhang "……"


translate japanese plot1_84005078:



    voice "voice/tianqin_153.ogg"
    tianqin "왜 그래?"


translate japanese plot1_36923c65_1:



    voice "voice/banzhang_02.ogg"
    banzhang "……"


translate japanese plot1_9f9417cb:



    voice "voice/tianqin_154.ogg"
    tianqin "아키?"


translate japanese plot1_e05ea462:



    voice "voice/banzhang_03.ogg"
    banzhang "네? 라이라 씨?"


translate japanese plot1_14f8aba0:



    voice "voice/tianqin_155.ogg"
    tianqin "괜찮아? 안색이 안 좋아 보이는데."


translate japanese plot1_a759bada:



    voice "voice/banzhang_04.ogg"
    banzhang "네, 괜찮아요……"


translate japanese plot1_839033dc:



    voice "voice/banzhang_05.ogg"
    banzhang "저기, 무슨 일이세요?"


translate japanese plot1_ae6dcbf6:



    voice "voice/tianqin_156.ogg"
    tianqin "이번 학기 출석 기록을 좀 확인하고 싶어서. 반장이 전부 정리해 뒀지?"


translate japanese plot1_c1d6e4ac:



    voice "voice/banzhang_06.ogg"
    banzhang "아, 네. 있어요."


translate japanese plot1_c3e5cb85:


    "반장은 서랍에서 두툼한 장부를 꺼냈다. 반 학생 모두의 출석 현황이 기록되어 있었다."


translate japanese plot1_9adab4e2:



    voice "voice/banzhang_07.ogg"
    banzhang "그러니까, 라이라 씨는 이번 학기에……."


translate japanese plot1_2ec57439:



    voice "voice/tianqin_157.ogg"
    tianqin "나도 같이 봐도 돼?"


translate japanese plot1_df9bd45d:



    voice "voice/banzhang_08.ogg"
    banzhang "그러세요."


translate japanese plot1_71953555:



    voice "voice/tianqin_158.ogg"
    tianqin "응, 학기 초에는 개근했지?"


translate japanese plot1_d1d58c6f:



    voice "voice/banzhang_09.ogg"
    banzhang "개근이라기보다는, 금요일은 전부 결석하셨네요?"


translate japanese plot1_b5cdc52b:



    voice "voice/tianqin_159.ogg"
    tianqin "금요일은 빼야지! 난 주 3일 휴일주의자라고!"


translate japanese plot1_d3b463b6:



    voice "voice/banzhang_10.ogg"
    banzhang "학교에는 그런 제도가 없는데요……"


translate japanese plot1_be88beb2:



    voice "voice/tianqin_160.ogg"
    tianqin "어어!? 여기서는 내가 일주일 내내 학교에 안 나왔어!?"


translate japanese plot1_8396eda2:



    voice "voice/banzhang_11.ogg"
    banzhang "네. 그동안 수학 선생님이랑 담임 선생님이 상당히 화가 나셨어요."


translate japanese plot1_7c5ce52e:



    voice "voice/banzhang_12.ogg"
    banzhang "그때 무슨 일 있으셨어요?"


translate japanese plot1_77b35ee4:



    voice "voice/tianqin_161.ogg"
    tianqin "그러게…"


translate japanese plot1_1081a2f0:



    voice "voice/tianqin_162.ogg"
    tianqin "아."


translate japanese plot1_7984ef24:



    voice "voice/tianqin_163.ogg"
    tianqin "아, 그냥 학교 오기 싫었을 뿐이야."


translate japanese plot1_7cbb8a4b:



    voice "voice/banzhang_13.ogg"
    banzhang "아하하, 라이라 씨답네요."


translate japanese plot1_af8dd8f7:



    voice "voice/tianqin_164.ogg"
    tianqin "어쩔 수 없잖아! 가끔, 가끔은 학교 가기 싫은 날도 있어."


translate japanese plot1_f3c7892c:



    voice "voice/banzhang_14.ogg"
    banzhang "라이라 씨, 그 정도로 빠지시면 「가끔」이라고는 못 하죠."


translate japanese plot1_acd1c22b:



    voice "voice/banzhang_15.ogg"
    banzhang "최근에는 매주 이삼 일씩 쉬셨죠?"


translate japanese plot1_3f3578ec:



    voice "voice/tianqin_165.ogg"
    tianqin "뭐, 그럼 출석률은?"


translate japanese plot1_4226cfc4:



    voice "voice/banzhang_16.ogg"
    banzhang "……48.8%%예요."


translate japanese plot1_dd642ecd:



    voice "voice/tianqin_166.ogg"
    tianqin "말도 안 돼! 50％도 안 된다고!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot1_c374ca1f:



    voice "voice/tianqin_167.ogg"
    tianqin "이번 학기에는 꽤 열심히 등교했는데!"


translate japanese plot1_d19660a0:



    voice "voice/banzhang_17.ogg"
    banzhang "일주일을 통째로 안 오셔서 출석률이 예상보다 낮아진 거예요."


translate japanese plot1_01ceb306:



    voice "voice/tianqin_168.ogg"
    tianqin "으으으…… 계산 잘못했네."


translate japanese plot1_3bf2168f:



    voice "voice/banzhang_18.ogg"
    banzhang "그래도 괜찮아요. 이제부터 결석을 줄이면 금방 50％를 넘을 거예요."


translate japanese plot1_1d0e06a2:



    voice "voice/banzhang_19.ogg"
    banzhang "하루 이틀 정도 차이인 데다 성적도 좋으시니, 선생님께 혼날 걱정은 없어요."


translate japanese plot1_54c8dbc6:



    voice "voice/tianqin_169.ogg"
    tianqin "그렇구나. 하루 이틀 정도면 괜찮겠네."


translate japanese plot1_24e0dfa7:



    voice "voice/tianqin_170.ogg"
    tianqin "그러니까 앞으로도 이렇게 설렁설렁 다녀도 괜찮다는 거네!"


translate japanese plot1_f4230dc8:



    voice "voice/banzhang_20.ogg"
    banzhang "그런 뜻은 아니에요……"


translate japanese plot1_5bbc3f26:


    "天琴が通う「龍華市第一高校」は、{a=dictionary:dict_entry_7}アシア地区{/a}でも屈指の名門校だ。"


translate japanese plot1_8acfb072:


    "だが、いくら{a=dictionary:dict_entry_9}名門{/a}といえども、ゆとり教育の波の中では、天琴のような「問題児」がどのクラスにも一人や二人はいるものだ。"


translate japanese plot1_0e2c1faa:


    "교사도 학생도 이미 이런 상황에 익숙해져 있었다."


translate japanese plot1_ec2fdba9:


    "수업에 지장만 주지 않으면 학교도 대개 그 학생들을 내버려 두었다."


translate japanese plot1_e2b155a9:


    "그것도 「유토리 교육」의 일환이다."


translate japanese plot1_76a607e9:



    voice "voice/banzhang_21.ogg"
    banzhang "아무튼 라이라 씨는 조금 조심하시는 게 좋겠어요."


translate japanese plot1_b21b26a6:



    voice "voice/banzhang_22.ogg"
    banzhang "출석률이 계속 50％를 넘지 못하면 학급 주임 선생님께 보고하도록 되어 있으니까요."


translate japanese plot1_df75892a:



    voice "voice/banzhang_23.ogg"
    banzhang "그때 불려 가시면…… 조금 곤란해질 거예요."


translate japanese plot1_10aef585:



    voice "voice/tianqin_171.ogg"
    tianqin "학년부장이라――그 대머리 아저씨…… 그 사람이랑 얘기하는 건 정말 사양인데."


translate japanese plot1_50cbf57f:



    voice "voice/banzhang_24.ogg"
    banzhang "네. 그러니까 학교에 제대로 나와 주세요."


translate japanese plot1_361087d2:



    voice "voice/tianqin_172.ogg"
    tianqin "네에, 네에. 앞으로는 땡땡이 안 치도록 노력하겠습니다!"


translate japanese plot1_9fa6781a:



    voice "voice/tianqin_173.ogg"
    tianqin "고마워, 반장. 이제 한시름 놓았네～."


translate japanese plot1_3963e4fe_17:



    voice "voice/cygnus_41.ogg"
    cygnusnameless "……"


translate japanese plot1_34222880:


    "라이라가 학교에 간 지 얼마 지나지 않아, 소녀가 조용히 집 밖으로 모습을 드러냈다."


translate japanese plot1_b0bb50dc:


    "주변을 경계하며 조심스럽게 걸음을 옮겼다. 낯선 세계의 정보를 조금이라도 더 모으기 위해――."


translate japanese plot1_bbff90ba:


    "출근과 등교로 붐비는 시간이 지나도 라이라의 집 근처는 여전히 활기찼다."


translate japanese plot1_a72551b4:


    "行き交う人々の層は、朝食を買い求める学生や会社員から、昼夕の支度を始める主婦たちへと移り変わっていた。"


translate japanese plot1_9e972409:


    "그 한가운데, 길모퉁이에 선 소녀가 도로와 사람들의 움직임을 조용히 관찰하고 있었다."


translate japanese plot1_3963e4fe_18:



    voice "voice/cygnus_42.ogg"
    cygnusnameless "……"


translate japanese plot1_414fbe9e:



    voice "voice/cygnus_43.ogg"
    cygnusnameless "（길이 둘로 나뉘어 있네…… 한쪽은 사람, 다른 한쪽은 저 「기계 탈것」을 위한 건가……）"


translate japanese plot1_1040a91c:



    voice "voice/cygnus_44.ogg"
    cygnusnameless "（저 빛나는 기둥은 사람과 기계의 움직임을 통제하는 장치……?）"


translate japanese plot1_09be89c1:



    voice "voice/cygnus_45.ogg"
    cygnusnameless "（초록색은 「가라」, 빨간색은 「멈춰라」――라는 건가?）"


translate japanese plot1_ddf27fa7:


    "현대 사회의 모든 것이 소녀에게는 낯설었다."


translate japanese plot1_432a08be:


    "하지만 날카로운 관찰력과 논리적 사고로 소녀는 이 세계의 「구조」를 조금씩 이해해 갔다."


translate japanese plot1_ad459da7:



    voice "voice/npc_01.ogg"
    npc107 "{a=dictionary:dict_entry_10}QRコード{/a}はこちらですか。"


translate japanese plot1_9860934d:



    voice "voice/npc_02.ogg"
    npc108 "네. 여기서 해 주시면 됩니다."


translate japanese plot1_0888ebf6:



    voice "voice/npc_03.ogg"
    npc107 "네, 결제했어요."


translate japanese plot1_5e53d3ac:



    voice "voice/npc_04.ogg"
    npc108 "감사합니다!"


translate japanese plot1_cdef1c45:



    voice "voice/cygnus_46.ogg"
    cygnusnameless "（사람들이 거래할 때 화폐를 쓰지 않아……?）"


translate japanese plot1_0d5b94d2:



    voice "voice/cygnus_47.ogg"
    cygnusnameless "（게다가 어느 가게나 마찬가지야. 살 때도 팔 때도 아무도 돈을 꺼내지 않아.）"


translate japanese plot1_f9473739:



    voice "voice/cygnus_48.ogg"
    cygnusnameless "（대신 저 작은 유리 기구로 값을 치르고 있어.）"


translate japanese plot1_92da1210:



    voice "voice/cygnus_49.ogg"
    cygnusnameless "（혹시 신원을 식별한 다음, 어딘가에 있는 금은을 매개로 거래하는 건가……?）"


translate japanese plot1_4162a2a8:



    voice "voice/cygnus_50.ogg"
    cygnusnameless "（大陸北方の、経済が発達した国々が運用している「無貨幣取引システム」に似ているな……）"


translate japanese plot1_aafd4b28:



    voice "voice/npc4_01.ogg"
    npc3 "안녕, 꼬마야."


translate japanese plot1_84c3a666_1:



    voice "voice/cygnus_51.ogg"
    cygnusnameless "!?"


translate japanese plot1_6098abaa:


    "振り返ると、制服を着た二人の大人が立っていた。"


translate japanese plot1_c5ae6603:



    voice "voice/cygnus_52.ogg"
    cygnusnameless "당신들은……?"


translate japanese plot1_f83fefa7:



    voice "voice/npc4_02.ogg"
    npc4 "怖がらなくていいよ。私たちはこの辺の{a=dictionary:dict_entry_11}巡査{/a}なんだ。"


translate japanese plot1_a01993ec:



    voice "voice/npc4_03.ogg"
    npc4 "얘야, 길을 잃었니?"


translate japanese plot1_9613e823:



    voice "voice/cygnus_53.ogg"
    cygnusnameless "아……"


translate japanese plot1_253762d8:


    "「巡査」という言葉の意味は分からない。だが、彼らの口調と態度から、その立場は察せられた。"


translate japanese plot1_3339f502:



    voice "voice/cygnus_54.ogg"
    cygnusnameless "（아마 이 세계의 「경비병」 같은 존재겠지.）"


translate japanese plot1_9500732e:



    voice "voice/cygnus_55.ogg"
    cygnusnameless "길을 잃은 건 아니에요. 타오베이로 근처에 살아요…… 그냥 산책하러 나온 거예요."


translate japanese plot1_5ab675b5:


    "사실 소녀는 근처 지명을 전혀 몰랐다. 그렇다고 아무렇게나 지어낸 이름도 아니었다."


translate japanese plot1_104ebecd:


    "거리의 간판에 적힌 글자를 살피며,\n여러 번 나온 「타오베이로」라는 단어와 화살표가 가리키는 방향을 기억해 두었다."


translate japanese plot1_9e4e5ac9:


    "그 정보로 이 표지판들이 무슨 역할을 하는지 금세 추론해 냈다."


translate japanese plot1_6d82a6bc:



    voice "voice/npc4_04.ogg"
    npc4 "아, 그렇구나. ……그런데 그 옷은?"


translate japanese plot1_69bb15db:



    voice "voice/cygnus_56.ogg"
    cygnusnameless "이건…… 언니가 입혀 줬어요."


translate japanese plot1_0eaa7967:



    voice "voice/npc4_05.ogg"
    npc4 "이런, 언니가 장난을 쳤구나……"


translate japanese plot1_66e5d902:



    voice "voice/cygnus_57.ogg"
    cygnusnameless "……네."


translate japanese plot1_d1d22f68:



    voice "voice/cygnus_58.ogg"
    cygnusnameless "（역시 이 차림은 너무 눈에 띄어……）"


translate japanese plot1_7dddcfea:


    "두 순경뿐만이 아니었다. 거리를 지나가는 사람들도 모두 소녀에게 시선을 빼앗겼다. 뒤돌아보는 비율은 무려 100％."


translate japanese plot1_0589f813:



    voice "voice/npc4_06.ogg"
    npc4 "그렇구나…… 낯선 사람이 말을 걸면 조심해야 한다?"


translate japanese plot1_6e49a194:



    voice "voice/npc4_07.ogg"
    npc4 "길을 잃으면 저 앞 파출소로 와서 우리를 찾아."


translate japanese plot1_118ef588:



    voice "voice/cygnus_59.ogg"
    cygnusnameless "네, 감사합니다. 곧 돌아갈게요."


translate japanese plot1_cf85bec5:


    "巡査たちの背中が見えなくなると、少女はすぐに近くの細い路地に身を潜めた。"


translate japanese plot1_302541d9:



    voice "voice/cygnus_60.ogg"
    cygnusnameless "（순경…… 역시 「경비병」 같은 역할이네.）"


translate japanese plot1_23802db4:



    voice "voice/cygnus_61.ogg"
    cygnusnameless "（그런데 무기를 가지고 있지 않아……?）"


translate japanese plot1_1986d5ae:



    voice "voice/cygnus_62.ogg"
    cygnusnameless "（어떻게 치안을 지키려는 거지……? 신기하네……）"


translate japanese plot1_86b1af2e:


    "이해할 수 없었다."


translate japanese plot1_8c52d57e:


    "이 세계는 소녀가 아는 상식과 너무나 동떨어져 있었다."


translate japanese plot1_0453b02a:


    "하지만 지금은 분석할 시간도 없다. 무엇보다 눈에 띄지 않고 이 세계의 정보를 모으는 게 우선이었다."


translate japanese plot1_6c9784d2:



    voice "voice/tianqin_174.ogg"
    tianqin "……그러니까, 오늘 아침에 출석률을 계산했더니 무려 48％인 거야!"


translate japanese plot1_bcf37e0c:



    voice "voice/tianqin_175.ogg"
    tianqin "50％도 안 되다니, 큰일이지!"


translate japanese plot1_368e44c3:



    voice "voice/tianqin_176.ogg"
    tianqin "게다가 반장 말로는 학급 주임인 그 아저씨한테 불려 갈 수도 있대……"


translate japanese plot1_50755a21:


    "화학 실험실에는 라이라와 다른 학생 한 명뿐이었다. 라이라는 손짓 발짓을 해 가며 오늘 있었던 일을 그 학생에게 열심히 이야기했다."


translate japanese plot1_66066986:


    "그 학생도 라이라처럼 수업에 안 들어오기로 학교에서 유명했지만, 라이라 같은 문제 학생은 아니었다."


translate japanese plot1_13e0073c:


    "지금도 손에 든 시험관과 비커를 진지하게 다루며 실험 결과를 하나하나 기록하고 있었다."


translate japanese plot1_f7fee9d8:



    voice "voice/keke_01.ogg"
    keke "흠, 그렇구나……"


translate japanese plot1_b03fb650:



    voice "voice/keke_02.ogg"
    keke "여기에 염소를 좀 더 넣으면……"


translate japanese plot1_074b6126:



    voice "voice/tianqin_177.ogg"
    tianqin "저기…… 코코, 듣고 있어?"


translate japanese plot1_cd3d1a30:



    voice "voice/keke_03.ogg"
    keke "응? 출석률 얘기잖아?"


translate japanese plot1_a2a83794:



    voice "voice/tianqin_178.ogg"
    tianqin "듣고 있었구나!"


translate japanese plot1_4a812ada:



    voice "voice/keke_04.ogg"
    keke "안 듣고 있다고 생각한 거야!?"


translate japanese plot1_5c748144:



    voice "voice/keke_05.ogg"
    keke "그럼 저 옆의 벽 보고 혼잣말하면 되잖아!"


translate japanese plot1_b00c71d0:



    voice "voice/tianqin_179.ogg"
    tianqin "아니! 너무 열심히 실험하길래 궁금해서 물어본 거야!"


translate japanese plot1_4764878e:



    voice "voice/tianqin_180.ogg"
    tianqin "그리고 내가 말할 때 누가 맞장구만 쳐 줘도 마음이 편하단 말이야!"


translate japanese plot1_414d62c0:



    voice "voice/keke_06.ogg"
    keke "그래, 그래……"


translate japanese plot1_2570cca4:



    voice "voice/keke_07.ogg"
    keke "（같은 여자한테 이런 말은 좀 그렇지만……）"


translate japanese plot1_3f2f6a94:



    voice "voice/keke_08.ogg"
    keke "（이 여자, 정말 귀찮아!）" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot1_35e0138d:



    voice "voice/tianqin_181.ogg"
    tianqin "아무튼 지금 내 출석률은 딱 벼랑 끝이야."


translate japanese plot1_ee0f98d8:



    voice "voice/tianqin_182.ogg"
    tianqin "언제 주임 선생님한테 불려 가도 이상하지 않은 상황이라고."


translate japanese plot1_90406732:



    voice "voice/keke_09.ogg"
    keke "그럼 수업을 들으러 가. 왜 또 수업 빼먹고 실험실에 와 있는 건데?"


translate japanese plot1_c7ab4cb2:



    voice "voice/tianqin_183.ogg"
    tianqin "수업 듣기가 싫으니까!"


translate japanese plot1_eafcb5fd:



    voice "voice/keke_10.ogg"
    keke "（으윽…… 이 사람, 말이 전혀 안 통해!）"


translate japanese plot1_2e6a8fc3:


    "틈만 나면 수업을 빼먹고 실험실로 오는 눈앞의 사람도, 학년으로 따지면 일단 그녀의 선배였다."


translate japanese plot1_cbe045b7:


    "하지만 이 선배는 전혀 본보기가 될 만한 사람이 아니었다. 거의 매일 결석하거나 수업을 빼먹었다."


translate japanese plot1_72b275fd:


    "모처럼 학교에 와도 늘 실험실에 와서 자신을 귀찮게 했다."


translate japanese plot1_2a1baf07:


    "코코는 이런 선배는 차라리 모르는 사이였으면 싶었다."


translate japanese plot1_b8ab13f8:



    voice "voice/tianqin_184.ogg"
    tianqin "코코도 수업 별로 안 듣잖아."


translate japanese plot1_d18d34ef:



    voice "voice/keke_11.ogg"
    keke "나랑 선배를 똑같이 취급하지 마."


translate japanese plot1_2f90c6be:



    voice "voice/keke_12.ogg"
    keke "私はもう龍華大学の{a=dictionary:dict_entry_12}推薦{/a}が決まってるの。高校統一試験を受けなくても進学できるから問題ないのよ。"


translate japanese plot1_560f7319:



    voice "voice/tianqin_185.ogg"
    tianqin "뭐!? 고작 1학년인데?!"


translate japanese plot1_af3b3a96:



    voice "voice/keke_13.ogg"
    keke "그래, 고작 1학년인데!"


translate japanese plot1_f37a7029:



    voice "voice/keke_14.ogg"
    keke "벌써 2학년인 선배랑 하늘과 땅 차이가 난다고!"


translate japanese plot1_700fc9d4:



    voice "voice/keke_15.ogg"
    keke "선배도 좀 부끄러운 줄 알아야지!"


translate japanese plot1_84e6eb76:



    voice "voice/tianqin_186.ogg"
    tianqin "아아, 좋겠다. 나도 추천 입학으로 대학 가고 싶어."


translate japanese plot1_1e83c3d0:



    voice "voice/keke_16.ogg"
    keke "선배도 열심히 공부하면 좋은 대학 가는 건 어렵지 않잖아."


translate japanese plot1_ad4f7a97:



    voice "voice/keke_17.ogg"
    keke "지난번 중간고사 성적도 꽤 괜찮지 않았어?"


translate japanese plot1_b242c5a4:



    voice "voice/tianqin_187.ogg"
    tianqin "그건 다 벼락치기로 한 거야."


translate japanese plot1_69c69470:



    voice "voice/tianqin_188.ogg"
    tianqin "히나타가 도와주지 않았으면 큰일 날 뻔했어."


translate japanese plot1_f95c82c5:



    voice "voice/keke_18.ogg"
    keke "（이 사람, 시험 직전에만 공부하면서 어떻게 저런 점수를 받지……）"


translate japanese plot1_823ce661:



    voice "voice/keke_19.ogg"
    keke "（분명 공부에 재능이 있는데 왜 의욕은 없는 걸까.）"


translate japanese plot1_8d4acef4:



    voice "voice/keke_20.ogg"
    keke "あは…"


translate japanese plot1_1c74a9ec:



    voice "voice/keke_21.ogg"
    keke "（노력하는 애들한테는 미안하지만, 공부는 노력뿐 아니라 재능도 관계있으니까……）"


translate japanese plot1_062aec66:



    voice "voice/keke_22.ogg"
    keke "（똑같은 시간을 공부해도 결과가 완전히 다르잖아. 그렇게 보면 시험으로 사람의 가치를 재는 게…… 정말 공평할까……）"


translate japanese plot1_523f9185:


    tianqin "……어—이, 코코—."


translate japanese plot1_b5832f3f:



    voice "voice/keke_23.ogg"
    keke "（누구나 자기 특기를 더 살릴 수 있는 제도가 있으면 좋을 텐데……）"


translate japanese plot1_868aab46:



    voice "voice/tianqin_190.ogg"
    tianqin "듣고 있어—? 저기—."


translate japanese plot1_6d9b0d3b:



    voice "voice/keke_24.ogg"
    keke "（「공평」이란 대체 뭘까……）"


translate japanese plot1_55357f34:



    voice "voice/tianqin_191.ogg"
    tianqin "얍!"


translate japanese plot1_530a1f41:



    voice "voice/keke_000024.ogg"
    keke "으악!?" with Shake((0, 0, 0, 0), 0.3, dist=10)


translate japanese plot1_2b951c5d:


    "라이라는 코코가 생각에 잠긴 틈에 조용히 뒤로 다가가 덥석 안아 올렸다."


translate japanese plot1_8ad5a7e0:



    voice "voice/tianqin_192.ogg"
    tianqin 0104 "날아라, 날아라!"


translate japanese plot1_b35f9078:



    voice "voice/keke_25.ogg"
    keke 0105 "뭐 하는 거야! 갑자기 들어 올리지 마!"


translate japanese plot1_3dbe7103:



    voice "voice/tianqin_193.ogg"
    tianqin 0104 "멍하니 있길래!"


translate japanese plot1_840028eb:



    voice "voice/keke_26.ogg"
    keke 0103 "……미안, 「입시 제도」를 좀 생각하고 있었어."


translate japanese plot1_ac338815:



    voice "voice/tianqin_194.ogg"
    tianqin 0113 "응? 정치인이 되고 싶어?"


translate japanese plot1_f1fb004e:



    voice "voice/keke_27.ogg"
    keke 0104 "그런 거 아니야!"


translate japanese plot1_3f57ded0:



    voice "voice/tianqin_195.ogg"
    tianqin 0104 "그나저나 코코, 엄청 가볍다. 밥은 잘 먹고 다녀?"


translate japanese plot1_fd04d8de:

    voice "voice/keke_28.ogg"

    keke 0105 "지금 그걸 물어볼 때야!?"


translate japanese plot1_e3b5e422:

    voice "voice/keke_29.ogg"

    keke 0105 "빨리 내려 줘!"


translate japanese plot1_163df979:

    voice "voice/keke_30.ogg"

    keke "누구야? 문 안 잠겼어."


translate japanese plot1_8eb0b283:



    voice "voice/xiaoxia_01.ogg"
    xiaoxia2 "저기……"


translate japanese plot1_2b5cd4a9:



    voice "voice/tianqin_196.ogg"
    tianqin "어? 아, 아키나네."


translate japanese plot1_fa5f05a7:



    voice "voice/keke_31.ogg"
    keke "아는 애야?"


translate japanese plot1_13271018:



    voice "voice/tianqin_197.ogg"
    tianqin "같은 반 친구야."


translate japanese plot1_6fcad1a1:



    voice "voice/tianqin_198.ogg"
    tianqin "무슨 일이야, 아키나?"


translate japanese plot1_ad8bf36f:



    voice "voice/xiaoxia_02.ogg"
    xiaoxia "라, 라이라 씨…… 담임 선생님이 교무실로 와 달라고 하셨어요……"


translate japanese plot1_989f3a8b:



    voice "voice/tianqin_199.ogg"
    tianqin "으악! 또야——"


translate japanese plot1_26ec8fa4:



    voice "voice/keke_32.ogg"
    keke "자업자득이지."


translate japanese plot1_a3d966bd:



    voice "voice/xiaoxia_03.ogg"
    xiaoxia "지금 시간 괜찮으시면……"


translate japanese plot1_76158de2:



    voice "voice/tianqin_200.ogg"
    tianqin "응, 갈게, 갈게."


translate japanese plot1_ceb5f7da:



    voice "voice/xiaoxia_04.ogg"
    xiaoxia "그, 그러면 다행이에요…… 선생님이 꼭 제가 데려오라고 하셔서……"


translate japanese plot1_170a1cf5:



    voice "voice/tianqin_201.ogg"
    tianqin "（저 선생님, 또 내성적인 애한테 심부름을 시키신 건가……）"


translate japanese plot1_445e0c28:



    voice "voice/tianqin_202.ogg"
    tianqin "（……결국 죄책감이 들어서 따라갈 수밖에 없어진다니까.）"


translate japanese plot1_4a7412b0:



    voice "voice/tianqin_203.ogg"
    tianqin "하아…… 그럼 갈까."


translate japanese plot1_cc11676f:



    voice "voice/tianqin_204.ogg"
    tianqin "코코, 또 올게."


translate japanese plot1_f1501901:



    voice "voice/keke_33.ogg"
    keke "오지 말라니까, 선배. 여긴 출입 금지야."


translate japanese plot1_2b84a694:



    voice "voice/tianqin_205.ogg"
    tianqin "（으으…… 자, 이번에는 어떻게 둘러댈까……）"


translate japanese plot1_a1aed1a0:



    voice "voice/tianqin_206.ogg"
    tianqin "네?"


translate japanese plot1_a49c8b9a:



    voice "voice/xiaoxia_05.ogg"
    xiaoxia "どうかしたんですか？天琴さん。"


translate japanese plot1_105d5153:



    voice "voice/tianqin_207.ogg"
    tianqin "잠깐, 치마 뒤쪽에 뭐 묻었어."


translate japanese plot1_1a2ed482:



    voice "voice/xiaoxia_06.ogg"
    xiaoxia "네!? 저, 정말요!?"


translate japanese plot1_74404d67:



    voice "voice/tianqin_208.ogg"
    tianqin "움직이지 마. 닦아 줄게."


translate japanese plot1_a4afafb9:



    voice "voice/xiaoxia_07.ogg"
    xiaoxia "아, 아니에요! 괘, 괜찮아요. 제가 할게요!"


translate japanese plot1_afc9e3b7:



    voice "voice/tianqin_209.ogg"
    tianqin "괜찮아. 가만히 있어."


translate japanese plot1_04626ccd:



    voice "voice/xiaoxia_08.ogg"
    xiaoxia "네, 네……"


translate japanese plot1_0c5b91f3:



    voice "voice/tianqin_210.ogg"
    tianqin "으음, 어디 쓸렸나 보네. 꽤 더러워졌는데?"


translate japanese plot1_03f96054:



    voice "voice/xiaoxia_09.ogg"
    xiaoxia "아, 그, 그건…… 아까 넘어져서요……"


translate japanese plot1_9781f5b9:



    voice "voice/tianqin_211.ogg"
    tianqin "（아키나가 이렇게 덜렁댔던가…?）"


translate japanese plot1_51fc4ce1:



    voice "voice/xiaoxia_10.ogg"
    xiaoxia "라, 라이라 씨…… 감사합니다."


translate japanese plot1_257a34b5:



    voice "voice/tianqin_212.ogg"
    tianqin "괜찮다니까. 그렇게 깍듯하게 굴지 마. 그냥 라이라라고 해."


translate japanese plot1_f48ba5eb:



    voice "voice/tianqin_213.ogg"
    tianqin "이번 학기부터 같은 반이 됐으니까, 그렇게 어려워하지 않아도 돼."


translate japanese plot1_813945b5:



    voice "voice/xiaoxia_11.ogg"
    xiaoxia "네…… 그, 그래요? 그, 그럼…… 그렇게 할게요."


translate japanese plot1_b0d15ee9:



    voice "voice/tianqin_214.ogg"
    tianqin "（으음…… 역시 나를 좀 무서워하나.）"


translate japanese plot1_adad4a7e:



    voice "voice/tianqin_215.ogg"
    tianqin "（サボりすぎたせいかな……今学期の新しい子たち、みんな妙に{a=dictionary:dict_entry_13}私{/a}を怖がってる気がする。）"


translate japanese plot1_3594619f:



    voice "voice/xiaoxia_12.ogg"
    xiaoxia "서, 선생님…… 데려왔어요……"


translate japanese plot1_e97e9486:



    voice "voice/banzhuren_01.ogg"
    banzhuren "응, 고맙다. 넌 이제 교실로 돌아가도 돼."


translate japanese plot1_04626ccd_1:



    voice "voice/xiaoxia_13.ogg"
    xiaoxia "네, 네……"


translate japanese plot1_aa8bca9a:



    voice "voice/tianqin_216.ogg"
    tianqin "으…… 선생님……"


translate japanese plot1_28efcafe:



    voice "voice/banzhuren_02.ogg"
    banzhuren "그래, 드디어 학교에 얼굴을 비췄구나, 이 녀석."


translate japanese plot1_a735c96f:


    "라이라 앞에 서 있는 사람은 담임 선생님이었다."


translate japanese plot1_5056d0f3:


    "見た目は少しだらしないが、生徒思いで、とても面倒見のいい先生だ。"


translate japanese plot1_f98cd0eb:


    "그러니 라이라가 학교에서 가장 어려워하는 사람이기도 했다."


translate japanese plot1_442941ca_1:


    "……"


translate japanese plot1_cc36f813:


    "이윽고 교무실에는 담임 선생님이 라이라를 훈계하는 소리만 남았다."


translate japanese plot1_72795a52:



    voice "voice/banzhuren_03.ogg"
    banzhuren "알겠니? 모처럼 학교에 왔으면 수업도 제대로 들어야지."


translate japanese plot1_cb58a0aa:



    voice "voice/tianqin_217.ogg"
    tianqin "알았어요. 오전에는 들었잖아요."


translate japanese plot1_cfdbfc64:



    voice "voice/banzhuren_04.ogg"
    banzhuren "그럼 오후에도 얼굴은 비춰야지."


translate japanese plot1_be0adec6:



    voice "voice/banzhuren_05.ogg"
    banzhuren "수학 시간이 싫은 건 알지만, 수학 시간마다 빠질 수는 없잖니."


translate japanese plot1_de152327:



    voice "voice/tianqin_218.ogg"
    tianqin "에이——"


translate japanese plot1_94623f21:


    "教師と生徒というより、まるで友人同士の会話のようだ。先生からは威圧感というものがまるで感じられない。"


translate japanese plot1_c53b9880:


    "天琴も説教を右から左に聞き流し、お互い「コミュニケーション」という名の儀式をこなしているだけだった。"


translate japanese plot1_f5ca0d4a:



    voice "voice/tianqin_219.ogg"
    tianqin "（……수학 선생님이 또 일렀나 보네.）"


translate japanese plot1_7105eeec:



    voice "voice/tianqin_220.ogg"
    tianqin "（담임 선생님도 참 힘드시겠다.）"


translate japanese plot1_a9d617f6:



    voice "voice/banzhuren_06.ogg"
    banzhuren "내 말 다 들었지? 앞으로 수학 시간은 빼먹지 마라."


translate japanese plot1_48f0de73:



    voice "voice/tianqin_221.ogg"
    tianqin "네, 네——"


translate japanese plot1_d8bec678:



    voice "voice/banzhuren_07.ogg"
    banzhuren "할 말은 이게 다야. 돌아가 봐."


translate japanese plot1_9dee6ad0:



    voice "voice/tianqin_222.ogg"
    tianqin "알겠습니다!"


translate japanese plot1_6ed261a6:



    voice "voice/banzhuren_08.ogg"
    banzhuren "교실로 가라는 뜻이야. 또 실험실에 가서 코코 귀찮게 하지 말고."


translate japanese plot1_b063902d:



    voice "voice/tianqin_223.ogg"
    tianqin "네에, 알고 있어요오."


translate japanese plot1_81af469f:



    voice "voice/tianqin_224.ogg"
    tianqin "후우～ 드디어 풀려났다……"


translate japanese plot1_c2e32d50:



    voice "voice/jinlaoshi_01.ogg"
    jinlaoshi "아! 라이라!"


translate japanese plot1_7d7d6bb7:



    voice "voice/tianqin_225.ogg"
    tianqin "히익!?"


translate japanese plot1_a1f3011b:



    voice "voice/tianqin_226.ogg"
    tianqin "서, 선생님……"


translate japanese plot1_e51cfb12:



    voice "voice/jinlaoshi_02.ogg"
    jinlaoshi "와, 정말 오랜만에 보는구나."


translate japanese plot1_9ab88726:



    voice "voice/jinlaoshi_03.ogg"
    jinlaoshi "내 수업에 안 들어온 지 얼마나 됐니?"


translate japanese plot1_d98b5be6:



    voice "voice/tianqin_227.ogg"
    tianqin "죄, 죄송해요……"


translate japanese plot1_7c572ed7:



    voice "voice/jinlaoshi_04.ogg"
    jinlaoshi "뭐, 됐어. 이번 수업은 꼭 들어야 해."


translate japanese plot1_3d696cac:



    voice "voice/tianqin_228.ogg"
    tianqin "네……"


translate japanese plot1_8601e349:



    voice "voice/banzhuren_09.ogg"
    banzhuren "으음——"


translate japanese plot1_d5231cf8:



    voice "voice/banzhuren_10.ogg"
    banzhuren "（저 애는 공부 쪽으로는 손이 안 가지만…… 다른 선생님들 불만이 너무 많단 말이지…….）"


translate japanese plot1_e110980a:



    voice "voice/jinlaoshi_05.ogg"
    jinlaoshi "무슨 일이세요, 이 선생님? 고민이라도 있으세요?"


translate japanese plot1_84daa482:



    voice "voice/banzhuren_11.ogg"
    banzhuren "대학 갓 졸업한 풋내기한테 얘기해 봤자 소용없어."


translate japanese plot1_66a67e01:



    voice "voice/jinlaoshi_06.ogg"
    jinlaoshi "너무하세요! 저 이제 신입 아니거든요!"


translate japanese plot1_b6702642:


    "김 선생님은 교무실에서 가장 젊은 체육 교사였다."


translate japanese plot1_bf2a6092:


    "若さゆえ、いつも他の先生からいじられている。"


translate japanese plot1_b80b0b82:



    voice "voice/jinlaoshi_07.ogg"
    jinlaoshi "정말～ 놀리지 마세요."


translate japanese plot1_6c680d62:



    voice "voice/jinlaoshi_08.ogg"
    jinlaoshi "혹시 라이라 생각하고 계셨죠?"


translate japanese plot1_c4ec409e:



    voice "voice/banzhuren_12.ogg"
    banzhuren "어? 만났어?"


translate japanese plot1_a2d9747d:



    voice "voice/jinlaoshi_09.ogg"
    jinlaoshi "네, 방금 교무실 앞에서요."


translate japanese plot1_f828bcfd:



    voice "voice/jinlaoshi_10.ogg"
    jinlaoshi "「도망가면 안 돼～」 하고 당부해 뒀어요."


translate japanese plot1_aef293a4:



    voice "voice/banzhuren_13.ogg"
    banzhuren "흥, 걔가 그 말을 순순히 듣겠어."


translate japanese plot1_0471a5d2:



    voice "voice/banzhuren_14.ogg"
    banzhuren "우리 반에는 라이라 말고도 그런 학생이 하나 더 있어."


translate japanese plot1_f7f46be6:



    voice "voice/banzhuren_15.ogg"
    banzhuren "공부는 잘하지만 학교라는 틀에 적응하지 못하는 타입이지."


translate japanese plot1_ed61ffb4:



    voice "voice/jinlaoshi_11.ogg"
    jinlaoshi "히나타요?"


translate japanese plot1_15874a17:



    voice "voice/banzhuren_16.ogg"
    banzhuren "오, 잘 아네."


translate japanese plot1_f7c4fc67:



    voice "voice/jinlaoshi_12.ogg"
    jinlaoshi "저도 그 반 체육 수업을 맡고 있거든요."


translate japanese plot1_9dc2ad14:



    voice "voice/banzhuren_17.ogg"
    banzhuren "아, 그랬지. 까맣게 잊었네."


translate japanese plot1_5b42b628:



    voice "voice/jinlaoshi_13.ogg"
    jinlaoshi "그렇게 말씀하시면 저 좀 섭섭한데요."


translate japanese plot1_bf708505:



    voice "voice/banzhuren_18.ogg"
    banzhuren "하하—— 농담이야."


translate japanese plot1_f0718eb3:



    voice "voice/jinlaoshi_14.ogg"
    jinlaoshi "그런데…… 라이라를 계속 그렇게 내버려 두실 거예요?"


translate japanese plot1_6e50e435:



    voice "voice/banzhuren_19.ogg"
    banzhuren "내버려 두는 게 아니야. 그 아이에게는 이게 가장 좋은 교육 방법이야."


translate japanese plot1_40202f05:



    voice "voice/banzhuren_20.ogg"
    banzhuren "걔는 학교라는 곳을 어려워하거든."


translate japanese plot1_dc03712f:



    voice "voice/banzhuren_21.ogg"
    banzhuren "억지로 묶어 두면 오히려 반발해서 자퇴해 버릴 수도 있어."


translate japanese plot1_d87f6e69:



    voice "voice/jinlaoshi_15.ogg"
    jinlaoshi "아이고, 그건 꽤 골치 아프겠네요……"


translate japanese plot1_e48e2a6c:



    voice "voice/banzhuren_22.ogg"
    banzhuren "어쩔 수 없지. 집안 사정도 좀 복잡하니까."


translate japanese plot1_3ed9dccb:



    voice "voice/banzhuren_23.ogg"
    banzhuren "머리가 좋은 게 다행이야. 공부도 곧잘 하고 성적도 나쁘지 않으니까."


translate japanese plot1_008f7bc9:



    voice "voice/jinlaoshi_16.ogg"
    jinlaoshi "그렇군요…… 그래서 일부러 자유롭게 두시는 거네요."


translate japanese plot1_e340f436:



    voice "voice/banzhuren_24.ogg"
    banzhuren "으음, 라이라는 말이야. 옭아맬수록 반발하는 타입이거든."


translate japanese plot1_fb23380d:



    voice "voice/banzhuren_25.ogg"
    banzhuren "다른 학생들처럼 규칙으로 묶어 두는 방식은 라이라에게 통하지 않아."


translate japanese plot1_5e1c1858:



    voice "voice/banzhuren_26.ogg"
    banzhuren "사실 라이라만의 문제도 아니야. 교칙으로 모두를 일률적으로 대하지 말고, 학생 한 명 한 명에 맞춰 지도해야 해."


translate japanese plot1_1df26bcd:



    voice "voice/banzhuren_27.ogg"
    banzhuren "다만 다른 선생님들에게서 불만이 산더미처럼 쏟아지는 게 문제지."


translate japanese plot1_389756b4:



    voice "voice/jinlaoshi_17.ogg"
    jinlaoshi "아하하…… 이 선생님 반은 성적도 우수한데, 교사 불만 비율은 학년 1등이네요."


translate japanese plot1_92aa2db9:



    voice "voice/jinlaoshi_18.ogg"
    jinlaoshi "그래도 전 선생님 생각이 좋아요. 좀 힘들어 보이긴 하지만요."


translate japanese plot1_0cc7be09:



    voice "voice/banzhuren_28.ogg"
    banzhuren "물론 그만큼 신경을 쓰긴 하지."


translate japanese plot1_0673b901:



    voice "voice/banzhuren_29.ogg"
    banzhuren "그래도 그 정도는 해야 진짜 교사라고 할 수 있지 않겠어."


translate japanese plot1_355b7f25:



    voice "voice/banzhuren_30.ogg"
    banzhuren "우리가 학생일 때, 그 고리타분한 늙은이들은 일을 게을리하고 교사로서 책임을 전혀 다하지 않았어."


translate japanese plot1_5cfe48cf:



    voice "voice/jinlaoshi_19.ogg"
    jinlaoshi "아～ 역시 이 선생님은 옛 교육 제도에 원한이 있으시네요."


translate japanese plot1_c67c8647:



    voice "voice/banzhuren_31.ogg"
    banzhuren "당연하지. 그래서 이 길로 들어선 거야."


translate japanese plot1_b0636f76:



    voice "voice/banzhuren_32.ogg"
    banzhuren "지금은 「유토리 교육」이라고들 하지만, 오히려 지금이야말로 진심으로 이끌어 줘야 할 때라고 생각해."


translate japanese plot1_c9c2f104:



    voice "voice/npc_05.ogg"
    npc3 "이 선생님 계십니까?"


translate japanese plot1_72e51de8:



    voice "voice/jinlaoshi_20.ogg"
    jinlaoshi "아, 학년부장 선생님이다……."


translate japanese plot1_83cd3b3a:



    voice "voice/banzhuren_33.ogg"
    banzhuren "（쳇, 또 저 얄미운 영감이네. 어차피 회의에 끌고 가겠지…….）"


translate japanese plot1_62088ed9:



    voice "voice/tianqin_229.ogg"
    tianqin "아—"


translate japanese plot1_2c73b562:



    voice "voice/yangxi_45.ogg"
    yangxi "돌아왔어?"


translate japanese plot1_71bfc6d1:



    voice "voice/tianqin_230.ogg"
    tianqin "담임 선생님한테서."


translate japanese plot1_6195ddcd:



    voice "voice/yangxi_46.ogg"
    yangxi "한바탕 혼났어?"


translate japanese plot1_7502c190:



    voice "voice/tianqin_231.ogg"
    tianqin "늘 그렇지 뭐. 한참 잔소리 듣고 왔어."


translate japanese plot1_83da9115:



    voice "voice/yangxi_47.ogg"
    yangxi "수학 선생님이 이르러 가셨겠지."


translate japanese plot1_cb6f9728:



    voice "voice/yangxi_48.ogg"
    yangxi "수업을 빼먹어서 꽤 화나신 모양이네."


translate japanese plot1_f0dab1ba:



    voice "voice/tianqin_232.ogg"
    tianqin "응, 그럴 줄 알았어."


translate japanese plot1_be476c8d:



    voice "voice/tianqin_233.ogg"
    tianqin "하아…… 내일 수학 수업만큼은 꼭 나오래."


translate japanese plot1_67ea4e27:



    voice "voice/yangxi_49.ogg"
    yangxi "아직도 빠질 생각이었어?"


translate japanese plot1_e1c34ec6:



    voice "voice/tianqin_234.ogg"
    tianqin "가능하면 평생 수학 선생님 안 보고 살고 싶은데……"


translate japanese plot1_2d8b9e62:



    voice "voice/yangxi_50.ogg"
    yangxi "……"


translate japanese plot1_eee3b570:



    voice "voice/yangxi_51.ogg"
    yangxi "오늘 끝나고 어디 좀 놀다가 갈까?"


translate japanese plot1_64565a6c:



    voice "voice/tianqin_235.ogg"
    tianqin "어? 웬일이야? 히나타가 먼저 놀자고 하네."


translate japanese plot1_a9923400:



    voice "voice/yangxi_52.ogg"
    yangxi "기분이 안 좋아 보여서."


translate japanese plot1_04c45820:



    voice "voice/tianqin_236.ogg"
    tianqin "그럼 뭐라도 먹고 가자."


translate japanese plot1_9470c274:



    voice "voice/tianqin_237.ogg"
    tianqin "그러고 보니 집 근처에서 괜찮아 보여서 눈길이 가는 디저트 가게를 찾았어."


translate japanese plot1_7d80b3b5:



    voice "voice/yangxi_53.ogg"
    yangxi "장사 잘돼? 줄 서야 하나?"


translate japanese plot1_ba79b8c1:



    voice "voice/tianqin_238.ogg"
    tianqin "장사는 잘 안되는 것 같아. 곧 문 닫을 것 같던데."


translate japanese plot1_0888a680:



    voice "voice/yangxi_54.ogg"
    yangxi "그게 어디가 「괜찮아 보인다」는 건데."


translate japanese plot1_8ac0c92c:



    voice "voice/tianqin_239.ogg"
    tianqin "음…… 네 입맛에 잘 맞을 것 같아서?"


translate japanese plot1_2d8b9e62_1:



    voice "voice/yangxi_55.ogg"
    yangxi "……"


translate japanese plot1_b18cdef4:



    voice "voice/tianqin_240.ogg"
    tianqin "뭐, 어때. 같이 가 줘～"


translate japanese plot1_5cb0ec90:



    voice "voice/tianqin_241.ogg"
    tianqin "으…… 그 가게 케이크, 너무 달았어…… 그 맛이면 곧 망할 것 같은 이유도 알겠네……"


translate japanese plot1_4b2b809c:



    voice "voice/tianqin_242.ogg"
    tianqin "뭐, 히나타는 그렇게 단 케이크도 괜찮은 것 같아서 다행이었지만."


translate japanese plot1_7ac02513:



    voice "voice/tianqin_243.ogg"
    tianqin "응——?"


translate japanese plot1_e94d50bc:


    "계단 쪽에서 종이를 넘기는 듯한 작은 소리가 났다."


translate japanese plot1_94d30bf1:


    "라이라는 또 이웃집 아이가 열쇠를 잊었나 싶어 살피러 갔다."


translate japanese plot1_7df6b37a:


    "하지만 눈앞에 나타난 건 낯익은 모자와 헐렁한 로브였다."


translate japanese plot1_867393e8:


    "아침에 벌써 떠난 줄 알았던 소녀가 지금은 계단 중간에 걸터앉아,"


translate japanese plot1_f5d2f0b6:


    "どこからか持ってきた小説を真剣に読んでいたのだ。"


translate japanese plot1_667da4bc:


    "라이라는 순간 어떻게 반응해야 할지 몰라 어색하게 그 자리에 멈춰 섰다."


translate japanese plot1_4f781951:


    "히나타의 말대로 경찰에게 먼저 전화해야 할까?"


translate japanese plot1_0870a9cc:


    "탁."


translate japanese plot1_f445f7f7:


    "소녀도 곧 라이라를 알아보고 손에 든 소설책을 덮었다."


translate japanese plot1_bdcc241e:


    voice "voice/cygnus_63.ogg"
    "「……돌아왔어?」{p}소녀의 목소리가 너무 작아 처음에는 혼잣말인 줄 알았다." (callback=nvl_page_voice, cb_page_voices=('voice/cygnus_63.ogg', None))


translate japanese plot1_8cfd6803:


    "조금 지나서야 자신에게 물은 말이라는 걸 깨달았다."


translate japanese plot1_fa171854:



    voice "voice/tianqin_244.ogg"
    tianqin 0103 "아…… 응. 방금 학교 끝났어."


translate japanese plot1_0f7b24b0:



    voice "voice/cygnus_64.ogg"
    cygnusnameless 0201 "문이…… 닫고 나니까 안 열리더라."


translate japanese plot1_6d2c71c9:



    voice "voice/tianqin_245.ogg"
    tianqin 0102 "아——! 자동으로 잠기거든."


translate japanese plot1_dc69f6b9:



    voice "voice/cygnus_65.ogg"
    cygnusnameless 0201 "자동으로 잠겨?"


translate japanese plot1_4c473c10:



    voice "voice/tianqin_246.ogg"
    tianqin 0114 "그러니까, 한 번 닫으면 저절로 잠기는 문을 말하는 거……겠지?"


translate japanese plot1_506e47d2:


    "설명을 하긴 했지만, 안 한 것이나 다름없었다."


translate japanese plot1_ba019a39:



    voice "voice/cygnus_66.ogg"
    cygnusnameless 0201 "……응."


translate japanese plot1_c36831fd:


    "理解できていないままの相槌。微妙な空気がまた漂った。"


translate japanese plot1_80b2d10e:


    "잠시 침묵이 흐른 뒤 라이라가 입을 열었다."


translate japanese plot1_c9fb37a3:



    voice "voice/tianqin_247.ogg"
    tianqin 0103 "……아직 안 돌아가?"


translate japanese plot1_7a45dabe:



    voice "voice/cygnus_67.ogg"
    cygnusnameless 0206 "집…… 난 여기에 집이 없어."


translate japanese plot1_d1186536:



    voice "voice/tianqin_248.ogg"
    tianqin 0103 "어?"


translate japanese plot1_10d4a829:



    voice "voice/tianqin_249.ogg"
    tianqin 0103 "（집 없이 떠도는 건가……?）"


translate japanese plot1_87b64155:



    voice "voice/cygnus_68.ogg"
    cygnusnameless "일단 안에 들어가서 얘기할까?"


translate japanese plot1_901ea27a:



    voice "voice/tianqin_250.ogg"
    tianqin "아, 맞다! 미안!"


translate japanese plot1_08b33041:



    voice "voice/tianqin_251.ogg"
    tianqin "일단 들어가자."


translate japanese plot1_0d7c2a64:


    "──지이익."


translate japanese plot1_3dbfcb42:


    "프라이팬에서 기름이 튀는 소리가 났다. 아침처럼 라이라는 집에 오자마자 부엌에서 움직이기 시작했다."


translate japanese plot1_e1b5dbc7:



    voice "voice/tianqin_252.ogg"
    tianqin "（이 애, 하루 종일 아무것도 안 먹은 거 아냐……?）"


translate japanese plot1_590a5184:



    voice "voice/tianqin_253.ogg"
    tianqin "（좋아, 빨리 밥을 만들어야겠어）"


translate japanese plot1_f6fa681e:


    "天琴はそう考えた。けれど少女の方は、一日何も口にしていないが、食事よりも天琴と話すことを望んでいるようだった。"


translate japanese plot1_3963e4fe_8:



    voice "voice/cygnus_69.ogg"
    cygnusnameless "……"


translate japanese plot1_64a04419:


    "소녀는 어떻게 말을 꺼낼지 생각했다."


translate japanese plot1_30421faf:


    "彼女にとって、この世界で繋がりがあるのは天琴だけ。"


translate japanese plot1_c1c034a9:


    "라이라를 믿어도 될까?"


translate japanese plot1_169dc4d8:


    "눈앞의 아직 완전히 어른이 되지 않은 젊은이는 자신을 도와줄까."


translate japanese plot1_9a7c8e6d:


    "자신의 상황을 전부 털어놓으면 라이라는 어떻게 반응할까?"


translate japanese plot1_30e2e048:


    "믿어 주지 않기만 한다면 그나마 낫다. 하지만 라이라가 다른 누군가에게 말해 버리면 상황은 단번에 손쓸 수 없게 된다."


translate japanese plot1_b4aa158e:



    voice "voice/cygnus_70.ogg"
    cygnusnameless "（……그것만은 피해야 해.）"


translate japanese plot1_42a1443d:


    "いくら魔法を知っていても、この「マナ」のない世界では何もできない。魔導書に記された内容も、絵に描いた餅になってしまった。"


translate japanese plot1_5cd7f516:



    voice "voice/tianqin_254.ogg"
    tianqin2 0102 "스테이크 먹을래?"


translate japanese plot1_ab69aef6:



    voice "voice/cygnus_71.ogg"
    cygnusnameless "……어느 쪽이든 괜찮아."


translate japanese plot1_cbb2e26d:



    voice "voice/tianqin_255.ogg"
    tianqin2 0102 "그래애."


translate japanese plot1_71e08e60:



    voice "voice/tianqin_256.ogg"
    tianqin "……"


translate japanese plot1_3963e4fe_20:



    voice "voice/cygnus_72.ogg"
    cygnusnameless "……"


translate japanese plot1_442941ca_2:


    "……"


translate japanese plot1_27414cc1:


    "テーブルについた二人の間に、長い沈黙が流れる。"


translate japanese plot1_ef43e5c6:



    voice "voice/tianqin_257.ogg"
    tianqin "（뭐, 뭐라도 말하는 게 좋겠지?）"


translate japanese plot1_7f95711f:



    voice "voice/tianqin_258.ogg"
    tianqin "（잘 다녀왔냐고 할까?）"


translate japanese plot1_7b1606f7:



    voice "voice/cygnus_73.ogg"
    cygnusnameless "저기, 숟가락 있어?"


translate japanese plot1_90fb4793:



    voice "voice/tianqin_259.ogg"
    tianqin "아, 응. 있어."


translate japanese plot1_460bcaf0:


    "天琴が戸棚から出してくれたスプーンを受け取り、少女は黙々と料理を口に運ぶ。箸の存在など気にも留めない。"


translate japanese plot1_b2dd0532:



    voice "voice/tianqin_260.ogg"
    tianqin "아, 젓가락질이 어려워?"


translate japanese plot1_531cf194:



    voice "voice/cygnus_74.ogg"
    cygnusnameless "젓가락이 이 막대기를 말하는 거야?"


translate japanese plot1_e2827b3f:



    voice "voice/cygnus_75.ogg"
    cygnusnameless "내가 살던 곳에서는 이런 식기를 쓰는 사람이 드물어."


translate japanese plot1_9129d254:



    voice "voice/tianqin_261.ogg"
    tianqin "아, 그렇구나……"


translate japanese plot1_b28519b3:



    voice "voice/tianqin_262.ogg"
    tianqin "（그럼 웨스트 지방 출신?）"


translate japanese plot1_34730ef9:



    voice "voice/tianqin_263.ogg"
    tianqin "포크 줄까?"


translate japanese plot1_f09da903:



    voice "voice/cygnus_76.ogg"
    cygnusnameless "응. 그러면 좋겠어."


translate japanese plot1_442941ca_3:


    "……"


translate japanese plot1_d53f69b0:


    "침묵은 여전히 이어졌다."


translate japanese plot1_7d89e402:


    "평소라면 라이라는 이런 침묵을 견디지 못하고 말을 꺼냈을 것이다. 어색한 분위기가 불편한 성격이었다."


translate japanese plot1_4c030132:


    "하지만 예상치 못한 상황에 지금은 무슨 말을 해야 할지 알 수 없었다."


translate japanese plot1_487b3b8b:


    "히나타의 경고도 별일 아니라고 생각했는데, 소녀가 떠나지 않았다는 사실에 정말 놀랐다."


translate japanese plot1_9bc31572:



    voice "voice/tianqin_264.ogg"
    tianqin "저기……"


translate japanese plot1_90aa76a1:



    voice "voice/cygnus_77.ogg"
    cygnusnameless "응?"


translate japanese plot1_273acde9:



    voice "voice/tianqin_265.ogg"
    tianqin "口に合った？"


translate japanese plot1_27004716:


    "「집에 무슨 일이 있어?」 하고 묻고 싶었지만, 막상 입을 열자 말이 나오지 않았다."


translate japanese plot1_d900c0ed:


    "少女のまわりに張りつめた空気が、天琴の口を封じ込めていた。"


translate japanese plot1_217d91cd:



    voice "voice/cygnus_78.ogg"
    cygnusnameless "……응. 전부 맛있어."


translate japanese plot1_649a0538:



    voice "voice/tianqin_266.ogg"
    tianqin "그, 그러면 다행이네……"


translate japanese plot1_442941ca_4:


    "……"


translate japanese plot1_af744008:


    "결국 저녁 식사가 끝날 때까지 라이라는 아무것도 묻지 못했다."


translate japanese plot1_46a1af40:



    voice "voice/tianqin_267.ogg"
    tianqin "（아, 정말! 바보같이 뭐 하는 거야!）"


translate japanese plot1_0e7e651c:



    voice "voice/tianqin_268.ogg"

translate japanese plot7_a419ee74:


    voice "voice/yangxi_542.ogg"
    yangxi "그리고 여기서 비명이 들리니까 애들이 몰려온 거야……"



translate japanese plot7_c1ced98e:


    voice "voice/hunter_54.ogg"
    monolith "헤헤는 무슨! 오늘 아침만 벌써 세 번째야!"



translate japanese plot7_06e4869a:


    voice "voice/yangxi_558.ogg"
    yangxi "체육대회도 아닌데……"



translate japanese plot7_f729173a:


    voice "voice/yangxi_580.ogg"

translate japanese plot7_5f1feb8f:



    voice "voice/tianqin_1398.ogg"
    tianqin "후—— 오늘 아침은 여유 있게 나와서 다행이다."


translate japanese plot7_ce71ea42:



    voice "voice/yangxi_392.ogg"
    yangxi "웬일이야. 사흘 연속 꼬박꼬박 학교에 오고, 지각도 안 하네."


translate japanese plot7_057ff436:



    voice "voice/tianqin_1399.ogg"
    tianqin "헤헤, 하려고 하면 할 수 있거든."


translate japanese plot7_098fef7e:



    voice "voice/yangxi_393.ogg"
    yangxi "何言ってんの。学生なら、それが普通でしょ。"


translate japanese plot7_c7894349:



    voice "voice/tianqin_1400.ogg"
    tianqin "너도 맨날 나랑 같이 땡땡이치잖아, 히나타!"


translate japanese plot7_68228419:



    voice "voice/yangxi_394.ogg"
    yangxi "나를 너랑 똑같이 취급하지 마. 난 내 속도에 맞춰 다닐 뿐이야."


translate japanese plot7_b82e68ed:



    voice "voice/tianqin_1401.ogg"
    tianqin "억지 부리지 마!"


translate japanese plot7_9af1b0b8:



    voice "voice/tianqin_1402.ogg"
    tianqin "그런데 말이야……"


translate japanese plot7_83baf871:



    voice "voice/tianqin_1403.ogg"
    tianqin "교실 분위기 왜 이래? 뭔가 이상하지 않아……?"


translate japanese plot7_8c35c8d8:



    voice "voice/yangxi_395.ogg"
    yangxi "저쪽. 저기 봐……"


translate japanese plot7_60c39d30:



    voice "voice/tianqin_1404.ogg"
    tianqin "응?"


translate japanese plot7_b9cf274e:


    "라이라는 히나타가 가리킨 쪽으로 눈을 돌렸다. 이틀 동안 비어 있던 자리에 오늘은 마침내 주인이 돌아와 있었다."


translate japanese plot7_71c68727:



    voice "voice/tianqin_1405.ogg"
    tianqin "어! 츠루기가 돌아왔네."


translate japanese plot7_9d90c0db:



    voice "voice/tianqin_1406.ogg"
    tianqin "이제 학교에 안 오는 건 아닐까 걱정했는데."


translate japanese plot7_4e1aff4e:



    voice "voice/yangxi_396.ogg"
    yangxi "그럴 리가. 츠루기 성격이면 자기를 함정에 빠뜨린 사람을 찾아낼 생각뿐일걸."


translate japanese plot7_1bec5cdd:



    voice "voice/tianqin_1407.ogg"
    tianqin "잘됐다. 가서 좀 물어볼게."


translate japanese plot7_2d26fe3d:



    voice "voice/yangxi_397.ogg"
    yangxi "잠깐, 어제처럼 막무가내로 굴지 마."


translate japanese plot7_90ba415b:



    voice "voice/tianqin_1408.ogg"
    tianqin "괜찮아. 나 츠루기랑 꽤 친하거든."


translate japanese plot7_fc0c257c:



    voice "voice/yangxi_398.ogg"
    yangxi ""


translate japanese plot7_e6191de5:



    voice "voice/minying_12.ogg"
    minying "츠루기, 어제 상점가에 있는 그 가게에 갔는데 예쁜 장식이 많더라."


translate japanese plot7_3beee524:



    voice "voice/xizhen_19.ogg"
    xizhen "맞아, 맞아! 전부 엄청 귀여웠어!"


translate japanese plot7_3b696e2e:



    voice "voice/xizhen_20.ogg"
    xizhen "오늘 훈련 끝나면 같이 보러 갈래?"


translate japanese plot7_98ca46cd:



    voice "voice/hecheng_98.ogg"
    hecheng "응, 그러자."


translate japanese plot7_03063450:



    voice "voice/tianqin_1409.ogg"
    tianqin "안녕, 츠루기."


translate japanese plot7_75f0287c:



    voice "voice/hecheng_99.ogg"
    hecheng "라이라…"


translate japanese plot7_764fa949:



    voice "voice/hecheng_100.ogg"
    hecheng "오늘은 제대로 학교에 왔네."


translate japanese plot7_a5bca152:



    voice "voice/tianqin_1410.ogg"
    tianqin "ほら…この前、出席率が危ないって言われたから、これ以上休んだら、本当に留年しちゃう。"


translate japanese plot7_68b512a1:



    voice "voice/hecheng_101.ogg"
    hecheng "흥, 참 고생이 많네."


translate japanese plot7_67d6ceeb:



    voice "voice/tianqin_1411.ogg"
    tianqin "그런데 츠루기, 지금 잠깐 괜찮아?"


translate japanese plot7_a0106056:



    voice "voice/hecheng_102.ogg"
    hecheng "왜? 무슨 일이야?"


translate japanese plot7_1b030b27:



    voice "voice/tianqin_1412.ogg"
    tianqin "음…… 여기서는 말하기 좀 그래서……"


translate japanese plot7_65f1e8db:



    voice "voice/hecheng_103.ogg"
    hecheng "…"


translate japanese plot7_d1c9ec46:



    voice "voice/xizhen_21.ogg"
    xizhen "그러니까 그런 일에 끼어들지 말라고 했잖아."


translate japanese plot7_440c3158:



    voice "voice/minying_13.ogg"
    minying "그만 참견해."


translate japanese plot7_83808ad9:



    voice "voice/hecheng_104.ogg"
    hecheng "난 괜찮아. 그렇게 날 세우지 않아도 돼."


translate japanese plot7_360bfacf:



    voice "voice/hecheng_105.ogg"
    hecheng "너희는 먼저 돌아가. 난 라이라랑 얘기할게."


translate japanese plot7_185de547:



    voice "voice/minying_14.ogg"
    minying "츠루기……"


translate japanese plot7_c830497a:



    voice "voice/xizhen_22.ogg"
    xizhen "그, 그럼 우린 갈게……"


translate japanese plot7_b9702edf:



    voice "voice/hecheng_106.ogg"
    hecheng "응."


translate japanese plot7_9971e79d:


    "츠루기가 그렇게 말하자 민영과 희진도 더는 끼어들 수 없었다. 두 사람은 불만스러운 얼굴로 자리를 떴다."


translate japanese plot7_53583757:



    voice "voice/hecheng_107.ogg"
    hecheng "그래서 라이라, 어디서 얘기할래?"


translate japanese plot7_f4e28f13:



    voice "voice/tianqin_1413.ogg"
    tianqin "따라와."


translate japanese plot7_57512195:



    voice "voice/hecheng_108.ogg"
    hecheng "오…… 옥상이구나. 여기는 처음 와 봐."


translate japanese plot7_30f8b696:



    voice "voice/tianqin_1414.ogg"
    tianqin "평소에는 잠겨 있으니까. 대부분 안 와 봤을걸."


translate japanese plot7_1533b11e:



    voice "voice/hecheng_109.ogg"
    hecheng "여기 열쇠까지 갖고 있을 줄은 몰랐네."


translate japanese plot7_4a39e7fe:



    voice "voice/tianqin_1415.ogg"
    tianqin "헤헤, 이곳이 좋아서 담임 선생님께 졸라서 얻었어."


translate japanese plot7_f7ddb4a8:



    voice "voice/hecheng_110.ogg"
    hecheng "교칙 위반 아니야?"


translate japanese plot7_bd0d8a6b:



    voice "voice/tianqin_1416.ogg"
    tianqin "아이, 그런 건 신경 쓰지 마."


translate japanese plot7_25a21831:



    voice "voice/hecheng_111.ogg"
    hecheng "그래서……"


translate japanese plot7_c00830a7:



    voice "voice/hecheng_112.ogg"
    hecheng "뭘 묻고 싶어?"


translate japanese plot7_9ab055df:



    voice "voice/tianqin_1417.ogg"
    tianqin "저…… 그게……"


translate japanese plot7_e352408c:



    voice "voice/hecheng_113.ogg"
    hecheng "왜, 또 말하기 어려워졌어?"


translate japanese plot7_4291fa90:



    voice "voice/hecheng_114.ogg"
    hecheng "지난주 일이지?"


translate japanese plot7_5f567ce2:



    voice "voice/tianqin_1418.ogg"
    tianqin "응…… 좀 괜찮아졌어?"


translate japanese plot7_d9738efb:



    voice "voice/hecheng_115.ogg"
    hecheng "전에 교회에서 만났을 때보다는 훨씬 나아. 그래도 아직 완전히 괜찮진 않아."


translate japanese plot7_68bfbb95:



    voice "voice/tianqin_1419.ogg"
    tianqin "그렇구나…"


translate japanese plot7_033efa89:



    voice "voice/hecheng_116.ogg"
    hecheng "요 며칠 매일 밤 악몽을 꿔."


translate japanese plot7_1691c028:



    voice "voice/hecheng_117.ogg"
    hecheng "흰쥐 떼에 파묻히거나, 입에서 기어 나오거나…… 온통 엉망진창인 꿈뿐이야."


translate japanese plot7_e8bb9e3b:



    voice "voice/tianqin_1420.ogg"
    tianqin "힘들었겠다……"


translate japanese plot7_ee7fceea:



    voice "voice/hecheng_118.ogg"
    hecheng "별일 아냐. 집에서 며칠 쉬니까 좀 나아졌어."


translate japanese plot7_5866aa98:



    voice "voice/hecheng_119.ogg"
    hecheng "どうせ、すぐに過ぎる。そんなに心配しなくていい。"


translate japanese plot7_71e08e60:



    voice "voice/tianqin_1421.ogg"
    tianqin "…"


translate japanese plot7_c9edcf9d:



    voice "voice/tianqin_1422.ogg"
    tianqin "츠루기, 반에서 누가 널 괴롭혀?"


translate japanese plot7_71c6d562:



    voice "voice/hecheng_120.ogg"
    hecheng "뭐? 나를 괴롭힌다고?"


translate japanese plot7_8e12909a:



    voice "voice/tianqin_1423.ogg"
    tianqin "응."


translate japanese plot7_00b437a3:



    voice "voice/hecheng_121.ogg"
    hecheng "훗…… 내가 괴롭힘을 당한다고 생각했어?"


translate japanese plot7_c3555805:



    voice "voice/tianqin_1424.ogg"
    tianqin "응…… 그게 걱정돼서."


translate japanese plot7_96f62d34:



    voice "voice/hecheng_122.ogg"
    hecheng "ライラ、私のこと見くびりすぎじゃない？"


translate japanese plot7_819901ac:



    voice "voice/hecheng_123.ogg"
    hecheng "自分で言うのも何だけど、"


translate japanese plot7_a7868ddf:



    voice "voice/hecheng_124.ogg"
    hecheng "うちはそれなりにお金もあるし、私もクラスじゃ地位のある方。"


translate japanese plot7_ff33db52:



    voice "voice/hecheng_125.ogg"
    hecheng "날 싫어하는 사람은 많아도 괴롭힐 배짱은 없어."


translate japanese plot7_57fbd1f0:



    voice "voice/hecheng_126.ogg"
    hecheng "ただ…今回は、そいつらはいい度胸を持ってるとは思わなかったけど。"


translate japanese plot7_35c6eccf:



    voice "voice/tianqin_1425.ogg"
    tianqin "누가 했는지 벌써 알아냈어?"


translate japanese plot7_406c93ec:



    voice "voice/hecheng_127.ogg"
    hecheng "……아직."


translate japanese plot7_3acb080e:



    voice "voice/hecheng_128.ogg"
    hecheng "요 며칠 학교 CCTV를 조사하게 했어. 하지만 아직 범인은 못 찾았어."


translate japanese plot7_68bfbb95_1:



    voice "voice/tianqin_1426.ogg"
    tianqin "그렇구나…"


translate japanese plot7_64ba9144:



    voice "voice/hecheng_129.ogg"
    hecheng "어차피 언젠가는 단서가 나오겠지."


translate japanese plot7_b35aaee6:



    voice "voice/hecheng_130.ogg"
    hecheng "見つけたら、絶対に許さない。"


translate japanese plot7_27168d87:



    voice "voice/tianqin_1427.ogg"
    tianqin "정말 도움이 필요하면 꼭 말해 줘."


translate japanese plot7_2eaeaa8b:



    voice "voice/hecheng_131.ogg"
    hecheng "ライラの方が、私より緊張してるじゃない。"


translate japanese plot7_95a723a9:



    voice "voice/hecheng_132.ogg"
    hecheng "오히려 그게 궁금한데. 왜 내가 괴롭힘을 당한다고 생각했어?"


translate japanese plot7_dd6c557e:



    voice "voice/tianqin_1428.ogg"
    tianqin "선생님한테 괴롭힘을 신고하는 편지가 왔다고 해서……"


translate japanese plot7_e2cf1337:



    voice "voice/hecheng_133.ogg"
    hecheng "뭐? 네가 어떻게 알아?"


translate japanese plot7_322febf9:



    voice "voice/tianqin_1429.ogg"
    tianqin "아, 그게…… 담임 선생님한테 혼나다가 우연히 들었어."


translate japanese plot7_65f1e8db_1:




    hecheng "…"


translate japanese plot7_61eb0669:



    voice "voice/tianqin_1430.ogg"
    tianqin "츠루기, 그 편지 네가 쓴 거야? 내가 도울 일 있어?"


translate japanese plot7_5c801991:



    voice "voice/hecheng_135.ogg"
    hecheng "아니, 그런 얘기는 몰라."


translate japanese plot7_776cd2e0:



    voice "voice/hecheng_136.ogg"
    hecheng "ライラ。私のことには、もうこれ以上関わらないで。"


translate japanese plot7_c759cdd5:



    voice "voice/hecheng_137.ogg"
    hecheng "先生にも何も言わないで…私の問題は、自分で片づける。"


translate japanese plot7_88929523:



    voice "voice/tianqin_1431.ogg"
    tianqin "츠루기……"


translate japanese plot7_7c282927:



    voice "voice/hecheng_138.ogg"
    hecheng "ほかに用がないなら、先に戻る。"


translate japanese plot7_2faaddc3:


    tianqin "잠깐, 츠루기!"


translate japanese plot7_e60c48d9:



    voice "voice/tianqin_1433.ogg"
    tianqin "……가 버렸네."


translate japanese plot7_9ebec0fd:



    voice "voice/yangxi_399.ogg"
    yangxi "음…… 라이라, 괜찮을까……"


translate japanese plot7_df3e0070:


    "라이라와 츠루기가 나간 뒤 히나타는 초조하게 휴대폰을 만지작거리며 라이라의 연락을 기다렸다."


translate japanese plot7_0556dbdd:



    voice "voice/yangxi_400.ogg"
    yangxi "——왔다."


translate japanese plot7_a0e49129:


    "알림이 울리자 히나타는 서둘러 화면 잠금을 풀었다."


translate japanese plot7_5a6d184e:


    voice "voice/tianqin_1434.ogg"
    tianqin3 0110 "「늘 만나던 곳으로 와.」"


translate japanese plot7_da84deb5:



    voice "voice/yangxi_401.ogg"
    yangxi "괜찮은가 보네."


translate japanese plot7_a0a19017:



    voice "voice/yangxi_402.ogg"
    yangxi "안녕."


translate japanese plot7_5c8b824a:



    voice "voice/tianqin_1435.ogg"
    tianqin "으음——"


translate japanese plot7_0efd3c38:



    voice "voice/yangxi_403.ogg"
    yangxi "어땠어? 뭐 좀 들었어?"


translate japanese plot7_d5401c8d:



    voice "voice/tianqin_1436.ogg"
    tianqin "아니. 츠루기가…… 이 얘기를 피하는 것 같아."


translate japanese plot7_8760e890:



    voice "voice/yangxi_404.ogg"
    yangxi "피한다고? 무슨 얘기를 했는데?"


translate japanese plot7_28391c97:



    voice "voice/tianqin_1437.ogg"
    tianqin "음—— 처음에는 몸이 어떠냐고 물었더니 좀 나아졌대."


translate japanese plot7_00f475b5:



    voice "voice/yangxi_405.ogg"
    yangxi "그다음은?"


translate japanese plot7_dc8b99ee:



    voice "voice/tianqin_1438.ogg"
    tianqin "그다음엔 다른 애들한테 괴롭힘을 당하냐고 물었어."


translate japanese plot7_aa73d8da:



    voice "voice/yangxi_406.ogg"
    yangxi "돌려 물을 거라곤 기대 안 했지만, 그래도 너무 직설적이지 않아?"


translate japanese plot7_40495aed:



    voice "voice/tianqin_1439.ogg"
    tianqin "츠루기는 빙빙 돌려 묻는 걸 더 싫어할 것 같아서 분명하게 물었어."


translate japanese plot7_b29a9928:



    voice "voice/tianqin_1440.ogg"
    tianqin "츠루기도 아무한테도 괴롭힘을 당하지 않는다고 분명하게 말했어……"


translate japanese plot7_5cef35d9:



    voice "voice/tianqin_1441.ogg"
    tianqin "다만 그 일을 누가 했는지는 아직 모르는 것 같아."


translate japanese plot7_3b3bbc0d:



    voice "voice/yangxi_407.ogg"
    yangxi "「되갚아 줄」 생각인가 보네."


translate japanese plot7_88fb079f:



    voice "voice/tianqin_1442.ogg"
    tianqin "그리고 선생님한테 온 편지도 자기가 쓴 건지 물었는데……"


translate japanese plot7_08f7c5ff:



    voice "voice/yangxi_408.ogg"
    yangxi "정말 끝까지 직설적이네."


translate japanese plot7_fbf09210:



    voice "voice/tianqin_1443.ogg"
    tianqin "진짜 어떻게 된 건지 알고 싶었으니까!"


translate japanese plot7_97042a1c:



    voice "voice/tianqin_1444.ogg"
    tianqin "그런데 편지 얘기를 꺼내자마자 태도가 변했어. 갑자기 얼버무리더니 마지막에는 자기 일에 끼어들지 말래."


translate japanese plot7_9e4a4696:



    voice "voice/tianqin_1445.ogg"
    tianqin "왠지…… 남의 도움을 받고 싶지 않은 것 같아."


translate japanese plot7_6855f03f:



    voice "voice/yangxi_409.ogg"
    yangxi "……재밌는 반응이네."


translate japanese plot7_cd5feb79:



    voice "voice/tianqin_1446.ogg"
    tianqin "넌 어떻게 생각해, 히나타?"


translate japanese plot7_09356299:



    voice "voice/yangxi_410.ogg"
    yangxi "그 편지, 츠루기가 쓴 것 같아."


translate japanese plot7_65055994:



    voice "voice/tianqin_1447.ogg"
    tianqin "어? 왜?"


translate japanese plot7_d04b6a13:



    voice "voice/yangxi_411.ogg"
    yangxi "もし手紙を知らなかったなら、話を聞いても「何それ」で終わる。ライラを避ける理由はない。"


translate japanese plot7_71ae917f:



    voice "voice/yangxi_412.ogg"
    yangxi "それに、態度が変わったのは手紙を口にしてから。知ってるって自白してるようなものでしょ。"


translate japanese plot7_37878968:



    voice "voice/tianqin_1448.ogg"
    tianqin "그, 그런가…… 그럴지도."


translate japanese plot7_6997b685:



    voice "voice/tianqin_1449.ogg"
    tianqin "하지만 그럼 태도랑 편지가 모순되지 않아……?"


translate japanese plot7_cb42d429:



    voice "voice/tianqin_1450.ogg"
    tianqin "도움을 받고 싶어서 편지를 쓴 거잖아?"


translate japanese plot7_2aafb7ac:



    voice "voice/tianqin_1451.ogg"
    tianqin "그런데 왜 나를 피하지?"


translate japanese plot7_86aac1ed:



    voice "voice/yangxi_413.ogg"
    yangxi "……자존심이 방해하는 것 같아."


translate japanese plot7_714d7359:



    voice "voice/tianqin_1452.ogg"
    tianqin "자존심?"


translate japanese plot7_8e7817a2:



    voice "voice/yangxi_414.ogg"
    yangxi "응, 자존심."


translate japanese plot7_10ad6205:



    voice "voice/yangxi_415.ogg"
    yangxi ""


translate japanese plot7_1934df7f:



    voice "voice/yangxi_416.ogg"
    yangxi "츠루기 입장에서는 네가 도우려 할수록 자존심이 상해."


translate japanese plot7_d67d65d0:



    voice "voice/yangxi_417.ogg"
    yangxi "助けじゃなくて、同情されてるように感じるから。"


translate japanese plot7_9bb88cbc:



    voice "voice/yangxi_418.ogg"
    yangxi "특히 편지 얘기까지 본인한테 했잖아…… 츠루기는 네가 편지의 존재를 몰랐으면 했을 거야."


translate japanese plot7_5c730bb3:



    voice "voice/tianqin_1453.ogg"
    tianqin "그럼 대체……"


translate japanese plot7_3e56fc98:



    voice "voice/yangxi_419.ogg"
    yangxi "まだ全部は分からない。鶴城の性格と、今ある情報から考えてるだけ。"


translate japanese plot7_ea693a19:



    voice "voice/yangxi_420.ogg"
    yangxi 0101 "まず、鶴城の反応を見る限り、手紙のことは絶対に知ってる。"


translate japanese plot7_5a78e194:



    voice "voice/yangxi_421.ogg"
    yangxi "あんな目に遭うのは初めてだっただろうし、怖かったんじゃない。"


translate japanese plot7_3f6e484a:


    voice "voice/yangxi_422.ogg"
    yangxi 0104 "도움은 받고 싶어. 하지만 고집 세고 피곤한 성격이 그걸 허락하지 않는 거야."


translate japanese plot7_7cf8516e:


    yangxi 0101 "人に隠れて助けてもらいたい。弱いところは絶対に見せたくない。"


translate japanese plot7_0ec38747:



    voice "voice/yangxi_424.ogg"
    yangxi "그래서 편지로 담임한테 사정을 알리고, 겸사겸사 범인한테 경고도 하려 한 거야."


translate japanese plot7_bbcfd56e:



    voice "voice/tianqin_1454.ogg"
    tianqin "그럼 더더욱 도와줘야지."


translate japanese plot7_0cf84da4:



    voice "voice/yangxi_425.ogg"
    yangxi "바보야. 도우려 할수록 널 피할 거라고 했잖아."


translate japanese plot7_02d4b783:



    voice "voice/tianqin_1455.ogg"
    tianqin "아…… 그럼 어떡해?"


translate japanese plot7_16ba85b0:



    voice "voice/yangxi_426.ogg"
    yangxi "先に担任に報告して。"


translate japanese plot7_49832492:



    voice "voice/yangxi_427.ogg"
    yangxi "츠루기는 더 안 찾아가는 게 좋겠어. 그렇게 거절하는데도 계속 다가가면 정말 싫어할 거야."


translate japanese plot7_b1d11654:



    voice "voice/tianqin_1456.ogg"
    tianqin "으…… 알겠어."


translate japanese plot7_671799d0:



    voice "voice/banzhuren_110.ogg"
    banzhuren "うん…鶴城はそう言ったのか…"


translate japanese plot7_d430ebcd:



    voice "voice/tianqin_1457.ogg"
    tianqin "선생님, 전 이제 어떻게 해야 해요?"


translate japanese plot7_e13a68bd:



    voice "voice/banzhuren_111.ogg"
    banzhuren "당분간은 츠루기를 찾아가지 않는 게 좋겠어."


translate japanese plot7_55113f34:



    voice "voice/tianqin_1458.ogg"
    tianqin "하지만…"


translate japanese plot7_e7e289e6:



    voice "voice/banzhuren_112.ogg"
    banzhuren "돕고 싶은 마음은 알아. 하지만 이럴 때 지나친 열의는 해결에 방해가 된단다."


translate japanese plot7_83580cbb:



    voice "voice/banzhuren_113.ogg"
    banzhuren "이제부터는 내게 맡겨. 누가 편지를 썼는지 알면 어떻게 움직여야 할지도 보이니까."


translate japanese plot7_2a8cb367:



    voice "voice/banzhuren_114.ogg"
    banzhuren "며칠 동안 반에서도 이런 이야기를 하면서, 그런 무리가 함부로 행동하기 어려운 분위기를 만들 거야."


translate japanese plot7_8dba180e:



    voice "voice/tianqin_1459.ogg"
    tianqin "그러면 츠루기가 눈치채지 않을까요?"


translate japanese plot7_c2d34a6d:



    voice "voice/banzhuren_115.ogg"
    banzhuren "걱정 마. 이 일이라는 걸 바로 알 만한 식으로 말하지는 않을 테니까."


translate japanese plot7_21d17697:



    voice "voice/banzhuren_116.ogg"
    banzhuren "츠루기도 그러길 바라서 편지를 쓴 거야. 내게 도와 달라고 한 거지."


translate japanese plot7_ab5391d1:



    voice "voice/banzhuren_117.ogg"
    banzhuren "나중에 내가 따로 얘기도 해 볼게."


translate japanese plot7_be8753ec:



    voice "voice/tianqin_1460.ogg"
    tianqin "음…… 제가 더 할 수 있는 일은 없을까요?"


translate japanese plot7_2423a1cf:



    voice "voice/banzhuren_118.ogg"
    banzhuren "충분해. 도우려 해 준 마음만으로도 고맙단다."


translate japanese plot7_7b82b596:



    voice "voice/banzhuren_119.ogg"
    banzhuren "다만 금방 해결할 수는 없어. 학생들 사이의 괴롭힘이라면 더더욱."


translate japanese plot7_98557a70:



    voice "voice/banzhuren_120.ogg"
    banzhuren "焦って動けば、鶴城が心を閉ざすかもしれない。そうなったら二度と人に助けを求めなくなるし、いじめる側の思う通りになった。"


translate japanese plot7_3e11d715:



    voice "voice/banzhuren_121.ogg"
    banzhuren "더 신중하게 접근해야 해. 라이라, 이번에는 내 말대로 당분간 츠루기를 찾아가지 마."


translate japanese plot7_21f9397f:



    voice "voice/tianqin_1461.ogg"
    tianqin "わかりました…何か手伝えることがあったら、いつでも言ってくださいね。"


translate japanese plot7_b3ae1a8a:



    voice "voice/banzhuren_122.ogg"
    banzhuren "그렇다면 있지."


translate japanese plot7_b613af0d:



    voice "voice/tianqin_1462.ogg"
    tianqin "어? 뭔데요?"


translate japanese plot7_2319b5a8:



    voice "voice/banzhuren_123.ogg"
    banzhuren "땡땡이치지 말고 수업에 꼬박꼬박 나오렴."


translate japanese plot7_b0331d35:



    voice "voice/tianqin_1463.ogg"
    tianqin ""


translate japanese plot7_062ca8a8:



    voice "voice/banzhuren_124.ogg"
    banzhuren "적어도 날 속인다는 생각으로라도 좀 더 단호하게 말해 주렴!"


translate japanese plot7_8e7ce314:


    "딩동댕동――"


translate japanese plot7_7076724d:



    voice "voice/banzhuren_125.ogg"
    banzhuren "자, 교실로 돌아가서 수업 들어."


translate japanese plot7_b01d0596:



    voice "voice/banzhuren_126.ogg"
    banzhuren "너무 걱정하지 않아도 돼. 이제부터는 우리 선생님들 일이야."


translate japanese plot7_7ef6be5c:



    voice "voice/tianqin_1464.ogg"
    tianqin "……네."


translate japanese plot7_f3ec2c3b:



    voice "voice/banzhuren_127.ogg"
    banzhuren "…"


translate japanese plot7_99eb191f:



    voice "voice/jinlaoshi_54.ogg"
    jinlaoshi "이걸로 잘 해결될까요?"


translate japanese plot7_4a05d9ba:



    voice "voice/banzhuren_128.ogg"
    banzhuren "김 선생님, 듣고 있었어요?"


translate japanese plot7_3f517dad:



    voice "voice/jinlaoshi_55.ogg"
    jinlaoshi "아, 일부러 엿들은 건 아니에요."


translate japanese plot7_fb548b1d:



    voice "voice/banzhuren_129.ogg"
    banzhuren "뭐, 괜찮아요. 이 얘기는 부장님께 하지 말아 주세요."


translate japanese plot7_63742136:



    voice "voice/jinlaoshi_56.ogg"
    jinlaoshi "안 할게요——"


translate japanese plot7_91da990f:



    voice "voice/jinlaoshi_57.ogg"
    jinlaoshi "그런데 피해자가 츠루기였다니……"


translate japanese plot7_fb25554d:



    voice "voice/banzhuren_130.ogg"
    banzhuren 0105 "사실 처음부터 츠루기가 쓴 편지 아닐까 싶었어요…… 라이라에게 확인만 부탁한 거죠."


translate japanese plot7_625c06a2:



    voice "voice/banzhuren_131.ogg"
    banzhuren 0104 "先週、クラスの誰かが鶴城にひどいいたずらをした。その直後にあの手紙が届いたんだから、結びつけない方が難しい。"


translate japanese plot7_3f34940a:



    voice "voice/jinlaoshi_58.ogg"
    jinlaoshi 0102 "그런 일까지 있었군요……"


translate japanese plot7_db25c5e0:



    voice "voice/banzhuren_132.ogg"
    banzhuren 0103 "이 학교는 학생들 사이의 대립이 심하니까요. 집안 배경이 있는 아이들이 워낙 많아서."


translate japanese plot7_c4e19dde:



    voice "voice/banzhuren_133.ogg"
    banzhuren "그런데 김 선생님은 이 일에 관심이 많으시네요. 무슨 의견이라도 있어요?"


translate japanese plot7_aabc0dd8:



    voice "voice/jinlaoshi_59.ogg"
    jinlaoshi "아, 그게……"


translate japanese plot7_446f6655:



    voice "voice/jinlaoshi_60.ogg"
    jinlaoshi "私が赴任したばかりの頃、去年の体育生の間でいじめがあったって噂を聞きましたよね？"


translate japanese plot7_dc3fe248:



    voice "voice/jinlaoshi_61.ogg"
    jinlaoshi "실종된 체육 특기생 말이에요……"


translate japanese plot7_e820d0ec:



    voice "voice/banzhuren_134.ogg"
    banzhuren "ああ、あったね。"


translate japanese plot7_b2d9977a:



    voice "voice/banzhuren_135.ogg"
    banzhuren "結局、あれはただの噂だった。行方不明の事件をきっかけに、話だけが広がったみたい。"


translate japanese plot7_f778a993:



    voice "voice/banzhuren_136.ogg"
    banzhuren "하지만 담당 체육 선생님은 여기저기서 압박을 받다가 그만두셨죠…… 그건 아시죠?"


translate japanese plot7_3d004c65:



    voice "voice/jinlaoshi_62.ogg"
    jinlaoshi "네. 그분이 그만두셔서 제가 이 학교에 오게 됐으니까요."


translate japanese plot7_cbed1d99:



    voice "voice/jinlaoshi_63.ogg"
    jinlaoshi "그러니 츠루기에게 이런 일이 생겼다니 걱정이 돼요."


translate japanese plot7_b50d953d:



    voice "voice/banzhuren_137.ogg"
    banzhuren "괜찮아요. 김 선생님, 제게 맡겨 주세요."


translate japanese plot7_fe7029a9:



    voice "voice/banzhuren_138.ogg"
    banzhuren "츠루기와 제대로 이야기해 볼게요."


translate japanese plot7_f3ec2c3b_1:



    voice "voice/banzhuren_139.ogg"
    banzhuren "…"


translate japanese plot7_ef092ae2:



    voice "voice/banzhuren_140.ogg"
    banzhuren "（그 편지는 정말 츠루기가 쓴 걸까…）"


translate japanese plot7_44194a10:



    voice "voice/banzhuren_141.ogg"
    banzhuren "（뭔가 이상한데… 어디가 걸리는 거지…）"


translate japanese plot7_1a4a83bf:



    voice "voice/banzhuren_142.ogg"
    banzhuren "（츠루기… 우선 직접 얘기해 보자.）"


translate japanese plot7_a26ca59c:



    voice "voice/tianqin_1465.ogg"
    tianqin "아아…… 이제 내가 나설 일은 없나 봐."


translate japanese plot7_ef529b64:



    voice "voice/yangxi_428.ogg"
    yangxi "잘된 거 아냐?"


translate japanese plot7_2cc3ddd7:



    voice "voice/tianqin_1466.ogg"
    tianqin "음…… 그렇긴 한데……"


translate japanese plot7_568152c3:



    voice "voice/yangxi_429.ogg"
    yangxi "너무 생각하지 말고 수업이나 잘 들어."


translate japanese plot7_414534e9:



    voice "voice/tianqin_1467.ogg"
    tianqin "싫어! 학교에서 할 일도 없으니까 우리 「그거」 하자!"


translate japanese plot7_15c3b995:



    voice "voice/yangxi_430.ogg"
    yangxi "「그거」 말이지."


translate japanese plot7_681183af:



    voice "voice/tianqin_1468.ogg"
    tianqin "맞아! 오랜만에 「그거」!"


translate japanese plot7_a5b6143c:



    voice "voice/tianqin_1469.ogg"
    tianqin "반장도 데리고!"


translate japanese plot7_dc1cbc70:



    voice "voice/yangxi_431.ogg"
    yangxi "あの子は断ると思うけど…"


translate japanese plot7_1eaa290f:



    voice "voice/tianqin_1470.ogg"
    tianqin "大丈夫！　私に任せて！"


translate japanese plot7_4fd22d10:



    voice "voice/banzhang_138.ogg"
    banzhang "（음… 다음은 수학이네…）"


translate japanese plot7_ecc4ead8:



    voice "voice/tianqin_1471.ogg"
    tianqin "반장! 이따 아무 일 없지!"


translate japanese plot7_d890b69f:



    voice "voice/banzhang_139.ogg"
    banzhang "네? 이따요? 수, 수업 듣기요?"


translate japanese plot7_6d414b9a:



    voice "voice/tianqin_1472.ogg"
    tianqin "그럼 가자!"


translate japanese plot7_dd2fddfe:



    voice "voice/banzhang_140.ogg"
    banzhang "네? 뭘요?"


translate japanese plot7_7afe825d:



    voice "voice/tianqin_1473.ogg"
    tianqin "같이 놀러 가자!"


translate japanese plot7_fc88aedc:



    voice "voice/banzhang_141.ogg"
    banzhang "자, 잠깐만요, 라이라 씨. 아직 오전 두 번째 수업이잖아요……?"


translate japanese plot7_3cb34221:



    voice "voice/tianqin_1474.ogg"
    tianqin "まあまあ、一日くらいサボっても大したことないって。"


translate japanese plot7_3644bccf:



    voice "voice/banzhang_142.ogg"
    banzhang "쉿!"


translate japanese plot7_5cb695bc:


    "반장은 다른 학생들이 「계획」을 듣지 못하도록 서둘러 라이라를 교실 구석으로 끌고 갔다."


translate japanese plot7_ed07b763:



    voice "voice/banzhang_143.ogg"
    banzhang "잠깐만요. 생각 좀 정리할게요."


translate japanese plot7_90bf51bb:



    voice "voice/banzhang_144.ogg"
    banzhang "라이라 씨는 조퇴하고 싶다는 거예요……?"


translate japanese plot7_d0af9438:



    voice "voice/tianqin_1475.ogg"
    tianqin "어? 아니. 땡땡이치는 거야."


translate japanese plot7_3cc189db:



    voice "voice/banzhang_145.ogg"
    banzhang "어어어!?"


translate japanese plot7_e13c0298:


    "너무나 당당한 대답에 반장은 할 말을 잃었다."


translate japanese plot7_3f097a3e:


    "게다가 반장은 방금 전 라이라가 교무실에서 담임에게 「이제 수업 안 빼먹겠다」고 약속한 사실조차 몰랐다."


translate japanese plot7_d9d622de:


    voice "voice/banzhang_146.ogg"
    banzhang 0102 "저도 같이…… 가자는 거예요?"


translate japanese plot7_bfc9dffa:



    voice "voice/tianqin_1476.ogg"
    tianqin "응. 다음 수학이잖아."


translate japanese plot7_3472a971:



    voice "voice/banzhang_147.ogg"
    banzhang "저기…… 수학이라서요……?"


translate japanese plot7_47778a74:


    "반장은 라이라의 논리를 도무지 이해할 수 없었다. 수학과 땡땡이에 무슨 관계가 있단 말인가."


translate japanese plot7_742a0bae:


    "그런데 라이라가 말하면 이상하게 전부 말이 되는 것처럼 들렸다."


translate japanese plot7_655b9d6b:



    voice "voice/tianqin_1477.ogg"
    tianqin "자, 자, 가자. 히나타가 저기서 기다려."


translate japanese plot7_b823378e:



    voice "voice/banzhang_148.ogg"
    banzhang "네? 히나타 씨도……?"


translate japanese plot7_06b1f8e5:


    "라이라에게 이끌려 고개를 돌리자, 벌써 가방을 멘 히나타가 복도에서 손을 흔들고 있었다."


translate japanese plot7_a0a19017_1:



    voice "voice/yangxi_432.ogg"
    yangxi "안녕."


translate japanese plot7_b705f229:



    voice "voice/tianqin_1478.ogg"
    tianqin "이제 곧 수업 시작해. 빨리 가자."


translate japanese plot7_64503711:



    voice "voice/banzhang_149.ogg"
    banzhang "잠깐, 잠깐만요! 라이라 씨, 아직 짐이——"


translate japanese plot7_529f1da9:



    voice "voice/banzhang_150.ogg"
    banzhang "에에에에————!?"


translate japanese plot7_c689e88e:


    "반장이 상황을 파악하기도 전에 라이라는 가방까지 챙겨 반장을 교실 밖으로 끌고 나갔다."


translate japanese plot7_e2514d03:


    "그렇게 갑자기 학교를 빠져나온 세 사람은 근처 상점가로 향했다."


translate japanese plot7_370c6823:



    voice "voice/yangxi_433.ogg"
    yangxi "으음——"


translate japanese plot7_0a4a69ee:


    "히나타는 근처 벤치에 앉아 휴대폰 화면을 넘기며 시간을 보내고 있었다."


translate japanese plot7_65bce57a:



    voice "voice/yangxi_434.ogg"
    yangxi "（아, 이 옷 이번 달에 나오네.）"


translate japanese plot7_a20c33a0:



    voice "voice/tianqin_1479.ogg"
    tianqin "자, 밀크티."


translate japanese plot7_a22227fe:



    voice "voice/yangxi_435.ogg"
    yangxi "땡큐."


translate japanese plot7_90083442:



    voice "voice/tianqin_1480.ogg"
    tianqin "그 말, 이미 유행 지난 거 아냐?"


translate japanese plot7_ae30d056:



    voice "voice/yangxi_436.ogg"
    yangxi "내가 쓰는 한 유행이 지난 게 아니야."


translate japanese plot7_b17892ea:



    voice "voice/tianqin_1481.ogg"
    tianqin "쳇, 억지 부리기는."


translate japanese plot7_fa3d4b22:



    voice "voice/tianqin_1482.ogg"
    tianqin "뭐 봐?"


translate japanese plot7_1512aae5:



    voice "voice/yangxi_437.ogg"
    yangxi "もうすぐ発売される服。"


translate japanese plot7_d58121e2:


    "히나타가 라이라 앞에 휴대폰을 내밀었다. 화면에는 줄곧 갖고 싶었던 옷이 떠 있었다."


translate japanese plot7_84e50a9d:



    voice "voice/tianqin_1483.ogg"
    tianqin "아, 전에 말한 거구나."


translate japanese plot7_052881f1:



    voice "voice/yangxi_438.ogg"
    yangxi "선물해 주겠다는 뜻이야?"


translate japanese plot7_205155a8:



    voice "voice/tianqin_1484.ogg"
    tianqin "나 아직 아무 말도 안 했거든!"


translate japanese plot7_42edcf2b:



    voice "voice/banzhang_00150.ogg"
    banzhang2 "ライラさーん、ヒナタさーん。"


translate japanese plot7_cedf1df8:



    voice "voice/banzhang_151.ogg"
    banzhang "すみませーん、お待たせしました。"


translate japanese plot7_1115f18b:



    voice "voice/tianqin_1485.ogg"
    tianqin "어! 괜찮아. 우리도 방금 왔어."


translate japanese plot7_3f6649c0:



    voice "voice/tianqin_1486.ogg"
    tianqin "자, 반장 밀크티."


translate japanese plot7_09fa98ee:



    voice "voice/banzhang_152.ogg"
    banzhang "아, 고마워요."


translate japanese plot7_24755c2e:



    voice "voice/banzhang_153.ogg"
    banzhang "죄송해요…… 집에 가서 옷을 갈아입지 않으면 영 마음이 안 놓여서요."


translate japanese plot7_d95f19b6:



    voice "voice/tianqin_1487.ogg"
    tianqin "이해해. 이런 시간에 교복 입고 돌아다니면 온 세상에 땡땡이친다고 알리는 거나 다름없지."


translate japanese plot7_a57a85a5:



    voice "voice/banzhang_154.ogg"
    banzhang "맞아요! 딱 그런 기분이에요!"


translate japanese plot7_3200cc6c:



    voice "voice/banzhang_155.ogg"
    banzhang "학교를 빼먹다니, 제게는 너무 자극적이에요……"


translate japanese plot7_30d8db76:



    voice "voice/yangxi_439.ogg"
    yangxi "뭐, 처음에는 죄책감이 꽤 들지."


translate japanese plot7_112aff14:



    voice "voice/yangxi_440.ogg"
    yangxi "네다섯 번 하면 아무렇지도 않아져."


translate japanese plot7_4434c825:



    voice "voice/banzhang_156.ogg"
    banzhang "어제는 두 분을 따라 하면 안 된다고 하셨잖아요……"


translate japanese plot7_7a393543:



    voice "voice/tianqin_1488.ogg"
    tianqin "아, 아하하…… 미안해, 반장. 이렇게 억지로 데리고 나와서."


translate japanese plot7_fbdc26fc:



    voice "voice/tianqin_1489.ogg"
    tianqin "한 번쯤은 해 봤으면 해서 그랬지——"


translate japanese plot7_4f5874dd:



    voice "voice/banzhang_157.ogg"
    banzhang "그래도 걱정돼요. 선생님께 분명 들키겠죠?"


translate japanese plot7_958cab1b:



    voice "voice/yangxi_441.ogg"
    yangxi "大丈夫。もともと私とライラはよくサボるし、一人二人いなくなったって先生は気づかない。"


translate japanese plot7_91457d80:



    voice "voice/yangxi_442.ogg"
    yangxi "물어보면 핑계는 얼마든지 있어. 보건실에 갔다거나 다른 선생님 일을 도왔다거나."


translate japanese plot7_bc589cd8:



    voice "voice/yangxi_443.ogg"
    yangxi "너는 체육 특기생이니까 체육 선생님이 불러서 훈련하러 가는 일도 많잖아."


translate japanese plot7_7fb8fb52:



    voice "voice/banzhang_158.ogg"
    banzhang "그럴지도 모르지만……"


translate japanese plot7_3e0c2d1a:



    voice "voice/tianqin_1490.ogg"
    tianqin "자, 자! 반장, 너무 생각하지 마! 오늘은 쉬는 날이라고 생각하고 즐기자!"


translate japanese plot7_cbe81924:



    voice "voice/tianqin_1491.ogg"
    tianqin "그래서 두 분! 오늘은 어디서 놀고 싶으신가요?"


translate japanese plot7_06e55d80:



    voice "voice/yangxi_444.ogg"
    yangxi "글쎄."


translate japanese plot7_0b09c6fe:



    voice "voice/banzhang_159.ogg"
    banzhang "갑자기 나오게 돼서 저도 아직 생각을 못 했어요."


translate japanese plot7_23aeba0c:



    voice "voice/tianqin_1492.ogg"
    tianqin "어, 그래? 사실 나도 좋은 생각은 없는데……"


translate japanese plot7_f9916ffc:



    voice "voice/yangxi_445.ogg"
    yangxi "じゃあ。誰も行きたいところがないなら、今日は解散。"


translate japanese plot7_e359306f:



    voice "voice/yangxi_446.ogg"
    yangxi "수고했어. 안녕."


translate japanese plot7_e330808c:



    voice "voice/banzhang_160.ogg"
    banzhang "네에!?"


translate japanese plot7_56976b09:



    voice "voice/tianqin_1493.ogg"
    tianqin "그게 아니지, 히나타! 오늘은 반장 데리고 놀러 가려고 땡땡이친 거잖아!?"


translate japanese plot7_52716e79:



    voice "voice/yangxi_447.ogg"
    yangxi "でも全員行きたい場所がないなら、家に帰るのが一番楽でしょ。"


translate japanese plot7_ff46c102:



    voice "voice/tianqin_1494.ogg"
    tianqin "하아, 이 집순이."


translate japanese plot7_c294a25e:



    voice "voice/tianqin_1495.ogg"
    tianqin "インドア…インドア…"


translate japanese plot7_b1174d08:



    voice "voice/tianqin_1496.ogg"
    tianqin "노래방 갈래?"


translate japanese plot7_64c948d8:



    voice "voice/yangxi_448.ogg"
    yangxi "{a=dictionary:dict_entry_73}노래방{/a}이라……"


translate japanese plot7_47ba29dd:



    voice "voice/tianqin_1497.ogg"
    tianqin "응. 생각해 보니까 노래하러 안 간 지 꽤 됐잖아."


translate japanese plot7_09a5a029:



    voice "voice/yangxi_449.ogg"
    yangxi "言われてみれば…確かに、かなり久しぶり。"


translate japanese plot7_420cefd1:



    voice "voice/tianqin_1498.ogg"
    tianqin "그렇지!"


translate japanese plot7_940179a4:



    voice "voice/banzhang_161.ogg"
    banzhang "그런데…… 노래방은 저희 나이에도 들어갈 수 있나요?"


translate japanese plot7_7e7b807a:



    voice "voice/tianqin_1499.ogg"
    tianqin "괜찮아, 반장."


translate japanese plot7_67f4090f:



    voice "voice/tianqin_1500.ogg"
    tianqin "우리가 가는 곳은 그런 험한 가게 아냐. 고등학생도 괜찮아."


translate japanese plot7_caa72a51:



    voice "voice/banzhang_162.ogg"
    banzhang "그, 그런가요?"


translate japanese plot7_cfbed9bb:



    voice "voice/tianqin_1501.ogg"
    tianqin "가 보면 알아."


translate japanese plot7_658c37de:


    "라이라와 히나타는 반장을 상점가의 노래방 체인점으로 데려갔다."


translate japanese plot7_bf7983ab:


    "반장은 매일 등하교하면서 이 가게 앞을 지나다녔다. 하지만 직접 안으로 들어갈 날이 올 줄은 몰랐다."


translate japanese plot7_87a25be8:


    "반장에게 노래방은 불량배와 술, 위험한 것들이 가득한 곳이었다."


translate japanese plot7_516abc69:



    voice "voice/tianqin_1502.ogg"
    tianqin "직원한테 물어보니까 작은 방은 다 찼대."


translate japanese plot7_a9506560:



    voice "voice/tianqin_1503.ogg"
    tianqin "큰 방으로 할까?"


translate japanese plot7_c179966d:



    voice "voice/yangxi_450.ogg"
    yangxi "いいんじゃない。今は空いてる時間だし、そんなに高くない。"


translate japanese plot7_0328c3d8:



    voice "voice/banzhang_163.ogg"
    banzhang "두 분께 맡길게요……"


translate japanese plot7_58abe7da:



    voice "voice/tianqin_1504.ogg"
    tianqin "좋아. 방 잡고 올 테니까 둘은 먼저 들어가 있어."


translate japanese plot7_be18e4a3:



    voice "voice/yangxi_451.ogg"
    yangxi "가자, 반장. 안내해 줄게."


translate japanese plot7_32bff516:



    voice "voice/banzhang_164.ogg"
    banzhang "아, 네……"


translate japanese plot7_9bc61127:



    voice "voice/banzhang_165.ogg"
    banzhang "와……"


translate japanese plot7_a576ae26:


    "예상과 달리 노래방 안은 아주 깨끗했다."


translate japanese plot7_0dced8db:


    "마이크와 무료 과자가 탁자 위에 가지런히 놓여 있었고, 불쾌한 냄새도 없었다."


translate japanese plot7_b5069f57:



    voice "voice/tianqin_1505.ogg"
    tianqin "자, 반장. 앉아."


translate japanese plot7_df9bd45d:



    voice "voice/banzhang_166.ogg"
    banzhang "네."


translate japanese plot7_d0f910e4:



    voice "voice/tianqin_1506.ogg"
    tianqin "노래방 처음이지?"


translate japanese plot7_6914e0ec:



    voice "voice/banzhang_167.ogg"
    banzhang "아, 네. 맞아요."


translate japanese plot7_85c22eaa:



    voice "voice/tianqin_1507.ogg"
    tianqin "어때?"


translate japanese plot7_e3df72bc:



    voice "voice/banzhang_168.ogg"
    banzhang "생각했던 것과 많이 달라요. 노래방은 좀 더 어수선한 곳인 줄 알았어요……"


translate japanese plot7_5a3aa18a:



    voice "voice/tianqin_1508.ogg"
    tianqin "아하하, 그건 아주 옛날 얘기야."


translate japanese plot7_b040cc37:



    voice "voice/tianqin_1509.ogg"
    tianqin "예전에는 노래방 규정도 제대로 안 잡혔고 법적으로 모호한 구석이 많아서 별로 안전하지 않았지."


translate japanese plot7_0b7ff11b:



    voice "voice/tianqin_1510.ogg"
    tianqin "하지만 지금은 정비가 잘돼서 체인점이면 평범하게 놀러 오는 곳이야."


translate japanese plot7_ce1cd368:



    voice "voice/banzhang_169.ogg"
    banzhang "그렇군요……"


translate japanese plot7_3ed4e650:



    voice "voice/banzhang_170.ogg"
    banzhang "二人に連れてきてもらわなかったら、今のカラオケがどんな場所か、ずっと知らないままだったかもしれません。"


translate japanese plot7_83edbdc1:



    voice "voice/yangxi_452.ogg"
    yangxi "자, 자. 아직 감상 얘기할 때가 아니야."


translate japanese plot7_7d33ac04:



    voice "voice/yangxi_453.ogg"
    yangxi "노래방에 왔으면 노래해야지! 자, 부르자!"


translate japanese plot7_90ba2328:



    voice "voice/tianqin_1511.ogg"
    tianqin "그럼 나부터!"


translate japanese plot7_52a48fe9:



    voice "voice/tianqin_1512.ogg"
    tianqin "♪――"


translate japanese plot7_c0dd73db:



    voice "voice/tianqin_1513.ogg"
    tianqin "♪――!!"


translate japanese plot7_93caea86:



    voice "voice/tianqin_1514.ogg"
    tianqin "후……"


translate japanese plot7_c5528d0c:



    voice "voice/tianqin_1515.ogg"
    tianqin "어때? 꽤 잘했지?"


translate japanese plot7_245dfde9:



    voice "voice/banzhang_171.ogg"
    banzhang "아, 네…… 정말 잘하셨어요."


translate japanese plot7_ec306306:



    voice "voice/yangxi_454.ogg"
    yangxi "반장, 그렇게 배려해 줄 필요 없어."


translate japanese plot7_eb880171:



    voice "voice/yangxi_455.ogg"
    yangxi "途中からずっと音外してた、バカ！"


translate japanese plot7_661f644d:



    voice "voice/tianqin_1516.ogg"
    tianqin "뭐!? 그럴 리 없어!"


translate japanese plot7_e144c1cd:



    voice "voice/yangxi_456.ogg"
    yangxi "못 믿겠으면 점수 봐."


translate japanese plot7_a7bd92da:


    "히나타의 말대로 노래방 채점 결과는 보기 좋게 낙제점이었다."


translate japanese plot7_997bf5e4:



    voice "voice/tianqin_1517.ogg"
    tianqin "에에!? 왜!"


translate japanese plot7_1cf67142:



    voice "voice/tianqin_1518.ogg"
    tianqin "매일 목욕하면서 열심히 연습하는데!?"


translate japanese plot7_e45b480f:



    voice "voice/yangxi_457.ogg"
    yangxi "이제 포기하지? 열 곡 부르면 두 곡 정도만 합격점이잖아."


translate japanese plot7_fe7e1ce1:



    voice "voice/yangxi_458.ogg"
    yangxi "しかも親世代の古い曲ばっかり。趣味が古すぎ。"


translate japanese plot7_8e8234d4:



    voice "voice/tianqin_1519.ogg"
    tianqin "でもいい曲じゃん？　名曲だと思わない？"


translate japanese plot7_29987453:



    voice "voice/yangxi_459.ogg"
    yangxi "名曲で音外す方が難しいではないか。"


translate japanese plot7_a10702f5:



    voice "voice/yangxi_460.ogg"
    yangxi "음감이 정말 없네……"


translate japanese plot7_d20703c3:



    voice "voice/tianqin_1520.ogg"
    tianqin "으으!"


translate japanese plot7_e3ba53a4:



    voice "voice/yangxi_461.ogg"
    yangxi "次は私。"


translate japanese plot7_7392036a:



    voice "voice/yangxi_462.ogg"
    yangxi "♪――"


translate japanese plot7_fded284d:



    voice "voice/yangxi_463.ogg"
    yangxi "♪――!　♪――!!"


translate japanese plot7_9972dd96:


    "히나타는 라이라보다 훨씬 잘 불렀고, 선곡도 밝고 요즘 유행에 맞았다."


translate japanese plot7_ad9baf53:


    "다만 저렇게 발랄하게 노래하는 모습은 평소의 히나타에게서는 도무지 상상할 수 없었다."


translate japanese plot7_1e5d1fd8:


    "마지막으로 채점 시스템이 내놓은 점수는 상당히 높았다."


translate japanese plot7_3792c933:



    voice "voice/yangxi_464.ogg"
    yangxi "후, 그럭저럭이네."


translate japanese plot7_024e789e:



    voice "voice/banzhang_172.ogg"
    banzhang "대…… 대단해요……"


translate japanese plot7_0d1831df:



    voice "voice/banzhang_173.ogg"
    banzhang "히나타 씨한테 저렇게 밝고 발랄한 면이 있다니……"


translate japanese plot7_42cc54c2:


    tianqin "쟤 애니메이션 좋아하거든. 특히 『{a=dictionary:dict_entry_47}문큐트{/a}』 같은 어린이 프로그램."


translate japanese plot7_4b724aff:



    voice "voice/tianqin_1522.ogg"
    tianqin "노래방에서는 『문큐트』 시리즈의 오프닝과 엔딩, 캐릭터송이랑 삽입곡만 부른다니까."


translate japanese plot7_6845fa39:



    voice "voice/yangxi_465.ogg"
    yangxi "뭐 불만 있어?"


translate japanese plot7_0fd9cc18:



    voice "voice/banzhang_174.ogg"
    banzhang "아, 아니에요! 그냥 너무 잘 부르셔서……"


translate japanese plot7_534da1c9:



    voice "voice/tianqin_1523.ogg"
    tianqin "평소랑 너무 달라서 놀란 거야."


translate japanese plot7_23d95d4a:



    voice "voice/yangxi_466.ogg"
    yangxi "반장."


translate japanese plot7_7a1c0ee2:



    voice "voice/banzhang_175.ogg"
    banzhang "네, 네!"


translate japanese plot7_78b71b1e:



    voice "voice/yangxi_467.ogg"
    yangxi "『문큐트』…"


translate japanese plot7_3477d818:



    voice "voice/banzhang_176.ogg"
    banzhang "『문큐트』…?"


translate japanese plot7_319faeb5:



    voice "voice/yangxi_468.ogg"
    yangxi "정말 재밌어. 우리 반 애들도 다 봐."


translate japanese plot7_3cc189db_1:



    voice "voice/banzhang_177.ogg"
    banzhang "ええっ！？"


translate japanese plot7_b70f0184:



    voice "voice/yangxi_469.ogg"
    yangxi "クラスの話題についていきたいなら、まずは『MoonCute』の第2シリーズがおすすめ。"


translate japanese plot7_ecdade53:



    voice "voice/yangxi_470.ogg"
    yangxi "第2シリーズがいちばん見やすいよ。キャラは派手じゃないけど、話はすごく引き込まれる！"


translate japanese plot7_caa72a51_1:



    voice "voice/banzhang_178.ogg"
    banzhang "그, 그런가요?"


translate japanese plot7_5a25a673:



    voice "voice/tianqin_1524.ogg"
    tianqin "스토오오오옵――!"


translate japanese plot7_501ac0c9:



    voice "voice/tianqin_1525.ogg"
    tianqin "急に勧誘を始めないで！"


translate japanese plot7_de51d121:



    voice "voice/yangxi_471.ogg"
    yangxi "……쳇."


translate japanese plot7_ba80f92c:



    voice "voice/tianqin_1526.ogg"
    tianqin "믿으면 안 돼. 우리 반에서 『문큐트』 보는 건 쟤뿐이야. 동지 늘리려는 거지."


translate japanese plot7_aaaa0bfc:



    voice "voice/banzhang_179.ogg"
    banzhang "그, 그렇군요……"


translate japanese plot7_d7a503a9:



    voice "voice/banzhang_180.ogg"
    banzhang "그래도 히나타 씨가 그렇게 좋아하신다면, 집에 가서 조금 찾아볼게요."


translate japanese plot7_951f76c8:



    voice "voice/yangxi_472.ogg"
    yangxi "응! 같이 보자!"


translate japanese plot7_2609f206:



    voice "voice/tianqin_1527.ogg"
    tianqin "『문큐트』 얘기만 나오면 진짜 딴사람 같아……"


translate japanese plot7_e1c2afe3:



    voice "voice/tianqin_1528.ogg"
    tianqin "반장도 불러 봐."


translate japanese plot7_41fc3395:



    voice "voice/banzhang_181.ogg"
    banzhang "네, 저, 저요?"


translate japanese plot7_dc3e81c8:



    voice "voice/banzhang_182.ogg"
    banzhang "하지만 여기 온 것도 처음인데……"


translate japanese plot7_fedf1eb0:



    voice "voice/tianqin_1529.ogg"
    tianqin "부끄러워할 필요 없어. 누구나 처음은 있잖아."


translate japanese plot7_5a912c16:



    voice "voice/tianqin_1530.ogg"
    tianqin "나도 처음엔 부끄러워서 못 불렀어. 히나타가 억지로 마이크를 쥐여 줘서 겨우 불렀다니까."


translate japanese plot7_60dd107b:



    voice "voice/banzhang_183.ogg"
    banzhang "으음……"


translate japanese plot7_691329fe:



    voice "voice/tianqin_1531.ogg"
    tianqin "아, 물론 정말 싫으면 억지로 시키지는 않을게."


translate japanese plot7_64d08e03:



    voice "voice/tianqin_1532.ogg"
    tianqin "그래도 모처럼 노래방에 왔으니까 한 곡만 불러 보면 어때?"


translate japanese plot7_548a15d2:



    voice "voice/yangxi_473.ogg"
    yangxi "아! 나왔다, 「모처럼 왔으니까」! 단골 권유 멘트네."


translate japanese plot7_ea5168be:



    voice "voice/tianqin_1533.ogg"
    tianqin "시끄러워. 남 의욕 꺾지 마!"


translate japanese plot7_13155c41:



    voice "voice/banzhang_184.ogg"
    banzhang "저는…"


translate japanese plot7_68222db4:



    voice "voice/banzhang_185.ogg"
    banzhang "그, 그럼 한 곡만 불러 볼게요!"


translate japanese plot7_0956de04:



    voice "voice/tianqin_1534.ogg"
    tianqin "좋아. 노래 넣는 법 알려 줄게."


translate japanese plot7_aff4421a:



    voice "voice/banzhang_186.ogg"
    banzhang "♪――"


translate japanese plot7_6a385575:



    voice "voice/banzhang_187.ogg"
    banzhang "♪～～"


translate japanese plot7_693fb369:



    voice "voice/banzhang_188.ogg"
    banzhang "후…… 부족한 노래 들어 주셔서 감사합니다."


translate japanese plot7_f561fd63:



    voice "voice/tianqin_1535.ogg"
    tianqin "대……"


translate japanese plot7_ecc3cd91:



    voice "voice/tianqin_1536.ogg"
    tianqin "대단해, 반장!"


translate japanese plot7_13310ef3:



    voice "voice/yangxi_474.ogg"
    yangxi "유럽 팝송이네. 게다가 유럽어 발음도 정말 깨끗해."


translate japanese plot7_7766f4f6:



    voice "voice/tianqin_1537.ogg"
    tianqin "히나타보다 훨씬 잘하지?"


translate japanese plot7_ef777308:



    voice "voice/yangxi_475.ogg"
    yangxi "시끄러워. 난 억양이 강한 것뿐이야."


translate japanese plot7_4616c170:



    voice "voice/banzhang_189.ogg"
    banzhang "저, 정말요?"


translate japanese plot7_d474aa41:



    voice "voice/banzhang_190.ogg"
    banzhang "사람들 앞에서는 처음이라…… 엄청 긴장했어요."


translate japanese plot7_5230e944:



    voice "voice/tianqin_1538.ogg"
    tianqin "점수 보면 거짓말 아닌 거 알걸."


translate japanese plot7_b27a18f3:


    "라이라가 화면을 가리켰다. 반장의 높은 점수가 표시되어 있었다."


translate japanese plot7_f8ec9555:



    voice "voice/tianqin_1539.ogg"
    tianqin "처음인데 이런 점수라니, 어어엄청 잘했어!"


translate japanese plot7_b3350a2d:



    voice "voice/yangxi_476.ogg"
    yangxi "후후. 그래도 날 넘으려면 좀 더 연습해야겠네."


translate japanese plot7_5359b34c:



    voice "voice/yangxi_477.ogg"
    yangxi "내 노래에는 『문큐트』를 향한 사랑이 가득하니까."


translate japanese plot7_14223a3c:



    voice "voice/tianqin_1540.ogg"
    tianqin "히・나・타―!"


translate japanese plot7_ed838fd0:



    voice "voice/banzhang_191.ogg"
    banzhang "부끄러운 모습을 보였네요."


translate japanese plot7_21e2b83c:



    voice "voice/tianqin_1541.ogg"
    tianqin "아이, 반장. 그렇게 겸손해하지 않아도 돼!"


translate japanese plot7_e4b5270e:



    voice "voice/tianqin_1542.ogg"
    tianqin "놀러 온 거잖아."


translate japanese plot7_ca80a186:



    voice "voice/banzhang_192.ogg"
    banzhang "후후, 죄송해요."


translate japanese plot7_ca371792:



    voice "voice/tianqin_1543.ogg"
    tianqin "初めてのカラオケ、どうだった？"


translate japanese plot7_bd7da068:



    voice "voice/banzhang_193.ogg"
    banzhang "とても…不思議な感じです！"


translate japanese plot7_50c33f4d:



    voice "voice/banzhang_194.ogg"
    banzhang "소리 내서 노래하니까 마음이 훨씬 가벼워졌어요."


translate japanese plot7_aee5a37a:



    voice "voice/tianqin_1544.ogg"
    tianqin "그렇지? 마음껏 소리 내서 노래하면 엄청 즐겁다니까!"


translate japanese plot7_45fda5ad:



    voice "voice/banzhang_195.ogg"
    banzhang "まだ胸がドキドキしています。歌うって、こんなにわくわくするんですね。"


translate japanese plot7_0baddcac:



    voice "voice/tianqin_1545.ogg"
    tianqin "헤헤, 시간도 아직 많아. 더 부르자!"


translate japanese plot7_4f1e14f2:



    voice "voice/banzhang_196.ogg"
    banzhang "네! 저도 히나타 씨 점수를 넘어 보고 싶어요."


translate japanese plot7_f4247361:



    voice "voice/yangxi_478.ogg"
    yangxi 0104 "面白い。『MoonCute』への究極の愛を宿した私に挑むつもり？"


translate japanese plot7_b69a71bd:



    voice "voice/yangxi_479.ogg"
    yangxi 0103 "그 도전, 받아 주지!"


translate japanese plot7_484ac4ac:



    voice "voice/yangxi_480.ogg"
    yangxi 0104 "와라, 신참. 전력을 보여 봐!"


translate japanese plot7_518bdb62:



    voice "voice/tianqin_1546.ogg"
    tianqin 0116 "오오——! 서쪽, 챔피언 히나타!"


translate japanese plot7_fd6312e4:



    voice "voice/tianqin_1547.ogg"
    tianqin 0116 "챔피언의 풍모를 숨기지도 않습니다! 이 패기, 과연 챔피언답습니다!"


translate japanese plot7_4239f7d5:



    voice "voice/tianqin_1548.ogg"
    tianqin 0102 "반장은 어떻게 맞설 것인가!?"


translate japanese plot7_ab7571cd:



    voice "voice/banzhang_197.ogg"
    banzhang 0203 "죄송해요, 히나타 씨. 그 왕좌는 제가 차지하게 될지도 모르겠네요."


translate japanese plot7_a1deb8bc:



    voice "voice/banzhang_198.ogg"
    banzhang 0204 "지지 않겠어요!"


translate japanese plot7_6e742a11:



    voice "voice/banzhang_199.ogg"
    banzhang 0204 "부디 봐주지 마세요."


translate japanese plot7_8cfe465d:



    voice "voice/tianqin_1549.ogg"
    tianqin 0116 "우오오——! 동쪽, 도전자 반장!"


translate japanese plot7_6aaba829:



    voice "voice/tianqin_1550.ogg"
    tianqin 0116 "마이크를 들고 당당하게 승리를 선언합니다!"


translate japanese plot7_a2441f79:



    voice "voice/tianqin_1551.ogg"
    tianqin 0102 "반장도 자기 실력에 상당한 자신이 있는 듯합니다!"


translate japanese plot7_f30e9db5:



    voice "voice/tianqin_1552.ogg"
    tianqin 0116 "양 선수, 입장!!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot7_062348ee:



    voice "voice/yangxi_481.ogg"
    yangxi 0103 "후후, 기세가 좋군, 신참."


translate japanese plot7_f07cf9e6:



    voice "voice/yangxi_482.ogg"
    yangxi 0103 "우리의 실력 차이를 깨닫게 해 주겠어!"


translate japanese plot7_b38570f3:



    voice "voice/banzhang_200.ogg"
    banzhang 0204 "잘 부탁드려요, 히나타 씨."


translate japanese plot7_7fa28593:



    voice "voice/banzhang_201.ogg"
    banzhang 0203 "져도 변명하기 없어요?"


translate japanese plot7_a48174c5:



    voice "voice/tianqin_1553.ogg"
    tianqin 0102 "일촉즉발! 드디어 격전의 막이 오릅니다!"


translate japanese plot7_a2c1e87e:



    voice "voice/tianqin_1554.ogg"
    tianqin 0102 "이번 노래방 챔피언은 과연 누구일 것인가!?"


translate japanese plot7_16a97870:



    voice "voice/tianqin_1555.ogg"
    tianqin 0116 "{size=72}Let's Rock!!!!!{/size}" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot7_df16c2b5:


    "그 뒤로 음을 틀리기 일쑤인 라이라는 순식간에 승부에서 탈락했다."


translate japanese plot7_5eb18707:


    "마이크는 쉴 새 없이 히나타와 반장 사이를 오갔다." (ctc="cg090_ktv_exchange_ctc")


translate japanese plot7_216a74cc:



    voice "voice/banzhang_202.ogg"
    banzhang ""


translate japanese plot7_54579148:



    voice "voice/banzhang_203.ogg"
    banzhang "해, 해냈어요!"


translate japanese plot7_19ec7e70:


    "마침내 반장이 근소한 점수 차로 노래방 대결에서 승리했다."


translate japanese plot7_5c6b56e7:



    voice "voice/yangxi_483.ogg"
    yangxi "그…… 그럴 수가!"


translate japanese plot7_6ba6dcba:



    voice "voice/yangxi_484.ogg"
    yangxi "노래방에 처음 온 신참에게 지다니……!?"


translate japanese plot7_33534e14:



    voice "voice/banzhang_204.ogg"
    banzhang "후후, 좋은 승부였어요, 히나타 씨."


translate japanese plot7_df5309e8:



    voice "voice/banzhang_205.ogg"
    banzhang "어쩌다 운이 좋았을 뿐이에요."


translate japanese plot7_77c8ecc9:



    voice "voice/tianqin_1556.ogg"
    tianqin "店員さん、時間だって。"


translate japanese plot7_832b0117:



    voice "voice/yangxi_485.ogg"
    yangxi "큭, 설욕은 다음으로 미뤄야 하나……"


translate japanese plot7_0cca0708:



    voice "voice/yangxi_486.ogg"
    yangxi "委員長！今度も一緒にカラオケ来て！"


translate japanese plot7_2417c6fe:



    voice "voice/yangxi_487.ogg"
    yangxi "그때는 절대 안 져."


translate japanese plot7_58b09d07:



    voice "voice/banzhang_206.ogg"
    banzhang "네. 다음에도 꼭 불러 주세요."


translate japanese plot7_3fed14e5:



    voice "voice/tianqin_1557.ogg"
    tianqin "하아…… 결국 오늘 실컷 못 부른 건 나뿐이잖아."


translate japanese plot7_211a0eeb:



    voice "voice/banzhang_207.ogg"
    banzhang "죄송해요…… 제가 라이라 씨 노래할 시간까지 빼앗았네요……"


translate japanese plot7_a8f84a0a:



    voice "voice/tianqin_1558.ogg"
    tianqin "괜찮아. 네가 이렇게 노래방 체질일 줄 몰랐을 뿐이야."


translate japanese plot7_959ef216:



    voice "voice/banzhang_208.ogg"
    banzhang "네. 저도 놀랐어요."


translate japanese plot7_906791c1:



    voice "voice/banzhang_209.ogg"
    banzhang "평소에는 숙제하면서 음악을 조금 듣는 정도인데, 그렇게 술술 부를 수 있을 줄은 몰랐어요."


translate japanese plot7_c5d54fdc:



    voice "voice/yangxi_488.ogg"
    yangxi "음악적 재능만큼은 반장이 라이라보다 훨씬 낫네."


translate japanese plot7_5f198430:



    voice "voice/tianqin_1559.ogg"
    tianqin "으으으!"


translate japanese plot7_326440ab:



    voice "voice/banzhang_210.ogg"
    banzhang "후후…"


translate japanese plot7_25709942:



    voice "voice/banzhang_211.ogg"
    banzhang "오늘도 여기 데려와 주셔서 고마워요."


translate japanese plot7_b4c0d193:



    voice "voice/banzhang_212.ogg"
    banzhang "두 분이 아니었다면 평생 노래방의 즐거움을 몰랐을지도 몰라요……"


translate japanese plot7_af5c8def:



    voice "voice/tianqin_1560.ogg"
    tianqin "아이, 반장. 그건 너무 과장이야."


translate japanese plot7_ae4ba82d:



    voice "voice/banzhang_213.ogg"
    banzhang "과장 아니에요."


translate japanese plot7_cae878e4:



    voice "voice/banzhang_214.ogg"
    banzhang "カラオケにあのまま悪いイメージを持っていたら、絶対に入ろうとは思わなかったから。"


translate japanese plot7_d6b0e822:



    voice "voice/banzhang_215.ogg"
    banzhang "오늘 마음껏 노래해서 새로운 취미를 찾은 기분이에요."


translate japanese plot7_2cced349:



    voice "voice/tianqin_1561.ogg"
    tianqin "마음에 들었다니 다행이야. 나랑 히나타는 방과 후에 이런 데서 시간 보내거든."


translate japanese plot7_7dcbb62e:



    voice "voice/yangxi_489.ogg"
    yangxi "다음에 기회 있으면 또 같이 부르자."


translate japanese plot7_97e744a0:



    voice "voice/yangxi_490.ogg"
    yangxi "私も鍛え直す。次は絶対、委員長の点数を超える。"


translate japanese plot7_0a29b432:



    voice "voice/banzhang_216.ogg"
    banzhang "네, 히나타 씨. 다음에 또 승부해요!"


translate japanese plot7_60f1135f:



    voice "voice/banzhang_217.ogg"
    banzhang "그러고 보니 두 분과 노는 건 내일이 마지막일 것 같아요."


translate japanese plot7_7f3292f8:



    voice "voice/banzhang_218.ogg"
    banzhang "明後日から、体育生のトレーニングに戻ります。"


translate japanese plot7_e5a9fbfb:



    voice "voice/tianqin_1562.ogg"
    tianqin "えっ、もう？一週間くらい休めるのかと思ってた。"


translate japanese plot7_f1a39289:



    voice "voice/banzhang_219.ogg"
    banzhang "첫 체육 특기생 종합시험이 얼마 안 남아서 미리 준비하려고요……"


translate japanese plot7_373e8163:



    voice "voice/banzhang_220.ogg"
    banzhang "내일 두 분이 같이 가 주셨으면 하는 곳이 있는데, 괜찮을까요?"


translate japanese plot7_a9de02ea:



    voice "voice/tianqin_1563.ogg"
    tianqin "어? 가고 싶은 데 있어?"


translate japanese plot7_a2daeba9:



    voice "voice/tianqin_1564.ogg"
    tianqin "멀지만 않으면 어디든 괜찮지?"


translate japanese plot7_3094898e:



    voice "voice/yangxi_491.ogg"
    yangxi "퇴근길 붐비는 버스나 지하철만 아니면 어디든 좋아."


translate japanese plot7_41b54ee7:



    voice "voice/banzhang_221.ogg"
    banzhang "괜찮아요. 자전거로 갈 수 있는 곳이에요."


translate japanese plot7_4fdd0d36:



    voice "voice/yangxi_492.ogg"
    yangxi "어디 가고 싶은데?"


translate japanese plot7_53ca672b:



    voice "voice/banzhang_222.ogg"
    banzhang "중앙공원이요."


translate japanese plot7_d2791c4a:



    voice "voice/banzhang_223.ogg"
    banzhang "두 분이랑 같이 그 거대한 나무를 보러 가고 싶어요."


translate japanese plot7_936c4298:



    voice "voice/cygnus_928.ogg"
    cygnus "…"


translate japanese plot7_befdaef3:


    "타닥타닥——"


translate japanese plot7_0b17e305:


    "마녀는 컴퓨터 앞에 앉아 무표정하게 키보드를 두드리고 있었다."


translate japanese plot7_2d17df97:


    "처음 사용할 때보다 타자가 제법 빨라졌다."


translate japanese plot7_6d593437:


    "하지만 화면에 무엇이 나오는지는 거의 보지 않았다. 인터넷에서 아무렇게나 검색하고 동영상 몇 개를 틀어 볼 뿐이었다."


translate japanese plot7_bb75de97:


    "오타쿠처럼 컴퓨터 앞에서 느긋하게 시간을 흘려보냈다."


translate japanese plot7_19f94ab5:



    voice "voice/cygnus_929.ogg"
    cygnus "그 기억은 대체……"


translate japanese plot7_fddb63b7:



    voice "voice/npc23_01.ogg"
    npc23 "이 배신자……"


translate japanese plot7_0469587b:



    voice "voice/blackcat_02.ogg"
    blackcat "서로 이용하고, 제 이익만 챙기며, 목적을 위해 수단을 가리지 않는다."


translate japanese plot7_b56638af:



    voice "voice/blackcat_30.ogg"
    blackcat "그게 네 본성이야."


translate japanese plot7_126ed705:



    voice "voice/cygnus_930.ogg"
    cygnus "크윽――!"


translate japanese plot7_799ad8d8:


    "꿈의 파편과 노리의 말이 몇 번이고 떠올랐다."


translate japanese plot7_3a650e83:


    "잊지 말라는 듯, 그것들은 거듭 시노스의 가슴을 조였다."


translate japanese plot7_c7abf2a1:



    voice "voice/cygnus_931.ogg"
    cygnus "대체 이건……"


translate japanese plot7_d41d8cd9:


    voice "voice/tianqin_1432.ogg"


translate japanese plot7_1ae69c7f:


    nvlNone "「…」"


translate japanese plot7_ea1acd28:


    nvlNone "아무 감정도 느끼지 못한 채\n유리관을 하나씩 지나갔다."


translate japanese plot7_e5f2768e:


    nvlNone "귓가의 욕설은 어느새 살려 달라는 애원으로 바뀌어 있었다."


translate japanese plot7_f804c257:


    nvlNone "「――――」" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot7_4f96c80f:


    nvlNone "어머님이 나를 재촉했다."


translate japanese plot7_053ac14b:


    nvlNone "거의 동시에 모든 유리관에서 피가 터졌다."


translate japanese plot7_517bf9d4:


    nvlNone "그것은 뇌수, 눈알, 근육, 중지, 유방, 두피, 인대, 소장,\n손톱, 종아리, 심장, 코, 척추,\n발가락, 살점이 뒤섞인 색이었다."


translate japanese plot7_53441fe6:


    nvlNone "짙푸르던 방은 다음 순간 핏빛으로 물들었다."


translate japanese plot7_dc7e7d07:


    nvlNone "번호: 癸2乙壬丁C{space=60}박명의 마녀{p}생존 시간: 5순 2일 14초 77밀리초"


translate japanese plot7_80f3f5ab:


    nvlNone "번호: 5J2甲4A{space=60}찬 샘의 마녀{p}생존 시간: 8136순 9일 6시간 52초 47밀리초"


translate japanese plot7_e619a5a7:


    nvlNone "번호: 2戊3F庚G{space=60}질주하는 뇌전의 마녀{p}생존 시간: 131472순 2일 4시간 8초 14밀리초"


translate japanese plot7_e3332e07:


    nvlNone "나는 유리관을 하나씩 점검했다."


translate japanese plot7_c14231ee:


    nvlNone "모두 이상 없이 작동하고 있음을 확인했다."


translate japanese plot7_9a5833e8:


    nvlNone "짙은 쇠 냄새가 장치를 뚫고 {rb}██{/rb}{rt}{font=SourceHanSerifSC-Heavy.otf}{size=12}신ㅁㅗㄱ ㅇ카ㅅㅑ{/size}{/font}{/rt} 전체에 퍼졌다."


translate japanese plot7_24c67058:


    nvlNone "이 유리관은 그들을 쉽게 죽게 두지 않는다."


translate japanese plot7_442ad03c:


    nvlNone "끝내 영혼이 육신의 속박에서 벗어난다 해도."


translate japanese plot7_cdfcc60f:


    nvlNone "장치는 어머님의 권능을 이용해 그녀들을 복원한다."


translate japanese plot7_69e1dc34:


    nvlNone "血肉をつなぎ合わせ、魂を据え、精神を初期化する。{p}狂うことさえ許されない。"


translate japanese plot7_473faf87:


    nvlNone "아아, {rb}감미로운{/rb}{rt}{font=SourceHanSerifSC-Heavy.otf}피비린내 나는{/font}{/rt} 마력."


translate japanese plot7_8625e949:


    nvlNone "알 수 있다.{p}절망에 무너질수록 장치는 그들에게서 더 많은 마력을 빨아들인다."


translate japanese plot7_437a184c:


    voice "voice/equinox_0092.ogg"
    nvlNone "「어머님, 오늘의 의식은 끝났습니다.」"


translate japanese plot7_3485a8cf:


    nvlNone "「――――」" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot7_27288b0e:


    voice "voice/equinox_0093.ogg"
    nvlNone "「오늘은 추출 효율이 높았기에……」"


translate japanese plot7_3485a8cf_1:


    nvlNone "「――――」" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot7_2638e2a3:


    voice "voice/equinox_0094.ogg"
    nvlNone "「알겠습니다.」"


translate japanese plot7_899b42ca:


    nvlNone "나는 어머님을 거역할 수 없다."


translate japanese plot7_c555fb9d:


    nvlNone "あの方が続けろと言うのなら、そうしなければならない。"


translate japanese plot7_d41d8cd9_1:


    voice "voice/tianqin_1521.ogg"


translate japanese plot7_704ed714:



    voice "voice/cygnus_932.ogg"
    cygnus "으윽――!"


translate japanese plot7_0bd28bf4:


    "털썩——"


translate japanese plot7_9406d6a4:



    voice "voice/tianqin_1565.ogg"
    tianqin "다녀왔어——!"


translate japanese plot7_cb8d3cc2:



    voice "voice/tianqin_1566.ogg"
    tianqin "어, 어! 시노스!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot7_e45b03ce:



    voice "voice/cygnus_933.ogg"
    cygnus "으음……"


translate japanese plot7_7b52022c:



    voice "voice/cygnus_934.ogg"
    cygnus "고마워. 이제 괜찮아……"


translate japanese plot7_1671b05a:



    voice "voice/tianqin_1567.ogg"
    tianqin "깜짝 놀랐잖아. 돌아오니까 바닥에 쓰러져 있더라."


translate japanese plot7_8c6e5d1f:



    voice "voice/cygnus_935.ogg"
    cygnus "마력이 부족할 뿐이야. 조금 쉬면 돌아와."


translate japanese plot7_cb61ca13:



    voice "voice/tianqin_1568.ogg"
    tianqin "저혈당 같은 거야? 물 마실래?"


translate japanese plot7_3c95789e:



    voice "voice/cygnus_936.ogg"
    cygnus "괜찮아……"


translate japanese plot7_be6a0f05:



    voice "voice/cygnus_937.ogg"
    cygnus "……아니, 역시 한 잔 부탁해."


translate japanese plot7_21111e9f:



    voice "voice/cygnus_938.ogg"
    cygnus "후——"


translate japanese plot7_71cb9fef:


    "시노스는 라이라에게 컵을 받아 물을 한 모금 마셨다."


translate japanese plot7_1f143b0a:



    voice "voice/tianqin_1569.ogg"
    tianqin "조금 편해졌어?"


translate japanese plot7_84b105ae:



    voice "voice/cygnus_939.ogg"
    cygnus "응."


translate japanese plot7_9d5c8a96:


    "시노스의 몸에는 물이 필요 없었다. 그래도 한 모금 마시니 마음이 조금 진정되었다."


translate japanese plot7_b3634476:


    "위약 효과 같은 것일지도 몰랐다."


translate japanese plot7_671de3f4:



    voice "voice/tianqin_1570.ogg"
    tianqin "아, 맞다. 주고 싶은 게 있었어."


translate japanese plot7_72fd6f45:



    voice "voice/tianqin_1571.ogg"
    tianqin "그래도 먼저 좀 쉬는 게 좋겠네."


translate japanese plot7_56f587df:



    voice "voice/cygnus_940.ogg"
    cygnus "응? 뭘?"


translate japanese plot7_826b1818:



    voice "voice/tianqin_1572.ogg"
    tianqin "급한 건 아니니까 우선 푹 쉬어."


translate japanese plot7_f47594d4:



    voice "voice/cygnus_941.ogg"
    cygnus "괜찮아. 몸은 이제 아무 문제 없어."


translate japanese plot7_00a9ab4a:



    voice "voice/tianqin_1573.ogg"
    tianqin "정말? 그럼 잠깐만. 가방에서 꺼낼게."


translate japanese plot7_4a59bfe5:



    voice "voice/tianqin_1574.ogg"
    tianqin "짜잔!"


translate japanese plot7_7baa7455:


    "라이라는 가방에서 예쁘게 포장한 상자를 꺼내 탁자 위에 놓았다."


translate japanese plot7_b7ab1770:



    voice "voice/cygnus_942.ogg"
    cygnus "이건?"


translate japanese plot7_c858312a:



    voice "voice/tianqin_1575.ogg"
    tianqin "열어 보면 알아."


translate japanese plot7_7fc63063:



    voice "voice/cygnus_943.ogg"
    cygnus "응?"


translate japanese plot7_a53981c5:



    voice "voice/cygnus_944.ogg"
    cygnus "응——?"


translate japanese plot7_b101c078:


    "시노스는 한참 상자를 만지작거렸지만 어떻게 여는지 알 수 없었다."


translate japanese plot7_78b4679d:



    voice "voice/tianqin_1576.ogg"
    tianqin "（시노스도 이런 데는 서투르구나…）"


translate japanese plot7_8c443d81:



    voice "voice/cygnus_945.ogg"
    cygnus "어쩔 수 없네. 마법으로 태워야겠어."


translate japanese plot7_766c38af:



    voice "voice/cygnus_946.ogg"
    cygnus "【사납게 날뛰는 광기｜Chaos flame】――"


translate japanese plot7_5072266c:



    voice "voice/tianqin_1577.ogg"
    tianqin "스토오오오옵!"


translate japanese plot7_a267914a:



    voice "voice/tianqin_1578.ogg"
    tianqin "魔法なんか使ったら、中身まで燃えちゃう！"


translate japanese plot7_311ac0ee:



    voice "voice/cygnus_947.ogg"
    cygnus "문제없어. 마력 출력은 정확히 조절할 거야……"


translate japanese plot7_a9868bd2:



    voice "voice/cygnus_948.ogg"
    cygnus "마력은 조금도 낭비하지 않아."


translate japanese plot7_06e504a1:



    voice "voice/tianqin_1579.ogg"
    tianqin "그 뜻이 아니잖아!"


translate japanese plot7_0e31518c:



    voice "voice/tianqin_1580.ogg"
    tianqin "이건 이렇게 여는 거야."


translate japanese plot7_a32dabf0:


    "라이라는 상자를 받아 몇 군데의 봉인을 뜯었다. 그러고서야 시노스 대신 내용물을 꺼낼 수 있었다."


translate japanese plot7_0856cec4:



    voice "voice/cygnus_949.ogg"
    cygnus "그렇구나. 이렇게 여는 거였네……"


translate japanese plot7_d98bb8a7:



    voice "voice/tianqin_1581.ogg"
    tianqin "네 선물인데 내가 뜯었네. 기분이 좀 이상하다……"


translate japanese plot7_e8554b3e:


    "상자에서 나온 것은 요즘 누구나 갖고 있는 디지털 기기였다. 시노스도 본 적이 있었다."


translate japanese plot7_8caa705f:



    voice "voice/cygnus_950.ogg"
    cygnus "この機械は…スマホか？"


translate japanese plot7_8e12909a_1:



    voice "voice/tianqin_1582.ogg"
    tianqin "응."


translate japanese plot7_51cb3c98:



    voice "voice/cygnus_951.ogg"
    cygnus "내 거야?"


translate japanese plot7_32551db0:



    voice "voice/tianqin_1583.ogg"
    tianqin "응. 스마트폰이 없으면 이 세상에서는 불편하잖아."


translate japanese plot7_9c0c3a1a:



    voice "voice/tianqin_1584.ogg"
    tianqin "그저께 나 기다릴 때도 스마트폰이 있었다면 바로 메시지를 보냈을 텐데. 사장님 가게를 찾아 헤매지 않아도 됐고."


translate japanese plot7_8bdf36c2:



    voice "voice/cygnus_952.ogg"
    cygnus "그건 그렇지……"


translate japanese plot7_3dad9fad:



    voice "voice/tianqin_1585.ogg"
    tianqin "처음에는 매장에서 최신 기종을 사려고 했는데, 나랑 같은 기종이 쓰기 편할 것 같았어."


translate japanese plot7_b2eab2c8:



    voice "voice/tianqin_1586.ogg"
    tianqin "네가 만져 본 건 내 스마트폰뿐이니까."


translate japanese plot7_1284a249:



    voice "voice/tianqin_1587.ogg"
    tianqin "아, 그리고 내 명의로 된 거야. 넌 아직 {a=dictionary:dict_entry_80}신분증{/a}이 없잖아."


translate japanese plot7_8626b4e5:



    voice "voice/tianqin_1588.ogg"
    tianqin "이제 이 스마트폰으로 쇼핑도 할 수 있어. 돈은 내 계좌에서 나가지만."


translate japanese plot7_c61e0e05:



    voice "voice/tianqin_1589.ogg"
    tianqin "너무 비싼 건 사지 마, 알겠지?"


translate japanese plot7_6fb804a2:



    voice "voice/cygnus_953.ogg"
    cygnus "……고마워."


translate japanese plot7_ba0a9680:



    voice "voice/cygnus_954.ogg"
    cygnus "비쌌을 텐데?"


translate japanese plot7_0a345609:


    "시노스는 인터넷에서 스마트폰 가격을 찾아본 적이 있었다. 저렴한 것도 있고 비싼 것도 있었다."


translate japanese plot7_3c2966ef:


    "라이라가 쓰는 기종은 딱 중간쯤 가격이었다."


translate japanese plot7_e3ef79e5:


    "그래도 고등학생이 가볍게 선물할 만한 가격은 아니었다."


translate japanese plot7_2d7e72e2:



    voice "voice/tianqin_1590.ogg"
    tianqin "괜찮아. 전에 말했잖아. 엄마가 나랑 언니한테 돈을 남겨 주셨다고."


translate japanese plot7_2927790f:



    voice "voice/tianqin_1591.ogg"
    tianqin "취직하기 전까지는 걱정 없이 지낼 만큼 남아 있어."


translate japanese plot7_f877e03b:



    voice "voice/cygnus_955.ogg"
    cygnus "그런데 왜 갑자기 선물을……"


translate japanese plot7_626c3a22:



    voice "voice/tianqin_1592.ogg"
    tianqin "음…… 요 이틀 계속 기운이 없어 보여서."


translate japanese plot7_35a5aac5:



    voice "voice/tianqin_1593.ogg"
    tianqin "조금이라도 힘냈으면 했어. 마침 스마트폰도 필요했고……"


translate japanese plot7_8da7b13c:



    voice "voice/cygnus_956.ogg"
    cygnus "아냐. 요 이틀은 정말 피곤했을 뿐이야……"


translate japanese plot7_a8797d4f:



    voice "voice/tianqin_1594.ogg"
    tianqin "괜찮아, 괜찮아. 내 응원이라고 생각해."


translate japanese plot7_9a518cfc:



    voice "voice/cygnus_957.ogg"
    cygnus "나는……"


translate japanese plot7_936c4298_1:



    voice "voice/cygnus_958.ogg"
    cygnus "…"


translate japanese plot7_4a311398:



    voice "voice/cygnus_959.ogg"
    cygnus "라이라. 사실…… 요 며칠 기억이 조금 돌아왔어."


translate japanese plot7_2231d017:


    "시노스는 라이라의 시선을 피하듯 몸을 살짝 돌렸다."


translate japanese plot7_cb8778df:



    voice "voice/tianqin_1595.ogg"
    tianqin "어!? 정말?"


translate japanese plot7_bdb62dd8:



    voice "voice/cygnus_960.ogg"
    cygnus "응. 모험가였을 때의 단편적인 기억들이야. 아주 오래전인 것 같아."


translate japanese plot7_0c17f34c:



    voice "voice/cygnus_961.ogg"
    cygnus "하지만 거기에도 내가 이 세상에 온 이유는 없었어."


translate japanese plot7_68bfbb95_2:



    voice "voice/tianqin_1596.ogg"
    tianqin "그렇구나…"


translate japanese plot7_b83c96a3:



    voice "voice/tianqin_1597.ogg"
    tianqin "그래도 괜찮지 않아? 기억이 돌아오는 건 좋은 일이잖아. 언젠가 분명 전부 떠오를 거야."


translate japanese plot7_9a518cfc_1:



    voice "voice/cygnus_962.ogg"
    cygnus "나는……"


translate japanese plot7_2a208657:



    voice "voice/cygnus_963.ogg"
    cygnus "그게 걱정이야."


translate japanese plot7_a2497aca:



    voice "voice/tianqin_1762.ogg"
    tianqin "어? 왜?"


translate japanese plot7_75d9c0ac:



    voice "voice/cygnus_964.ogg"
    cygnus 0306 "돌아온 기억에 몹시 끔찍한 것이 섞여 있어."


translate japanese plot7_9ecee9c3:



    voice "voice/cygnus_965.ogg"
    cygnus "그 기억 속에서 난…… 다른 마녀들의 힘을 짜내려고 아주 잔인한 짓을 했어."


translate japanese plot7_52c4b9f2:


    voice "voice/cygnus_966.ogg"
    cygnus 0307 "떠올리기만 해도 아직 식은땀이 나."


translate japanese plot7_aabeb2d8:



    voice "voice/cygnus_967.ogg"
    cygnus "처음에는 기억에 섞인 꿈이라고 생각했어. 그런데 아까 그 뒤가 또 떠올랐어."


translate japanese plot7_b136c2c6:


    voice "voice/cygnus_968.ogg"
    cygnus 0306 "너무 생생해…… 모험가 시절 기억보다도 깊게 박혀 있어."


translate japanese plot7_bb2782c3:



    voice "voice/cygnus_969.ogg"
    cygnus "우리 세상에서 {a=dictionary:dict_entry_74}마녀{/a}는 원래도 좋은 존재는 아니야. 그런데 나는… 그들보다도 더 끔찍했을지 몰라."


translate japanese plot7_264b363b:



    voice "voice/tianqin_1599.ogg"
    tianqin "그래서…… 이틀 동안 계속 그걸 걱정했어?"


translate japanese plot7_da5fc80c:



    voice "voice/cygnus_970.ogg"
    cygnus "응. 전부 떠올렸을 때 기억 속의 나로 돌아가 버리는 건 아닐까……"


translate japanese plot7_3379006c:



    voice "voice/tianqin_1600.ogg"
    tianqin "바보."


translate japanese plot7_62763df7:


    "딱!"


translate japanese plot7_ea89eba8:


    "전에 시노스가 노리에게 했듯, 라이라도 손가락으로 시노스의 이마를 튕겼다."


translate japanese plot7_479b19f7:



    voice "voice/cygnus_971.ogg"
    cygnus "아파! 뭐 하는 거야!"


translate japanese plot7_7e6ef3b2:



    voice "voice/tianqin_1601.ogg"
    tianqin "아직 일어나지도 않은 일로 계속 걱정하지 마."


translate japanese plot7_b1c3bddd:



    voice "voice/cygnus_972.ogg"
    cygnus "걱정될 수밖에. 기억이 돌아오면 딴사람처럼 변할지도 몰라."


translate japanese plot7_b82db2d3:



    voice "voice/cygnus_973.ogg"
    cygnus "혹시 널 해치는 짓이라도 하면……"


translate japanese plot7_3aa4d27c:



    voice "voice/tianqin_1602.ogg"
    tianqin "괜찮아. 그때는 나도 제대로 판단할 수 있어."


translate japanese plot7_b3835274:



    voice "voice/tianqin_1603.ogg"
    tianqin "하지만 난 지금 여기 있는 「너」야말로 진짜 시노스라고 믿어."


translate japanese plot7_c74bebc4:



    voice "voice/tianqin_1604.ogg"
    tianqin "끔찍한 과거가 있을지도 몰라. 그래도 도망치기보다는 받아들이는 게 좋다고 생각해."


translate japanese plot7_50b8da13:



    voice "voice/tianqin_1605.ogg"
    tianqin "今のシノスちゃんにできるのは、過去の間違いをどう償うか考えることじゃないかな。"


translate japanese plot7_9a518cfc_2:



    voice "voice/cygnus_974.ogg"
    cygnus "나는……"


translate japanese plot7_806b60a3:



    voice "voice/cygnus_975.ogg"
    cygnus "뭘 해야 할지 모르겠어…… 라이라…… 난……"


translate japanese plot7_12783bb9:


    "되살아난 기억에 시노스의 마음이 흔들렸다."


translate japanese plot7_2b1e634c:


    "강한 죄책감에 짓눌려 차라리 기억이 돌아오지 않았으면 싶기까지 했다."


translate japanese plot7_2cbd3de5:



    voice "voice/tianqin_1606.ogg"
    tianqin "자, 아직 모르는 일로 괴로워하지 마."


translate japanese plot7_e74417b4:



    voice "voice/tianqin_1607.ogg"
    tianqin "기억이 돌아오기 전에 생각해 봐야 아무 의미 없어."


translate japanese plot7_6c92e50e:


    "라이라는 시노스를 살며시 끌어안고 자신의 체온으로 차가운 몸을 녹였다."


translate japanese plot7_f5744014:


    "지금 마녀에게 필요한 것은 누군가의 답이 아니라, 이렇게 안아 주는 일이었을지도 모른다."


translate japanese plot7_fa1f893c:


    "다시 일어설 용기를 주는 따뜻한 포옹."


translate japanese plot7_96310174:



    voice "voice/cygnus_976.ogg"
    cygnus "……응."


translate japanese plot7_280126f6:



    voice "voice/cygnus_977.ogg"
    cygnus "고마워, 라이라."


translate japanese plot7_7d756e3a:



    voice "voice/tianqin_1608.ogg"
    tianqin "고맙다는 말은 됐어. 널 돕는 건 당연한걸."


translate japanese plot7_99472c8f:



    voice "voice/equinox_93.ogg"
    equinox "후……"


translate japanese plot7_7cf9e797:


    "ようやく町の宿で休める。"


translate japanese plot7_fb226e8c:


    "魔女遺跡の一件を片づけてから、何日野営を続けたか、もう数えてもいない。"


translate japanese plot7_27b52c63:


    "準備はしてあったけど、野宿はやっぱり不便が多い。"


translate japanese plot7_053ac636:


    "少なくとも今夜は、きれいな服に着替えて、ちょうどいい硬さのベッドで眠れる。"


translate japanese plot7_40d22823:


    "できれば一人部屋で、勇者とベッドを取り合わずに済んだら、もっとよかった。"


translate japanese plot7_0a18eea4:



    voice "voice/champion_66.ogg"
    champion "안녕."


translate japanese plot7_3b1dabdd:



    voice "voice/equinox_94.ogg"
    equinox "용사."


translate japanese plot7_2001f238:



    voice "voice/champion_67.ogg"
    champion "목욕은 했어?"


translate japanese plot7_46fef8d9:



    voice "voice/equinox_95.ogg"
    equinox "아니. 오늘은 안 할래."


translate japanese plot7_043c7df5:



    voice "voice/champion_68.ogg"
    champion "어……"


translate japanese plot7_5535d62a:



    voice "voice/equinox_96.ogg"
    equinox "왜. 나 냄새나?"


translate japanese plot7_ddcfa341:



    voice "voice/champion_69.ogg"
    champion "그런 게 아냐. 모처럼 마을에 왔잖아. 매일 씻을 수 있으면 그러는 게 좋지 않아?"


translate japanese plot7_eba17229:



    voice "voice/equinox_97.ogg"
    equinox "지금도 충분히 깨끗해. 오늘은 거의 움직이지도 않았고."


translate japanese plot7_5612fca9:



    voice "voice/champion_70.ogg"
    champion "아…… 알겠어. 마음대로 해."


translate japanese plot7_e87c46f0:



    voice "voice/equinox_98.ogg"
    equinox "（후후…）"


translate japanese plot7_59aef0d8:


    "勇者を少しからかえて、内心ちょっと気分がよかった。"


translate japanese plot7_520db5d2:


    "彼女は、私が出会った中で最も謎めいた冒険者だ。何を考えているのか、まるで読めない。"


translate japanese plot7_2c057222:


    "だが彼女から見れば、私も同じだろう。"


translate japanese plot7_673ee6da:


    "互いに何となく分かっている。たぶん、私と彼女は似た者同士だ。"


translate japanese plot7_9b100d81:


    ""


translate japanese plot7_897f5894:



    voice "voice/champion_71.ogg"
    champion "별을 보고 점치는 거야?"


translate japanese plot7_cf7f1b69:



    voice "voice/equinox_99.ogg"
    equinox "응. 여름의 대삼각형 주변 별들에 이상한 움직임이 있어."


translate japanese plot7_568d5633:



    voice "voice/equinox_100.ogg"
    equinox "앞으로는 그리 순조롭지 않을 것 같아……"


translate japanese plot7_03aaced8:



    voice "voice/champion_72.ogg"
    champion "그런 걸 믿어?"


translate japanese plot7_7eeec75d:



    voice "voice/equinox_101.ogg"
    equinox "믿고 안 믿고의 문제가 아냐. 별 읽기 학파의 이론은 전부 마법의 이치로 실증되어 있어."


translate japanese plot7_1b7d2802:



    voice "voice/equinox_102.ogg"
    equinox "앞으로의 모험에도 도움이 될 거야."


translate japanese plot7_1aadbb7e:


    ""


translate japanese plot7_bbce2e52:


    "星詠学派など、遊びにすぎないと思っている。まったく無知な話だ。"


translate japanese plot7_97c20317:


    ""


translate japanese plot7_a12ef11a:



    voice "voice/champion_73.ogg"
    champion "그래? 미안해. 난 이런 데 어두워서."


translate japanese plot7_34a97184:


    "ところが勇者は、この話を深く掘り下げるつもりなど最初からなく、あっさり謝った。"


translate japanese plot7_faf6e770:


    "でも、その声には妙に含みがあった。私にこれ以上話させたくないだけらしい。"


translate japanese plot7_3a0f8164:


    "――さっきからかった仕返しでもするように。"


translate japanese plot7_1f3cad2a:



    voice "voice/equinox_103.ogg"
    equinox "（하아… 역시 우린 닮았어.）"


translate japanese plot7_c1555699:



    voice "voice/champion_74.ogg"
    champion "그런데 마녀에게 가장 큰 난제는 수명이었지."


translate japanese plot7_17a23402:



    voice "voice/champion_75.ogg"
    champion "지난번 유적의 마녀도 죽을 때까지 마법의 이치에 숨은 오의를 깨닫지 못했어. 그게 가장 큰 미련이었겠지."


translate japanese plot7_3756858c:



    voice "voice/equinox_104.ogg"
    equinox "용사는 마녀에 대해 잘 아네."


translate japanese plot7_b7a8a2dc:



    voice "voice/champion_76.ogg"
    champion "그건…… 친하게 지내는 {a=dictionary:dict_entry_75}마녀{/a}가 한 명 있어서 그래."


translate japanese plot7_ff1b2cc3:



    voice "voice/champion_77.ogg"
    champion "그래서 좀 궁금했어. 마녀는 모두 같은 고민을 하는지."


translate japanese plot7_3846f766:



    voice "voice/equinox_105.ogg"
    equinox "말이 통하는 마녀를 둘이나 만나다니 운이 좋네."


translate japanese plot7_57cdcf1b:



    voice "voice/equinox_106.ogg"
    equinox "수명…… 확실히 우리 마녀들의 공통된 고민이지."


translate japanese plot7_3b7c3390:



    voice "voice/equinox_107.ogg"
    equinox "たとえ何千年も生きる長命種が偶然魔女になっても、魔理を究めるには短すぎる。入口にすら立てないかもしれない。"


translate japanese plot7_098b93f3:



    voice "voice/champion_78.ogg"
    champion "그럼 어떻게 해?"


translate japanese plot7_6229693a:



    voice "voice/equinox_108.ogg"
    equinox "초대와 계약해 마녀가 될 때, 계약에는 한 가지 약속이 있어."


translate japanese plot7_ee6eb874:



    voice "voice/equinox_109.ogg"
    equinox "마법의 이치를 깊이 탐구할수록 수명이 늘어나지."


translate japanese plot7_aa24ed1c:



    voice "voice/equinox_110.ogg"
    equinox "하지만 그 원리는 나도 몰라. 그 작동 원리 자체에 초대와 마법의 이치에 얽힌 비밀이 숨어 있을지도."


translate japanese plot7_41716e2d:



    voice "voice/champion_79.ogg"
    champion "마녀는 정말 마법의 이치를 연구하려고 존재하는 종족이구나……"


translate japanese plot7_bea58944:



    voice "voice/equinox_111.ogg"
    equinox "その通りだ。契約を結んだ瞬間から、私たちはもう人間ではない。"


translate japanese plot7_35e0c7c0:



    voice "voice/equinox_112.ogg"
    equinox "하지만 대부분의 마녀는 평생을 바쳐도 마법의 이치에 숨은 오의를 깨닫지 못해…… 계약으로 수명을 늘리는 건 더더욱 불가능하지."


translate japanese plot7_0dbbeb97:



    voice "voice/equinox_113.ogg"
    equinox "죽음에 저항하려고 많은 마녀가 다른 방법으로 조금이라도 수명을 늘리려 해."


translate japanese plot7_f3a7531e:



    voice "voice/equinox_114.ogg"
    equinox "고대의 수명 연장 마법이나 유물을 찾거나, 자신을 리치로 바꿔 죽음을 받아들이거나…… 소멸을 피하는 방법은 보통 이 둘이야."


translate japanese plot7_e3e23718:



    voice "voice/champion_80.ogg"
    champion "너는?"


translate japanese plot7_170ef729:



    voice "voice/equinox_115.ogg"
    equinox "나? 더 좋은 방법이 있어."


translate japanese plot7_11883092:



    voice "voice/equinox_116.ogg"
    equinox ""


translate japanese plot7_6afd667f:



    voice "voice/dorothea_45.ogg"
    dorothea "나 다 씻었어——!"


translate japanese plot7_7a6ce247:



    voice "voice/dorothea_46.ogg"
    dorothea "오늘은 내가 침대에서 잘 차례지!"


translate japanese plot7_0378990f:



    voice "voice/equinox_117.ogg"
    equinox "싫어."


translate japanese plot7_241a070e:



    voice "voice/equinox_118.ogg"
    equinox "넌 얌전히 바닥에서 자."


translate japanese plot7_81aac0a3:



    voice "voice/dorothea_47.ogg"
    dorothea "뭐야! 치사해! 며칠 내내 네가 침대에서 잤잖아!"


translate japanese plot7_c65384af:



    voice "voice/champion_81.ogg"
    champion "그럼 내가 바닥에서 잘게."


translate japanese plot7_1e5bfb17:



    voice "voice/equinox_119.ogg"
    equinox "아냐, 용사. 난 그냥 도로시아랑 같은 침대에서 자기 싫어서……"


translate japanese plot7_aa4e728f:



    voice "voice/equinox_120.ogg"
    equinox "됐어. 내가 바닥에서 잘게."


translate japanese plot7_f53d371e:



    voice "voice/equinox_121.ogg"
    equinox "もう一部屋取れればよかったのに…"


translate japanese plot7_75788ddd:



    voice "voice/champion_82.ogg"
    champion "어쩔 수 없지. 지금은 상인 일행이 많이 오가는 시기야."


translate japanese plot7_f5082736:



    voice "voice/champion_83.ogg"
    champion "이 여관에서 방 하나를 내준 것만 해도 다행이야."


translate japanese plot7_7b9b5fe1:



    voice "voice/equinox_122.ogg"
    equinox "알아. 그냥 해 본 말이야."


translate japanese plot7_d77507a6:



    voice "voice/equinox_123.ogg"
    equinox "그럼 나 먼저 씻고 올게."


translate japanese plot7_b9cf3ac8:



    voice "voice/champion_84.ogg"
    champion "응? 아까 안 씻는다고 하지 않았어?"


translate japanese plot7_42a5325e:


    "용사는 아까 말이 그냥 장난이었다는 걸 아직도 눈치채지 못한 모양이다."


translate japanese plot7_3b2464db:



    voice "voice/equinox_124.ogg"
    equinox "마음이 바뀌었어. 갑자기 씻고 싶어졌거든."


translate japanese plot7_126ed705_1:



    voice "voice/cygnus_978.ogg"
    cygnus "크윽――!"


translate japanese plot7_f7748944:



    voice "voice/cygnus_979.ogg"
    cygnus "아침인가……"


translate japanese plot7_40a0d6ee:



    voice "voice/cygnus_980.ogg"
    cygnus "（또 기억의 조각인가…）"


translate japanese plot7_c97fb239:



    voice "voice/cygnus_981.ogg"
    cygnus "（그래도 그 끔찍한 기억은 아니었어…）"


translate japanese plot7_2565a5e1:



    voice "voice/cygnus_982.ogg"
    cygnus "야, 노리."


translate japanese plot7_442941ca:


    "…"


translate japanese plot7_26dd08cf:


    "노리는 대답하지 않았고, 시노스의 목소리만 방 안에 울렸다."


translate japanese plot7_b15f084c:



    voice "voice/cygnus_983.ogg"
    cygnus "（쳇. 또 휴면 중이군. 좀 더 물어볼 게 있었는데.）"


translate japanese plot7_0b32ef50:



    voice "voice/cygnus_984.ogg"
    cygnus "（됐어. 우선 라이라를 찾자…）"


translate japanese plot7_66e9860a:



    voice "voice/cygnus_985.ogg"
    cygnus "뭐!? 벌써 열 시 반이야!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot7_296722fa:


    "시노스가 침대 옆 알람시계를 보았다. 며칠째 연달아 늦잠이었다."


translate japanese plot7_e7ab4c9c:


    "이 시간이면 라이라는 진작 학교에 갔다. 집에는 시노스뿐이었다."


translate japanese plot7_27e10ec2:



    voice "voice/cygnus_986.ogg"
    cygnus "……좀 더 잘까."


translate japanese plot7_fee47fe2:



    voice "voice/jinlaoshi_64.ogg"
    jinlaoshi "자, 이백 미터만 뛰면 자유 시간이야."


translate japanese plot7_08b4fced:



    voice "voice/npc29_02.ogg"
    npc29 "아직 이백 미터나 더 뛰어요!?"


translate japanese plot7_f91d4c24:



    voice "voice/npc29_03.ogg"
    npc29 "살려 주세요——"


translate japanese plot7_2c7af935:


    "목요일 체육 시간은 대개 끔찍했다."


translate japanese plot7_b89d60ba:


    "지난 체육 시간의 피로도 풀리지 않았는데 근육통에 시달리며 그 주의 두 번째 수업을 들어야 했기 때문이다."


translate japanese plot7_c6cc605f:


    "체육 선생님이 운동량을 줄여도 대부분의 학생은 죽는소리를 했다."


translate japanese plot7_df01f6df:



    voice "voice/jinlaoshi_65.ogg"
    jinlaoshi "자, 불평하지 말고."


translate japanese plot7_6e41a86b:



    voice "voice/jinlaoshi_66.ogg"
    jinlaoshi "내년 통합시험에서 체육 점수 조금이라도 올리려면 지금 이를 악물고 힘내자."


translate japanese plot7_7ebdbb07:



    voice "voice/npc29_04.ogg"
    npc29 "네에——"


translate japanese plot7_2083ab1c:



    voice "voice/jinlaoshi_67.ogg"
    jinlaoshi "좋아——"


translate japanese plot7_c7632697:



    voice "voice/jinlaoshi_68.ogg"
    jinlaoshi "츠루기, 24.8초. 아키, 25.2초."


translate japanese plot7_558a25d0:



    voice "voice/jinlaoshi_69.ogg"
    jinlaoshi "좋은 상태를 유지하고 있네, 츠루기. 다음 주 체육 특기생 종합시험도 이대로 하자."


translate japanese plot7_3550ff11:



    voice "voice/hecheng_139.ogg"
    hecheng "걱정 마세요. 더 빨리 뛸 수 있어요."


translate japanese plot7_529e1a0f:



    voice "voice/jinlaoshi_70.ogg"
    jinlaoshi "（그런 일을 겪고도 츠루기의 운동 능력이 떨어지지 않았네.）"


translate japanese plot7_d4fa5129:



    voice "voice/jinlaoshi_71.ogg"
    jinlaoshi "（열심히 해 주고 있어.）"


translate japanese plot7_eb3ed832:



    voice "voice/jinlaoshi_72.ogg"
    jinlaoshi "아키, 방금 기록도 충분히 좋아."


translate japanese plot7_26af82c4:



    voice "voice/jinlaoshi_73.ogg"
    jinlaoshi "하지만 더 낼 수 있지? 지금 기록은 네 평균보다 느려."


translate japanese plot7_238f8696:



    voice "voice/banzhang_224.ogg"
    banzhang "죄송해요, 선생님. 오늘은 컨디션이 조금 안 좋아서……"


translate japanese plot7_e8dc7260:



    voice "voice/banzhang_225.ogg"
    banzhang "금방 회복할게요."


translate japanese plot7_6db88872:



    voice "voice/jinlaoshi_74.ogg"
    jinlaoshi "넌 더 빨리 뛸 수 있어."


translate japanese plot7_ae9c13c8:



    voice "voice/jinlaoshi_75.ogg"
    jinlaoshi "내일 체육 특기생 훈련에는 참가하니?"


translate japanese plot7_117c4f6b:



    voice "voice/banzhang_226.ogg"
    banzhang "네, 참가해요."


translate japanese plot7_f82a2176:



    voice "voice/jinlaoshi_76.ogg"
    jinlaoshi "좋아. 그럼 힘내렴."


translate japanese plot7_a40cd180:



    voice "voice/jinlaoshi_77.ogg"
    jinlaoshi "次の組！準備――！"


translate japanese plot7_47eb8f51:



    voice "voice/jinlaoshi_78.ogg"
    jinlaoshi "출발!"


translate japanese plot7_6d1dbc18:



    voice "voice/yangxi_493.ogg"
    yangxi "후——"


translate japanese plot7_60f6052f:



    voice "voice/xizhen_23.ogg"
    xizhen "하아, 하아…… 뭐야, 쟤는……"


translate japanese plot7_e30dc9ff:



    voice "voice/minying_15.ogg"
    minying "젠장…… 하아…… 역시 못 따라가……"


translate japanese plot7_217c2286:



    voice "voice/jinlaoshi_79.ogg"
    jinlaoshi "히나타, 25.8초라…"


translate japanese plot7_0fb44822:



    voice "voice/jinlaoshi_80.ogg"
    jinlaoshi "체육 특기생 대부분보다 빠른 기록이네……"


translate japanese plot7_180dd420:



    voice "voice/jinlaoshi_81.ogg"
    jinlaoshi "아직 전력 아니지? 꽤 여유 있어 보이는데."


translate japanese plot7_a070dda3:



    voice "voice/yangxi_494.ogg"
    yangxi "글쎄요."


translate japanese plot7_38ef0b56:



    voice "voice/jinlaoshi_82.ogg"
    jinlaoshi "다시 한번 생각해 보렴. 정말 체육 특기생으로 바꿀 생각 없어?"


translate japanese plot7_5d9abc63:



    voice "voice/jinlaoshi_83.ogg"
    jinlaoshi "성적도 체력도 좋잖아. 아키처럼 아시아의 명문 학교라면 어디든 노려볼 수 있을 텐데."


translate japanese plot7_99f9a003:



    voice "voice/yangxi_495.ogg"
    yangxi "사양할게요. 그런 건 관심 없어서요."


translate japanese plot7_3fa418c2:



    voice "voice/yangxi_496.ogg"
    yangxi "普通に高校を卒業して、普通の大学へ行ければ、それでいい。"


translate japanese plot7_39404f3f:



    voice "voice/jinlaoshi_84.ogg"
    jinlaoshi ""


translate japanese plot7_e24b596c:



    voice "voice/yangxi_497.ogg"
    yangxi "（음… 라이라가 운동장에 없네.）"


translate japanese plot7_827003ee:



    voice "voice/yangxi_498.ogg"
    yangxi "（またサボって、どこ行ったんだか…）"


translate japanese plot7_d2527610:


    voice "voice/banzhang_227.ogg"
    banzhang 0310 "히나타 씨——"


translate japanese plot7_6fcb643b:



    voice "voice/yangxi_499.ogg"
    yangxi "반장? 무슨 일이야?"


translate japanese plot7_ea3d75a1:



    voice "voice/banzhang_228.ogg"
    banzhang "아뇨, 그냥 말 좀 걸려고요."


translate japanese plot7_3bf3b789:



    voice "voice/yangxi_500.ogg"
    yangxi "그, 그래……"


translate japanese plot7_e3cd697e:


    "이틀 동안 방과 후를 함께 보내며 반장과 히나타는 조금 가까워졌다."


translate japanese plot7_94227ade:


    "하지만 히나타는 아직 조금 어색했다. 반에서도 유명한 외톨이답게 쉽게 마음을 열지 못했다."


translate japanese plot7_a6649011:



    voice "voice/banzhang_229.ogg"
    banzhang "저기, 어제 『문큐트』를 찾아봤어요. 추천해 주신 대로 두 번째 시리즈부터 보려고요……"


translate japanese plot7_03d29f30:



    voice "voice/yangxi_501.ogg"
    yangxi "오, 오오!!"


translate japanese plot7_a50c8f0a:


    "반장이 『문큐트』를 입에 올린 순간 히나타의 눈에 평소와 다른 빛이 깃들었다."


translate japanese plot7_3b3304fa:


    "두꺼운 마음의 벽은 순식간에 무너졌다."


translate japanese plot7_ee5f5b7e:



    voice "voice/yangxi_502.ogg"
    yangxi "『문큐트』 두 번째 시리즈는 정말 재밌어! 요즘 큐트처럼 초능력으로 싸우는 게 아니라, 초대의 작풍을 이어받아서 화려한 체술을 쓰거든."


translate japanese plot7_698fa7e0:



    voice "voice/yangxi_503.ogg"
    yangxi "ストーリーも、第四シリーズほど暗くはないけど、第二シリーズだってかなり深い。敵の幹部も一人ひとりちゃんと掘り下げられてて…"


translate japanese plot7_9aa241f1:



    voice "voice/yangxi_504.ogg"
    yangxi "それに第二シリーズは、OPもEDもすごくいい。劇中曲も本当にいい曲ばかり。"


translate japanese plot7_490d5a61:



    voice "voice/yangxi_505.ogg"
    yangxi "특히 리더의 캐릭터송 『Cute Like Me』. 가사에 블루를 향한 마음이 가득해서……"


translate japanese plot7_84f20afd:



    voice "voice/yangxi_506.ogg"
    yangxi "아, 안 되겠다. 더 말하면 스포일러야."


translate japanese plot7_da2b7d8a:



    voice "voice/banzhang_230.ogg"
    banzhang "후후. 정말 『문큐트』를 좋아하시네요."


translate japanese plot7_f3bfda02:



    voice "voice/yangxi_507.ogg"
    yangxi "당연하지. 현대 최고의 애니메이션 시리즈니까."


translate japanese plot7_c5267807:



    voice "voice/yangxi_508.ogg"
    yangxi "私もアニメはかなり観てる。覚えてるだけでも二百本くらい。"


translate japanese plot7_8124c4a0:



    voice "voice/yangxi_509.ogg"
    yangxi "그중 좋은 작품도 얼마든지 있지. 그래도 최고는 『문큐트』 시리즈라고 생각해."


translate japanese plot7_2a10a945:



    voice "voice/yangxi_510.ogg"
    yangxi "막 철들기 시작한 아이든, 오랫동안 일에 치인 직장인이든 『문큐트』에서는 똑같은 감동을 느낄 수 있어."


translate japanese plot7_1d4d99f8:



    voice "voice/banzhang_231.ogg"
    banzhang "なるほど。では、ヒナタさんのおすすめ通り、まず第二シリーズを最後まで観てみます。"


translate japanese plot7_a5c79eb9:



    voice "voice/yangxi_511.ogg"
    yangxi "응! 두 번째를 보면 『문큐트』가 얼마나 멋진지 분명 알게 될 거야."


translate japanese plot7_5b0e4aad:


    "『문큐트』 이야기가 나오자 히나타는 갑자기 말이 많아져 쉴 새 없이 설명하기 시작했다."


translate japanese plot7_9241abd8:


    "어제 노래방에 다녀온 뒤로 반장은 히나타와 가까워지는 가장 좋은 방법을 알아냈다."


translate japanese plot7_c314a740:



    voice "voice/banzhang_232.ogg"
    banzhang "그러고 보니 수업 시작하고 라이라 씨를 못 봤네요. 어디 있는지 아세요?"


translate japanese plot7_063c93df:



    voice "voice/yangxi_512.ogg"
    yangxi "땡땡이쳤겠지, 아마."


translate japanese plot7_5e19cc65:



    voice "voice/yangxi_513.ogg"
    yangxi "どうせ体育試験は受けられないし、授業に出ても出なくても同じだと思ってるんけど。"


translate japanese plot7_76af18ff:



    voice "voice/banzhang_233.ogg"
    banzhang "그렇구나…"


translate japanese plot7_2719ce9f:



    voice "voice/yangxi_514.ogg"
    yangxi "아, 맞다. 원예부에 가서 키우는 것들 좀 돌봐 달라고 했지."


translate japanese plot7_235ed624:



    voice "voice/yangxi_515.ogg"
    yangxi "마침 잘됐다. 반장, 같이 갈래?"


translate japanese plot7_020e66c3:



    voice "voice/yangxi_516.ogg"
    yangxi "혼자 갔다가 다른 부원을 만나면 어색하거든."


translate japanese plot7_392ca211:



    voice "voice/banzhang_234.ogg"
    banzhang "네. 같이 가요."


translate japanese plot7_972f16b3:


    npc50 "きゃああああああ――！"


translate japanese plot7_74de0c03:



    voice "voice/yangxi_517.ogg"
    yangxi "무슨 소리야?"


translate japanese plot7_fc4959cd:



    voice "voice/banzhang_235.ogg"
    banzhang "휴게실 쪽에서 난 것 같은데……"


translate japanese plot7_818a0558:



    voice "voice/yangxi_518.ogg"
    yangxi "가 보자."


translate japanese plot7_6b19a1ec:



    voice "voice/tianqin_1609.ogg"
    tianqin "先週さ、ヒナタちゃんとコミュニティ近くの公園の裏に新しくできたスイーツ店へ行ったの。"


translate japanese plot7_bebfce58:



    voice "voice/tianqin_1610.ogg"
    tianqin "でも、びっくりするくらいまずくて！パフェに生クリーム山ほど入ってて、くどいのなんの。"


translate japanese plot7_d1f12d9f:



    voice "voice/tianqin_1611.ogg"
    tianqin "그래서 가게를 나와서 상점가에 늘 가던 밀크티 집으로 가기로 했는데."


translate japanese plot7_9c059431:



    voice "voice/tianqin_1612.ogg"
    tianqin "なぜかすごい行列ができてて、その手前に別の新しいミルクティー店があったの。"


translate japanese plot7_21b4ace9:



    voice "voice/tianqin_1613.ogg"
    tianqin "아까 새 디저트 가게도 꽝이었는데, 설마 새 밀크티 집까지 맛없을 정도로 운이 나쁘겠어 싶었지."


translate japanese plot7_34fb971d:



    voice "voice/tianqin_1614.ogg"
    tianqin "그래서 일단 한번 들어가 봤어."


translate japanese plot7_31c1dfa8:



    voice "voice/tianqin_1615.ogg"
    tianqin "그랬더니 진짜 맛없는 거야!"


translate japanese plot7_145be451:



    voice "voice/tianqin_1616.ogg"
    tianqin "그제야 늘 가던 가게에 왜 그렇게 줄이 길었는지 알았지——"


translate japanese plot7_22b4008d:



    voice "voice/keke_81.ogg"
    keke "저기……"


translate japanese plot7_6fee1475:



    voice "voice/tianqin_1617.ogg"
    tianqin "응? 왜?"


translate japanese plot7_c23a038a:



    voice "voice/keke_82.ogg"
    keke "라이라 선배! 수업 빼먹을 때마다 내 연구실에 좀 안 오면 안 돼!?"


translate japanese plot7_23eee50d:


    "체육 수업을 빼먹은 라이라는 후배의 전용 연구실에 와 있었다."


translate japanese plot7_8f010e31:


    "바빠 보이는 후배의 기분은 아랑곳하지 않고, 연구실 구석에 앉아 제멋대로 수다를 떨기 시작했다."


translate japanese plot7_5f7947e8:


    "평범한 대화라면 몰라도 라이라가 하는 말은 전부 시시콜콜한 일상 이야기였다. 듣고 있으면 이상하게 짜증이 났다."


translate japanese plot7_79a4d341:



    voice "voice/tianqin_1618.ogg"
    tianqin "まあまあ。ココちゃんだって暇そうだし。"


translate japanese plot7_f9b2c69b:



    voice "voice/keke_83.ogg"
    keke "어디가 한가해! 실험하면서 논문 쓰고 있잖아!"


translate japanese plot7_298da752:



    voice "voice/tianqin_1619.ogg"
    tianqin "어, 정말? 괜히 바쁘게 돌아다니는 게 아니었구나."


translate japanese plot7_6ad9ad94:



    voice "voice/keke_84.ogg"
    keke "수업 빼먹는 선배랑은 다르거든!"


translate japanese plot7_3ce41ffc:



    voice "voice/keke_85.ogg"
    keke "그런데 선배, 근시였어?"


translate japanese plot7_0fa7a510:



    voice "voice/tianqin_1620.ogg"
    tianqin "ううん。ちょっと気分を変えたくて、今日は伊達眼鏡。"


translate japanese plot7_77989a75:



    voice "voice/tianqin_1621.ogg"
    tianqin "어때? 잘 어울리지? 지적으로 보이지 않아?"


translate japanese plot7_0c82e5ee:



    voice "voice/keke_86.ogg"
    keke "……아니, 전혀. 안경 써도 지적으로는 안 보여."


translate japanese plot7_190895c7:



    voice "voice/tianqin_1622.ogg"
    tianqin "너무해! 다른 애들은 다 잘 어울린다고 했는데!"


translate japanese plot7_fd076cb6:



    voice "voice/keke_87.ogg"
    keke "다들 선배가 계속 들러붙는 게 싫어서 대충 맞춰 주는 거겠지……"


translate japanese plot7_fe60e8f4:



    voice "voice/tianqin_1623.ogg"
    tianqin "에이, 그 얘기는 됐고."


translate japanese plot7_60f87cf1:



    voice "voice/tianqin_1624.ogg"
    tianqin "저 커피 다 됐어? 마시고 싶어——"


translate japanese plot7_9f79c27c:



    voice "voice/keke_88.ogg"
    keke "はぁ…"


translate japanese plot7_1f636b30:


    "라이라 때문에 집중이 완전히 흐트러진 코코는 어쩔 수 없이 실험을 멈추고 비커에서 커피를 따라 주었다."


translate japanese plot7_c3fc333c:



    voice "voice/keke_89.ogg"
    keke "자."


translate japanese plot7_b0b2d951:



    voice "voice/tianqin_1625.ogg"
    tianqin "땡큐~ 비커로 내린 커피는 처음이야!"


translate japanese plot7_255a08fc:



    voice "voice/tianqin_1626.ogg"
    tianqin "설탕이랑 연유 있어?"


translate japanese plot7_daf1e08c:



    voice "voice/keke_90.ogg"
    keke "뭐!? 커피는 무조건 블랙이지."


translate japanese plot7_4c78404a:



    voice "voice/tianqin_1627.ogg"
    tianqin "어? 설탕이랑 연유 넣으면 훨씬 맛있잖아."


translate japanese plot7_c0824b01:



    voice "voice/tianqin_1628.ogg"
    tianqin "블랙은 쓰기만 해."


translate japanese plot7_3977f30d:



    voice "voice/keke_91.ogg"
    keke "커피 맛을 하나도 모르네. 원두의 섬세한 향을 느끼려면 블랙으로 마셔야 해."


translate japanese plot7_3dab7fe5:



    voice "voice/tianqin_1629.ogg"
    tianqin "그런 맛은 아무래도 좋아. 난 원두 풍미 같은 건 신경 안 써."


translate japanese plot7_44649157:



    voice "voice/tianqin_1630.ogg"
    tianqin "飲み物は甘い方がおいしいに決まってる。"


translate japanese plot7_c800fc20:



    voice "voice/keke_92.ogg"
    keke "하아…… 찾아 줄게."


translate japanese plot7_eb793524:



    voice "voice/keke_93.ogg"
    keke "흰 설탕이 조금 남아 있었을 텐데……"


translate japanese plot7_cd806334:



    voice "voice/keke_94.ogg"
    keke "자, 설탕."


translate japanese plot7_6ad469c1:



    voice "voice/keke_95.ogg"
    keke "연유는 포기하세요. 그런 건 학교에 안 가져오거든."


translate japanese plot7_c53e231e:



    voice "voice/tianqin_1631.ogg"
    tianqin "고마워. 난 블랙은 정말 못 마시겠더라——"


translate japanese plot7_cc6fac16:



    voice "voice/keke_96.ogg"
    keke "선배한테 마시게 하다니 좋은 원두가 아깝네……"


translate japanese plot7_935837e5:



    voice "voice/tianqin_1632.ogg"
    tianqin "그런데 코코는 블랙으로 마시면서 왜 설탕을 둬?"


translate japanese plot7_8be6e8b7:



    voice "voice/keke_97.ogg"
    keke "この前、紅茶を淹れた時の残りだ。"


translate japanese plot7_9144cfbc:



    voice "voice/tianqin_1633.ogg"
    tianqin "어!? 홍차에 설탕?"


translate japanese plot7_0bf6f5c9:



    voice "voice/keke_98.ogg"
    keke "이번엔 또 뭔가요, 아가씨."


translate japanese plot7_a67685f8:



    voice "voice/tianqin_1634.ogg"
    tianqin "달콤한…… 홍차……?"


translate japanese plot7_cb86150c:



    voice "voice/keke_99.ogg"
    keke "何がおかしい？ヨーロッパじゃ、みんな紅茶をそうやって飲むだろう？"


translate japanese plot7_37eb4736:



    voice "voice/tianqin_1635.ogg"
    tianqin "어, 그래!?"


translate japanese plot7_88eab255:



    voice "voice/tianqin_1636.ogg"
    tianqin "なんかすごく変な味しそう…私には無理かも。"


translate japanese plot7_8d9a6b8e:



    voice "voice/keke_100.ogg"
    keke "선배, 커피에는 설탕 넣으면서 홍차에는 못 넣겠다니 그게 더 이상하지 않아?"


translate japanese plot7_2239b9c1:



    voice "voice/tianqin_1637.ogg"
    tianqin "커피는 쓰잖아?"


translate japanese plot7_895d9b97:



    voice "voice/keke_101.ogg"
    keke "홍차도 쓰거든!"


translate japanese plot7_ebe5c6f9:



    voice "voice/keke_102.ogg"
    keke "선배들 자주 가는 밀크티 집도 그냥 차 시켜도 시럽 잔뜩 넣어!"


translate japanese plot7_dd0ee2e0:



    voice "voice/tianqin_1638.ogg"
    tianqin "어, 코코도 그 가게 가 봤어?"


translate japanese plot7_43bc0806:



    voice "voice/keke_103.ogg"
    keke "아! 그게…… 가, 가끔. 몇 번……"


translate japanese plot7_e63b360f:



    voice "voice/keke_104.ogg"
    keke "（아차, 말실수했다.）"


translate japanese plot7_ecd21b47:



    voice "voice/tianqin_1639.ogg"
    tianqin "そうだ！あのお店、実は裏メニューがあるんだよ。トッピングなしでミルクティーを頼むとね…"


translate japanese plot7_032306ed:



    voice "voice/keke_105.ogg"
    keke "（はぁ…しまった…）"


translate japanese plot7_bdbd9cbc:



    voice "voice/tianqin_1640.ogg"
    tianqin "그러니까 거기는 당도 절반을 추천해. 그러면 차 맛이 더 진해지거든."


translate japanese plot7_59139daf:



    voice "voice/keke_106.ogg"
    keke "（드디어 끝났네…）"


translate japanese plot7_a727488a:



    voice "voice/tianqin_1641.ogg"
    tianqin "맞다, 코코. 전에 표본으로 만든 흰쥐는?"


translate japanese plot7_2b0b376b:



    voice "voice/keke_107.ogg"
    keke "그건 갑자기 왜?"


translate japanese plot7_78a7c276:



    voice "voice/tianqin_1642.ogg"
    tianqin "그냥 궁금해서. 보고 싶어."


translate japanese plot7_2a87872b:



    voice "voice/keke_108.ogg"
    keke "구석 표본장에 있어."


translate japanese plot7_bfb9d6dd:



    voice "voice/tianqin_1643.ogg"
    tianqin "오—— 찾아볼게."


translate japanese plot7_9d8603a7:



    voice "voice/tianqin_1644.ogg"
    tianqin "이쯤인가——?"


translate japanese plot7_da4df83e:



    voice "voice/tianqin_1645.ogg"
    tianqin "어, 찾았다."


translate japanese plot7_7e0a3848:


    keke 0104 "見つかったかー？　私の棚、ぐちゃぐちゃにしないでくださいよ。"


translate japanese plot7_4ca1b5bd:



    voice "voice/tianqin_1646.ogg"
    tianqin "괜찮아, 찾았어."


translate japanese plot7_42dbe476:



    voice "voice/tianqin_1647.ogg"
    tianqin "영차——"


translate japanese plot7_315a15e2:


    "라이라는 포르말린으로 가득 찬 표본 병을 조심스럽게 꺼냈다. 안에는 전에 코코가 해부한 흰쥐가 잠겨 있었다."


translate japanese plot7_3012b348:



    voice "voice/tianqin_1648.ogg"
    tianqin "（다음은…）"


translate japanese plot7_dfb7864f:



    voice "voice/tianqin_1649.ogg"
    tianqin "아——!"


translate japanese plot7_c591d15a:


    "시노스에게 받은 안경은 곧바로 흰쥐 표본에 남은 마력에 반응했다."


translate japanese plot7_25f7d259:


    "렌즈 너머의 표본은 시노스와 똑같은 마법의 빛을 내고 있었다."


translate japanese plot7_d803e7bf:



    voice "voice/tianqin_1650.ogg"
    tianqin "（반응했어! 시노스가 준 안경이 제대로 작동해.）"


translate japanese plot7_ca8c506d:



    voice "voice/tianqin_1651.ogg"
    tianqin "（이 색은 시노스 몸에서 나던 것과 같아…）"


translate japanese plot7_684c11e1:



    voice "voice/tianqin_1652.ogg"
    tianqin "（鶴城の机に入ってた白ネズミと、園芸部に出た白ネズミはやっぱりつながってる…これで間違いないよね。）"


translate japanese plot7_cd28ce80:



    voice "voice/keke_110.ogg"
    keke "뭐 해?"


translate japanese plot7_c27b40ab:



    voice "voice/tianqin_1653.ogg"
    tianqin "으아아!?"


translate japanese plot7_4f4a4386:



    voice "voice/tianqin_1654.ogg"
    tianqin "깜짝이야……"


translate japanese plot7_9ae577f0:



    voice "voice/keke_111.ogg"
    keke "그렇게 놀랄 일이야? 대체 뭐 하는데?"


translate japanese plot7_d7212ea6:



    voice "voice/tianqin_1655.ogg"
    tianqin "아, 아니. 네가 만든 표본 좀 보고 싶어서."


translate japanese plot7_a70ca695:



    voice "voice/keke_112.ogg"
    keke "선배 이런 거 관심 없잖아?"


translate japanese plot7_e7062946:



    voice "voice/tianqin_1656.ogg"
    tianqin "아이! 갑자기 관심이 생겼다니까!"


translate japanese plot7_a9b2a314:



    voice "voice/tianqin_1657.ogg"
    tianqin "전에 선생님들보다 잘 만들었다고 했던 거 계속 기억하고 있었어. 그래서 오늘 한번 볼까 했지."


translate japanese plot7_addcdf2a:



    voice "voice/keke_113.ogg"
    keke "흐음? 갑자기 비위 맞추는 걸 보니 뭐 있어?"


translate japanese plot7_e9e8f46e:



    voice "voice/tianqin_1658.ogg"
    tianqin "아니라니까! 코코 표본이 얼마나 멋진지 보러 온 것뿐이야!"


translate japanese plot7_bda8b347:



    voice "voice/keke_114.ogg"
    keke "……마음대로 해. 표본장만 어지르지 않으면 상관없어."


translate japanese plot7_2edc4407:



    voice "voice/tianqin_1659.ogg"
    tianqin "（후… 코코는 안경을 눈치 못 챘겠지?）"


translate japanese plot7_f579d20a:


    "띠링, 띠링——"


translate japanese plot7_856c5281:



    voice "voice/keke_115.ogg"
    keke "응?"


translate japanese plot7_fb200c37:



    voice "voice/tianqin_1660.ogg"
    tianqin "아, 내 휴대폰이네."


translate japanese plot7_1b7ad576:



    voice "voice/tianqin_1661.ogg"
    tianqin "여보세요, 히나타? 무슨 일이야?"


translate japanese plot7_7a02f331:


    yangxi 0101 "ライラ、まだ学校にいる？"


translate japanese plot7_f0c9e880:



    voice "voice/tianqin_1662.ogg"
    tianqin "응. 코코 연구실."


translate japanese plot7_6a347532:


    voice "voice/yangxi_520.ogg"
    yangxi 0101 "지금 운동장에 올 수 있어? 휴게실에서 일이 생겼어."


translate japanese plot7_94bcdba2:



    voice "voice/tianqin_1663.ogg"
    tianqin "히나타, 어디……?"


translate japanese plot7_d827f949:



    voice "voice/banzhang_236.ogg"
    banzhang "ライラさーん。"


translate japanese plot7_7d775662:



    voice "voice/yangxi_521.ogg"
    yangxi "ライラ、こっち。"


translate japanese plot7_30ac78ec:



    voice "voice/tianqin_1664.ogg"
    tianqin "히나타, 반장!"


translate japanese plot7_9bf80a4b:



    voice "voice/tianqin_1665.ogg"
    tianqin "전화로 한 말 진짜야? 휴게실에서 무슨 일 있었어?"


translate japanese plot7_0300d3b5:



    voice "voice/yangxi_522.ogg"
    yangxi "응. 나랑 반장은 그때 바로 근처에 있었어."


translate japanese plot7_db7ab725:



    voice "voice/yangxi_523.ogg"
    yangxi "반장한테 안내해 달라고 하자."


translate japanese plot7_d7580173:



    voice "voice/banzhang_237.ogg"
    banzhang "……네."


translate japanese plot7_9ecd590d:


    "라이라는 히나타와 반장을 따라 체육 특기생 {a=dictionary:dict_entry_76}휴게실{/a}로 향했다."


translate japanese plot7_808130db:


    "들어가기 전부터 썩은 비린내와 짙은 쇠 냄새가 코를 찔렀다."


translate japanese plot7_87f667ce:



    voice "voice/tianqin_1666.ogg"
    tianqin "으음——"


translate japanese plot7_6085da50:



    voice "voice/banzhang_238.ogg"
    banzhang "정말 들어가실 거예요?"


translate japanese plot7_6f044b5c:



    voice "voice/tianqin_1667.ogg"
    tianqin "저기…… 사실 무슨 일인지 아직 하나도 몰라. 히나타가 불러서 왔을 뿐이야."


translate japanese plot7_abe82a09:



    voice "voice/yangxi_524.ogg"
    yangxi "들어가서 말할게. 아무튼 우리 반 일과 관련 있어."


translate japanese plot7_2dfa0591:



    voice "voice/tianqin_1668.ogg"
    tianqin "어? 그럼 꼭 봐야겠네."


translate japanese plot7_d62c58ee:



    voice "voice/banzhang_239.ogg"
    banzhang "음…… 지금 선생님께서 다른 학생은 못 들어가게 하셔서……"


translate japanese plot7_77f0f99d:



    voice "voice/banzhang_240.ogg"
    banzhang "최대한 서둘러 주세요. 전 밖에서 망을 볼게요."


translate japanese plot7_ccf0cb1e:



    voice "voice/tianqin_1669.ogg"
    tianqin "반장, 부탁해."


translate japanese plot7_afd09c13:


    "찰칵——"


translate japanese plot7_7413b4ad:


    "반장이 열쇠로 문을 열자 역한 비린내가 세 사람을 감쌌다."


translate japanese plot7_ff8585dc:



    voice "voice/yangxi_525.ogg"
    yangxi "윽……"


translate japanese plot7_c3cfc963:



    voice "voice/tianqin_1670.ogg"
    tianqin "냄새……!"


translate japanese plot7_8b8a2615:



    voice "voice/banzhang_241.ogg"
    banzhang "두 분, 괜찮으세요?"


translate japanese plot7_c304f9ee:



    voice "voice/tianqin_1671.ogg"
    tianqin "大丈夫！　急いで調べるから、委員長は外で待ってて。"


translate japanese plot7_3cd9066f:



    voice "voice/banzhang_242.ogg"
    banzhang "그, 그럼 문은 닫을게요?"


translate japanese plot7_ead5953b:



    voice "voice/banzhang_243.ogg"
    banzhang "열어 두면 눈에 띄니까……"


translate japanese plot7_b11709e2:



    voice "voice/tianqin_1672.ogg"
    tianqin "응. 밖에서 망 좀 봐 줘."


translate japanese plot7_37b78a15:



    voice "voice/banzhang_244.ogg"
    banzhang "네."


translate japanese plot7_fd276bdb:


    "쾅——"


translate japanese plot7_4690c017:


    "문이 닫히고 썩은 냄새 속에 라이라와 히나타만 남았다."


translate japanese plot7_7c2c85e9:



    voice "voice/yangxi_526.ogg"
    yangxi "당장 나가고 싶다……"


translate japanese plot7_bc4c2192:



    voice "voice/tianqin_1673.ogg"
    tianqin "조금만 참아."


translate japanese plot7_fd5be12f:



    voice "voice/tianqin_1674.ogg"
    tianqin "그래서 무슨 일이 있었어?"


translate japanese plot7_d04b9c13:



    voice "voice/yangxi_527.ogg"
    yangxi "사실 나도 자세히는 몰라. 반장이랑 왔을 때는 이미 구경하는 애들이 모여 있었거든."


translate japanese plot7_87f5f02f:



    voice "voice/yangxi_528.ogg"
    yangxi "무슨 일인지는 걔들한테 들었어."


translate japanese plot7_507684a5:



    voice "voice/tianqin_1675.ogg"
    tianqin "음…… 그래서?"


translate japanese plot7_26b56647:



    voice "voice/yangxi_529.ogg"
    yangxi "誰かがロッカーの中に血をぶちまけた。"


translate japanese plot7_b942db9a:



    voice "voice/tianqin_1676.ogg"
    tianqin "어? 그게 무슨 소리야?"


translate japanese plot7_cab5f253:



    voice "voice/yangxi_530.ogg"
    yangxi "페인트 뿌리는 거 알지?"


translate japanese plot7_c2a66ece:



    voice "voice/tianqin_1677.ogg"
    tianqin "아, 빚 받으러 온 사람들이 하는 것처럼……"


translate japanese plot7_6fdd3d7f:



    voice "voice/yangxi_531.ogg"
    yangxi "응. 그런 협박."


translate japanese plot7_c5f8e66a:



    voice "voice/yangxi_532.ogg"
    yangxi "그런데 여기서는 피를 썼어."


translate japanese plot7_1342c7c5:



    voice "voice/tianqin_1678.ogg"
    tianqin "에? 그런……"


translate japanese plot7_f310a5c6:



    voice "voice/yangxi_533.ogg"
    yangxi "しかもロッカーの中に流し込んで、入ってたものを全部びしょびしょにした。"


translate japanese plot7_9299a486:


    "히나타가 휴게실 한쪽에 늘어선 철제 사물함을 가볍게 두드렸다."


translate japanese plot7_e1b7db71:



    voice "voice/yangxi_534.ogg"
    yangxi "体育生が、普段荷物を入れておくロッカー。"


translate japanese plot7_6ed8c0eb:



    voice "voice/tianqin_1679.ogg"
    tianqin "じゃあ、クラスの件と関係あるってことは…鶴城のロッカーが…"


translate japanese plot7_1107b3ad:



    voice "voice/yangxi_535.ogg"
    yangxi "違う。鶴城じゃない。"


translate japanese plot7_d743d714:



    voice "voice/tianqin_1680.ogg"
    tianqin "えっ？"


translate japanese plot7_003cae85:



    voice "voice/yangxi_536.ogg"
    yangxi "鶴城といつも一緒にいる、あの二人。"


translate japanese plot7_0701bd08:



    voice "voice/tianqin_1784.ogg"
    tianqin "아——"


translate japanese plot7_cf021a1e:



    voice "voice/minying_10.ogg"
    minying "우리한테 묻지 말고 츠루기한테 직접 물어봐."


translate japanese plot7_cb87e703:



    voice "voice/xizhen_13.ogg"
    xizhen "주제 파악 좀 해."


translate japanese plot7_aaa0cad7:



    voice "voice/tianqin_1682.ogg"
    tianqin "그 둘이구나."


translate japanese plot7_0586323a:



    voice "voice/yangxi_537.ogg"
    yangxi "응."


translate japanese plot7_5489d932:



    voice "voice/tianqin_1683.ogg"
    tianqin "그럼 츠루기는……"


translate japanese plot7_efc62a18:



    voice "voice/yangxi_538.ogg"
    yangxi "鶴城のロッカーは無事。三人のロッカーは横に並んでるけど、鶴城のだけ何もされてない。"


translate japanese plot7_3d7fc9a8:



    voice "voice/yangxi_539.ogg"
    yangxi "でも、血がかかったかどうかはもう関係ない。三人全員に対する行為だ。"


translate japanese plot7_33f96137:



    voice "voice/tianqin_1684.ogg"
    tianqin "最初に見つけたのは誰？"


translate japanese plot7_4cfbf6d8:



    voice "voice/yangxi_540.ogg"
    yangxi "체육 특기생들이 준비운동을 마치고 옷을 갈아입으러 돌아왔다가 발견했대."


translate japanese plot7_ace32455:



    voice "voice/yangxi_541.ogg"
    yangxi "츠루기 일행도 거기 있었고."


translate japanese plot7_d4768763:



    voice "voice/yangxi_542.ogg"
    yangxi "それで、ここの悲鳴を聞いた生徒が大勢集まってきた…"


translate japanese plot7_5d9e90dd:



    voice "voice/tianqin_1685.ogg"
    tianqin "그럼 벌써 온 학교에 퍼졌겠네."


translate japanese plot7_f7c56216:



    voice "voice/yangxi_543.ogg"
    yangxi "うん。隠したくても、先生の耳には絶対入る。"


translate japanese plot7_87f667ce_1:



    voice "voice/tianqin_1686.ogg"
    tianqin "으음——"


translate japanese plot7_d4d270b7:


    "라이라는 휴게실을 한 바퀴 둘러보았다. 피가 잔뜩 남아 있어서 희진과 민영의 사물함은 금방 찾을 수 있었다."


translate japanese plot7_f3ce78d1:



    voice "voice/tianqin_1687.ogg"
    tianqin "그럼 좀 살펴볼까."


translate japanese plot7_8a8ad429:



    voice "voice/yangxi_544.ogg"
    yangxi "……갑자기 안경은 왜?"


translate japanese plot7_c26aa05e:



    voice "voice/tianqin_1688.ogg"
    tianqin "시노스가 준 거야. 마력을 감지할 수 있어."


translate japanese plot7_38719377:



    voice "voice/tianqin_1689.ogg"
    tianqin "여기는 어떨까……"


translate japanese plot7_b9163e2a:


    "라이라가 안경을 쓰자 새겨진 탐지 술식이 즉시 발동했다."


translate japanese plot7_3523ae15:


    "두 사물함에는 마력의 흔적이 뚜렷이 남아 있었다. 조금 전 흰쥐 표본보다 훨씬 강한 빛이었다."


translate japanese plot7_c3476254:



    voice "voice/tianqin_1690.ogg"
    tianqin "오! 잘 보여!"


translate japanese plot7_bf24199d:



    voice "voice/yangxi_545.ogg"
    yangxi "뭐가 보여?"


translate japanese plot7_d4c841fe:



    voice "voice/tianqin_1691.ogg"
    tianqin "여기 전부 시노스의 마력으로 빛나. 마도구를 가져간 사람이 한 짓이 틀림없어."


translate japanese plot7_8d13c785:



    voice "voice/yangxi_546.ogg"
    yangxi "……방식과 표적을 보면, 그 안경이 없어도 같은 사람의 짓인 건 알겠는데."


translate japanese plot7_ec3189df:



    voice "voice/tianqin_1692.ogg"
    tianqin "그거야 그렇지만……"


translate japanese plot7_87e3b4e5:



    voice "voice/banzhang_245.ogg"
    banzhang "저기……"


translate japanese plot7_3c99eabc:



    voice "voice/yangxi_547.ogg"
    yangxi "어!?"


translate japanese plot7_c062d2c4:



    voice "voice/tianqin_1693.ogg"
    tianqin "와, 반장!"


translate japanese plot7_876d4480:



    voice "voice/banzhang_246.ogg"
    banzhang "아, 죄송해요! 방해했나요?"


translate japanese plot7_50169b5f:



    voice "voice/banzhang_247.ogg"
    banzhang "곧 체육 선생님이 살펴보러 오실지도 몰라서 알려 드리려고……"


translate japanese plot7_c626c4f1:



    voice "voice/tianqin_1694.ogg"
    tianqin "알겠어. 우리도 막 끝났어."


translate japanese plot7_0c9b531c:



    voice "voice/banzhang_248.ogg"
    banzhang "あれ？ライラさんって、眼鏡をかけてたんですか？"


translate japanese plot7_96f64dce:



    voice "voice/tianqin_1695.ogg"
    tianqin "아, 이건…… 요즘 좀 근시가 생긴 것 같아서. 안경 쓰면 잘 보이거든……"


translate japanese plot7_5e5f86d6:



    voice "voice/banzhang_249.ogg"
    banzhang "그렇군요…… 단서는 좀 찾았어요?"


translate japanese plot7_3efb7fdc:



    voice "voice/tianqin_1696.ogg"
    tianqin "뭐라고 해야 하지…… 찾았다고 하면 찾은 것 같기도, 아닌 것 같기도……"


translate japanese plot7_8ae810b8:



    voice "voice/banzhang_250.ogg"
    banzhang "그, 그런가요……?"


translate japanese plot7_0816ec81:



    voice "voice/tianqin_1697.ogg"
    tianqin "아무튼 고마워, 반장. 네가 안 도와줬으면 들어오지도 못했을 거야."


translate japanese plot7_fd74ebc8:



    voice "voice/banzhang_251.ogg"
    banzhang "아뇨. 두 분께 도움이 되어서 다행이에요."


translate japanese plot7_bd53c685:



    voice "voice/tianqin_1698.ogg"
    tianqin "맞다, 반장. 여기 휴게실은 평소에 누가 들어올 수 있어?"


translate japanese plot7_b85e4e26:



    voice "voice/banzhang_252.ogg"
    banzhang "아, 그건……"


translate japanese plot7_566f5005:



    voice "voice/banzhang_253.ogg"
    banzhang "평소에는 문을 잠가 두지만, 체육 특기생들은 모두 열쇠를 갖고 있어요."


translate japanese plot7_f9eb09ee:



    voice "voice/tianqin_1699.ogg"
    tianqin "어? 전부?"


translate japanese plot7_632de80b:



    voice "voice/banzhang_254.ogg"
    banzhang "네. 개인 열쇠가 따로 있는 건 안의 사물함뿐이에요."


translate japanese plot7_bfa05b63:



    voice "voice/banzhang_255.ogg"
    banzhang "어…… 그럼 어떻게 사물함 안에 피를 넣었을까요……"


translate japanese plot7_f231ab45:



    voice "voice/banzhang_256.ogg"
    banzhang "설마 잠그지 않았던 걸까요……"


translate japanese plot7_0e3ed774:



    voice "voice/tianqin_1700.ogg"
    tianqin "그러게…… 그건 확실히 이상하네……"


translate japanese plot7_80a216b4:



    voice "voice/yangxi_548.ogg"
    yangxi "（마법을 썼으니까…）"


translate japanese plot7_32fbfff1:


    "희진과 민영의 사물함도 아마 잠겨 있었을 것이다. 하지만 마법이라면 쉽게 열 수 있다."


translate japanese plot7_c416e657:


    "라이라와 히나타는 같은 생각을 했지만, 물론 반장에게는 말할 수 없었다."


translate japanese plot7_8e7ce314_1:


    "딩동댕동――"


translate japanese plot7_b0cc676f:



    voice "voice/yangxi_549.ogg"
    yangxi "가자. 수업도 끝났어."


translate japanese plot7_eab8cfb5:



    voice "voice/yangxi_550.ogg"
    yangxi "このままいたら体育の先生に見つかる。委員長にも迷惑かかる。"


translate japanese plot7_a95af4ab:



    voice "voice/tianqin_1701.ogg"
    tianqin "맞아. 반장, 가자."


translate japanese plot7_df9bd45d_1:



    voice "voice/banzhang_257.ogg"
    banzhang "네."


translate japanese plot7_9f6a51fd:



    voice "voice/tianqin_1702.ogg"
    tianqin "――!"


translate japanese plot7_6983a4a7:



    voice "voice/tianqin_1703.ogg"
    tianqin "아, 잠깐—— 반장!"


translate japanese plot7_71c5463d:



    voice "voice/banzhang_258.ogg"
    banzhang "네? 왜 그러세요?"


translate japanese plot7_eea403cc:



    voice "voice/tianqin_1704.ogg"
    tianqin "아…… 아니, 아무것도 아냐."


translate japanese plot7_f854853d:



    voice "voice/banzhang_259.ogg"
    banzhang "네?"


translate japanese plot7_d51847a5:



    voice "voice/tianqin_1705.ogg"
    tianqin "（놓친 건가… 방금 잠깐 마력의 빛이 보인 것 같은데…）"


translate japanese plot7_1077b31c:



    voice "voice/yangxi_551.ogg"
    yangxi "꾸물거리지 마. 다음은 담임 수업이야."


translate japanese plot7_06977d42:



    voice "voice/tianqin_1706.ogg"
    tianqin "맞다! 깜빡할 뻔했네!"


translate japanese plot7_32eecb5b:



    voice "voice/tianqin_1707.ogg"
    tianqin "반장, 오늘 방과 후에도 교문 앞에서 만날까?"


translate japanese plot7_76d22a36:



    voice "voice/banzhang_260.ogg"
    banzhang "아, 수업 끝나면 먼저 운동장에서 조금 뛰려고 해요."


translate japanese plot7_ee9485a3:



    voice "voice/banzhang_261.ogg"
    banzhang "잠깐만 기다려 주실래요? 금방 끝나요."


translate japanese plot7_50e15506:



    voice "voice/tianqin_1708.ogg"
    tianqin "어? 훈련은 내일부터 아니었어?"


translate japanese plot7_d8897755:



    voice "voice/banzhang_262.ogg"
    banzhang "네. 미리 달리는 감각을 되찾고 싶어서요. 오늘 체육 시간 기록이 별로였거든요……"


translate japanese plot7_a0fdcf4b:



    voice "voice/tianqin_1709.ogg"
    tianqin "알겠어. 그럼 운동장에서 기다릴게."


translate japanese plot7_48dee84c:



    voice "voice/banzhang_263.ogg"
    banzhang "네! 고마워요."


translate japanese plot7_330df060:



    voice "voice/hunter_44.ogg"
    monolith "…"


translate japanese plot7_2581f477:



    voice "voice/hunter_45.ogg"
    monolith "【「동조」｜Synchro】."


translate japanese plot7_e292fab3:


    "검은 마녀는 줄기에 손을 대고 거목 안으로 자신의 마력을 흘려보냈다."


translate japanese plot7_d8d6a718:


    "하지만 불과 몇 초 만에 이상이 생겼다."


translate japanese plot7_0325a701:



    voice "voice/hunter_46.ogg"
    monolith "쳇."


translate japanese plot7_7b9bb314:


    "줄기 표면에 전격이 번쩍이며 손을 튕겨 내고 마력의 연결을 끊었다."


translate japanese plot7_ff7527e5:



    voice "voice/hunter_47.ogg"
    monolith "흥, 음흉한 늙은이 같으니……"


translate japanese plot7_d1d47a4a:


    "마녀가 올려다보자 거목의 수관은 바람에 맞춰 고요히 흔들리고 있었다."


translate japanese plot7_be507676:


    "낯익은 광경이었다."


translate japanese plot7_0b0ecb68:



    voice "voice/hunter_48.ogg"
    monolith 0101 "정말 똑같군. 그 세상의……"


translate japanese plot7_330df060_1:



    voice "voice/hunter_49.ogg"
    monolith "…"


translate japanese plot7_9cd62bed:



    voice "voice/hunter_50.ogg"
    monolith "드디어 시작인가."


translate japanese plot7_497b0698:


    "대마녀에게 도전하기 위해 얼마나 오랫동안 준비했던가."


translate japanese plot7_f184e18b:


    "십 년인가. 수십 년인가. 아니면 거의 백 년이 다 되었나."


translate japanese plot7_9bfa3b8e:


    "어쨌든 아직 마녀 마을에 있을 때 이 「기회」를 알아챈 순간부터 오늘을 위해 계획을 짜 왔다."


translate japanese plot7_58959063:



    voice "voice/hunter_51.ogg"
    monolith "참 오래도 걸렸군."


translate japanese plot7_f579d20a_1:


    "띠링, 띠링——"


translate japanese plot7_23859197:



    voice "voice/hunter_52.ogg"
    monolith "이번에는 또 뭐야?"


translate japanese plot7_9fce9b16:


    voice "voice/flame_42.ogg"
    ataset 0106 "군만두는 식초에 찍어? 간장에 찍어?"


translate japanese plot7_313d9100:



    voice "voice/hunter_53.ogg"
    monolith "……설마 재미로 전화한 건 아니겠지?"


translate japanese plot7_d2e60d0f:


    voice "voice/flame_43.ogg"
    ataset 0105 "들켰어? 헤헤~"


translate japanese plot7_837b73a9:



    voice "voice/hunter_54.ogg"
    monolith "えへへ、じゃない！　今朝だけでもう三回目！"


translate japanese plot7_b54b6f9b:


    voice "voice/flame_44.ogg"
    ataset 0104 "스마트폰이 너무 재밌단 말이야——"


translate japanese plot7_dd6b6aab:



    voice "voice/hunter_55.ogg"
    monolith "하아——"


translate japanese plot7_fda5224e:


    "「실수했군. 저 녀석에게 스마트폰을 사 주는 게 아니었어.」"


translate japanese plot7_1d8ca1d3:


    "검은 마녀는 그렇게 생각했다."


translate japanese plot7_f5c74ad5:


    "통신 마법에 쓰는 마력을 아끼고 싶었을 뿐인데. 마력의 제약이 사라지자 동료는 전보다 더 귀찮게 굴었다."


translate japanese plot7_531fc62c:



    voice "voice/hunter_56.ogg"
    monolith "지금 어디야?"


translate japanese plot7_7edbc50c:


    voice "voice/flame_45.ogg"
    ataset 0101 "아래 마트~ 같이 장 볼래?"


translate japanese plot7_4d94595d:



    voice "voice/hunter_57.ogg"
    monolith "……거기서 기다려."


translate japanese plot7_8e7ce314_2:


    "딩동댕동――"


translate japanese plot7_7f523a5a:



    voice "voice/tianqin_1710.ogg"
    tianqin "수업 끝났다——!"


translate japanese plot7_83a01157:



    voice "voice/tianqin_1711.ogg"
    tianqin "가자, 가자! 운동장에 반장 찾으러 가자!"


translate japanese plot7_1edf5a91:



    voice "voice/yangxi_552.ogg"
    yangxi "기다려. 아직 가방 안 챙겼어."


translate japanese plot7_fe83d716:



    voice "voice/tianqin_1712.ogg"
    tianqin "어? 챙길 만큼 꺼내 놨었어?"


translate japanese plot7_97b1f2b5:



    voice "voice/yangxi_553.ogg"
    yangxi "誰もがあんたみたいに、一日中カバンから教科書を出さないわけじゃない。"


translate japanese plot7_7ea38b8c:



    voice "voice/tianqin_1713.ogg"
    tianqin "아니거든! 수업 중에는 교과서 펴 놓고 잘 듣는 척해!"


translate japanese plot7_e24604e4:



    voice "voice/yangxi_554.ogg"
    yangxi "그래, 그래. 먼저 운동장에 가서 반장 찾아. 나도 금방 갈게."


translate japanese plot7_05e76701:



    voice "voice/tianqin_1714.ogg"
    tianqin "응—. 그럼 내가 먼저 갈게—."


translate japanese plot7_44bf10b7:



    voice "voice/tianqin_1715.ogg"
    tianqin "반장은 운동장에 있겠지——"


translate japanese plot7_5265059f:


    "마지막 시간은 자습이라 체육 특기생인 반장은 교실에서 자습하거나 운동장에서 자율 훈련하는 것 중에 고를 수 있었다."


translate japanese plot7_5c3e187e:


    "평소에는 교실에 남는 경우가 많았다. 하지만 오늘은 운동장을 뛰며 감각을 되찾을 생각이었다."


translate japanese plot7_8738ac92:



    voice "voice/tianqin_1716.ogg"
    tianqin "아, 있다!"


translate japanese plot7_064df2be:



    voice "voice/tianqin_1717.ogg"
    tianqin 0113 "…"


translate japanese plot7_69549fa3:



    voice "voice/banzhang_265.ogg"
    banzhang 0301 "아……"


translate japanese plot7_1578644b:



    voice "voice/tianqin_1718.ogg"
    tianqin 0102 "힘내——! 반장——!"


translate japanese plot7_e87ff77b:



    voice "voice/tianqin_1719.ogg"
    tianqin "수고했어—— 자, 물."


translate japanese plot7_f94f92ff:



    voice "voice/banzhang_266.ogg"
    banzhang "고마워요, 라이라 씨."


translate japanese plot7_eba67592:



    voice "voice/banzhang_267.ogg"
    banzhang "기다리게 해서 죄송해요."


translate japanese plot7_7f7c9f94:



    voice "voice/tianqin_1720.ogg"
    tianqin "전혀. 네가 달리는 모습에 넋을 잃고 있었는걸."


translate japanese plot7_2737ff99:



    voice "voice/banzhang_268.ogg"
    banzhang "네!? 그, 그런가요……"


translate japanese plot7_38c99637:



    voice "voice/banzhang_269.ogg"
    banzhang "그렇게 말씀하시니 좀 부끄럽네요……"


translate japanese plot7_4f88c569:



    voice "voice/tianqin_1721.ogg"
    tianqin "헤헤, 부끄러워할 것 없어."


translate japanese plot7_c46f6c40:



    voice "voice/tianqin_1722.ogg"
    tianqin "자습 시간 내내 달린 거야?"


translate japanese plot7_1a7dfd49:



    voice "voice/banzhang_270.ogg"
    banzhang "네, 맞아요."


translate japanese plot7_4cd82400:



    voice "voice/banzhang_271.ogg"
    banzhang "이상하게 오늘은 평소보다 훨씬 힘이 나요. 전혀 피곤하지 않아요."


translate japanese plot7_dee741ac:



    voice "voice/tianqin_1723.ogg"
    tianqin "오! 요 이틀 푹 쉬어서 피로가 풀렸나 봐!"


translate japanese plot7_8f1f60dc:



    voice "voice/banzhang_272.ogg"
    banzhang "네. 그럴지도 몰라요."


translate japanese plot7_653aacae:



    voice "voice/banzhang_273.ogg"
    banzhang "다만 체육 시간에는 기록이 별로여서……"


translate japanese plot7_f8293f71:



    voice "voice/tianqin_1724.ogg"
    tianqin "괜찮아. 너라면 다음 주 체육 시험도 분명 잘 볼 거야!"


translate japanese plot7_4a5d5a0a:



    voice "voice/banzhang_274.ogg"
    banzhang "고마워요. 그러면 좋겠네요."


translate japanese plot7_b46cf363:



    voice "voice/banzhang_275.ogg"
    banzhang "그런데 히나타 씨는요?"


translate japanese plot7_dcd6b31d:



    voice "voice/tianqin_1725.ogg"
    tianqin "어…… 아직 가방 챙기고 있었어."


translate japanese plot7_1defc51b:



    voice "voice/tianqin_1726.ogg"
    tianqin "그래도 곧 올 거야."


translate japanese plot7_aeb2086e:



    voice "voice/yangxi_555.ogg"
    yangxi "야—— 나 왔어——"


translate japanese plot7_3cf36c3a:



    voice "voice/yangxi_556.ogg"
    yangxi "갈까?"


translate japanese plot7_14eff6c7:



    voice "voice/tianqin_1727.ogg"
    tianqin "응, 가자! 그 커다란 나무를 보러!"


translate japanese plot7_1abfdae0:



    voice "voice/npc10_02.ogg"
    npc10 "안녕하세요——! 여러분, 또 접니다! 오늘은 룽화의 그 거목이 지금 어떤지 보여 드릴게요!"


translate japanese plot7_26531d92:



    voice "voice/npc10_03.ogg"
    npc10 "과학자들이 나무가 커진 원인을 밝혔습니다. 사실 저희 비료를 쓴 거였죠. 지금 아래 링크에서 구매하실 수 있습니다……"


translate japanese plot7_914ac6b3:



    voice "voice/npc12_02.ogg"
    npc12 "있지~ 나 배고파~"


translate japanese plot7_8ef1d279:



    voice "voice/npc13_02.ogg"
    npc13 "알았어. 먼저 입구에서 크레이프 사자."


translate japanese plot7_28a128d3:



    voice "voice/banzhang_276.ogg"
    banzhang "와…… 사람이 많네요."


translate japanese plot7_10ee6f47:



    voice "voice/tianqin_1728.ogg"
    tianqin "히나타랑 처음 왔을 때보다는 많이 줄었어."


translate japanese plot7_7fb87603:



    voice "voice/banzhang_277.ogg"
    banzhang "공원 주변에 작은 가게도 많이 생겼네요. 근처 길까지 전보다 막히는 것 같은데……"


translate japanese plot7_2c5361cd:



    voice "voice/tianqin_1729.ogg"
    tianqin "지구 위원회에서 여길 새 관광지로 만들 생각이래. 그래서 노점도 많이 나왔어."


translate japanese plot7_dd34d186:



    voice "voice/tianqin_1730.ogg"
    tianqin "저녁도 여기서 해결할 수 있겠네——!"


translate japanese plot7_d7c5df31:



    voice "voice/yangxi_557.ogg"
    yangxi "사람 너무 많아…… 돌아가고 싶다……"


translate japanese plot7_dabc4ace:



    voice "voice/tianqin_1731.ogg"
    tianqin "히나타, 조금만 참아!"


translate japanese plot7_f743798f:


    "이윽고 세 사람은 인파를 뚫고 공원 입구에 도착했다."


translate japanese plot7_8f1d12c8:


    "전에 있던 통제선 대신 바리케이드가 뿌리 주변을 둘러싸고 있었다."


translate japanese plot7_4abcff4e:


    "거목을 보호하기 위해 이제는 뿌리를 따라 줄기 근처까지 갈 수 없었다."


translate japanese plot7_cbc5d9a2:



    voice "voice/banzhang_278.ogg"
    banzhang "아…… 앞이 막혀 있네요."


translate japanese plot7_02ecacb6:



    voice "voice/banzhang_279.ogg"
    banzhang "여기까지밖에 못 가겠네요."


translate japanese plot7_bde47935:



    voice "voice/gt_06.ogg"
    npc14 "영차——"


translate japanese plot7_ebc62325:


    "라이라와 히나타는 바리케이드가 보이지도 않는다는 듯 가볍게 뛰어넘었다."


translate japanese plot7_8de1f3c8:



    voice "voice/banzhang_280.ogg"
    banzhang "네!? 라, 라이라 씨, 히나타 씨?"


translate japanese plot7_93771485:



    voice "voice/tianqin_1732.ogg"
    tianqin "응? 반장, 못 넘겠어?"


translate japanese plot7_47a06c9f:



    voice "voice/banzhang_281.ogg"
    banzhang "그, 그런 게 아니라…… 바리케이드는 들어가면 안 된다는 뜻이잖아요?"


translate japanese plot7_da2b63da:



    voice "voice/tianqin_1733.ogg"
    tianqin "괜찮아. 아무도 안 말려."


translate japanese plot7_7e6b5fb2:


    "라이라의 말대로 주변 사람들은 둘이 바리케이드를 넘는 데 관심도 없었다."


translate japanese plot7_48533036:


    "주변은 누가 무엇을 하는지 구분하기도 힘들 만큼 혼잡했다."


translate japanese plot7_2aa8a621:



    voice "voice/banzhang_282.ogg"
    banzhang "하, 하지만 이건 좀 곤란하지 않을까요……?"


translate japanese plot7_2d4e4a0a:



    voice "voice/tianqin_1734.ogg"
    tianqin "괜찮아, 반장. 아무도 눈치 못 채."


translate japanese plot7_1b682ed6:



    voice "voice/banzhang_283.ogg"
    banzhang "하지만…"


translate japanese plot7_cf01ce35:



    voice "voice/tianqin_1735.ogg"
    tianqin "あ、本当に嫌なら、この辺を見て回るだけでもいいよ。中には入らないね。"


translate japanese plot7_445357d6:



    voice "voice/banzhang_284.ogg"
    banzhang "그건……"


translate japanese plot7_008fbeef:



    voice "voice/banzhang_285.ogg"
    banzhang "……아뇨, 결정했어요."


translate japanese plot7_083b5d05:



    voice "voice/banzhang_286.ogg"
    banzhang "지금 갈게요."


translate japanese plot7_d0c91972:


    "반장은 중대한 결심이라도 한 듯 눈매를 날카롭게 가다듬었다. 육상 트랙에 섰을 때 같은 기백이 감돌았다."


translate japanese plot7_0c76d19b:



    voice "voice/banzhang_287.ogg"
    banzhang "영차——!"


translate japanese plot7_4016cb14:


    "바리케이드는 허리 높이밖에 안 되었다. 체육 특기생인 반장이 넘기에는 어렵지 않았다."


translate japanese plot7_97c7e752:



    voice "voice/banzhang_288.ogg"
    banzhang "하아… 하아…"


translate japanese plot7_ea222d4b:



    voice "voice/banzhang_289.ogg"
    banzhang "……해냈어요!"


translate japanese plot7_0efff8ce:



    voice "voice/tianqin_1736.ogg"
    tianqin "야호——!"


translate japanese plot7_0fcaaa07:



    voice "voice/yangxi_558.ogg"
    yangxi "体育大会じゃないんだから…"


translate japanese plot7_c7940a81:



    voice "voice/banzhang_290.ogg"
    banzhang "갑자기 긴장되네요. 누가 잡아서 밖으로 끌어내지는 않겠죠?"


translate japanese plot7_6707bf1e:



    voice "voice/tianqin_1737.ogg"
    tianqin "괜찮아. 아무도 신경 안 써."


translate japanese plot7_83b018ae:



    voice "voice/tianqin_1738.ogg"
    tianqin "그럼 이번에야말로 출발——!"


translate japanese plot7_672d7792:



    voice "voice/tianqin_1739.ogg"
    tianqin "목표는 거목의 밑동!"


translate japanese plot7_1742d4e7:


    "세 사람은 땅을 뚫고 나온 뿌리 위를 따라 거목의 밑동으로 향했다."


translate japanese plot7_2c6a5718:


    "라이라와 히나타는 두 번째라 길을 완전히 익혔다. 뒤따르는 반장은 흥미롭게 주변을 둘러보았다."


translate japanese plot7_5d3ef682:



    voice "voice/banzhang_291.ogg"
    banzhang "나무뿌리 위를 걷다니……"


translate japanese plot7_1bcf7e8a:



    voice "voice/tianqin_1740.ogg"
    tianqin "신기하지?"


translate japanese plot7_2a310c86:



    voice "voice/banzhang_292.ogg"
    banzhang ""


translate japanese plot7_de453e96:



    voice "voice/yangxi_559.ogg"
    yangxi "전문가들 말로는 이 나무 아직도 자라고 있대."


translate japanese plot7_3aa2558d:



    voice "voice/tianqin_1741.ogg"
    tianqin "뭐!? 정말!?"


translate japanese plot7_0546ed42:



    voice "voice/yangxi_560.ogg"
    yangxi "봐. 전에 왔을 때보다 뿌리가 높아졌어."


translate japanese plot7_f5b52e63:



    voice "voice/tianqin_1742.ogg"
    tianqin "듣고 보니 그런 것 같아!"


translate japanese plot7_885a532c:



    voice "voice/yangxi_561.ogg"
    yangxi "계속 자라면 뿌리가 공원 밖까지 뻗겠네."


translate japanese plot7_7b54670d:



    voice "voice/tianqin_1743.ogg"
    tianqin "그건 곤란한데. 조금 잘라야 하지 않을까?"


translate japanese plot7_429a687b:



    voice "voice/yangxi_562.ogg"
    yangxi "글쎄. 결론을 내려면 한동안 더 연구해야 하나 봐."


translate japanese plot7_07108411:



    voice "voice/yangxi_563.ogg"
    yangxi "지금은 각지의 전문가들이 이 나무를 연구하고 있어."


translate japanese plot7_6feb97d5:



    voice "voice/banzhang_293.ogg"
    banzhang "으악!"


translate japanese plot7_0bfa1508:



    voice "voice/tianqin_1744.ogg"
    tianqin "반장!?"


translate japanese plot7_ab34db2d:



    voice "voice/tianqin_1745.ogg"
    tianqin "괜찮아?"


translate japanese plot7_7ec74085:



    voice "voice/banzhang_294.ogg"
    banzhang "네. 발을 조금 헛디뎠을 뿐이에요……"


translate japanese plot7_3362057d:



    voice "voice/tianqin_1746.ogg"
    tianqin "조심해. 여기 꽤 높으니까 떨어지지 않게."


translate japanese plot7_7ff81d10:



    voice "voice/banzhang_295.ogg"
    banzhang "네. 조심할게요."


translate japanese plot7_bfd8dfe4:



    voice "voice/banzhang_296.ogg"
    banzhang "모든 게 신기해서…… 그만 발밑을 못 봤네요."


translate japanese plot7_3225b5c0:



    voice "voice/tianqin_1747.ogg"
    tianqin "알아, 알아. 여기 있으면 내가 작아진 기분이지."


translate japanese plot7_eeaec03f:



    voice "voice/banzhang_297.ogg"
    banzhang "후후. 딱 맞는 표현이네요, 라이라 씨."


translate japanese plot7_420cefd1_1:



    voice "voice/tianqin_1748.ogg"
    tianqin "그렇지!"


translate japanese plot7_704dae80:


    "라이라와 히나타가 처음 왔을 때보다 사람은 눈에 띄게 줄어 있었다."


translate japanese plot7_6df4b737:


    "하나는 「조회 수」로 먹고사는 인플루언서가 줄어든 탓이었다."


translate japanese plot7_2991fc34:


    "룽화의 거목은 매체마다 충분히 다룬 뒤라 인터넷에서 관심을 모으기 어려운 소재가 되었다."


translate japanese plot7_88cc5d81:


    "또 하나는 사람들이 거목에 느끼는 흥분이 가라앉았기 때문이다."


translate japanese plot7_403f1d5b:


    "요즘 세상에서는 2주만 지나도 한 가지 화제에 대한 열기가 식는다."


translate japanese plot7_4dca6156:


    "결국 룽화시 주민이 아니라면 이 나무가 있든 없든 생활에는 상관없었다."


translate japanese plot7_66034ac1:



    voice "voice/tianqin_1749.ogg"
    tianqin "아, 다 왔어. 이 앞이 나무 밑동이야."


translate japanese plot7_d7563ac5:



    voice "voice/banzhang_298.ogg"
    banzhang "오……"


translate japanese plot7_34397a2c:


    "굽이진 뿌리 위를 십여 분 걷고서야 세 사람은 거목의 밑동에 도착했다."


translate japanese plot7_913d81d7:


    "공원 중심부는 땅을 뚫고 솟은 거목에 완전히 점령당했다. 지금 모습으로는 한때 아름다운 공원이었다는 사실을 상상하기도 어려웠다."


translate japanese plot7_f87e5efd:


    "솟아오른 뿌리는 산책로와 잔디밭을 찢어 놓았고, 다른 공공시설도 무사하지 못했다."


translate japanese plot7_20509179:


    "뒤엉킨 뿌리에 막혀 중장비는 공원 안쪽으로 들어오지 못했다."


translate japanese plot7_8ee55964:


    "거목이 부순 건물은 철거도 하지 못한 채 뿌리 틈에 끼인 폐허가 되어 있었다."


translate japanese plot7_648faf97:



    voice "voice/tianqin_1750.ogg"
    tianqin "전에 히나타랑 왔을 땐 급해서 공원이 이렇게 망가진 줄 몰랐어."


translate japanese plot7_114d4df5:



    voice "voice/yangxi_564.ogg"
    yangxi "사람이 살지 않는 중앙공원에 생긴 게 불행 중 다행이야."


translate japanese plot7_0f0fa847:



    voice "voice/yangxi_565.ogg"
    yangxi "주택가에 생겼으면 어땠을지 상상도 못 하겠어."


translate japanese plot7_cf7d78b4:



    voice "voice/banzhang_299.ogg"
    banzhang "왠지 좀 황폐해 보이네요……"


translate japanese plot7_5da6b56a:


    voice "voice/npc3_13.ogg"
    npc51 "거기, 너희들!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot7_3ac602b7:


    "갑자기 뒤에서 누군가 불러 세웠다."


translate japanese plot7_8853ec49:


    "세 사람이 돌아보니 흰 가운을 입은 연구원이 서 있었다."


translate japanese plot7_aba1a60c:



    voice "voice/npc35_01.ogg"
    npc35 "そこで何してるの！ここは観光客立入禁止！"


translate japanese plot7_70eb67a8:



    voice "voice/yangxi_566.ogg"
    yangxi "아, 안녕하세요. 저희는 관광객이 아니라 룽화 제1고등학교 원예부원이에요."


translate japanese plot7_3ba4d907:



    voice "voice/npc35_02.ogg"
    npc35 "어? 그런데 왜 여기 있어?"


translate japanese plot7_9bfae98d:


    "몰래 들어온 관광객은 아닌 듯하자 연구원의 말투가 조금 부드러워졌다."


translate japanese plot7_07801acc:



    voice "voice/yangxi_567.ogg"
    yangxi "저희 동아리에서 이 거목을 연구하고 있어요. 그래서 현장 조사를 하려고요."


translate japanese plot7_f2584d51:



    voice "voice/yangxi_568.ogg"
    yangxi "학생증이에요."


translate japanese plot7_979222dd:



    voice "voice/npc35_03.ogg"
    npc35 "음…… 정말 룽화 1고 학생이네……"


translate japanese plot7_00ef7030:



    voice "voice/npc35_04.ogg"
    npc35 "그래도 동아리 활동이라고 마음대로 들어오면 안 돼."


translate japanese plot7_326aa797:



    voice "voice/npc35_05.ogg"
    npc35 "허가 없이는 나무에 가까이 갈 수 없어. 구경은 밖에서 해."


translate japanese plot7_e5afe39d:



    voice "voice/yangxi_569.ogg"
    yangxi "죄송해요. 북문으로 들어왔는데 길에 안내가 없어서 그만……"


translate japanese plot7_ba5cd473:



    voice "voice/npc35_06.ogg"
    npc35 "하아…… 경비원들 또 자리를 비웠네."


translate japanese plot7_9f9008cb:



    voice "voice/npc35_07.ogg"
    npc35 "아까부터 관광객이 들어와서 일을 방해하더라니."


translate japanese plot7_699ffe7b:



    voice "voice/yangxi_570.ogg"
    yangxi "저희는 정말 이 나무에 관심이 있어요. 꼭 가까이서 관찰하고 싶어서요."


translate japanese plot7_1ae6bce7:



    voice "voice/yangxi_571.ogg"
    yangxi "한 번만 보내 주시면 안 될까요?"


translate japanese plot7_fe597be3:



    voice "voice/npc35_08.ogg"
    npc35 "……알겠어. 일하는 데 방해만 하지 마."


translate japanese plot7_f9344a3d:



    voice "voice/npc35_09.ogg"
    npc35 "이 앞에서는 조금 돌아가. 저쪽은 데이터를 모으는 곳이라 장치도 많이 있거든. 케이블 밟지 않게 조심해."


translate japanese plot7_67fbd2c8:



    voice "voice/yangxi_572.ogg"
    yangxi "고맙습니다. 조심할게요."


translate japanese plot7_68fd6986:



    voice "voice/yangxi_573.ogg"
    yangxi "후…… 어떻게든 넘어갔네……"


translate japanese plot7_84c4e4d6:



    voice "voice/tianqin_1751.ogg"
    tianqin "역시 히나타! 숨 쉬듯 거짓말하네!"


translate japanese plot7_3789a9d5:



    voice "voice/yangxi_574.ogg"
    yangxi "그거 칭찬 아니지."


translate japanese plot7_db1a359a:



    voice "voice/banzhang_300.ogg"
    banzhang "깜짝 놀랐어요…… 쫓겨날 줄 알았는데……"


translate japanese plot7_6eecda8a:



    voice "voice/tianqin_1752.ogg"
    tianqin "괜찮아. 이럴 때 히나타는 믿을 만하거든."


translate japanese plot7_293a7d93:



    voice "voice/yangxi_575.ogg"
    yangxi "これ以上言われると、委員長に悪人だと思われそうなんだけど…"


translate japanese plot7_be46bcd9:



    voice "voice/yangxi_576.ogg"
    yangxi "난 사실대로 말했을 뿐이야. 나쁜 짓 하러 온 것도 아니잖아."


translate japanese plot7_a4667b65:



    voice "voice/yangxi_577.ogg"
    yangxi "성의를 보이고 말하면 상대도 그렇게 엄하게 굴지는 않아."


translate japanese plot7_0932f09f:



    voice "voice/yangxi_578.ogg"
    yangxi "그래도 가장 잘 먹힌 건 이 학생증이지. 이게 없었으면 그렇게 쉽게 보내 주지 않았을 거야."


translate japanese plot7_e074d848:



    voice "voice/yangxi_579.ogg"
    yangxi "명문 학교 간판도 아직 쓸 만하네."


translate japanese plot7_15bec38c:


    "세 사람은 곧 연구원이 말한 곳에 도착했다."


translate japanese plot7_1f1fd24b:


    "줄기 근처에 뿌리가 만든 작은 발판이었다. 온갖 전자기기가 빼곡하게 늘어서 뿌리에 박힌 전극 패드와 이어져 있었다."


translate japanese plot7_c24c1b7c:


    "연구원 몇 명이 기기 사이를 바쁘게 오가며 거목의 여러 데이터를 모았다."


translate japanese plot7_cada3822:


    "연구원들은 일행을 보고도 아무 말 없이 불쾌한 표정으로 가까이 오지 말라는 눈짓만 한 뒤 다시 기기로 고개를 돌렸다."


translate japanese plot7_1e9ee675:



    voice "voice/yangxi_580.ogg"
    yangxi "前に来た時は何もなかったのに。もう設備でいっぱい。"


translate japanese plot7_6fd47a92:



    voice "voice/yangxi_581.ogg"
    yangxi "저렇게 큰 기기는 어떻게 들여왔지? 설마 사람이 직접……?"


translate japanese plot7_83e5ff99:



    voice "voice/banzhang_301.ogg"
    banzhang "다들 굉장히 바빠 보이세요."


translate japanese plot7_c6bda02d:



    voice "voice/yangxi_582.ogg"
    yangxi "うん。この樹、学術界ではとんでもなく貴重な研究対象だから。"


translate japanese plot7_d44ca6a4:



    voice "voice/yangxi_583.ogg"
    yangxi "전 세계 연구자들이 여기서 모으는 데이터를 기다리고 있어."


translate japanese plot7_b3790c4d:



    voice "voice/banzhang_302.ogg"
    banzhang "저희가 방해되는 건 아닐까요?"


translate japanese plot7_2399c94a:



    voice "voice/yangxi_584.ogg"
    yangxi "막지는 않잖아. 연구원들 피해서 지나가면 돼."


translate japanese plot7_df9bd45d_2:



    voice "voice/banzhang_303.ogg"
    banzhang "네."


translate japanese plot7_d3acbf25:


    "연구원들로 붐비는 발판을 피해 세 사람은 거목의 밑동으로 왔다."


translate japanese plot7_1218b4fc:


    "구경꾼이 사라진 밑동에는 고요하고 팽팽한 공기만 남아 있었다."


translate japanese plot7_7ba1665d:


    "거목 자체가 주위에 말없는 압박을 주는 것 같았다."


translate japanese plot7_2b417101:


    "거대물 공포증이 없어도 거대한 것을 보면 본능적으로 불안을 느끼는 사람이 많다."


translate japanese plot7_44cb126f:


    "평소 익숙한 것일수록 있을 수 없는 크기가 되면 불안을 자극한다."


translate japanese plot7_9f482a5c:



    voice "voice/banzhang_304.ogg"
    banzhang "텔레비전으로 볼 때보다 훨씬 압도되네요……"


translate japanese plot7_6861419f:



    voice "voice/tianqin_1753.ogg"
    tianqin "언제 봐도 정말 크다."


translate japanese plot7_c4b18c0e:



    voice "voice/yangxi_585.ogg"
    yangxi "이젠 세상 어떤 건물보다 높아."


translate japanese plot7_0c54a5f7:



    voice "voice/tianqin_1754.ogg"
    tianqin "어, 정말? {a=dictionary:dict_entry_77}아시아 타워{/a}보다 높아?"


translate japanese plot7_bae4007e:



    voice "voice/yangxi_586.ogg"
    yangxi "응. 아시아 타워보다 백 미터쯤 높대."


translate japanese plot7_b6417e30:



    voice "voice/tianqin_1755.ogg"
    tianqin "와—— 나무가 이렇게 높고 크게 자랄 수 있구나. 줄기도 이렇게 굵고……"


translate japanese plot7_2d8f3265:



    voice "voice/yangxi_587.ogg"
    yangxi "이젠 평범한 자연법칙으로는 설명할 수 없지만."


translate japanese plot7_36923c65:



    voice "voice/banzhang_305.ogg"
    banzhang "…"


translate japanese plot7_d3d55187:


    "반장은 줄기에 손을 대고 거친 껍질을 느끼며 살며시 쓰다듬었다."


translate japanese plot7_658d5945:



    voice "voice/banzhang_306.ogg"
    banzhang "신기해요. 이렇게 큰 나무가 있다니……"


translate japanese plot7_b915b844:



    voice "voice/banzhang_307.ogg"
    banzhang "이 나무 앞에 있으면 우리가 아주 작게 느껴져요……"


translate japanese plot7_1361cf03:



    voice "voice/banzhang_308.ogg"
    banzhang "한 사람 한 사람의 처지도, 경험도, 고민도……"


translate japanese plot7_726cd142:



    voice "voice/banzhang_309.ogg"
    banzhang "전부 아무래도 상관없어지는 것처럼……"


translate japanese plot7_996f722b:



    voice "voice/gt_07.ogg"
    npc14 "…"


translate japanese plot7_e15e04eb:



    voice "voice/banzhang_310.ogg"
    banzhang "아, 죄송해요! 이상한 말을 했네요……"


translate japanese plot7_c20ee29b:



    voice "voice/tianqin_1756.ogg"
    tianqin "괜찮아, 반장. 신경 안 써."


translate japanese plot7_ab40b5bc:



    voice "voice/yangxi_588.ogg"
    yangxi "넌 그런 느낌이 드는구나."


translate japanese plot7_a411ba74:



    voice "voice/banzhang_311.ogg"
    banzhang "죄송해요. 왜 그런지 저도 잘 모르겠어요……"


translate japanese plot7_6f9561bd:



    voice "voice/banzhang_312.ogg"
    banzhang "저…… 전에도 어디선가 이 나무를 본 적이 있는 것 같아요……"


translate japanese plot7_3b964ea1:



    voice "voice/tianqin_1757.ogg"
    tianqin "ええー？こんな大きな樹、どこにあるのか。"


translate japanese plot7_b487420a:



    voice "voice/yangxi_589.ogg"
    yangxi "「데자뷔」 아냐? 뇌가 보여 주는 착각 같은 거."


translate japanese plot7_fbc9f833:



    voice "voice/tianqin_1758.ogg"
    tianqin "오! 반장, 꿈에서 비슷한 풍경을 봤나?"


translate japanese plot7_3bf0dc25:



    voice "voice/banzhang_313.ogg"
    banzhang "음…… 저도 모르겠어요."


translate japanese plot7_404b08bc:



    voice "voice/banzhang_314.ogg"
    banzhang "그냥 갑자기 너무 그리운 느낌이 들어서……"


translate japanese plot7_42f245cf:


    "반장은 거목을 바라보았다. 눈에는 무언가를 그리워하는 듯한 빛이 떠올랐다."


translate japanese plot7_b882fe24:


    "산들바람에 가지가 흔들리며 무성한 잎 사이로 이따금 햇살이 비쳤다."


translate japanese plot7_1e39d63b:


    "나는 언제 이 풍경을 보았을까."


translate japanese plot7_be8a2ee5:



    voice "voice/tianqin_1759.ogg"
    tianqin "오늘은 관광객이 거의 안 들어와서 다행이야."


translate japanese plot7_47096140:



    voice "voice/tianqin_1760.ogg"
    tianqin "여기가 본격적으로 관광지가 되면 이렇게 한가롭게 못 돌아보겠지."


translate japanese plot7_5ef01d1d:



    voice "voice/tianqin_1761.ogg"
    tianqin "入口みたいに、観光客でいっぱいになるよ。"


translate japanese plot7_5903ead0:



    voice "voice/yangxi_590.ogg"
    yangxi "아니. 일반에 공개돼도 줄기 주변은 아마 계속 막아 둘걸."


translate japanese plot7_a2497aca_1:



    voice "voice/tianqin_1762.ogg"
    tianqin "えっ？どうして？"


translate japanese plot7_309e2933:



    voice "voice/yangxi_591.ogg"
    yangxi "분명 나무껍질에 이름 같은 거 새기는 사람이 나올 테니까."


translate japanese plot7_a7bb8247:



    voice "voice/yangxi_592.ogg"
    yangxi "막으려면 줄기 주변에 못 오게 하는 수밖에 없어."


translate japanese plot7_d6016fab:



    voice "voice/tianqin_1763.ogg"
    tianqin "아…… 듣고 보니 그렇네."


translate japanese plot7_b2faed35:



    voice "voice/yangxi_593.ogg"
    yangxi "이렇게 가까이 오는 건 오늘이 마지막일지도 모르겠다."


translate japanese plot7_1a631462:



    voice "voice/banzhang_315.ogg"
    banzhang "저기, 두 분!"


translate japanese plot7_f0e2e7e7:



    voice "voice/tianqin_1764.ogg"
    tianqin "ん？"


translate japanese plot7_e04ed6c6:



    voice "voice/banzhang_316.ogg"
    banzhang "오늘 정말 여기 데려와 주셔서 고마워요."


translate japanese plot7_9603bef7:



    voice "voice/banzhang_317.ogg"
    banzhang "사실 저…… 계속 이 거목을 보고 싶었어요."


translate japanese plot7_1d68b37a:



    voice "voice/banzhang_318.ogg"
    banzhang "전에 라이라 씨가 같이 가자고 했을 때는 망설여졌어요."


translate japanese plot7_17f72ad3:



    voice "voice/banzhang_319.ogg"
    banzhang "뭐랄까… 다들 앞에서는 「반장」다워야 하니까, 남들보다 더 참아야 한다고 생각했거든요."


translate japanese plot7_37e0aca4:



    voice "voice/banzhang_320.ogg"
    banzhang "이해하실지 모르겠지만, 그날도 사실은 두 분을 따라가고 싶었어요……"


translate japanese plot7_e4bd372c:



    voice "voice/banzhang_321.ogg"
    banzhang "ここ数日、二人と過ごした放課後はとても楽しかったです。今日は、前に来られなかった心残りもなくなりました。本当にありがとうございます。"


translate japanese plot7_0371c0f4:



    voice "voice/tianqin_1765.ogg"
    tianqin "아이, 반장. 그렇게 어려워하지 않아도 돼. 우린 그냥 놀 곳이나 찾는 불량 학생인걸."


translate japanese plot7_61698199:



    voice "voice/banzhang_322.ogg"
    banzhang "불량 학생이라…… 후후. 두 분의 고등학교 생활이야말로 제가 동경한 것이었을지도 모르겠어요."


translate japanese plot7_f57b4719:



    voice "voice/banzhang_323.ogg"
    banzhang "두 분에 비하면 전 정말 딱딱한 사람이네요."


translate japanese plot7_978cf146:



    voice "voice/tianqin_1766.ogg"
    tianqin "반장, 그렇지 않아."


translate japanese plot7_b1709ad4:



    voice "voice/tianqin_1767.ogg"
    tianqin "나랑 히나타는 이제 남들이 못마땅하게 보는 데 익숙해졌거든."


translate japanese plot7_06031025:



    voice "voice/tianqin_1768.ogg"
    tianqin "ほかの人の評価とか見方とか、私たちにはどうでもいいの。"


translate japanese plot7_5eba1ebe:



    voice "voice/tianqin_1769.ogg"
    tianqin "넌 그걸 너무 신경 쓰는 것 같아. 그래서 계속 스스로를 틀에 가두는 거고."


translate japanese plot7_7d4d8de1:



    voice "voice/tianqin_1770.ogg"
    tianqin "다들 바라는 네 모습 말고, 네가 되고 싶은 네 모습이 되면 돼."


translate japanese plot7_b3fa45cd:



    voice "voice/banzhang_324.ogg"
    banzhang "……그런 걸까요."


translate japanese plot7_13155c41_1:



    voice "voice/banzhang_325.ogg"
    banzhang "저는…"


translate japanese plot7_eb918df3:



    voice "voice/tianqin_1771.ogg"
    tianqin "아, 미안! 내가 너무 내 생각만 말했나 봐!"


translate japanese plot7_62e16b04:



    voice "voice/tianqin_1772.ogg"
    tianqin "너한테는 네 사정이 있는데. 내가 훈계할 입장도 아니지."


translate japanese plot7_9576fc06:



    voice "voice/banzhang_326.ogg"
    banzhang "아뇨, 그게 아니에요. 전 그냥……"


translate japanese plot7_59ca4f5f:



    voice "voice/banzhang_327.ogg"
    banzhang "두 분이랑 좀 더 일찍 친구가 됐으면 좋았겠다고 생각했어요."


translate japanese plot7_bb04f492:



    voice "voice/banzhang_328.ogg"
    banzhang "전…… 두 분의 자유로운 사고방식을 배우고 싶었을지도 몰라요."


translate japanese plot7_f49ba76b:



    voice "voice/banzhang_329.ogg"
    banzhang "더 일찍 친구가 됐다면 저도 더 빨리 바뀔 수 있었을지도…"


translate japanese plot7_bfb4596d:



    voice "voice/tianqin_1773.ogg"
    tianqin "지금부터 바뀌어도 늦지 않아."


translate japanese plot7_0e6e8d9d:



    voice "voice/banzhang_330.ogg"
    banzhang "네?"


translate japanese plot7_e5593cfa:



    voice "voice/tianqin_1774.ogg"
    tianqin "언제 바뀌든 너무 늦은 때는 없어."


translate japanese plot7_5da17050:



    voice "voice/tianqin_1775.ogg"
    tianqin "바뀐다는 건 성장한다는 거니까!"


translate japanese plot7_f5054ae2:



    voice "voice/tianqin_1776.ogg"
    tianqin "반장, 뭔가 하고 싶으면 과감하게 움직여야 해."


translate japanese plot7_d2d80270:



    voice "voice/banzhang_331.ogg"
    banzhang "……네!"


translate japanese plot7_f8bdb14e:



    voice "voice/banzhang_332.ogg"
    banzhang "라이라 씨 말대로 지금부터 바뀌어도 늦지 않을지 몰라요!"


translate japanese plot7_3e3a1a37:



    voice "voice/tianqin_1777.ogg"
    tianqin "헤헤. 좀 부끄럽네. 나 혼자 이상한 말만 잔뜩 했어."


translate japanese plot7_bc1dd9d5:



    voice "voice/banzhang_333.ogg"
    banzhang "아뇨. 라이라 씨 말이 맞다고 생각해요."


translate japanese plot7_3c208626:



    voice "voice/banzhang_334.ogg"
    banzhang "저도 라이라 씨를 본받고 싶어요."


translate japanese plot7_80853644:



    voice "voice/tianqin_1778.ogg"
    tianqin "응. 도움이 됐다면 나도 기뻐!"


translate japanese plot7_b9a74fd9:


    "세 사람이 공원을 나설 무렵에는 주변이 완전히 어두워져 있었다."


translate japanese plot7_39e8f0ca:



    voice "voice/tianqin_1779.ogg"
    tianqin "후——! 오늘은 여기까지 할까."


translate japanese plot7_157b876b:



    voice "voice/tianqin_1780.ogg"
    tianqin "委員長、明日もどこか遊びに行こうよ。また面白そうな場所、思いついたんだ。"


translate japanese plot7_5ae25ff8:



    voice "voice/banzhang_335.ogg"
    banzhang "고마워요, 라이라 씨. 하지만 내일은 선생님과 약속해서 훈련에 참가하기로 했거든요……"


translate japanese plot7_e45f26ce:



    voice "voice/tianqin_1781.ogg"
    tianqin "하루쯤 더 쉬면 안 돼? 며칠 쉬었는데 하루 늘어도 똑같잖아."


translate japanese plot7_7f3d5d8b:



    voice "voice/banzhang_336.ogg"
    banzhang "すみません、ライラさん。そろそろ気持ちを引き締めて、調子を戻さないと。"


translate japanese plot7_e34f4ccb:



    voice "voice/banzhang_337.ogg"
    banzhang "다음 주에 {a=dictionary:dict_entry_78}체육 특기생 종합시험{/a}이 있으니 제대로 준비하고 싶어요."


translate japanese plot7_4729618d:



    voice "voice/tianqin_1782.ogg"
    tianqin "아, 그렇구나. 아쉽다."


translate japanese plot7_cd9b0140:



    voice "voice/tianqin_1783.ogg"
    tianqin "그럼 나중에 시간 있을 때 또 놀자!"


translate japanese plot7_7644e1d0:



    voice "voice/banzhang_338.ogg"
    banzhang "네. 요 며칠 정말 감사했어요. 생각하는 방식이 많이 달라진 것 같아요."


translate japanese plot7_afef15d8:



    voice "voice/banzhang_339.ogg"
    banzhang "그러고 보니 다음 주에는 {a=dictionary:dict_entry_79}월례 시험{/a}도 있어요. 두 분 다 준비되셨나요?"


translate japanese plot7_0701bd08_1:



    voice "voice/tianqin_1784.ogg"
    tianqin "あー…"


translate japanese plot7_5837b7ce:



    voice "voice/yangxi_594.ogg"
    yangxi "……굳었네. 방금 떠올랐나 봐."


translate japanese plot7_903ba604:



    voice "voice/banzhang_340.ogg"
    banzhang "후후. 그럼 이번 주말에는 복습 열심히 하셔야겠네요, 라이라 씨."




translate japanese plot7_b23b7636:


    voice "voice/yangxi_455.ogg"
    yangxi "중간부터 계속 음이 틀렸거든, 바보야!" with Shake((0, 0, 0, 0), 0.5, dist=8)



translate japanese plot7_b398432a:


    voice "<volume 4.0>voice/banzhang_186.ogg"
    banzhang "♪――" (interact=False, ctc=None, screen="plot7_singing_say")



translate japanese plot7_8b1816d8:


    voice "<volume 4.0>voice/banzhang_187.ogg"
    banzhang "♪～～" (interact=False, ctc=None, screen="plot7_singing_say")



translate japanese plot7_b4a48764:


    voice "voice/tianqin_1543.ogg"
    tianqin 0102 "첫 노래방은 어땠어?"



translate japanese plot7_c068ca12:


    voice "voice/tianqin_1562.ogg"
    tianqin 0103 "어, 벌써? 일주일쯤 쉬는 줄 알았어."



translate japanese plot7_c64e139b:


    voice "voice/banzhang_236.ogg"
    banzhang 0111 "라이라 씨——"



translate japanese plot7_b0a936e2:


    voice "voice/yangxi_521.ogg"
    yangxi 0104 "라이라, 여기."



translate japanese plot7_69d7b7dc:


    voice "voice/yangxi_534.ogg"
    yangxi 0101 "체육 특기생들이 평소 짐을 넣어 두는 사물함이야."



translate japanese plot7_e994b2dd:


    voice "voice/tianqin_1679.ogg"
    tianqin 0110 "그럼 우리 반 일과 관계 있다는 건…… 츠루기 사물함이……"



translate japanese plot7_8ab6c5da:


    voice "voice/yangxi_535.ogg"
    yangxi 0104 "아냐. 츠루기는 아니야."



translate japanese plot7_eb495f05:


    voice "voice/tianqin_1680.ogg"
    tianqin 0113 "어?"



translate japanese plot7_e6a3c627:


    voice "voice/tianqin_1681.ogg"
    tianqin 0103 "아——"



translate japanese plot7_7f69e0a2:


    voice "voice/tianqin_1764.ogg"
    tianqin 0113 "응?"



translate japanese plot7_dc66b282:


    voice "voice/yangxi_393.ogg"
    yangxi "무슨 소리야. 학생이면 당연한 거지."



translate japanese plot7_4537cfef:


    voice "voice/tianqin_1410.ogg"
    tianqin "그게…… 얼마 전에 출석률이 위험하다고 들었거든. 더 빠지면 진짜 유급이야."



translate japanese plot7_a76131d5:


    voice "voice/hecheng_119.ogg"
    hecheng "어차피 곧 지나갈 일이야. 그렇게 걱정하지 않아도 돼."



translate japanese plot7_dcc9ed6a:


    voice "voice/hecheng_126.ogg"
    hecheng "다만…… 이번에는 그 녀석들이 이렇게 배짱 좋을 줄 몰랐지."



translate japanese plot7_f69618e6:


    voice "voice/hecheng_130.ogg"
    hecheng "찾으면 절대 가만두지 않을 거야."



translate japanese plot7_ed62da93:


    voice "voice/hecheng_136.ogg"
    hecheng "라이라. 내 일에는 더 이상 끼어들지 마."



translate japanese plot7_62627c6d:


    voice "voice/hecheng_138.ogg"
    hecheng "다른 볼일 없으면 먼저 갈게."



translate japanese plot7_ff28d3a9:


    voice "voice/yangxi_411.ogg"
    yangxi "편지를 몰랐다면 얘길 듣고도 「그게 뭔데」 하고 끝났겠지. 라이라를 피할 이유가 없어."



translate japanese plot7_a6a921cf:


    voice "voice/yangxi_412.ogg"
    yangxi "게다가 태도가 바뀐 건 편지를 말한 다음이잖아. 알고 있다고 자백한 셈이지."



translate japanese plot7_ebed9b52:


    voice "voice/yangxi_415.ogg"
    yangxi "츠루기도 반에서 나름 지위가 있잖아. 그런 일을 당했다는 게 본인한테는 엄청난 수치일 거야."



translate japanese plot7_8e8d8efd:


    voice "voice/yangxi_417.ogg"
    yangxi "도움이 아니라 동정으로 느껴지니까."



translate japanese plot7_a6e06198:


    voice "voice/yangxi_419.ogg"
    yangxi "아직 전부는 몰라. 츠루기의 성격이랑 지금 있는 정보로 생각해 보는 것뿐이야."



translate japanese plot7_fcb6ffeb:


    voice "voice/yangxi_420.ogg"
    yangxi 0101 "우선 반응을 보면 편지에 대해서는 확실히 알아."



translate japanese plot7_c54bf5d9:


    voice "voice/yangxi_421.ogg"
    yangxi "그런 일을 당한 건 처음일 테니까 무서웠겠지."



translate japanese plot7_e04a63b1:


    voice "voice/yangxi_423.ogg"
    yangxi 0101 "남몰래 도움은 받고 싶지만, 약한 모습은 절대로 보이기 싫은 거지."



translate japanese plot7_9b4e671e:


    voice "voice/banzhuren_120.ogg"
    banzhuren "서두르면 츠루기가 마음을 닫을 수도 있어. 그러면 다시는 남에게 도움을 청하지 않겠지. 괴롭히는 쪽이 바라는 대로 되는 거야."



translate japanese plot7_6f60cf8e:


    voice "voice/tianqin_1461.ogg"
    tianqin "알겠어요…… 도울 일이 있으면 언제든 말씀해 주세요."



translate japanese plot7_6433d8de:


    voice "voice/banzhuren_131.ogg"
    banzhuren 0104 "지난주에 반 아이 중 누군가가 츠루기에게 심한 장난을 쳤어요. 바로 뒤에 그 편지가 왔으니 연관 짓지 않기가 어렵죠."



translate japanese plot7_ad4d67ef:


    voice "voice/jinlaoshi_60.ogg"
    jinlaoshi "제가 처음 부임했을 때, 작년에 체육 특기생들 사이에서 괴롭힘이 있었다는 소문을 들었잖아요?"



translate japanese plot7_b9601b63:


    voice "voice/banzhuren_134.ogg"
    banzhuren "아, 그랬죠."



translate japanese plot7_ed246f5d:


    voice "voice/banzhuren_135.ogg"
    banzhuren "결국 소문뿐이었어요. 실종 사건을 계기로 말만 퍼진 것 같더라고요."



translate japanese plot7_b0c8493a:


    voice "voice/tianqin_1474.ogg"
    tianqin "에이, 하루쯤 빼먹어도 별일 없어."



translate japanese plot7_aec2dec9:


    voice "voice/yangxi_437.ogg"
    yangxi "곧 나오는 옷."



translate japanese plot7_723e90fb:


    voice "voice/yangxi_441.ogg"
    yangxi "괜찮아. 나랑 라이라는 원래 자주 빠지니까. 한두 명 없어도 모르셔."



translate japanese plot7_fdce415e:


    voice "voice/yangxi_445.ogg"
    yangxi "그럼. 아무도 가고 싶은 데 없으니까 오늘은 해산."



translate japanese plot7_52c544c8:


    voice "voice/yangxi_449.ogg"
    yangxi "그러네…… 정말 오랜만이네."



translate japanese plot7_74167d3f:


    voice "voice/yangxi_458.ogg"
    yangxi "그것도 전부 부모님 세대의 옛날 노래. 취향이 너무 낡았어."



translate japanese plot7_93bf84b5:


    voice "voice/yangxi_469.ogg"
    yangxi "반 애들 얘기에 끼고 싶으면 『문큐트』 두 번째 시리즈부터 추천해."



translate japanese plot7_234fc2d9:


    voice "voice/yangxi_470.ogg"
    yangxi "두 번째가 제일 보기 편해. 캐릭터는 화려하지 않아도 이야기에 엄청 빠져들거든!"



translate japanese plot7_4bb68c9d:


    voice "voice/banzhang_195.ogg"
    banzhang "아직 가슴이 두근거려요. 노래하는 게 이렇게 설레는 거군요."



translate japanese plot7_0c63c15b:


    voice "voice/yangxi_478.ogg"
    yangxi 0104 "재밌군. 『문큐트』를 향한 궁극의 사랑을 품은 나에게 도전하겠다는 건가?"



translate japanese plot7_c5392dba:


    voice "voice/banzhang_202.ogg"
    banzhang "구…… 구십팔 점!"



translate japanese plot7_ebac856c:


    voice "voice/banzhang_214.ogg"
    banzhang "노래방에 계속 안 좋은 인상을 갖고 있었다면 절대로 들어오려 하지 않았을 거예요."



translate japanese plot7_bacb9335:


    voice "voice/yangxi_490.ogg"
    yangxi "나도 다시 연습할 거야. 다음에는 꼭 네 점수를 넘겠어."



translate japanese plot7_92e73020:


    voice "voice/banzhang_218.ogg"
    banzhang "모레부터는 체육 특기생 훈련에 돌아가거든요."



translate japanese plot7_4ef66b4e:


    voice "voice/tianqin_1578.ogg"
    tianqin "마법을 쓰면 안에 든 것까지 타 버려!"



translate japanese plot7_237d3079:


    voice "voice/tianqin_1605.ogg"
    tianqin "지금 네가 할 수 있는 건 과거의 잘못을 어떻게 속죄할지 생각하는 게 아닐까?"



translate japanese plot7_58d200bc:


    nvlNone "드디어 마을 여관에서 쉴 수 있다."



translate japanese plot7_ed7b1792:


    nvlNone "마녀 유적의 일을 해결한 뒤\n며칠이나 야영했는지 이제는 세지도 않았다."



translate japanese plot7_bd355581:


    nvlNone "準備はしてあったけど、野宿はやっぱり不便が多い。"



translate japanese plot7_1163eb9e:


    nvlNone "적어도 오늘 밤은 깨끗한 옷으로 갈아입고 적당히 단단한 침대에서 잘 수 있다."



translate japanese plot7_06773f2d:


    nvlNone "용사를 조금 놀려 먹으니\n기분이 조금 좋아졌다."



translate japanese plot7_0487d81c:


    nvlNone "彼女は、私が出会った中で最も謎めいた冒険者だ。何を考えているのか、まるで読めない。"



translate japanese plot7_3c388559:


    nvlNone "하지만 그녀에게는 나도 마찬가지겠지."



translate japanese plot7_270c141b:


    nvlNone "서로 어렴풋이 알고 있다.\n아마 나와 그녀는 닮은 사람들이다."



translate japanese plot7_062556df:


    nvlNone "용사의 질문에 조금 화가 났다. 세상은 늘 별 읽기 학파를 이런 식으로 바라본다."



translate japanese plot7_b971a689:


    nvlNone "별 읽기 학파 따위는 믿을 수 없는 점술일 뿐이라고 생각한다.\n참으로 무지한 생각이다."



translate japanese plot7_870b8a96:


    nvlNone "ところが勇者は、この話を深く掘り下げるつもりなど最初からなく、あっさり謝った。"



translate japanese plot7_79f8bb8c:


    nvlNone "でも、その声には妙に含みがあった。私にこれ以上話させたくないだけらしい。"



translate japanese plot7_e44bdbf4:


    voice "voice/equinox_107.ogg"
    equinox "수천 년을 사는 장수종이 우연히 마녀가 되어도 마법의 이치를 끝까지 탐구하기에는 너무 짧아. 입구에도 못 설지 몰라."



translate japanese plot7_c3b9dcdc:


    voice "voice/equinox_111.ogg"
    equinox "맞아. 계약하는 순간부터 우리는 더는 인간이 아니야."



translate japanese plot7_60700fbd:


    voice "voice/equinox_116.ogg"
    equinox "비밀도 아냐. 간단히 말하면 육체를 마나 상태로 보존하는 거야……"



translate japanese plot7_2b2fc1e2:


    voice "voice/yangxi_496.ogg"
    yangxi "평범하게 고등학교 졸업하고 평범한 대학에 가면 그걸로 돼요."



translate japanese plot7_47363023:


    voice "voice/jinlaoshi_84.ogg"
    jinlaoshi "그래…… 그래도 역시 아깝구나."



translate japanese plot7_ed1d1b1e:


    voice "voice/yangxi_503.ogg"
    yangxi "이야기도 네 번째만큼 어둡지는 않지만, 두 번째도 깊이가 상당해. 적 간부도 한 명 한 명 제대로 다뤄 주고……"



translate japanese plot7_1be98ff7:


    voice "voice/yangxi_504.ogg"
    yangxi "게다가 두 번째는 오프닝이랑 엔딩도 정말 좋아. 삽입곡도 전부 명곡이고."



translate japanese plot7_eaa23638:


    voice "voice/yangxi_508.ogg"
    yangxi "나도 애니메이션을 꽤 많이 봤어. 기억나는 것만 이백 편쯤."



translate japanese plot7_10c0ff16:


    voice "voice/banzhang_231.ogg"
    banzhang "그렇군요. 그럼 추천해 주신 대로 두 번째 시리즈부터 끝까지 볼게요."



translate japanese plot7_c53f0e74:


    voice "voice/yangxi_513.ogg"
    yangxi "어차피 체육 시험도 못 보니까 수업에 나오든 말든 똑같다고 생각하나 봐."



translate japanese plot7_1c003be7:


    voice "voice/tianqin_1610.ogg"
    tianqin "그런데 놀라울 정도로 맛이 없는 거야! 파르페에 생크림을 산더미처럼 넣어서 얼마나 느끼하던지."



translate japanese plot7_3bf0552f:


    voice "voice/tianqin_1612.ogg"
    tianqin "이상하게 줄이 엄청 길더라고. 그 앞에 다른 새 밀크티 집이 있었거든."



translate japanese plot7_730212d8:


    voice "voice/tianqin_1620.ogg"
    tianqin "아니. 기분 좀 바꾸려고 오늘은 도수 없는 안경."



translate japanese plot7_384355a3:


    voice "voice/tianqin_1630.ogg"
    tianqin "음료는 달아야 맛있는 게 당연하잖아."



translate japanese plot7_661cbe44:


    voice "voice/keke_99.ogg"
    keke "뭐가 이상해? 유럽에서는 다들 그렇게 마시잖아."



translate japanese plot7_1fa35fb9:


    voice "voice/tianqin_1636.ogg"
    tianqin "엄청 이상한 맛일 것 같은데…… 난 못 마실지도."



translate japanese plot7_62290e61:


    voice "voice/tianqin_1639.ogg"
    tianqin "맞다! 그 가게 사실 숨겨진 메뉴가 있어. 토핑 없이 밀크티를 시키면……"



translate japanese plot7_8e93eba8:


    voice "voice/keke_109.ogg"
    keke 0104 "찾았어―? 내 표본장 어지르지 마세요."



translate japanese plot7_2828941e:


    voice "voice/tianqin_1652.ogg"
    tianqin "（츠루기 책상에 있던 흰쥐와 원예부에 나온 흰쥐는 역시 연결되어 있어… 이젠 틀림없겠지.）"



translate japanese plot7_330dfbf1:


    voice "voice/tianqin_1671.ogg"
    tianqin "괜찮아! 빨리 살펴볼 테니까 밖에서 기다려."



translate japanese plot7_98424a4b:


    voice "voice/yangxi_533.ogg"
    yangxi 0101 "게다가 사물함 안으로 부어서 물건을 전부 흠뻑 적셔 놨어."



translate japanese plot7_4d97e0de:


    voice "voice/yangxi_538.ogg"
    yangxi "츠루기 사물함은 멀쩡해. 셋이 나란히 있는데 츠루기 것만 아무 일도 없어."



translate japanese plot7_dd0d52df:


    voice "voice/yangxi_543.ogg"
    yangxi "응. 숨기고 싶어도 선생님 귀에는 꼭 들어가겠지."



translate japanese plot7_7222ef49:


    voice "voice/banzhang_248.ogg"
    banzhang "어? 라이라 씨, 안경 쓰셨어요?"



translate japanese plot7_89506a00:


    voice "voice/yangxi_553.ogg"
    yangxi "누구나 너처럼 온종일 가방에서 교과서도 안 꺼내는 건 아니거든."



translate japanese plot7_1fd03fef:


    voice "voice/tianqin_1735.ogg"
    tianqin "아, 정말 싫으면 이 근처만 돌아봐도 돼. 안 들어갈게."



translate japanese plot7_5f6d10bf:


    voice "voice/npc35_01.ogg"
    npc35 "거기서 뭐 하는 거야! 여긴 관광객 출입 금지야!"



translate japanese plot7_98424ada:


    voice "voice/yangxi_575.ogg"
    yangxi "더 말하면 반장이 나 나쁜 사람인 줄 알겠는데……"



translate japanese plot7_683e1526:


    voice "voice/yangxi_582.ogg"
    yangxi "응. 학계에서는 이 나무가 엄청 귀중한 연구 대상이거든."



translate japanese plot7_abcb6915:


    voice "voice/tianqin_1761.ogg"
    tianqin "입구처럼 관광객으로 가득할 거야."



translate japanese plot7_63c74e8d:


    voice "voice/banzhang_321.ogg"
    banzhang "요 며칠 같이 보낸 방과 후는 정말 즐거웠어요. 오늘은 전에 못 와서 아쉬웠던 마음도 풀렸고요. 정말 고마워요."



translate japanese plot7_6f403515:


    voice "voice/tianqin_1768.ogg"
    tianqin "남들의 평가나 시선은 아무래도 상관없어."



translate japanese plot7_693f7343:


    voice "voice/tianqin_1780.ogg"
    tianqin "반장, 내일도 어디 놀러 가자. 또 재밌을 만한 곳이 생각났어."



translate japanese plot7_0041354a:


    voice "voice/banzhang_336.ogg"
    banzhang "미안해요, 라이라 씨. 슬슬 마음을 다잡고 컨디션을 되찾아야 해요."


translate japanese plot7_970ea014:

    nvlNone "준비는 해 뒀지만, 역시 노숙은 불편한 점이 많다."


translate japanese plot7_935f10fc:

    nvlNone "그녀는 내가 만난 모험가 중 가장 수수께끼 같은 사람이었다. 무슨 생각을 하는지 도무지 읽을 수 없었다."


translate japanese plot7_1aa7447e:

    nvlNone "그런데 용사는\n처음부터 이 얘기를 깊이 파고들 생각은 없었다는 듯 순순히 사과했다."


translate japanese plot7_6432da5e:

    nvlNone "하지만 목소리에는 묘한 뜻이 담겨 있었다.\n내가 더 말하지 못하게 하려는 모양이었다."


translate japanese plot7_a344f59f:


    voice "voice/hecheng_122.ogg"
    hecheng "라이라, 날 너무 얕보는 거 아니야?"



translate japanese plot7_a6f3f2d2:


    voice "voice/hecheng_131.ogg"
    hecheng "네가 나보다 더 긴장했네."



translate japanese plot7_9846c5ff:


    voice "voice/hecheng_137.ogg"
    hecheng "선생님한테도 아무 말 하지 마…… 내 문제는 내가 해결할 거야."



translate japanese plot7_8931d87f:


    voice "voice/yangxi_426.ogg"
    yangxi "먼저 담임한테 말씀드려."



translate japanese plot7_a08072c9:


    voice "voice/banzhuren_110.ogg"
    banzhuren "음…… 츠루기가 그렇게 말했구나……"



translate japanese plot7_81476030:


    voice "voice/tianqin_1463.ogg"
    tianqin "윽…… 아, 아마 이제 안 빼먹을…… 걸요? 아하하……"



translate japanese plot7_56436847:


    voice "voice/yangxi_431.ogg"
    yangxi "걔는 싫다고 할 것 같은데……"



translate japanese plot7_2c586e99:


    voice "voice/tianqin_1470.ogg"
    tianqin "괜찮아! 나한테 맡겨!"



translate japanese plot7_c6dd297a:


    voice "voice/yangxi_447.ogg"
    yangxi "다들 가고 싶은 데가 없으면 집에 가는 게 제일 편하잖아."



translate japanese plot7_7afbd8d1:


    voice "voice/tianqin_1495.ogg"
    tianqin "집순이…… 실내……"



translate japanese plot7_73c78cd3:


    voice "voice/banzhang_170.ogg"
    banzhang "두 분이 데려와 주지 않았다면 요즘 노래방이 어떤 곳인지 계속 몰랐을지도 모르겠어요."



translate japanese plot7_ab4e3011:


    voice "voice/tianqin_1519.ogg"
    tianqin "하지만 좋은 노래잖아? 명곡이라고 생각 안 해?"



translate japanese plot7_8c9d677d:


    voice "voice/yangxi_459.ogg"
    yangxi "명곡으로 음을 틀리는 게 더 어렵겠다."



translate japanese plot7_e6b1baab:


    voice "voice/yangxi_461.ogg"
    yangxi "이번에는 나야."



translate japanese plot7_9b823d6d:


    voice "voice/banzhang_177.ogg"
    banzhang "네!?"



translate japanese plot7_a37a58e5:


    voice "voice/tianqin_1525.ogg"
    tianqin "갑자기 영업하지 마!"



translate japanese plot7_ea242f78:


    voice "voice/banzhang_193.ogg"
    banzhang "정말…… 신기해요!"



translate japanese plot7_1d4a4cb1:


    voice "voice/yangxi_486.ogg"
    yangxi "반장! 다음에도 같이 노래방 와!"



translate japanese plot7_ff2db319:






translate japanese plot7_aa4a19d8:



    voice "voice/tianqin_1396.ogg"
    tianqin "세――――이프!"


translate japanese plot7_6087aa26:



    voice "voice/tianqin_1397.ogg"
    tianqin "안 늦었지?"


translate japanese plot7_6b4b572e:



    voice "voice/yangxi_391.ogg"

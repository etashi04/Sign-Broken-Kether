translate japanese plot6_ring_detail_hold_d971abd7:



    voice "voice/cygnus_887.ogg"
    cygnus "크윽――!!"


translate japanese plot6_ring_detail_hold_63b47864:



    voice "voice/cygnus_888.ogg"
    cygnus "（――방금 그건 뭐였지? 이것도 내 기억이야?）"


translate japanese plot6_ring_detail_hold_f58df87a:


    "시노스는 잠에서 벌떡 깨어났다. 강한 오한이 밀려왔다. 방금 꿈에서 본 광경을 믿을 수 없었다."


translate japanese plot6_ring_detail_hold_e53c0eb0:



    voice "voice/cygnus_889.ogg"
    cygnus "（마녀의 처형장? 그럴 리가…）"


translate japanese plot6_ring_detail_hold_bec78e25:



    voice "voice/blackcat_04.ogg"
    blackcat "흐음~?"


translate japanese plot6_ring_detail_hold_6a3cd5b4:



    voice "voice/cygnus_890.ogg"
    cygnus "아냐, 그럴 리 없어……"


translate japanese plot6_ring_detail_hold_b8c963d2:



    voice "voice/cygnus_891.ogg"
    cygnus "내가… 왜…"


translate japanese plot6_ring_detail_hold_84fbaf72:



    voice "voice/blackcat_08.ogg"
    blackcat "재밌는 일을 떠올린 모양이구나."


translate japanese plot6_ring_detail_hold_279eb6d8:



    voice "voice/cygnus_892.ogg"
    cygnus "시끄러워!!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot6_ring_detail_hold_3838d4de:



    voice "voice/tianqin_1272.ogg"
    tianqin "후우―― 하아――"


translate japanese plot6_ring_detail_hold_c2c356a2:



    voice "voice/tianqin_1273.ogg"
    tianqin "피곤해——!"


translate japanese plot6_ring_detail_hold_4883516c:



    voice "voice/tianqin_1274.ogg"
    tianqin "너무 오랜만에 전력을 썼더니 온몸에서 뚝뚝 소리가 나는 것 같아……"


translate japanese plot6_ring_detail_hold_7c3d118c:



    voice "voice/tianqin_1275.ogg"
    tianqin "학교 가기 싫다……"


translate japanese plot6_ring_detail_hold_936c4298:



    voice "voice/cygnus_893.ogg"
    cygnus "…"


translate japanese plot6_ring_detail_hold_769ab5b0:



    voice "voice/tianqin_1276.ogg"




translate japanese plot6_14e7daf0:


    nvlNone "라이라는 시노스를 히나타에게 맡기고,\n스스로 그레임 앞을 막아섰다."


translate japanese plot6_187da17f:


    nvlNone "시노스가 놀라움에서 벗어나기도 전에――"


translate japanese plot6_b16839d5:


    nvlNone "쿵…… 쿵——"


translate japanese plot6_deb60659:


    nvlNone "쿵—— 쿵—— 쿵——"


translate japanese plot6_979add8c:


    nvlNone "무언가 맥박치는 소리였다."


translate japanese plot6_b6a97f4c:


    nvlNone "주변 공기마저 그 소리에 들썩였다."


translate japanese plot6_f1e14898:


    nvlNone "쿵——!"


translate japanese plot6_a096716d:


    nvlNone "곧 시노스는 알아차렸다."


translate japanese plot6_f1e14898_1:


    nvlNone "쿵——!"


translate japanese plot6_4fd36019:


    nvlNone "라이라의 심장이 오랜만에 전력을 다해 뛰기 시작했다."


translate japanese plot6_b523383d:


    nvlNone "피가 엄청난 속도로 온몸을 돌았다."


translate japanese plot6_f1e14898_2:


    nvlNone "쿵——!"


translate japanese plot6_cdf583c8:


    nvlNone "혈류가 빨라지며,\n몸속에 비축된 에너지가 온몸으로 전달된다."


translate japanese plot6_5fa59d23:


    nvlNone "평소 억눌려 있던 라이라의 근육이,\n지금 그 족쇄에서 풀려난다."


translate japanese plot6_96cd90a9:


    nvlNone "힘줄과 근외막, 근섬유가 차례로 늘어났다."


translate japanese plot6_f1e14898_3:


    nvlNone "쿵——!"


translate japanese plot6_67ee9bfe:


    nvlNone "흥분. 고양감. 뛰는 가슴. 끓어오르는 피…"


translate japanese plot6_b16371ab:


    nvlNone "온몸의 세포가 환성을 질렀다."


translate japanese plot6_f1e14898_4:


    nvlNone "쿵——!"


translate japanese plot6_c59a3994:


    nvlNone "한편, 단련으로 익힌 {a=dictionary:dict_entry_48}{font=SourceHanSerifSC-Regular.otf}호흡법{/font}{/a}이라면,\n온몸의 세포에 충분한 산소를 보낼 수 있다."


translate japanese plot6_9096116b:


    nvlNone "라이라가 이런 상태에 들어간 것은,\n언니와 수련하던 때뿐이었다."


translate japanese plot6_a49566c6:


    nvlNone "그 이름은 『무아』."


translate japanese plot6_090fa32c:


    nvlNone "쾅!"


translate japanese plot6_4344eadf:


    nvlNone "빠르게 올려친 주먹이 음속을 돌파하며 엄청난 굉음을 냈다."


translate japanese plot6_24b75e03:


    nvlNone "거대한 팔 아래에서 라이라는 이미 주먹을 거둔 뒤였다."


translate japanese plot6_8b3fb325:



    voice "voice/tianqin_001204.ogg"
    nvlNone "「덤벼.」"


translate japanese plot6_f4c3bd79:


    nvlNone "극도의 흥분에서 빠르게 마음을 가다듬는 것.\n수없이 반복한 수련의 결과였다."


translate japanese plot6_a928f39c:


    nvlNone "자제한 데 대한 보상인 양, 뇌 안에 넘쳐흐르는 도파민이 그녀를 더 큰 환희로 감쌌다."


translate japanese plot6_7d7cb66a:



    voice "voice/yangxi_00309.ogg"
    nvlNone "「음, 저런 모습은 오랜만이네.」"


translate japanese plot6_a1669cb5:


    nvlNone "라이라와 함께 온 소녀가 그 모습을 보고 나직이 말했다."


translate japanese plot6_71a2e166:


    nvlNone "시노스는 이해할 수 없었다."


translate japanese plot6_ddefcc56:


    nvlNone "어떻게 라이라가 그레임의 거대한 주먹을 받아 냈지?"


translate japanese plot6_aaa349c9:


    nvlNone "방금 무엇이 그레임의 팔을 튕겨 낸 거야?"


translate japanese plot6_e030cbc6:


    nvlNone "어째서 라이라가 나를 위기에서 구해 낸 거지?"


translate japanese plot6_71a2e166_1:


    nvlNone "시노스는 이해할 수 없었다."


translate japanese plot6_e6787220:


    nvlNone "이 세계에 존재할 리 없는\n그레임을 앞에 두고――"


translate japanese plot6_9318e8c0:


    nvlNone "라이라와 함께 온 소녀의 얼굴에 담긴 것은 단 하나. 흔들림 없는 신뢰였다."


translate japanese plot6_7709d8d1:


    nvlNone "「라이라한테 맡기면 괜찮아.」"


translate japanese plot6_b48e8c9c:


    nvlNone "근거 없는 신뢰… 아니, 오만이라고 해야 할까."


translate japanese plot6_80ae856b:


    nvlNone "대체 어떻게 된 걸까?"


translate japanese plot6_71a2e166_2:


    nvlNone "시노스는 이해할 수 없었다."


translate japanese plot6_70d04dab:


    nvlNone "자신이 의지해 온 논리가 뿌리째 박살 나는 듯한 감각."


translate japanese plot6_617f4d7c:


    nvlNone "끼기기기기기긱————!" with Shake((0, 0, 0, 0), 0.3, dist=5)


translate japanese plot6_5ef0985d:


    nvlNone "하지만 그레임은 시노스가 생각할 틈을 주지 않았다."


translate japanese plot6_a0392e67:


    nvlNone "팔이 튕겨 나간 그레임은 즉시 다음 공격에 나섰다."


translate japanese plot6_26587dbe:


    nvlNone "내장된 행동 규칙에 따라,\n그 자리에 있는 세 사람 모두를 적으로 판단했다."


translate japanese plot6_8b5c1e86:


    nvlNone "첫 번째 표적은 가장 앞에 선 라이라였다."


translate japanese plot6_1ae69c7f:


    nvlNone "「…」"


translate japanese plot6_7122c106:


    nvlNone "얼굴에는 별다른 표정이 없었다."


translate japanese plot6_9a9c65cc:


    nvlNone "담담함? 평온함?"


translate japanese plot6_b91334e5:


    nvlNone "하지만 라이라가 무표정해지는 것 자체가 드문 일이었다."


translate japanese plot6_82c1612d:


    nvlNone "끼기긱————!" with Shake((0, 0, 0, 0), 0.3, dist=5)


translate japanese plot6_d22ddd2d:


    nvlNone "한쪽 팔로 부족하다면 양팔로."


translate japanese plot6_7db36626:


    nvlNone "이번에는 그레임이 두 팔을 들어 올렸다."


translate japanese plot6_3af9b7b3:


    nvlNone "그레임의 공격 수단 자체는 다양하지 않았다."


translate japanese plot6_1becdf6b:


    nvlNone "두 팔을 휘두르거나 대상을 짓밟는 정도였다."


translate japanese plot6_c6a7acd9:


    nvlNone "왜냐하면 그만큼 강했으니까."


translate japanese plot6_22b9d524:


    nvlNone "미궁을 지키든, 공성전의 주력이 되든――"


translate japanese plot6_00510bf3:


    nvlNone "그레임은 단단한 외갑만으로 대부분의 공격을 막아 냈다."


translate japanese plot6_d468cad9:


    nvlNone "힘 또한 모든 것을 짓부수기에 충분했다."


translate japanese plot6_a0da5bb9:


    nvlNone "콰앙——!!!"


translate japanese plot6_0f7d8e9f:


    nvlNone "앞쪽에서 다시 굉음이 터졌다."


translate japanese plot6_4a69d836:


    nvlNone "그레임의 양팔이 라이라가 선 곳을 내리쳤다."


translate japanese plot6_09133cd5:



    voice "voice/cygnus_00831.ogg"
    nvlNone "「으——!」"


translate japanese plot6_46fc3102:


    nvlNone "시노스는 고개를 돌렸다."


translate japanese plot6_3f04379a:


    nvlNone "라이라가 거대한 양팔에 짓눌려 곤죽이 되는 광경은 차마 볼 수 없었다."


translate japanese plot6_f43ce2b0:


    nvlNone "라이라가 예상처럼 곤죽이 되지는 않을 것 같았다."


translate japanese plot6_58f89638:


    nvlNone "잠깐의 숨 돌릴 틈을 타\n시노스는 마력을 조금 모았다."


translate japanese plot6_9e22485a:


    nvlNone "그 마력을 눈과 귀에 모아 시력과 청력을 강화했다."


translate japanese plot6_51823abb:


    nvlNone "라이라에 대한 호기심은,\n이미 그레임의 위협마저 넘어서 있었다."


translate japanese plot6_25d16e7c:


    nvlNone "먼지가 걷혔다."


translate japanese plot6_5dd851c5:


    nvlNone "그레임의 두 팔이 또다시 허공에 멈춰 있었다."


translate japanese plot6_4b3983cd:


    nvlNone "이번에는 시노스도 똑똑히 보았다."


translate japanese plot6_74f15ea4:


    nvlNone "충격에 라이라 주변의 땅이 움푹 파인 것이 보였다."


translate japanese plot6_ced09250:


    nvlNone "그런데 어째서 라이라는 그레임의 공격을 버틸 수 있는 걸까?"


translate japanese plot6_29c12082:



    voice "voice/tianqin_001206.ogg"
    nvlNone "「영차——!」"


translate japanese plot6_fb0e9af5:


    nvlNone "끼기기긱————!"


translate japanese plot6_fb0e9af5_1:


    nvlNone "끼기기긱————!"


translate japanese plot6_f4c9d536:


    nvlNone "갑자기 가해진 힘에 거구의 그레임이 순간 균형을 잃었다."


translate japanese plot6_23013684:


    nvlNone "하지만 다음 순간, 라이라가 눈앞으로 다가왔다."


translate japanese plot6_fa584a27:


    nvlNone "그레임은 대여섯 걸음 물러나 라이라와 십 미터나 떨어져 있었지만,{p}라이라는 순식간에 그 거리를 좁혔다."


translate japanese plot6_540f8937:


    nvlNone "숨 한 번, 아니 눈 한 번 깜빡할 사이에 벌어진 일이었다.{p}라이라는 순간이동하듯 그레임 앞에 나타났다."


translate japanese plot6_e8ba26f0:


    voice "voice/cygnus_00832.ogg"
    nvlNone "「――!」"


translate japanese plot6_57bb8f15:


    nvlNone "라이라가 오른발로 힘껏 땅을 박차자, 몸이 허공을 미끄러지듯 나아갔다."


translate japanese plot6_fb76d668:


    nvlNone "시노스는 무언가를 떠올렸다."


translate japanese plot6_268d0fe6:



    voice "voice/dorothea_0009.ogg"
    nvlNone "「……이렇게 하면 단번에 상대에게 다가갈 수 있어!」"


translate japanese plot6_b7a2afd6:


    nvlNone "기억 속의 소녀는 그렇게 말하고 직접 시범을 보였다."


translate japanese plot6_db15dc28:


    nvlNone "한쪽 발로 땅을 박차기만 했는데도,\n보통 사람은 상상도 못 할 거리를 순식간에 내달린다."


translate japanese plot6_012b84c2:


    nvlNone "{a=dictionary:dict_entry_49}{font=SourceHanSerifSC-Regular.otf}『축지』{/font}{/a}다."


translate japanese plot6_75ff3390:


    nvlNone "하지만 이름이 무엇인지는 이제 중요하지 않았다."


translate japanese plot6_f7848c6f:


    nvlNone "자기보다 열 배도 넘게 큰 그레임에게 제 발로 다가가는 사람이 있을까?"


translate japanese plot6_95bf1dca:


    nvlNone "하지만 시노스가 보기에는."


translate japanese plot6_f2995c51:


    nvlNone "라이라는 진작 죽었어도 이상하지 않았다. 그것도 두 번이나."


translate japanese plot6_d41d8cd9:


    voice "voice/tianqin_001207.ogg"


translate japanese plot6_3aadd16d:


    nvlNone "「후우…」"


translate japanese plot6_38fdbe9f:


    nvlNone "라이라는 그레임 앞에 멈춰 서서,\n깊게 숨을 들이쉬었다."


translate japanese plot6_1db647e3:


    nvlNone "그녀는 몸의 모든 근육을 제어하며\n최대한 힘을 빼고 이완시켰다."


translate japanese plot6_3677dc14:


    nvlNone "몸은 물처럼 유연해져,\n공기 속으로, 땅속으로 녹아들어 간다…"


translate japanese plot6_5a9d81d0:



    voice "voice/tianqin_001208.ogg"
    nvlNone "합!"


translate japanese plot6_ecf41a3e:


    nvlNone "다음 호흡에 그녀는 온몸의 근육을\n한꺼번에 팽팽하게 긴장시켰다."


translate japanese plot6_f42e66cd:


    nvlNone "머리, 목, 손, 몸통, 다리.{p}다섯 지점이 일직선으로 이어져,\n동시에 힘을 폭발시킨다." (**end_page())


translate japanese plot6_6423bfe8:


    nvlNone "부드러움의 극치에서 단단함의 극치로―― 모아 둔 힘이 주먹을 통해 폭발했다." (**end_page())


translate japanese plot6_d41d8cd9_1:


    nvl clear


translate japanese plot6_f67b6d73:


    nvlNone "쾅——!!!" (what_slow_cps=0) with Shake((0, 0, 0, 0), 0.5, dist=10)


translate japanese plot6_09133cd5_1:



    voice "voice/cygnus_00833.ogg"
    nvlNone "「으——!」"


translate japanese plot6_9f8de538:


    nvlNone "옆에 있던 시노스도 놀라 움찔했다."


translate japanese plot6_f69a731b:


    nvlNone "강화된 청력 덕분에\n그녀는 방금 소리가 한 번이 아니었음을 구별했다."


translate japanese plot6_04f73218:


    nvlNone "세 번."


translate japanese plot6_b71bb385:


    nvlNone "너무나도 빨랐기에,\n세 발이 한 번의 타격음으로 겹쳐 들린 것이다."


translate japanese plot6_69c2b791:


    nvlNone "첫 주먹은 머리."


translate japanese plot6_a1c181ac:


    nvlNone "그레임의 몸에서도 비교적 약한 부위라,\n순식간에 얼음 조각이 되어 부서져 흩어졌다."


translate japanese plot6_edf78cdd:


    nvlNone "그런데 이 그레임은 높이가 무려 사오 미터였다."


translate japanese plot6_982d332a:


    nvlNone "시력을 강화한 시노스의 눈에도,\n희미한 잔상밖에 보이지 않았다."


translate japanese plot6_318612eb:


    nvlNone "二発目。左肩。"


translate japanese plot6_efb3fede:


    nvlNone "砲のような拳が、グレームの左肩へ叩き込まれた。"


translate japanese plot6_5876000e:


    nvlNone "爆発じみた衝撃が、左腕と胴体の接合部を粉々に吹き飛ばす。"


translate japanese plot6_19087d57:


    nvlNone "콰앙——!" with Shake((0, 0, 0, 0), 0.5, dist=10)


translate japanese plot6_7cd71909:


    nvlNone "마지막은 몸통."


translate japanese plot6_262fbb5e:


    nvlNone "그레임의 온몸에서 가장 튼튼한 부위였다." (**end_page())


translate japanese plot6_4c563b7a:


    nvlNone "핵을 감싼 얼음 갑옷에는,\n시노스의 마법이 뚫어 놓은 구멍이 있었다."


translate japanese plot6_48ce6b99:


    nvlNone "시노스는 약한 핵을 노리라고 소리칠 뻔했다."


translate japanese plot6_675e1591:


    nvlNone "하지만 라이라는 일부러 피하고 있는 게 분명했다."


translate japanese plot6_c9168304:


    nvlNone "시노스도 그것을 깨달았다." (**end_page())


translate japanese plot6_d892b6dc:


    nvlNone "――라이라는 『놀고』 있다."


translate japanese plot6_11905a51:


    nvlNone "주먹이 그레임의 핵 바로 아래,\n사람으로 치면 배에 해당하는 곳을 직격했다."


translate japanese plot6_aeaf75bb:


    nvlNone "주먹의 충격이 두꺼운 얼음 갑옷을 뚫고, 정면에서 등까지 칼날로 뚫은 듯한 구멍을 냈다."


translate japanese plot6_fb0e9af5_2:


    nvlNone "끼기기긱————!"


translate japanese plot6_f558c301:



    voice "voice/tianqin_001209.ogg"
    nvlNone "「으음——」"


translate japanese plot6_0b64f6ae:


    nvlNone "라이라는 가볍게 손을 털었다. 주먹 마디에서는,\n여전히 하얀 수증기가 가늘게 피어올랐다."


translate japanese plot6_b73ea3a6:


    nvlNone "연이어 세 번 주먹을 내지른 팔은 달아올라 붉어져 있었다."


translate japanese plot6_d41d8cd9_2:


    nvl clear


translate japanese plot6_28f5ab12:


    nvlNone "정작 본인은 이 결과가 그리 만족스럽지 않은 듯했다."


translate japanese plot6_1b517262:


    nvlNone "끼긱!"


translate japanese plot6_bbb227a6:


    nvlNone "그리고 라이라의 기대에 응답하듯, 그레임의 마법진이 다시 작동했다."


translate japanese plot6_f40bc7d5:


    nvlNone "너덜너덜해진 몸을 수복하려고, 흩어진 얼음 덩어리들이 마법진에 끌려와 구멍을 메워 갔다."


translate japanese plot6_8f13178b:


    nvlNone "결국 이 장소의 파수꾼으로\n남겨 둔 그레임일 뿐이었다."


translate japanese plot6_cfb216e8:


    nvlNone "본래 이 마법진에\n담아 둔 마력은 많지 않았다."


translate japanese plot6_d4d14987:


    nvlNone "대량의 얼음 덩어리가 구멍을 메우며 핵을 다시 감췄다."


translate japanese plot6_786b7584:


    nvlNone "하지만 거기까지였다."


translate japanese plot6_31a31a60:


    nvlNone "「자신」의 작품이 이토록 망가지는 모습을 보니, 아무래도 조금 마음이 아팠다." (**end_page())


translate japanese plot6_776c4b8a:


    nvlNone "그레임은 힘겹게 몸을 지탱하며 일어났다.{p}머리와 팔 하나를 잃은 모습에는\n아까의 위엄이 전혀 남아 있지 않았다."


translate japanese plot6_c8641920:



    voice "voice/yangxi_00310.ogg"
    nvlNone "「이제 끝나겠네.」"


translate japanese plot6_b2dfedaf:


    nvlNone "옆의 소녀가 나직이 중얼거렸다."


translate japanese plot6_c60cfdee:


    nvlNone "시노스는 이제야 그 사람이 왜 그렇게 태연한지 알았다."


translate japanese plot6_c70907e5:


    nvlNone "시노스는 다시 라이라에게 시선을 돌렸다."


translate japanese plot6_5e3e43a0:


    nvlNone "또 다른 변화가 느껴졌다."


translate japanese plot6_e7e58280:


    nvlNone "라이라의 자세는\n조금도 바뀌지 않았는데."


translate japanese plot6_fd396316:


    nvlNone "그런데도 아까와는\n전혀 다른 기운을 뿜어내고 있었다."


translate japanese plot6_9b966829:


    nvlNone "공기는 아까보다 더욱\n뜨거워진 것처럼 느껴졌다."


translate japanese plot6_8b3fb325_1:



    voice "voice/tianqin_001210.ogg"
    nvlNone "「덤벼.」"


translate japanese plot6_86cd067f:


    nvlNone "라이라는 다시 담담하게 한마디를 던졌다."


translate japanese plot6_1b517262_1:


    nvlNone "끼긱!"


translate japanese plot6_ef978806:


    nvlNone "그레임은 다시 자세를 바로잡았다."


translate japanese plot6_4df27321:


    nvlNone "지성은 없고, 그저\n주인의 명령을 따를 뿐이다."


translate japanese plot6_bcf06be1:


    nvlNone "주변의 표적을 탐지하고 공격한다."


translate japanese plot6_37b8147c:


    nvlNone "상대를 이길 수 없더라도,{p}움직일 수 있는 한 멈추지 않는다."


translate japanese plot6_fbaa431c:


    nvlNone "끼기기긱!"


translate japanese plot6_03b411da:


    nvlNone "온몸의 얼음 덩어리가 삐걱이는 가운데, 그레임이 마지막 포효를 내질렀다."


translate japanese plot6_182f3bbb:


    nvlNone "다섯 걸음, 십 미터."


translate japanese plot6_2c1451df:


    nvlNone "그레임은 자세를 가다듬고,\n두 걸음 내디뎠다."


translate japanese plot6_1b517262_2:


    nvlNone "끼긱!"


translate japanese plot6_a08836ca:


    nvlNone "속도와 질량을 실은 슈퍼맨 펀치―― 이것이야말로,\n그레임의 최대 일격."


translate japanese plot6_b3e887a4:


    nvlNone "한쪽 팔을 잃어 가벼워진 그레임은,\n전보다 더 높이, 더 빠르게 뛰었다."


translate japanese plot6_9ad57aef:


    nvlNone "한편 라이라도 자세를 잡았다."


translate japanese plot6_f49dcf87:


    nvlNone "몸을 반쯤 틀고 허리를 깊이 낮추며,\n오른 주먹을 허리에 끌어당겼다."


translate japanese plot6_b5cd0cb9:


    nvlNone "가까워졌다."


translate japanese plot6_eb3a76d3:


    nvlNone "날아드는 그레임의 주먹은 눈 깜짝할 사이에 눈앞으로 다가왔다."


translate japanese plot6_f38a7104:


    nvlNone "더 가까워졌다."


translate japanese plot6_c7dde43b:


    nvlNone "하지만 라이라는,\n아까처럼 빠른 잽을 날리지 않았다."


translate japanese plot6_ca48d293:


    nvlNone "맞닿았다."


translate japanese plot6_b54c118e:


    nvlNone "두 주먹이 부딪혔다.{p}그레임의 주먹은 그토록 거대하면서도\n그토록 작았다."


translate japanese plot6_fe031573:


    nvlNone "――!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot6_63ddd9da:


    nvlNone "맞닿은 그 찰나. 라이라는 궁보로 내디디며,{p}밀착한 주먹으로 영거리에서 힘을 쏟아부었다."


translate japanese plot6_d9c8f733:


    nvlNone "그 이름은——"


translate japanese plot6_1811883b:


    nvlNone "{a=dictionary:dict_entry_50}{font=SourceHanSerifSC-Regular.otf}『촌경』{/font}{/a}." (**end_page())


translate japanese plot6_d41d8cd9_3:


    nvl clear


translate japanese plot6_002241ec:


    plot6_duel_shout "「합!」{nw=1.0}"


translate japanese plot6_17234ab6:


    nvlNone "콰앙!!{nw=0.65}" (what_slow_cps=0) with Shake((0, 0, 0, 0), 0.5, dist=10)


translate japanese plot6_d41d8cd9_4:


    nvl clear


translate japanese plot6_a9d98011:


    nvlNone "부딪힌 두 주먹에서 다시 굉음이 터졌다."


translate japanese plot6_fbaa431c_1:


    nvlNone "끼기기긱!"


translate japanese plot6_49202a0b:


    nvlNone "허공을 나는 동안에도,\n온몸의 얼음 결정들이 강렬한 충격에 차례차례 부서져 무너졌다." (**end_page())


translate japanese plot6_d41d8cd9_5:


    nvl clear


translate japanese plot6_d22d5649:


    nvlNone "촌경의 충격이 팔을 따라 온몸으로 전해졌다."


translate japanese plot6_dd690bdc:


    nvlNone "두꺼운 갑옷은 아무런 의미도 없었다."


translate japanese plot6_1c156919:


    nvlNone "얼음 갑옷과 핵이 함께 가루가 되었다." (**end_page())


translate japanese plot6_d41d8cd9_6:


    nvl clear


translate japanese plot6_d41d8cd9_7:


    nvl clear


translate japanese plot6_17cb52d7:


    nvlNone "콰앙!!"


translate japanese plot6_7582b0c8:


    nvlNone "그레임이 땅에 세차게 떨어졌다."


translate japanese plot6_1ae69c7f_1:


    nvlNone "「…」"


translate japanese plot6_a6d65ffb:


    nvlNone "시노스는 무언가를 떠올렸다."


translate japanese plot6_cfe3ada2:


    nvlNone "기억 속에는 분명\n맨손으로 그레임을 제압하는 사람이 있었다."


translate japanese plot6_a371c7a3:


    nvlNone "한편 라이라는 이미 주먹을 거두었다."


translate japanese plot6_b941ee37:


    nvlNone "두 눈을 감고 방금의 감촉을 되새겼다."


translate japanese plot6_cc1529a7:


    nvlNone "오랜만에 전력을 다해 가슴이 벅차올랐다."


translate japanese plot6_c0ddd8c3:


    nvlNone "하지만 싸움은 이미 끝났다. 지금은 무엇보다,\n달아오른 마음과 몸을 가라앉혀야 한다."


translate japanese plot6_71e08e60:



    voice "voice/tianqin_1205.ogg"
    tianqin "…"


translate japanese plot6_5caced8b:



    voice "voice/tianqin_1206.ogg"
    tianqin "후욱——!"


translate japanese plot6_37a641af:



    voice "voice/tianqin_1207.ogg"
    tianqin "좋아, 이제 괜찮으려나."


translate japanese plot6_e94a94d4:



    voice "voice/tianqin_1208.ogg"
    tianqin "시노스, 다친 데는 없어?"


translate japanese plot6_936c4298:



    voice "voice/cygnus_817.ogg"
    cygnus "…"


translate japanese plot6_c02b9994:


    "머릿속은 묻고 싶은 것들로 가득했다."


translate japanese plot6_6db9a0cd:


    "하지만 라이라가 앞에 다가오자 오히려 무슨 말부터 해야 할지 몰랐다."


translate japanese plot6_32667def:



    voice "voice/cygnus_818.ogg"
    cygnus "저…… 방금 그건……"


translate japanese plot6_881a433b:



    voice "voice/tianqin_1209.ogg"
    tianqin "아, 순간 흥분해서 조절을 못 했네."


translate japanese plot6_99dfa94e:



    voice "voice/cygnus_819.ogg"
    cygnus "그걸 묻는 게 아니라, 그러니까——"


translate japanese plot6_a376fe9c:


    "웅——"


translate japanese plot6_142d6c71:


    "그레임의 잔해에서 작은 소리가 나며 시노스의 말을 끊었다."


translate japanese plot6_8bf40e5e:


    "세 사람이 그쪽을 보자, 그레임의 잔해에서 은빛이 희미하게 새어 나오며 허공에 마법진이 서서히 나타났다."


translate japanese plot6_8b950c24:


    "그레임의 몸에 새겨졌던 전이 마법―― 이 공간에서 나가는 유일한 길이었다."


translate japanese plot6_ae9b89f3:



    voice "voice/cygnus_820.ogg"
    cygnus "……일단 여기서 나가자."


translate japanese plot6_3e9b450d:



    voice "voice/cygnus_821.ogg"
    cygnus "이 공간은 더 못 버틸 것 같아."


translate japanese plot6_portal_peak_wait_c4243e13:


    "원예부 쪽에서는 손전등 두 개의 불빛이 화단의 식물들을 계속 훑고 있었다."


translate japanese plot6_portal_peak_wait_b073fe66:



    voice "voice/npc17_01.ogg"
    npc17 ""


translate japanese plot6_portal_peak_wait_a0eb1ada:



    voice "voice/npc18_01.ogg"
    npc18 "에이, 진 씨. 졸다가 잘못 들은 거 아냐?"


translate japanese plot6_portal_peak_wait_6f80ce2c:



    voice "voice/npc18_02.ogg"
    npc18 "한밤중에 누가 운동장에 오겠어."


translate japanese plot6_portal_peak_wait_d5e4ad10:



    voice "voice/npc18_03.ogg"
    npc18 "학교 건물에 학생이 숨어서 안 나갔다면 또 몰라도……"


translate japanese plot6_portal_peak_wait_ab62f036:



    voice "voice/npc17_02.ogg"
    npc17 ""


translate japanese plot6_portal_peak_wait_9fd56906:



    voice "voice/npc17_03.ogg"
    npc17 "コソ泥でも入り込んだのかもしれん。"


translate japanese plot6_portal_peak_wait_3d2ba416:



    voice "voice/npc18_04.ogg"
    npc18 "いやいや、今どきの生徒なんてもちろん、俺らの財布にだって小銭くらいしか入ってないって。"


translate japanese plot6_portal_peak_wait_e2509adc:



    voice "voice/npc18_05.ogg"
    npc18 "学校に忍び込んだって、盗むもんなんかあるか？"


translate japanese plot6_portal_peak_wait_615dabfd:


    "앞장선 경비원은 동료의 투덜거림을 무시하고 손전등으로 원예부 주변을 꼼꼼히 살폈다."


translate japanese plot6_portal_peak_wait_d9f6f4ed:


    "조금 전 근처를 순찰하다 원예부 쪽에서 소리가 나는 것을 들었다."


translate japanese plot6_portal_peak_wait_832aca30:



    voice "voice/npc17_04.ogg"
    npc17 "으음……"


translate japanese plot6_portal_peak_wait_23d983bd:


    "오랜 근무로 길러진 직감은 예리했다. 방금 이곳에서 무슨 일이 있었다고 확신했다."


translate japanese plot6_portal_peak_wait_4c5d99fd:


    "하지만 그 소리를 낸 세 「범인」은 이미 달아난 뒤였다."


translate japanese plot6_portal_peak_wait_d41d8cd9:


    voice "voice/npc18_06.ogg"


translate japanese plot6_portal_peak_wait_fb8eb4c8:


    npc18 "으악!!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot6_portal_peak_wait_c2ec3bd4:



    voice "voice/npc17_05.ogg"
    npc17 ""


translate japanese plot6_portal_peak_wait_31191f0e:



    voice "voice/npc18_07.ogg"
    npc18 "엄마야! 깜짝 놀랐네. 방금 저기 엄청 큰 쥐가 있었어."


translate japanese plot6_portal_peak_wait_4ccbf02a:



    voice "voice/npc17_06.ogg"
    npc17 "いい歳して、ネズミくらいで騒ぐなよ。"


translate japanese plot6_portal_peak_wait_5e73eb94:



    voice "voice/npc18_08.ogg"
    npc18 "いやいや、それと歳は関係ないって！怖いもんは怖いんだよ！"


translate japanese plot6_portal_peak_wait_0c0787dd:



    voice "voice/npc17_07.ogg"
    npc17 "…"


translate japanese plot6_portal_peak_wait_eeff1535:


    "손전등 불빛이 몇 번이고 주위를 훑었지만, 결국 더 이상 이상한 점은 발견되지 않았다."


translate japanese plot6_portal_peak_wait_7398f06c:



    voice "voice/npc18_09.ogg"
    npc18 "자네 아까 들은 소리도 그 큰 쥐가 낸 거 아니야?"


translate japanese plot6_portal_peak_wait_48665bd4:



    voice "voice/npc17_08.ogg"
    npc17 "…그럴지도."


translate japanese plot6_portal_peak_wait_25dbf5f0:


    "앞장선 경비원이 손전등을 껐다. 자신이 괜히 의심한 모양이었다."


translate japanese plot6_portal_peak_wait_70988f6f:



    voice "voice/npc18_10.ogg"
    npc18 "ほら見ろ。こんな時間に、わざわざ学校へ入り込むやつなんているわけないだろ。"


translate japanese plot6_portal_peak_wait_ed2ba604:


    "옥상으로 도망쳐 온 세 사람은 아래에서 오가는 손전등 불빛을 내려다보며 겨우 가슴을 쓸어내렸다."


translate japanese plot6_portal_peak_wait_e2a26422:



    voice "voice/yangxi_310.ogg"
    yangxi "……하마터면 경비원한테 잡힐 뻔했네."


translate japanese plot6_portal_peak_wait_6511937e:



    voice "voice/tianqin_1210.ogg"
    tianqin "여기까지 왔으면 괜찮아. 옥상에는 안 올라오시거든."


translate japanese plot6_portal_peak_wait_aefdc6b3:



    voice "voice/tianqin_1211.ogg"
    tianqin "아, 안 들켜서 정말 다행이야…… 거기서 잡혔으면 변명도 못 했을 거야."


translate japanese plot6_portal_peak_wait_2704c827:



    voice "voice/yangxi_311.ogg"
    yangxi "애초에 소란 피운 건 너희잖아. 누명도 뭣도 아니거든."


translate japanese plot6_portal_peak_wait_2dd58a2a:



    voice "voice/tianqin_1212.ogg"
    tianqin "아이, 일부러 그런 건 아니잖아——"


translate japanese plot6_portal_peak_wait_99e31297:



    voice "voice/cygnus_822.ogg"
    cygnus "라이라, 이 사람은 누구야?"


translate japanese plot6_portal_peak_wait_13a1b095:


    "시노스가 입을 열자 공기에 희미한 긴장감이 감돌았다."


translate japanese plot6_portal_peak_wait_c9294162:



    voice "voice/tianqin_1213.ogg"
    tianqin "자, 자. 일단 진정해."


translate japanese plot6_portal_peak_wait_dd444d7a:



    voice "voice/tianqin_1214.ogg"
    tianqin "내 가장 친한 친구야. 이름은 히나타. 믿어도 되는 사람이야."


translate japanese plot6_portal_peak_wait_c3267f19:



    voice "voice/yangxi_312.ogg"
    yangxi "어!?"


translate japanese plot6_portal_peak_wait_15857487:


    "그레임 소동이 끝나고 나서야 히나타는 결계 안에서 라이라에게 들은 말을 되새기기 시작했다."


translate japanese plot6_portal_peak_wait_e8ba208e:


    "이세계, 마법, 마녀……"


translate japanese plot6_portal_peak_wait_e22962a5:


    "한 번 놀랄 만큼 놀랐을 텐데도, 그 충격은 이제야 서서히 밀려왔다."


translate japanese plot6_portal_peak_wait_ed591571:


    "무엇보다 라이라가 말하던 「【마녀｜시노스】」 본인이,"


translate japanese plot6_portal_peak_wait_43684041:


    "지금 바로 눈앞에 서 있었다."


translate japanese plot6_portal_peak_wait_bf01a08a:


    "게다가 이쪽을 경계하는 눈으로 빤히 바라보면서."


translate japanese plot6_portal_peak_wait_4da357fb:



    voice "voice/yangxi_313.ogg"
    yangxi "…왠지 머리가 아파 오네."


translate japanese plot6_portal_peak_wait_777845df:



    voice "voice/yangxi_314.ogg"
    yangxi "네가…… 시노스야?"


translate japanese plot6_portal_peak_wait_cd60566d:



    voice "voice/cygnus_823.ogg"
    cygnus "……역시 내 이름을 들었구나."


translate japanese plot6_portal_peak_wait_0a043d46:



    voice "voice/yangxi_315.ogg"
    yangxi "（이름?）"


translate japanese plot6_portal_peak_wait_8b28784f:


    "히나타는 곧 라이라가 {a=dictionary:dict_entry_63}「시노스」{/a}라는 이름을 말한 직후 무척 당황했던 일을 떠올렸다."


translate japanese plot6_portal_peak_wait_a2460b8e:



    voice "voice/yangxi_316.ogg"
    yangxi "（그렇게 중요한 거야…?）"


translate japanese plot6_portal_peak_wait_af25e538:



    voice "voice/tianqin_1215.ogg"
    tianqin "미, 미안해, 시노스! 정말 일부러 그런 게 아니야!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot6_portal_peak_wait_5a1be4fb:



    voice "voice/cygnus_824.ogg"
    cygnus "아무튼 이 사람은 이제 내 이름을 알아."


translate japanese plot6_portal_peak_wait_60695c60:



    voice "voice/tianqin_1216.ogg"
    tianqin "그럼…… 어떡하지?"


translate japanese plot6_portal_peak_wait_b6cbeb8e:



    voice "voice/tianqin_1217.ogg"
    tianqin "시노스, 기억을 지우는 마법 같은 건 없어?"


translate japanese plot6_portal_peak_wait_7bc41290:



    voice "voice/cygnus_825.ogg"
    cygnus "그런 마법을 써도 소용없어."


translate japanese plot6_portal_peak_wait_9048c784:



    voice "voice/cygnus_826.ogg"
    cygnus "내 이름은 기억보다 깊은 곳에 【각인｜Sign】되었으니까."


translate japanese plot6_portal_peak_wait_e50c9e9d:



    voice "voice/cygnus_827.ogg"
    cygnus "이제 남은 방법은……"


translate japanese plot6_portal_peak_wait_ca1fa6f2:


    "거기까지 말하고 시노스는 말을 끊었다. 대신 조용히 히나타에게 눈길을 보냈다."


translate japanese plot6_portal_peak_wait_936c4298:



    voice "voice/cygnus_828.ogg"
    cygnus "…"


translate japanese plot6_portal_peak_wait_0f5958b0:


    "뒤탈을 없앨 방법이 하나 있기는 했다."


translate japanese plot6_portal_peak_wait_ecb72433:


    "만일 「저쪽 세계」였다면 시노스는 망설임 없이 하인에게 명령했을 것이다."


translate japanese plot6_portal_peak_wait_0ba2859a:


    "하지만 이 세계에서는 통하지 않을 것이다."


translate japanese plot6_portal_peak_wait_a5466053:



    voice "voice/tianqin_1218.ogg"
    tianqin "잠깐, 잠깐! 그건 안 돼!"


translate japanese plot6_portal_peak_wait_a39d593b:


    "시노스가 그런 생각을 한 것은 찰나였지만, 라이라는 예리하게 알아차렸다."


translate japanese plot6_portal_peak_wait_e7cabe0e:



    voice "voice/cygnus_829.ogg"
    cygnus "알아. 그래서 다른 방법이 없을지 생각 중이야."


translate japanese plot6_portal_peak_wait_ab83382a:



    voice "voice/yangxi_317.ogg"
    yangxi "당사자 앞에서 위험한 얘기는 좀 안 해 줄래? 왠지 나만 바보 같잖아."


translate japanese plot6_portal_peak_wait_e6712099:



    voice "voice/yangxi_318.ogg"
    yangxi "그 이름에 무슨 중요한 의미가 있어?"


translate japanese plot6_portal_peak_wait_7c6caf9e:



    voice "voice/cygnus_830.ogg"
    cygnus "하아……"


translate japanese plot6_portal_peak_wait_371ec3fe:


    "말로 설명하기보다는 보여 주는 편이 빨랐다."


translate japanese plot6_portal_peak_wait_3c99deda:


    "처음 라이라에게 보여 주었을 때처럼 시노스는 손끝에 연필만 한 얼음 결정을 만들었다."


translate japanese plot6_portal_peak_wait_cd0097bd:



    voice "voice/cygnus_831.ogg"
    cygnus "가라."


translate japanese plot6_portal_peak_wait_453ed235:


    "손을 가볍게 휘젓자 얼음 결정이 히나타를 향해 날아갔다."


translate japanese plot6_portal_peak_wait_64ac1aea:



    voice "voice/yangxi_319.ogg"
    yangxi "어!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot6_portal_peak_wait_c60ebf74:


    "히나타는 본능적으로 피하려 했지만, 얼음 결정은 너무 빨라 팔을 스쳤다."


translate japanese plot6_portal_peak_wait_c653e59d:



    voice "voice/yangxi_320.ogg"
    yangxi "읏!"


translate japanese plot6_portal_peak_wait_3775c430:



    voice "voice/yangxi_321.ogg"
    yangxi "응——? 안 아파? 아무 느낌도 없는데……"


translate japanese plot6_portal_peak_wait_50900216:


    "히나타가 팔을 만져 보았다. 날카로운 얼음 결정은 상처 하나 내지 못했다. 심지어 차가운 감촉조차 느껴지지 않았다."


translate japanese plot6_portal_peak_wait_f9f799b0:



    voice "voice/cygnus_832.ogg"
    cygnus "이런 거야. 마녀의 마법은 그 이름을 아는 사람에게 통하지 않아."


translate japanese plot6_portal_peak_wait_36f2bd92:



    voice "voice/yangxi_322.ogg"
    yangxi "아…… 그렇구나……"


translate japanese plot6_portal_peak_wait_5cc022ba:



    voice "voice/yangxi_323.ogg"
    yangxi "（그러니까 이 사람은 내 앞에서는 자기를 지킬 수 없다는 건가.）"


translate japanese plot6_portal_peak_wait_5cc9a7c8:


    "히나타는 시노스가 자신을 경계하는 이유를 이제야 이해했다."


translate japanese plot6_portal_peak_wait_e936028f:



    voice "voice/yangxi_324.ogg"
    yangxi "라이라, 이건 네 잘못이 맞아."


translate japanese plot6_portal_peak_wait_ef2c37b7:



    voice "voice/tianqin_1219.ogg"
    tianqin "으으… 제대로 반성하고 있어. 꼭 명심할게."


translate japanese plot6_portal_peak_wait_9b4d577d:



    voice "voice/cygnus_833.ogg"
    cygnus "하나 더 물어볼 게 있어."


translate japanese plot6_portal_peak_wait_f059c7a1:



    voice "voice/cygnus_834.ogg"
    cygnus "어떻게 라이라를 따라 결계 안으로 들어온 거야?"


translate japanese plot6_portal_peak_wait_6a276501:



    voice "voice/yangxi_325.ogg"
    yangxi "아—— 그게……"


translate japanese plot6_portal_peak_wait_6627c3aa:



    voice "voice/yangxi_326.ogg"
    yangxi "학교 밖에서 라이라가 너랑 몰래 들어가는 걸 보고 궁금해서 따라갔어."


translate japanese plot6_portal_peak_wait_9cc08c75:



    voice "voice/cygnus_835.ogg"
    cygnus "뭐?"


translate japanese plot6_portal_peak_wait_198631e9:



    voice "voice/yangxi_327.ogg"
    yangxi "校舎の中まではついていってないよ。適当に校内をぶらついてただけ。"


translate japanese plot6_portal_peak_wait_9e0847a6:



    voice "voice/yangxi_328.ogg"
    yangxi "そのあと振り返ったら、二人が園芸部のほうへ行ってたから、私もついて行って…"


translate japanese plot6_portal_peak_wait_db6b778e:



    voice "voice/yangxi_329.ogg"
    yangxi "그랬더니 갑자기 강한 빛에 휩싸여서… 정신을 차려 보니 라이라랑 같이 결계 안에 있었어."


translate japanese plot6_portal_peak_wait_936c4298_1:



    voice "voice/cygnus_836.ogg"
    cygnus "…"


translate japanese plot6_portal_peak_wait_f57984ef:



    voice "voice/tianqin_1220.ogg"
    tianqin "시노스, 히나타는 정말 나쁜 애가 아니야."


translate japanese plot6_portal_peak_wait_6f1e6d89:



    voice "voice/tianqin_1221.ogg"
    tianqin "내가 보증할게! 절대 널 해치지 않을 거야!"


translate japanese plot6_portal_peak_wait_dd42a8f2:


    "분위기가 더 험악해지기 전에 라이라는 황급히 두 사람 사이로 끼어들었다."


translate japanese plot6_portal_peak_wait_ec1b4ccd:



    voice "voice/tianqin_1222.ogg"
    tianqin "그리고 난 원래 기회를 봐서 히나타한테 말하려고 했어…… 더는 못 숨길 것 같았거든."


translate japanese plot6_portal_peak_wait_db833242:



    voice "voice/tianqin_1223.ogg"
    tianqin "그냥… 이런 식이 될 줄은 몰랐을 뿐이야."


translate japanese plot6_portal_peak_wait_936c4298_2:



    voice "voice/cygnus_837.ogg"
    cygnus "…"


translate japanese plot6_portal_peak_wait_86b2857f:


    "시노스는 몸을 기울여 라이라 너머의 히나타를 살폈다."


translate japanese plot6_portal_peak_wait_2d8b9e62:



    voice "voice/yangxi_330.ogg"
    yangxi "…"


translate japanese plot6_portal_peak_wait_ff12af6c:


    "그렇게 빤히 관찰당하는 것은 확실히 불편했다."


translate japanese plot6_portal_peak_wait_07847ae5:


    "히나타는 문득 지난번 자신이 아키나를 살펴보던 일이 떠올랐다."


translate japanese plot6_portal_peak_wait_52795dbb:


    "그때 아키나도 이런 기분이었을까."


translate japanese plot6_portal_peak_wait_de142879:



    voice "voice/cygnus_838.ogg"
    cygnus "……알겠어."


translate japanese plot6_portal_peak_wait_22a51beb:


    "시노스는 결국 타협하듯 한숨을 내쉬었다."


translate japanese plot6_portal_peak_wait_0e109d0d:



    voice "voice/cygnus_839.ogg"
    cygnus "내 존재를 다른 사람한테 알리지 않았으면 해…… 특히 내 이름은."


translate japanese plot6_portal_peak_wait_29d4f7b7:



    voice "voice/yangxi_331.ogg"
    yangxi "나 나쁜 사람 아니야. 안심해."


translate japanese plot6_portal_peak_wait_17392182:



    voice "voice/yangxi_332.ogg"
    yangxi "그냥 이 상황을 받아들일 시간이 좀 필요할 뿐이야……"


translate japanese plot6_portal_peak_wait_4aaa21a0:



    voice "voice/tianqin_1224.ogg"
    tianqin "괜찮아. 금방 받아들일 수 있을 거야."


translate japanese plot6_portal_peak_wait_ae035cfd:



    voice "voice/yangxi_333.ogg"
    yangxi "그렇게 쉽게 말하지 마. 난 네가 아니거든……"


translate japanese plot6_portal_peak_wait_ce53a8ff:



    voice "voice/cygnus_840.ogg"
    cygnus "그럼 이제……"


translate japanese plot6_portal_peak_wait_bf151bfd:



    voice "voice/cygnus_841.ogg"
    cygnus "네 몸이 어떻게 된 건지도 제대로 설명해 줘."


translate japanese plot6_portal_peak_wait_048b463e:



    voice "voice/tianqin_1225.ogg"
    tianqin "아—— 그게……"


translate japanese plot6_portal_peak_wait_2b7673b3:



    voice "voice/tianqin_1226.ogg"
    tianqin "시노스의 마법이 대단했잖아. 난 힘을 조금 내서 그 괴물을 쓰러뜨렸을 뿐이고…"


translate japanese plot6_portal_peak_wait_cb0a5c9c:



    voice "voice/cygnus_842.ogg"
    cygnus "내가 믿을 것 같아?"


translate japanese plot6_portal_peak_wait_04fe09d2:



    voice "voice/tianqin_1227.ogg"
    tianqin "아니……"


translate japanese plot6_portal_peak_wait_9de18eff:



    voice "voice/cygnus_843.ogg"
    cygnus "그럼 제대로 설명해."


translate japanese plot6_portal_peak_wait_e0ea6c10:



    voice "voice/tianqin_1228.ogg"
    tianqin "어—— 그게——"


translate japanese plot6_portal_peak_wait_71e08e60:



    voice "voice/tianqin_1229.ogg"
    tianqin "…"


translate japanese plot6_portal_peak_wait_1a173610:



    voice "voice/tianqin_1230.ogg"
    tianqin "分かったよ。別に、シノスちゃんに隠すことでもないし。"


translate japanese plot6_portal_peak_wait_e338d9f3:



    voice "voice/tianqin_1231.ogg"
    tianqin "유전병이라고 알아?"


translate japanese plot6_portal_peak_wait_d89acdfd:



    voice "voice/cygnus_844.ogg"
    cygnus "유전성 질환이라는 거야?"


translate japanese plot6_portal_peak_wait_652e86d4:



    voice "voice/tianqin_1232.ogg"
    tianqin "쉽게 말하면 부모에게서 물려받은 선천적인 병이야."


translate japanese plot6_portal_peak_wait_aa787dd9:



    voice "voice/tianqin_1233.ogg"
    tianqin "난 사실 어떤 {a=dictionary:dict_entry_66}유전병{/a} 때문에 근육과 뼈의 밀도가 보통 사람보다 열몇 배나 높아."


translate japanese plot6_portal_peak_wait_cc2181b2:



    voice "voice/cygnus_845.ogg"
    cygnus "잠깐, 그건……"


translate japanese plot6_portal_peak_wait_cf0f3796:



    voice "voice/cygnus_846.ogg"
    cygnus "병이야?"


translate japanese plot6_portal_peak_wait_5136fe23:



    voice "voice/tianqin_1234.ogg"
    tianqin "응, 믿기 힘들겠지만 유전자 결함으로 생긴 특수한 질병이야."


translate japanese plot6_portal_peak_wait_bde6856b:



    voice "voice/tianqin_1235.ogg"
    tianqin "아… 「유전자가 뭐야?」라는 건 나중에 컴퓨터로 찾아봐 줘."


translate japanese plot6_portal_peak_wait_4e3ecc4e:



    voice "voice/tianqin_1236.ogg"
    tianqin "그건 나도 잘 설명할 수 없거든."


translate japanese plot6_portal_peak_wait_b1419dea:



    voice "voice/cygnus_847.ogg"
    cygnus "병이라지만…… 넌 멀쩡하잖아? 이렇게 강한 몸을 갖고 있고."


translate japanese plot6_portal_peak_wait_b86e6e4e:



    voice "voice/tianqin_1237.ogg"
    tianqin "그게…… 내가 앓는 유전병은 다른 곳에도 환자가 조금 있어."


translate japanese plot6_portal_peak_wait_64de3d17:



    voice "voice/tianqin_1238.ogg"
    tianqin "그런데 근육 이상으로 일찍 세상을 떠나서, 대부분은 다섯 살까지 살지 못했어."


translate japanese plot6_portal_peak_wait_90a28ecf:



    voice "voice/tianqin_1239.ogg"
    tianqin "나랑 언니는 운이 좋은 편이야. 병은 있어도 목숨이 위험할 정도로 진행되지는 않았거든."


translate japanese plot6_portal_peak_wait_4bc56d63:



    voice "voice/tianqin_1240.ogg"
    tianqin "주기적으로 병원에 가서 몸을 검사하면 되는 정도야."


translate japanese plot6_portal_peak_wait_1079d9d2:



    voice "voice/cygnus_848.ogg"
    cygnus "네 언니도 너랑 같아?"


translate japanese plot6_portal_peak_wait_66198081:



    voice "voice/tianqin_1241.ogg"
    tianqin "응, 유전병이니까."


translate japanese plot6_portal_peak_wait_f13629e7:



    voice "voice/tianqin_1242.ogg"
    tianqin 0117 "하지만 남들보다 튼튼하다고 해서 좋은 병은 아니야."


translate japanese plot6_portal_peak_wait_2488e191:



    voice "voice/tianqin_1243.ogg"
    tianqin "어릴 때는 이 힘을 어떻게 조절해야 할지 몰라서 주변 물건을 자주 망가뜨렸어."


translate japanese plot6_portal_peak_wait_d41d8cd9_1:


    voice "voice/tianqin_1244.ogg"


translate japanese plot6_portal_peak_wait_81bfe79f:


    tianqin 0117 "처음 밖에 나갔을 때 나무 위의 새끼 고양이를 구하려다가…… 실수로 졸라 죽인 적도 있어."


translate japanese plot6_portal_peak_wait_d772e45d:



    voice "voice/tianqin_1245.ogg"
    tianqin 0103 "……아주 잔인하게. 아직도 손에 피가 가득 묻었던 감촉을 잊지 못해."


translate japanese plot6_portal_peak_wait_7fac5277:



    voice "voice/tianqin_1246.ogg"
    tianqin "사실 그렇게 될 수 있다는 건 알고 있었어. 그런데 조절을 못 했어."


translate japanese plot6_portal_peak_wait_d4dd59eb:



    voice "voice/tianqin_1247.ogg"
    tianqin 0117 "그때 주변에 있던 아이들도 전부 놀라서 달아났어."


translate japanese plot6_portal_peak_wait_3e53791b:



    voice "voice/tianqin_1248.ogg"
    tianqin "멀찍이 떨어져서 괴물이라도 보는 눈으로 날 봤지."


translate japanese plot6_portal_peak_wait_71e08e60_1:



    voice "voice/tianqin_1249.ogg"
    tianqin "…"


translate japanese plot6_portal_peak_wait_12685cde:



    voice "voice/tianqin_1250.ogg"
    tianqin "그때부터 내 힘을 조절하는 법을 배우기로 했어."


translate japanese plot6_portal_peak_wait_22dae825:



    voice "voice/tianqin_1251.ogg"
    tianqin "꼭 필요할 때가 아니면 절대 이 힘을 쓰지 않아."


translate japanese plot6_portal_peak_wait_fab5f887:



    voice "voice/tianqin_1252.ogg"
    tianqin "이 힘 때문에…… 나쁜 기억이 너무 많이 생겼거든."


translate japanese plot6_portal_peak_wait_a3785bde:



    voice "voice/tianqin_1253.ogg"
    tianqin "평소에는 평범한 사람이랑 다를 게 없어 보이지? 사실은 근육을 조절하려고 굉장히 애쓰고 있는 거야."


translate japanese plot6_portal_peak_wait_a43609a3:



    voice "voice/tianqin_1254.ogg"
    tianqin "평소에 운동하는 것도 근육에 힘이 들어가는 감각을 더 잘 느껴서 최대한 억제하려는 거야."


translate japanese plot6_portal_peak_wait_4801a124:



    voice "voice/tianqin_1255.ogg"
    tianqin "그러지 않으면 평범하게 악수조차 할 수 없어. 조금만 힘을 줘도 상대의 뼈를 부숴 버리니까."


translate japanese plot6_portal_peak_wait_cc616b92:



    voice "voice/tianqin_1256.ogg"
    tianqin "가능하다면 차라리 이 힘이 없었으면 좋겠어……"


translate japanese plot6_portal_peak_wait_936c4298_3:



    voice "voice/cygnus_849.ogg"
    cygnus "…"


translate japanese plot6_portal_peak_wait_50fd3aa8:



    voice "voice/cygnus_850.ogg"
    cygnus "미안…… 그런 사정이 있을 줄은 몰랐어……"


translate japanese plot6_portal_peak_wait_77d2f078:



    voice "voice/tianqin_1257.ogg"
    tianqin "괜찮아. 줄곧 말 안 한 나도 잘못했으니까."


translate japanese plot6_portal_peak_wait_68318f63:



    voice "voice/cygnus_851.ogg"
    cygnus "오늘 밤은 정말 네 덕분에 살았어."


translate japanese plot6_portal_peak_wait_741690f5:



    voice "voice/cygnus_852.ogg"
    cygnus "네가 없었다면 나 혼자서는 그 그레임을 이기지 못했을 거야."


translate japanese plot6_portal_peak_wait_8f1fb2b6:



    voice "voice/tianqin_1258.ogg"
    tianqin "별것 아니야. 널 도울 수 있어서 나도 기뻐."


translate japanese plot6_portal_peak_wait_388d6c2c:



    voice "voice/tianqin_1259.ogg"
    tianqin "이 체질 때문에 안 좋은 일만 겪어 왔으니까…"


translate japanese plot6_portal_peak_wait_026293f6:



    voice "voice/tianqin_1260.ogg"
    tianqin "앞으로는 이런 기회가 없을지도 몰라."


translate japanese plot6_portal_peak_wait_9ea53412:



    voice "voice/tianqin_1261.ogg"
    tianqin "그래도 오늘 한 번이라도 이 힘 덕분에 널 도울 수 있었으니까, 난 그걸로 만족해."


translate japanese plot6_portal_peak_wait_936c4298_4:



    voice "voice/cygnus_853.ogg"
    cygnus "…"


translate japanese plot6_portal_peak_wait_c3e1662a:



    voice "voice/cygnus_854.ogg"
    cygnus "라이라, 내 생각에는…… 네 힘이 어쩌면……"


translate japanese plot6_portal_peak_wait_f0e2e7e7:



    voice "voice/tianqin_1262.ogg"
    tianqin "응?"


translate japanese plot6_portal_peak_wait_ae3a4ea9:



    voice "voice/cygnus_855.ogg"
    cygnus "그러니까……"


translate japanese plot6_portal_peak_wait_7de4f585:



    voice "voice/cygnus_856.ogg"
    cygnus "――こほん…どう言えばいいのだ。"


translate japanese plot6_portal_peak_wait_8ab4ebaf:


    "마녀는 필사적으로 머리를 굴리고 있었다."


translate japanese plot6_portal_peak_wait_44c4a477:


    "하려던 말이 목구멍에서 멈췄고, 그녀는 억지로 삼켰다."


translate japanese plot6_portal_peak_wait_e08187af:


    "그대로 말하면 분위기가 이상해질 것 같았기 때문이다."


translate japanese plot6_portal_peak_wait_d631cf9e:


    "자기 생각을 전할 적절한 표현을 찾으려 했다."


translate japanese plot6_portal_peak_wait_bebd94db:


    "말주변이 없다는 것은 알았지만, 충분히 생각하면 해낼 수 있다고 여겼다."


translate japanese plot6_fate_silence_caption_15e80aa8:


    "길지도 짧지도 않은 고민 끝에 마녀가 내놓은 말은 역시 뜬금없었다."


translate japanese plot6_fate_silence_caption_7e56f23b:


    "옆에서 슬그머니 듣던 히나타조차 하마터면 웃음을 참지 못할 뻔했다."


translate japanese plot6_fate_silence_caption_65f28b89:



    voice "voice/tianqin_1263.ogg"
    tianqin "——어, 어?"


translate japanese plot6_fate_silence_caption_e6c59f4a:


    "세 사람 중 가장 엉뚱한 라이라조차 순간 시노스의 흐름을 따라가지 못했다."


translate japanese plot6_fate_silence_caption_dda949c1:



    voice "voice/cygnus_858.ogg"
    cygnus "네가 가진 그 힘은… 무언가로 이끄는 것일지도 몰라."


translate japanese plot6_fate_silence_caption_b26b9fca:



    voice "voice/cygnus_859.ogg"
    cygnus "그 힘이 「저쪽 세계」에 있던 나를 이끌어서, 큰 위험을 무릅쓰고서라도 이곳에 오게 한 거야."


translate japanese plot6_fate_silence_caption_8ee47f1d:



    voice "voice/cygnus_860.ogg"
    cygnus "우리의 만남도 우연이 아니라 무언가의 「필연」이었던 거지."


translate japanese plot6_fate_silence_caption_4d71afea:



    voice "voice/cygnus_861.ogg"
    cygnus "그러니까 내가 『운명』이라고 부르는 것이야."


translate japanese plot6_fate_silence_caption_468ab507:



    voice "voice/tianqin_1264.ogg"
    tianqin "어——? 무, 무슨 말인지 잘 모르겠어."


translate japanese plot6_fate_silence_caption_e3fbcc88:



    voice "voice/cygnus_862.ogg"
    cygnus "음. 이 【과제｜운명】에 대해서는 나도 아직 밝혀내지 못했어."


translate japanese plot6_fate_silence_caption_22c31c40:



    voice "voice/cygnus_863.ogg"
    cygnus "그저 눈에 보이지 않는 무언가에 이끌리고 있다는 느낌이 들어."


translate japanese plot6_fate_silence_caption_a79d408c:



    voice "voice/cygnus_864.ogg"
    cygnus "그 힘을 가진 너만이 나를 곤경에서 벗어나게 해 줄 수 있어."


translate japanese plot6_fate_silence_caption_24bc6389:



    voice "voice/tianqin_1265.ogg"
    tianqin "아이—— 나 그렇게 대단하지 않아. 그렇게 말하니까 부끄럽잖아."


translate japanese plot6_fate_silence_caption_d32f436c:



    voice "voice/cygnus_865.ogg"
    cygnus "아니, 진심으로 그렇게 생각해, 라이라."


translate japanese plot6_fate_silence_caption_26cbf08e:



    voice "voice/cygnus_866.ogg"
    cygnus "앞으로도 오늘 같은 위험에 많이 처할지도 몰라……"


translate japanese plot6_fate_silence_caption_f312da27:



    voice "voice/cygnus_867.ogg"
    cygnus "이런 말을 하자니 염치없지만……"


translate japanese plot6_fate_silence_caption_d41d8cd9:


    voice "voice/cygnus_868.ogg"


translate japanese plot6_fate_silence_caption_60d6f961:


    cygnus "——라이라, 네 힘이 필요해. 날 도와줘."


translate japanese plot6_fate_silence_caption_a037a6f6:



    voice "voice/tianqin_1266.ogg"
    tianqin "물론이지! 앞으로 내 도움이 필요하면 언제든 말해."


translate japanese plot6_fate_silence_caption_461b195f:



    voice "voice/tianqin_1267.ogg"
    tianqin "어떤 괴물이든 전부 때려눕혀 줄게."


translate japanese plot6_fate_silence_caption_8b02674b:



    voice "voice/cygnus_869.ogg"
    cygnus "응, 고마워……"


translate japanese plot6_fate_silence_caption_354e4c20:


    "히나타는 옥상 가장자리에 기대어 원예부 쪽을 내려다보았다."


translate japanese plot6_fate_silence_caption_3b10bb61:


    "이제 그곳은 캄캄했고, 손전등 불빛도 사라져 있었다."


translate japanese plot6_fate_silence_caption_4a67bd1f:



    voice "voice/yangxi_334.ogg"
    yangxi "경비원들은 이제 돌아간 것 같아."


translate japanese plot6_fate_silence_caption_a567fb16:



    voice "voice/tianqin_1268.ogg"
    tianqin "내일 별 소동이 없어야 할 텐데."


translate japanese plot6_fate_silence_caption_d62761a4:



    voice "voice/yangxi_335.ogg"
    yangxi "어딘가 CCTV에 우리랑 그 이상한 빛이 찍혔을지도 모르지."


translate japanese plot6_fate_silence_caption_45a1f079:



    voice "voice/tianqin_1269.ogg"
    tianqin "우와—— 그러면 진짜 초자연 현상이네!"


translate japanese plot6_fate_silence_caption_ebff1eb0:



    voice "voice/yangxi_336.ogg"
    yangxi "아직도 그 생각이야?"


translate japanese plot6_fate_silence_caption_de2ed8ee:



    voice "voice/tianqin_1270.ogg"
    tianqin "게다가 자칫하면 학교에 몰래 들어온 것도 들킬 수 있잖아——!"


translate japanese plot6_fate_silence_caption_7d0e5ba5:



    voice "voice/yangxi_337.ogg"
    yangxi "내일 일은 내일 생각하자."


translate japanese plot6_fate_silence_caption_b054fe1a:



    voice "voice/yangxi_338.ogg"
    yangxi "난 돌아갈게. 오늘 일은 좀 곱씹어 봐야겠어."


translate japanese plot6_fate_silence_caption_eea644e7:



    voice "voice/tianqin_1271.ogg"
    tianqin "그럼 우리도 집에 갈까?"


translate japanese plot6_fate_silence_caption_cb614ed9:



    voice "voice/cygnus_870.ogg"
    cygnus "응, 오늘 마력을 너무 많이 썼어."


translate japanese plot6_fate_silence_caption_fc64395b:



    voice "voice/cygnus_871.ogg"
    cygnus "한동안 푹 쉬어야겠어."


translate japanese plot6_fate_silence_caption_2d8b9e62:



    voice "voice/yangxi_339.ogg"
    yangxi "…"


translate japanese plot6_fate_silence_caption_7187c37a:


    "라이라 일행과 헤어진 히나타는 곧장 집에 가지 않고 번화가 근처를 계속 맴돌았다."


translate japanese plot6_fate_silence_caption_f5a4954e:



    voice "voice/yangxi_340.ogg"
    yangxi "（――대체 이게 다 뭐야.）"


translate japanese plot6_fate_silence_caption_03425343:


    "오늘 밤 겪은 일은 너무도 기이했다. 그녀의 세계관을 완전히 뒤집어 놓았다."


translate japanese plot6_fate_silence_caption_2cc0c2d4:


    "아무렇지도 않게 시노스를 받아들인 라이라와 달리, 히나타의 모습이야말로 평범한 사람다운 반응이었다."


translate japanese plot6_fate_silence_caption_9aabf764:


    "마녀? 마법? 이세계?"


translate japanese plot6_fate_silence_caption_57d31861:


    "지나가는 사람이라도 붙잡고 방금 겪은 일을 전부 털어놓고 싶었다. 미친 사람 취급을 받아도 상관없었다."


translate japanese plot6_fate_silence_caption_c80f3743:


    "안타깝게도 그럴 수는 없었다. 이 안절부절못하는 기분은 혼자 감당해야 했다."


translate japanese plot6_fate_silence_caption_08ba6987:



    voice "voice/yangxi_341.ogg"
    yangxi "（…좀 걷다가 돌아가자.）"


translate japanese plot6_fate_silence_caption_69a9335f:


    "히나타는 사람이 많은 곳을 싫어했지만, 완전히 진정하고 싶을 때는 오히려 가장 붐비는 야시장으로 들어갔다."


translate japanese plot6_fate_silence_caption_4865670a:


    "번화가의 소란 속에서는 평온을 느낄 수 있었다. 떠들썩한 환경이 어린 시절을 떠올리게 했다."


translate japanese plot6_fate_silence_caption_6b428237:



    voice "voice/yangxi_342.ogg"
    yangxi 0101 "…"


translate japanese plot6_fate_silence_caption_43a0feeb:


    ""


translate japanese plot6_fate_silence_caption_8d75f2fb:



    voice "voice/yangxi_343.ogg"
    yangxi "（――考えれば考えるほど、余計に気持ちが乱れてるじゃん。）"


translate japanese plot6_fate_silence_caption_d924fcd4:


    ""


translate japanese plot6_fate_silence_caption_71256042:


    "追い払おうとすればするほど、かえって離れなくなった。"


translate japanese plot6_fate_silence_caption_f97f1235:



    voice "voice/yangxi_344.ogg"
    yangxi "……아직 열 시네."


translate japanese plot6_fate_silence_caption_27b5b7e9:


    "히나타는 스마트폰으로 시간을 확인했다. 아직 밤이 깊지도 않았는데 밤새 깨어 있었던 듯 피곤했다."


translate japanese plot6_fate_silence_caption_133d7a5f:


    "무심코 주머니를 더듬었지만, 그곳은 이미 텅 비어 있었다."


translate japanese plot6_fate_silence_caption_48694697:


    "지난 학기에 라이라와 니코틴이 든 것은 다시는 손대지 않겠다고 약속했다."


translate japanese plot6_fate_silence_caption_0699b167:



    voice "voice/yangxi_345.ogg"
    yangxi "하아——"


translate japanese plot6_fate_silence_caption_368d3f60:


    "그럼 지금의 초조함은 어떻게 달래야 할까?"


translate japanese plot6_fate_silence_caption_dd41ec0e:


    "히나타는 지난 학기의 자신에게 속으로 욕을 퍼부었지만, 편의점으로 들어갈 용기는 없었다."


translate japanese plot6_fate_silence_caption_c16cb5cf:


    "라이라와의 약속을 깨는 자신도 용서할 수 없었기 때문이다."


translate japanese plot6_fate_silence_caption_0207fdc0:



    voice "voice/yangxi_346.ogg"
    yangxi "（나도 참 피곤한 인간이야――）"


translate japanese plot6_fate_silence_caption_fdfbc99a:


    "곧 히나타는 인파 속에 섞여 시끄러운 번화가의 일부가 되었다."


translate japanese plot6_fate_silence_caption_5771b27c:


    "밤은 아직 길었다. 오늘 밤의 기이한 경험을 천천히 받아들일 시간은 많았다."


translate japanese plot6_fate_silence_caption_d7327b61:


    "한편 마녀 역시 오늘 밤 보고 들은 것을 곱씹고 있었다."


translate japanese plot6_fate_silence_caption_c6fd5e36:


    "라이라가 깊이 잠들자 시노스는 살며시 침실을 빠져나와 거실에서 생각을 정리했다."


translate japanese plot6_fate_silence_caption_936c4298:



    voice "voice/cygnus_872.ogg"
    cygnus "…"


translate japanese plot6_fate_silence_caption_0dd102cc:



    voice "voice/cygnus_873.ogg"
    cygnus "노리, 거기 있지?"


translate japanese plot6_fate_silence_caption_0bd88b2d:


    "말이 끝나자마자 어두운 거실에서 바스락거리는 소리가 났다."


translate japanese plot6_fate_silence_caption_57a8ae51:


    "검은 고양이 한 마리가 어두운 구석에서 걸어 나왔다. 창밖 가로등의 희미한 빛으로는 윤곽을 겨우 알아볼 수 있었다."


translate japanese plot6_fate_silence_caption_ee75de96:


    voice "voice/blackcat_35.ogg"
    "고양이는 작게 울고는 사뿐사뿐 걸어와 거실 식탁 위로 뛰어올랐다."


translate japanese plot6_fate_silence_caption_5f9fa97e:



    voice "voice/blackcat_13.ogg"
    blackcat "냐하~"


translate japanese plot6_fate_silence_caption_2f43c5e7:



    voice "voice/blackcat_14.ogg"
    blackcat "아이고, 오늘 밤은 정말 위험했구나."


translate japanese plot6_fate_silence_caption_aa709491:



    voice "voice/blackcat_04.ogg"
    blackcat "하지만 누가 맨손으로 네 그레임을 때려 부술 줄은 몰랐어. 큰 도움이 됐지."


translate japanese plot6_fate_silence_caption_b2461f58:



    voice "voice/cygnus_874.ogg"
    cygnus "바로 그게 믿기지 않아."


translate japanese plot6_fate_silence_caption_181e0a7a:



    voice "voice/blackcat_19.ogg"
    blackcat "네 그레임이 너무 약했던 것 아니냐? 냐하하——"


translate japanese plot6_fate_silence_caption_53299c48:



    voice "voice/blackcat_29.ogg"
    blackcat "아야——!"


translate japanese plot6_fate_silence_caption_bc9daf10:


    "시노스는 가차 없이 노리의 이마에 딱밤을 먹였다."


translate japanese plot6_fate_silence_caption_d53930e3:



    voice "voice/cygnus_875.ogg"
    cygnus "조금만 생각해도 그건 아니잖아. 그 그레임은 내 전력의 마법을 정면으로 맞고도 버텼어."


translate japanese plot6_fate_silence_caption_5d81cf66:



    voice "voice/blackcat_05.ogg"
    blackcat "네 전력?"


translate japanese plot6_fate_silence_caption_67880e4c:



    voice "voice/blackcat_06.ogg"
    blackcat "그 공격 마법이나 그레임이나, 내가 아는 네 「전력」과는 한참 거리가 있던데."


translate japanese plot6_fate_silence_caption_d05e3321:



    voice "voice/cygnus_876.ogg"
    cygnus "지금은 마력이 부족할 뿐이야."


translate japanese plot6_fate_silence_caption_4831e453:



    voice "voice/cygnus_877.ogg"
    cygnus "게다가 지금은 그 얘기가 아니야. 내가 묻고 싶은 건…"


translate japanese plot6_fate_silence_caption_dc9fb4df:



    voice "voice/blackcat_09.ogg"
    blackcat "라이라라는 그 소녀냐?"


translate japanese plot6_fate_silence_caption_6df82c38:



    voice "voice/cygnus_878.ogg"
    cygnus "넌 어떻게 생각해?"


translate japanese plot6_fate_silence_caption_10ad37cd:



    voice "voice/blackcat_24.ogg"
    blackcat "……참 쓸데없는 질문을 하는구나."


translate japanese plot6_fate_silence_caption_b2fd0b03:



    voice "voice/blackcat_13.ogg"
    blackcat "이미 마음속에 답이 있으면서 이 몸의 의견이 중요하겠느냐."


translate japanese plot6_fate_silence_caption_4d32acf0:



    voice "voice/cygnus_879.ogg"
    cygnus "맨손으로 내 그레임에 맞서고, 가볍게 쓰러뜨릴 수 있는 사람은……"


translate japanese plot6_fate_silence_caption_5e764dbe:



    voice "voice/cygnus_880.ogg"
    cygnus "「저쪽 세계」에서도 가능한 사람은 손에 꼽을 정도야."


translate japanese plot6_fate_silence_caption_d57826eb:



    voice "voice/blackcat_12.ogg"
    blackcat "그렇지. 하지만 마침 너도 그런 짓을 할 수 있는 녀석 하나를 알고 있구나."


translate japanese plot6_fate_silence_caption_4594f74a:



    voice "voice/cygnus_881.ogg"
    cygnus "――「{a=dictionary:dict_entry_64}용사{/a}」의 체질인가…"


translate japanese plot6_fate_silence_caption_404dc292:



    voice "voice/cygnus_882.ogg"
    cygnus "그런데 마나가 없는 환경에서도 정말 「용사」가 태어날 수 있어?"


translate japanese plot6_fate_silence_caption_2039474d:



    voice "voice/cygnus_883.ogg"
    cygnus "게다가 라이라는 이 세상에서 자기 체질이 질병이라고 했고……"


translate japanese plot6_fate_silence_caption_94c727ba:


    "시노스는 라이라의 말을 못 믿는 게 아니었다."


translate japanese plot6_fate_silence_caption_41ae9b9b:


    "단지 라이라의 설명만큼 간단한 일은 아닐 것 같았다."


translate japanese plot6_fate_silence_caption_b5ed4fa4:



    voice "voice/blackcat_07.ogg"
    blackcat "흐흐—— 그건 나도 모르겠구나."


translate japanese plot6_fate_silence_caption_dfbaa8b1:



    voice "voice/blackcat_14.ogg"
    blackcat "어쨌든 막다른 곳에서 좋은 패를 뽑았어."


translate japanese plot6_fate_silence_caption_47f78a7c:



    voice "voice/blackcat_15.ogg"
    blackcat "그 녀석을 잘 이용하면 네 목적도 한결 쉽게 이룰 수 있겠지."


translate japanese plot6_fate_silence_caption_9c4ceae3:



    voice "voice/cygnus_884.ogg"
    cygnus "아냐, 난……"


translate japanese plot6_fate_silence_caption_8e649fa6:



    voice "voice/cygnus_885.ogg"
    cygnus "그저 도움을 받고 싶은 것뿐이야. 그 애를 이용해서 위험한 일을 시키지는 않을 거야."


translate japanese plot6_fate_silence_caption_075f7110:



    voice "voice/blackcat_05.ogg"
    blackcat "……이 몸을 웃기려는 거냐."


translate japanese plot6_fate_silence_caption_2dc18595:



    voice "voice/blackcat_06.ogg"
    blackcat "대마녀님께서 자기 사역마 앞에서 착한 척을 다 하시는군?"


translate japanese plot6_fate_silence_caption_0469587b:



    voice "voice/blackcat_02.ogg"
    blackcat "서로 이용하고, 제 이익만 챙기며, 목적을 위해 수단을 가리지 않는다."


translate japanese plot6_fate_silence_caption_86e57dea:



    voice "voice/blackcat_30.ogg"
    blackcat "그것이 바로 【마녀｜너】의 본성이야."


translate japanese plot6_fate_silence_caption_4d38d905:



    voice "voice/equinox_42.ogg"
    nvl_equinox "힘 좀 써. 밥도 안 먹었어?" (**end_page(inline=True))


translate japanese plot6_fate_silence_caption_9a3aa814:



    voice "voice/dorothea_09.ogg"
    nvl_dorothea "제대로 먹었어! 힘을 너무 줄까 봐 무서워서 그래."


translate japanese plot6_fate_silence_caption_9c2a732c:



    voice "voice/dorothea_10.ogg"
    nvl_dorothea "아직 힘을 세밀하게 조절하지는 못하거든." (**end_page())


translate japanese plot6_fate_silence_caption_5d9073e4:



    voice "voice/equinox_43.ogg"
    nvl_equinox "됐어. 그냥 힘껏 해." (**end_page())


translate japanese plot6_fate_silence_caption_14acc649:


    nvlNone "도로시아는 유적에서 가져온 마나 결정을 손에 쥐고, 망설이며 내 등에 눌러 대고 있었다." (**end_page(inline=True))


translate japanese plot6_fate_silence_caption_05211cee:


    nvl clear
    nvlNone "목적은 이 결정을 내 등에 박아 넣는 것.\n가장 원시적이고 난폭한 방법으로." (**end_page(inline=True))


translate japanese plot6_fate_silence_caption_93c2c9a0:



    voice "voice/dorothea_11.ogg"
    nvl_dorothea "힘준다?"


translate japanese plot6_fate_silence_caption_7a8d90fe:



    voice "voice/equinox_44.ogg"
    nvl_equinox "응." (**end_page())


translate japanese plot6_fate_silence_caption_bfddaa8c:


    nvlNone "푸슉——" (**end_page())


translate japanese plot6_fate_silence_caption_d41d8cd9_1:

    nvl clear


translate japanese plot6_fate_silence_caption_d49776fa:


    voice "voice/equinox_45.ogg"
    nvl_equinox "아파——!!!" (**end_page())


translate japanese plot6_fate_silence_caption_5d5994b8:



    voice "voice/dorothea_12.ogg"
    nvl_dorothea "내가 뭐랬어……" (**end_page())


translate japanese plot6_fate_silence_caption_0a300f32:


    nvlNone "도로시아가 힘을 주자 날카로운 결정이 살갗을 뚫고 등을 통해 몸속으로 파고들었다." (**end_page(inline=True))


translate japanese plot6_fate_silence_caption_c0821740:


    nvlNone "결정을 받아들일 수 있도록 마법으로 몸의 구조를 바꾸고,\n최상급 진통 마법까지 걸었다. 그래도 이렇게 난폭하게 박아 넣으니 정신을 잃을 것처럼 아팠다." (**end_page(inline=True))


translate japanese plot6_fate_silence_caption_a1b18b57:



    voice "voice/dorothea_13.ogg"
    nvl_dorothea "으아아, 피가 튀잖아——" (**end_page())


translate japanese plot6_fate_silence_caption_4feaa6b9:



    voice "voice/equinox_46.ogg"
    nvl_equinox "이리 와." (**end_page())


translate japanese plot6_fate_silence_caption_7ed83548:



    voice "voice/dorothea_14.ogg"
    nvl_dorothea "싫어. 피투성이잖아." (**end_page())


translate japanese plot6_fate_silence_caption_17df1a83:



    voice "voice/dorothea_15.ogg"
    nvl_dorothea "으앗――!"


translate japanese plot6_fate_silence_caption_dcf71dda:


    nvlNone "나는 도로시아의 거절을 무시하고\n억지로 끌어당겼다." (**end_page())


translate japanese plot6_fate_silence_caption_37723ba4:



    voice "voice/dorothea_16.ogg"
    nvl_dorothea "내 옷——" (**end_page())


translate japanese plot6_fate_silence_caption_ce038b88:



    voice "voice/equinox_47.ogg"
    nvl_equinox "나중에 빨면 돼." (**end_page())


translate japanese plot6_fate_silence_caption_a9f26fa3:


    nvlNone "마나 결정이 몸에 박히자 거대한 마력의 흐름이 몸속에서 끊임없이 요동쳤다."


translate japanese plot6_fate_silence_caption_745dbbc7:


    nvlNone "내 것이 아닌 마력이 거세게 몰아치며 몸속에 폭풍을 일으키려는 듯했다." (**end_page())


translate japanese plot6_fate_silence_caption_7444b18d:


    nvl clear
    nvlNone "지금의 나로서는 이 거대한 힘을 제어할 수 없지만, 도로시아는 견딜 수 있었다." (**end_page())


translate japanese plot6_fate_silence_caption_ee52be90:


    nvlNone "나는 맞닿은 피부를 통해 둑을 넘으려는 마력을 전부 그녀에게 보냈다." (**end_page())


translate japanese plot6_fate_silence_caption_8b1513d3:



    voice "voice/equinox_48.ogg"
    nvl_equinox "무슨 느낌이 들어?" (**end_page())


translate japanese plot6_fate_silence_caption_bb89a455:



    voice "voice/dorothea_17.ogg"
    nvl_dorothea "아무 느낌도 없어."


translate japanese plot6_fate_silence_caption_ee07c0a0:



    voice "voice/dorothea_18.ogg"
    nvl_dorothea "굳이 말하자면 아사요의 피가 끈적거려서 기분 나빠." (**end_page(inline=True))


translate japanese plot6_fate_silence_caption_418e36f1:



    voice "voice/equinox_49.ogg"
    nvl_equinox "그래, 그래. 미안해——" (**end_page())


translate japanese plot6_fate_silence_caption_e582f5a7:


    nvlNone "아무리 마력을 흘려 넣어도 도로시아는 그 모든 것을 저장해 나갔다."


translate japanese plot6_fate_silence_caption_33592f69:


    nvlNone "그녀는 밑 없는 구덩이처럼 내게서 남는 마력을 빨아들이고 있었다." (**end_page())


translate japanese plot6_fate_silence_caption_bfe19137:



    voice "voice/dorothea_19.ogg"
    nvl_dorothea "얼마나 더 해야 해? 나 졸려——"


translate japanese plot6_fate_silence_caption_836c01a3:



    voice "voice/equinox_50.ogg"
    nvl_equinox "참고 조금만 더 기다려." (**end_page(inline=True))


translate japanese plot6_fate_silence_caption_9d28c46c:



    voice "voice/champion_22.ogg"
    champion "…"


translate japanese plot6_fate_silence_caption_3b1dabdd:



    voice "voice/equinox_51.ogg"
    equinox "용사."


translate japanese plot6_fate_silence_caption_f2f5c15c:



    voice "voice/champion_23.ogg"
    champion "어, 끝났어?"


translate japanese plot6_fate_silence_caption_908d16ef:



    voice "voice/equinox_52.ogg"
    equinox "응, 오래 기다렸지."


translate japanese plot6_fate_silence_caption_6e82e48f:


    "도로시아가 계속 망설이는 바람에 우리는 마차 안에서 한참 시간을 끌었다."


translate japanese plot6_fate_silence_caption_446ca5bc:


    "그동안 용사는 밖에서 혼자 모닥불을 지키고 있었다."


translate japanese plot6_fate_silence_caption_1a99e408:



    voice "voice/champion_24.ogg"
    champion "도로시아는?"


translate japanese plot6_fate_silence_caption_3eafbd1b:



    voice "voice/equinox_53.ogg"
    equinox "그 녀석은 그대로 잠들었어."


translate japanese plot6_fate_silence_caption_99d24be2:



    voice "voice/equinox_54.ogg"
    equinox "아직 다 넘기지 못한 마력이 좀 있어. 이따가 마도구에 저장할 거야."


translate japanese plot6_fate_silence_caption_816fd4e7:



    voice "voice/champion_25.ogg"
    champion "음——"


translate japanese plot6_fate_silence_caption_58073633:


    "용사는 대답하듯 작게 소리를 냈다."


translate japanese plot6_fate_silence_caption_09637a2e:


    "그 뒤로 긴 침묵이 이어졌다."


translate japanese plot6_fate_silence_caption_2010276f:


    "함께 지내는 동안 용사가 어떤 사람인지는 대강 파악했다."


translate japanese plot6_fate_silence_caption_1b664b70:


    "대부분 조용하지만 차가운 사람은 아니었다."


translate japanese plot6_fate_silence_caption_2f399426:


    "도로시아가 있을 때는 무슨 화제를 꺼내든 한마디씩 맞장구를 쳐 주었다."


translate japanese plot6_fate_silence_caption_41ca5b42:


    "하지만 지금은 나와 용사뿐이고, 도로시아는 마차에서 곤히 자고 있었다."


translate japanese plot6_fate_silence_caption_9bfe6287:


    "적당한 화제가 없다면 잠자리에 들 때까지 이렇게 조용히 모닥불만 지킬지도 몰랐다."


translate japanese plot6_fate_silence_caption_ba2be562:



    voice "voice/champion_26.ogg"
    champion "저기……"


translate japanese plot6_fate_silence_caption_8f350778:


    "뜻밖에도 잠시 후 용사가 입을 열었다."


translate japanese plot6_fate_silence_caption_ea6dcb21:



    voice "voice/champion_27.ogg"
    champion "그 결정을 좀 봐도 될까? 조금 궁금해서."


translate japanese plot6_fate_silence_caption_4cb52e92:



    voice "voice/equinox_55.ogg"
    equinox "용사, 취향이 좀 고약하네."


translate japanese plot6_fate_silence_caption_5e3cf5a6:



    voice "voice/equinox_56.ogg"
    equinox "아니면 나한테 그런 관심이 있어?"


translate japanese plot6_fate_silence_caption_83b0e514:


    "용사가 먼저 화제를 꺼내자 나도 흥미가 동했다."


translate japanese plot6_fate_silence_caption_101ba5ba:



    voice "voice/champion_28.ogg"
    champion "아, 아니, 그게, 그냥 궁금해서……"


translate japanese plot6_fate_silence_caption_d8f8b938:


    "용사는 당황했다. 이제야 자기 질문이 조금 무례했음을 알아차린 모양이었다."


translate japanese plot6_fate_silence_caption_bfaa938c:



    voice "voice/equinox_57.ogg"
    equinox "（이 사람도 부끄러워할 때가 있구나.）"


translate japanese plot6_fate_silence_caption_757ab71d:


    "용사의 작은 비밀을 알게 된 기분이었다. 나는 더 놀리지 않았다."


translate japanese plot6_fate_silence_caption_d41d8cd9_2:

    nvl clear


translate japanese plot6_fate_silence_caption_78d57b9b:


    equinox "자."


translate japanese plot6_fate_silence_caption_16f27808:


    "나는 윗옷을 풀어 등에 박힌 결정을 보여 주었다."


translate japanese plot6_fate_silence_caption_cfabbaca:


    "결정이 박힌 곳에서 불규칙한 무늬 몇 줄기가 뻗어 나와 등 전체를 뒤덮었다."


translate japanese plot6_fate_silence_caption_2c049032:



    voice "voice/champion_29.ogg"
    champion "음…… 정말 말 그대로 몸속에 박았네."


translate japanese plot6_fate_silence_caption_265a3c77:



    voice "voice/equinox_59.ogg"
    equinox 0410 "어쩔 수 없지. 여긴 내 마녀의 탑이 아니니까 일단 이렇게 거칠게 융합할 수밖에."


translate japanese plot6_fate_silence_caption_aa948637:


    "용사는 내 등을 꼼꼼히 살폈다. 눈이 마주치지는 않았지만 등에 닿는 시선이 어렴풋이 느껴져 화끈거렸다."


translate japanese plot6_fate_silence_caption_e07591bd:



    voice "voice/equinox_60.ogg"
    equinox 0406 "……다 봤어?"


translate japanese plot6_fate_silence_caption_0c9da820:


    "이번에는 내가 조금 부끄러워졌다."


translate japanese plot6_fate_silence_caption_039f6244:



    voice "voice/champion_30.ogg"
    champion "아, 미안. 일단 옷 입어."


translate japanese plot6_fate_silence_caption_1a935c0d:



    voice "voice/equinox_61.ogg"
    equinox "피가 좀 튀어서 마차 안에서 냄새가 날지도 몰라."


translate japanese plot6_fate_silence_caption_23034411:



    voice "voice/champion_31.ogg"
    champion "괜찮아. 신경 안 써."


translate japanese plot6_fate_silence_caption_7fcfca03:



    voice "voice/champion_32.ogg"
    champion "그런데 아프진 않아? 그런 걸 몸에 직접 박아 넣었잖아."


translate japanese plot6_fate_silence_caption_e73ed636:



    voice "voice/equinox_62.ogg"
    equinox "죽도록 아팠어! 도로시아가 서툴러서 더 그랬지." with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot6_fate_silence_caption_bffde4be:



    voice "voice/equinox_63.ogg"
    equinox "그래도 나중에는 이게 내 힘이 될 테니까, 이 정도 대가면 꽤 남는 장사야."


translate japanese plot6_fate_silence_caption_8aac536a:



    voice "voice/champion_33.ogg"
    champion "전부터 궁금했는데, 너랑 도로시아는 연인이야?"


translate japanese plot6_fate_silence_caption_c8dcef60:



    voice "voice/equinox_64.ogg"
    equinox "응? 왜 그렇게 물어?"


translate japanese plot6_fate_silence_caption_eceacf02:



    voice "voice/champion_34.ogg"
    champion "二人とも同じ指輪をしているだろう。あれは対の指輪ではないのか？"


translate japanese plot6_ring_detail_hold_617555dd:



    voice "voice/equinox_65.ogg"
    equinox "아…… 물건만 보면 {a=dictionary:dict_entry_67}결혼반지{/a}가 맞아. 형식적으로는."


translate japanese plot6_ring_detail_hold_2199cdc3:



    voice "voice/equinox_66.ogg"
    equinox "하지만 정확히 말하면 주인과 하인 관계에 가까워."


translate japanese plot6_ring_detail_hold_86c47b00:



    voice "voice/champion_35.ogg"
    champion "형식적이라고? 주인과 하인?"


translate japanese plot6_ring_detail_hold_ff670633:


    "내 설명이 용사에게 더 많은 의문을 안겨 준 모양이었다."


translate japanese plot6_ring_detail_hold_c7ed3277:



    voice "voice/champion_36.ogg"
    champion "마녀의 계약과 관련 있어?"


translate japanese plot6_ring_detail_hold_b1691e82:



    voice "voice/equinox_67.ogg"
    equinox "응, 맞아."


translate japanese plot6_ring_detail_hold_01d7f1d9:



    voice "voice/champion_37.ogg"
    champion "그럼 그렇게 많은 마력을 주고 나서 배신할까 봐 걱정되진 않아?"


translate japanese plot6_ring_detail_hold_1d06b866:



    voice "voice/equinox_68.ogg"
    equinox "그건 걱정할 필요 없어. 그 녀석은 마법에 재능이 없거든."


translate japanese plot6_ring_detail_hold_ed01edb6:



    voice "voice/equinox_69.ogg"
    equinox "마력을 아무리 많이 가져도 사용할 수가 없어."


translate japanese plot6_ring_detail_hold_46bef251:



    voice "voice/champion_38.ogg"
    champion "음, 그렇구나. 그래서 곁에 두고 대신 마력을 저장하게 하는 건가……"


translate japanese plot6_ring_detail_hold_24869322:


    "나와 도로시아의 사정은 용사의 생각보다 더 복잡했다."


translate japanese plot6_ring_detail_hold_84944099:


    "하지만 전부 털어놓을 필요는 없다고 생각했다."


translate japanese plot6_ring_detail_hold_d28a0565:


    "설명이 번거롭기도 했지만, 사실 우리가 용사와 그리 친밀한 사이도 아니었다."


translate japanese plot6_ring_detail_hold_6b80c453:


    "우리는 합의를 맺고 서로 협력하는 동료일 뿐이었다."


translate japanese plot6_ring_detail_hold_f31d3ff5:



    voice "voice/champion_39.ogg"
    champion "하나 더 물어볼게."


translate japanese plot6_ring_detail_hold_d41d8cd9:


    voice "staging/champion_40_glitch.ogg"


translate japanese plot6_ring_detail_hold_e6a487bf:


    champion "왜 【그것｜성수】의 힘을 쫓는 거야?{cps=0}qv1nao74pe99gneo2bvppprpppxzbnjdqwe41r6oitiawc5bzzngoi3ewan3yyogbweoqv1nao74pe99gn\neo2bvppprpppxzbnjdqwe41r6oitiawc5bzzngoi3ewan3yyogbweo{/cps}" (ctc=None)


translate japanese plot6_ring_detail_hold_1ae69c7f:


    voice "voice/equinox_0069.ogg"
    nvlNone "「…」"


translate japanese plot6_ring_detail_hold_24234e26:


    nvlNone "나는 말없이 복도를 지나갔다."


translate japanese plot6_ring_detail_hold_99187c41:


    nvlNone "{rb}이곳{/rb}{rt}{font=SourceHanSerifSC-Heavy.otf}{size=12}신ㅁㅗㄱ ㅇ카ㅅㅑ{/size}{/font}{/rt}에는 똑같은 규격의 유리관이 백 개 넘게 늘어서 있었다."


translate japanese plot6_ring_detail_hold_e2b2b17e:


    voice "voice/npc23_01.ogg"
    nvlNone "「이 배신자……」"


translate japanese plot6_ring_detail_hold_a559031f:


    voice "voice/npc_0002.ogg"
    nvlNone "「반드시 널 죽이겠어.\n여기서 나가면 가장 잔인한 방법으로 죽여 버릴 거야.」"


translate japanese plot6_ring_detail_hold_761478d0:


    voice "voice/npc_0003.ogg"
    nvlNone "「풀어 줘. 제발……」"


translate japanese plot6_ring_detail_hold_533815f7:


    voice "voice/npc_0004.ogg"
    nvlNone "「흑흑……」"


translate japanese plot6_ring_detail_hold_39ef74b1:


    nvlNone "욕설, 울부짖음, 협박, 애원."


translate japanese plot6_ring_detail_hold_703d264d:


    nvlNone "이곳에 끌려온 마녀들은 이전에 어떤 성격이었든,"


translate japanese plot6_ring_detail_hold_915a5dbc:


    nvlNone "예전에는 손을 쓸 수 없을 만큼\n강했을지도 모른다."


translate japanese plot6_ring_detail_hold_3f61dcf2:


    nvlNone "마법으로 나라 하나를 짓밟고,\n대륙마저 지배했던 이도 있었을 것이다."


translate japanese plot6_ring_detail_hold_610c5b61:


    nvlNone "하지만 이곳, 마나가 존재하지 않는 곳에서는."


translate japanese plot6_ring_detail_hold_c6b95a7a:


    nvlNone "나는 욕설을 무시하고 곧장 제어대로 향했다."


translate japanese plot6_ring_detail_hold_09bb9800:


    nvlNone "이 레버를 내리면,{p}유리관 속 죄수들에게 온갖 고문이 가해진다." (**end_page())


translate japanese plot6_ring_detail_hold_50102acb:


    nvlNone "毒殺、硫酸、斬首、針刺し、\n車輪刑、磔、胴斬り、槍、\n圧殺、串刺し、窒息、溺死、\n巨石、火あぶり、銃殺、人豚、\n貫通、車輪刑、糸鋸、絞首、\n頭蓋切開、回転刃、急速冷凍、腸抜き…"


translate japanese plot6_ring_detail_hold_a76a6dd9:


    nvlNone "하지만 마녀들은 진정한 해방을 얻지 못한다."


translate japanese plot6_ring_detail_hold_5917df89:


    nvlNone "유리관은 그들을 수없이 되살려 낸다.\n그들은 영원히 이 안에 갇혀 있게 된다."


translate japanese plot6_ring_detail_hold_f804c257:


    nvlNone "「――――」"


translate japanese plot6_ring_detail_hold_f5b04d06:


    nvlNone "긴 복도 깊은 곳에서 낮은 울림이 들려왔다."


translate japanese plot6_ring_detail_hold_9d38c7d4:


    nvlNone "그 울림의 의미를 이해할 수 있는 것은 나뿐이었다."


translate japanese plot6_ring_detail_hold_cc2cccac:


    nvlNone "「그분」의 말씀이었으니까."


translate japanese plot6_ring_detail_hold_3f02f7df:


    voice "voice/equinox_0070.ogg"
    nvlNone "「어머님.」{p}나는 복도 깊은 곳을 향해 인사를 올렸다." (callback=nvl_page_voice, cb_page_voices=('voice/equinox_0070.ogg', None))


translate japanese plot6_ring_detail_hold_f804c257_1:


    nvlNone "「――――」"


translate japanese plot6_ring_detail_hold_00f3ff71:


    nvlNone "그분은 오늘의 의식을 시작하라고 재촉했다."


translate japanese plot6_ring_detail_hold_80134a71:


    nvlNone "이 의식을 완수할 수 있는 것은 나뿐이었다."


translate japanese plot6_ring_detail_hold_77646cda:


    nvlNone "그것이 내가 이곳에 있는 이유이기도 했다."


translate japanese plot6_ring_detail_hold_929eb104:


    nvlNone "마녀들에게서 추출한 힘은,{p}마지막에는 모두 {glitch=10}{font=SourceHanSerifSC-Heavy.otf}신ㅁㅗㄱ▓▓▓ ㅇ카▒ㅅ░░ㅑ{/font}{/glitch}에 모인다."


translate japanese plot6_ring_detail_hold_e63d9251:


    nvlNone "내가 제어대에 다가갈수록,{p}감옥 속 마녀들의 협박은 잦아들고{p}애원은 커져 갔다."


translate japanese plot6_ring_detail_hold_1ae69c7f_1:


    nvlNone "「…」"


translate japanese plot6_ring_detail_hold_f804c257_2:


    nvlNone "「――――」"


translate japanese plot6_ring_detail_hold_7a49549a:


    nvlNone "어머니는 다시 나를 재촉했다."


translate japanese plot6_ring_detail_hold_82d9a393:


    nvlNone "나는 제어 레버를 당겼다{cps=*2}v1naope99gneo2bvcxzbnjdqwe41r6oitiaw5bngoi3ewan3ogbweo{/cps}{nw}" (what_language="unicode")


translate japanese plot6_ring_detail_hold_d41d8cd9_1:


    nvl clear



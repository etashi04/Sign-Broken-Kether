translate japanese plot6_ring_detail_hold_ee97bfa2:



    voice "voice/banzhang_96.ogg"
    banzhang "선생님, 다 풀었어요."


translate japanese plot6_ring_detail_hold_4fdb3739:



    voice "voice/npc19_05.ogg"
    npc19 "흐음…"


translate japanese plot6_ring_detail_hold_08ffff4a:



    voice "voice/npc19_06.ogg"
    npc19 "과정은 분명하게 잘 썼네. 문제없어."


translate japanese plot6_ring_detail_hold_2bf9b0a7:



    voice "voice/npc19_07.ogg"
    npc19 "다만 마지막 여기, 앞이 음수니까 빼기 부호가 되어야겠지."


translate japanese plot6_ring_detail_hold_18e2058b:



    voice "voice/banzhang_97.ogg"
    banzhang "아, 맞아요……"


translate japanese plot6_ring_detail_hold_3a584195:



    voice "voice/npc19_08.ogg"
    npc19 "응, 마지막 부분만 고치면 돼."


translate japanese plot6_ring_detail_hold_0221eca7:



    voice "voice/npc19_09.ogg"
    npc19 "다음에는 조금 더 꼼꼼히 보렴."


translate japanese plot6_ring_detail_hold_7f6416db:



    voice "voice/banzhang_98.ogg"
    banzhang "네, 선생님……"


translate japanese plot6_ring_detail_hold_b3618cfa:



    voice "voice/npc6_17.ogg"
    npc6 "웬일이야. 반장이 저런 실수를 다 하네."


translate japanese plot6_ring_detail_hold_e923a323:



    voice "voice/npc7_13.ogg"
    npc7 "체육 특기생들 요즘 훈련이 엄청 빡세서 피곤한가 봐."


translate japanese plot6_ring_detail_hold_370a20db:



    voice "voice/npc6_18.ogg"
    npc6 "곧 체육 시험이잖아. 그럴 만하네."


translate japanese plot6_ring_detail_hold_ae2e2214:



    voice "voice/npc7_14.ogg"
    npc7 "쉿—— 조용히 해! 선생님이 다음 문제 내시잖아!"


translate japanese plot6_ring_detail_hold_36923c65:



    voice "voice/banzhang_99.ogg"
    banzhang "…"


translate japanese plot6_ring_detail_hold_05d69eb2:



    voice "voice/npc19_10.ogg"
    npc19 "자, 다음 예제는……"


translate japanese plot6_ring_detail_hold_3b7d6dad:



    voice "voice/npc19_11.ogg"

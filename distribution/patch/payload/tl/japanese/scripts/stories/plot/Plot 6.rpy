translate japanese plot6_ring_detail_hold_936c4298_1:



    voice "voice/cygnus_894.ogg"
    cygnus "…"


translate japanese plot6_ring_detail_hold_0d09dd0f:



    voice "voice/cygnus_895.ogg"

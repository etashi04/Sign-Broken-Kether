translate japanese plot6_ring_detail_hold_73677a53:



    voice "voice/tianqin_1278.ogg"
    tianqin "어디 아파? 혹시 어제 다친 거야?"


translate japanese plot6_ring_detail_hold_de435bf3:



    voice "voice/cygnus_896.ogg"
    cygnus "아냐, 아무것도…… 어제 마력을 너무 많이 써서……"


translate japanese plot6_ring_detail_hold_5a90252e:



    voice "voice/cygnus_897.ogg"
    cygnus "한동안 푹 쉬면 괜찮아져."


translate japanese plot6_ring_detail_hold_dd0d615a:



    voice "voice/tianqin_1279.ogg"
    tianqin "그렇구나… 그럼 난 먼저 학교에 다녀올게."


translate japanese plot6_ring_detail_hold_6a2ec827:



    voice "voice/tianqin_1280.ogg"
    tianqin "점심은 냉장고에 넣어 뒀으니까 꼭 먹어."


translate japanese plot6_ring_detail_hold_49153c62:



    voice "voice/cygnus_898.ogg"
    cygnus "알겠어."


translate japanese plot6_ring_detail_hold_c7308579:



    voice "voice/npc19_01.ogg"
    npc19 "자, 여기까지 식을 정리하니 훨씬 익숙한 형태가 됐지?"


translate japanese plot6_ring_detail_hold_0e501bd3:



    voice "voice/npc19_02.ogg"
    npc19 "이것이 독립변수 x, 이것이 종속변수 y. 그래, 미지수가 두 개인 가장 흔한 연립일차방정식이 되었네."


translate japanese plot6_ring_detail_hold_85a5f8bb:



    voice "voice/npc19_03.ogg"
    npc19 "다음은 공식에 대입해서 해를 구하면……"


translate japanese plot6_ring_detail_hold_6324c156:



    voice "voice/npc19_04.ogg"
    npc19 "음, 반장. 나와서 이 예제를 풀어 볼래?"


translate japanese plot6_ring_detail_hold_0aa702ec:



    voice "voice/banzhang_95.ogg"

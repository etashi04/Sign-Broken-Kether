translate japanese plot6_ring_detail_hold_2313bd2e:



    voice "voice/tianqin_1281.ogg"
    tianqin "후우… Zzz…"


translate japanese plot6_ring_detail_hold_4c321d77:



    voice "voice/npc19_12.ogg"
    npc19 "라이라?"


translate japanese plot6_ring_detail_hold_10f67368:



    voice "voice/tianqin_1282.ogg"
    tianqin "Zzz…"


translate japanese plot6_ring_detail_hold_f35e2ab5:



    voice "voice/yangxi_347.ogg"
    yangxi "야, 라이라."


translate japanese plot6_ring_detail_hold_0f2418d7:


    "히나타는 앞자리로 발을 뻗어 라이라의 의자를 찼다."


translate japanese plot6_ring_detail_hold_d41d8cd9_2:

    voice "voice/equinox_0071.ogg"


translate japanese plot6_ring_detail_hold_00c95efd:


    npc19 "라이라!"


translate japanese plot6_ring_detail_hold_16d62ef2:



    voice "voice/tianqin_1283.ogg"
    tianqin "아! 어! 뭐야?"


translate japanese plot6_ring_detail_hold_6b09a990:



    voice "voice/npc19_14.ogg"
    npc19 "뭘 멍하니 있어? 나와서 이 문제 풀어 보라고."


translate japanese plot6_ring_detail_hold_e8e0c6cc:




    tianqin "크다아!"


translate japanese plot2_a460c53b:



    voice "voice/yangxi_118.ogg"
    yangxi "400~500미터쯤 된다잖아. 클 수밖에."


translate japanese plot2_64ef00ce:



    voice "voice/tianqin_415.ogg"
    tianqin "우리 시내 금융 빌딩은 높이가 얼마였지?"


translate japanese plot2_de13fc51:



    voice "voice/yangxi_119.ogg"
    yangxi "아마 180미터 정도였나."


translate japanese plot2_dd39b299:



    voice "voice/tianqin_416.ogg"
    tianqin "그럼 이 나무가 그 건물의 세 배라고!?"


translate japanese plot2_30d45657:



    voice "voice/yangxi_120.ogg"
    yangxi "아마도."


translate japanese plot2_02853c9f:



    voice "voice/tianqin_417.ogg"
    tianqin "우와～"


translate japanese plot2_0869e0c7:


    "라이라는 고개를 들어 거대한 나무를 올려다봤다. 끝은 전혀 보이지 않았다."


translate japanese plot2_ea48671e:


    "거인이 지상의 모든 것을 내려다보는 듯한 위압감에 저도 모르게 숨을 삼키게 된다."


translate japanese plot2_dc10f0b4:



    voice "voice/yangxi_121.ogg"
    yangxi "실감 나?"


translate japanese plot2_dabf5d47:



    voice "voice/tianqin_418.ogg"
    tianqin "전혀."


translate japanese plot2_ebf69d68:



    voice "voice/yangxi_122.ogg"
    yangxi "나도 그래. 꿈꾸는 것 같아."


translate japanese plot2_57f48bca:



    voice "voice/tianqin_419.ogg"
    tianqin "500미터라…… 얼마나 높은 건지 상상도 안 되네."


translate japanese plot2_e0e17a26:



    voice "voice/tianqin_420.ogg"
    tianqin "아, 저기! 흰 가운 입은 사람들이 있어!"


translate japanese plot2_9c02b0cf:



    voice "voice/yangxi_123.ogg"
    yangxi "다른 곳에서 달려온 과학자랑 연구원들이겠지."


translate japanese plot2_b29a7dda:



    voice "voice/yangxi_124.ogg"
    yangxi "하룻밤 만에 이런 나무가 자라다니, 너무 이상하잖아."


translate japanese plot2_b3aba1b3:



    voice "voice/yangxi_125.ogg"
    yangxi "학계가 난리겠지. 자칫하면 {a=dictionary:dict_entry_26}「특이점」{/a} 같은 사건이 될지도 몰라."


translate japanese plot2_9c25ca30:



    voice "voice/tianqin_421.ogg"
    tianqin "초자연 현상이니까."


translate japanese plot2_6bb45606:



    voice "voice/yangxi_126.ogg"
    yangxi "뭐?"


translate japanese plot2_3969c4b0:



    voice "voice/tianqin_422.ogg"
    tianqin "어? 히나타는 그렇게 생각 안 해?"


translate japanese plot2_27a59955:



    voice "voice/tianqin_423.ogg"
    tianqin "과학으로 설명 못 하는 현상이 초자연 현상이잖아."


translate japanese plot2_a6c32f4d:



    voice "voice/yangxi_127.ogg"
    yangxi "아니, 지금이 중세도 아니잖아."


translate japanese plot2_ae940121:



    voice "voice/yangxi_128.ogg"
    yangxi "연구자들이 자료를 모아 제대로 분석하면 원인 정도는 찾을 거야."


translate japanese plot2_4bcd03a0:



    voice "voice/tianqin_424.ogg"
    tianqin "분석해도 못 밝히는 경우는 있잖아?"


translate japanese plot2_27629f2e:



    voice "voice/tianqin_425.ogg"
    tianqin "だから、もしかしたらやっぱり超自然現象かも……"


translate japanese plot2_15a9ede0:



    voice "voice/yangxi_129.ogg"
    yangxi "（뭐야, 얘 오늘은 왜 이렇게 「초자연 현상」에 집착하지?）"


translate japanese plot2_10c9d027:



    voice "voice/yangxi_130.ogg"
    yangxi "뭐, 일단 지켜보자. 과학자들의 견해를 기다리는 거야."


translate japanese plot2_6147b0b5:



    voice "voice/tianqin_426.ogg"
    tianqin "（으음…… 그래도 이건 시노스의 힘과 관련 있을 가능성이 클지도…）"


translate japanese plot2_7948f6de:



    voice "voice/tianqin_427.ogg"
    tianqin "（돌아가면 물어봐야지.）"


translate japanese plot2_913a6f2e:


    "둘이 거목을 떠날 때 해가 졌다."


translate japanese plot2_9b29cb77:


    "陽汐は天琴の「飛び降りようよ！」という提案を完全に無視し、周囲の人が設置した梯子を使って慎重に降りた。"


translate japanese plot2_0987bdbc:



    voice "voice/tianqin_428.ogg"
    tianqin "그냥 뛰어내리라니까. 내가 받아 준다고 했잖아."


translate japanese plot2_e9a159a0:



    voice "voice/tianqin_429.ogg"
    tianqin "그랬으면 이렇게 멀리 돌아오지 않아도 됐는데."


translate japanese plot2_0b9b15fe:



    voice "voice/yangxi_131.ogg"
    yangxi "이쪽이 더 안전하잖아."


translate japanese plot2_898c7038:



    voice "voice/tianqin_430.ogg"
    tianqin "그냥 날 못 믿는 거지!"


translate japanese plot2_62ad46d2:



    voice "voice/yangxi_132.ogg"
    yangxi "그냥 이쪽이 더 안전한 거야."


translate japanese plot2_a3c66605:



    voice "voice/tianqin_431.ogg"
    tianqin "못 믿는 거 맞잖아!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot2_373bf3d1_1:



    voice "voice/xiaoxia_18.ogg"
    xiaoxia "……"


translate japanese plot2_b4da0487:



    voice "voice/xiaoxia_19.ogg"
    xiaoxia "……후우"


translate japanese plot2_d2250acb:



    voice "voice/tianqin_432.ogg"
    tianqin "아키나?"


translate japanese plot2_a0a19017_2:



    voice "voice/yangxi_133.ogg"
    yangxi "안녕."


translate japanese plot2_2a5d11ea:



    voice "voice/xiaoxia_20.ogg"
    xiaoxia "히익!? 아, 아으……" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot2_07d2e4c2:



    voice "voice/xiaoxia_21.ogg"
    xiaoxia "라이라 씨, 히나타 씨……"


translate japanese plot2_5671b79b:



    voice "voice/tianqin_433.ogg"
    tianqin "미안, 미안. 놀랐어? 아직 안 갔길래 인사하러 왔어."


translate japanese plot2_35e048a8:



    voice "voice/xiaoxia_22.ogg"
    xiaoxia "아, 아니에요…… 그런 건……"


translate japanese plot2_31319451:



    voice "voice/tianqin_434.ogg"
    tianqin "あれ？鶴城たちは？"


translate japanese plot2_a315638f:



    voice "voice/xiaoxia_23.ogg"
    xiaoxia "아, 그, 그쪽은 방금 돌아갔어요……"


translate japanese plot2_14b0bb6e:



    voice "voice/tianqin_435.ogg"
    tianqin "그렇구나. 좀 서두르는 것 같던데 무슨 볼일이라도 있었어?"


translate japanese plot2_c97b93cd:



    voice "voice/xiaoxia_24.ogg"
    xiaoxia "……아, 그게…… 체육 선생님이 부탁하신 일이 좀 있어서요……"


translate japanese plot2_cfdddb8e:



    voice "voice/tianqin_436.ogg"
    tianqin "흐음……?"


translate japanese plot2_2d8b9e62_1:



    voice "voice/yangxi_134.ogg"
    yangxi "……"


translate japanese plot2_373bf3d1_2:



    voice "voice/xiaoxia_25.ogg"
    xiaoxia "……"


translate japanese plot2_c579a697:



    voice "voice/xiaoxia_26.ogg"
    xiaoxia "저, 저기…… 볼일 없으시면 저는 이제 돌아갈게요……" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot2_285dc5ac:



    voice "voice/tianqin_437.ogg"
    tianqin "아, 그래. 잘 가——"


translate japanese plot2_fe852edf:



    voice "voice/tianqin_438.ogg"
    tianqin "히나타, 그렇게 빤히 쳐다보지 마."


translate japanese plot2_42f26b9e:



    voice "voice/tianqin_439.ogg"
    tianqin "봐, 도망가 버렸잖아."


translate japanese plot2_6a0fc766:



    voice "voice/yangxi_135.ogg"
    yangxi "그런가?"


translate japanese plot2_1f3b8d37:



    voice "voice/tianqin_440.ogg"
    tianqin "그렇다니까. 히나타 눈빛은 좀 무섭거든."


translate japanese plot2_9c617926:



    voice "voice/yangxi_136.ogg"
    yangxi "별거 아냐. 조금 신경 쓰였을 뿐이야. ……거짓말을 하고 있었으니까."


translate japanese plot2_8eddd745:



    voice "voice/tianqin_441.ogg"
    tianqin "에이, 말하기 싫다는데 우리가 신경 쓰지 말자."


translate japanese plot2_f0205bed:



    voice "voice/tianqin_442.ogg"
    tianqin "그렇게 내성적인 애를 빤히 쳐다보면 더 불편하잖아."


translate japanese plot2_ffaca625:



    voice "voice/yangxi_137.ogg"
    yangxi "내성적이라기보다 겁이 많은 거겠지."


translate japanese plot2_7b91a36f:



    voice "voice/tianqin_443.ogg"
    tianqin "으음…… 그러고 보니 1학년 때는 옆 반이었는데, 그때는 더 밝았지……"


translate japanese plot2_f03e3d6a:



    voice "voice/tianqin_444.ogg"
    tianqin "요즘 왜 이렇게 달라졌지?"


translate japanese plot2_11d3e179:



    voice "voice/yangxi_138.ogg"
    yangxi "요즘 성적이 떨어진다더라. 이것저것 혼자 짊어지고 있는 거 아닐까."


translate japanese plot2_5ca96925:



    voice "voice/yangxi_139.ogg"
    yangxi "여기 온 것도 기분 전환을 하고 싶어서였겠지?"


translate japanese plot2_cad06b8e:



    voice "voice/tianqin_445.ogg"
    tianqin "하아, 고등학생도 참 힘들구나."


translate japanese plot2_79091a1d:



    voice "voice/yangxi_140.ogg"
    yangxi "너도 그 「고등학생」 중 하나라는 거 안 잊었지?"


translate japanese plot2_cb5894b0:



    voice "voice/cygnus_180.ogg"
    cygnus "……흠, 「컴퓨터」란 대강 이런 거구나."


translate japanese plot2_cd173093:


    "마녀는 하루 종일 독수리 타법으로 키보드를 두드렸다."


translate japanese plot2_b8404816:


    "「パソコン」という機械を通じて、「インターネット」と呼ばれる不思議なものにアクセスし、この世界の大まかな全貌を掴みつつあった。"


translate japanese plot2_32fa0c89:



    voice "voice/cygnus_181.ogg"
    cygnus "（이 세계의 과학은 정말 놀라울 만큼 발전했어……）"


translate japanese plot2_f4f7b202:



    voice "voice/cygnus_182.ogg"
    cygnus "（마나가 없는 세계라 미개한 땅인 줄 알았는데, 오히려 문명은 훨씬 앞서 있잖아.）"


translate japanese plot2_115a4f92:



    voice "voice/cygnus_183.ogg"
    cygnus "（……그렇다면 우리 마법이야말로 과학의 발전을 막고 있었는지도 모르겠네.）"


translate japanese plot2_bf4481da:



    voice "voice/cygnus_184.ogg"
    cygnus "（비교하자면 우리 세계는 여기보다 몇백 년은 뒤처졌겠지.）"


translate japanese plot2_a2f976e5:


    "두 세계를 비교해 본 시노스는 「원래 세계」가 더 낫다고 생각하지 않았다."


translate japanese plot2_04b22f7d:


    "시노스에게는 원주민으로서의 자존심 같은 건 없었다. 그저 두 세계의 차이에 흥미를 느꼈을 뿐이다."


translate japanese plot2_9017cc81:



    voice "voice/cygnus_185.ogg"
    cygnus "（그리고 또 하나, 이 세계의 「무기」.）"


translate japanese plot2_44d1a8ab:



    voice "voice/cygnus_186.ogg"
    cygnus "（몇백 년 전까지는 이 세계의 전쟁에서도 근접 무기로 싸웠던 모양이야.）"


translate japanese plot2_4ff79b87:



    voice "voice/cygnus_187.ogg"
    cygnus "（하지만 총이 개량되면서 냉병기는 완전히 쇠퇴했어……）"


translate japanese plot2_6548b89c:



    voice "voice/cygnus_188.ogg"
    cygnus "（마법으로 방어할 수 없으니 총이라는 무기가 너무 강했던 거네.）"


translate japanese plot2_49460252:



    voice "voice/cygnus_189.ogg"
    cygnus "（……아니, 방탄 마법이 있더라도 모든 총알을 막아 낼 수 있다고는 못 해.）"


translate japanese plot2_df8e68df:


    "마녀의 세계에도 화약으로 쏘는 수발총은 있었지만, 위력은 현대 총기에 한참 못 미쳤다."


translate japanese plot2_38be541f:


    "게다가 방호 마법이 널리 퍼져 탄환이 마력 장벽을 뚫는 일은 드물었고, 총은 경시되었다."


translate japanese plot2_a73e7c3e:


    "반면 이 세계의 전쟁에서 주역은 더 이상 인간이 아니라 그 손에 쥔 무기였다."


translate japanese plot2_aa8b69d8:


    "위력이 강한 총기, 두꺼운 장갑을 두른 전차, 바다를 가르는 군함, 음속을 넘어 나는 전투기……"


translate japanese plot2_ca6cd63c:


    "이 현대 무기들은 마녀의 세계에서는 상상도 못 할 존재였다."


translate japanese plot2_1e991102:



    voice "voice/cygnus_190.ogg"
    cygnus "（그리고 약 200년 전, 이 세계에서는 50년이나 이어진 대전이 일어났어……）"


translate japanese plot2_52a0d4c4:



    voice "voice/cygnus_191.ogg"
    cygnus "（기나긴 전쟁으로 질서가 무너지고, 인류는 멸망 직전까지 몰렸지.）"


translate japanese plot2_dfc9beed:



    voice "voice/cygnus_192.ogg"
    cygnus "（결국 승자가 없는 채로 싸움은 끝을 맞았어……）"


translate japanese plot2_1f92fe73:



    voice "voice/cygnus_193.ogg"
    cygnus "（그 뒤 국경이라는 개념이 사라지고, 각지가 연맹을 맺으며 「지구」라는 형태로 바뀌었어――）"


translate japanese plot2_f0f75821:



    voice "voice/cygnus_194.ogg"
    cygnus "（그 이후 이 세계에서는 대규모 전쟁이 단 한 번도 일어나지 않았고……）"


translate japanese plot2_524d1bf1:



    voice "voice/cygnus_195.ogg"
    cygnus "（흠……　그 전쟁의 그림자가 지금도 이 세계의 질서를 지탱한다는 건가……）"


translate japanese plot2_bbec3d8f:



    voice "voice/cygnus_196.ogg"
    cygnus "（……이상하네. 뭔가 위화감이 들어……）"


translate japanese plot2_dfc9523e:


    "이제 많은 이에게 「전쟁」은 그저 먼 옛날이야기일 뿐이었다."


translate japanese plot2_26cfaa62:


    "일부 지구에서 산발적인 충돌이 있을 뿐, 이 세계의 사회 질서는 매우 안정적이었다."


translate japanese plot2_1101277e:



    voice "voice/cygnus_197.ogg"
    cygnus "（법이 정비되어 있고, 질서를 지키는 기관도 아주 강력해……）"


translate japanese plot2_6eef1b3a:



    voice "voice/cygnus_198.ogg"
    cygnus "（……조심해서 움직여야겠네.）"


translate japanese plot2_eb7b1c36:


    "この穏やかで安定した世界は、シノスにとって、いいことでもあり、悪いことでもある。"


translate japanese plot2_dfe5dd8c:


    "아마 혼돈을 추구하는 마녀의 본능이리라. 시노스는 지나치게 정돈된 세계보다 모호하고 불확실한 회색 지대를 좋아했다."


translate japanese plot2_d816aafe:


    "하지만 동시에 범죄의 대가가 큰 이 세계에서는, 힘을 잃은 지금의 시노스도 안전하게 살아갈 수 있다."


translate japanese plot2_965cce82:



    voice "voice/cygnus_199.ogg"
    cygnus "새옹지마네……"


translate japanese plot2_9b610242:


    "찰칵——"


translate japanese plot2_e9135d94:



    voice "voice/tianqin_446.ogg"
    tianqin "다녀왔어—!"


translate japanese plot2_9d63698d:



    voice "voice/tianqin_447.ogg"
    tianqin "미안, 미안. 집에 혼자 두고 가서."


translate japanese plot2_fe174cb3:



    voice "voice/cygnus_200.ogg"
    cygnus "괜찮아. 잠시 여기 머물게 해 준 것만으로도 충분히 고마워."


translate japanese plot2_e59d1cde:



    voice "voice/cygnus_201.ogg"
    cygnus "（……뭐, 혼자 있는 쪽이 편하긴 하지만.）"


translate japanese plot2_f59a9ac9:



    voice "voice/tianqin_448.ogg"
    tianqin "어? 남겨 둔 점심 안 먹었어?"


translate japanese plot2_bcc9bec4:



    voice "voice/cygnus_202.ogg"
    cygnus "잊었어. 컴퓨터에 너무 집중해서."


translate japanese plot2_f1818306:



    voice "voice/tianqin_449.ogg"
    tianqin "정말～! 밥은 제대로 먹어야지."


translate japanese plot2_eb6d7476:



    voice "voice/tianqin_450.ogg"
    tianqin "좋아, 지금 바로 밥 할게."


translate japanese plot2_4b52d8be:



    voice "voice/cygnus_203.ogg"
    cygnus "그러고 보니……"


translate japanese plot2_f0e2e7e7:



    voice "voice/tianqin_451.ogg"
    tianqin "응?"


translate japanese plot2_7e60b251:



    voice "voice/cygnus_204.ogg"
    cygnus "このパソコン、さっきから動きがすごく鈍いんですけど。"


translate japanese plot2_cfbf6dea:



    voice "voice/tianqin_452.ogg"
    tianqin "아!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_071ccea6:


    "라이라는 앞치마를 팽개치고 순식간에 컴퓨터 앞으로 달려갔다."


translate japanese plot2_1f803e2b:



    voice "voice/tianqin_453.ogg"
    tianqin "아이고—— 역시 이랬구나."


translate japanese plot2_f0528c6e:


    "화면 오른쪽 아래에는 정체 모를 백신 프로그램들이 줄지어 있었다."


translate japanese plot2_edcaeae5:


    "떠 있는 작은 창도 여러 개였고, 이따금 이상한 페이지까지 튀어나왔다."


translate japanese plot2_9aaf2fe4:



    voice "voice/cygnus_205.ogg"
    cygnus "무슨 일인데?"


translate japanese plot2_da5f292d:



    voice "voice/tianqin_454.ogg"
    tianqin "필요 없는 프로그램이 너무 많이 깔려서 잘 안 돌아가는 거야."


translate japanese plot2_3a1d80b6:



    voice "voice/cygnus_206.ogg"
    cygnus "「프로그램」?"


translate japanese plot2_f7f069de:



    voice "voice/tianqin_455.ogg"
    tianqin "그러니까, 「프로그램」이란……"


translate japanese plot2_c808ee42:


    "라이라는 많은 시간을 들여 「프로그램」과 {a=dictionary:dict_entry_27}「불량 소프트웨어」{/a}의 차이를 차근차근 설명했다. 컴퓨터가 왜 느려지는지도 제대로 설명해 주었다."


translate japanese plot2_3e09afdd:



    voice "voice/cygnus_207.ogg"
    cygnus "그러니까 화면에 뜬 「설치하시겠습니까」라는 말에 따른 탓이야?"


translate japanese plot2_5a48e33a:



    voice "voice/tianqin_456.ogg"
    tianqin "맞아, 맞아. 바로 그거!"


translate japanese plot2_bb0bfca1:



    voice "voice/cygnus_208.ogg"
    cygnus "다들 「컴퓨터를 지켜 드립니다」라고 적혀 있었는데."


translate japanese plot2_c28db4be:



    voice "voice/tianqin_457.ogg"
    tianqin "그건 전부 거짓말이야."


translate japanese plot2_8589c523:



    voice "voice/tianqin_458.ogg"
    tianqin "이 세계에는 그런 교활한 나쁜 사람이 많아. 조심해야 해."


translate japanese plot2_84fea05a:


    "꼬르르륵——"


translate japanese plot2_3293640e:



    voice "voice/tianqin_459.ogg"
    tianqin "아하하, 미안. 말하다 보니 배고파졌네." with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_69f81031:



    voice "voice/tianqin_460.ogg"
    tianqin "아무튼 조심해. 이제 수상한 사이트에서 프로그램 설치하지 말고."


translate japanese plot2_2727a767:



    voice "voice/cygnus_209.ogg"
    cygnus "알았어."


translate japanese plot2_d20736e1:



    voice "voice/tianqin_461.ogg"
    tianqin "（……혹시 여기 음식이 입에 안 맞나?）"


translate japanese plot2_7906b4e5:



    voice "voice/tianqin_462.ogg"
    tianqin "（그러고 보니 시노스는 젓가락질이 서툴렀지…… 그럼 혹시 서쪽 지구 음식을 좋아하나?）"


translate japanese plot2_449bc035:



    voice "voice/tianqin_463.ogg"
    tianqin "（좋아, 오늘은 큰맘 먹고 양식으로 해 보자!）"


translate japanese plot2_c01660b0:



    voice "voice/tianqin_464.ogg"
    tianqin "짜자안! 저녁 다 됐어!"


translate japanese plot2_103b5720:



    voice "voice/tianqin_465.ogg"
    tianqin "ごめんね、聞かずに勝手に作っちゃったけど。"


translate japanese plot2_e92533d9:



    voice "voice/tianqin_466.ogg"
    tianqin "口に合うといいな。"


translate japanese plot2_4508e499:



    voice "voice/cygnus_210.ogg"
    cygnus "먹을 수만 있으면 돼."


translate japanese plot2_4e353fcc:


    "……딱히 먹지 않아도 문제는 없다."


translate japanese plot2_df3f8284:


    "마녀에게 식사는 그저 「사람처럼 보이기 위한 행위」에 불과했다."


translate japanese plot2_55399f26:



    voice "voice/tianqin_467.ogg"
    tianqin "너희 세계 음식은 우리랑 많이 달라?"


translate japanese plot2_540c8546:



    voice "voice/cygnus_211.ogg"
    cygnus "아니, 사실 거의 같아."


translate japanese plot2_b1c5aa9f:



    voice "voice/cygnus_212.ogg"
    cygnus "그 세계에도 같은 곡물과 채소, 고기가 있어."


translate japanese plot2_c9e62929:



    voice "voice/cygnus_213.ogg"
    cygnus "요리법은 지역마다 다르지만, 전체적으로는 이 세계와 크게 다르지 않아."


translate japanese plot2_36bd1d5b:



    voice "voice/cygnus_214.ogg"
    cygnus "（가장 큰 차이라면 {a=dictionary:dict_entry_28}마물 계열{/a} 식재료가 없다는 걸까.）"


translate japanese plot2_0dfa1f71:



    voice "voice/tianqin_468.ogg"
    tianqin "그렇구나……"


translate japanese plot2_60af177b:



    voice "voice/cygnus_215.ogg"
    cygnus "비교하자면 그쪽 식문화는 너희의 700, 800년 전쯤이겠네."


translate japanese plot2_3bde3be7:



    voice "voice/tianqin_469.ogg"
    tianqin "아, 그럼 설마――"


translate japanese plot2_b0cddccf:



    voice "voice/cygnus_216.ogg"
    cygnus "{a=dictionary:dict_entry_29}「중세」{/a}——라고 했지? 대강 그 정도 수준이야."


translate japanese plot2_c7edb69c:



    voice "voice/cygnus_217.ogg"
    cygnus "굽든 삶든, 불 세기를 마음대로 조절할 도구도 없으니 서민들의 음식은 아주 볼품없어."


translate japanese plot2_a262c1c7:



    voice "voice/tianqin_470.ogg"
    tianqin "마법이 있잖아? 마법으로 하면……"


translate japanese plot2_b6d94546:



    voice "voice/cygnus_218.ogg"
    cygnus "응, 이론상 가능하지만…… 불 세기를 일정하게 유지하려면 계속 마력을 조절해야 해. 아주 피곤한 일이지."


translate japanese plot2_330cf7e0:



    voice "voice/cygnus_219.ogg"
    cygnus "귀족을 모시는 요리사 중에는 마법사가 많아서 마력으로 요리해. 하지만 보통 사람들에게는 장작을 태우는 쪽이 훨씬 경제적이야."


translate japanese plot2_9c2913af:



    voice "voice/tianqin_471.ogg"
    tianqin "그, 그런 건…… 엄청 원시적이네……"


translate japanese plot2_e5f5aeee:


    "라이라는 문득 예전에 읽은 판타지 소설이 떠올랐다."


translate japanese plot2_50a99506:


    "剣と魔法の世界で、人々の生活レベルが中世に留まっている。"


translate japanese plot2_79f528c5:


    "그리고 이야기의 주인공은 중세 생활에 도무지 적응하지 못해 여기저기 소동을 일으키다가, 마지막에는 「이제 현대로 돌아가고 싶어!」 하고 소리쳤다."


translate japanese plot2_9b137239:



    voice "voice/tianqin_472.ogg"
    tianqin "（……그게 웃자고 하는 얘기가 아니었구나!）"


translate japanese plot2_e0cb1541:



    voice "voice/tianqin_473.ogg"
    tianqin "시노스는 이 세계 생활에 잘 적응할 수 있겠어?"


translate japanese plot2_20305356:



    voice "voice/cygnus_220.ogg"
    cygnus "후후, 아직 모르는 건 많지만…… 문제없을 거야."


translate japanese plot2_9c8e1ca9:



    voice "voice/cygnus_221.ogg"
    cygnus "왜 물어?"


translate japanese plot2_e3ab4584:



    voice "voice/tianqin_474.ogg"
    tianqin "별거 아니야. 그냥 궁금해서."


translate japanese plot2_754f3cb6:



    voice "voice/tianqin_475.ogg"
    tianqin "（다행이다. 시노스도 돌아가고 싶다고 하면 곤란하니까.）"


translate japanese plot2_0857e664:



    voice "voice/tianqin_476.ogg"
    tianqin "あ、そうだ！ネットで注文してた服、届いたんだよ！"


translate japanese plot2_b7e45e64:



    voice "voice/cygnus_222.ogg"
    cygnus "오…… 「인터넷 쇼핑」은 정말 빠르네."


translate japanese plot2_2958306d:



    voice "voice/tianqin_477.ogg"
    tianqin "응. 인터넷으로 사면 대부분 다음 날 집에 도착해."


translate japanese plot2_b1f9f5a1:



    voice "voice/tianqin_478.ogg"
    tianqin "입어 볼래?"


translate japanese plot2_68a2eaf5:



    voice "voice/cygnus_223.ogg"
    cygnus "응, 저녁 먹고 입어 볼게."


translate japanese plot2_936c4298_1:



    voice "voice/cygnus_224.ogg"
    cygnus "……"


translate japanese plot2_c1dc1da3:



    voice "voice/cygnus_225.ogg"
    cygnus "（오…… 이게 이 세계의 옷차림인가……）"


translate japanese plot2_441c35b0:



    voice "voice/cygnus_226.ogg"
    cygnus "（그렇군…… 옷감 촉감도 나쁘지 않아.）"


translate japanese plot2_9f0e8928:



    voice "voice/tianqin_479.ogg"
    tianqin "어때? 잘 맞아?"


translate japanese plot2_02b2b98f:



    voice "voice/cygnus_227.ogg"
    cygnus "딱 맞아."


translate japanese plot2_f80b96a3:



    voice "voice/tianqin_480.ogg"
    tianqin "다행이다."


translate japanese plot2_7ffb94c7:



    voice "voice/tianqin_481.ogg"
    tianqin "안 맞으면 언제든 바꿀 수 있어. 다만 시간이 좀 걸리겠지만."


translate japanese plot2_2e3dabf6:



    voice "voice/cygnus_228.ogg"
    cygnus "네가 입는 스타일의 옷은 없어? 거리에서도 비슷한 옷을 입은 사람을 많이 봤는데."


translate japanese plot2_5b118c04:



    voice "voice/tianqin_482.ogg"
    tianqin "이건 안 돼. 우리 학교 교복이라 학생만 입는 거야."


translate japanese plot2_052201a7:



    voice "voice/tianqin_483.ogg"
    tianqin "私の年に見えたら大丈夫だけど。シノスちゃんが昨日みたいにちょっと大きくなれたら、混ざってもバレないかもしれないけどね。"


translate japanese plot2_c242a64c:



    voice "voice/cygnus_229.ogg"
    cygnus "안 돼. 그 모습은 마력이 너무 많이 들어. 지금 모습을 유지하는 편이 나아."


translate japanese plot2_c33fd140:



    voice "voice/tianqin_484.ogg"
    tianqin "응, 그럼 지금 옷이 더 좋겠다."


translate japanese plot2_a006de55:



    voice "voice/tianqin_485.ogg"
    tianqin "게다가 학생들은 대부분 수업 중이니까, 평소에 교복 입고 나가면 오히려 눈에 띌 거야."


translate japanese plot2_f11b5068:



    voice "voice/cygnus_230.ogg"
    cygnus "그렇구나."


translate japanese plot2_e5394d1e:



    voice "voice/cygnus_231.ogg"
    cygnus "（이 사람 판단을 따르자. 난 아직 이 세계를 잘 몰라……）"


translate japanese plot2_e6379676:



    voice "voice/npc2_05.ogg"
    npc2 "……다음은 오늘의 뉴스입니다."


translate japanese plot2_b8194599:



    voice "voice/npc2_06.ogg"
    npc2 "……오늘 룽화시 중앙 공원에 정체불명의 거대한 나무가 솟아올랐습니다."


translate japanese plot2_e3301170:



    voice "voice/npc2_07.ogg"
    npc2 "현재 나무의 종류는 확인되지 않았으며, 전문가들은 조사를 계속하고 있다고 밝혔습니다."


translate japanese plot2_04dd22da:



    voice "voice/npc2_08.ogg"
    npc2 "その大きさは現存する最大の杉の十数倍、高さはおよそ四百から五百メートル、なお成長を続けている模様です。"


translate japanese plot2_6dd0117d:



    voice "voice/npc2_09.ogg"
    npc2 "전문가들은 시민들에게 인근에서 대피할 것을 당부하고 있습니다. 이 거목이 생명이나 재산에 위험을 끼칠 가능성이 있다고 합니다."


translate japanese plot2_d3a686e8:



    voice "voice/npc2_10.ogg"
    npc2 "…저희 방송국에서는 앞으로도 이 거목의 동향을 지켜보겠습니다."


translate japanese plot2_442941ca_1:


    "……"


translate japanese plot2_f95d6537:



    voice "voice/tianqin_486.ogg"
    tianqin "아! 맞다! 이거, 이거야!"


translate japanese plot2_9cc08c75_1:



    voice "voice/cygnus_232.ogg"
    cygnus "뭐가?"


translate japanese plot2_f9c1726a:


    "시노스는 아직 자신이 입은 현대식 옷에 정신이 팔려, TV에서 무슨 말을 하는지 전혀 듣지 못했다."


translate japanese plot2_2cb84e76:


    tianqin "이거, 이거, 이거!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot2_8d1ec004:


    "라이라는 황급히 휴대폰으로 방금 뉴스를 열어 시노스에게 보여 주었다."


translate japanese plot2_b28b7770:



    voice "voice/cygnus_233.ogg"
    cygnus "……거목 얘기구나. 오후에 나도 컴퓨터로 조금 찾아봤어."


translate japanese plot2_8312f53d:



    voice "voice/tianqin_488.ogg"
    tianqin "역시 이거 시노스의 힘이랑 관련 있는 거 아냐?"


translate japanese plot2_739fd049:



    voice "voice/cygnus_234.ogg"
    cygnus "지금은 단정할 수 없어. 가능성이 크다고만 할 수 있지."


translate japanese plot2_6e1f8458:



    voice "voice/tianqin_489.ogg"
    tianqin "오늘 수업 끝나고 잠깐 가 봤어."


translate japanese plot2_897bff1e:



    voice "voice/cygnus_235.ogg"
    cygnus "뭐 좀 알아냈어? 예를 들면 위험한 마물이 나타났다든가."


translate japanese plot2_52a82914:



    voice "voice/tianqin_490.ogg"
    tianqin "아니, 이 일대에는 사람이 가득하니까 아마 괜찮을 거야."


translate japanese plot2_fdf8373a:



    voice "voice/cygnus_236.ogg"
    cygnus "음…… 그렇구나……"


translate japanese plot2_83a22caa:



    voice "voice/cygnus_237.ogg"
    cygnus "마침 옷도 생겼으니 내일 조사하러 가 볼게."


translate japanese plot2_aee91581:



    voice "voice/tianqin_491.ogg"
    tianqin "어, 갈 거야? 내가 안내해 줄까? 꽤 머니까."


translate japanese plot2_9d76e80d:



    voice "voice/cygnus_238.ogg"
    cygnus "괜찮아. 혼자 가면 돼."


translate japanese plot2_ca42d95c:



    voice "voice/cygnus_239.ogg"
    cygnus "게다가 방금 네가 그랬잖아. 학생들은 평소에 수업을 듣는다고. 네가 따라오면 눈에 띄겠지."


translate japanese plot2_3c5cffe1:



    voice "voice/tianqin_492.ogg"
    tianqin "으으……! 그렇기는 한데……"


translate japanese plot2_7ec363ab:


    "（사실 라이라는 내일 땡땡이칠 구실이 필요했을 뿐이었다.）"


translate japanese plot2_f778a356:



    voice "voice/tianqin_493.ogg"
    tianqin "でも、気をつけてね！もし迷ったら、この住所をお巡りさんに伝えて。それから、知らない人に話しかけられたら絶対相手にしないでね……"


translate japanese plot2_dabeeadb:



    voice "voice/cygnus_240.ogg"
    cygnus "（꼭 진짜 동생 취급을 받는 것 같네……）"


translate japanese plot2_b1b5dd5f:



    voice "voice/cygnus_241.ogg"
    cygnus "걱정 마. 길은 안 잃어."


translate japanese plot2_94dee3f5:



    voice "voice/cygnus_242.ogg"
    cygnus "여기에 길 찾기 마법을 걸어 뒀어. 아무리 멀리 가도 돌아오는 길을 찾을 수 있어."


translate japanese plot2_776d85a9:



    voice "voice/tianqin_494.ogg"
    tianqin "마법은 편리하네!"


translate japanese plot2_a86be364:



    voice "voice/cygnus_243.ogg"
    cygnus "이건 아주 일부분에 불과해."


translate japanese plot2_27239221:


    "시노스는 이렇게 간단한 마법을 쓰고도 칭찬받는 날이 올 줄은 몰랐다."


translate japanese plot2_ea99924c:



    voice "voice/tianqin_495.ogg"




translate japanese plot2_516bde49:



    voice "voice/cygnus_88.ogg"
    cygnus2 "나는{a=dictionary:dict_entry_15}{/a}, 다른 세계에서 온 마녀야."


translate japanese plot2_721e84c0:



    voice "voice/tianqin_279.ogg"
    tianqin "어…… 그러니까, 다른 세계? 마, 마녀?"


translate japanese plot2_927b8eb6:



    voice "voice/cygnus_89.ogg"
    cygnus2 "응, 마녀."


translate japanese plot2_2097d993:



    voice "voice/tianqin_280.ogg"
    tianqin "으음…… 마녀가 대체 뭔데?"


translate japanese plot2_5da97418:


    "라이라는 방금 들은 단어가 분명 「마녀」라는 두 글자였다고 확신했다."


translate japanese plot2_63e680d3:



    voice "voice/cygnus_90.ogg"
    cygnus2 "（やはりこの世界には、魔女という概念が存在しないみたいね……）"


translate japanese plot2_508562ef:


    "마나가 없는 이세계에서 자신의 말이 전혀 설득력 없다는 사실은 소녀도 알고 있었다."


translate japanese plot2_cf0b006d:


    "그래서 이미 준비해 둔 것이 있었다."


translate japanese plot2_a50c0e7e:



    voice "voice/cygnus_91.ogg"
    cygnus2 "믿기 어렵겠지만…… 잠깐만 기다려."


translate japanese plot2_301874de:



    voice "voice/cygnus_92.ogg"
    cygnus2 "（마력이 얼마 안 남았지만…… 이 정도는 아직 쓸 수 있을 거야.）"


translate japanese plot2_3404b37e:


    "少女が体内に残るわずかな魔力を凝縮すると、彼女の肌が微かに蛍光を帯び、輪郭が揺らめき始めた。"


translate japanese plot2_11961521:



    voice "voice/tianqin_281.ogg"
    tianqin 0109 "으악!?"


translate japanese plot2_784296ac:


    "凝縮された魔力がさらに高まり、少女の身体から放たれる光はどんどん強くなる。眩しさに、天琴は思わず目を閉じた。"


translate japanese plot2_634ec7bc:



    voice "voice/cygnus_93.ogg"
    cygnus2 "（좋아, 지금이야……!）"


translate japanese plot2_6451f887:


    cygnus2 "……"


translate japanese plot2_d88285d0:


    "강한 빛과 귀를 찌르는 소음이 지나간 뒤, 마녀는 다른 모습으로 나타났다."


translate japanese plot2_e2960e78:



    voice "voice/cygnus_95.ogg"
    cygnus2 "마력을 이렇게 쓰고도… 이 정도밖에 돌아오지 못하나……"


translate japanese plot2_61d418b3:



    voice "voice/tianqin_282.ogg"
    tianqin "으악! 이 빛은 뭐야?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_00b7eccf:



    voice "voice/tianqin_283.ogg"
    tianqin "어……?"


translate japanese plot2_ec37e256:



    voice "voice/tianqin_284.ogg"
    tianqin "너…… 커졌어!?"


translate japanese plot2_36077df4:



    voice "voice/cygnus_96.ogg"
    cygnus3 "겉모습을 바꾼 거야."


translate japanese plot2_77a40eff:



    voice "voice/cygnus_97.ogg"
    cygnus3 "（기억은 안 나지만…… 이건 내게 익숙한 모습과 꽤 다르네……）"


translate japanese plot2_40315fd8:



    voice "voice/tianqin_285.ogg"
    tianqin "대, 대단해! 어떻게 한 거야?"


translate japanese plot2_0fcb9e49:



    voice "voice/cygnus_98.ogg"
    cygnus3 "마법. 이게 마법의 힘이야."


translate japanese plot2_2f7bcf95:



    voice "voice/tianqin_286.ogg"
    tianqin "뭐?"


translate japanese plot2_6b295ebe:



    voice "voice/cygnus_99.ogg"
    cygnus3 "（으음… 안 되겠어. 설명보다 보여 주는 게 빠르겠네.）"


translate japanese plot2_1950889a:


    "魔女は黙って両手を胸の前で合わせた。"


translate japanese plot2_be583711:


    "すぐに、天琴は彼女からひんやりとした空気が流れ出すのを感じた。"


translate japanese plot2_7a96dfd9:


    "이윽고 마녀의 두 손 사이에 아름다운 얼음 결정이 맺혔다."


translate japanese plot2_ccd18ff5:


    "그녀에게 가장 익숙하고, 실수할 일이 없는 기초 마법이었다."


translate japanese plot2_c1f2cacb:


    "「【氷素凝結｜Condensation】。」"


translate japanese plot2_cc16c7bb:



    voice "voice/tianqin_287.ogg"
    tianqin 0113 "우와!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_0211265b:


    "魔女が魔力を絶え間なく注ぎ込むと、小さな氷晶が瞬く間に成長し、芸術品のような氷の薄片となった。"


translate japanese plot2_3913c2eb:



    voice "voice/cygnus_100.ogg"
    cygnus4 0501 "……지금 마력으로는 영창 없이는 이 정도 「연출」밖에 못 하겠네."


translate japanese plot2_beb2c042:



    voice "voice/tianqin_288.ogg"
    tianqin 0113 "이게…… 마법……?"


translate japanese plot2_632a4f4d:



    voice "voice/cygnus_101.ogg"
    cygnus4 0501 "그런 셈이지."


translate japanese plot2_efdd95d7:



    voice "voice/cygnus_102.ogg"
    cygnus4 "가장 기본적인 마법이지만…… 아직 이 정도는 할 수 있어."


translate japanese plot2_00a9371f:


    "파직——"


translate japanese plot2_9386023a:


    "彼女の脳裏で{a=dictionary:dict_entry_17}術式{/a}を書き換えた瞬間――氷の薄片が一瞬に消えて、ビリビリとする電光になった。"


translate japanese plot2_62ad07b9:


    "파지직——"


translate japanese plot2_1f6427f2:



    voice "voice/tianqin_289.ogg"
    tianqin 0102 "으아아아!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_fc5ee3d2:



    voice "voice/tianqin_290.ogg"
    tianqin "이, 이번엔 번개야!?"


translate japanese plot2_6a23d4da:



    voice "voice/cygnus_103.ogg"
    cygnus4 0501 "이건 대기 마법의 일종이야."


translate japanese plot2_3b24e757:



    voice "voice/cygnus_104.ogg"
    cygnus4 "이것도 기초 마법이지만…… 대기 마법은 마력 출력을 조절하기가 어려워……"


translate japanese plot2_95d8be53:



    voice "voice/tianqin_291.ogg"
    tianqin 0102 "와—! 대단해—!"


translate japanese plot2_28769ad6:



    voice "voice/cygnus_105.ogg"
    cygnus4 0502 "보고 싶으면 더 보여 줄게."


translate japanese plot2_8f49191d:


    "시노스가 그렇게 말하자 전광이 순식간에 불꽃으로 바뀌었다."


translate japanese plot2_ea3bf65b:


    "라이라의 칭찬을 듣자 조용히 마법만 보여 주려던 마녀의 마음도 조금 풀렸다."


translate japanese plot2_db764c82:


    "라이라의 놀라는 목소리를 더 듣고 싶어져, 마녀는 다시 술식을 바꾸고 몰래 마력 출력을 높였다."


translate japanese plot2_0174a907:



    voice "voice/tianqin_292.ogg"
    tianqin 0113 "우왓!?" with Shake((0, 0, 0, 0), 0.4, dist=5)


translate japanese plot2_cc3f3614:



    voice "voice/cygnus_106.ogg"
    cygnus4 0501 "마법사들이 자주 쓰는 불 계열 마법――「【화구술｜Pyro Orb】」."


translate japanese plot2_b4d2c440:



    voice "voice/cygnus_107.ogg"
    cygnus4 "구조는 단순하지만 폭발 위력은 아주 강해."


translate japanese plot2_aaae53b3:



    voice "voice/cygnus_108.ogg"
    cygnus4 0509 "마력만 충분하다면 이 일대를 날려 버리는 것도 쉬워."


translate japanese plot2_200ed71b:



    voice "voice/tianqin_293.ogg"
    tianqin 0111 "뭐! 자, 잠깐만!" with Shake((0, 0, 0, 0), 0.5, dist=7)


translate japanese plot2_f659f87e:



    voice "voice/tianqin_294.ogg"
    tianqin "날려 버리면 안 돼!"


translate japanese plot2_bcf75797:



    voice "voice/tianqin_295.ogg"
    tianqin 0112 "으악! 가구가 타겠어!" with Shake((0, 0, 0, 0), 0.6, dist=8)


translate japanese plot2_a71d5663:



    voice "voice/cygnus_109.ogg"
    cygnus4 "으음——"


translate japanese plot2_a2bc0bda:



    voice "voice/cygnus_110.ogg"
    cygnus4 "아……"


translate japanese plot2_8c6428db:



    voice "voice/tianqin_296.ogg"
    tianqin "또, 또 작아졌어!?" with Shake((0, 0, 0, 0), 0.4, dist=5)


translate japanese plot2_e4fd44b1:



    voice "voice/cygnus_111.ogg"
    cygnus4 "마력을 다 써 버렸어…… 이 세계 대기에는 마나가 거의 없는 것 같네……"


translate japanese plot2_61b292ef:



    voice "voice/tianqin_297.ogg"
    tianqin "마나?"


translate japanese plot2_25baa50a:



    voice "voice/cygnus_112.ogg"
    cygnus4 "마력의 원천이 되는 에너지야."


translate japanese plot2_b3630bde:



    voice "voice/cygnus_113.ogg"
    cygnus4 "쉽게 말하면, 마법을 쓰려면 대기에서 마나를 끌어와 몸 안에서 마력으로 바꿔야 해. 그리고 복잡한 연산을 거쳐야 비로소 온전한 마법을 펼칠 수 있지."


translate japanese plot2_ab9f4830:



    voice "voice/tianqin_298.ogg"
    tianqin "な、なるほど！"


translate japanese plot2_a2e5d7c9:



    voice "voice/cygnus_114.ogg"
    cygnus4 "……이해했어?"


translate japanese plot2_faacd60d:



    voice "voice/tianqin_299.ogg"
    tianqin "미안, 하나도 모르겠어."


translate japanese plot2_ed5e210e:



    voice "voice/cygnus_115.ogg"
    cygnus4 "으윽――!"


translate japanese plot2_1e542d89:



    voice "voice/cygnus_116.ogg"
    cygnus4 "（역시 이 세계에는 이 분야의 지식이 전혀 없어……）"


translate japanese plot2_a7b80b74:



    voice "voice/cygnus_117.ogg"
    cygnus4 "（아까 시연으로는 부족했던 모양이네.）"


translate japanese plot2_ed11c85a:



    voice "voice/tianqin_300.ogg"
    tianqin "잠깐! 마법은 잘 모르겠지만! 그래도 한 가지는 알았어!"


translate japanese plot2_e1f348cc:



    voice "voice/tianqin_301.ogg"
    tianqin "とにかく、{a=dictionary:dict_entry_14}異世界{/a}から来たんだね！" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_09cde68e:



    voice "voice/cygnus_118.ogg"
    cygnus4 "아…… 응."


translate japanese plot2_f10a179e:



    voice "voice/tianqin_302.ogg"
    tianqin "우와! 멋지다!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_6fe58724:



    voice "voice/tianqin_303.ogg"
    tianqin "거봐, 역시! 이세계는 정말 있었어!"


translate japanese plot2_57cc60a2:



    voice "voice/cygnus_119.ogg"
    cygnus4 "……내 말을 믿어?"


translate japanese plot2_868e035f:



    voice "voice/tianqin_304.ogg"
    tianqin "좀 놀라긴 했지만, 네 마법까지 봤는데 못 믿을 이유도 없잖아."


translate japanese plot2_b9a6a37b:



    voice "voice/cygnus_120.ogg"
    cygnus4 "……"


translate japanese plot2_52c1aa54:


    "そのあまりにも素直な反応に、魔女は思わず固まった。"


translate japanese plot2_9f831a3a:



    voice "voice/cygnus_121.ogg"
    cygnus4 "（……이 사람, 정말 괜찮은 걸까? 내 말을 진지하게 듣고는 있는 건가.）"


translate japanese plot2_8e81026d:


    "자신이 이 세계의 상식을 뒤집는 존재임을 아는 시노스에게, 그 반응은 너무도 담담했다."


translate japanese plot2_2181b47b:


    "설명은 쉬워진 대신 마녀의 불안이 커졌다."


translate japanese plot2_eb52ffbc:



    voice "voice/tianqin_305.ogg"
    tianqin "저기, 마녀야. 우리 세계에는 뭘 하러 온 거야?"


translate japanese plot2_bf7a8bdb:



    voice "voice/cygnus_122.ogg"
    cygnus4 "……모르겠어."


translate japanese plot2_aa4811a4:



    voice "voice/tianqin_306.ogg"
    tianqin "응?"


translate japanese plot2_34273f80:



    voice "voice/cygnus_123.ogg"
    cygnus4 "私は{a=dictionary:dict_entry_16}【力｜魔力】{/a}と記憶を失っているの。"


translate japanese plot2_5c152db2:



    voice "voice/cygnus_124.ogg"
    cygnus4 "어떻게 왔는지, 왜 이 세계에 왔는지, 어떻게 돌아가야 하는지…… 전부 기억이 안 나."


translate japanese plot2_f6638270:



    voice "voice/tianqin_307.ogg"
    tianqin "에에—!? 그럼 이제 어떻게 할 거야?"


translate japanese plot2_07f759ee:



    voice "voice/cygnus_125.ogg"
    cygnus4 "그래서…… 부탁이 있어."


translate japanese plot2_696c6c6e:



    voice "voice/cygnus_126.ogg"
    cygnus4 "私の力と{a=dictionary:dict_entry_18}記憶{/a}を取り戻すために、協力してください。"


translate japanese plot2_0bfc43f7:



    voice "voice/tianqin_308.ogg"
    tianqin "어? 그건……"


translate japanese plot2_e9cd652f:



    voice "voice/tianqin_309.ogg"
    tianqin "내가 할 수 있는 일이면 도와줄 수는 있어."


translate japanese plot2_212219a7:



    voice "voice/tianqin_310.ogg"
    tianqin "하지만 아까 마법 같은 건 솔직히 뭐가 뭔지……."


translate japanese plot2_d7b32451:



    voice "voice/cygnus_127.ogg"
    cygnus4 "괜찮아. 네가 할 수 있는 것만 도와줘도 충분해."


translate japanese plot2_6d4be1a9:



    voice "voice/tianqin_311.ogg"
    tianqin "오! 그거라면 맡겨!"


translate japanese plot2_b9a6a37b_1:



    voice "voice/cygnus_128.ogg"
    cygnus4 "……"


translate japanese plot2_740d3405:


    "라이라의 반응은 너무도 가벼웠다. 아주 평범한 부탁을 들어주는 것처럼 보였다."


translate japanese plot2_ef3d2642:


    "그 가벼움이 오히려 마녀의 가슴에 불안을 지폈다."


translate japanese plot2_20907c72:



    voice "voice/cygnus_129.ogg"
    cygnus4 "(어쩔 수 없지. 아직 이 일이 얼마나 중요한지 모를 테니까.)"


translate japanese plot2_a4c961c7:



    voice "voice/cygnus_130.ogg"
    cygnus4 "（지금 내가 할 수 있는 건 이 사람에게 의지하는 것뿐……）"


translate japanese plot2_0d64af72:



    voice "voice/tianqin_312.ogg"
    tianqin "아, 맞다! 아직 이름을 안 물어봤네!"


translate japanese plot2_73ad5de0:



    voice "voice/tianqin_313.ogg"
    tianqin "난 라이라야. 너는?"


translate japanese plot2_64f6ea13:



    voice "voice/cygnus_131.ogg"
    cygnus4 "내 이름은……"


translate japanese plot2_b9a6a37b_2:



    voice "voice/cygnus_132.ogg"
    cygnus4 "……"


translate japanese plot2_8ac3ff8e:


    "이름 이야기가 나오자 마녀는 조금 말문이 막혔다."


translate japanese plot2_c1327401:


    "라이라에게 자신의 진명을 밝혀도 될지 망설였다. 마녀에게 이름은 무엇보다 무거운 의미를 지녔으니까."


translate japanese plot2_213d33a6:



    voice "voice/tianqin_314.ogg"
    tianqin "아, 혹시 말하기 곤란해? 말하기 싫으면 무리하지 않아도 돼."


translate japanese plot2_ed193886:



    voice "voice/tianqin_315.ogg"
    tianqin "그동안은 「마녀」라고 부를게."


translate japanese plot2_94d71aa9:



    voice "voice/cygnus_133.ogg"
    cygnus4 "아니."


translate japanese plot2_b9a6a37b_3:



    voice "voice/cygnus_134.ogg"
    cygnus4 "……"


translate japanese plot2_9a81cafc:



    voice "voice/cygnus_135.ogg"
    cygnus4 "우리 마녀에게 이름은 아주 특별한 의미가 있어. 다른 사람이 안다는 건, 그것만으로도――"


translate japanese plot2_2ae66939:



    voice "voice/tianqin_316.ogg"
    tianqin "그것만으로도……?"


translate japanese plot2_b9a6a37b_8:



    voice "voice/cygnus_136.ogg"
    cygnus4 "……"


translate japanese plot2_b66f4f12:


    "소녀는 깊이 숨을 들이쉬고 마음을 굳혔다."


translate japanese plot2_64999723:



    voice "voice/cygnus_137.ogg"
    cygnus4 "私は「【朝と夜｜Equinox】の大魔女」――{color=#7393B3}{b}シノス{/b}{/color}。"


translate japanese plot2_da4ad256:



    voice "voice/tianqin_317.ogg"
    tianqin "——!?"


translate japanese plot2_ec73a28f:


    "{glitch=5}{color=#7393B3}{b}「シノス」{/b}{/color}{/glitch}という名を意識した瞬間、天琴は微かな電流が体を走り抜け、言葉にならない感じを覚えた。"


translate japanese plot2_bdbc3766:



    voice "voice/tianqin_318.ogg"
    tianqin "오, 오오…… 시노스구나?"


translate japanese plot2_bd40757e:



    voice "voice/tianqin_319.ogg"
    tianqin "그럼 시노스라고 부를게."


translate japanese plot2_ca20fc9e:



    voice "voice/cygnus_138.ogg"
    cygnus "……쉿." with Shake((0, 0, 0, 0), 0.4, dist=3)


translate japanese plot2_61a53ddf:



    voice "voice/cygnus_139.ogg"
    cygnus "우리 마녀에게 이름은 아주 소중하니까 너무 자주 입에 올리지 마."


translate japanese plot2_32d28537:



    voice "voice/cygnus_140.ogg"
    cygnus "……직접 보여 주는 게 빠르겠네."


translate japanese plot2_0f9f65d4:


    "시노스가 손끝에 남은 마력을 모아 라이터 불꽃만 한 불덩이를 만들어 냈다."


translate japanese plot2_cd0097bd:



    voice "voice/cygnus_141.ogg"
    cygnus "가라."


translate japanese plot2_32571013:


    "시노스가 손끝을 살짝 움직이자 작은 불덩이가 둥실 떠올라 라이라에게 날아갔다."


translate japanese plot2_243276af:



    voice "voice/tianqin_320.ogg"
    tianqin "으악!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_64cb2d75:



    voice "voice/tianqin_321.ogg"
    tianqin "……어라, 안 뜨거워?"


translate japanese plot2_d43fd5bc:



    voice "voice/cygnus_142.ogg"
    cygnus "응. 이런 거야."


translate japanese plot2_e4bbe8fc:



    voice "voice/cygnus_143.ogg"
    cygnus "마녀의 마법은 자기 「이름」을 아는 사람에게는 통하지 않아."


translate japanese plot2_2bcd5e10:



    voice "voice/tianqin_322.ogg"
    tianqin "어어!? 그런 거야?"


translate japanese plot2_e535de70:



    voice "voice/tianqin_323.ogg"
    tianqin "그럼 나한테는 가짜 이름을 알려 줬어도 되잖아……"


translate japanese plot2_ca5d89ac:



    voice "voice/cygnus_144.ogg"
    cygnus "아니, 이걸 우리 사이에 맺어지는 「【계약｜Sign】」이라고 생각해 줘. 내가 마법을 써도 널 해치지 않는다는 증거이기도 해."


translate japanese plot2_93a7355b:



    voice "voice/cygnus_145.ogg"
    cygnus "내가 정말로 네 도움이 필요하다는 걸 알아줬으면 해. 그래서 진짜 이름을 알려 준 거야. 이건 【마녀｜내】가 다른 사람에게 표할 수 있는 최고의 경의야."


translate japanese plot2_b695bbbc:



    voice "voice/cygnus_146.ogg"
    cygnus "그러니 내 이름을 다른 사람에게 알리지 말아 줘."


translate japanese plot2_59be0c3f:



    voice "voice/cygnus_147.ogg"
    cygnus "魔法とは、自己を守るための術だ。ゆえに、本当の名は魔女の{a=dictionary:dict_entry_19}弱点{/a}でもある。"


translate japanese plot2_e377ef97:



    voice "voice/cygnus_148.ogg"
    cygnus "내 이름이 다른 사람에게 알려지면 안전을 보장할 수 없어."


translate japanese plot2_451daeba:



    voice "voice/cygnus_149.ogg"
    cygnus "그러니까…… 평소에는 아사요라고 불러 주면 돼."


translate japanese plot2_f5bc5765:



    voice "voice/tianqin_324.ogg"
    tianqin "응! 알았어. 나를 믿어 줘서 고마워."


translate japanese plot2_a5cba7d7:



    voice "voice/cygnus_150.ogg"
    cygnus "그럼…… 다음은 본론이야. 지금 가장 신경 쓰이는 일이지."


translate japanese plot2_91d99fad:



    voice "voice/cygnus_151.ogg"
    cygnus "잃어버린 【힘｜마력】은…… 이 세계에 「재앙」을 가져올지도 몰라."


translate japanese plot2_a31958a6:



    voice "voice/champion_01.ogg"
    champion "배웅은 여기까지면 됐어요. 도와주셔서 감사합니다."


translate japanese plot2_82f2f890:



    voice "voice/champion_02.ogg"
    champion "이 앞에는 마물이 나올지도 몰라요. 마을 안에 계시는 편이 안전해요."


translate japanese plot2_633b2059:



    voice "voice/npc5_01.ogg"
    npc5 "용사님, 앞으로 위험한 일이 많을 테니 부디 조심하십시오."


translate japanese plot2_5c7ee532:



    voice "voice/champion_03.ogg"
    champion "네, 알겠습니다."


translate japanese plot2_22b689bd:



    voice "voice/champion_04.ogg"
    champion "근처 마물 소동은 저희가 조사해 볼게요."


translate japanese plot2_138020de:



    voice "voice/npc5_02.ogg"
    npc5 "아아, 용사님. 정말 감사합니다."


translate japanese plot2_04512bb8:



    voice "voice/dorothea_01.ogg"
    dorothea "이 마을 사람들 참 친절하네. 맛있는 것도 이렇게 많이 줬어."


translate japanese plot2_d16bc478:



    voice "voice/equinox_01.ogg"
    equinox "너는 먹을 생각밖에 없구나."


translate japanese plot2_49d8da33:



    voice "voice/equinox_02.ogg"
    equinox "기나긴 마차 여행 끝에 이틀 동안은 겨우 여관에서 쉬었네."


translate japanese plot2_27b89e8d:



    voice "voice/equinox_03.ogg"
    equinox "누군가 쓸데없이 참견만 안 했으면 여기서 하루쯤 더 쉴 수 있었을 텐데."


translate japanese plot2_e925cdc5:



    voice "voice/dorothea_02.ogg"
    dorothea "미, 미안하다니까!"


translate japanese plot2_f9998fba:



    voice "voice/champion_05.ogg"
    champion "아사요, 마을 사람들이 이 근처에 마물이 늘었다던데, 짐작 가는 게 있어?"


translate japanese plot2_a499f9bd:



    voice "voice/equinox_04.ogg"
    equinox "흔한 일이잖아."


translate japanese plot2_c003d7ec:



    voice "voice/equinox_05.ogg"
    equinox "엘프의 숲에 「거목」이 나타난 뒤로 대륙 전체의 마나 흐름이 불안정해졌어."


translate japanese plot2_3502ebba:



    voice "voice/equinox_06.ogg"
    equinox "그리고 그 불안정한 마나가 모이면――결국 심각한 「【왜곡｜Error】」이 돼. 이제 이 대륙에는 「절대 안전한 곳」 따위는 없다고 해도 좋을 정도야."


translate japanese plot2_e8b50ef9:



    voice "voice/champion_06.ogg"
    champion "「【왜곡｜Error】」이라…"


translate japanese plot2_81c12fa7:



    voice "voice/champion_07.ogg"
    champion "그 거목을 부수면 마나의 불안정도 가라앉을까?"


translate japanese plot2_36d95069:



    voice "voice/equinox_07.ogg"
    equinox "몰라. 원래 상태로 돌아갈 수도, 아무것도 달라지지 않을 수도 있어. 둘 다 가능해."


translate japanese plot2_711af9b9:



    voice "voice/equinox_08.ogg"
    equinox "게다가 아직 실마리도 못 잡았잖아. 거목에 접근할 「열쇠」가 없는 한, 쓰러뜨리는 건 꿈도 못 꿔."


translate japanese plot2_714153d4:



    voice "voice/champion_08.ogg"
    champion "그렇긴 하네."


translate japanese plot2_e47f4931:



    voice "voice/dorothea_03.ogg"
    dorothea2 0416 "얘들아—— 빨리 이리 와 봐——"


translate japanese plot2_858e8c3b:



    voice "voice/dorothea_04.ogg"
    dorothea2 0416 "앞에 좀 이상한 마물이 있어——!"


translate japanese plot2_7bc1d5db:



    voice "voice/cygnus_152.ogg"
    cygnus "――!"


translate japanese plot2_aafdb88b:


    "마녀는 꿈에서 놀라 깼다. 꿈속의 기억 조각은 아직 사라지지 않아, 장면들이 또렷이 떠올랐다."


translate japanese plot2_21487228:



    voice "voice/cygnus_153.ogg"
    cygnus "이건…… 내 기억……?"


translate japanese plot2_e45b03ce:



    voice "voice/cygnus_154.ogg"
    cygnus "으음……"


translate japanese plot2_803b1ebe:


    "기억 속에서 자신은 용사 일행과 함께 모험을 하고 있었던 것 같았다."


translate japanese plot2_74f23418:


    "그들은 거창한 목표를 품고 세상을 구하기 위해 움직였다."


translate japanese plot2_72f5af14:


    "하지만 기억은 거기까지였다. 시노스가 아무리 애써도 두 동료의 얼굴은 떠오르지 않았다."


translate japanese plot2_b63bc797:



    voice "voice/cygnus_155.ogg"
    cygnus "젠장."


translate japanese plot2_cd2ef5b5:



    voice "voice/cygnus_156.ogg"
    cygnus "……라이라는?"


translate japanese plot2_4b693ee3:


    "시노스는 침실을 나와 자신을 받아 준 동거인을 찾았다."


translate japanese plot2_10ba49fc:


    "하지만 집에는 자신 외에 아무도 없었다."


translate japanese plot2_0e5ee838:


    "라이라는 아침을 차려 놓고 이미 학교로 향한 모양이었다."


translate japanese plot2_b0c914fc:



    voice "voice/cygnus_157.ogg"
    cygnus "어젯밤에 얘기를 그렇게 많이 했는데, 제대로 이해했을지 모르겠네……"


translate japanese plot2_39c8b5ad:



    voice "voice/cygnus_158.ogg"
    cygnus "뭔가 단서를 찾아 주고 있으면 좋겠는데――."


translate japanese plot2_5cb8ae3f:



    voice "voice/tianqin_325.ogg"
    tianqin "하아～……（하품）"


translate japanese plot2_1265d8d3:



    voice "voice/yangxi_56.ogg"
    yangxi "안녕."


translate japanese plot2_d0797fb5:



    voice "voice/tianqin_326.ogg"
    tianqin "좋은 아치임!"


translate japanese plot2_d1099f5f:



    voice "voice/yangxi_57.ogg"
    yangxi "어머, 오늘은 제시간에 왔네. 웬일이야."


translate japanese plot2_9510aacd:



    voice "voice/yangxi_58.ogg"
    yangxi "그런데…… 얼굴은 왜 그래? 시체 같잖아."


translate japanese plot2_e0006afb:



    voice "voice/tianqin_327.ogg"
    tianqin "어젯밤에 머릿속에 너무 많은 걸 쑤셔 넣어서 잠이 안 오더라고……"


translate japanese plot2_0ee6e98e:



    voice "voice/tianqin_328.ogg"
    tianqin "동트기 전에 겨우 잠깐 눈 붙였어."


translate japanese plot2_75e9e98d:



    voice "voice/yangxi_59.ogg"
    yangxi "공부했어?"


translate japanese plot2_625c30f6:



    voice "voice/tianqin_329.ogg"
    tianqin "아냐, 아냐."


translate japanese plot2_68e1dfb6:



    voice "voice/tianqin_330.ogg"
    tianqin "그래도 어떤 의미로는 공부보다 힘들었을지도……."


translate japanese plot2_368edd8a:



    voice "voice/yangxi_60.ogg"
    yangxi "뭐야? 대체 뭘 했는데?"


translate japanese plot2_a3ba4b95:



    voice "voice/tianqin_331.ogg"
    tianqin "으음…… 비・밀!"


translate japanese plot2_d0096a84:



    voice "voice/yangxi_61.ogg"
    yangxi "……뭐야, 의미심장하네."


translate japanese plot2_68092d98:



    voice "voice/tianqin_332.ogg"
    tianqin "（어젯밤 시노스가 한 얘기는 히나타한테 할 수 없어……）"


translate japanese plot2_b8258aa0:



    voice "voice/tianqin_333.ogg"
    tianqin "시노스의 힘이…… 재앙을 부른다는 거야?"


translate japanese plot2_b77acc8a:



    voice "voice/cygnus_159.ogg"
    cygnus "君たちの世界にはマナが存在しない。私が失った【力｜魔力】は、必ずどこかで{a=dictionary:dict_entry_20}「【歪み｜Error】」{/a}という形で現れる。"


translate japanese plot2_2f1ae603:



    voice "voice/cygnus_160.ogg"
    cygnus "어떤 악영향을 끼칠지는 나도 예측할 수 없어."


translate japanese plot2_b78788a9:



    voice "voice/cygnus_161.ogg"
    cygnus "이 세계에서는 아주 불합리한 형태로 나타날 가능성이 있어."


translate japanese plot2_ef0a173f:



    voice "voice/tianqin_334.ogg"
    tianqin "구체적으로는?"


translate japanese plot2_23f75233:



    voice "voice/cygnus_162.ogg"
    cygnus "예를 들어…… 기묘한 생물이 나타나거나, 설명할 수 없는 현상이 일어나거나 하는 식이야."


translate japanese plot2_8b38c7ff:



    voice "voice/tianqin_335.ogg"
    tianqin "それって……{a=dictionary:dict_entry_21}超自然現象{/a}、みたいな？"


translate japanese plot2_9cc08c75:



    voice "voice/cygnus_163.ogg"
    cygnus "뭐가?"


translate japanese plot2_86747140:



    voice "voice/tianqin_336.ogg"
    tianqin "우리 세계에서 가끔 일어나는 원인 불명의 사건이야."


translate japanese plot2_27fc1aef:



    voice "voice/tianqin_337.ogg"
    tianqin "물론 그런 일도 대부분은 나중에 과학적으로 설명되지만."


translate japanese plot2_024dafbb:



    voice "voice/cygnus_164.ogg"
    cygnus "대부분이라는 건……"


translate japanese plot2_86ced2c8:



    voice "voice/cygnus_165.ogg"
    cygnus "나머지는 설명할 수 없다는 거네?"


translate japanese plot2_860706b1:



    voice "voice/tianqin_338.ogg"
    tianqin "뭐, 그렇기는 한데…… 그런 건 사람이 꾸민 속임수인 경우가 많아."


translate japanese plot2_7bb789ce:



    voice "voice/cygnus_166.ogg"
    cygnus "꼭 그렇지는 않아. 어쩌면 그중에 내 힘과 관련된 사건이 있을지도 몰라."


translate japanese plot2_99621bc8:



    voice "voice/tianqin_339.ogg"
    tianqin "어? 그, 그래?"


translate japanese plot2_155a15d2:



    voice "voice/cygnus_167.ogg"
    cygnus "너희는 그런 초자연 사건들을 기록해 두고 있지?"


translate japanese plot2_f8920ce7:



    voice "voice/tianqin_340.ogg"
    tianqin "어디 보자…… 잠깐만. 휴대폰으로 찾아볼게……"


translate japanese plot2_f7cce88a:



    voice "voice/tianqin_341.ogg"
    tianqin "（결국 그대로 한밤중까지 초자연 현상 영상을 계속 봤지……）"


translate japanese plot2_0fe7d79c:



    voice "voice/tianqin_342.ogg"
    tianqin "（게다가 아무리 이상한 영상도 시노스는 마법으로 설명해 버리니까.）"


translate japanese plot2_f3922f27:



    voice "voice/tianqin_343.ogg"
    tianqin "（결국 관련 있어 보이는 건 아무것도 못 찾았지만……）"


translate japanese plot2_32d5a808:



    voice "voice/tianqin_344.ogg"
    tianqin "（왠지 우리 둘 다 점점 머리가 이상해지는 것 같아……）"


translate japanese plot2_c20032f1:



    voice "voice/yangxi_62.ogg"
    yangxi "야—— 괜찮아?"


translate japanese plot2_9fce69b4:



    voice "voice/tianqin_345.ogg"
    tianqin "괘, 괜찮아……. 그냥 머리가 좀 과열됐을 뿐이야……."


translate japanese plot2_0dfd3486:



    voice "voice/npc6_01.ogg"
    npc6 "있잖아, 오늘 아침 TV 봤어?"


translate japanese plot2_3e9d34fc:



    voice "voice/npc7_01.ogg"
    npc7 "{a=dictionary:dict_entry_22}中央公園{/a}のやつ？"


translate japanese plot2_d6a393ca:



    voice "voice/npc8_01.ogg"
    npc8 "아, 휴대폰에 뜨더라. 뉴스 봤어."


translate japanese plot2_11aec105:



    voice "voice/npc9_01.ogg"
    npc9 "벌써 전문가들이 조사하러 갔나 봐."


translate japanese plot2_9def30f8:



    voice "voice/tianqin_346.ogg"
    tianqin "……무슨 얘기를 하는 걸까."


translate japanese plot2_37aad8ee:



    voice "voice/yangxi_63.ogg"
    yangxi "몰라. 잠깐만, 지금 찾아볼게……"


translate japanese plot2_f319fd6f:



    voice "voice/yangxi_64.ogg"
    yangxi "뉴스, 중앙 공원, 전문가……"


translate japanese plot2_a7f09bd8:


    "先に得た情報をもとに、陽汐は手際よくスマホで検索を始めた。"


translate japanese plot2_4280ca2e:



    voice "voice/yangxi_65.ogg"
    yangxi "앗!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot2_e743e1eb:



    voice "voice/tianqin_347.ogg"
    tianqin "어, 뭔데? 히나타가 놀라다니 드문 일이네."


translate japanese plot2_b624d3b7:



    voice "voice/yangxi_66.ogg"
    yangxi "이것 좀 봐."


translate japanese plot2_238deeac:


    "히나타가 검색한 페이지를 라이라에게 보냈다."


translate japanese plot2_52135d2b:



    voice "voice/tianqin_348.ogg"
    tianqin "「중앙 공원에 하룻밤 사이 거목 출현」……!?"


translate japanese plot2_7804469d:



    voice "voice/tianqin_349.ogg"
    tianqin "「높이 약 400미터, 반지름 50미터로 추정」……이라니, 뭐야 그게!?" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot2_9f4a2fae:



    voice "voice/yangxi_67.ogg"
    yangxi "세계에서 가장 큰 나무보다 수십 배는 크대."


translate japanese plot2_6c80fd1e:



    voice "voice/tianqin_350.ogg"
    tianqin "잠깐. 중앙 공원이면 여기서도 보이겠는데!"


translate japanese plot2_fdb000af:


    "二人が教室の窓辺に立つと、中央公園の方向に、まるで天を貫くような巨樹が見えた。"


translate japanese plot2_02ba5c0b:


    "학교는 중앙 공원에서 멀지 않았다. 근처 건물들로는 우뚝 솟은 거목을 가릴 수 없었다."


translate japanese plot2_c4c48005:


    "それは緑色の巨大な塔のように、唐突にその場所にそびえ立っている。"


translate japanese plot2_29821ced:



    voice "voice/tianqin_351.ogg"
    tianqin "지, 진짜야…… 학교에 올 때는 전혀 못 봤어."


translate japanese plot2_29a7beab:



    voice "voice/yangxi_68.ogg"
    yangxi "떠들면서 오느라 그랬겠지."


translate japanese plot2_41316e30:



    voice "voice/tianqin_352.ogg"
    tianqin "……신기하다. 나무 밑에서 보면 분명 장관이겠지."


translate japanese plot2_9002a5f3:



    voice "voice/tianqin_353.ogg"
    tianqin "（잠깐.）"


translate japanese plot2_7e2da2fd:



    voice "voice/tianqin_354.ogg"
    tianqin "（이거 어젯밤 시노스가 말한 「왜곡」 아냐!?）"


translate japanese plot2_d71ddcf7:



    voice "voice/tianqin_355.ogg"
    tianqin "（혹시…… 걔 힘과 관련이 있을지도!）"


translate japanese plot2_6485228b:



    voice "voice/tianqin_356.ogg"
    tianqin "これだーーーっ！！！" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_40fe9439:



    voice "voice/yangxi_69.ogg"
    yangxi "야, 소리 지르지 마! 놀랐잖아!"


translate japanese plot2_d3fe1bd4:



    voice "voice/tianqin_357.ogg"
    tianqin "오늘 학교 끝나고 같이 저 나무 보러 가자!"


translate japanese plot2_20a9474e:



    voice "voice/yangxi_70.ogg"
    yangxi "……좋아."


translate japanese plot2_fa68bb3e:



    voice "voice/yangxi_71.ogg"
    yangxi "근데 거기 지금 사람이 엄청 많대. 뉴스를 보고 다들 모여드는 모양이야."


translate japanese plot2_0a4a242c:



    voice "voice/tianqin_358.ogg"
    tianqin "괜찮아! 비집고 들어가면 어떻게든 되겠지!"


translate japanese plot2_e4d261b6:



    voice "voice/yangxi_72.ogg"
    yangxi "그래, 그래……"


translate japanese plot2_936c4298:



    voice "voice/cygnus_168.ogg"
    cygnus "……"


translate japanese plot2_fbbcb2c6:


    "天琴は登校後、シノスを家に残した。"


translate japanese plot2_266264be:


    "당장은 입을 만한 옷이 없어서 밖에 나갈 수도 없었다."


translate japanese plot2_36373f7b:


    "무엇보다 저 「마녀 옷」은 이 세계에서 너무 눈에 띄었다."


translate japanese plot2_c1a3c5f2:


    "이 세계에 자신처럼 다른 세계에서 떠내려온 사람이 더 있는지도 아직 몰랐다."


translate japanese plot2_ce21794b:


    "이럴 때는 최대한 정체를 드러내지 않는 편이 좋았다."


translate japanese plot2_77fa3818:



    voice "voice/cygnus_169.ogg"
    cygnus "그래도 이 세계는 밖에 안 나가도 온갖 물건을 살 수 있다니 다행이네……"


translate japanese plot2_ecf6f21c:



    voice "voice/cygnus_170.ogg"
    cygnus "……라이라가 말한 「인터넷 쇼핑」이라는 건 대체 어떤 원리일까?"


translate japanese plot2_e45b03ce_1:



    voice "voice/cygnus_171.ogg"
    cygnus "으음……"


translate japanese plot2_78dd56aa:


    "시간을 주체하지 못한 시노스는 거실에 놓인 「컴퓨터」라는 기계를 살펴보기 시작했다."


translate japanese plot2_eea742d9:


    cygnus "오! 켜진 것 같네."


translate japanese plot2_041ae56b:



    "어젯밤 라이라는 이 기계를 다루는 법을 간단히 알려 주었다."


translate japanese plot2_afefbca0:



    voice "voice/tianqin_359.ogg"
    tianqin "자, 여기를 누르면 켜져."


translate japanese plot2_68903c40:



    voice "voice/tianqin_360.ogg"
    tianqin "그다음 이 「마우스」를 움직여서 「화면」에 나오는 「프로그램」을 고르는 거야."


translate japanese plot2_4b48040c:



    voice "voice/tianqin_361.ogg"
    tianqin "글자를 치고 싶을 때는 이 「키보드」를 쓰면 돼."


translate japanese plot2_d9098ea5:



    voice "voice/tianqin_362.ogg"
    tianqin "아무튼 복잡하게 생각하지 마. 그냥 좀 더 큰 휴대폰일 뿐이야!"


translate japanese plot2_1340a3ae:


    "天琴は昨夜、そう言い残していた。"


translate japanese plot2_337094c0:


    "딸깍—— 딸깍——"


translate japanese plot2_35572da6:



    voice "voice/cygnus_173.ogg"
    cygnus "그렇구나…… 이 「마우스」는 이렇게 쓰는 거네."


translate japanese plot2_b76805bf:


    "현대 컴퓨터의 그래픽 화면 덕분에 시노스는 마우스와 화면 속 커서의 관계를 금방 이해했다."


translate japanese plot2_d7cddef2:


    "しかも昨夜、天琴のスマホを少しいじっていたこともあり、シノスは思ったより早くパソコンの操作に慣れていった。"


translate japanese plot2_1df7086e:



    voice "voice/cygnus_174.ogg"
    cygnus "（어디 보자…… 이 「키보드」는 어떻게 쓰는 거지?）"


translate japanese plot2_b3f30ab7:


    "새로운 난관이 나타났다. ――키보드 배열이 휴대폰의 입력 방식과는 완전히 달랐다."


translate japanese plot2_292856e9:


    "天琴のスマホは、いまだに{a=dictionary:dict_entry_23}トグル入力{/a}を使っている。だから、シノスにとってこのQWERTY配列のキーボードは未知の領域だった。"


translate japanese plot2_b823f1d3:



    voice "voice/cygnus_175.ogg"
    cygnus "그래도 이렇게 알파벳이 전부 나열되어 있으면 라이라의 휴대폰보다 효율적으로 입력할 수 있겠네."


translate japanese plot2_e45b03ce_2:



    voice "voice/cygnus_176.ogg"
    cygnus "으음……"


translate japanese plot2_7174c7d2:


    "타닥, 타닥, 타닥——"


translate japanese plot2_ce3c832f:


    "키보드 조작은 시노스를 당황하게 했다."


translate japanese plot2_3435f3d0:


    "우선 마우스처럼 버튼이 두 개뿐인 것은 아니었다."


translate japanese plot2_ba88f242:


    "게다가 키보드의 알파벳은 순서대로 배열되어 있지 않다. 글자마다 위치가 제각각이라 규칙성이 전혀 보이지 않았다."


translate japanese plot2_5eb76952:


    "시노스에게는 그게 아무래도 이상하게 느껴졌다."


translate japanese plot2_80e79632:



    voice "voice/cygnus_177.ogg"
    cygnus "（어쩔 수 없지, 익숙해지는 수밖에……）"


translate japanese plot2_356b7062:



    voice "voice/cygnus_178.ogg"
    cygnus "（뭐, 이 세계에 오기 전에 언어 교정 마법을 써 둬서 다행이야. 안 그랬으면 이런 기계 앞에서는 완전히 두 손을 들었겠지.）"


translate japanese plot2_d4d52ef4:


    "타닥, 타닥——"


translate japanese plot2_0559cd3f:


    "시노스는 눈썹을 잔뜩 찌푸린 채 양손 검지로 키보드를 하나씩 눌렀다."


translate japanese plot2_39b1d874:



    voice "voice/cygnus_179.ogg"
    cygnus "잠깐, 이건!"


translate japanese plot2_0b770256:


    "곧 그녀도 전 세계를 떠들썩하게 만든 뉴스를 발견했다."


translate japanese plot2_8354dcd0:


    centertext "{size=58}「룽화시 중앙 공원에 거목 출현!」{p}「식물학자들이 현장 조사 중!」{/size}"


translate japanese plot2_f4c33efd:


    "수업이 끝나자 대부분의 학생이 역으로 몰려갔다."


translate japanese plot2_e9fecfca:


    "마치 초등학교 때 다 같이 꽃구경을 가듯, 학생들은 재잘거리며 같은 방향으로 걸음을 옮겼다."


translate japanese plot2_c8d6f0c9:


    "目的地は一つ——三つ先の駅にある中央公園。誰もが自分の目であの巨樹を見てみたかった。"


translate japanese plot2_d35fc8d5:



    voice "voice/yangxi_73.ogg"
    yangxi "정말 갈 거야?"


translate japanese plot2_3c284068:



    voice "voice/tianqin_363.ogg"
    tianqin "가자, 가자! 화제의 사건이 바로 근처에서 일어나다니 흔치 않잖아!"


translate japanese plot2_01558e31:



    voice "voice/yangxi_74.ogg"
    yangxi "사람이 너무 많아… 꽉 끼잖아……!"


translate japanese plot2_2550b9e4:



    voice "voice/yangxi_75.ogg"
    yangxi "게다가 주변이 전부 우리 학교 애들 아냐?"


translate japanese plot2_1fbf7876:



    voice "voice/tianqin_364.ogg"
    tianqin "괜찮아. 지하철 몇 정거장만 가면 되는데!"


translate japanese plot2_3609f429:



    voice "voice/yangxi_76.ogg"
    yangxi "그 몇 정거장도 이렇게 끼여 가긴 싫어."


translate japanese plot2_37ae03a7:



    voice "voice/tianqin_365.ogg"
    tianqin "그럼 자전거 탈까?"


translate japanese plot2_49eedc0b:



    voice "voice/yangxi_77.ogg"
    yangxi "うん、自転車で行こう。近くに{a=dictionary:dict_entry_24}シェアサイクル{/a}がまだ残ってるみたいだし……"


translate japanese plot2_2cb4131e:



    voice "voice/tianqin_366.ogg"
    tianqin "어?"


translate japanese plot2_f7d857fb:



    voice "voice/yangxi_78.ogg"
    yangxi "왜 그래?"


translate japanese plot2_e2c0767d:



    voice "voice/tianqin_367.ogg"
    tianqin "저쪽에 반장 아냐?"


translate japanese plot2_e01a1516:



    voice "voice/yangxi_79.ogg"
    yangxi "걔도 중앙 공원에 가려나?"


translate japanese plot2_776fdfbb:



    voice "voice/tianqin_368.ogg"
    tianqin "모르겠어. 전화하는 것 같은데."


translate japanese plot2_d56c1eea:



    voice "voice/banzhang_25.ogg"
    banzhang "……네. 오늘은 조금 늦게 들어갈게요."


translate japanese plot2_233a9e74:



    voice "voice/banzhang_26.ogg"
    banzhang "곧 체육 시험이라 조금 더 연습해 두고 싶어서요."


translate japanese plot2_a7a3e342:



    voice "voice/banzhang_27.ogg"
    banzhang "네, 괜찮아요. 몸 상태도 잘 조절할게요."


translate japanese plot2_8de19229:



    voice "voice/banzhang_28.ogg"
    banzhang "……알겠습니다. 그럼 끊을게요."


translate japanese plot2_38a743cd:



    voice "voice/banzhang_29.ogg"
    banzhang "이따 봬요."


translate japanese plot2_5a903eb9:



    voice "voice/banzhang_30.ogg"
    banzhang "후……"


translate japanese plot2_3793a83c:



    voice "voice/tianqin_369.ogg"
    tianqin "누구랑 통화했어?"


translate japanese plot2_0e5d29bd:



    voice "voice/banzhang_31.ogg"
    banzhang "으악!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot2_b3c6ce1f:



    voice "voice/banzhang_32.ogg"
    banzhang "라이라 씨랑 히나타 씨였군요……"


translate japanese plot2_a0a19017:



    voice "voice/yangxi_80.ogg"
    yangxi "안녕."


translate japanese plot2_d116ed92:



    voice "voice/tianqin_370.ogg"
    tianqin "미안, 놀랐어?"


translate japanese plot2_4ce93d37:



    voice "voice/banzhang_33.ogg"
    banzhang "ええ、少しだけ……今、母さんと話してたんです。"


translate japanese plot2_69e430cd:



    voice "voice/banzhang_34.ogg"
    banzhang "아, 저기! 라이라 씨, 그게……" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot2_255fc633:



    voice "voice/tianqin_371.ogg"
    tianqin "괜찮아. 난 그런 얘기 신경 안 써."


translate japanese plot2_adf11ebd:



    voice "voice/banzhang_35.ogg"
    banzhang "저기…… 두 분도 중앙 공원에 가시나요?"


translate japanese plot2_b7dc2262:



    voice "voice/tianqin_372.ogg"
    tianqin "응. 반장도 우리랑 같이 갈래?"


translate japanese plot2_40ebf677:



    voice "voice/banzhang_36.ogg"
    banzhang "저는…… 그만둘게요."


translate japanese plot2_154a50c6:



    voice "voice/banzhang_37.ogg"
    banzhang "체육 특기생 훈련이 있어서 이따 운동장에 갈 예정이에요."


translate japanese plot2_954790ae:



    voice "voice/tianqin_373.ogg"
    tianqin "그래? 아쉽네."


translate japanese plot2_d90e40c4:



    voice "voice/tianqin_374.ogg"
    tianqin "훈련 힘내!"


translate japanese plot2_47dcbf2c:



    voice "voice/banzhang_38.ogg"
    banzhang "네, 열심히 할게요."


translate japanese plot2_24f72836:



    voice "voice/banzhang_39.ogg"
    banzhang "그러고 보니…… 지금 중앙 공원에 사람이 엄청 많대요."


translate japanese plot2_5ba3eff6:



    voice "voice/banzhang_40.ogg"
    banzhang "두 분도 조심하세요. 사람이 많으면 서로 밀려서 위험하니까요……"


translate japanese plot2_13ef33dc:



    voice "voice/tianqin_375.ogg"
    tianqin "걱정 마. 사람들 움직임 잘 살필게."


translate japanese plot2_ac56dd14:



    voice "voice/banzhang_41.ogg"
    banzhang "지하철로 가시나요? 지금 역 안이 상당히 붐비는 것 같던데요."


translate japanese plot2_305474a5:



    voice "voice/tianqin_376.ogg"
    tianqin "아니, 우린 공유 자전거로 갈 거야."


translate japanese plot2_e8f7bd73:



    voice "voice/tianqin_377.ogg"
    tianqin "히나타가 사람 많은 데를 불편해하거든."


translate japanese plot2_6f0fe499:



    voice "voice/yangxi_81.ogg"
    yangxi "사람 많은 데 싫어하는 거 뻔히 알면서 억지로 끌고 가다니, 참 심술궂다니까."


translate japanese plot2_1ae3e58d:



    voice "voice/tianqin_378.ogg"
    tianqin "에이, 같이 가 줘～."


translate japanese plot2_a887b29a:



    voice "voice/banzhang_42.ogg"
    banzhang "후후, 사이가 좋으시네요."


translate japanese plot2_391c4805:



    voice "voice/yangxi_82.ogg"
    yangxi "슬슬 갈까."


translate japanese plot2_3d38f80a:



    voice "voice/yangxi_83.ogg"
    yangxi "더 꾸물거리면 자전거도 없겠다."


translate japanese plot2_5d69e00d:



    voice "voice/tianqin_379.ogg"
    tianqin "맞다! 우리도 가야겠다."


translate japanese plot2_57f96012:



    voice "voice/tianqin_380.ogg"
    tianqin "그럼 내일 봐, 반장."


translate japanese plot2_76241cd4:



    voice "voice/banzhang_43.ogg"
    banzhang "응, 내일 봐."


translate japanese plot2_96ff637e:



    voice "voice/tianqin_381.ogg"
    tianqin "우와……!"


translate japanese plot2_f7eeafbe:



    voice "voice/yangxi_84.ogg"
    yangxi "역시……"


translate japanese plot2_871c8f2f:



    voice "voice/npc10_01.ogg"
    npc10 "여러분, 보세요! 이게 지금 화제인 「도시에서 가장 큰 나무」……"


translate japanese plot2_683dffb8:



    voice "voice/npc11_01.ogg"
    npc11 "지금 구매하시면 20퍼센트 할인도 받으실 수 있습니다……"


translate japanese plot2_876ce2d0:



    voice "voice/npc12_01.ogg"
    npc12 "거기! 앞 좀 가리지 마세요!"


translate japanese plot2_ac84f48b:



    voice "voice/npc13_01.ogg"
    npc13 "무슨 소리야, 여긴 누구나 와도 되는 곳이야!"


translate japanese plot2_442941ca:


    "……"


translate japanese plot2_da739038:


    "나무 밑에 가기는커녕, 중앙 공원 입구부터 사람으로 가득했다."


translate japanese plot2_fb3db783:


    "동네 주민, 외지 관광객, 조회 수를 노리고 달려온 각종 개인 방송인들…… 온갖 사람이 중앙 공원에 몰려들었다."


translate japanese plot2_ea9118d5:


    "그곳에는 평소 중앙 공원의 모습이 더 이상 남아 있지 않았다."


translate japanese plot2_ea21362e:


    "그 넓던 공원은 흔적도 없었다."


translate japanese plot2_f06db71b:


    "代わりに、公園全体を覆い尽くすように巨大な一本の樹が根を張っていた。"


translate japanese plot2_d6a3b7fe:


    "変化はそこだけに留まらなかった。中央公園の全体が、まるで別世界に変わっていた。"


translate japanese plot2_b409b5c7:


    "まるで巨樹に付き従うかのように、無数の木々が一斉に生い茂り、元の公園の面影を完全に埋め尽くしていた。"


translate japanese plot2_46af5df7:


    "이곳은 이제 「공원」이라기보다는 「숲」 그 자체였다."


translate japanese plot2_29754c57:



    voice "voice/tianqin_382.ogg"
    tianqin "사람이 많을 줄은 알았지만, 이 정도일 줄은 몰랐네……"



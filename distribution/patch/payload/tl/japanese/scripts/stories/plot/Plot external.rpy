


translate japanese plotexternal_c8007a93:


    nvlNone "「왜 산에 오르는가?」"


translate japanese plotexternal_42680d99:


    nvlNone "어느 등산가가 그런 말을 했던 것 같다."


translate japanese plotexternal_8ed399d1:



    voice "voice/tianqin_2719.ogg"
    nvlNone "「후—— 더워——」"


translate japanese plotexternal_f70fe0cd:


    nvlNone "라이라는 조금이라도 몸을 식히려고 연신 옷깃으로 부채질했다."


translate japanese plotexternal_8601180f:


    nvlNone "가슴 쪽 단추를 세 개나 풀었는데도 전혀 효과가 없었다."


translate japanese plotexternal_f8e2722d:



    voice "voice/tianqin_2720.ogg"
    nvlNone "「히나타는 안 더워?」"


translate japanese plotexternal_4a88febe:



    voice "voice/yangxi_0993.ogg"
    nvlNone "「뭐, 괜찮아.」"


translate japanese plotexternal_56dc67af:


    nvlNone "나도 조금은 땀이 나지만 라이라만큼은 아니다."


translate japanese plotexternal_2710ff7a:



    voice "voice/yangxi_0994.ogg"
    nvlNone "「그러니까 한번 집에 가서 더 시원한 옷으로 갈아입고 오랬잖아.」"


translate japanese plotexternal_0e9c3d66:


    nvlNone "그래. 오늘 우리의 목적은——"


translate japanese plotexternal_f74c6425:


    nvlNone "시간을 네 시간쯤 되돌려 보자."


translate japanese plotexternal_503e7a27:


    nvlNone "경비원이 보지 않는 틈에 나와 라이라는 당당히 정문으로 학교를 빠져나왔다."


translate japanese plotexternal_2a201c9a:



    voice "voice/tianqin_2722.ogg"
    nvlNone "「아하하, 학교 안녕——!」"


translate japanese plotexternal_82df289e:


    nvlNone "유토리 교육 덕인지 학교에서는 우리를 그리 엄하게 단속하지 않았다."


translate japanese plotexternal_c8319029:


    nvlNone "수업을 빼먹든 학교를 나가든 자유였다."


translate japanese plotexternal_15cc4c9d:


    nvlNone "나도 라이라도 학교에 처박혀 곰팡이나 피우느니 밖을 돌아다니는 게 좋았다."


translate japanese plotexternal_040db19c:


    nvlNone "학교 근처라면 이제 거의 다 가 봤다."


translate japanese plotexternal_e7130682:


    nvlNone "번화가, 공원, 헬스장, 도서관, 오락실……"


translate japanese plotexternal_2e278123:


    nvlNone "그리고 지금, 학교를 빠져나온 우리는 중대한 문제에 직면해 있다."


translate japanese plotexternal_ff9b1dc2:


    nvlNone "라이라와 시시한 이야기를 하며 걷다 보니,\n어느새 도시 서쪽 공원까지 와 있었다."


translate japanese plotexternal_2deb9616:


    nvlNone "호수를 끼고 있는 도시공원이다."


translate japanese plotexternal_9e19ac4f:


    nvlNone "라이라는 이곳을 좋아했다."


translate japanese plotexternal_22f7a743:


    nvlNone "놀러 갈 곳을 정하지 못하면\n으레 슬그머니 나를 이리로 데려왔다."


translate japanese plotexternal_0578920a:



    voice "voice/tianqin_2723.ogg"
    nvlNone "「다음은 어디 갈까?」"


translate japanese plotexternal_fadea266:


    nvlNone "湖面を渡ってきた風が、\n心地よい涼しさを何度も運んでくる。"


translate japanese plotexternal_1331c89d:


    nvlNone "나는 그대로 벤치에 드러누워,\n편안하게 낮잠을 자기로 했다."


translate japanese plotexternal_9d88aa22:



    voice "voice/tianqin_2724.ogg"
    nvlNone "「에에! 노숙자처럼 자지 마!」"


translate japanese plotexternal_89a98f73:


    voice "voice/yangxi_0996.ogg"
    nvlNone "「누워 봐. 기분 좋으니까.」{p}나는 라이라에게 손을 팔랑팔랑 흔들고는 가방을 베고 벤치에 똑바로 드러누웠다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_0996.ogg', None))


translate japanese plotexternal_67c26a7e:



    voice "voice/tianqin_2725.ogg"
    nvlNone "「정말——」"


translate japanese plotexternal_128877f7:


    nvlNone "그러다 호수 건너편을 보고는 불쑥 말했다."


translate japanese plotexternal_4e866d7c:


    voice "voice/yangxi_0997.ogg"
    nvlNone "「뭐?」{p}라이라의 제안에 나도 모르게 몸을 일으켰다.{p}「등산?」" (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_0997.ogg', None, 'voice/yangxi_0998.ogg'))


translate japanese plotexternal_19da7631:



    voice "voice/yangxi_0999.ogg"
    nvlNone "「설마……」"


translate japanese plotexternal_09f7507b:


    nvlNone "그 시선을 따라가니 호수 건너편의 작은 산이 보였다."


translate japanese plotexternal_2a64bd5e:



    voice "voice/tianqin_2728.ogg"
    nvlNone "「아니야! 저건 너무 낮아서 오르는 맛이 없잖아.」"


translate japanese plotexternal_ede21821:


    nvlNone "「음, 룽화 동쪽까지 가는 거야?」"


translate japanese plotexternal_d0fa6fe8:


    nvlNone "나는 눈을 감고 생각했다."


translate japanese plotexternal_cbc4f6bf:


    nvlNone "지금 있는 곳은 룽화 서쪽 공원이다.\n동쪽까지 가려면 지하철을 적어도 두 시간은 타야 한다."


translate japanese plotexternal_78c1b43a:



    voice "voice/tianqin_2730.ogg"
    nvlNone "「자, 가자, 가자—! 여기서 자느니 나랑 땀 흘리러 가자!」"


translate japanese plotexternal_a4de9687:


    nvlNone "라이라는 생각할 틈도 주지 않고 억지로 나를 벤치에서 끌어 일으켰다."


translate japanese plotexternal_d8532b15:



    voice "voice/yangxi_1002.ogg"
    nvlNone "「알았어, 알았어. 그렇게 안 잡아당겨도 같이 갈게.」"


translate japanese plotexternal_9409102c:


    nvlNone "거절하고 싶었는데 결국 권유를 받아들이고 말았다."


translate japanese plotexternal_a2069464:



    voice "voice/tianqin_2731.ogg"
    nvlNone "「우물우물우물——」"


translate japanese plotexternal_46dac806:


    nvlNone "지하철역에 들어가기 전에\n라이라는 손에 든 쏸차이 찐빵을 허겁지겁 먹어 치웠다."


translate japanese plotexternal_d1b71b72:


    voice "voice/yangxi_1003.ogg"
    nvlNone "「정말 다섯 개나 살 거야?」{p}가게에서 찐빵을 주문하는 걸 보고 그렇게 물었다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1003.ogg', None))


translate japanese plotexternal_3d5f6964:


    nvlNone "사지 말라고 해도 소용없다는 건 안다.\n적어도 개수라도 줄일 수 없을까 했을 뿐이다."


translate japanese plotexternal_89142d9f:


    nvlNone "그래서 지금 이 모양이다."


translate japanese plotexternal_f01cc00f:


    nvlNone "나는 개찰구 너머에서,{p}조금 떨어진 곳에 서서\n양손에 든 마지막 두 개를 번갈아 베어 무는 라이라를 바라보았다."


translate japanese plotexternal_e67edfd5:


    nvlNone "이 애가 먹는 모습은 보고 있으면 재밌다."


translate japanese plotexternal_c674dccc:


    nvlNone "酸っぱいものや辛いものを食べると、すぐに汗をかく。"


translate japanese plotexternal_cf564861:


    nvlNone "그러면서도 자극적인 맛을 무척 좋아한다."


translate japanese plotexternal_e35a75a3:


    nvlNone "전에 같이 쏸라펀을 먹을 때 내가 이런 말을 했다."


translate japanese plotexternal_73300e03:



    voice "voice/yangxi_1004.ogg"
    nvlNone "「사실 미각으로는 매운맛을 느끼지 못해.」{p}「매운 성분이 입안을 자극해서 아픈 것뿐이야.」" (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1004.ogg', 'voice/yangxi_1005.ogg'))


translate japanese plotexternal_bc0aaa34:



    voice "voice/yangxi_1006.ogg"
    nvlNone "「그러니까 네가 좋아하는 건 매운 음식이 아니라 매운맛이 주는 고통인 거지.」"


translate japanese plotexternal_29440f4e:



    voice "voice/tianqin_2734.ogg"
    nvlNone "「음, 그…… 런가.」"


translate japanese plotexternal_561976d7:



    voice "voice/yangxi_1007.ogg"
    nvlNone "「완전 마조네.」"


translate japanese plotexternal_fdf95445:


    nvlNone "삑——"


translate japanese plotexternal_580dc877:



    voice "voice/tianqin_2736.ogg"
    nvlNone "「다 먹었어!」"


translate japanese plotexternal_8f422523:


    nvlNone "……"


translate japanese plotexternal_8f409772:


    nvlNone "다행히 출근 시간이 지난 지하철에는 승객이 거의 없었다."


translate japanese plotexternal_b69b0744:


    nvlNone "사람 많은 밀폐된 장소는 질색이다."


translate japanese plotexternal_bc255554:


    nvlNone "버스, 지하철, 엘리베이터."


translate japanese plotexternal_149e23f9:


    nvlNone "꼭 필요한 게 아니라면 이런 곳은 최대한 피한다."


translate japanese plotexternal_4a124ca0:


    nvlNone "이런 곳에 있으면 이유 없이 불안해진다."


translate japanese plotexternal_9a691ce7:


    nvlNone "「이쪽 봐——!」"


translate japanese plotexternal_1393a893:



    voice "voice/yangxi_1009.ogg"
    nvlNone "「브이.」"


translate japanese plotexternal_0319fa1e:


    nvlNone "라이라가 어깨를 두드리자 반사적으로 그쪽을 향해 「브이」를 했다."


translate japanese plotexternal_2caec4bf:


    nvlNone "찰칵——!"


translate japanese plotexternal_d7914e70:



    voice "voice/yangxi_1010.ogg"
    nvlNone "「갑자기 왜? 새 스티커야?」"


translate japanese plotexternal_8e4583f5:



    voice "voice/tianqin_2738.ogg"
    nvlNone "「응! 봐 봐!」"


translate japanese plotexternal_799b6e68:



    voice "voice/yangxi_1011.ogg"
    nvlNone "「인형 탈 스티커네.」"


translate japanese plotexternal_7e7cbcf2:



    voice "voice/tianqin_2739.ogg"
    nvlNone "「아하하—— 이 스티커 재밌다!」"


translate japanese plotexternal_2880e666:



    voice "voice/yangxi_1012.ogg"
    nvlNone "「촌스러워.」"


translate japanese plotexternal_d979ad1a:



    voice "voice/tianqin_2740.ogg"
    nvlNone "「이러니까 놀이공원에 온 것 같지 않아?」"


translate japanese plotexternal_ebbf3116:



    voice "voice/yangxi_1013.ogg"
    nvlNone "「놀이공원…… 놀이공원이라……」"


translate japanese plotexternal_75b5c7a7:



    voice "voice/yangxi_1014.ogg"
    nvlNone "「조금. 안 간 지 꽤 됐으니까.」"


translate japanese plotexternal_d3a66f7f:



    voice "voice/tianqin_2742.ogg"
    nvlNone "「그럼 다음에 학교 빼먹고 가자.」"


translate japanese plotexternal_51597be1:



    voice "voice/yangxi_1016.ogg"
    nvlNone "「음……」"


translate japanese plotexternal_f24e7e33:


    nvlNone "어느새 라이라에게 기대어 잠들어 있었다."


translate japanese plotexternal_af3a5a66:


    nvlNone "라이라도 고개를 젖힌 채 창에 기대어 자고 있었다."


translate japanese plotexternal_159c32bc:


    nvlNone "지하철을 오래 타면 꼭 이렇게 된다."


translate japanese plotexternal_8a57ad2d:


    nvlNone "「뭐어—!?」"


translate japanese plotexternal_0c379436:



    voice "voice/yangxi_1018.ogg"
    nvlNone "「야! 라이라! 일어나!」"


translate japanese plotexternal_ae8627d0:


    nvlNone "급히 흔들자 라이라가 졸린 눈으로 나를 봤다.{p}「왜 그래——?」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/tianqin_2743.ogg'))


translate japanese plotexternal_5c1b0812:



    voice "voice/yangxi_1020.ogg"
    nvlNone "「지금 어딘지 봐.」{p}안내 화면을 가리켰다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1020.ogg', None))


translate japanese plotexternal_cc3fb614:


    nvlNone "결국 반대 방향 지하철을 타고 몇 정거장이나 돌아왔다."


translate japanese plotexternal_ced3b2a8:


    nvlNone "지하철만 꼬박 두 시간 반을 탔다."


translate japanese plotexternal_94ad6d0e:



    voice "voice/tianqin_2745.ogg"
    nvlNone "「히나타, 왜 그렇게 푹 잔 거야~」"


translate japanese plotexternal_1fee4dee:



    voice "voice/yangxi_1022.ogg"
    nvlNone "「정말 와 버렸네……」"


translate japanese plotexternal_6219235e:


    nvlNone "눈앞의 길은 그대로 산속으로 이어진다."


translate japanese plotexternal_bf4558cc:


    nvlNone "갑자기 현실감이 사라졌다."


translate japanese plotexternal_781a51a7:


    nvlNone "지하철역에 들어간 건 아홉 시 조금 넘어서였다."


translate japanese plotexternal_12653ab1:


    nvlNone "여기에 도착하니 거의 열두 시다."


translate japanese plotexternal_6043a9d1:


    nvlNone "즉, 지금은 한낮이다."


translate japanese plotexternal_6d46d9c9:


    nvlNone "아직 초여름이라고는 해도,"


translate japanese plotexternal_b6fbbd6d:


    nvlNone "한낮의 햇볕은 역시 따갑다."


translate japanese plotexternal_b1b1344d:


    nvlNone "산에 들어가면 쉽게 돌아나오지 못한다."


translate japanese plotexternal_4f2605c6:


    nvlNone "「자—— 가자, 가자——」"


translate japanese plotexternal_9933a820:


    nvlNone "내가 겁먹은 걸 눈치챈 라이라가 급히 등을 밀었다."


translate japanese plotexternal_dbd828d5:



    voice "voice/yangxi_1023.ogg"
    nvlNone "「잠깐—— 선크림부터 바르게 해 줘!」"


translate japanese plotexternal_ede7700b:



    voice "voice/tianqin_2747.ogg"
    nvlNone "「히나타는 조금 타는 게 더 어울릴 것 같은데?」"


translate japanese plotexternal_507f76ee:


    nvlNone "그 결과가 지금의 이 상황이다."


translate japanese plotexternal_8ed399d1_1:



    voice "voice/tianqin_2748.ogg"
    nvlNone "「후—— 더워——」"


translate japanese plotexternal_3b57af53:


    nvlNone "라이라는 조금이라도 몸의 열을 식히려고 손으로 연신 뺨에 부채질했다."


translate japanese plotexternal_cb4cf0f5:



    voice "voice/yangxi_1025.ogg"
    nvlNone "「후회했어?」"


translate japanese plotexternal_5605e1de:


    nvlNone "「음…… 그러려나.」"


translate japanese plotexternal_10e94e6b:


    nvlNone "여태 올랐던 산을 어떻게든 떠올려 본다."


translate japanese plotexternal_84fdb350:


    nvlNone "頂上からの景色に息をのんだ山も、確かにいくつかはあった。"


translate japanese plotexternal_446a99f0:


    nvlNone "하지만 이 산에서 같은 느낌을 받을 가능성은 낮아 보였다."


translate japanese plotexternal_568513ec:


    nvlNone "한 시간도 안 돼 정상에 도착했다."


translate japanese plotexternal_1adc8724:


    nvlNone "산길은 전혀 험하지 않았고,\n한 시간 내내 완만한 비탈을 올랐을 뿐이다."


translate japanese plotexternal_da03a2f0:


    nvlNone "운동량은 평소 체육 수업보다 적을 정도였다."


translate japanese plotexternal_88b27bb8:


    nvlNone "라이라에게는 드디어 풀려났다는 느낌인 모양이었다."


translate japanese plotexternal_19596e22:



    voice "voice/tianqin_2751.ogg"
    nvlNone "「후아——! 도착했다——!」"


translate japanese plotexternal_0babc0ce:


    nvlNone "그 애는 기뻐하며 정상의 난간에 팔을 얹고,\n정면에서 불어오는 시원한 바람을 맞았다."


translate japanese plotexternal_42756493:


    nvlNone "둘러보니 대체로 예상대로였다."


translate japanese plotexternal_4d782a30:


    nvlNone "정상은 나무에 둘러싸여 있었고,\n나와 라이라 말고는 등산객이 한 명도 없었다."


translate japanese plotexternal_d4d2088b:


    nvlNone "遠くに目を向ければ、木々の梢越しに龍華市の一角を見下ろせる。"


translate japanese plotexternal_696c700c:



    voice "voice/yangxi_1027.ogg"
    nvlNone "「잠깐, 너……!」"


translate japanese plotexternal_e527ef01:


    nvlNone "돌아보니 라이라가 휴지로 셔츠 안쪽의 땀을 닦고 있었다."


translate japanese plotexternal_7ef501c0:



    voice "voice/yangxi_1028.ogg"
    nvlNone "「여기도 일단 공공장소거든. 조금은 조심해.」"


translate japanese plotexternal_4653ea53:



    voice "voice/tianqin_2753.ogg"
    nvlNone "「괜찮아. 여기 너밖에 없잖아.」"


translate japanese plotexternal_7c09b1bd:


    nvlNone "예전부터 그랬다.\n나를 남처럼 대한 적이 없다."


translate japanese plotexternal_b5a392e0:


    nvlNone "그래도 나는 그 애가 걱정된다."


translate japanese plotexternal_232b94df:


    nvlNone "아니, 정확히 말하면,\n이건 내 독점욕일지도 모른다."


translate japanese plotexternal_edad57a5:


    nvlNone "이런 모습은 다른 누구에게도 보이고 싶지 않다."


translate japanese plotexternal_bf9a2668:


    nvlNone "그런데 생각해 보면,"


translate japanese plotexternal_32739908:


    nvlNone "내가 같은 짓을 한다면\n그 애도 틀림없이 불평할 것이다."


translate japanese plotexternal_31d358fa:


    nvlNone "우리는 서로 아주\n비슷한 강한 욕망을 품고 있었다."


translate japanese plotexternal_f55fe516:


    nvlNone "거기까지 생각하고 그만두었다."


translate japanese plotexternal_1ae69c7f:


    voice "voice/yangxi_1029.ogg"
    nvlNone "「……」"


translate japanese plotexternal_4ec536d3:



    voice "voice/tianqin_2755.ogg"
    nvlNone "「왜 그래? 갑자기 무서운 표정이네.」"


translate japanese plotexternal_ece51a63:



    voice "voice/yangxi_1030.ogg"
    nvlNone "「다음 밥은 네가 사.」"


translate japanese plotexternal_5bdf3dd0:


    nvlNone "내려갈 때는 올라갈 때보다 훨씬 편했다."


translate japanese plotexternal_c2788c4c:


    nvlNone "계속 내리막이라 속도를 늦추려 해도 잘되지 않았다."


translate japanese plotexternal_4e883513:


    nvlNone "나와 라이라는 타닥타닥 가볍게 뛰며 산을 내려왔다."


translate japanese plotexternal_96910978:


    nvlNone "결국 우리는 무엇 때문에 산에 올랐을까?"


translate japanese plotexternal_58f822fd:


    nvlNone "룽화 동쪽 근처 상점가에서 가격이 적당한 체인 식당에 들어갔다."


translate japanese plotexternal_7d5a779c:


    nvlNone "「아리사」라는 가게로, 나와 라이라는 룽화 서쪽 지점의 단골이었다."


translate japanese plotexternal_356e5d1d:


    nvlNone "한 가지 마음에 걸리는 것은\n현지 입맛에 맞춘 서양 요리로 성공한 체인이라는 점이다."


translate japanese plotexternal_b961b1c5:


    nvlNone "나는 이런 요리에는 까다롭다.\n고향 음식이니까."


translate japanese plotexternal_ab84c331:


    nvlNone "하지만 시간이 지나면서,\n그렇게까지 싫지는 않아졌다."


translate japanese plotexternal_5d509937:


    nvlNone "오히려 여기의 값싼 미트소스 파스타가 조금 좋아지고 있다."


translate japanese plotexternal_46065de4:


    nvlNone "아니면 다른\n선택지가 없었을 뿐일지도 모른다."


translate japanese plotexternal_f1d0db60:


    nvlNone "그렇기는 해도,"


translate japanese plotexternal_1a595cb7:


    nvlNone "注文した料理が全部そろった頃には、もう午後二時半だった。"


translate japanese plotexternal_24c8d7df:


    nvlNone "학교에서는 오후 첫 수업이 절반쯤 끝났을 무렵이다."


translate japanese plotexternal_0c10b369:


    nvlNone "뭐, 아무래도 좋다."


translate japanese plotexternal_f69db000:


    nvlNone "탁자 가득 놓인 음식을 앞에 두고\n무서운 속도로 접시를 비우고 있었다."


translate japanese plotexternal_3699b2c9:


    nvlNone "처음 같이 식사했을 때는 그 먹성에 놀랐다."


translate japanese plotexternal_16608a58:


    nvlNone "굶주린 귀신 같았다."


translate japanese plotexternal_c07e0cac:


    nvlNone "이제 라이라와 식사할 때는 주문할 필요조차 없다."


translate japanese plotexternal_6c939843:


    nvlNone "그 애가 시킨 음식에서 당연하다는 듯 내 그릇에 덜어 오면 된다."


translate japanese plotexternal_5c02e6cc:


    nvlNone "주방에서 나온 직원이 피자를 들고 우리 탁자 옆을 지나갔다."


translate japanese plotexternal_687565d7:


    nvlNone "냄새가 순식간에 코를 찔렀다."


translate japanese plotexternal_193eb8ba:



    voice "voice/yangxi_1031.ogg"
    nvlNone "「윽…… 두리안……」"


translate japanese plotexternal_e4c87ffb:



    voice "voice/tianqin_2757.ogg"
    nvlNone "「{a=dictionary:dict_entry_95}두리안 피자{/a}가 의외로 맛있다던데?」"


translate japanese plotexternal_0c0ce8ef:



    voice "voice/yangxi_1032.ogg"
    nvlNone "「그거 시키면 다음부터 같이 안 와.」"


translate japanese plotexternal_d13cf204:


    nvlNone "아니, 이 녀석은 내가 없을 때 혼자 몰래 먹을 게 틀림없다."


translate japanese plotexternal_c635c7fa:



    voice "voice/yangxi_1033.ogg"
    nvlNone "「……피자에 대한 모독이야!」"


translate japanese plotexternal_36787402:



    voice "voice/tianqin_2759.ogg"
    nvlNone "「과일 피자랑 비교하면?」"


translate japanese plotexternal_49c0989e:


    nvlNone "밥을 먹고 라이라와 룽화 동쪽 상점가를 한동안 걸었다."


translate japanese plotexternal_8f96ad1f:


    nvlNone "여기는 우리가 평소 가는 상점가보다 번화한 모양이다."


translate japanese plotexternal_fc2c80bd:


    nvlNone "내 눈에는 그리 큰 차이가 없어 보였다."


translate japanese plotexternal_25f82242:


    nvlNone "옷 가게, 액세서리 가게, 화장품 가게."


translate japanese plotexternal_87a8c764:


    nvlNone "게다가 지금은 오후 두세 시. 보행자 거리에는 사람이 거의 없었다."


translate japanese plotexternal_e9bf40fb:



    voice "voice/tianqin_2760.ogg"
    nvlNone "「딱히 특별한 건 없네!」"


translate japanese plotexternal_1b5b6c39:


    nvlNone "라이라까지 그런 말을 하기 시작했다."


translate japanese plotexternal_373309c6:



    voice "voice/yangxi_1035.ogg"
    nvlNone "「보행자 거리야 어디든 똑같지 않아?」"


translate japanese plotexternal_2e174e6c:



    voice "voice/tianqin_2761.ogg"
    nvlNone "「휴대폰으로 찾아보니까,\n여기가 아시아 지구에서 세 손가락 안에 드는 보행자 거리래!」"


translate japanese plotexternal_0bbe48c6:



    voice "voice/tianqin_2762.ogg"
    nvlNone "「음, 좀 더 특별할 줄 알았는데.」"


translate japanese plotexternal_866b9ea7:


    nvlNone "라이라는 볼을 부풀리고 불만스럽게 평했다."


translate japanese plotexternal_7e232b88:



    voice "voice/yangxi_1038.ogg"
    nvlNone "「아, 지도 앱 보니까 앞에 노점 거리가 있대.」"


translate japanese plotexternal_e7c16c90:


    nvlNone "결국 노점 거리도 특별한 것은 없었다."


translate japanese plotexternal_adb6921b:


    nvlNone "다른 곳처럼 유행하는 음식을 이것저것 팔았다."


translate japanese plotexternal_016928b6:


    nvlNone "이런 유행 가게는 시간이 좀 지나면 통째로 바뀐다."


translate japanese plotexternal_f8045389:


    nvlNone "맛있는 것보다는 화제가 되는 것을 팔고 싶은 모양이다."


translate japanese plotexternal_57d4c214:


    nvlNone "그래도 라이라는 즐거워 보였다."


translate japanese plotexternal_b90f06a8:


    nvlNone "음식이기만 하면 유행 여부 따위는 아무래도 좋다.{p}전부 배 속에 넣으면 그만이다."


translate japanese plotexternal_0652ef7c:



    voice "voice/tianqin_2764.ogg"
    nvlNone "「으음~ 마시써. 히나타도 안 머거?」"


translate japanese plotexternal_56b87311:



    voice "voice/tianqin_2765.ogg"
    nvlNone "「자!」"


translate japanese plotexternal_f6c27e90:


    nvlNone "라이라가 튀긴 고기 완자 꼬치를 눈앞에 내밀었다.\n나는 완자를 보며 망설였다."


translate japanese plotexternal_a8d2007a:


    nvlNone "보기만 해도 기름져서 내게는 조금 부담스러워 보였다."


translate japanese plotexternal_dc18a579:


    nvlNone "「조금만 먹어 봐!」"


translate japanese plotexternal_bb9dced9:



    voice "voice/yangxi_1040.ogg"
    nvlNone "「하아…… 하나만.」"


translate japanese plotexternal_4b9b76f1:


    nvlNone "처음 라이라와 노점 음식을 먹었을 때는 그날 밤 배탈이 났던 기억이 있다."


translate japanese plotexternal_2fb2026f:


    nvlNone "나는 라이라와 다르다. 그 애의 소화기관은 강철로 만든 밑 없는 늪이다."


translate japanese plotexternal_dac413ab:


    nvlNone "「맛있지?」"


translate japanese plotexternal_51597be1_1:



    voice "voice/yangxi_1041.ogg"
    nvlNone "「음……」"


translate japanese plotexternal_1e2594ab:


    nvlNone "입안의 완자를 씹었다.{p}혀에는 튀김의 느끼함과 지나친 짠맛만 느껴졌다."


translate japanese plotexternal_c6eaf756:


    nvlNone "「맛있다」와는 거리가 멀다."


translate japanese plotexternal_8b35c5ac:



    voice "voice/yangxi_1042.ogg"
    nvlNone "「맛없어.」"


translate japanese plotexternal_b1e58404:


    nvlNone "그 뒤에는 근처 쇼핑몰도 둘러보았다."


translate japanese plotexternal_149a04e0:


    nvlNone "예상대로 안의 체인점도 전부 낯익은 곳들이었다."


translate japanese plotexternal_a60f8fc0:


    nvlNone "어느 쇼핑몰에 가든,\n같은 서비스를 받을 수 있을 것 같았다."


translate japanese plotexternal_bae60c70:


    nvlNone "마지막에는 퇴근 시간이 시작되기 전에\n서둘러 룽화 서쪽으로 가는 지하철에 올랐다."


translate japanese plotexternal_eb5aca85:



    voice "voice/tianqin_2769.ogg"
    nvlNone "「이야, 오늘 룽화 동쪽까지 올 줄은 몰랐네.」"


translate japanese plotexternal_7c3ab240:



    voice "voice/tianqin_2770.ogg"
    nvlNone "「실컷 땀 흘리니까 나쁘지 않았지?」"


translate japanese plotexternal_ffebaabe:


    nvlNone "아직 퇴근 시간 전인데도\n차 안은 아침보다 훨씬 붐볐다."


translate japanese plotexternal_b6e6d3c0:


    nvlNone "다행히 앉을 자리가 없을 정도는 아니었다."


translate japanese plotexternal_114adc6d:


    nvlNone "나는 긴 의자 구석에 앉았고, 라이라는 알아서 그 옆에 앉았다."


translate japanese plotexternal_d344a152:


    nvlNone "지하철은 미끄러지듯 달렸다."


translate japanese plotexternal_9260c82a:


    nvlNone "룽화시를 가로지르는 이 노선은\n지상과 지하를 거듭 오간다."


translate japanese plotexternal_2e6f67cd:


    nvlNone "하늘은 주황빛으로 물들었고, 나는 조금 넋을 놓고 바라보았다."


translate japanese plotexternal_14977314:


    nvlNone "내릴 역이 가까워질 무렵, 역시 승객들이 차 안으로 잔뜩 밀려들었다."


translate japanese plotexternal_8e0c06aa:


    nvlNone "결국 퇴근길 혼잡을 피하지는 못했다."


translate japanese plotexternal_14f6ee37:


    nvlNone "무심코 가방을 몸 앞으로 돌려 방패처럼 꼭 끌어안았다."


translate japanese plotexternal_0aa1ed59:


    nvlNone "불안한 두 손으로 가방의 마스코트 인형을 몇 번이고 짓눌렀다."


translate japanese plotexternal_1838b667:


    nvlNone "평소에는 소중히 다루는데 지금은 모양이 완전히 뭉개졌다."


translate japanese plotexternal_6410c6b6:


    nvlNone "그때 라이라가 문득 내 어깨에 머리를 기댔다."


translate japanese plotexternal_8f684acd:


    voice "voice/tianqin_2771.ogg"
    nvlNone "「몇 정거장만 더 가면 내려.」{p}그 애가 귓가에 조용히 말했다." (callback=nvl_page_voice, cb_page_voices=('voice/tianqin_2771.ogg', None))


translate japanese plotexternal_1ae69c7f_1:


    voice "voice/yangxi_1046.ogg"
    nvlNone "「……」"


translate japanese plotexternal_759e081e:


    nvlNone "「힘들어?」"


translate japanese plotexternal_1ae69c7f_2:


    voice "voice/yangxi_1047.ogg"
    nvlNone "「……」"


translate japanese plotexternal_61441de4:


    nvlNone "ライラが、固く組んだ私の両手にそっと手を重ねる。少しだけ息ができるようになった。"


translate japanese plotexternal_ece7b0c3:


    nvlNone "그 애가 다시 물었다.{p}「내릴까?」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/tianqin_2773.ogg'))


translate japanese plotexternal_65a73f08:


    nvlNone "이상하게도 라이라가 곁에 있으면 견딜 수 있을 것 같았다."


translate japanese plotexternal_641af752:


    nvlNone "긴장도 많이 옅어졌다."


translate japanese plotexternal_7faf40a4:


    nvlNone "「……너무 기대잖아.」"


translate japanese plotexternal_9141f4bd:



    voice "voice/tianqin_2774.ogg"
    nvlNone "「응?」"


translate japanese plotexternal_3ceebc00:



    voice "voice/yangxi_1050.ogg"
    nvlNone "「땀 냄새 나.」"


translate japanese plotexternal_73874721:



    voice "voice/tianqin_2776.ogg"
    nvlNone "「정말 이사 안 도와줘도 돼?」"


translate japanese plotexternal_ae93b28c:


    nvlNone "지하철역에서 헤어질 때 라이라가 물었다."


translate japanese plotexternal_b74232e1:


    nvlNone "집에 와서도 바로 씻지 않고 옷부터 챙겼다."


translate japanese plotexternal_ce33a5c6:


    nvlNone "빵빵해진 여행 가방을 보며 생각에 잠겼다."


translate japanese plotexternal_39da121e:



    voice "voice/yangxi_1053.ogg"
    nvlNone "「너무 많이 챙겼나?」"


translate japanese plotexternal_1d3b8c49:


    nvlNone "아까 역에서 라이라에게 도와 달라고 하는 게 나았을지도 모른다."


translate japanese plotexternal_d71eb633:


    nvlNone "적어도 여행 가방 하나만 더\n가져와 달라고 할걸 그랬다."


translate japanese plotexternal_58ab1a14:


    nvlNone "방 안을 돌아다니며,\n어떻게 해야 가방 안에 여유가 생길지 생각했다."


translate japanese plotexternal_2a4d04b8:



    voice "voice/yangxi_1055.ogg"
    nvlNone "「걔 집에도 있으니까,\n정 안 되면 라이라 옷을 입지 뭐.」"


translate japanese plotexternal_0a4c3aeb:


    nvlNone "이것저것 빼다 보니 작은 여행 가방에도 간신히 여유가 생겼다."


translate japanese plotexternal_fe77a6e9:



    voice "voice/yangxi_1056.ogg"
    nvlNone "「로리타 옷들아…… 다음에 데리러 올게.」"


translate japanese plotexternal_1de13e80:



    voice "voice/yangxi_1057.ogg"
    nvlNone "「응…… 이 정도면 됐겠지.」"


translate japanese plotexternal_2aa70494:


    nvlNone "작은 여행 가방을 닫고,\n일단 짐 정리를 마쳤다."


translate japanese plotexternal_b6332e09:



    voice "voice/yangxi_1058.ogg"
    nvlNone "「아……」"


translate japanese plotexternal_2a95ec9f:



    voice "voice/yangxi_1059.ogg"
    nvlNone "「……전부 압수당했지.」"


translate japanese plotexternal_a247eaef:


    nvlNone "얼마 전 라이라가 내건 조건이었다."


translate japanese plotexternal_34c6d187:


    nvlNone "앞으로도 계속 이어 가고 싶다면,\n중독성 있는 것은 끊을 것."


translate japanese plotexternal_c27704aa:


    nvlNone "그 뒤로 주머니에서는 막대사탕만 나오게 되었다."


translate japanese plotexternal_b46d36dc:


    nvlNone "라이라 말로는 이것으로 대신할 수 있단다."


translate japanese plotexternal_868657ed:


    nvlNone "애초에 담배에 중독된 것은 아니라,\n금단 증상도 없다."


translate japanese plotexternal_483d28f3:


    nvlNone "막대사탕으로 바꾼 뒤에도,\n생활은 별로 달라지지 않았다."


translate japanese plotexternal_8cf97376:


    nvlNone "라이라가 보지 않는 곳에서도,\n약속을 어기지는 않았다."


translate japanese plotexternal_e2c7344c:


    nvlNone "애초에 라이라 몰래 피울 용기도 없다."


translate japanese plotexternal_739a5acb:


    nvlNone "그 애의 코는 개보다 예민하다."


translate japanese plotexternal_7bde8832:


    nvlNone "학생이 담배를 피웠는지 확인하려고 손가락 냄새까지 맡는 학년부장과는 다르다."


translate japanese plotexternal_db9f3067:


    nvlNone "하지만 장난의 신은\n나를 놀리고 싶어진 모양이다."


translate japanese plotexternal_209bccf3:


    nvlNone "여행 가방에서 옷을 꺼내 던지자,{p}사이에 끼어 있던 담배 한 개비가 미끄러져 떨어졌다."


translate japanese plotexternal_a13a9d71:


    nvlNone "조용히, 지나치게 절묘한 움직임으로,\n내 눈앞 바닥에 떨어졌다."


translate japanese plotexternal_efab075e:


    nvlNone "낯이 익었다. 아주 오래전에 산 것이다."


translate japanese plotexternal_b6332e09_1:



    voice "voice/yangxi_1060.ogg"
    nvlNone "「아……」"


translate japanese plotexternal_1d605c2b:


    nvlNone "조금 생각하자 금방 떠올랐다."


translate japanese plotexternal_60128392:


    nvlNone "전에 딱 한 번 담뱃갑을\n엎은 적이 있었다."


translate japanese plotexternal_1ae69c7f_3:


    voice "voice/yangxi_1061.ogg"
    nvlNone "「……」"


translate japanese plotexternal_f8a549d1:


    nvlNone "나는 그것을 바라보았다.\n그것도 나를 마주 보는 것 같았다."


translate japanese plotexternal_b08992fa:


    nvlNone "다음 순간, 마음속이 거세게 출렁이기 시작했다."


translate japanese plotexternal_a22416d2:


    nvlNone "뭐라고 하더라."


translate japanese plotexternal_1c79abbd:


    nvlNone "하지 말라고 할수록 더 하고 싶어진다."


translate japanese plotexternal_99968fed:


    nvlNone "세상을 멸망시키는 새빨간 버튼이라도,\n누군가는 꼭 누른다."


translate japanese plotexternal_538047b2:


    nvlNone "인간이라는 생물은,\n태어날 때부터 그런 청개구리다."


translate japanese plotexternal_7969ea35:


    nvlNone "베란다로 달려가 담배를 입술에 물고 라이터로 불을 붙였다."


translate japanese plotexternal_e943782c:



    voice "voice/yangxi_1063.ogg"
    nvlNone "「후——」"


translate japanese plotexternal_b2f137de:


    nvlNone "오랜만에 연기를 들이마셨다. 하지만 니코틴은 예전 같은 쾌감을 주지 않았다."


translate japanese plotexternal_51f7c80d:


    nvlNone "대신 지독한 죄책감이 가슴으로 밀려왔다."


translate japanese plotexternal_1cc18846:


    nvlNone "귓가에서 속삭이던 악마들은,\n이미 사라졌다."


translate japanese plotexternal_f8c27a57:


    nvlNone "대신 그들의 웃음소리가 들리는 것 같았다."


translate japanese plotexternal_903ae614:


    nvlNone "장난의 신과 함께 나를 비웃고 있었다."


translate japanese plotexternal_1ae69c7f_4:


    voice "voice/yangxi_1064.ogg"
    nvlNone "「……」"


translate japanese plotexternal_d6d71d91:


    nvlNone "안절부절못하며 다리를 떨고,\n빨리 이 한 개비를 다 피우려 했다."


translate japanese plotexternal_90b5f5df:


    nvlNone "잘못을 저지른 아이처럼."


translate japanese plotexternal_9f634e52:


    nvlNone "악마도 장난의 신도,\n어디에도 없다는 것을 안다."


translate japanese plotexternal_10a2197f:


    nvlNone "그저 내가 참지 못했을 뿐이다."


translate japanese plotexternal_0892bf34:



    voice "voice/yangxi_1065.ogg"
    nvlNone "「이게 마지막이야. 정말 마지막 한 개비.」"


translate japanese plotexternal_36a9d357:


    nvlNone "몇 번이고 스스로에게 말했다."


translate japanese plotexternal_c8f7dffc:


    nvlNone "한숨을 쉬고 남은 것을 얼른 피워 버렸다."


translate japanese plotexternal_1d0ee496:


    nvlNone "私の生活も、人間関係も、新しい段階へ入ろうとしている。"


translate japanese plotexternal_4b86c79f:


    nvlNone "담배를 내려놓는 것처럼."


translate japanese plotexternal_3e015ab9:


    nvlNone "「삐삐…… 삐삐……」"


translate japanese plotexternal_b63eb638:


    nvlNone "탁!"


translate japanese plotexternal_c9275f57:


    nvlNone "두 번 울리자마자 알람을 끄고 졸린 눈을 비볐다."


translate japanese plotexternal_f66f5f4c:



    voice "voice/yangxi_1068.ogg"
    nvlNone "「아…… 머리 아파……」"


translate japanese plotexternal_796bf66f:



    voice "voice/yangxi_1069.ogg"
    nvlNone "「너무 일찍 일어났나……」"


translate japanese plotexternal_ae406bb0:


    nvlNone "알람시계를 보니 짧은 바늘은 네 시를 가리키고 있었다."


translate japanese plotexternal_8999e8c0:


    nvlNone "평소라면 다섯 시가 조금 지나 저절로 눈이 떠진다."


translate japanese plotexternal_04f6a1b9:


    nvlNone "관자놀이를 문지르며 간신히 일어섰다."


translate japanese plotexternal_8b4ffb29:



    voice "voice/yangxi_1070.ogg"
    nvlNone "「으, 와!」"


translate japanese plotexternal_b678a622:


    nvlNone "털썩——"


translate japanese plotexternal_59c70a87:


    nvlNone "한 걸음 내딛는 순간,\n솜을 밟은 듯 다리에 힘이 풀렸다."


translate japanese plotexternal_d4c549cb:


    nvlNone "오랜만에 니코틴을 섭취해서일까?"


translate japanese plotexternal_51e5588e:


    nvlNone "온몸이 거세게 항의하는 것 같았다."


translate japanese plotexternal_8657416e:



    voice "voice/yangxi_1071.ogg"
    nvlNone "「아냐. 무슨 생각이야.」"


translate japanese plotexternal_6031a0e7:


    nvlNone "고개를 흔들고 다시 일어났다."


translate japanese plotexternal_e3edb328:


    nvlNone "세수하니 두통이 조금 가라앉은 것 같았다."


translate japanese plotexternal_987d03f2:


    nvlNone "샤워기를 틀고 이를 닦으며 몸을 씻었다."


translate japanese plotexternal_1166500f:


    nvlNone "어젯밤에는 자기 전에 이를 세 번이나 닦았다.\n잇몸에서 피가 날 것 같을 정도로."


translate japanese plotexternal_b9a0351b:


    nvlNone "그래도 불안은 사라지지 않았다."


translate japanese plotexternal_5b9dff82:


    nvlNone "타르와 니코틴 냄새가,\n입안이나 손끝에 배어 있으면 어쩌나 걱정했다."


translate japanese plotexternal_e943782c_1:



    voice "voice/yangxi_1072.ogg"
    nvlNone "하아——"


translate japanese plotexternal_537caeb6:


    nvlNone "거울 앞에서 몇 번이고 숨을 내쉬고 이를 닦고 다시 숨을 내쉬었다."


translate japanese plotexternal_34c39181:


    nvlNone "상쾌한 치약 향만 느껴지고서야,\n겨우 손을 멈췄다."


translate japanese plotexternal_1f629c6d:


    nvlNone "조심스럽게 욕실을 나와,\n어젯밤 준비해 둔 옷으로 갈아입었다."


translate japanese plotexternal_c94d7889:


    nvlNone "짐도 전부 챙겼다. 언제든 나갈 수 있다."


translate japanese plotexternal_0bca29fa:


    nvlNone "어젯밤의 멍청한 짓만 없었다면,\n완벽한 하루의 시작이었을 텐데."


translate japanese plotexternal_9c07b565:


    nvlNone "집을 나설 때는 하늘이 조금 밝아져 있었다."


translate japanese plotexternal_3e935b8e:


    nvlNone "夏に入ると、夜が明けるのも早い。"


translate japanese plotexternal_624e7587:


    nvlNone "지하철역으로 걸어갈 때는 가능한 한 피하는 곳이 몇 군데 있다."


translate japanese plotexternal_eaedb35c:


    nvlNone "이른 아침이라고 길에 아무도 없는 것은 아니다."


translate japanese plotexternal_472b7f11:


    nvlNone "매일 아침 대여섯 시면 이 동네는 벌써 북적이기 시작한다."


translate japanese plotexternal_3490ba71:


    nvlNone "일찍 일어나는 사람도 다양하다.{p}운동하는 사람, 주부, 추가 근무를 하러 회사로 서둘러 돌아가는 사람."


translate japanese plotexternal_f01aad71:


    nvlNone "나는 아침의 고요함을 독차지하는 게 좋다."


translate japanese plotexternal_298d6993:


    nvlNone "길에서 라디오를 크게 틀어 놓은 사람을 만나면 몹시 짜증이 난다."


translate japanese plotexternal_a51671f5:


    nvlNone "하필 이른 아침에는 그런 사람이 많다."


translate japanese plotexternal_54a482da:


    nvlNone "避けるためには、公園の近くも通れない。"


translate japanese plotexternal_46e003cf:


    nvlNone "아무도 없는 거리를 여행 가방을 끌며 걸었다.{p}바퀴가 보도 타일을 굴러가며,\n덜그럭거렸다."


translate japanese plotexternal_f9915ffa:


    nvlNone "하지만 시끄럽다거나 조용한 분위기를 깨뜨린다고 생각하지는 않았다."


translate japanese plotexternal_c61f7cd8:


    nvlNone "아마 내가 내는 소리라\n전혀 문제로 느껴지지 않는 모양이다."


translate japanese plotexternal_fdf95445_1:


    nvlNone "삑——"


translate japanese plotexternal_a8069c3f:


    nvlNone "교통카드를 찍고 개찰구를 통과했다. 역 안에도 승객은 드문드문 몇 명뿐이었다."


translate japanese plotexternal_fb1fe734:


    nvlNone "늘 첫차를 타니,\n여기 있는 사람은 전부 낯익은 얼굴이다."


translate japanese plotexternal_440af999:


    nvlNone "물론 나는 아니다."


translate japanese plotexternal_e624d128:


    nvlNone "그러고 보니 라이라한테도,\n그 일로 놀림받은 적이 있다—"


translate japanese plotexternal_d344a152_1:


    nvlNone "지하철은 별로 흔들리지도 않고 조용히 계속 달렸다."


translate japanese plotexternal_41966cc4:


    nvlNone "라이라 집에서 가장 가까운 역까지 가려면 몇 정거장 더 간 뒤 갈아타야 한다."


translate japanese plotexternal_2e13e1d1:


    nvlNone "휴대폰을 만지작거리며 알맹이 없는 뉴스를 훑었다."


translate japanese plotexternal_f6c9b80c:


    nvlNone "「집에서 나왔어.」"


translate japanese plotexternal_34807f66:


    nvlNone "맨 아래에는 십오 분 전에 내가 보낸 메시지가 있었다."


translate japanese plotexternal_688432ff:


    nvlNone "물론 아직 읽음 표시는 뜨지 않았다."


translate japanese plotexternal_575aacdb:



    voice "voice/yangxi_1074.ogg"
    nvlNone "（적어도 일어나서 문은 열어 줘……）"


translate japanese plotexternal_46fe4ff5:


    nvlNone "속으로 그렇게 빌었다."


translate japanese plotexternal_5d5f6199:



    voice "voice/yangxi_1075.ogg"
    nvlNone "「거짓말……」"


translate japanese plotexternal_b2c628df:


    nvlNone "하지만 벌써 오늘의 첫 오산과 마주했다."


translate japanese plotexternal_3aeec22f:


    nvlNone "이 환승역은……"


translate japanese plotexternal_34c267fb:


    nvlNone "그러니까 여기서 갈아타면 앞으로 가는 내내 저 사람들 틈에 끼어 시달려야 한다는 거다."


translate japanese plotexternal_2a0096ea:


    nvlNone "이렇게 이른 시간에 지하철에 사람이 이토록 많을 줄은 전혀 예상하지 못했다."


translate japanese plotexternal_93a72475:


    nvlNone "늘 타던 첫차 탓에\n이른 아침 지하철은 어디나 텅 비어 있을 거라고 생각했던 모양이다."


translate japanese plotexternal_135350bd:


    nvlNone "정말 붐비는 노선은 첫차부터 거의 만원이다."


translate japanese plotexternal_fc3afe81:



    voice "voice/yangxi_1076.ogg"
    nvlNone "「하아……」"


translate japanese plotexternal_682456a7:


    nvlNone "한숨을 쉬고,\n지도 앱으로 목적지까지의 거리를 다시 확인했다."


translate japanese plotexternal_22d7e2a8:


    nvlNone "고민 끝에 여행 가방을\n끌고 역 출구로 향했다."


translate japanese plotexternal_9f0d188a:


    nvlNone "3킬로미터라는 거리는,\n길다고도 짧다고도 하기 어렵다."


translate japanese plotexternal_36ec6681:


    nvlNone "歩けば、おそらく四十分ほどかかる。"


translate japanese plotexternal_447de5d6:


    nvlNone "마지막에는 라이라네 집 아래에 있는,\n동네 공원에서 발을 멈췄다."


translate japanese plotexternal_e635fa22:


    nvlNone "해가 막 떠오른 참이라,\n주위에는 아직 서늘하고 상쾌한 아침 공기가 남아 있었다."


translate japanese plotexternal_52956570:


    nvlNone "이곳 공원은 우리 집 근처 공원과는 다르다."


translate japanese plotexternal_7432dc0f:


    nvlNone "운동하는 사람은 거의 보이지 않고,{p}길에는 지하철역으로 서두르는 직장인이 더 많았다."


translate japanese plotexternal_ee3f61d6:


    nvlNone "휴대폰을 꺼내 보니 채팅창 맨 아래 메시지에는 여전히 읽음 표시가 없었다."


translate japanese plotexternal_fc3afe81_1:



    voice "voice/yangxi_1078.ogg"
    nvlNone "「하아……」"


translate japanese plotexternal_1079865a:


    nvlNone "벤치 등받이에 몸을 기대고 잠시 망설였다."


translate japanese plotexternal_a3bac473:


    nvlNone "지금 당장 라이라에게 가도 문제는 없지만, 이렇게 일찍 찾아가고 싶지는 않았다."


translate japanese plotexternal_5c05682b:


    nvlNone "또 무의식적으로 주머니를 더듬어 여러 맛이 뒤섞인 막대사탕을 하나 꺼냈다."


translate japanese plotexternal_bf6a0c8b:


    nvlNone "신맛, 단맛, 짠맛, 매운맛. 강렬하게 어긋나는 네 가지 맛이 한꺼번에 입안 가득 퍼졌다."


translate japanese plotexternal_229c6038:


    nvlNone "마음을 단단히 먹고 여행 가방을\n끌어 목적지에 도착했다."


translate japanese plotexternal_1ae69c7f_5:


    voice "voice/yangxi_1079.ogg"
    nvlNone "「……」"


translate japanese plotexternal_f5407b0b:


    nvlNone "문 앞에 서서 숨을 깊게 들이마셨다."


translate japanese plotexternal_f4d9c3d7:


    nvlNone "그리고 초인종을 눌렀다."


translate japanese plotexternal_8f422523_1:


    nvlNone "……"


translate japanese plotexternal_ff0069a9:


    nvlNone "딩동, 딩동――!"


translate japanese plotexternal_7ac3e51f:


    nvlNone "딩동, 딩동――!"


translate japanese plotexternal_b26c5352:


    nvlNone "딩동딩동딩동\n딩동딩동딩동――!"


translate japanese plotexternal_637fb8c3:



    voice "voice/tianqin_2777.ogg"
    nvlNone "「네네, 나가요~!!!!」"


translate japanese plotexternal_84a9e364:


    nvlNone "철컥—"


translate japanese plotexternal_c2d4c543:


    nvlNone "침대에서 벌떡 일어나 문을 열러 나온 라이라는 아직도 잠이 덜 깬 얼굴이었다."


translate japanese plotexternal_efdec148:



    voice "voice/yangxi_1080.ogg"
    nvlNone "「이제야 일어났어?」"


translate japanese plotexternal_7feac840:



    voice "voice/yangxi_1081.ogg"
    nvlNone "「지하철에서 사람들한테 치이기 싫어서.」"


translate japanese plotexternal_3aca5e8f:



    voice "voice/yangxi_1082.ogg"
    nvlNone "「이쪽 역은 우리 동네보다 훨씬 붐비더라.」"


translate japanese plotexternal_048627fe:



    voice "voice/tianqin_2779.ogg"
    nvlNone "「아하하~, 어쩔 수 없지. 이쪽 지하철은 출퇴근 노선이거든.」"


translate japanese plotexternal_b7d14d8a:


    nvlNone "여행 가방을 끌고 안으로 들어갔다. 방 안에는 익숙한 냄새가 가득했다."


translate japanese plotexternal_a405d26d:



    voice "voice/tianqin_2781.ogg"
    nvlNone "「음……?」"


translate japanese plotexternal_14b06e07:


    nvlNone "망했다."


translate japanese plotexternal_671fdbab:


    nvlNone "그 순간 오늘 있었던 일이 주마등처럼 머릿속을 한꺼번에 스쳐 갔다."


translate japanese plotexternal_3cb9f6e3:


    nvlNone "어젯밤부터 오늘 아침까지 필사적으로 숨겨 왔던 일."


translate japanese plotexternal_caa9255c:


    nvlNone "어디서 눈치챈 거지?"


translate japanese plotexternal_f2bfea80:


    nvlNone "냄새가 남아 있었나? 어디에?"


translate japanese plotexternal_268133e4:



    voice "voice/tianqin_2782.ogg"
    nvlNone "「아침 먹을래?」"


translate japanese plotexternal_9b916e9a:



    voice "voice/yangxi_1084.ogg"
    nvlNone "「아니…… 더 자도 돼. 난 짐 정리할 테니까.」"


translate japanese plotexternal_8952390f:



    voice "voice/tianqin_2783.ogg"
    nvlNone "「그래? 옷은 빈 선반에 넣으면 돼.」"


translate japanese plotexternal_e00ed59b:



    voice "voice/yangxi_1085.ogg"
    nvlNone "「가져온 옷이 모자라고 생필품도 아직 못 샀으니까 일단 네 것 좀 빌릴게.」"


translate japanese plotexternal_2cef820c:



    voice "voice/tianqin_2785.ogg"
    nvlNone "「그럼 나 다시 잘게~. 쿨쿨……」"


translate japanese plotexternal_fc3afe81_2:



    voice "voice/yangxi_1086.ogg"
    nvlNone "「하아……」"


translate japanese plotexternal_fe7568e9:


    nvlNone "나는 또 한숨을 쉬었다."


translate japanese plotexternal_4e3bdaba:


    nvlNone "이걸로 넘어간…… 건가?"


translate japanese plotexternal_27ba532e:


    nvlNone "고개를 저으며 그 어리석은 생각을 단호히 부정했다."


translate japanese plotexternal_86e2859e:



    voice "voice/yangxi_1087.ogg"
    nvlNone "「젠장……」"


translate japanese plotexternal_808bc16b:


    nvlNone "어젯밤의 바보 같은 짓을 작은 목소리로 욕했다."


translate japanese plotexternal_09a06e19:


    nvlNone "치이이——"


translate japanese plotexternal_9fa4f3db:


    nvlNone "뜨거운 기름이 프라이팬 안에서 끓어오르듯 보글거렸고,\n곧 달걀흰자가 익는 고소한 냄새가 풍겨 왔다."


translate japanese plotexternal_d1c4c13d:


    nvlNone "라이라가 부엌에서 아점을 만들고 있다."


translate japanese plotexternal_8ea27f5b:


    nvlNone "그녀는 프라이팬을 보고 있었다."


translate japanese plotexternal_c0dd7b76:


    nvlNone "라이라가 완전히 잠에서 깼을 때는 벌써 10시였다."


translate japanese plotexternal_d6c56837:


    nvlNone "오늘은 평일이다. 우리는 아주 자연스럽게 학교를 땡땡이쳤다."


translate japanese plotexternal_35c37c77:


    nvlNone "「네 이사 축하라는 걸로 할까?」{p}라이라는 그렇게 말했다." (callback=nvl_page_voice, cb_page_voices=('voice/tianqin_2786.ogg', None))


translate japanese plotexternal_c8182eb9:


    nvlNone "학교를 땡땡이칠 때마다 그녀는 매번 억지로 이유를 짜낸다."


translate japanese plotexternal_f38561a4:


    nvlNone "「짜잔!」"


translate japanese plotexternal_f4a76bce:


    nvlNone "잠시 후,\n라이라가 완성된 음식을 큰 접시에 담아 거실로 가져왔다."


translate japanese plotexternal_1e9539b3:


    nvlNone "쿵——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plotexternal_ec21b571:


    nvlNone "큰 접시는 거대한 바위 같은 무게로 식탁에 쿵 하고 놓였다."


translate japanese plotexternal_17cb74a8:


    nvlNone "目に入ったのは、山のように積まれた目玉焼きとベーコン。"


translate japanese plotexternal_4514408f:


    nvlNone "이젠 익숙해서 딴죽 걸기도 귀찮았다. 시키기도 전에 부엌으로 식기를 가지러 갔다."


translate japanese plotexternal_69684c54:


    nvlNone "밥솥 안에는,\n토마토소스를 넣고 구워 낸 파스타도 들어 있었다. 이게 주식이라는 거다."


translate japanese plotexternal_29ca25eb:


    nvlNone "이것도 고향 음식에 대한 모독이라고 생각한다."


translate japanese plotexternal_763d1b88:


    nvlNone "파스타를 접시에 조금 덜자,\n진한 토마토소스 향이 코를 간질였다."


translate japanese plotexternal_e899eb7e:


    nvlNone "평소의 나라면 이 정도로 끝낼 리 없다."


translate japanese plotexternal_6347f38e:


    nvlNone "그녀가 갑자기 뭔가 물어볼까 봐 무섭다."


translate japanese plotexternal_e0500e51:


    nvlNone "おそるおそる椅子を引き、食卓についた。"


translate japanese plotexternal_8e355a03:



    voice "voice/tianqin_2789.ogg"
    nvlNone "「히나타……」"


translate japanese plotexternal_2e0112e4:


    voice "voice/yangxi_1088.ogg"
    nvlNone "「――！」"


translate japanese plotexternal_82cf0f28:



    voice "voice/tianqin_2790.ogg"
    nvlNone "「오늘은 조금밖에 안 먹네?」"


translate japanese plotexternal_94cae7dc:



    voice "voice/yangxi_1090.ogg"
    nvlNone "「오늘은 입맛이 없어서 조금이면 돼.」"


translate japanese plotexternal_dad84b17:



    voice "voice/tianqin_2791.ogg"
    nvlNone "「어? 어디 아파?」"


translate japanese plotexternal_e9ecdc9a:



    voice "voice/yangxi_1091.ogg"
    nvlNone "「조금.」"


translate japanese plotexternal_6a1afd06:



    voice "voice/tianqin_2792.ogg"
    nvlNone "「약 먹을래? 우리 집에 있는데.」"


translate japanese plotexternal_e13c7ce1:



    voice "voice/yangxi_1092.ogg"
    nvlNone "「됐어. 별거 아니야.」"


translate japanese plotexternal_9c2f4513:


    voice "voice/tianqin_2793.ogg"
    nvlNone "「그렇구나~.」{p}라이라는 그렇게 대답했다." (callback=nvl_page_voice, cb_page_voices=('voice/tianqin_2793.ogg', None))


translate japanese plotexternal_ebbc7b10:


    nvlNone "넘어간 건가……?"


translate japanese plotexternal_b667b3c4:


    nvlNone "또 그런 생각이 떠올랐다."


translate japanese plotexternal_6be92085:


    nvlNone "하지만 곧바로 지워 버렸다."


translate japanese plotexternal_ba56c5df:



    voice "voice/tianqin_2794.ogg"
    nvlNone "「왜 그래? 아까부터 계속 딴생각하네.」"


translate japanese plotexternal_d15ae037:



    voice "voice/yangxi_1093.ogg"
    nvlNone "「아무것도 아니야.」"


translate japanese plotexternal_4a4e0c8f:



    voice "voice/yangxi_1094.ogg"
    nvlNone "「너도 계속 휴대폰만 보면서 그런 말이 나와?」"


translate japanese plotexternal_0d3713d0:



    voice "voice/tianqin_2795.ogg"
    nvlNone "「아니야. 내가 보던 건 이거야.」"


translate japanese plotexternal_2cba71f2:



    voice "voice/yangxi_1095.ogg"
    nvlNone "「룽화 마트 회원의 날……?」"


translate japanese plotexternal_e4c241e1:



    voice "voice/tianqin_2796.ogg"
    nvlNone "「맞아! 매주 목요일은 할인하거든!」"


translate japanese plotexternal_fc29aa41:



    voice "voice/yangxi_1096.ogg"
    nvlNone "「그게 어디 있는데?」"


translate japanese plotexternal_3052b3c3:


    nvlNone "이곳으로 오던 길을 떠올렸다.\n그러고 보니 이 근처에 마트가 있었던 것 같다."


translate japanese plotexternal_e7339c36:



    voice "voice/yangxi_1097.ogg"
    nvlNone "「응…… 있었던 것 같아. 그래서?」"


translate japanese plotexternal_c270a480:


    nvlNone "후회했다."


translate japanese plotexternal_8fc14860:


    nvlNone "그렇게 쉽게 알겠다고 하는 게 아니었다."


translate japanese plotexternal_0621c499:


    nvlNone "마트 회원의 날이면 반드시 따라오는 게 있다……"


translate japanese plotexternal_4be23703:




    nvlNone "사람."


translate japanese plotexternal_894e6a97:


    nvlNone "나와 라이라는 카트를 밀고 있었지만,\n마음대로 앞으로도 뒤로도 움직일 수 없었다."


translate japanese plotexternal_a97d6c74:


    nvlNone "앞도 사람, 뒤도 사람, 좌우도 온통 사람."


translate japanese plotexternal_7411a6b0:


    nvlNone "「으으으――!」"


translate japanese plotexternal_0bfcbc17:



    voice "voice/tianqin_2799.ogg"
    nvlNone "「죄송해요! 잠깐만 지나갈게요!」"


translate japanese plotexternal_6c37908a:



    voice "voice/tianqin_2800.ogg"
    nvlNone "「이것 좀 집을게요!」"


translate japanese plotexternal_9f32d9d4:



    voice "voice/tianqin_2801.ogg"
    nvlNone "「저기요~, 그것 좀 집어 주시겠어요?」"


translate japanese plotexternal_a925ba50:



    voice "voice/tianqin_2802.ogg"
    nvlNone "「괜찮아, 히나타?」"


translate japanese plotexternal_50746441:



    voice "voice/yangxi_1099.ogg"
    nvlNone "「괘, 괜찮아…… 아마도.」"


translate japanese plotexternal_16427169:


    nvlNone "라이라가 가리킨 쪽을 봤다.\n반값으로 할인 중인 병에 든 칠리소스였다."


translate japanese plotexternal_ca0147a8:



    voice "voice/yangxi_1100.ogg"
    nvlNone "「으앗――!」"


translate japanese plotexternal_597fe5ea:


    nvlNone "그때 라이라가 팔꿈치로 밀려오는 카트를 막았다."


translate japanese plotexternal_3f48623d:



    voice "voice/yangxi_1101.ogg"
    nvlNone "「좋아, 집었다.」"


translate japanese plotexternal_d3fb8deb:


    nvlNone "손에 넣은 칠리소스를 재빨리 카트에 담자,{p}뒤에서는 벌써 투덜거리는 소리가 들렸다."


translate japanese plotexternal_ea6f93ce:


    nvlNone "私がカートを押して後ろと距離を取ってから、ライラはようやく手を離した。"


translate japanese plotexternal_e943782c_2:



    voice "voice/gt_14.ogg"
    nvlNone "「후——」"


translate japanese plotexternal_8fbf6091:


    nvlNone "계산을 마친 우리는 각자 전리품이 든 커다란 봉투를 안고 휴게 공간에 앉았다."


translate japanese plotexternal_65d186cc:


    nvlNone "라이라는 산 물건들을 확인하고 있었다.\n안에는 과일과 신선식품, 생필품뿐이었다."


translate japanese plotexternal_acf1073a:



    voice "voice/tianqin_2807.ogg"
    nvlNone "「어때? 마트를 느긋하게 둘러보는 거, 재미있지?」"


translate japanese plotexternal_dc8cbca8:



    voice "voice/yangxi_1103.ogg"
    nvlNone "「이게 어딜 봐서 『느긋하게』라는 거야……」"


translate japanese plotexternal_4c4c66a0:



    voice "voice/tianqin_2808.ogg"
    nvlNone "나는 꽤 사람 사는 느낌이 나서 좋은데."


translate japanese plotexternal_564c6399:


    nvlNone "어이가 없어서 웃음이 났다. 마트 전체가 사람들로 꽉 차 있었다."


translate japanese plotexternal_e38fdda0:


    nvlNone "여기 손님들에게 양보 따위는 기대하면 안 된다.{p}카트를 밀며 앞사람에게 계속 부딪쳐 가면서 나아갈 뿐이다."


translate japanese plotexternal_62b7df95:


    nvlNone "라이라가 지켜 주지 않았다면 아무것도 집지 못했을 것 같다."


translate japanese plotexternal_13cf0b24:



    voice "voice/tianqin_2809.ogg"
    nvlNone "「좋아, 필요한 건 다 샀으니까 돌아갈까?」"


translate japanese plotexternal_a90be9c7:


    nvlNone "잠시 후 라이라는 겨우 전리품을 전부 확인했다."


translate japanese plotexternal_28dbb066:



    voice "voice/yangxi_1105.ogg"
    nvlNone "「드디어……」"


translate japanese plotexternal_58117554:



    voice "voice/tianqin_2810.ogg"
    nvlNone "「앞으로 자주 오게 될 거야. 조금씩 익숙해지자~.」"


translate japanese plotexternal_4c3a3a2f:


    nvlNone "오후 내내 시달린 덕분에 어젯밤 일은 머릿속에서 사라져 있었다."


translate japanese plotexternal_ab003d8a:


    nvlNone "하지만 집으로 돌아오자 그 감각이 다시 가슴속에 퍼지기 시작했다."


translate japanese plotexternal_e64442b3:


    nvlNone "설마 저 녀석 일부러 이러는 건가?"


translate japanese plotexternal_3b11d631:


    nvlNone "일부러 아무 말도 안 하고,\n내가 혼자 고민하다 지치기를 기다리는 거야."


translate japanese plotexternal_8e86f83e:



    voice "voice/tianqin_2811.ogg"
    nvlNone "「……히나……」"


translate japanese plotexternal_affa1fb8:



    voice "voice/tianqin_2812.ogg"
    nvlNone "「히나타!」"


translate japanese plotexternal_28476fd0:



    voice "voice/yangxi_1107.ogg"
    nvlNone "「아, 응? 왜?」"


translate japanese plotexternal_5f1eff48:



    voice "voice/tianqin_2813.ogg"
    nvlNone "「몇 번이나 불렀어. 밥 다 됐다고.」"


translate japanese plotexternal_e478bdee:


    nvlNone "저녁은 당연히 오후에 마트에서 사 온 재료로 만든 음식이었다."


translate japanese plotexternal_419cb35a:


    nvlNone "마트 회원의 날이란 게 결국\n평소에 안 팔리는 물건을 깎아서 처분하는 것뿐이다."


translate japanese plotexternal_facfbac2:


    nvlNone "그래서 오늘 산 할인 상품도 대부분 팔다 남은 냉동식품이었다."


translate japanese plotexternal_e4e85972:


    nvlNone "하지만 라이라는 요리를 잘한다."


translate japanese plotexternal_1ae69c7f_6:


    voice "voice/yangxi_1109.ogg"
    nvlNone "「……」"


translate japanese plotexternal_51e5c0a6:


    nvlNone "그런데도 나는 생각에 잠겨 음식에 손을 대지 않았다."


translate japanese plotexternal_18992e50:


    nvlNone "먹는 척하며 젓가락으로 접시 안의 음식을 뒤적일 뿐."


translate japanese plotexternal_b85fc6e2:



    voice "voice/tianqin_2814.ogg"
    nvlNone "「히나타~!」"


translate japanese plotexternal_7cf8e719:



    voice "voice/yangxi_1110.ogg"
    nvlNone "「왜?」"


translate japanese plotexternal_28a5006b:



    voice "voice/tianqin_2815.ogg"
    nvlNone "「빨리 안 먹으면 식는다?」"


translate japanese plotexternal_d34e5b41:


    nvlNone "명령을 받은 나는 무언가 한 조각을 집어,\n제대로 보지도 않고 입에 넣었다."


translate japanese plotexternal_f5bcab45:




    nvlNone "맛있다."


translate japanese plotexternal_ece60869:


    nvlNone "아마 냉동 포크스테이크를 구운 거겠지.{p}라이라가 솜씨를 부린 덕분인지 냉동식품 느낌은 전혀 남아 있지 않았다."


translate japanese plotexternal_c8fe1158:


    nvlNone "소스의 간도 딱 좋다. 기름지거나,\n느끼하지 않고, 은은한 매운맛에 자꾸 손이 간다."


translate japanese plotexternal_a5f30b7b:


    nvlNone "평소 라이라가 먹는 음식은 간이 세다.{p}이건 나한테 맞춰 싱겁게 만들어 준 것이다."


translate japanese plotexternal_1b98f4b4:



    voice "voice/yangxi_1112.ogg"
    nvlNone "「……이거 맛있네.」"


translate japanese plotexternal_71e66dfc:


    nvlNone "「그렇지, 그렇지! 마트에서 봤을 때 꽤 맛있어 보였거든.」"


translate japanese plotexternal_cffc448e:



    voice "voice/yangxi_1113.ogg"
    nvlNone "「난 이제 그런 마트에서 치이고 싶지 않아.」"


translate japanese plotexternal_d7f34e56:


    nvlNone "거짓말이다. 할인 날이면 언제든 그만큼 붐빌 게 뻔하다."


translate japanese plotexternal_dcb8af9b:


    nvlNone "この辺りの住民構成を考えると、退職した人が多い。"


translate japanese plotexternal_b29f79de:


    nvlNone "그러니까 마트 할인 날은 저 사람들에게 꽤 매력적인 것이다."


translate japanese plotexternal_ac655a14:


    nvlNone "게다가 아까 마트에서 만난 매너 없는 손님들도,\n대부분 그런 사람들이었다."


translate japanese plotexternal_cb413c26:


    voice "voice/yangxi_1114.ogg"
    nvlNone "「잘 먹었어.」{p}식기를 치우며 말했다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1114.ogg', None))


translate japanese plotexternal_4b359c38:



    voice "voice/tianqin_2819.ogg"
    nvlNone "「뭐!? 오늘 거의 안 먹었잖아!」"


translate japanese plotexternal_0668f825:



    voice "voice/yangxi_1115.ogg"
    nvlNone "「오늘은 입맛이 없어서.」"


translate japanese plotexternal_caf4d57b:



    voice "voice/tianqin_2820.ogg"
    nvlNone "「몸은 괜찮아? 아직 안 좋아?」"


translate japanese plotexternal_fc3afe81_3:



    voice "voice/yangxi_1117.ogg"
    nvlNone "「하아……」"


translate japanese plotexternal_16caf0f7:


    nvlNone "보글보글보글……"


translate japanese plotexternal_604704c6:


    nvlNone "욕조에 온몸을 담근 채 할 일 없이 보글보글 거품을 불었다."


translate japanese plotexternal_42df59cd:


    nvlNone "역시 먼저 털어놓아야 할지도 모른다."


translate japanese plotexternal_e018a46a:


    nvlNone "라이라는 정말 눈감아 준 걸지도 모른다.\n애써 숨기는 걸 굳이 들추려 하지 않았겠지."


translate japanese plotexternal_02b4f9cb:


    nvlNone "하지만…… 이런 비밀은 분명 우리 사이에 금을 낼 것이다."


translate japanese plotexternal_48a4cdf9:



    voice "voice/yangxi_1118.ogg"
    nvlNone "「좋아.」"


translate japanese plotexternal_e2c8ecdd:


    nvlNone "각오를 다진 듯 욕조 안에서 벌떡 일어섰다."


translate japanese plotexternal_4dae0b17:



    voice "voice/tianqin_2821.ogg"
    nvlNone "「들어갈게~.」"


translate japanese plotexternal_84c9bac1:



    voice "voice/yangxi_1119.ogg"
    nvlNone "「으앗!」"


translate japanese plotexternal_4d4e409d:


    nvlNone "라이라의 기습에 당황해 무릎을 끌어안고 욕조 구석에 웅크렸다."


translate japanese plotexternal_24cd4a69:



    voice "voice/yangxi_1120.ogg"
    nvlNone "「갑자기 들어오지 마.」"


translate japanese plotexternal_a6848ba3:


    nvlNone "라이라는 욕조 안에서 몸을 웅크린 나를 바라봤다.{p}「왜 그래? 이제 와서 부끄러워졌어?」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/tianqin_2823.ogg'))


translate japanese plotexternal_45d82af9:



    voice "voice/yangxi_1121.ogg"
    nvlNone "「갑자기 들어오면 곤란하거든.」"


translate japanese plotexternal_9285028d:



    voice "voice/yangxi_1122.ogg"
    nvlNone "「야, 잠깐, 욕조에 들어오지 마! 아직 씻지도 않았잖아!」"


translate japanese plotexternal_2cf56536:


    nvlNone ""


translate japanese plotexternal_a316e9c2:



    voice "voice/tianqin_2825.ogg"
    nvlNone "「후우~, 천국이네, 천국이야~.」"


translate japanese plotexternal_df9c7f27:



    voice "voice/yangxi_1123.ogg"
    nvlNone "「……」" (**end_page())


translate japanese plotexternal_96f57d7e:



    voice "voice/tianqin_2826.ogg"
    nvl_tianqin_dialogue "있잖아, 뭐 때문에 삐졌어?" (**end_page())


translate japanese plotexternal_b37ebc79:



    voice "voice/yangxi_1124.ogg"
    nvl_yangxi "안 삐졌어." (**end_page())


translate japanese plotexternal_e0016bef:



    voice "voice/tianqin_2827.ogg"
    nvl_tianqin_dialogue "거짓말." (**end_page())


translate japanese plotexternal_15374499:


    nvlNone "찍――"


translate japanese plotexternal_48f6daac:



    voice "voice/yangxi_1125.ogg"
    nvl_yangxi "억!"


translate japanese plotexternal_6db46ea6:


    nvlNone "라이라는 두 손을 모아 손바닥에 물을 담더니, 손가락 틈으로 내 얼굴을 향해 찍 뿜어냈다." (**end_page())


translate japanese plotexternal_93d44f9b:



    nvl clear
    voice "voice/yangxi_1126.ogg"
    nvl_yangxi "이게―― 받아라!"


translate japanese plotexternal_738c62a3:


    nvlNone "나도 질세라 두 손을 모아 그녀를 향해 물을 찍 뿜어냈다." (**end_page())


translate japanese plotexternal_772dafe0:



    voice "voice/tianqin_2828.ogg"
    nvl_tianqin_dialogue "크윽――!" (**end_page())


translate japanese plotexternal_f601a351:


    nvl_tianqin_dialogue "――받아라!" (**end_page())


translate japanese plotexternal_3cc2fc05:


    nvlNone "평범한 목욕이 어느새 물총 싸움으로 변해 있었다." (**end_page())


translate japanese plotexternal_39f39b1d:


    nvlNone "원래도 얼마 없던 욕조의 물을 서로에게 쏘아 대며,\n더 줄여 나갔다." (**end_page())


translate japanese plotexternal_bac5273f:



    voice "voice/tianqin_2830.ogg"
    nvl_tianqin_dialogue "앗! 알았어, 알았어.\n이제 그만."


translate japanese plotexternal_08d3054c:


    "ライラが操作パネルの足し湯ボタンを押す。給湯口から熱い湯が流れ、半分にも満たない浴槽を満たしていった。"


translate japanese plotexternal_fcd9e316:



    voice "voice/yangxi_1127.ogg"
    nvl_yangxi "……라이라."


translate japanese plotexternal_f0e2e7e7:



    voice "voice/tianqin_2831.ogg"
    nvl_tianqin_dialogue "응?"


translate japanese plotexternal_e4d6ecc7:



    voice "voice/yangxi_1128.ogg"
    nvl_yangxi "저기, 나……"


translate japanese plotexternal_a217e2f4:



    voice "voice/yangxi_1129.ogg"
    nvl_yangxi "――어젯밤에 담배 피웠어." (**end_page())


translate japanese plotexternal_ea1039f6:



    voice "voice/tianqin_2832.ogg"
    nvl_tianqin_dialogue "어?"


translate japanese plotexternal_4eec0d15:



    voice "voice/yangxi_1130.ogg"
    nvl_yangxi "어?"


translate japanese plotexternal_1362ed78:



    voice "voice/tianqin_2833.ogg"
    nvl_tianqin_dialogue "자, 잠깐만……"


translate japanese plotexternal_a3f0dcab:



    voice "voice/tianqin_2834.ogg"
    nvl_tianqin_dialogue "오늘 하루 종일 고민하던 게 그거였어?" (**end_page())


translate japanese plotexternal_8f2cbfa8:



    nvl clear
    voice "voice/yangxi_1131.ogg"
    nvl_yangxi "……몰랐어?"


translate japanese plotexternal_7a9924c6:



    voice "voice/tianqin_2835.ogg"
    nvl_tianqin_dialogue "아니, 나는…… 아~!"


translate japanese plotexternal_8fb7456f:



    voice "voice/tianqin_2836.ogg"
    nvl_tianqin_dialogue "아침에 왜 이렇게 보디워시 냄새가\n진한가 했지!" (**end_page())


translate japanese plotexternal_442941ca:


    nvl clear
    nvlNone "……"


translate japanese plotexternal_eaef1e93:


    "あの時、反応したのはこっちの匂いだったのか！"


translate japanese plotexternal_442941ca_1:


    nvlNone "……"


translate japanese plotexternal_6b01fd65:



    voice "voice/yangxi_1132.ogg"
    nvl_yangxi "……방금 말 취소." (**end_page())


translate japanese plotexternal_d6e4f43d:



    nvl clear
    voice "voice/tianqin_2837.ogg"
    nvl_tianqin_dialogue "안 돼! 어젯밤에\n담배 피웠다며!"


translate japanese plotexternal_b9217db6:



    voice "voice/yangxi_1133.ogg"
    nvl_yangxi "안 피웠어."


translate japanese plotexternal_063d04d3:



    voice "voice/tianqin_2838.ogg"
    nvl_tianqin_dialogue "방금 말했잖아!" (**end_page())
    nvl clear


translate japanese plotexternal_ceccf205:



    voice "voice/yangxi_1134.ogg"
    nvl_yangxi "취소했어."


translate japanese plotexternal_d293c452:



    voice "voice/tianqin_2839.ogg"
    nvl_tianqin_dialogue "그럼\n피웠다는 거잖아!"


translate japanese plotexternal_7e7ac55c:



    voice "voice/yangxi_1135.ogg"
    nvl_yangxi "윽……" (**end_page())


translate japanese plotexternal_2b8c4f47:



    voice "voice/tianqin_2840.ogg"
    nvl_tianqin_dialogue "왜?" (**end_page())


translate japanese plotexternal_1135dee7:



    voice "voice/yangxi_1136.ogg"
    nvl_yangxi "그냥…… 어쩌다 보니." (**end_page())


translate japanese plotexternal_b4e3c80f:



    nvl clear
    voice "voice/tianqin_2841.ogg"
    nvl_tianqin_dialogue "담배는 내가 다 압수했잖아?"


translate japanese plotexternal_c6519f2b:



    voice "voice/yangxi_1137.ogg"
    nvl_yangxi "어젯밤에 옷 정리하다가 옷 사이에 담배 한 개비가 끼어 있는 걸 발견했어."


translate japanese plotexternal_fc30a976:



    voice "voice/yangxi_1138.ogg"
    nvl_yangxi "그래서, 그……" (**end_page())


translate japanese plotexternal_71e08e60:



    voice "voice/tianqin_2842.ogg"
    nvl_tianqin_dialogue "……"


translate japanese plotexternal_e6855e63:



    voice "voice/yangxi_1139.ogg"
    nvl_yangxi "마지막 한 개비야. 정말로."


translate japanese plotexternal_5a934b5e:


    nvlNone "나 자신도 믿을 수 없는 거짓말이다."


translate japanese plotexternal_0d86e42c:


    nvlNone "이런 「어쩌다 보니」가 언제 또 갑자기 찾아올지 모른다." (**end_page())


translate japanese plotexternal_aec75f65:



    voice "voice/tianqin_2843.ogg"
    nvl_tianqin_dialogue "마지막일 리 없잖아!\n나 몰래 숨어서 피우는 거지! 흥!" (**end_page())


translate japanese plotexternal_19d0a651:


    nvlNone "라이라는 물속에서 발끝으로 나를 가볍게 찼다."


translate japanese plotexternal_43304a6c:



    voice "voice/yangxi_1140.ogg"
    nvl_yangxi "안 피웠어! 약속할게!" (**end_page())


translate japanese plotexternal_33ecb4de:



    nvl clear
    voice "voice/tianqin_2844.ogg"
    nvl_tianqin_dialogue "정말?"


translate japanese plotexternal_cf40e210:



    voice "voice/yangxi_1141.ogg"
    nvl_yangxi "정말."


translate japanese plotexternal_127d5fec:



    voice "voice/tianqin_2845.ogg"
    nvl_tianqin_dialogue "흐음? 그럼,\n됐지만." (**end_page())
    nvl clear


translate japanese plotexternal_b5bf0909:



    voice "voice/tianqin_2846.ogg"
    nvl_tianqin_dialogue "다음엔 절대 안 돼!"


translate japanese plotexternal_0586323a:



    voice "voice/yangxi_1142.ogg"
    nvl_yangxi "응." (**end_page())


translate japanese plotexternal_c22745c5:



    voice "voice/tianqin_2847.ogg"
    nvl_tianqin_dialogue "갑자기 왜 나한테\n말할 생각이 든 거야?"


translate japanese plotexternal_f50c88e4:



    voice "voice/tianqin_2848.ogg"
    nvl_tianqin_dialogue "아무 말 안 했으면 그냥 넘어갔을 텐데." (**end_page())


translate japanese plotexternal_8489e040:



    voice "voice/yangxi_1143.ogg"
    nvl_yangxi "뭐라고 해야 할까……"


translate japanese plotexternal_c96a712b:



    voice "voice/yangxi_1144.ogg"
    nvl_yangxi "아무 말도 안 하면 계속 마음에 걸릴 테니까."


translate japanese plotexternal_5c636ef2:



    voice "voice/yangxi_1145.ogg"
    nvl_yangxi "우리가 앞으로도\n함께 있고 싶다면……" (**end_page())


translate japanese plotexternal_cca0fb4a:



    voice "voice/tianqin_2849.ogg"
    nvl_tianqin_dialogue "바보." (**end_page())


translate japanese plotexternal_9b7eed4e:


    nvl_tianqin_dialogue "에잇――!"


translate japanese plotexternal_c6edff12:



    voice "voice/yangxi_1146.ogg"
    nvl_yangxi "으앗! 마음을 담아서 말하려는데 물 뿌리지 마!" (**end_page())


translate japanese plotexternal_8f422523_2:


    nvlNone "……"


translate japanese plotexternal_6bfaa767:


    nvlNone "눈을 뜨자,\n조금 낯선 천장이 보였다."


translate japanese plotexternal_0f98f891:


    nvlNone "하지만 언젠가는 익숙해지겠지."


translate japanese plotexternal_a5f88575:


    nvlNone "「하아, 피곤해…… 몸이 무거워……」{p}온몸에 말로 표현하기 어려운 피로감이 감돌았다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1147.ogg', None))


translate japanese plotexternal_9d9a1ba2:



    voice "voice/yangxi_1148.ogg"
    nvlNone "「벌써 10시네……」"


translate japanese plotexternal_829f0d0e:


    nvlNone "아홉 시간 가까이 잤는데도\n아직 부족한 기분이다."


translate japanese plotexternal_4e622ef5:


    nvlNone "자정을 넘겨 잠드는 건 나한테는 상당히 늦게까지 깨어 있는 셈이다."


translate japanese plotexternal_aea9428f:


    nvlNone "고개를 흔들어 봐도 계속 머리가 울렸다."


translate japanese plotexternal_c1b209af:



    voice "voice/yangxi_1149.ogg"
    nvlNone "「이 녀석 잠버릇은 여전히 최악이네.」"


translate japanese plotexternal_d280393f:


    nvlNone "어젯밤에 내 얼굴에서 이 녀석의 손을 몇 번이나 치웠는지 셀 수도 없다."


translate japanese plotexternal_994d0158:



    voice "voice/yangxi_1150.ogg"
    nvlNone "「……일어나자.」"


translate japanese plotexternal_8a32c8a9:


    nvlNone "침대 위에서 몸을 일으켰다."


translate japanese plotexternal_01738324:


    nvlNone "이 방도 이 침대도 나를 안심시키는 냄새가 났다."


translate japanese plotexternal_7f9e7dc2:


    nvlNone "평소 그녀에게 가까이 다가갈 때면 문득 맡을 수 있는 냄새다."


translate japanese plotexternal_6c06bce9:


    nvlNone "이렇게 말하면 기분 나쁠 수도 있지만, 나는 그녀의 냄새를 좋아했다."


translate japanese plotexternal_c1522249:


    nvlNone "희미한 땀 냄새와, 값싼 화장품인지 다른 무엇인지 알 수 없는 향."


translate japanese plotexternal_829cadb2:


    nvlNone "그 모든 것이 뒤섞인 냄새."


translate japanese plotexternal_963a1673:



    voice "voice/yangxi_1151.ogg"
    nvlNone "「칫――!」"


translate japanese plotexternal_c3967cae:


    nvlNone "왼쪽 눈에 날카로운 통증이 일었다."


translate japanese plotexternal_46fbd59b:


    nvlNone ""


translate japanese plotexternal_6d560d26:



    voice "voice/tianqin_2851.ogg"
    nvlNone "「후아암……」"


translate japanese plotexternal_408ceba7:


    nvlNone "라이라가 뒤척이며, 이쪽으로 몸을 돌렸다."


translate japanese plotexternal_f09f916f:


    nvlNone "眠そうな顔を見る限り、まだしばらく寝るつもりだろう。"


translate japanese plotexternal_2241683b:



    voice "voice/yangxi_1153.ogg"
    nvlNone "「일어났어?」"


translate japanese plotexternal_d187ecb7:


    nvlNone "라이라는 눈을 가늘게 뜨고 나를 봤다. 당장이라도 다시 잠들 것 같았다."


translate japanese plotexternal_ba61ac9d:


    nvlNone "그런데 갑자기 눈을 크게 떴다.{p}「으, 응? 눈 왜 그래?」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/tianqin_2853.ogg'))


translate japanese plotexternal_3559ce00:



    voice "voice/yangxi_1154.ogg"
    nvlNone "「응, 아무것도 아니야.」"


translate japanese plotexternal_7c7789fd:


    voice "voice/yangxi_1155.ogg"
    nvlNone "「가벼운 알레르기야. 별거 아니야.」{p}더는 이 얘기를 하고 싶지 않아 서둘러 침대에서 내려왔다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1155.ogg', None))


translate japanese plotexternal_03861093:



    voice "voice/tianqin_2855.ogg"
    nvlNone "「뭐어? 지금 병원에 가서 진찰받아 보자.」"


translate japanese plotexternal_ababeda3:


    nvlNone "라이라는 침대에서 벌떡 튀어 일어났다."


translate japanese plotexternal_0faa35ed:


    nvlNone "한숨을 쉬었다."


translate japanese plotexternal_54a8d2d2:


    nvlNone "이런 일로 걱정시키고 싶지 않았는데 오히려 역효과가 났다."


translate japanese plotexternal_f3089fb6:



    voice "voice/tianqin_2857.ogg"
    nvlNone "「어때? 좀 나아졌어?」"


translate japanese plotexternal_ff7955f2:



    voice "voice/yangxi_1158.ogg"
    nvlNone "「방금 먹었는데 그렇게 빨리 들을 리가 없잖아.」"


translate japanese plotexternal_d1381662:



    voice "voice/yangxi_1159.ogg"
    nvlNone "「……미안해.」"


translate japanese plotexternal_0b90fcbe:


    nvlNone "아침부터 분주하게 만들어 조금 미안했다."


translate japanese plotexternal_f4ff7b0c:



    voice "voice/tianqin_2859.ogg"
    nvlNone "「참, 무슨 소리야. 계속 힘들면 꼭 말해 줘.」"


translate japanese plotexternal_483da362:


    nvlNone ""


translate japanese plotexternal_da6ab2c8:


    nvlNone "싫지는 않았다. 하지만 도무지 익숙해지지 않았다."


translate japanese plotexternal_e4ade15a:


    nvlNone "크면서,\n혼자 해 나가는 데 완전히 익숙해져 버린 걸지도 모른다.{p}이런 다정함을 받아도,\n어떻게 답해야 할지 모르겠다."


translate japanese plotexternal_bc26eab1:


    nvlNone "30분 뒤 알레르기약이 듣기 시작했다."


translate japanese plotexternal_037e8acd:


    nvlNone "빨갛게 부었던 곳이 가라앉아 아까 일이 거짓말 같았다."


translate japanese plotexternal_08b08508:


    nvlNone "그런데도 라이라는 여전히 불안한 듯 말했다.{p}「역시 의사 선생님한테 진찰받아 보지 않을래?」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/tianqin_2860.ogg'))


translate japanese plotexternal_a49cf779:



    voice "voice/yangxi_1161.ogg"
    nvlNone "「됐어. 약이 들었으니까 이제 괜찮아.」"


translate japanese plotexternal_a4675319:



    voice "voice/yangxi_1162.ogg"
    nvlNone "「당사자보다 더 호들갑 떨면 어쩌자는 거야.」{p}그녀를 슬쩍 봤다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1162.ogg', None))


translate japanese plotexternal_bcc14d62:



    voice "voice/yangxi_1163.ogg"
    nvlNone "「이런 건 흔해. 그렇게 당황할 필요 없어.」"


translate japanese plotexternal_1221a993:



    voice "voice/yangxi_1164.ogg"
    nvlNone "「병원 가면 오늘 놀러 갈 시간 없어질 텐데?」"


translate japanese plotexternal_50604fb8:


    nvlNone "나는 문득 다른 이야기를 꺼냈다."


translate japanese plotexternal_608406e3:


    nvlNone "오늘은 라이라와 놀러 나가기로 약속한 날이었다."


translate japanese plotexternal_e2962d23:



    voice "voice/tianqin_2863.ogg"
    nvlNone "「그런 건 서두를 필요 없어. 다음에 가면 되잖아.」"


translate japanese plotexternal_fd6d6d97:


    nvlNone "하지만,{p}라이라는 망설임 없이 「놀러 가기」보다 「병원에 가기」를 우선했다."


translate japanese plotexternal_65553e2e:



    voice "voice/yangxi_1166.ogg"
    nvlNone "「……알았어, 알았어. 그럼 의사 선생님한테 진찰받자.」"


translate japanese plotexternal_17f55841:


    nvlNone "결국 양보한 건 나였다."


translate japanese plotexternal_bd1ccad3:


    nvlNone "혼자 갈 수 있다고 했는데도 라이라는 따라왔다."


translate japanese plotexternal_4f7010f9:


    nvlNone "뭐, 함께 와 달라고 하는 게 맞았을지도 모른다."


translate japanese plotexternal_62d9e7cc:




    nvlNone "하지만…… 뭐라고 해야 할까."


translate japanese plotexternal_85cfe50d:



    voice "voice/yangxi_1168.ogg"
    nvlNone "「여기서 기다려. 선생님한테는 나 혼자 갈게.」"


translate japanese plotexternal_ae16c248:


    nvlNone "누군가 걱정해 주면,\n오히려 불편해지는 걸까?"


translate japanese plotexternal_202bef65:




    nvlNone "모르겠다."


translate japanese plotexternal_dac663a2:


    nvlNone "아니면 시시한 자존심 때문일까?"


translate japanese plotexternal_3bf178c4:


    nvlNone "가장 친한 사람에게는,\n꼴사나운 모습을 보이고 싶지 않은 걸까?"


translate japanese plotexternal_7a7b3762:


    nvlNone ""


translate japanese plotexternal_1ae69c7f_7:


    voice "voice/yangxi_1169.ogg"
    nvlNone "「……」"


translate japanese plotexternal_c3b93852:



    voice "voice/doctor_0001.ogg"
    nvlNone "「듣고 계신가요, 아가씨?」"


translate japanese plotexternal_f6237fc9:


    nvlNone "진료실에서 내 맞은편에 앉은 의사는,\n원래 본가의 전속 의사였다."


translate japanese plotexternal_51eb3bc9:


    nvlNone "내가 룽화시로 이사 온 뒤 그녀도 함께 따라왔다."


translate japanese plotexternal_80370070:



    voice "voice/yangxi_1171.ogg"
    nvlNone "「여기서는 아가씨라고 부르지 마.」"


translate japanese plotexternal_b0120939:



    voice "voice/doctor_0002.ogg"
    nvlNone "「……죄송합니다. 아직 입에 익지 않아서요.」"


translate japanese plotexternal_0c83e6ec:



    voice "voice/yangxi_1172.ogg"
    nvlNone "「이젠 내 전속 의사가 아니잖아. 지금은 이 병원 원장이지.」"


translate japanese plotexternal_45674c8a:



    voice "voice/doctor_0003.ogg"
    nvlNone "「그렇긴 합니다만, 주인어른께서……」{p}「――흠흠. 아버님께서는,\n지금도 많이 걱정하고 계십니다.」" (callback=nvl_page_voice, cb_page_voices=('voice/doctor_0003.ogg', 'voice/doctor_0004.ogg'))


translate japanese plotexternal_a5792227:



    voice "voice/yangxi_1173.ogg"
    nvlNone "「……그만해. 여기서 혼자 산 지가 몇 년인데 아직도 뭐가 걱정이야.」"


translate japanese plotexternal_727d4a5a:



    voice "voice/yangxi_1174.ogg"
    nvlNone "「그보다 선생님은 여기 생활에 익숙해졌어?」"


translate japanese plotexternal_a6bf4c71:


    nvlNone "이번에는 내가 되물었다."


translate japanese plotexternal_efcc64be:



    voice "voice/yangxi_1175.ogg"
    nvlNone "「나 때문에 아빠의 고집에 휘말려 유럽에서 여기까지 온 거잖아……」"


translate japanese plotexternal_5db04b85:



    voice "voice/doctor_0005.ogg"
    nvlNone "「아, 아닙니다, 아가씨. 오해십니다.\n저는 아무런 불만도 없습니다.」"


translate japanese plotexternal_ee52e17a:


    nvlNone "그녀는 황급히 자리에서 일어섰다."


translate japanese plotexternal_38de0cf5:



    voice "voice/doctor_0006.ogg"
    nvlNone "「아버님은 제 생명의 은인이십니다.」"


translate japanese plotexternal_6e9521a8:



    voice "voice/yangxi_1177.ogg"
    nvlNone "（아빠에게 진 은혜라……）"


translate japanese plotexternal_8bdd2607:


    nvlNone "속으로 그렇게 생각했다."


translate japanese plotexternal_48797d58:


    nvlNone "ヨーロッパで安定した暮らしをしていた彼女は、家族ごと私について引っ越してきた。"


translate japanese plotexternal_f757c767:



    voice "voice/doctor_0008.ogg"
    nvlNone "「그리고 아가씨.」"


translate japanese plotexternal_326dbd1f:


    nvlNone "그녀는 말을 이었다."


translate japanese plotexternal_9984f2d7:



    voice "voice/doctor_0009.ogg"
    nvlNone "「검사 이야기로 돌아가면, 일단 진찰한 바로는 큰 문제는 없는 것 같습니다.」"


translate japanese plotexternal_efdbad01:



    voice "voice/doctor_0011.ogg"
    nvlNone "「다만 아가씨께서는 건강검진을 오랫동안 받지 않으셨습니다.」"


translate japanese plotexternal_703d4c58:



    voice "voice/doctor_0012.ogg"
    nvlNone "내일 시간 괜찮으시면,\n아침에 여기서 채혈하시지요."


translate japanese plotexternal_afbd3dee:



    voice "voice/doctor_0013.ogg"
    nvlNone "「그리고, 그러니까……」"


translate japanese plotexternal_e6b5e178:



    nvlNone "「곧 신제품이 도입되거든요.」{p}「그쪽에서 지금 데이터를 바탕으로 개개인에게 맞게 조정할 필요가 있습니다.」" (callback=nvl_page_voice, cb_page_voices=('voice/doctor_0015.ogg', 'voice/doctor_0016.ogg'))


translate japanese plotexternal_ed56d3b5:



    voice "voice/yangxi_1178.ogg"
    nvlNone "「어? 또 새 걸로 바꾸는 거야…… 지금 것도 쓴 지 아직 1년이 안 됐잖아?」{p}의아해서 의사에게 물었다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1178.ogg', None))


translate japanese plotexternal_2b860836:



    voice "voice/yangxi_1179.ogg"
    nvlNone "「알았어…… 내일 검사받으러 올게.」"


translate japanese plotexternal_bf78f877:



    voice "voice/doctor_0018.ogg"
    nvlNone "「그럼 만일을 대비해 소염제와 항생제를 처방해 드리겠습니다.」"


translate japanese plotexternal_65a6dd3c:


    nvlNone "의사는 컴퓨터를 조작해 여러 종류의 약을 처방했다."


translate japanese plotexternal_4dee2bbf:



    voice "voice/doctor_0019.ogg"
    nvlNone "「내일 또 붓는다면,\n거부 반응을 억제하는 약도 드리겠습니다.」"


translate japanese plotexternal_8f422523_3:


    nvlNone "……"


translate japanese plotexternal_5990666b:



    voice "voice/yangxi_1181.ogg"
    nvlNone "（귀찮아…… 이걸로 내일 오전도 날아가겠네.）"


translate japanese plotexternal_ba77f3f5:


    voice "voice/tianqin_2866.ogg"
    nvlNone "「어땠어? 선생님이 뭐래?」{p}진료실에서 나오자 라이라가 곧바로 달려왔다." (callback=nvl_page_voice, cb_page_voices=('voice/tianqin_2866.ogg', None))


translate japanese plotexternal_74f9ccc7:



    voice "voice/yangxi_1183.ogg"
    nvlNone "「막 여름이 돼서 알레르기가 조금 생긴 것 같아.」{p}그렇게 덧붙였다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1183.ogg', None))


translate japanese plotexternal_916d59dc:



    voice "voice/tianqin_2867.ogg"
    nvlNone "「휴…… 아무 일 없어서 다행이야.」"


translate japanese plotexternal_7f303e56:



    voice "voice/yangxi_1185.ogg"
    nvlNone "「내일 아침에 다시 채혈하러 와서,\n엑스레이도 찍어야 하지만.」"


translate japanese plotexternal_2ff6032d:



    voice "voice/tianqin_2868.ogg"
    nvlNone "「그럼 내일도 따라올까?」"


translate japanese plotexternal_5d3b87f1:


    nvlNone "라이라는 의욕적으로 물었다. 하지만,\n중요한 사실 하나를 잊은 모양이었다."


translate japanese plotexternal_d1143b3d:



    voice "voice/tianqin_2869.ogg"
    nvlNone "「윽! 노, 노력하면 아마도……?」"


translate japanese plotexternal_ffed5f62:



    voice "voice/yangxi_1187.ogg"
    nvlNone "「그만둬. 나 혼자 와도 되고, 별일도 아니니까.」"


translate japanese plotexternal_e35036c1:


    nvlNone "휴대폰을 봤다. 시간은 아직 일렀다."


translate japanese plotexternal_f5f809fc:


    nvlNone "병원에 오는 것만으로는 그리 오래 걸리지 않는다."


translate japanese plotexternal_5da89ec4:



    voice "voice/yangxi_1188.ogg"
    nvlNone "「놀러 가자.」{p}그렇게 제안했다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1188.ogg', None))


translate japanese plotexternal_8fb55998:



    voice "voice/tianqin_2871.ogg"
    nvlNone "「어? 집에 안 가?」"


translate japanese plotexternal_26098f0d:



    voice "voice/tianqin_2872.ogg"
    nvlNone "「하지만 몸은……」"


translate japanese plotexternal_fec80797:



    voice "voice/yangxi_1190.ogg"
    nvlNone "「괜찮다고 했잖아. 약 먹었으니까 괜찮아.」"


translate japanese plotexternal_4dc803c1:


    nvlNone "또 그 감각이다."


translate japanese plotexternal_0ca5d33f:


    nvlNone "누군가 지나치게 신경 써 주면,\n온몸이 안절부절못하는 감각."


translate japanese plotexternal_cee82f61:


    nvlNone "예전의 그녀라면,\n아까처럼 내게 물어보지는 않았을 것이다."


translate japanese plotexternal_d6d43769:


    nvlNone "하지만 서로 의지하는 사이라면 이 정도 배려는 당연할 텐데."


translate japanese plotexternal_080abe75:


    voice "voice/yangxi_1191.ogg"
    nvlNone "「자, 가자.」{p}더는 쓸데없는 생각을 하지 않기로 했다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1191.ogg', None))


translate japanese plotexternal_4420fa8d:



    voice "voice/yangxi_1192.ogg"
    nvlNone "「조금만 둘러보다 돌아가자.」"


translate japanese plotexternal_40751b39:


    nvlNone "여기저기 구경한다고 해도 결국 왔던 길을 되돌아갔다."


translate japanese plotexternal_bff69691:


    nvlNone "彼女は張り切って、この辺りの施設を紹介してくれる。"


translate japanese plotexternal_897bff27:


    nvlNone "외출은 좋아하지 않는다."


translate japanese plotexternal_ad1c1161:


    nvlNone "사람 많은 곳도 싫다."


translate japanese plotexternal_b83ea199:


    nvlNone "라이라가 늘 놀러 가자고 하지 않았다면,"


translate japanese plotexternal_88a83118:


    nvlNone "문득 시야 구석에 재미있어 보이는 가게가 들어왔다."


translate japanese plotexternal_cbf17848:


    nvlNone "라이라를 보니 아직도 옆 식당이 얼마나 맛있는지\n끝없이 떠들고 있었다."


translate japanese plotexternal_b26e88f7:



    voice "voice/yangxi_1193.ogg"
    nvlNone "（얘는 뭔가 부족한 것 같아.）"


translate japanese plotexternal_a9cf6740:


    voice "voice/yangxi_1194.ogg"
    nvlNone "「라이라.」{p}그녀의 말을 끊었다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1194.ogg', None))


translate japanese plotexternal_4f717dc6:



    voice "voice/tianqin_2875.ogg"
    nvlNone "「응?」"


translate japanese plotexternal_cdec7a6d:



    voice "voice/yangxi_1195.ogg"
    nvlNone "「저기 가 볼래?」"


translate japanese plotexternal_31683530:


    nvlNone "그녀는 내가 가리킨 가게로 눈길을 돌렸다."


translate japanese plotexternal_97032ef3:



    voice "voice/tianqin_2877.ogg"
    nvlNone "「응? 액세서리 가게? 히나타, 가고 싶어?」"


translate japanese plotexternal_dbb4c044:


    voice "voice/yangxi_1196.ogg"
    nvlNone "「응.」{p}정확히는 피어싱 전문점이었다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1196.ogg', None))


translate japanese plotexternal_67e0760e:



    voice "voice/tianqin_2878.ogg"
    nvlNone "「그럼 같이 보자! 나도 들어가 본 적 없거든!」"


translate japanese plotexternal_e367caaf:




    nvlNone "역시."


translate japanese plotexternal_1b4331cb:


    nvlNone "피어싱을 몇 개 고르고 우리는 집으로 돌아왔다."


translate japanese plotexternal_4d3f47e2:


    voice "voice/tianqin_2879.ogg"
    nvlNone "「도와줄까?」{p}내가 피어싱을 만지작거리자 라이라가 곁으로 다가왔다." (callback=nvl_page_voice, cb_page_voices=('voice/tianqin_2879.ogg', None))


translate japanese plotexternal_ef2e3c80:



    voice "voice/yangxi_1197.ogg"
    nvlNone "「응. 머리 좀 더 이쪽으로 가져와 봐.」"


translate japanese plotexternal_0281c9ae:


    nvlNone "그녀의 귓가에 피어싱을 대 봤다."


translate japanese plotexternal_36bbc4e8:


    nvlNone "어느 게 가장 잘 어울리는지 확인했다."


translate japanese plotexternal_6068a6f3:


    nvlNone "그제야 그녀도 눈치챈 모양이었다.{p}「뭐? 이거 나한테 사 준 거야!?」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/tianqin_2881.ogg'))


translate japanese plotexternal_dc8d9ba6:



    voice "voice/tianqin_2882.ogg"
    nvlNone "「하지만 나 귀 안 뚫었는데?」"


translate japanese plotexternal_637f219c:


    voice "voice/yangxi_1199.ogg"
    nvlNone "「그래서 귀 뚫는 기구도 샀어.」{p}스테이플러처럼 생긴 작은 기구를 꺼내 탁자에 놓았다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1199.ogg', None))


translate japanese plotexternal_33c4abe3:



    voice "voice/tianqin_2883.ogg"
    nvlNone "「뭐? 그, 그러면――」"


translate japanese plotexternal_51f00f88:


    voice "voice/yangxi_1200.ogg"
    nvlNone "「왜? 무서워?」{p}그 모습을 보고 한 번 더 밀어붙이기로 했다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1200.ogg', None))


translate japanese plotexternal_d4f8fb68:



    voice "voice/tianqin_2884.ogg"
    nvlNone "「아니거든!」"


translate japanese plotexternal_43798045:



    voice "voice/yangxi_1201.ogg"
    nvlNone "「아니면 나 못 믿어? 내가 아프게 할까 봐 무서워?」"


translate japanese plotexternal_0d437d88:



    voice "voice/yangxi_1202.ogg"
    nvlNone "「으음…… 확실히 갑작스럽긴 했네.」"


translate japanese plotexternal_5c54fc9f:



    voice "voice/yangxi_1203.ogg"
    nvlNone "「싫으면 안 뚫어도 되지만.」"


translate japanese plotexternal_fb30866d:



    voice "voice/tianqin_2887.ogg"
    nvlNone "「할 거면 하자! 귀 뚫는 것뿐이잖아!」"


translate japanese plotexternal_568a13f8:


    nvlNone "라이라는 볼을 부풀리며 내 옆에 털썩 앉았다."


translate japanese plotexternal_6f7b62a9:


    nvlNone "그런데 바로 그 순간, 오히려 내가 조금 망설였다."


translate japanese plotexternal_9f1b6d88:


    nvlNone "손이 떨려 제대로 뚫지 못할까 봐 두려운 건 아니었다."


translate japanese plotexternal_6e74bf72:


    nvlNone "잔꾀를 부려 그녀를 내 뜻에 따르게 했기 때문이다."


translate japanese plotexternal_8a5ac1fa:


    nvlNone "그렇게 생각하면서도 결국 손은 귀 뚫는 기구를 집어 들었다."


translate japanese plotexternal_8aac76b5:


    nvlNone "그냥 그녀가 피어싱을 하면 분명 예쁠 거라고 생각했다."


translate japanese plotexternal_83e3218c:


    nvlNone "머리카락을 걷어 올리자 귀의 윤곽부터 목덜미까지,\n모든 것이 눈앞에 드러났다."


translate japanese plotexternal_cb38cf6a:


    nvlNone "평소에는 별로 의식하지 않던 곳이 지금은 내 앞에 드러나 있었다."


translate japanese plotexternal_07cc7f5a:


    nvlNone "왜인지 몹시 매혹적으로 보였다."


translate japanese plotexternal_51b18de6:


    nvlNone "만지면 어떤 느낌일까?"


translate japanese plotexternal_5b5889af:


    nvlNone "그 의문이 머릿속에 떠오르자마자,"


translate japanese plotexternal_dfc4dc26:


    nvlNone "갑자기 쓰다듬자 그녀는 저도 모르게 어깨를 움츠렸다.{p}「으응~~! 뭐 하는 거야……」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/tianqin_2888.ogg'))


translate japanese plotexternal_12ac3557:


    nvlNone "물론 거짓말이다."


translate japanese plotexternal_6e89fe66:


    nvlNone "나는 그저 그녀의 몸에 있는 「비밀」을 알아보고 싶었다."


translate japanese plotexternal_29031a30:


    nvlNone "검지로 귀 연골의 감촉을 확인했다."


translate japanese plotexternal_7621a71f:




    nvlNone "후——"


translate japanese plotexternal_c4497bcf:


    nvlNone "속으로 한숨을 내쉬었다."


translate japanese plotexternal_18fd14f3:


    nvlNone "소소한 「탐구심」은 충분히 채워졌다."


translate japanese plotexternal_f1aa2e08:



    voice "voice/yangxi_1205.ogg"
    nvlNone "「소독 시작한다?」"


translate japanese plotexternal_967e5194:


    nvlNone "알코올을 적신 면봉이 닿는 순간,\n그녀는 살짝 몸을 뒤로 뺐다."


translate japanese plotexternal_de9efea5:


    nvlNone "귓불 전체에 알코올을 꼼꼼히 발랐다."


translate japanese plotexternal_12fbedd7:



    voice "voice/tianqin_2889.ogg"
    nvlNone "「힉――」"


translate japanese plotexternal_440b7ba0:


    nvlNone "문득 어깨에 손이 닿자 책상 모서리에 부딪힌 것처럼 딱딱했다."


translate japanese plotexternal_bab67042:


    nvlNone "몹시 굳어 있었다."


translate japanese plotexternal_2468f4a9:


    nvlNone "그제야 그녀가 눈을 꼭 감고,\n온몸에 힘을 주고 있다는 걸 깨달았다."


translate japanese plotexternal_edfe0539:


    nvlNone "그녀와는 달리 지금의 나는 들떠 있었다."


translate japanese plotexternal_5eddc95b:


    nvlNone "그녀가 눈을 뜨고 있었다면,\n그 눈동자에 비친 지금의 내 모습을 볼 수 있었을지도 모른다."


translate japanese plotexternal_855f5a8b:


    nvlNone "볼을 붉히고 기뻐하는 표정의 나를."


translate japanese plotexternal_e943782c_3:


    voice "voice/yangxi_1206.ogg"
    nvlNone "「후——」"


translate japanese plotexternal_20df3cd2:


    nvlNone "그녀의 얼굴에 입김을 불었다."


translate japanese plotexternal_bfc648e0:



    voice "voice/tianqin_2890.ogg"
    nvlNone "「으아――!!」"


translate japanese plotexternal_879af946:



    voice "voice/yangxi_1207.ogg"
    nvlNone "「힘 빼. 그렇게 긴장하면 어떡해.」"


translate japanese plotexternal_9fac2fb0:



    voice "voice/yangxi_1208.ogg"
    nvlNone "「안 아파. 모기에 물리는 정도니까.」{p}그렇게 말하며 그녀를 한 번 더 달랬다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1208.ogg', None))


translate japanese plotexternal_d9fb1362:


    nvlNone "라이라는 이 정도 아픔을 무서워할 애가 아니라고 생각한다."


translate japanese plotexternal_b301ac77:


    nvlNone "그냥 긴장한 것뿐이다."


translate japanese plotexternal_5cdda9bd:


    nvlNone "그때 마음 깊은 곳에서 강한 충동이 솟구쳤다."


translate japanese plotexternal_0ae8c37e:


    nvlNone "그녀의 몸에 무언가를 남기고 싶다."


translate japanese plotexternal_db3aa786:


    nvlNone "그 충동이 아까의 혐오감을 흔적도 없이 씻어 냈다."


translate japanese plotexternal_ad6c0e9e:



    voice "voice/yangxi_1209.ogg"
    nvlNone "「……간다.」"


translate japanese plotexternal_5ad1170a:


    nvlNone "기구를 그녀의 귓불에 맞췄다."


translate japanese plotexternal_afebd822:


    nvlNone "위치가 뚜렷이 보여 표시조차 하지 않았다."


translate japanese plotexternal_09133cd5:



    voice "voice/tianqin_2892_02.ogg"
    nvlNone "「으——!」"


translate japanese plotexternal_362dd770:


    nvlNone "라이라가 억눌린 소리를 냈다."


translate japanese plotexternal_4ae9eaea:


    nvlNone "그녀가 숨을 다 내쉬기도 전에 재빨리 손에 힘을 줬다."


translate japanese plotexternal_2eef2faf:


    nvlNone "그녀의 몸이 움찔 떨리는 게 느껴졌다."


translate japanese plotexternal_6c7c3b6c:



    voice "voice/yangxi_1210.ogg"
    nvlNone "「어때? 그렇게 안 아프지?」"


translate japanese plotexternal_a91f637c:


    nvlNone "彼女が予想していない瞬間に、ピアッサーを押した。"


translate japanese plotexternal_3cbc92ce:


    nvlNone "그러면 통증을 크게 느끼지 않아도 된다."


translate japanese plotexternal_43cea37a:


    nvlNone "마음의 준비가 완벽해질 때까지 기다리면 통증을 실제보다 크게 느끼게 마련이다."


translate japanese plotexternal_4777b337:


    nvlNone "그녀의 귀를 보니\n처음 끼우는 피어싱이 막 뚫은 구멍에 깔끔하게 들어가 있었다."


translate japanese plotexternal_25b8e13f:


    nvlNone "예상대로 아주 잘 어울린다."


translate japanese plotexternal_cb927135:


    nvlNone "거울을 가져와 그녀에게도 결과를 보여 줬다.{p}「봐, 하나도 안 삐뚤어졌지?」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/yangxi_1211.ogg'))


translate japanese plotexternal_c83dca7c:



    voice "voice/tianqin_2894.ogg"
    nvlNone "「으음…… 거울로 귀를 보니까 오히려 조금 아파진 것 같아.」"


translate japanese plotexternal_022b8098:


    voice "voice/yangxi_1213.ogg"
    nvlNone "「자, 반대쪽.」{p}포장에서 새 기구를 꺼냈다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1213.ogg', None))


translate japanese plotexternal_6731a0ee:



    voice "voice/tianqin_2895.ogg"
    nvlNone "「뭐!? 반대쪽도 해?」"


translate japanese plotexternal_aa8b5064:



    voice "voice/tianqin_2896.ogg"
    nvlNone "「네네~.」"


translate japanese plotexternal_68f47f0e:


    nvlNone "向きを変え、ライラはまだ穴を開けていない方の耳を私へ向けた。"


translate japanese plotexternal_a20dc77d:


    nvlNone "한 번 겪어 봐서인지 아까만큼 싫어하지 않았다."


translate japanese plotexternal_00aef455:


    nvlNone "반대쪽도 문제없이 뚫었다."


translate japanese plotexternal_dde1bcae:


    nvlNone "라이라는 더는 몸을 굳히지 않았다."


translate japanese plotexternal_4f076428:


    nvlNone "「오오~.」"


translate japanese plotexternal_afb24dc8:


    nvlNone "라이라는 거울을 보며 양쪽 귀를 번갈아 살폈다."


translate japanese plotexternal_554f2c75:



    voice "voice/yangxi_1215.ogg"
    nvlNone "「며칠은 귀 적시지 마. 물 닿지 않게 조심해.」{p}옆에서 몇 가지 주의 사항을 알려 줬다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1215.ogg', None))


translate japanese plotexternal_03a8404e:


    voice "voice/tianqin_2898.ogg"
    nvlNone "「알고 있어~.」"


translate japanese plotexternal_eda65fc4:



    voice "voice/yangxi_1216.ogg"
    nvlNone "「있잖아……」"


translate japanese plotexternal_4f717dc6_1:



    voice "voice/tianqin_2899.ogg"
    nvlNone "「응?」"


translate japanese plotexternal_30e62379:



    voice "voice/yangxi_1217.ogg"
    nvlNone "「치유력이 너무 세서 피어싱까지 붙어 버리는 거 아니야?」"


translate japanese plotexternal_ea3ccaff:


    nvlNone "「으음…… 아마 괜찮을 거야.」{p}조금 후 그녀는 그렇게 말했다." (callback=nvl_page_voice, cb_page_voices=('voice/tianqin_2901.ogg', None))


translate japanese plotexternal_d26654a9:



    voice "voice/yangxi_1218.ogg"
    nvlNone "「왜?」"


translate japanese plotexternal_185a0911:



    voice "voice/tianqin_2902.ogg"
    nvlNone "「스스로 조절할 수 있으니까!」"


translate japanese plotexternal_0dcf338b:



    voice "voice/yangxi_1219.ogg"
    nvlNone "「어떻게?」"


translate japanese plotexternal_cdaab710:



    voice "voice/tianqin_2904.ogg"
    nvlNone "「낫지 않는 상태를 상상하면 정말로 안 낫거든.」"


translate japanese plotexternal_13d182a5:


    nvlNone "한편으로는 말도 안 된다고 생각했다."


translate japanese plotexternal_3d59fba0:


    nvlNone "또 한편으로는 라이라 본인이 그렇게 말한다면 정말 가능하겠다고 생각했다."


translate japanese plotexternal_89e4a412:



    voice "voice/yangxi_1221.ogg"
    nvlNone "「……너 정말 신기하네.」"


translate japanese plotexternal_d5f67d8d:


    nvlNone "그녀가 기뻐하며 거울을 보는 모습을 바라봤다."


translate japanese plotexternal_0f76a240:


    nvlNone "귓불에 남은 저 작은 구멍은 내 작품이다."


translate japanese plotexternal_4729a6f5:


    nvlNone "심장은 여전히 빠르게 뛰고 있다."


translate japanese plotexternal_6485f63e:


    nvlNone "그게 무슨 「감정」인지,\n나 자신도 모르겠다."


translate japanese plotexternal_64db5b35:


    nvlNone "흥분? 아니면 환희?"


translate japanese plotexternal_a91282b4:


    nvlNone "아마 둘 다 아닐 것이다."


translate japanese plotexternal_f2798c4e:


    nvlNone "그냥 그녀의 귓불에 생긴 빈 공간이 나 자신을 채워 준 것 같았다."


translate japanese plotexternal_6caf7ec2:


    nvlNone "라이라가 기뻐하는 지금, 한 걸음 더 나아가기로 했다."


translate japanese plotexternal_dd528b8f:


    nvlNone "마음속으로 생각하던 것을 그녀에게 전하기로 했다."


translate japanese plotexternal_416e5de5:


    nvlNone "라이라도 무언가 눈치챈 것 같았다."


translate japanese plotexternal_0f6a1b62:


    nvlNone "갑자기 입을 다물었다."


translate japanese plotexternal_83bc0b87:



    voice "voice/yangxi_1222.ogg"
    nvlNone "「라이라…… 나……」"


translate japanese plotexternal_fdd1239d:


    nvlNone "결국 나는 말해야 한다."


translate japanese plotexternal_c45e6fe2:



    voice "voice/tianqin_2906.ogg"
    nvlNone "「어!?」"


translate japanese plotexternal_a2cb61e7:


    nvlNone "예상했던 말과 달랐던 모양이다. 그녀는 그 자리에서 굳어 버렸다."


translate japanese plotexternal_c8e42920:


    nvlNone "내가 고백할 줄 알았어?"


translate japanese plotexternal_a2ce5f3c:



    voice "voice/tianqin_2907.ogg"
    nvlNone "「왜 그래? 갑자기 그런 말을 하고.」"


translate japanese plotexternal_fa5357f9:



    voice "voice/yangxi_1224.ogg"
    nvlNone "「너도 눈치챘잖아.」"


translate japanese plotexternal_cce20508:



    voice "voice/tianqin_2908.ogg"
    nvlNone "「으음……」"


translate japanese plotexternal_d4887266:



    voice "voice/yangxi_1225.ogg"
    nvlNone "「우리는 같이 사는 게 안 맞네.」"


translate japanese plotexternal_c448440d:


    nvlNone "생각하던 것을 분명하게 말로 꺼냈다."


translate japanese plotexternal_33ebced9:



    voice "voice/tianqin_2909.ogg"
    nvlNone "「으음…… 히나타도 그렇게 생각했구나?」"


translate japanese plotexternal_224cf32d:


    nvlNone "라이라가 어떻게 생각하는지는 정확히 모른다."


translate japanese plotexternal_2176e5eb:


    voice "voice/yangxi_1226.ogg"
    nvlNone "「으음―― 뭐라고 해야 할까.」"


translate japanese plotexternal_7aac8139:


    nvlNone "잠시 생각하고 가슴속 감각을 말로 표현해 봤다."


translate japanese plotexternal_1b3d76ee:



    voice "voice/tianqin_2910.ogg"
    nvlNone "「뭐야, 그게. 결국 잘 맞느냐의 문제잖아.」"


translate japanese plotexternal_dfb86a04:



    voice "voice/yangxi_1230.ogg"
    nvlNone "「너는 어떻게 생각해?」"


translate japanese plotexternal_19e1e0e6:


    nvlNone "문득 라이라를 봤다. 그녀는 지금 무엇을 느끼고 있을까."


translate japanese plotexternal_443564fb:



    voice "voice/tianqin_2911.ogg"
    nvlNone "「어, 나? 으음……」"


translate japanese plotexternal_c5c01bd9:



    voice "voice/tianqin_2912.ogg"
    nvlNone "「나는 내가 달라지기 시작한 것 같아.\n나답지 않아지고 있다고 할까.」"


translate japanese plotexternal_af1956ea:



    voice "voice/tianqin_2913.ogg"
    nvlNone "「히나타도 마찬가지야. 우리 둘 다 뭔가 변하고 있는 것 같아.」"


translate japanese plotexternal_fd7513ff:



    voice "voice/yangxi_1231.ogg"
    nvlNone "「위화감?」"


translate japanese plotexternal_7f5c69c6:


    nvlNone "그녀가 하고 싶은 말을 헤아려 그렇게 말했다."


translate japanese plotexternal_0d1f189c:



    voice "voice/yangxi_1232.ogg"
    nvlNone "「이렇게 아무런 거리도 없는 관계는 우리가 바라던 게 아닐지도 몰라.」"


translate japanese plotexternal_ca81bcb2:



    voice "voice/yangxi_1233.ogg"
    nvlNone "「서로 기대기보다는,\n나 자신을 위한 공간이 필요해.」"


translate japanese plotexternal_9480a0fe:



    voice "voice/tianqin_2916.ogg"
    nvlNone "「상대를 너무 신경 쓰고 싶지도 않고, 나를 너무 신경 써 주길 바라지도 않는 거지.」"


translate japanese plotexternal_b32a6f9f:



    voice "voice/yangxi_1235.ogg"
    nvlNone "「응. 그런 느낌이야.」"


translate japanese plotexternal_532a9650:



    voice "voice/yangxi_1236.ogg"
    nvlNone "「지금 거리라면 오히려 서로를 묶어 두게 돼.」"


translate japanese plotexternal_0f74fa86:



    voice "voice/yangxi_1237.ogg"
    nvlNone "「우리 사이에 있는 건 세상에서 말하는 『연애』도 아니고, 물론 『우정』도 아니야.」"


translate japanese plotexternal_39f127a4:



    voice "voice/tianqin_2918.ogg"
    nvlNone "「으음, 그럴지도. 하지만 나도 이 느낌을 어떻게 설명해야 할지 모르겠어.」"


translate japanese plotexternal_319dbd03:


    nvlNone "라이라는 고개를 갸웃하며 잠시 생각했다."


translate japanese plotexternal_940b81b4:



    voice "voice/yangxi_1239.ogg"
    nvlNone "「나는…… 지금 상태를\n끝내는 게 좋겠어.」"


translate japanese plotexternal_7c2e7a54:


    nvlNone "패배를 인정하는 것 같은 말을 내뱉자,\n몹시 불쾌해졌다."


translate japanese plotexternal_00202dc6:


    nvlNone "한 달 전, 같이 살자고 꺼낸 건 나였다."


translate japanese plotexternal_bcd50257:


    nvlNone "지금 상태는 우리 둘 중 누구에게도 좋지 않다."


translate japanese plotexternal_bbf2260a:


    nvlNone "그래도 조금은 변명하고 싶었다."


translate japanese plotexternal_f22d5beb:



    voice "voice/yangxi_1240.ogg"
    nvlNone "「언젠가 다시 이런 관계가 될지도 몰라.」"


translate japanese plotexternal_fdf6c990:



    voice "voice/tianqin_2920.ogg"
    nvlNone "「그렇네. 앞으로 우리가 어떻게 변할지는 모르는 거니까.」"


translate japanese plotexternal_5b8887b4:



    voice "voice/yangxi_1242.ogg"
    nvlNone "「나도 예전에는 줄곧 한 마리 늑대처럼 혼자 지낼 줄 알았어.」"


translate japanese plotexternal_e5f69cb1:



    voice "voice/yangxi_1243.ogg"
    nvlNone "「널 만나고 나서 많이 달라졌지.」"


translate japanese plotexternal_3162ab63:



    voice "voice/yangxi_1245.ogg"
    nvlNone "「6년이네. 너를 만난 지.」"


translate japanese plotexternal_0a6fadfd:


    nvlNone "ライラを見つめ、六年前の私たちと今を思い返す。いろいろな思いが胸へ込み上げた。"


translate japanese plotexternal_eb170215:


    voice "voice/yangxi_1246.ogg"
    nvlNone "「아무튼, 【Insomma, torniamo come prima｜예전 사이로 돌아가자】.」"


translate japanese plotexternal_ee74cfca:


    nvlNone "자리에서 일어섰다."


translate japanese plotexternal_8a16f252:


    nvlNone "이번 한 달의 경험을 통해 많은 것을 생각하게 됐다."


translate japanese plotexternal_35064d86:


    nvlNone "몸의 거리는 가까워졌는데 마음은 서로 멀어져 갔다."


translate japanese plotexternal_4f78f59f:



    voice "voice/yangxi_1247.ogg"
    nvlNone "「서로에게 여유를 더 남겨 두는 편이 지금 우리에게는 맞는 것 같아.」{p}라이라를 보고 그렇게 제안했다." (callback=nvl_page_voice, cb_page_voices=('voice/yangxi_1247.ogg', None))


translate japanese plotexternal_90d51f7a:


    nvlNone "다음 날 아침."


translate japanese plotexternal_99f0fe7a:


    nvlNone "눈을 떴을 때, 그 조금 낯설던 천장은 더 이상 없었다."


translate japanese plotexternal_7b0e0e56:


    nvlNone "어젯밤에는 집에 돌아오자마자 일찍 잠들었다."


translate japanese plotexternal_ef832003:


    nvlNone "오늘은 드디어 충분히 잤다."


translate japanese plotexternal_30fde9c8:


    nvlNone "하지만 옆에는 늘 있던 그녀도, 그 익숙한 냄새도 없었다."


translate japanese plotexternal_27ab15c6:


    nvlNone "베란다로 나갔다."


translate japanese plotexternal_97c64113:


    nvlNone "오른손이 평소 버릇대로 난간 옆을 향해 뻗었다."


translate japanese plotexternal_5211036d:


    nvlNone "이번에야말로 손에 쥔 건 담뱃갑이었다."


translate japanese plotexternal_9ef0f6bf:


    nvlNone "어젯밤 돌아오는 길에 편의점에 들러 산 것이다."


translate japanese plotexternal_f4f3ae32:


    "吐き出した煙が体の周りを漂う。前回のような罪悪感はなかった。"


translate japanese plotexternal_10efd676:


    "解放感を覚えるのと同時に、胸の空白はますます私を苦しめた。"


translate japanese plotexternal_c38ae8a9:


    voice "voice/yangxi_1248.ogg"
    nvl_yangxi "후우―― 정말 귀찮은 여자네, 나란……"


translate japanese plotexternal_a2429a64:


    nvlNone "이렇게,\n망설이기만 하는 자신에게 화가 났다."


translate japanese plotexternal_52a1bb58:


    nvlNone "스스로 선택했다면\n깔끔하게 받아들여야 한다."


translate japanese plotexternal_d0b5684f:


    nvlNone "하지만 잃고 나서야 혼자 있는 허무함과 공허함이 떠올랐다." (**end_page())


translate japanese plotexternal_d90c26a6:


    nvlNone "나는 역시 그녀에게 강한 감정을 품고 있는 것 같다."


translate japanese plotexternal_82e29cbc:


    nvlNone "라이라도 나와 같은\n기분일까?"


translate japanese plotexternal_6dc54368:


    nvlNone "같은 기분일까 봐 걱정되면서도 그렇지 않을까 봐 두렵다." (**end_page())


translate japanese plotexternal_3b9bbb79:


    nvlNone "우리는 닮았으면서도 닮지 않았다."


translate japanese plotexternal_2395d7fa:


    nvlNone "겉은 다른데 속은 무척 닮았다." (**end_page())


translate japanese plotexternal_bcd484b7:


    nvl clear
    nvlNone "그래서 서로의 영혼이 서로의 그림자를 비추는 것 같았다."


translate japanese plotexternal_1d04f996:


    "自分や相手が変われば、すぐに気づいてしまう。"


translate japanese plotexternal_6cfe5e57:


    nvlNone "둘 다 더 가까워지고 싶었다."


translate japanese plotexternal_734433f1:


    nvlNone "그런 마음을 품고\n한 달을 함께 보내 봤다."


translate japanese plotexternal_36279124:


    nvlNone "매일이 정말 행복했다." (**end_page())


translate japanese plotexternal_4bba2de6:


    nvlNone "그런데 그 뒤, 우리 안에서 무언가 변하기 시작했다."


translate japanese plotexternal_cd0f6e99:


    nvlNone "변화에 민감한 우리는 그 변화가 둘의 관계에 영향을 주고, 심지어 위협할 수도 있음을 느꼈다." (**end_page())


translate japanese plotexternal_21a8868b:


    nvl clear
    nvlNone "「거리」를 잊어버리고 나서야 서로에게 가장 필요했던 것이 바로 「거리」였다는 걸 깨달았다." (**end_page())


translate japanese plotexternal_fe955582:


    nvl clear
    nvlNone "겨울에 몸을 맞대는 호저처럼, 너무 가까워지면 서로에게 상처를 준다."


translate japanese plotexternal_d13ccdab:


    nvlNone "「상대를 신경 쓴다」라는 이름의 가시로." (**end_page())


translate japanese plotexternal_8e7ce314:


    nvlNone "딩동, 딩동――"


translate japanese plotexternal_235ce96e:


    nvlNone "하필 그때 초인종이 울렸다." (**end_page())


translate japanese plotexternal_123e7bc7:



    nvl clear
    voice "voice/yangxi_1249.ogg"
    nvl_yangxi "이렇게 이른 아침에 누구……?"


translate japanese plotexternal_d56ac499:


    nvlNone "머리를 긁적이며 담배를 비벼 끄고 현관으로 향했다."


translate japanese plotexternal_eece4f4a:


    nvlNone "이 시간에 찾아올 사람이라면 방문 판매원 정도겠지." (**end_page())


translate japanese plotexternal_2d53b11f:



    voice "voice/tianqin_2923.ogg"
    nvl_tianqin_dialogue "좋은 아침~."


translate japanese plotexternal_f89ab613:



    voice "voice/tianqin_2924.ogg"
    nvl_tianqin_dialogue "콜록, 콜록!!"


translate japanese plotexternal_0b410458:



    voice "voice/tianqin_2925.ogg"
    nvl_tianqin_dialogue "참! 아침부터 담배 피우는 거야!?" (**end_page())


translate japanese plotexternal_23858fe6:



    voice "voice/yangxi_1250.ogg"
    nvl_yangxi "……라이라? 이렇게 일찍 일어나서 무슨 일로 왔어."


translate japanese plotexternal_fbe87c9c:


    nvlNone "뒤쪽 알람시계를 봤다. 아직 7시 반이었다."


translate japanese plotexternal_16e091d4:


    "ここまで来るなら、少なくとも一時間前には起きたはずだ。少し意外だった。"


translate japanese plotexternal_b5e23b52:



    voice "voice/tianqin_2926.ogg"
    nvl_tianqin_dialogue "오늘도 검사받으러 간다고 했잖아?\n그래서 따라가려고."


translate japanese plotexternal_82467968:



    voice "voice/yangxi_1251.ogg"
    nvl_yangxi "……아. 완전히 잊고 있었네." (**end_page())


translate japanese plotexternal_6b3e3dc2:



    voice "voice/tianqin_2927.ogg"
    nvl_tianqin_dialogue "게다가 담배까지 피우고! 이래서야 검사 못 받잖아!"


translate japanese plotexternal_c5d96b8e:



    voice "voice/yangxi_1252.ogg"
    nvl_yangxi "――됐어. 내일 갈게." (**end_page())


translate japanese plotexternal_e351cbb8:



    nvl clear
    voice "voice/yangxi_1253.ogg"
    nvl_yangxi "그래서 진짜 무슨 일로 왔어?"


translate japanese plotexternal_c2011ccb:


    nvlNone "화제를 돌렸다. 그녀가 「그런 일」만으로 찾아왔을 리 없다. 지금 여기서 묻는 게 빠르다." (**end_page())


translate japanese plotexternal_99cd6abe:



    voice "voice/tianqin_2928.ogg"
    nvl_tianqin_dialogue "그게…… 히나타랑 놀이공원에 가고 싶어서……"


translate japanese plotexternal_31432f36:



    voice "voice/tianqin_2929.ogg"
    nvl_tianqin_dialogue "있잖아, 어제 그렇게 따로 살게 됐으니까 네가 풀이 죽진 않았을까 해서……" (**end_page())


translate japanese plotexternal_2d8b9e62:



    voice "voice/yangxi_1254.ogg"
    nvl_yangxi "……"


translate japanese plotexternal_05462c5a:



    voice "voice/yangxi_1255.ogg"
    nvl_yangxi "알았어. 먼저 준비하고 올게." (**end_page())


translate japanese plotexternal_ef54eca0:


    nvlNone "우리에게는 대체 어떤 거리가 필요한 걸까?"


translate japanese plotexternal_9e8ab0f0:


    nvlNone "곧 그 생각을 그만뒀다."


translate japanese plotexternal_5a024587:


    nvlNone "아마 이대로면 괜찮겠지." (**end_page())


translate japanese plotexternal_c6b7c00e:


    nvl clear
    nvlNone "그때가 오기 전까지는 이렇게 그녀와 함께 웃으며 하루하루를 보내자."


translate japanese plotexternal_1705d9a2:


    nvlNone "앞일은 그때가 돼서 생각하면 된다." (**end_page())


translate japanese plotexternal_1eec61f4:

    nvlNone "호수 위를 건너온 바람이\n기분 좋은 시원함을 거듭 실어 왔다." id plotexternal_1eec61f4


translate japanese plotexternal_a14c6916:

    nvlNone "정상에서 본 풍경에 숨이 멎을 듯했던 산도 분명 몇 개는 있었다." id plotexternal_a14c6916


translate japanese plotexternal_b334538d:

    nvlNone "멀리 바라보면,\n나무 꼭대기 너머로 룽화시의 한쪽을 내려다볼 수 있다." id plotexternal_b334538d


translate japanese plotexternal_b4f39e44:

    nvlNone "주문한 음식이 다 나왔을 때는 벌써 오후 두 시 반이었다." id plotexternal_b4f39e44


translate japanese plotexternal_bb64b9d4:

    nvlNone "라이라가 꼭 맞잡은 내 두 손 위에 손을 얹었다.\n그 순간 안도의 숨이 나왔다." id plotexternal_bb64b9d4


translate japanese plotexternal_6d8f22e9:

    nvlNone "내 생활도, 인간관계도,\n새로운 단계로 접어들려 하고 있다." id plotexternal_6d8f22e9


translate japanese plotexternal_88e2d6af:

    nvlNone "여름에는 날이 일찍 밝는다." id plotexternal_88e2d6af


translate japanese plotexternal_1e538abb:

    nvlNone "피하려면 공원 근처로도 갈 수 없다." id plotexternal_1e538abb


translate japanese plotexternal_a754437b:

    nvlNone "눈에 들어온 것은 산더미처럼 쌓인 달걀 프라이와 베이컨." id plotexternal_a754437b


translate japanese plotexternal_468b921e:

    nvlNone "조심스레 의자를 빼고 식탁에 앉았다." id plotexternal_468b921e


translate japanese plotexternal_f03ba7a2:

    nvlNone "내가 카트를 밀어 뒤쪽과 거리를 벌리고 나서야\n라이라는 손을 뗐다." id plotexternal_f03ba7a2


translate japanese plotexternal_e2761a8c:

    nvlNone "수도꼭지에서 따뜻한 물이 천천히 흘러나와 반도 차지 않은 욕조에 채워졌다." id plotexternal_e2761a8c (**end_page())


translate japanese plotexternal_bf043340:

    nvlNone "졸린 얼굴을 보니 아직 한참 더 잘 생각인 모양이다." id plotexternal_bf043340


translate japanese plotexternal_41f872a7:

    nvlNone "그녀는 열심히 이 근처 시설들을 소개해 주고 있었다." id plotexternal_41f872a7


translate japanese plotexternal_f71c5ed4:

    nvlNone "그녀가 예상하지 못한 순간에 기구를 눌렀다." id plotexternal_f71c5ed4


translate japanese plotexternal_07d85d0d:

    nvlNone "라이라를 바라보며 6년 전의 우리와 지금을 떠올렸다.\n여러 감정이 가슴에 차올랐다." id plotexternal_07d85d0d


translate japanese plotexternal_0b3cacc0:

    nvlNone "내뱉은 연기가 몸 주위를 맴돌았다. 지난번 같은 죄책감은 없었다." id plotexternal_0b3cacc0


translate japanese plotexternal_56269b12:

    nvlNone "해방감을 느끼는 동시에 가슴속 빈자리가 나를 더욱 괴롭혔다." id plotexternal_56269b12 (**end_page())


translate japanese plotexternal_407ea318:

    nvlNone "여기까지 오려면,\n적어도 한 시간 전에는 일어났을 텐데. 조금 의외였다." id plotexternal_407ea318 (**end_page())


translate japanese plotexternal_8d5d8248:

    nvlNone "이 근처에는 은퇴한 사람이 많다." id plotexternal_8d5d8248


translate japanese plotexternal_a62ba48d:

    nvlNone "유럽에서 안정적으로 살던 그녀는 가족을 데리고 나를 따라 이사 왔다." id plotexternal_a62ba48d

translate japanese strings:
    old "「终将重合的渐近线」　完"
    new "「점근선이 겹치는 숙명」　끝"


translate japanese plotexternal_965facef:

    nvlNone "몸을 돌린 라이라는 아직 뚫지 않은 쪽 귀를 내게 향했다." id plotexternal_965facef


translate japanese plotexternal_d3c668e5:

    nvlNone "시거나 매운 걸 먹으면 금세 땀을 흘린다." id plotexternal_d3c668e5


translate japanese plotexternal_740d8be5:

    nvlNone "그때 반응한 건 이 냄새였던 거야!" id plotexternal_740d8be5


translate japanese plotexternal_0a76bdb7:

    nvlNone "나나 상대가 변하면 금세 알아차리게 된다." id plotexternal_0a76bdb7 (**end_page())


translate japanese plotexternal_714243be:

    nvlNone "걸어가면 30분 넘게 걸릴 것 같다." id plotexternal_714243be


translate japanese plotexternal_13461a31:

    nvlNone "라이라는 내 만류를 무시하고,{p}욕조 맞은편 구석에 털썩 앉아 나와 마주했다." id plotexternal_13461a31


translate japanese plotexternal_a0a1f8a4:

    nvlNone "왼쪽 눈을 비비자,{p}손이 닿은 곳이 따갑고 가려웠다. 조금 부은 것 같았다." id plotexternal_a0a1f8a4


translate japanese plotexternal_03d47a88:

    nvlNone "누군가 내 걱정을 해 주는 건 오랜만이었다.{p}마지막으로 이렇게 신경 써 준 건 본가의 집사였다." id plotexternal_03d47a88


translate japanese plotexternal_8a0e21f7:

    nvlNone "하지만 그녀는 이것보다 훨씬 꼴사나운 모습까지 알고 있다.{p}이런 일로 동요할 필요는 없을 텐데." id plotexternal_8a0e21f7

translate japanese plot10_intro_shortcuts_enabled_24492d0a:



    voice "voice/hecheng_276.ogg"
    hecheng "민영아, 널 곁에 두길 잘했어."


translate japanese plot10_intro_shortcuts_enabled_138f4330:



    voice "voice/hecheng_277.ogg"
    hecheng "너랑 희진, 그 멍청이 둘은 늘 다른 누구도 줄 수 없는 즐거움을 주거든."


translate japanese plot10_intro_shortcuts_enabled_d1f583ac:



    voice "voice/minying_40.ogg"
    minying "무, 무슨 뜻이야…"


translate japanese plot10_intro_shortcuts_enabled_372246fd:



    voice "voice/hecheng_278.ogg"
    hecheng "거짓말을 너무 못하잖아. 이 병신아."


translate japanese plot10_intro_shortcuts_enabled_f3389d97:



    voice "voice/hecheng_279.ogg"
    hecheng "그렇게 떠들어 놓고 진심이었던 건 마지막에 살려 달라고 빈 말뿐이지."


translate japanese plot10_intro_shortcuts_enabled_77fe12a6:



    voice "voice/hecheng_280.ogg"
    hecheng "네 거짓말 따위, 다들 진작 알아챘어."


translate japanese plot10_intro_shortcuts_enabled_edca7b09:



    voice "voice/hecheng_281.ogg"
    hecheng "특히 반장은 너랑 희진이 어떤 인간인지 제일 잘 아니까."


translate japanese plot10_intro_shortcuts_enabled_29cf1889:



    voice "voice/minying_41.ogg"
    minying "ち、違うの！委員長！" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot10_intro_shortcuts_enabled_845e1fd2:



    voice "voice/minying_42.ogg"
    minying "전부 진심이에요! 정말, 제대로 반성하고 있어요!"


translate japanese plot10_intro_shortcuts_enabled_be7f91ec:



    voice "voice/minying_43.ogg"
    minying "츠루기 말은 듣지 마! 미안해요, 미안해요! 정말… 못할 짓을…"


translate japanese plot10_intro_shortcuts_enabled_ba769831:



    voice "voice/hecheng_282.ogg"
    hecheng "すごい。「フール」の役を、ここまでうまく演じられるとは思わなかった。"


translate japanese plot10_intro_shortcuts_enabled_5928a022:



    voice "voice/hecheng_283.ogg"
    hecheng "뭐, 네가 진심으로 반성한다 해도,"


translate japanese plot10_intro_shortcuts_enabled_9b1c697f:



    voice "voice/hecheng_284.ogg"
    hecheng "반장이 용서해 줄 것 같아?"


translate japanese plot10_intro_shortcuts_enabled_f784d44e:



    voice "voice/hecheng_285.ogg"
    hecheng "그렇지, 반장님?"


translate japanese plot10_intro_shortcuts_enabled_bcb601a8:



    voice "voice/hecheng_286.ogg"
    hecheng "이제 착한 애인 척은 그만해."


translate japanese plot10_intro_shortcuts_enabled_b83da62e:



    voice "voice/banzhang_705.ogg"
    banzhang2 "후후…"


translate japanese plot10_intro_shortcuts_enabled_e09c17ec:



    voice "voice/minying_44.ogg"
    minying "그… 그만해! 기다려!"


translate japanese plot10_intro_shortcuts_enabled_58276930:



    voice "voice/minying_45.ogg"
    minying "반장! 잠깐, 그만해, 난 정말…"


translate japanese plot10_intro_shortcuts_enabled_dcb00463:



    voice "voice/minying_46.ogg"
    minying "그만해, 그만해, 그만해, 그만해, 그만해, 그만해, 그만해, 그만해――"


translate japanese plot10_intro_shortcuts_enabled_369ddaa4:



    voice "voice/minying_47.ogg"
    minying "그만해애――!!!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot10_intro_shortcuts_enabled_e172202e:



    voice "voice/tianqin_2091.ogg"
    tianqin "그만해! 반장!"


translate japanese plot10_intro_shortcuts_enabled_528952d7_1:


    "푸슉――!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot10_intro_shortcuts_enabled_18e2acf2:


    "반장이 아까처럼 가볍게 손을 한 번 휘두르자, 바닥에는 텅 빈 가죽 주머니가 또 하나 늘었다."


translate japanese plot10_intro_shortcuts_enabled_01166793:


    "새빨간 피안개가 곧장 피어올랐고, 공기에는 코를 찌르는 쇠 비린내가 가득 찼다."


translate japanese plot10_intro_shortcuts_enabled_9e1c24fc:



    voice "voice/banzhang_706.ogg"
    banzhang2 "ごめんね、ライラさん。もう戻れないの。"


translate japanese plot10_intro_shortcuts_enabled_fdea2401:



    voice "voice/banzhang_707.ogg"
    banzhang2 "아무리 당신이라도, 저를 막을 수는 없어요."


translate japanese plot10_intro_shortcuts_enabled_3a0c8614:



    voice "voice/hecheng_287.ogg"
    hecheng "하핫… 하하하하하――!"


translate japanese plot10_intro_shortcuts_enabled_06beb6c8:


    "츠루기는 옆에 떨어진 가죽 두 장을 보고도 두려워하지 않았다."


translate japanese plot10_intro_shortcuts_enabled_5ac1d919:


    "오히려 아직도 웃고 있었다."


translate japanese plot10_intro_shortcuts_enabled_4878f689:



    voice "voice/hecheng_288.ogg"
    hecheng "기분이 어때? 반장."


translate japanese plot10_intro_shortcuts_enabled_c8f4f9c3_1:



    voice "voice/banzhang_708.ogg"
    banzhang2 "…"


translate japanese plot10_intro_shortcuts_enabled_326313c3:



    voice "voice/hecheng_289.ogg"
    hecheng "「이제 돌아갈 수 없어」라고?"


translate japanese plot10_intro_shortcuts_enabled_abc5d073:



    voice "voice/hecheng_290.ogg"
    hecheng "자기는 잘못 없다고 말하고 싶은 거야? 아니면 그렇게 생각해야 조금이라도 마음이 편해져?"


translate japanese plot10_intro_shortcuts_enabled_4c0b372c:



    voice "voice/hecheng_291.ogg"
    hecheng "ああ――違う。罪悪感より、今は気持ちよさのほうが強いんだろう？"


translate japanese plot10_intro_shortcuts_enabled_a3995392:



    voice "voice/hecheng_292.ogg"
    hecheng "이 살・인・자."


translate japanese plot10_intro_shortcuts_enabled_05e61f09:



    voice "voice/banzhang_709.ogg"
    banzhang2 "너랑 똑같이 취급하지 마, 츠루기."


translate japanese plot10_intro_shortcuts_enabled_c699a1dd:



    voice "voice/hecheng_293.ogg"
    hecheng "후후, 후후후――"


translate japanese plot10_intro_shortcuts_enabled_9277eb54:


    "희진과 민영의 죽음은 츠루기의 마음을 조금도 흔들지 못했다."


translate japanese plot10_intro_shortcuts_enabled_60c91a66:


    "그저 재미있다는 듯 모든 걸 지켜보고 있었다."


translate japanese plot10_intro_shortcuts_enabled_b1cbd70b:


    "동물을 괴롭힐 때와 똑같이."


translate japanese plot10_intro_shortcuts_enabled_49bf9f3d:



    voice "voice/hecheng_294.ogg"
    hecheng "알아? 파괴 행위와 번식 행위는 사실 무척 비슷해."


translate japanese plot10_intro_shortcuts_enabled_f017bcd2:



    voice "voice/hecheng_295.ogg"
    hecheng "손이 떨리고, 감정이 고조되고, 아드레날린이 치솟지."


translate japanese plot10_intro_shortcuts_enabled_4b2333f2:



    voice "voice/hecheng_296.ogg"
    hecheng "생명을 빼앗는 일과 생명을 낳는 일… 그러니까 살육과 교미는 의외로 같을지도 몰라."


translate japanese plot10_intro_shortcuts_enabled_2611bab7:



    voice "voice/banzhang_710.ogg"
    banzhang2 "――김 선생님을 좋아하죠?"


translate japanese plot10_intro_shortcuts_enabled_6e34131d:



    voice "voice/hecheng_297.ogg"
    hecheng "호오?"


translate japanese plot10_intro_shortcuts_enabled_15397c77:



    voice "voice/banzhang_711.ogg"
    banzhang2 "너와 접하게 된 뒤의 기억을 되짚어 봤어요."


translate japanese plot10_intro_shortcuts_enabled_771ae042:



    voice "voice/banzhang_712.ogg"
    banzhang2 "제 체육 시험 결과가 너보다 좋았던 그때부터, 너는 몹시 짜증이 난 것처럼 보였어요."


translate japanese plot10_intro_shortcuts_enabled_f8b556b9:



    voice "voice/banzhang_713.ogg"
    banzhang2 "그래서 저를 괴롭힐 상대로 골랐어요. 그렇죠?"


translate japanese plot10_intro_shortcuts_enabled_e9fbf2d7:



    voice "voice/hecheng_298.ogg"
    hecheng "후후…"


translate japanese plot10_intro_shortcuts_enabled_b3a421e6:



    voice "voice/banzhang_714.ogg"
    banzhang2 "희진과 민영을 곁에 둔 건, 김 선생님과 같은 민족이기 때문인가요?"


translate japanese plot10_intro_shortcuts_enabled_ef6d256c:



    voice "voice/banzhang_715.ogg"
    banzhang2 "그 둘에게서 김 선생님과 비슷한 모습을 봤으니까――"


translate japanese plot10_intro_shortcuts_enabled_612f2b87:



    voice "voice/hecheng_299.ogg"
    hecheng "됐어. 그 멍청이 둘을 김 선생님하고 같은 취급 하지 마."


translate japanese plot10_intro_shortcuts_enabled_f433fdae:



    voice "voice/hecheng_300.ogg"
    hecheng "그래. 맞아."


translate japanese plot10_intro_shortcuts_enabled_74a83e2b:



    voice "voice/hecheng_301.ogg"
    hecheng "난 선생님을 좋아해… 아니, 사랑한다고 하는 게 맞겠네."


translate japanese plot10_intro_shortcuts_enabled_dbf32ad1:



    voice "voice/hecheng_302.ogg"
    hecheng "김 선생님을 진심으로 사랑해."


translate japanese plot10_intro_shortcuts_enabled_c591b1cd:



    voice "voice/hecheng_303.ogg"
    hecheng "처음 만났을 때부터 완전히 마음을 빼앗겼어."


translate japanese plot10_intro_shortcuts_enabled_5a08b673:



    voice "voice/hecheng_304.ogg"
    hecheng "이런 감정은 지금껏 한 번도 느껴 본 적 없었지."


translate japanese plot10_intro_shortcuts_enabled_c470f71a:



    voice "voice/hecheng_305.ogg"
    hecheng "동경. 사모. 갈망 같은 감정…"


translate japanese plot10_intro_shortcuts_enabled_3a3a44ee:



    voice "voice/hecheng_306.ogg"
    hecheng "그 강렬한 욕망은… 고양이나 개를 죽이며 얻은 쾌감으로도 채울 수 없는 굶주림과 갈증이었어."


translate japanese plot10_intro_shortcuts_enabled_c9072426:



    voice "voice/hecheng_307.ogg"
    hecheng "너라면 이 기분, 알겠지?"


translate japanese plot10_intro_shortcuts_enabled_c8f4f9c3_2:



    voice "voice/banzhang_716.ogg"
    banzhang2 "…"


translate japanese plot10_intro_shortcuts_enabled_1ce2391a:



    voice "voice/hecheng_308.ogg"
    hecheng "그 뒤로 네 기록은 점점 좋아졌어."


translate japanese plot10_intro_shortcuts_enabled_bc06c51a:



    voice "voice/hecheng_309.ogg"
    hecheng "날 앞지르고 나서는 눈엣가시 같아서 견딜 수 없었지."


translate japanese plot10_intro_shortcuts_enabled_ce005d14:



    voice "voice/hecheng_310.ogg"
    hecheng "선생님 눈에 나보다 뛰어난 존재가 비치는 게 싫었으니까."


translate japanese plot10_intro_shortcuts_enabled_f06f3164:



    voice "voice/hecheng_311.ogg"
    hecheng "바로 그때, 네가 갑자기 내게 부탁을 해 왔어."


translate japanese plot10_intro_shortcuts_enabled_dedbf71e:



    voice "voice/hecheng_312.ogg"
    hecheng "불이 붙은 건 그때였을지도 모르겠네."


translate japanese plot10_intro_shortcuts_enabled_c8f4f9c3_3:



    voice "voice/banzhang_717.ogg"
    banzhang2 "…"


translate japanese plot10_intro_shortcuts_enabled_da9b4446:



    voice "voice/hecheng_313.ogg"
    hecheng "「고작 그런 것 때문에?」"


translate japanese plot10_intro_shortcuts_enabled_feaee32f:



    voice "voice/hecheng_314.ogg"
    hecheng "そう思ってる？"


translate japanese plot10_intro_shortcuts_enabled_c8f4f9c3_4:



    voice "voice/banzhang_718.ogg"
    banzhang2 "…"


translate japanese plot10_intro_shortcuts_enabled_af680c40:



    voice "voice/hecheng_315.ogg"
    hecheng "있잖아, 라이라."


translate japanese plot10_intro_shortcuts_enabled_9f6a51fd_1:



    voice "voice/tianqin_2092.ogg"
    tianqin "――！"


translate japanese plot10_intro_shortcuts_enabled_fd7b1279:



    voice "voice/hecheng_316.ogg"
    hecheng "너도 그렇게 생각해?"


translate japanese plot10_intro_shortcuts_enabled_b966896a:



    voice "voice/hecheng_317.ogg"
    hecheng "「그런 이유로 같은 반 애를 괴롭힌 거야?」 같은 거."


translate japanese plot10_intro_shortcuts_enabled_da114801:



    voice "voice/hecheng_318.ogg"
    hecheng "그 「이유」 때문이야, 반장."


translate japanese plot10_intro_shortcuts_enabled_366f7a68:



    voice "voice/hecheng_319.ogg"
    hecheng "私も、自分のやり方で欲しいものを追ってただけ。"


translate japanese plot10_intro_shortcuts_enabled_c0363666:



    voice "voice/hecheng_320.ogg"
    hecheng "네가 엄마를 목표로 삼는 것과 똑같아."


translate japanese plot10_intro_shortcuts_enabled_b7cb20a5:



    voice "voice/banzhang_719.ogg"
    banzhang2 "똑같지 않아…"


translate japanese plot10_intro_shortcuts_enabled_58c25e3f:



    voice "voice/hecheng_321.ogg"
    hecheng "사람은 저마다 다른 길을 살아. 다른 경험은 다른 가치관을 만들지."


translate japanese plot10_intro_shortcuts_enabled_c8dbf12c:



    voice "voice/hecheng_322.ogg"
    hecheng "똑같은 걸 보더라도, 사람마다 가치를 판단하는 기준이 달라."


translate japanese plot10_intro_shortcuts_enabled_9ab29281:



    voice "voice/hecheng_323.ogg"
    hecheng "너희 눈에는 우습게 보이는 이 짝사랑이, 내게는 삶의 거의 전부야."


translate japanese plot10_intro_shortcuts_enabled_0db2d5b2:



    voice "voice/hecheng_324.ogg"
    hecheng "마찬가지로, 네겐 무엇보다 소중한 엄마겠지만 내게 그 죽음은 조금 안타까운 일일 뿐이었어."


translate japanese plot10_intro_shortcuts_enabled_f30b5262:


    banzhang2 "츠루기!"


translate japanese plot10_intro_shortcuts_enabled_c7f84b0f:



    voice "voice/hecheng_325.ogg"
    hecheng "나도 그 둘처럼 텅 비게 만들 거야?"


translate japanese plot10_intro_shortcuts_enabled_330b78f7:



    voice "voice/hecheng_326.ogg"
    hecheng "해 봐. 오히려 기다리고 있었어."


translate japanese plot10_intro_shortcuts_enabled_7b309edf:



    voice "voice/banzhang_721.ogg"
    banzhang2 "너――!"


translate japanese plot10_intro_shortcuts_enabled_f3100e2f:



    voice "voice/hecheng_327.ogg"
    hecheng "今日、私が殺されることは分かってた。だから怖くない。"


translate japanese plot10_intro_shortcuts_enabled_eee35ae9:



    voice "voice/hecheng_328.ogg"
    hecheng "난 잘못 없다고 하진 않을게. 그냥 내 생각을 말하는 것뿐이야."


translate japanese plot10_intro_shortcuts_enabled_ff8d22a3:



    voice "voice/hecheng_329.ogg"
    hecheng "라이라, 너도 그렇지?"


translate japanese plot10_intro_shortcuts_enabled_cd7c6a43:



    voice "voice/tianqin_2093.ogg"
    tianqin "뭐가?"


translate japanese plot10_intro_shortcuts_enabled_3628bc92:



    voice "voice/hecheng_330.ogg"
    hecheng "아까 반장 어머니가 교통사고로 돌아가셨다는 걸 알았어도, 그렇게 슬프지는 않았잖아?"


translate japanese plot10_intro_shortcuts_enabled_bcffd54a:



    voice "voice/hecheng_331.ogg"
    hecheng "아무 감정도 없었다는 건 아니야. 하지만 대부분의 사람은 그런 소식을 들어도 「내 가족이 아니라 다행이다」 정도만 생각하잖아."


translate japanese plot10_intro_shortcuts_enabled_ff2b9845:



    voice "voice/tianqin_2094.ogg"
    tianqin "아니야, 나는…"


translate japanese plot10_intro_shortcuts_enabled_7be56e06:



    voice "voice/hecheng_332.ogg"
    hecheng "아니라고 단언할 수 있어? 라이라."


translate japanese plot10_intro_shortcuts_enabled_12342666:



    voice "voice/hecheng_333.ogg"
    hecheng "네 친절로 온 세상 사람들을 구할 수 있다고 생각해?"


translate japanese plot10_intro_shortcuts_enabled_71e08e60_2:



    voice "voice/tianqin_2095.ogg"
    tianqin "…"


translate japanese plot10_intro_shortcuts_enabled_020959ac:



    voice "voice/hecheng_334.ogg"
    hecheng "그렇잖아. 우리한테는 그렇게 강한 공감 능력이 없어. 누구나 자신이 가장 소중하니까."


translate japanese plot10_intro_shortcuts_enabled_5acf50e6:



    voice "voice/hecheng_335.ogg"
    hecheng "네겐 소중한 엄마. 내겐 소중한 사랑."


translate japanese plot10_intro_shortcuts_enabled_c19e11fc:



    voice "voice/hecheng_336.ogg"
    hecheng "다른 사람들한테는 둘 다 대단한 일이 아니야."


translate japanese plot10_intro_shortcuts_enabled_43942ea5:



    voice "voice/banzhang_722.ogg"
    banzhang2 "엄마의 목숨에는 아무 가치도 없었다는 건가요?"


translate japanese plot10_intro_shortcuts_enabled_774e2dc0:



    voice "voice/hecheng_337.ogg"
    hecheng "아니, 물론 아니지."


translate japanese plot10_intro_shortcuts_enabled_0be3c1bf:



    voice "voice/hecheng_338.ogg"
    hecheng "내 말은, 너도 나와 같은 짓을 하고 있다는 거야. 반장."


translate japanese plot10_intro_shortcuts_enabled_cd227c31:



    voice "voice/hecheng_339.ogg"
    hecheng "――自分の欲のために、ほかの人間を好きなように踏みつけている。"


translate japanese plot10_intro_shortcuts_enabled_98bcb1af:



    voice "voice/hecheng_340.ogg"
    hecheng "아직도 모르겠어?"


translate japanese plot10_intro_shortcuts_enabled_c8f4f9c3_5:



    voice "voice/banzhang_723.ogg"
    banzhang2 "…"


translate japanese plot10_intro_shortcuts_enabled_0ff752b7:



    voice "voice/hecheng_341.ogg"
    hecheng "ふふふ…結局、あんたも私と同じだったね。"


translate japanese plot10_intro_shortcuts_enabled_e8ec6559:



    voice "voice/hecheng_342.ogg"
    hecheng "지금 너한테는 나와 같은 위치에 설 수 있는 힘이 있어."


translate japanese plot10_intro_shortcuts_enabled_66bc298d:



    voice "voice/hecheng_343.ogg"
    hecheng "네 뜻대로… 뭐든 할 수 있지."


translate japanese plot10_intro_shortcuts_enabled_22cc97b2:



    voice "voice/hecheng_344.ogg"
    hecheng "私の机に死んだ白ネズミを入れ、みんなに私たちを馬鹿にさせることも、こうして簡単に私たちを殺すことも。"


translate japanese plot10_intro_shortcuts_enabled_103eefb9:



    voice "voice/hecheng_345.ogg"
    hecheng "자유롭지? 이게 「힘」이야."


translate japanese plot10_intro_shortcuts_enabled_1de14d2d:



    voice "voice/hecheng_346.ogg"
    hecheng "結局、この世界は弱肉強食。"


translate japanese plot10_intro_shortcuts_enabled_39f5a3ee:



    voice "voice/hecheng_347.ogg"
    hecheng "규칙은 강자를 보호하고, 질서는 약자를 억압하지."


translate japanese plot10_intro_shortcuts_enabled_5018bc52:



    voice "voice/hecheng_348.ogg"
    hecheng "돈 있는 사람은 가난한 사람을, 권력 있는 사람은 힘없는 사람을 장난감으로 삼아."


translate japanese plot10_intro_shortcuts_enabled_ded27faa:



    voice "voice/hecheng_349.ogg"
    hecheng "――나와 너처럼."


translate japanese plot10_intro_shortcuts_enabled_ff1df840:



    voice "voice/hecheng_350.ogg"
    hecheng "지금은 그저 둘의 처지가 뒤바뀌었을 뿐이야."


translate japanese plot10_intro_shortcuts_enabled_65402ac0:



    voice "voice/hecheng_351.ogg"
    hecheng "기분이 어때? 반장."


translate japanese plot10_intro_shortcuts_enabled_f2bd83af:



    voice "voice/hecheng_352.ogg"
    hecheng "남을 짓밟는 건 즐겁지? 그 둘은 네게 저항조차 못 했잖아."


translate japanese plot10_intro_shortcuts_enabled_7bd0c607:



    voice "voice/hecheng_353.ogg"
    hecheng "죽였을 때 기분은, 그 개를 죽였을 때랑 같았어?"


translate japanese plot10_intro_shortcuts_enabled_8c449b6b:



    voice "voice/hecheng_354.ogg"
    hecheng "그래서 말했잖아. 분명 나를 이해할 거라고. 같은 냄새가 났으니까."


translate japanese plot10_intro_shortcuts_enabled_cb69f0ba:


    banzhang2 "그만해! 우리는 달라!"


translate japanese plot10_intro_shortcuts_enabled_7ccdee2e:



    voice "voice/banzhang_725.ogg"
    banzhang2 "난 네가 한 짓만큼 대가를 치르게 하고 싶을 뿐이야!"


translate japanese plot10_intro_shortcuts_enabled_c0fb920a:



    voice "voice/hecheng_355.ogg"
    hecheng "후후후… 그럼 재미있는 얘기 하나 더 해 줄게."


translate japanese plot10_intro_shortcuts_enabled_f0ec60fb:



    voice "voice/hecheng_356.ogg"
    hecheng "네 어머니 사고는 나와 상관없어."


translate japanese plot10_intro_shortcuts_enabled_e4f33601:



    voice "voice/hecheng_357.ogg"
    hecheng "어제 거기 있었던 것도 우연일 뿐이야."


translate japanese plot10_intro_shortcuts_enabled_a90f4f5e:



    voice "voice/banzhang_726.ogg"
    banzhang2 "…그럴 리 없어."


translate japanese plot10_intro_shortcuts_enabled_c46a9120:



    voice "voice/banzhang_727.ogg"
    banzhang2 "누군가에게 시킨 건 너야."


translate japanese plot10_intro_shortcuts_enabled_cec3bccb:



    voice "voice/hecheng_358.ogg"
    hecheng "훗. 현대 사회가 돌아가는 방식을 너무 쉽게 보네."


translate japanese plot10_intro_shortcuts_enabled_7cf3681a:



    voice "voice/hecheng_359.ogg"
    hecheng "내가 죽기를 바라면 누구든 정말로 죽는다니. 그게 말이나 돼?"


translate japanese plot10_intro_shortcuts_enabled_e57a6d60:



    voice "voice/hecheng_360.ogg"
    hecheng "確かに私は悪人。でも、そこまでは…"


translate japanese plot10_intro_shortcuts_enabled_b4e8fb87:


    banzhang2 "내 앞에서 연기하지 마!"


translate japanese plot10_intro_shortcuts_enabled_c9348209:



    voice "voice/banzhang_729.ogg"
    banzhang2 "작년에 체육 특기생이 죽은 일에도 네가 관련돼 있었지."


translate japanese plot10_intro_shortcuts_enabled_fc8a4d37:



    voice "voice/hecheng_361.ogg"
    hecheng "걔는 스스로 뛰어내린――"


translate japanese plot10_intro_shortcuts_enabled_65f1e8db_4:



    voice "voice/hecheng_362.ogg"
    hecheng "…"


translate japanese plot10_intro_shortcuts_enabled_60aa5a7b:



    voice "voice/banzhang_730.ogg"
    banzhang2 "どうして続かないのか？"


translate japanese plot10_intro_shortcuts_enabled_a7933635:



    voice "voice/banzhang_731.ogg"
    banzhang2 "뉴스에서는 「실종」됐다고만 전해졌어요. 그런데 뛰어내렸다는 건 어떻게 알아?"


translate japanese plot10_intro_shortcuts_enabled_0fa24dd0:



    voice "voice/banzhang_732.ogg"
    banzhang2 "그때 현장에 있었지."


translate japanese plot10_intro_shortcuts_enabled_88251353:



    voice "voice/hecheng_363.ogg"
    hecheng "흥…"


translate japanese plot10_intro_shortcuts_enabled_ef99a92b:



    voice "voice/banzhang_733.ogg"
    banzhang2 "거의 일 년이 다 됐지만 기억해. 그 애는 작년에 가장 성적이 좋았던 체육 특기생이었어."


translate japanese plot10_intro_shortcuts_enabled_0b4da59e:



    voice "voice/banzhang_734.ogg"
    banzhang2 "너는 분명 그 사람한테도 똑같은 짓을 했을 거야. 나한테 한 것처럼."


translate japanese plot10_intro_shortcuts_enabled_9c00436d:



    voice "voice/banzhang_735.ogg"
    banzhang2 "그 애가 실종된 건… 아니, 결국 네가 그 애를 죽음으로 내몬 거겠지."


translate japanese plot10_intro_shortcuts_enabled_4868a327:



    voice "voice/hecheng_364.ogg"
    hecheng "말했잖아? …걔가 자기 발로 뛰어내렸어. 나랑은 상관없어."


translate japanese plot10_intro_shortcuts_enabled_c0a585d4:



    voice "voice/banzhang_736.ogg"
    banzhang2 "네가 죽게 한 거야."


translate japanese plot10_intro_shortcuts_enabled_a64f7715:



    voice "voice/banzhang_737.ogg"
    banzhang2 "엄마가 나를 밀지 않았다면, 그 차에 치인 건 나였어."


translate japanese plot10_intro_shortcuts_enabled_337403cc:



    voice "voice/banzhang_738.ogg"
    banzhang2 "그리고 너는 옆에서 그걸 즐기고 있었지."


translate japanese plot10_intro_shortcuts_enabled_2fe8c6c3:



    voice "voice/banzhang_739.ogg"
    banzhang2 "넌 목숨을 티끌만도 못하게 여기는 인간이야."


translate japanese plot10_intro_shortcuts_enabled_f7117cef:



    voice "voice/banzhang_740.ogg"
    banzhang2 "동물도, 사람도. 네겐 아무 의미 없지."


translate japanese plot10_intro_shortcuts_enabled_5c0b653f:



    voice "voice/hecheng_365.ogg"
    hecheng "후… 후후후…"


translate japanese plot10_intro_shortcuts_enabled_53969ede:



    voice "voice/hecheng_366.ogg"
    hecheng "最後になって、あなたにそこを突かれるとは思わなかった。"


translate japanese plot10_intro_shortcuts_enabled_8da249a5:



    voice "voice/hecheng_367.ogg"
    hecheng "뭐, 아무래도 좋아."


translate japanese plot10_intro_shortcuts_enabled_bc0c1bfa:



    voice "voice/hecheng_368.ogg"
    hecheng "それで、どうする？"


translate japanese plot10_intro_shortcuts_enabled_b46e23b9:



    voice "voice/hecheng_369.ogg"
    hecheng "あの二人と同じように、私を血と肉のしぶきにするのか？"


translate japanese plot10_intro_shortcuts_enabled_2f1844e5:



    voice "voice/hecheng_370.ogg"
    hecheng "말했잖아. 난 무섭지 않아."


translate japanese plot10_intro_shortcuts_enabled_12c84949:



    voice "voice/hecheng_371.ogg"
    hecheng "私から反省の言葉を聞きたいなら、諦めたほうがいいよ。"


translate japanese plot10_intro_shortcuts_enabled_7945821f:



    voice "voice/banzhang_741.ogg"
    banzhang2 "아니. 널 편히 죽게 두지는 않아."


translate japanese plot10_intro_shortcuts_enabled_1bfe537a:



    voice "voice/banzhang_742.ogg"
    banzhang2 "네가 한 짓은 너무나 끔찍해."


translate japanese plot10_intro_shortcuts_enabled_9db9745d:



    voice "voice/banzhang_743.ogg"
    banzhang2 "나뿐만이 아니야. 괴롭힘을 당한 사람은 더 있어."


translate japanese plot10_intro_shortcuts_enabled_60021086:



    voice "voice/banzhang_744.ogg"
    banzhang2 "네가 사라져도, 그 사람들은 앞으로도 네 그림자에 떨며 살아가겠지."


translate japanese plot10_intro_shortcuts_enabled_2d05a120:



    voice "voice/banzhang_745.ogg"
    banzhang2 "그러니까――너를 이 세계에서 뿌리째 없애겠어."


translate japanese plot10_intro_shortcuts_enabled_aad7bf04:



    voice "voice/hecheng_372.ogg"
    hecheng "――뭐?"


translate japanese plot10_intro_shortcuts_enabled_e5d0da68:



    voice "voice/banzhang_746.ogg"
    banzhang2 "철저하게, 철저하게, 철저하게 이 세상에서 지워 버리겠어."


translate japanese plot10_intro_shortcuts_enabled_110db874:



    voice "voice/banzhang_747.ogg"
    banzhang2 "「나의 살, 나의 뼈, 나의 영혼을 걸고 맹세하노라.」"


translate japanese plot10_intro_shortcuts_enabled_558df953:



    voice "voice/banzhang_748.ogg"
    banzhang2 "「너도 나도 이 세계에서 사라져, 함께 소멸의 소용돌이로 향하리라.」"


translate japanese plot10_intro_shortcuts_enabled_8d37205a:


    cygnus "마도구!"


translate japanese plot10_intro_shortcuts_enabled_0625082c:


    "반장의 영창에 맞춰, 그 몸에서 마법의 빛이 서서히 떠올랐다."


translate japanese plot10_intro_shortcuts_enabled_f52094d0:


    "곁에서 오랫동안 마력을 모으던 시노스도 같은 순간 마력을 한꺼번에 방출했다."


translate japanese plot10_intro_shortcuts_enabled_268d01c3:


    "압도적인 마력이 반장 주변을 뒤덮은 역장을 뚫고, 머리 위의 왕관에 닿았다."


translate japanese plot10_intro_shortcuts_enabled_4b6459f5:



    voice "voice/cygnus_1177.ogg"
    cygnus "명한다. 멈춰라."


translate japanese plot10_intro_shortcuts_enabled_f0488714:


    cygnus "크윽――!"


translate japanese plot10_intro_shortcuts_enabled_821eb407:


    "시노스는 왕관과 마력을 연결하려 했다. 하지만 더 강한 힘에 곧바로 밀려났다."


translate japanese plot10_intro_shortcuts_enabled_887696c7:



    voice "voice/banzhang_749.ogg"
    banzhang2 "조금만 기다려 주세요, 마녀."


translate japanese plot10_intro_shortcuts_enabled_d0640f9c:



    voice "voice/banzhang_750.ogg"
    banzhang2 "곧 돌려드릴 테니까요."


translate japanese plot10_intro_shortcuts_enabled_8c187406:



    voice "voice/banzhang_751.ogg"
    banzhang2 "모든 게 끝난 뒤에…"


translate japanese plot10_intro_shortcuts_enabled_0cc33ae8:



    voice "voice/tianqin_2096.ogg"
    tianqin "반장! 진정해!"


translate japanese plot10_intro_shortcuts_enabled_44be56e6:



    voice "voice/tianqin_2097.ogg"
    tianqin "그렇게 서두르지 마! 분명 다른 방법이 있을 거야!"


translate japanese plot10_intro_shortcuts_enabled_081999ee:



    voice "voice/banzhang_752.ogg"
    banzhang2 "라이라 씨… 미안해요. 결국 이렇게 돼 버렸네요."


translate japanese plot10_intro_shortcuts_enabled_e98d0b5f:



    voice "voice/tianqin_2098.ogg"
    tianqin "아, 안 돼, 반장. 그만해."


translate japanese plot10_intro_shortcuts_enabled_d0b0658e:



    voice "voice/banzhang_753.ogg"
    banzhang2 "괜찮아요, 라이라 씨."


translate japanese plot10_intro_shortcuts_enabled_a516e9a9:



    voice "voice/banzhang_754.ogg"
    banzhang2 "이 마법이면 전부 잊을 수 있어요. 저에 대해서도, 츠루기에 대해서도."


translate japanese plot10_intro_shortcuts_enabled_3220e536:


    tianqin "그만해! 아직 다른 방법이 있다니까!"


translate japanese plot10_intro_shortcuts_enabled_b5af8515:



    voice "voice/banzhang_755.ogg"
    banzhang2 "고마워요, 라이라 씨."


translate japanese plot10_intro_shortcuts_enabled_9e47dfd9:



    voice "voice/banzhang_756.ogg"
    banzhang2 "정말… 다정하시네요."


translate japanese plot10_intro_shortcuts_enabled_7456bc6a:



    voice "voice/banzhang_757.ogg"
    banzhang2 "우리가 가장 힘들었을 때, 당신은 손을 내밀어 주셨어요."


translate japanese plot10_intro_shortcuts_enabled_8e27d7f8:



    voice "voice/banzhang_758.ogg"
    banzhang2 "一番いい終わり方ではなかったけど…私は後悔していません。"


translate japanese plot10_intro_shortcuts_enabled_a6487e24:



    voice "voice/banzhang_759.ogg"
    banzhang2 "고마워요, 라이라 씨… 고마워요…"


translate japanese plot10_intro_shortcuts_enabled_1e47270d:



    voice "voice/banzhang_760.ogg"
    banzhang2 "츠루기. 「허무」를 알아?"


translate japanese plot10_intro_shortcuts_enabled_dbc58535:



    voice "voice/hecheng_373.ogg"
    hecheng "뭐?"


translate japanese plot10_intro_shortcuts_enabled_0258e27a:



    voice "voice/banzhang_761.ogg"
    banzhang2 "「空き」しかない場所。魔女たちが、最後にたどり着こうとするところ。"


translate japanese plot10_intro_shortcuts_enabled_df6fa3b5:



    voice "voice/banzhang_762.ogg"
    banzhang2 "그곳에는 하늘도, 바다도, 땅도 없어."


translate japanese plot10_intro_shortcuts_enabled_7eb61768:



    voice "voice/banzhang_763.ogg"
    banzhang2 "식물도, 동물도, 사람도 없지."


translate japanese plot10_intro_shortcuts_enabled_46adde07:



    voice "voice/banzhang_764.ogg"
    banzhang2 "「사물」이라는 개념조차 없어."


translate japanese plot10_intro_shortcuts_enabled_801bc244:



    voice "voice/banzhang_765.ogg"
    banzhang2 "이름 그대로, 그곳에는 「공허」만이 있을 뿐이야."


translate japanese plot10_intro_shortcuts_enabled_5184da82:



    voice "voice/hecheng_374.ogg"
    hecheng "いったい何が言いたい？"


translate japanese plot10_intro_shortcuts_enabled_56db41cc:



    voice "voice/banzhang_766.ogg"
    banzhang2 "허무에 들어가면 네 모든 것이 사라져. 그 더러운 영혼조차 아무것도 남지 않아."


translate japanese plot10_intro_shortcuts_enabled_4aa8c038:



    voice "voice/banzhang_767.ogg"
    banzhang2 "그것만이 네 죄에 걸맞은 벌이야."


translate japanese plot10_intro_shortcuts_enabled_d2e5c86a:



    voice "voice/hecheng_375.ogg"
    hecheng "하핫… 하하하하하――!"


translate japanese plot10_intro_shortcuts_enabled_454799d6:



    voice "voice/hecheng_376.ogg"
    hecheng "뭐 재미있는 생각이라도 한 줄 알았네."


translate japanese plot10_intro_shortcuts_enabled_3ec60906:



    voice "voice/hecheng_377.ogg"
    hecheng "결국 이런 시시한 생각밖에 못 했구나."


translate japanese plot10_intro_shortcuts_enabled_bf50036e:



    voice "voice/banzhang_768.ogg"
    banzhang2 "そこは、地獄よりも恐ろしい場所だ。"


translate japanese plot10_intro_shortcuts_enabled_4de64d4f:



    voice "voice/banzhang_769.ogg"
    banzhang2 "그 무지를 언젠가 후회하게 될 거야."


translate japanese plot10_intro_shortcuts_enabled_c80c32ba:



    voice "voice/hecheng_378.ogg"
    hecheng "언제까지 질질 끌면서 떠들 거야? 죽이고 싶으면 빨리 해."


translate japanese plot10_void_pair_ward_form_aafe9626:


    "마력이 소용돌이치며 반장의 발밑에 마법진이 펼쳐졌고, 그녀와 츠루기를 감쌌다."


translate japanese plot10_void_pair_ward_form_8ec842e0:



    voice "voice/cygnus_1179.ogg"
    cygnus "이건…!"


translate japanese plot10_void_pair_ward_form_3452211f:


    "그 자리에 있는 누구보다 마력에 민감한 시노스는 곧바로 마법진을 알아차렸다."


translate japanese plot10_void_pair_ward_form_c5e1a644:


    "그리고 마법진에 새겨진 문양을 해독하기 시작했다."


translate japanese plot10_void_pair_ward_form_50fdb5c3:



    voice "voice/cygnus_1180.ogg"
    cygnus "（수많은 노드가 방어에 쓰이고, 작동 노드가 나타내는 의미는 「전이」… 즉, 전송에 가까운 마법이야.）"


translate japanese plot10_void_pair_ward_form_c3fdaab3:


    "해독은 한순간에 끝났다."


translate japanese plot10_void_pair_ward_form_9061a703:


    "이 마법진의 전체 구조는 시노스에게 너무나 간단했다."


translate japanese plot10_void_pair_ward_form_f372e719:


    cygnus "（문제는 전이 목적지를 나타내는 지점이 어디로 이어지는가인데…）"


translate japanese plot10_intro_shortcuts_enabled_a9973061:


    cygnus "（뭐――?）"


translate japanese plot10_void_pair_ward_form_21131bfb:


    "하지만 그 부분만은 해독할 수 없었다."


translate japanese plot10_void_pair_ward_form_5178c700:


    "이 마법진에서 가장 핵심인 노드 하나만은 시노스도 해독하지 못했다."


translate japanese plot10_void_pair_ward_form_8ccd2f61:



    voice "voice/cygnus_1183.ogg"
    cygnus "이건 대체…"


translate japanese plot10_void_pair_ward_form_6e5ad548:


    "시노스는 해독할 수 없는 그 노드를 뚫어져라 바라봤다."


translate japanese plot10_void_pair_ward_form_6b5464b1:


    "아무것도 없는 것처럼 보였지만, 마녀인 그녀는 그곳에 무언가가 「각인」되어 있다는 걸 분명히 느낄 수 있었다."


translate japanese plot10_intro_shortcuts_enabled_04b5d4eb:


    "その「【ナル値｜NULL】」は、記号で表せるものを超えていた。「無」でありながら、同時に「全」でもある。"


translate japanese plot10_void_pair_ward_form_320ae3e5:



    voice "voice/cygnus_1184.ogg"
    cygnus "그럴 수가…"


translate japanese plot10_void_pair_ward_form_7cdb2fae:


    "하나 짚이는 건 있었다. 하지만 확신할 용기는 없었다."


translate japanese plot10_void_pair_ward_form_35f90d5d:


    "수많은 마녀가 일생을 바쳐 추구해 온 하나의 답일지도 모르는 것이, 이토록 간단히 마법진의 노드 하나로 나타나 있었기 때문이다."


translate japanese plot10_void_pair_ward_form_cdbfe133:


    "하지만 눈앞의 마법진은 시노스가 생각했던 것보다도 훨씬 복잡했다."


translate japanese plot10_void_pair_ward_form_f7b118fb:


    cygnus "――형태가 변하고 있어?"


translate japanese plot10_void_pair_ward_form_eba9fbb2:


    "시노스가 본 대로, 마법진의 문양은 끊임없이 변하고 있었다."


translate japanese plot10_void_pair_ward_form_664d8fca:


    "마법진의 문양을 위장하는 마법사가 있다는 건 알고 있었다. 하지만 눈앞의 마법진은 명백히 그 범주를 넘어섰다."


translate japanese plot10_void_pair_ward_form_a7221297:


    "마법진은 분명 조정과 갱신을 거듭하고 있었다. 문양이 바뀔 때마다 작동 상태도 달라졌다."


translate japanese plot10_void_pair_ward_form_fc450ebf:


    "그 모든 변화는 「【널 값｜NULL】」을 나타내는 노드를 담아내기 위한 것이었다."


translate japanese plot10_void_pair_ward_form_0522818d:


    "마치 이 마법이 사용될 미래만 먼저 정해져 있고, 마법진은 그 미래를 구현하기 위한 도구에 불과한 것 같았다."


translate japanese plot10_void_pair_ward_form_0595a28a:


    "그때 시노스는 반장의 기억을 떠올렸다."


translate japanese plot10_void_pair_ward_form_059326ca:


    cygnus "（현실을 고쳐 쓰는 기적… 인과의 역전이라는 건가――）"


translate japanese plot10_void_pair_ward_form_675b8efc:


    "이 세계의 사람에게는 마법의 이치에 관한 지식이 없다. 그것이 오히려 반장이 상상한 대로 마법을 구축하는 힘이 됐다."


translate japanese plot10_void_pair_ward_form_02136925:



    voice "voice/cygnus_1187.ogg"
    cygnus "（그렇군. 그녀 자신이 【법칙｜이치】가 된 거야）"


translate japanese plot10_void_pair_ward_form_8be49795:


    "그 세계의 마법의 이치에 얽매이지 않고,"


translate japanese plot10_void_pair_ward_form_4383658b:


    "반장은 이 세계의 「마법의 이치」를 정의한 것이다."


translate japanese plot10_void_pair_ward_form_183d7799:



    voice "voice/cygnus_1188.ogg"
    cygnus "（생각만으로 무엇이든 고쳐 쓸 수 있어. 지금 그녀는 나보다 강할지도 몰라――）"


translate japanese plot10_void_pair_ward_form_dc557359:


    "하지만 그런 생각을 하고 있을 틈은 없었다."


translate japanese plot10_void_pair_ward_form_218af4d5:


    "시노스는 곧바로 모습을 바꾸고 마력 출력을 최대치로 끌어올린 뒤, 다시 반장의 왕관에 연결을 시도했다."


translate japanese plot10_void_pair_ward_form_84b836db:


    "마법진이 완성되기 전에, 기회를 놓칠 수는 없었다."


translate japanese plot10_intro_shortcuts_enabled_55ade9b7:


    cygnus "크윽――!!"


translate japanese plot10_void_pair_ward_form_2b7382cc:



    voice "voice/banzhang_770.ogg"
    banzhang2 "소용없어요, 마녀."


translate japanese plot10_void_pair_ward_form_9d22fe37:



    voice "voice/cygnus_1190.ogg"
    cygnus "큭!"


translate japanese plot10_void_pair_ward_form_76b4ff96:


    "두 사람의 마력이 충돌했다."


translate japanese plot10_void_pair_ward_form_0d0e5070:


    "시노스의 마력이 반장 가까이에 닿을 듯할 때마다, 더 강한 마력이 그 방향을 비틀어 버렸다."


translate japanese plot10_void_pair_ward_form_4eceb9aa:



    voice "voice/banzhang_771.ogg"
    banzhang2 "포기하세요. 이제 완성됐어요."


translate japanese plot10_void_pair_ward_form_512b09db:


    "충돌이 끝나는 것과 동시에, 마법진이 완전한 형태를 갖췄다."


translate japanese plot10_ward_first_form_bfde1221:


    "단단한 구형 장벽이 펼쳐져, 마법진 안과 밖을 단절했다."


translate japanese plot10_ward_first_block_e2070ee1:


    "시노스의 마력이 일으킨 충격도 모두 밖으로 튕겨 나갔다."


translate japanese plot10_cg170_success_b3161a5e:


    "シノスはすぐにそう思った。"


translate japanese plot10_cg170_success_b206a458:


    "가장 강한 창이 가장 강한 방패를 꿰뚫었다."


translate japanese plot10_cg170_success_a47e909f:


    "장벽은 거대한 충격과 무시무시한 열기에 완전히 부서졌다."


translate japanese plot10_cg170_success_1b09dbdf:


    "시노스는 즉시 마법진 안으로 마력을 침투시켜, 계속 탐색했다."


translate japanese plot10_cg170_success_c68806f1:


    "하지만…"


translate japanese plot10_cg170_outro_chronicle_warning_08eba5e1:


    cygnus "윽!"


translate japanese plot10_cg170_outro_chronicle_warning_535952b2:


    "시노스는 자신의 힘이 빠져나가는 것을 느꼈다."


translate japanese plot10_cg170_outro_chronicle_warning_12eed24b:


    "실은――원래 자신의 것이었던 {a=dictionary:dict_entry_94}힘{/a}을 누군가 사용하고 있었다."


translate japanese plot10_cg170_outro_chronicle_warning_d6e9de25:


    "반장은 손을 뻗어, 무언가를 돌리는 듯한 동작을 했다."


translate japanese plot10_cg170_outro_chronicle_warning_d5aadd3a:


    "눈앞에 마법진이 나타나, 그 움직임에 맞춰 회전하기 시작했다."


translate japanese plot10_ward_rollback_form_012ee156:


    "마법진이 돌자 방어 장벽이 다시 나타나, 시노스의 마력을 튕겨 냈다."


translate japanese plot10_cg170_outro_chronicle_warning_f0488714:


    cygnus "크윽――!"


translate japanese plot10_ward_rollback_clear_851505c5:



    voice "voice/cygnus_1198.ogg"
    cygnus "――어떻게… 장벽이 복구됐지?"


translate japanese plot10_ward_rollback_clear_f299ad57:



    voice "voice/cygnus_1199.ogg"
    cygnus "아니… 시간을 되돌린 건가."


translate japanese plot10_ward_rollback_clear_d81aca86:


    "시노스는 방금 무슨 일이 일어났는지 즉시 이해했다."


translate japanese plot10_ward_rollback_clear_3f263cd0:


    "장벽이 한순간에 복구된 게 아니었다. 반장은 {rb}마도구{/rb}{rt}왕 관{/rt}의 권능을 사용해, 이곳의 시간을 {rb}되감은{/rb}{rt}Rollback{/rt} 것이다."


translate japanese plot10_ward_rollback_clear_f556a6ae:


    "――즉, 불꽃의 창이 부딪히기 전의 마법진으로 되돌린 것이다."


translate japanese plot10_ward_rollback_clear_906d31b2:


    "연기가 걷힌 뒤에도 장벽은 변함없이 바깥의 힘을 막고 있었다."


translate japanese plot10_ward_rollback_clear_d8b420a9:


    "그 마법은 여전히 작동하고 있었다."


translate japanese plot10_ward_rollback_clear_bd32244f:



    voice "voice/cygnus_1200.ogg"
    cygnus "（이제 포기할 수밖에 없는 건가…）"


translate japanese plot10_ward_rollback_clear_36426428:


    "반장이 이토록 능숙하게 마도구를 다룰 수 있게 됐을 줄은 몰랐다."


translate japanese plot10_ward_rollback_clear_7122be31:


    "다시 불꽃의 창을 쏘더라도, 또 시간을 되돌릴 것이다."


translate japanese plot10_ward_rollback_clear_ecec80bb:


    "게다가 마법진은 그만한 여유를 주지 않을 터였다."


translate japanese plot10_ward_rollback_clear_8fe7ccea:


    "얼마나 더 지나야 그 마법이 완성될지는 알 수 없었다."


translate japanese plot10_ward_rollback_clear_49963729:


    "하지만 오랫동안 마법을 써 온 시노스는, 곧 발동하리라는 것을 느낄 수 있었다."


translate japanese plot10_cg170_outro_chronicle_warning_f0488714_1:


    cygnus "크윽――!"


translate japanese plot10_ward_rollback_clear_55569abf:


    "파괴된 그 도시의 광경이 갑자기 뇌리를 스쳤다. 그때와 비슷한 감각이 시노스의 가슴속에 서서히 퍼져 나갔다."


translate japanese plot10_ward_rollback_clear_baacd174:


    "――무력감."


translate japanese plot10_ward_rollback_clear_bea67418:



    voice "voice/tianqin_2100.ogg"
    tianqin "반장, 미안해!"


translate japanese plot10_ward_rollback_clear_c3528d6d:



    voice "voice/tianqin_2101.ogg"
    tianqin "그래도 난 널 막을 거야!!"


translate japanese plot10_ward_punch_one_b5066362:


    "쾅!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot10_ward_punch_one_1d35bd72:



    voice "voice/cygnus_1202.ogg"
    cygnus "뭐!?"


translate japanese plot10_ward_punch_one_58186702:


    "커다란 소리에 놀라 고개를 들자, 라이라가 온 힘을 다해 장벽을 주먹으로 내리치고 있었다."


translate japanese plot10_ward_punch_one_clear_1f0d1588:


    "이어서 한 번 더."


translate japanese plot10_ward_punch_one_clear_560a7b96:



    voice "voice/tianqin_2102.ogg"
    tianqin "하앗――!"


translate japanese plot10_ward_punch_two_b5066362:


    "쾅!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot10_ward_punch_two_38051097:


    "라이라의 주먹이 다시 장벽에 부딪히며, 엄청난 소리가 울려 퍼졌다."


translate japanese plot10_cg170_outro_chronicle_warning_d34b0db2:


    "拳に返ってきた衝撃で、ライラは久しぶりにある感覚を思い出した。"


translate japanese plot10_ward_punch_two_clear_e66d13e0:


    "――통증."


translate japanese plot10_ward_punch_two_clear_b2f2cb8a:



    voice "voice/tianqin_2103.ogg"
    tianqin "쳇――정말 단단하네."


translate japanese plot10_ward_punch_two_clear_0743244e:



    voice "voice/tianqin_2104.ogg"
    tianqin "전에 그 차갑고 커다란 녀석은 건드리기만 해도 부서졌는데."


translate japanese plot10_ward_punch_flurry_dd2ed510:


    "쾅! 쾅! 쾅!" with Shake((0, 0, 0, 0), 1.5, dist=8)


translate japanese plot10_cg170_outro_chronicle_warning_f4fb14cc:


    "ライラはさらに力を入れた。一発ごとに、グレームを砕けるほどの力がある。"


translate japanese plot10_ward_punch_flurry_f8567b92:


    "움켜쥔 주먹은 찢어져 피를 흘리고 있었지만, 전혀 신경 쓰지 않았다."


translate japanese plot10_ward_punch_flurry_clear_7e4aba4b:



    voice "voice/cygnus_1203.ogg"
    cygnus "라이라, 그만해. 그 장벽은 주먹으로 부술 수 있는 게 아니야."


translate japanese plot10_ward_punch_flurry_clear_254dc990:



    voice "voice/tianqin_2105.ogg"
    tianqin "해 보기 전에는 모르잖아!"


translate japanese plot10_ward_punch_flurry_clear_5e7db52d:



    voice "voice/cygnus_1204.ogg"
    cygnus "불가능해…"


translate japanese plot10_ward_punch_flurry_clear_4909e3b0:



    voice "voice/cygnus_1205.ogg"
    cygnus "거기 있다가는 너까지 그 마법에 지워질지도 몰라."


translate japanese plot10_ward_punch_flurry_clear_00acfe7b:



    voice "voice/tianqin_2106.ogg"
    tianqin "아사요."


translate japanese plot10_ward_punch_flurry_clear_0adedce3:


    "라이라는 더 반박하지 않고, 단호한 눈빛으로 시노스를 똑바로 바라봤다."


translate japanese plot10_ward_punch_flurry_clear_3ffaad8e:



    voice "voice/tianqin_2107.ogg"
    tianqin "이걸 부수면 반장을 막을 방법이 있어?"


translate japanese plot10_ward_punch_flurry_clear_9a518cfc:



    voice "voice/cygnus_1206.ogg"
    cygnus "나는…"


translate japanese plot10_ward_punch_flurry_clear_c63b8984:


    "냉정하게 생각하면, 나쁜 결과 쪽이 실제로 일어날 가능성이 높았다."


translate japanese plot10_ward_punch_flurry_clear_776c8c2f:


    "장벽이 없어도, 자신의 마력만으로 그 마법에 간섭하기는 이미 어려웠다."


translate japanese plot10_ward_punch_flurry_clear_73bb1001:



    voice "voice/cygnus_1207.ogg"
    cygnus "…막을 수 있다고 단언할 순 없어. 다만 막을 가능성은 있어."


translate japanese plot10_ward_punch_flurry_clear_1f62f352:


    "하지만 시노스는 막지 않겠다고 말할 수 없었다."


translate japanese plot10_ward_punch_flurry_clear_f95e39bf:


    "라이라의 눈빛이 그렇게 말하고 있었으니까――"


translate japanese plot10_ward_punch_flurry_clear_6d9b6cc4:


    "「나는 포기하지 않아.」"


translate japanese plot10_ward_punch_flurry_clear_4ecefcc2:



    voice "voice/banzhang_774.ogg"
    banzhang2 "왜… 라이라 씨…"


translate japanese plot10_ward_punch_flurry_clear_e34f136b:



    voice "voice/banzhang_775.ogg"
    banzhang2 "왜 그렇게까지…"


translate japanese plot10_cg170_outro_chronicle_warning_ba1c28fa:


    tianqin "너를 두고 갈 수 없으니까!"


translate japanese plot10_ward_punch_flurry_clear_c013340a:



    voice "voice/tianqin_2109.ogg"
    tianqin "돌아와!"


translate japanese plot10_ward_punch_three_b5066362:


    "쾅!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot10_ward_punch_three_d7abb63d:


    "라이라는 다시 장벽을 힘껏 때렸다."


translate japanese plot10_ward_punch_three_1b57152a:


    "주먹에서 피가 튀었고, 손가락 마디의 피부는 완전히 벗겨져 피투성이 살이 드러나 있었다."


translate japanese plot10_ward_punch_three_clear_9fbae4ba:


    "그래도 라이라는 신경 쓰지 않았다."


translate japanese plot10_ward_punch_three_clear_42150caf:


    "반드시 반장을 데려오겠다는, 순수하고 한결같은 믿음이 있었기 때문이다."


translate japanese plot10_ward_punch_three_clear_0e863bf5:



    voice "voice/banzhang_776.ogg"
    banzhang2 "라이라 씨…"


translate japanese plot10_ward_punch_three_clear_882721ed:


    "그때, 시노스는 이상을 감지했다."


translate japanese plot10_ward_punch_three_clear_d93bf20d:


    "――장벽 안을 흐르는 마력에 흐트러짐이 생기고 있다."


translate japanese plot10_ward_punch_three_clear_844060bd:



    voice "voice/cygnus_1208.ogg"
    cygnus "（어떻게 된 거지. 라이라의 힘이 장벽을 관통했나…）"


translate japanese plot10_ward_punch_three_clear_d84e5444:



    voice "voice/cygnus_1209.ogg"
    cygnus "（아니야. 저 소녀 자신이야…）"


translate japanese plot10_ward_punch_three_clear_4525dbfa:


    "시노스는 곧바로 이유를 깨달았다."


translate japanese plot10_ward_punch_three_clear_a7ece6ec:



    voice "voice/cygnus_1210.ogg"
    cygnus "（그녀의 마력은 감정에서 태어났어. 순수한 분노와 증오에서.）"


translate japanese plot10_ward_punch_three_clear_76053bf1:



    voice "voice/cygnus_1211.ogg"
    cygnus "（하지만 라이라라면, 그녀 안에 다른 감정을 싹트게 할 수 있을지도 몰라…）"


translate japanese plot10_ward_punch_three_clear_29dfa0d9:


    "시노스는 곧바로 결론을 내렸다. 라이라라면 할 수 있다. 아니, 라이라만이 할 수 있다."


translate japanese plot10_ward_punch_three_clear_283d912f:


    "그래도 목숨을 건, 그야말로 모 아니면 도인 승부였다."


translate japanese plot10_ward_punch_three_clear_88ca78cf:



    voice "voice/cygnus_1212.ogg"
    cygnus "라이라! 무기로 쓸 만한 걸 찾아!"


translate japanese plot10_ward_punch_three_clear_1e027f08:



    voice "voice/tianqin_2110.ogg"
    tianqin "어? 무기?"


translate japanese plot10_ward_punch_three_clear_3a172fc6:



    voice "voice/cygnus_1213.ogg"
    cygnus "뭐든 좋아! 손에 들 수만 있으면!"


translate japanese plot10_cg170_outro_chronicle_warning_d41d8cd9:


    voice "voice/cygnus_1196.ogg"


translate japanese plot10_cg180_lyra_raise_sign_a981ddb3:


    banzhang2 "크윽――!!"


translate japanese plot10_cg180_lyra_raise_sign_2e504354:


    "まるで発動直前の魔法を無理やり止められたかのように、委員長は激しい眩暈と頭痛に襲われた。"


translate japanese plot10_cg180_lyra_raise_sign_6ec90f46:


    "魔法陣の中にあったバランスが、今の一撃によって崩れた。"


translate japanese plot10_cg180_lyra_raise_sign_9106148d:


    "魔法を守るはずの障壁が、逆に邪魔になった。障壁が壊れたことで、中を流れる魔力は大きく乱れている。"


translate japanese plot10_cg180_lyra_raise_sign_4410a42d:


    "これが、シノスが見つけた勝つための道だった。大きな魔法陣そのものを利用し、逆に委員長を妨害する。"


translate japanese plot10_cg180_lyra_raise_sign_f7006e77:


    "障壁を壊したあとは、シノスの番だ。"


translate japanese plot10_cg180_lyra_raise_sign_baccbf2b:


    "シノスも賭けていた。"


translate japanese plot10_cg180_lyra_raise_sign_6e68a676:


    "今の強い衝撃で委員長が動けなくなり、魔導器の権能を使えなくなることに。"


translate japanese plot10_cg180_lyra_raise_sign_581bdbc4:



    voice "voice/cygnus_1218.ogg"
    cygnus "가라!"


translate japanese plot10_cg180_lyra_raise_sign_db647a28:


    "강렬한 일격은 장벽만 부순 게 아니었다. 표지판에 담긴 마력도 마법진 안으로 때려 넣었다."


translate japanese plot10_cg180_lyra_raise_sign_0202462e:


    "시노스는 표지판에 깃든 거대한 마력을 움직여, 반장의 왕관을 향해 단숨에 몰아갔다."


translate japanese plot10_cg180_lyra_raise_sign_a1984e88:


    banzhang2 "그만해… 방해하지 마――!"


translate japanese plot10_cg180_lyra_raise_sign_d750a0eb:


    "반장은 아까처럼 마력으로 막으려 했다. 하지만 지금은 제대로 움직일 수 없었다."


translate japanese plot10_cg180_lyra_raise_sign_515783d8:


    "현기증과 두통 때문에 집중할 수 없어, 왕관을 움직여 시간을 {rb}되감는{/rb}{rt}Rollback{/rt} 것도 불가능했다."


translate japanese plot10_cg180_lyra_raise_sign_b36677be:


    "시노스의 도박이 성공했다."


translate japanese plot10_cg180_lyra_raise_sign_2f905890:


    "반장의 마력을 피해, 마침내 왕관과 연결하는 데 성공했다."


translate japanese plot10_cg180_lyra_raise_sign_f0488714:


    cygnus "크윽――!"


translate japanese plot10_cg180_lyra_raise_sign_93213c07:


    "마도구와 연결하기만 하면, 주인인 자신의 명령으로 간단히 멈출 수 있을 줄 알았다."


translate japanese plot10_cg180_lyra_raise_sign_009c96a5:


    "하지만 그렇게 간단하지는 않았다."


translate japanese plot10_cg180_lyra_raise_sign_cb18fb44:


    "반장의 왕관은 시노스의 명령을 따르지 않았다."


translate japanese plot10_cg180_lyra_raise_sign_cb2e8e81:


    "반장과 하나가 된 것처럼, 몸에 단단히 달라붙어 있었다."


translate japanese plot10_cg180_lyra_raise_sign_290055ae:


    "시노스에게 돌아가기보다, 그대로 반장 곁에 남고 싶어 하는 것 같았다."


translate japanese plot10_cg180_lyra_raise_sign_37c8ef87:


    "그 모습을 보고, 시노스는 또 다른 사역마를 떠올렸다."


translate japanese plot10_cg180_lyra_raise_sign_0dce6cd9:



    voice "voice/cygnus_1220.ogg"
    cygnus "큭. 하나같이 어쩜 이렇게 말을 안 듣지."


translate japanese plot10_cg180_lyra_raise_sign_8eefe377:



    voice "voice/cygnus_1221.ogg"
    cygnus "돌아올 생각이 없다면, 억지로 떼어 내겠어!"


translate japanese plot10_cg180_lyra_raise_sign_534e4515:


    "시노스는 왕관에 마력을 집중해, 반장의 지배에서 강제로 떼어 내려 했다."


translate japanese plot10_cg180_lyra_raise_sign_bdac6067:


    banzhang2 "으윽――!"


translate japanese plot10_cg180_lyra_raise_sign_f82a9380:


    "마력이 흐트러진 탓에, 반장은 시노스에게 저항하지도 못했다."


translate japanese plot10_cg180_lyra_raise_sign_56674587:


    "그저 무의식적으로 자신의 마력을 다른 곳에 모으고 있었다."


translate japanese plot10_cg180_lyra_raise_sign_51154a3c:


    "아무 저항도 없는 것에, 시노스는 살짝 위화감을 느꼈다."


translate japanese plot10_cg180_lyra_raise_sign_908ea924:


    "그리고 곧바로 장벽에서 무언가 일어나고 있다는 걸 알아차렸다."


translate japanese plot10_cg180_lyra_raise_sign_870b6982:



    voice "voice/cygnus_1222.ogg"
    cygnus "장벽을 고칠 셈인가――"


translate japanese plot10_cg180_lyra_raise_sign_fde35027:


    "반장은 장벽의 재생과 복구에 마력을 집중하고 있었다."


translate japanese plot10_cg180_lyra_raise_sign_0f92d9d4:


    "갈라진 틈이 아주 빠르게 닫혀 갔다."


translate japanese plot10_cg180_lyra_raise_sign_fa0b88e4:



    voice "voice/cygnus_1223.ogg"
    cygnus "（큰일이야… 이래서는 늦어――）"


translate japanese plot10_cg180_lyra_raise_sign_1545a64f:


    tianqin "절대로! 닫히게 두지 않아!"


translate japanese plot10_cg180_lyra_raise_sign_b1576d05:


    cygnus "라이라!"


translate japanese plot10_cg180_lyra_raise_sign_6b80b9b5:


    "닫히던 장벽을 라이라가 맨손으로 붙잡을 줄은 시노스도 예상하지 못했다."


translate japanese plot10_cg180_lyra_raise_sign_9fd882ea:



    voice "voice/tianqin_2114.ogg"
    tianqin "난 괜찮아! 여기는 내가 잡고 있을 테니까――"


translate japanese plot10_stone_first_begin_7bf35c05:


    "휙――"


translate japanese plot10_stone_first_begin_89545064:


    "말을 끝내는 순간, 무언가가 장벽 안에서 라이라의 뺨을 스치며 날아갔다."


translate japanese plot10_cg180_lyra_raise_sign_dc3ee7d7:



    voice "voice/tianqin_2115.ogg"
    tianqin "뭐――"


translate japanese plot10_cg180_lyra_raise_sign_7e4312f2:


    "팡――!"


translate japanese plot10_cg180_lyra_raise_sign_885b49c1:


    "라이라 뒤에서 메마른 소리가 울렸다."


translate japanese plot10_cg180_lyra_raise_sign_9db50557:


    "돌아보니 시노스 앞에 옅은 연기가 피어오르고 있었다."


translate japanese plot10_cg180_lyra_raise_sign_97aaa662:



    voice "voice/cygnus_1225.ogg"
    cygnus "뭐야?"


translate japanese plot10_cg180_lyra_raise_sign_64da138c:


    "시노스도 무엇이 날아왔는지 알지 못했다."


translate japanese plot10_cg180_lyra_raise_sign_56dc50b8:


    "정체를 확인하기도 전에, 날아온 물체는 시노스의 몸에 걸린 방어 마법에 튕겨 산산조각 났다."


translate japanese plot10_cg180_lyra_raise_sign_8efdef46:



    voice "voice/hecheng_379.ogg"
    hecheng2 "있잖아～. 그렇게 초 치지 말아 줄래――"


translate japanese plot10_cg180_lyra_raise_sign_7dc6ce27:


    "마법진 안에서 한동안 잠자코 있던 목소리가 들려왔다."


translate japanese plot10_cg180_lyra_raise_sign_5237572b:


    tianqin "츠루기! 방해하지 마!"


translate japanese plot10_cg180_lyra_raise_sign_a941254d:



    voice "voice/hecheng_380.ogg"
    hecheng "아, 진짜. 시끄럽네."


translate japanese plot10_cg180_lyra_raise_sign_950e64a9:



    voice "voice/hecheng_381.ogg"
    hecheng "난 그저 반장의 소원을 이뤄 주고 싶을 뿐인데."


translate japanese plot10_cg180_lyra_raise_sign_597aaa7e:


    "츠루기는 바닥 타일에서 떨어져 나온 날카로운 조각을 손끝으로 만지작거리고 있었다."


translate japanese plot10_cg180_lyra_raise_sign_27a653ab:


    "さっきシノスに投げつけたのは、それだ。"


translate japanese plot10_cg180_lyra_raise_sign_d403d5e3:


    "유능한 마법사인 시노스는 평소에도 몸에 여러 방어 마법을 걸어 두고 있었다."


translate japanese plot10_cg180_lyra_raise_sign_d6f35c24:


    "이런 기습에 대비하기 위해서였다."


translate japanese plot10_cg180_lyra_raise_sign_326e1905:



    voice "voice/cygnus_1226.ogg"
    cygnus "안됐네. 그 정도로는 나한테 상처 하나 못 내."


translate japanese plot10_cg180_lyra_raise_sign_3b89f9a6:


    "그렇게 말한 시노스는 커다란 나무를 뿌리째 뽑듯 마력을 끌어당겨,"


translate japanese plot10_cg180_lyra_raise_sign_681ea1d0:


    "왕관을 반장의 몸에서 조금씩 떼어 냈다."


translate japanese plot10_cg180_lyra_raise_sign_3e576bc5:


    banzhang2 "으윽!!"


translate japanese plot10_cg180_lyra_raise_sign_2f09ec0b:


    "반장이 아무리 발버둥 쳐도, 왕관에서 몸속 깊이 뻗어 나간 뿌리는 하나씩 뽑혀 나왔다."


translate japanese plot10_cg180_lyra_raise_sign_4d30c69a:



    voice "voice/tianqin_2117.ogg"
    tianqin "반장… 같이 돌아가자."


translate japanese plot10_cg180_lyra_raise_sign_e9205d26:



    voice "voice/banzhang_781.ogg"
    banzhang2 "라이라… 씨…"


translate japanese plot10_cg180_lyra_raise_sign_86dd2106:


    "心に残っていた最後の抵抗も崩れ、強い魔力が王冠を委員長から完全に引きはがした。"


translate japanese plot10_cg180_lyra_raise_sign_24a535f2:


    "힘을 잃은 반장은 눈앞이 깜깜해졌고, 라이라가 이름을 부르는 소리를 들으며 의식을 잃었다."


translate japanese plot10_cg180_lyra_raise_sign_0e140678:



    voice "voice/tianqin_2118.ogg"
    tianqin "반장!"


translate japanese plot10_cg180_lyra_raise_sign_635d5c94:



    voice "voice/cygnus_1227.ogg"
    cygnus "잠깐! 라이라, 아직 가까이 가지 마!"


translate japanese plot10_cg180_lyra_raise_sign_ea1039f6:



    voice "voice/tianqin_2119.ogg"
    tianqin "어?"


translate japanese plot10_cg180_lyra_raise_sign_5e378b67:



    voice "voice/cygnus_1228.ogg"
    cygnus "{rb}「빙결」{/rb}{rt}Freeze{/rt}"


translate japanese plot10_cg180_lyra_raise_sign_98f50e68:


    "시노스의 손바닥에서 냉기를 머금은 바람이 뿜어져 나왔다."


translate japanese plot10_cg180_lyra_raise_sign_d0a245b6:


    "이윽고 거대한 얼음 결정이 생겨나, 반장과 츠루기를 감쌌다."


translate japanese plot10_cg180_lyra_raise_sign_a5bc8708:



    voice "voice/tianqin_2120.ogg"
    tianqin "어어!? 뭐 하는 거야?"


translate japanese plot10_cg180_lyra_raise_sign_c3564424:



    voice "voice/cygnus_1229.ogg"
    cygnus "괜찮아. 이 마법으로 두 사람이 다치지는 않아."


translate japanese plot10_cg180_lyra_raise_sign_1bf18962:



    voice "voice/cygnus_1230.ogg"
    cygnus "잠시 얼려서 생명력을 유지하는 것뿐이야."


translate japanese plot10_cg180_lyra_raise_sign_f5437fbe:



    voice "voice/tianqin_2121.ogg"
    tianqin "후우――깜짝 놀랐잖아――"


translate japanese plot10_cg180_lyra_raise_sign_e08832c8:



    voice "voice/yangxi_733.ogg"
    yangxi "어이――라이라――"


translate japanese plot10_cg180_lyra_raise_sign_28a3f3db:



    voice "voice/tianqin_2122.ogg"
    tianqin "아, 히나타! 빨리 왔네!"


translate japanese plot10_cg180_lyra_raise_sign_02dce33b:



    voice "voice/tianqin_2123.ogg"
    tianqin "벌써 시험 끝났어?"


translate japanese plot10_cg180_lyra_raise_sign_1a6f1dbf:



    voice "voice/yangxi_734.ogg"
    yangxi "いつも時間前に出しちゃうから。"


translate japanese plot10_cg180_lyra_raise_sign_46ae2d8f:



    voice "voice/yangxi_735.ogg"
    yangxi "시험장에서 나와서 메시지를 보고 바로 왔어."


translate japanese plot10_cg180_lyra_raise_sign_9f50c5f9:



    voice "voice/yangxi_736.ogg"
    yangxi "우와. 반장이랑 츠루기잖아."


translate japanese plot10_cg180_lyra_raise_sign_17437af5:



    voice "voice/yangxi_737.ogg"
    yangxi "무슨 일이야? 바닥도 피투성이고…"


translate japanese plot10_cg180_lyra_raise_sign_8b4c6d36:



    voice "voice/tianqin_2124.ogg"
    tianqin "으음… 말하자면 길어."


translate japanese plot10_cg180_lyra_raise_sign_ae80cc61:



    voice "voice/tianqin_2125.ogg"
    tianqin "아사요. 둘 다… 살릴 수 있어?"


translate japanese plot10_cg180_lyra_raise_sign_ce66160b:



    voice "voice/cygnus_1231.ogg"
    cygnus "できる限り頑張るね。"


translate japanese plot10_cg180_lyra_raise_sign_10ec1c35:



    voice "voice/banzhang_782.ogg"
    banzhang "（으음――다음은 수학인가…）"


translate japanese plot10_cg180_lyra_raise_sign_ecc4ead8:



    voice "voice/tianqin_2126.ogg"
    tianqin "반장! 이따 아무 일 없지!"


translate japanese plot10_cg180_lyra_raise_sign_b37bb8a5:



    voice "voice/banzhang_783.ogg"
    banzhang "라이라 씨. 또 수업 빼먹으시려고요?"


translate japanese plot10_cg180_lyra_raise_sign_78aef270:



    voice "voice/tianqin_2127.ogg"
    tianqin "쉿!"


translate japanese plot10_cg180_lyra_raise_sign_6cfc65b2:


    "라이라는 주위를 둘러보더니, 나를 슬그머니 옆으로 데려갔다."


translate japanese plot10_cg180_lyra_raise_sign_ab4847fd:



    voice "voice/tianqin_2128.ogg"
    tianqin "반장, 크게 말하지 마! 어제 또 담임 선생님한테 수업 안 빼먹겠다고 약속했단 말이야――"


translate japanese plot10_cg180_lyra_raise_sign_d42a7d52:



    voice "voice/banzhang_784.ogg"
    banzhang "후후. 정말, 라이라 씨도 못 말리겠네요."


translate japanese plot10_cg180_lyra_raise_sign_2d228d4e:


    "곧 우리는 가방을 들고 몰래 교실을 빠져나왔다."


translate japanese plot10_cg180_lyra_raise_sign_fd7788ab:


    nvlNone "그 일이 있은 지 두 달이 지났다."


translate japanese plot10_cg180_lyra_raise_sign_fc8f963c:


    nvlNone "교실에 빈자리가 몇 개 늘어난 것을 빼면,"


translate japanese plot10_cg180_lyra_raise_sign_96494578:


    nvlNone "마치 아무 일도 없었던 것 같았다."


translate japanese plot10_cg180_lyra_raise_sign_20e41ca1:


    nvlNone "그 마녀는 마법으로 나와 츠루기의 몸을 원래대로 되돌려 줬다."


translate japanese plot10_cg180_lyra_raise_sign_9e2d6b13:


    nvlNone "경찰은 두 사람이 실종됐다고 발표했다."


translate japanese plot10_cg180_lyra_raise_sign_8a36413c:


    nvlNone "학교뿐 아니라 룽화시 전체가 떠들썩해질 만큼 큰 소동이 일었다."


translate japanese plot10_cg180_lyra_raise_sign_ecc78c51:


    nvlNone "하지만 그것도 금세 잠잠해졌다."


translate japanese plot10_cg180_lyra_raise_sign_a677f4b1:


    nvlNone "어쨌든 두 사람은 금세 잊혔다."


translate japanese plot10_cg180_lyra_raise_sign_637e2235:


    nvlNone "이 이야기에서 다뤄진 방식과 마찬가지로."


translate japanese plot10_cg180_lyra_raise_sign_82e59ec6:


    nvlNone "츠루기는 학교를 그만뒀다."


translate japanese plot10_cg180_lyra_raise_sign_8ee8080e:


    nvlNone "그 후로 한 번도 만나지 못했다."


translate japanese plot10_cg180_lyra_raise_sign_50435de8:


    nvlNone "아무 벌도 받지 않았다."


translate japanese plot10_cg180_lyra_raise_sign_c0393693:


    nvlNone "여유롭게 학교를 떠났다."


translate japanese plot10_cg180_lyra_raise_sign_b01e60bb:


    nvlNone "내 손으로 두 사람을 심판하고, 피를 뒤집어쓴 나도,"


translate japanese plot10_cg180_lyra_raise_sign_02776639:


    nvlNone "죄책감은 있는 걸까."


translate japanese plot10_cg180_lyra_raise_sign_202bef65:




    nvlNone "모르겠다."


translate japanese plot10_cg180_lyra_raise_sign_fa92e02a:


    nvlNone "라이라는 내게 이렇게 말했다."


translate japanese plot10_cg180_lyra_raise_sign_6f01bb90:


    nvlNone "그때는 힘에 홀려 있었던 거라고.{p}내 의지로 한 일이 아니라고."


translate japanese plot10_cg180_lyra_raise_sign_47fe3569:


    nvlNone "내가 너무 깊이 자책할까 봐 걱정해 준 거겠지."


translate japanese plot10_cg180_lyra_raise_sign_6a70d899:


    nvlNone "사람을 죽였다. 그 사실은 부정하지 않는다."


translate japanese plot10_cg180_lyra_raise_sign_99ab4cda:


    nvlNone "그저 아무 느낌이 없다."


translate japanese plot10_cg180_lyra_raise_sign_b0142bf1:


    nvlNone "내가 잘못했다는 건 분명히 알고 있다."


translate japanese plot10_cg180_lyra_raise_sign_1ea8a98f:


    nvlNone "그런데도 어떻게 반성해야 할지 모르겠다."


translate japanese plot10_cg180_lyra_raise_sign_800320e9:


    nvlNone "아침에 수업을 빠져나온 뒤,\n그날은 한 번도 학교로 돌아가지 않았다."


translate japanese plot10_cg180_lyra_raise_sign_79aaac36:


    nvlNone "저녁 시간이 될 때까지 밖을 돌아다녔다."


translate japanese plot10_cg180_lyra_raise_sign_96ff80e7:



    voice "voice/nvlbanzhang_005.ogg"
    nvlNone "「엄마, 다녀왔어요.」"


translate japanese plot10_cg180_lyra_raise_sign_a4a7a28a:


    nvlNone "현관문을 열고 평소처럼 말을 건넸다."


translate japanese plot10_cg180_lyra_raise_sign_5ccfb17f:


    nvlNone "엄마가 돌아가신 지 두 달."


translate japanese plot10_cg180_lyra_raise_sign_394d9b30:


    nvlNone "혼자 살기 시작한 지 두 달."


translate japanese plot10_cg180_lyra_raise_sign_ac1fcd64:


    nvlNone "그사이 나를 걱정한 라이라가 한동안 함께 있어 줬다."


translate japanese plot10_cg180_lyra_raise_sign_51f137df:


    nvlNone "줄곧 슬픔에 잠겨 꼼짝도 못 하게 될 줄 알았다."


translate japanese plot10_cg180_lyra_raise_sign_ad83228c:


    nvlNone "하지만 지금은 이제 아무것도 느껴지지 않는다."


translate japanese plot10_cg180_lyra_raise_sign_3474f6de:


    nvlNone "두 달조차 걸리지 않았다."


translate japanese plot10_cg180_lyra_raise_sign_e11f3288:


    nvlNone "차로 우리를 들이받은 건 엄마를 모함했던 옛 동료였다."


translate japanese plot10_cg180_lyra_raise_sign_9fbb1295:


    nvlNone "회사에서 쫓겨난 뒤로, 줄곧 복수할 생각만 했던 모양이다."


translate japanese plot10_cg180_lyra_raise_sign_7376376a:


    nvlNone "법에 따라 마땅한 처벌을 받았다."


translate japanese plot10_cg180_lyra_raise_sign_55b48467:


    nvlNone "츠루기는 그 사고와 관련이 없었던 것 같다."


translate japanese plot10_cg180_lyra_raise_sign_3aadd16d:


    nvlNone "「후우…」"


translate japanese plot10_cg180_lyra_raise_sign_8d9ef2b8:


    nvlNone "한숨을 내쉬었다."


translate japanese plot10_cg180_lyra_raise_sign_88fef413:


    nvlNone "무언가 빠진 채, 가슴 깊은 곳에는 그저 「공허」만 있었다."


translate japanese plot10_cg180_lyra_raise_sign_3d7fed76:


    nvlNone "커다란 구멍."


translate japanese plot10_cg180_lyra_raise_sign_1cb99c12:


    nvlNone "그곳에 슬픔도, 기쁨도,\n추억도, 미래를 향한 희망도 전부 쏟아부었다."


translate japanese plot10_cg180_lyra_raise_sign_638c064b:


    nvlNone "5년 후."


translate japanese plot10_cg180_lyra_raise_sign_642b6ff9:


    nvlNone "나와 라이라는 함께 평범한 대학을 졸업했다."


translate japanese plot10_cg180_lyra_raise_sign_8b8ea29b:


    nvlNone "하지만 별로 걱정되지는 않았다."


translate japanese plot10_cg180_lyra_raise_sign_2783267e:


    nvlNone "5년 전과 마찬가지로, 내 안에는 「공허」만 있었다."


translate japanese plot10_cg180_lyra_raise_sign_ee69843d:


    nvlNone "과거 때문에 고민하지도, 미래를 불안해하지도 않는다."


translate japanese plot10_cg180_lyra_raise_sign_a00d5ef3:


    nvlNone "라이라 쪽은,"


translate japanese plot10_cg180_lyra_raise_sign_eafdef86:


    nvlNone "애초에 「일자리」 정도로 고민할 사람이 아니다."


translate japanese plot10_cg180_lyra_raise_sign_261302bf:


    nvlNone "히나타가 유럽으로 돌아가 가업을 물려받은 뒤,"


translate japanese plot10_cg180_lyra_raise_sign_d0b4ed34:


    nvlNone "라이라는 「월세를 내는 동거인」\n자격으로 우리 집에 이사 왔다."


translate japanese plot10_cg180_lyra_raise_sign_3bd742cc:



    voice "voice/nvlyisheng_01.ogg"
    nvlNone "「요즘은 어떠세요? 힘들게 느껴지는 일이 있나요?」{p}의사는 손에 든 서류를 보며 물었다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlyisheng_01.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_1f236529:



    voice "voice/nvlyisheng_02.ogg"
    nvlNone "「지금 상태를,\n1부터 10까지로 표현한다면 몇 점인가요?」"


translate japanese plot10_cg180_lyra_raise_sign_c02b4c26:



    voice "voice/nvlbanzhang_08.ogg"
    nvlNone "「5점이요.」"


translate japanese plot10_cg180_lyra_raise_sign_d255fcc4:


    voice "voice/nvlyisheng_03.ogg"
    nvlNone "「그렇군요… 지난번보다 1점 올랐네요.」{p}「뭔가 달라진 게 있었나요?」{p}의사는 이어서 물었다." (callback=nvl_page_voice, cb_next_voice="voice/nvlyisheng_04.ogg", cb_last_segment_silent=True)


translate japanese plot10_cg180_lyra_raise_sign_eb490365:



    voice "voice/nvlyisheng_05.ogg"
    nvlNone "「최근에 불안해지는 일이 있나요?」"


translate japanese plot10_cg180_lyra_raise_sign_d295bebd:



    voice "voice/nvlbanzhang_10.ogg"
    nvlNone "「없어요.」"


translate japanese plot10_cg180_lyra_raise_sign_11b15d02:



    voice "voice/nvlyisheng_06.ogg"
    nvlNone "「잠은 어떤가요? 요즘 잠들기 어려운 적은요?」"


translate japanese plot10_cg180_lyra_raise_sign_a29852e7:



    voice "voice/nvlyisheng_07.ogg"
    nvlNone "「그럼 약은 지금 용량을 유지하죠.」{p}「다만 힘들어지면 바로 병원에 와 주세요.」" (callback=nvl_page_voice, cb_next_voice="voice/nvlyisheng_08.ogg")


translate japanese plot10_cg180_lyra_raise_sign_78dda3a3:


    nvlNone "라이라의 권유로,"


translate japanese plot10_cg180_lyra_raise_sign_f6782827:


    nvlNone "나는 정기적으로 병원 진료를 받고 있었다."


translate japanese plot10_cg180_lyra_raise_sign_a37956c8:


    nvlNone "처방받은 약도 지시한 대로 먹고 있었다."


translate japanese plot10_cg180_lyra_raise_sign_7bd35658:


    nvlNone "그래도 마음속 「공허」는 사라지지 않았다."


translate japanese plot10_cg180_lyra_raise_sign_055f7f51:


    nvlNone "강해지지도, 옅어지지도 않았다."


translate japanese plot10_cg180_lyra_raise_sign_3784e9b8:


    nvlNone "진료가 끝날 무렵, 의사가 문득 물었다.{p}「최근에 술을 마시나요?」" (callback=nvl_page_voice, cb_page_voices=(None, 'voice/nvlyisheng_09.ogg'))


translate japanese plot10_cg180_lyra_raise_sign_06ffe681:



    voice "voice/nvlbanzhang_13.ogg"
    nvlNone "「아… 요즘은 조금요.」"


translate japanese plot10_cg180_lyra_raise_sign_26512cd5:



    voice "voice/nvlyisheng_10.ogg"
    nvlNone "「가능하면 자제해 주세요.」"


translate japanese plot10_cg180_lyra_raise_sign_5b5b78e4:


    nvlNone "밤에 집으로 돌아오자 스마트폰 알람이 울렸다."


translate japanese plot10_cg180_lyra_raise_sign_de59c554:


    nvlNone "마침 약 먹을 시간이었다."


translate japanese plot10_cg180_lyra_raise_sign_1d022f91:


    nvlNone "냉장고에서 캔 맥주 하나를 꺼냈다."


translate japanese plot10_cg180_lyra_raise_sign_38dd5c08:


    voice "voice/nvltianqin_10.ogg"
    nvlNone "「아, 또 술 마시네!」{p}젖은 머리를 닦으며 라이라가 욕실에서 나왔다." (callback=nvl_page_voice, cb_page_voices=('voice/nvltianqin_10.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_9471e4ad:


    voice "voice/nvlbanzhang_15.ogg"
    nvlNone "「으음――」{p}현장을 들켰다. 그렇다고 몰래 마실 생각이 있었던 건 아니지만." (callback=nvl_page_voice, cb_page_voices=('voice/nvlbanzhang_15.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_b31815b2:



    voice "voice/nvltianqin_11.ogg"
    nvlNone "「병원은 갔어? 의사 선생님이 뭐래?」"


translate japanese plot10_cg180_lyra_raise_sign_e7ef1780:



    voice "voice/nvltianqin_12.ogg"
    nvlNone "「요즘 잠은 잘 자?」"


translate japanese plot10_cg180_lyra_raise_sign_c1694547:


    voice "voice/nvlbanzhang_17.ogg"
    nvlNone "「선생님이랑 똑같은 걸 묻네.」{p}맥주를 한 모금 마시고, 고개를 갸웃하며 라이라를 봤다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlbanzhang_17.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_cbbe857d:



    voice "voice/nvltianqin_13.ogg"
    nvlNone "「네가 술을 마시니까 그렇지!」"


translate japanese plot10_cg180_lyra_raise_sign_2b5f6559:



    voice "voice/nvltianqin_14.ogg"
    nvlNone "「윽! 드, 들켰어? 아하하…」"


translate japanese plot10_cg180_lyra_raise_sign_9d525cfe:


    voice "voice/nvlbanzhang_20.ogg"
    nvlNone "「라이라는 원래 거짓말을 못하잖아.」{p}예전부터 내게 무언가를 숨기는 데는 서툴렀다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlbanzhang_20.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_ff032b04:



    voice "voice/nvltianqin_15.ogg"
    nvlNone "「으음. 뭐, 그렇지.」"


translate japanese plot10_cg180_lyra_raise_sign_d281b3a5:


    nvlNone "TV 소리에 묻히려는 듯, 라이라는 마침내 입을 열었다."


translate japanese plot10_cg180_lyra_raise_sign_7453dcc3:



    voice "voice/nvltianqin_16.ogg"
    nvlNone "「고등학교 때 체육 선생님…\n김 선생님이 실종되셨대.」"


translate japanese plot10_cg180_lyra_raise_sign_a9b62bf7:


    voice "voice/nvlbanzhang_22.ogg"
    nvlNone "「츠루기?」{p}잠시 뜸을 들이다, 그 이름을 입에 올렸다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlbanzhang_22.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_2b444714:


    voice "voice/nvlbanzhang_23.ogg"
    nvlNone "「위험해.」{p}단단히 말해 뒀다. 하지만 이 말로 라이라가 멈출 리는 없다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlbanzhang_23.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_08ce80eb:



    voice "voice/nvltianqin_19.ogg"
    nvlNone "「괜찮아.」{p}「아직 취직도 못 했는데,\n마침 할 일이 생겼네.」" (callback=nvl_page_voice, cb_page_voices=('voice/nvltianqin_19.ogg', 'voice/nvltianqin_20.ogg'))


translate japanese plot10_cg180_lyra_raise_sign_ce2b88e6:



    voice "voice/nvlbanzhang_24.ogg"
    nvlNone "「일자리라면, 우리 여행사에서 일하면 되잖아.」"


translate japanese plot10_cg180_lyra_raise_sign_cc7c1737:


    nvlNone "그 후 라이라는 여러모로 조사했다.{p}하지만 쓸 만한 단서는 아무것도 찾지 못했다."


translate japanese plot10_cg180_lyra_raise_sign_822b6714:


    nvlNone "더 뜻밖이었던 건,\n츠루기 역시 홀연히 자취를 감췄다는 사실이었다."


translate japanese plot10_cg180_lyra_raise_sign_355e4835:


    nvlNone "돌아가신 엄마보다,"


translate japanese plot10_cg180_lyra_raise_sign_aa2dad99:


    nvlNone "나를 상처 입힌 츠루기가 더 내 마음을 흔들었다."


translate japanese plot10_cg180_lyra_raise_sign_fbe88706:


    nvlNone "20년 후." (**end_page())


translate japanese plot10_cg180_lyra_raise_sign_74e4954d:


    nvlNone "거리에서 우연히 그때 나를 구해 준 마녀를 만났다."


translate japanese plot10_cg180_lyra_raise_sign_ed6c6ebe:


    nvlNone "식사하며 이야기하자고 음식점에 초대했다."


translate japanese plot10_cg180_lyra_raise_sign_45effa4f:


    nvlNone "그녀는 거절하지 않았다."


translate japanese plot10_cg180_lyra_raise_sign_da1e2f30:


    nvlNone "이렇게 세월이 흘렀는데도, 그녀와 이야기하는 건 겨우 두 번째였다."


translate japanese plot10_cg180_lyra_raise_sign_ce9322c9:


    nvlNone "마법에 관한 정보는 아직 머릿속에 단편적으로 남아 있었다."


translate japanese plot10_cg180_lyra_raise_sign_13b6307b:


    voice "voice/nvlcygnus_10.ogg"
    nvlNone "「으음――「공허」한 느낌이라.」{p}마녀는 햄버거를 입에 가득 문 채, 웅얼거리는 목소리로 말했다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlcygnus_10.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_ce11cb4b:


    nvlNone "지금까지 겪어 온 일을 마녀에게 이야기했다."


translate japanese plot10_cg180_lyra_raise_sign_5ee63042:


    nvlNone "정확히는 고민이라고도 할 수 없었다."


translate japanese plot10_cg180_lyra_raise_sign_bba0a5e6:


    nvlNone "지난 20년 동안 나는 꾸준히 병원에 다녔다."


translate japanese plot10_cg180_lyra_raise_sign_5a2810ee:


    nvlNone "정신과 약은 오래전에 의사의 판단으로 끊었다."


translate japanese plot10_cg180_lyra_raise_sign_639a1dd5:


    nvlNone "먹어도 아무것도 달라지지 않았기 때문이다."


translate japanese plot10_cg180_lyra_raise_sign_126300f3:


    nvlNone "그저 내 안에서 무슨 일이 일어나는지 알고 싶었다."


translate japanese plot10_cg180_lyra_raise_sign_ac370838:


    nvlNone "이야기를 다 들은 마녀는 손끝을 핥고 나서 대답했다."


translate japanese plot10_cg180_lyra_raise_sign_e2f0edd3:


    voice "voice/nvlcygnus_11.ogg"
    nvlNone "「먼저 말해 두지. 지금의 너도 마녀야.」{p}「어떻게 해야 마력을 끌어낼 수 있는지는 모르겠지만…」{p}「그 상태는 네 몸에 깃든 힘 때문일 거야.」" (callback=nvl_page_voice, cb_page_voices=('voice/nvlcygnus_11.ogg', 'voice/nvlcygnus_12.ogg', 'voice/nvlcygnus_13.ogg'))


translate japanese plot10_cg180_lyra_raise_sign_b8f4a85d:


    voice "voice/nvlcygnus_14.ogg"
    nvlNone "「나는 몰라. 스스로 찾아야 해.」{p}「너는 이 세계에서 태어난 유일한 마녀야.」{p}「나와는 달라.」" (callback=nvl_page_voice, cb_page_voices=('voice/nvlcygnus_14.ogg', 'voice/nvlcygnus_15.ogg', 'voice/nvlcygnus_16.ogg'))


translate japanese plot10_cg180_lyra_raise_sign_d4ec8319:


    nvlNone "그러자 마녀가 말을 이었다."


translate japanese plot10_cg180_lyra_raise_sign_b0eb5665:


    voice "voice/nvlcygnus_17.ogg"
    nvlNone "「그것도 네게 내려진 벌일지 모르겠네.」{p}마녀는 의미심장하게 웃었다.{p}「하지만 나쁜 점만 있는 건 아니야.」{p}「평범한 사람보다 오래 살 수 있을지도 몰라.」" (callback=nvl_page_voice, cb_page_voices=('voice/nvlcygnus_17.ogg', None, 'voice/nvlcygnus_18.ogg', 'voice/nvlcygnus_19.ogg'))


translate japanese plot10_cg180_lyra_raise_sign_467ad619:



    voice "voice/nvlcygnus_20.ogg"
    nvlNone "「그러고 보니, 라이라는 잘 지내?」"


translate japanese plot10_cg180_lyra_raise_sign_7c51b337:


    voice "voice/nvlbanzhang_25.ogg"
    nvlNone "「어?」{p}갑작스러운 질문에, 나도 모르게 눈을 깜빡였다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlbanzhang_25.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_757af2fb:



    voice "voice/nvlcygnus_21.ogg"
    nvlNone "「지금은 같이 안 살아?」{p}마녀가 다시 물었다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlcygnus_21.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_7dab5d9a:



    voice "voice/nvlbanzhang_27.ogg"
    nvlNone "「라이라라면 잘 지내. 황소처럼 튼튼해.」{p}그렇게 대답했다." (callback=nvl_page_voice, cb_page_voices=('voice/nvlbanzhang_27.ogg', None))


translate japanese plot10_cg180_lyra_raise_sign_e4e806c3:



    voice "voice/nvlcygnus_22.ogg"
    nvlNone "「황소처럼…」"


translate japanese plot10_cg180_lyra_raise_sign_2fe3d626:


    nvlNone "마녀는 턱에 손을 대고, 진지하게 생각하기 시작했다."


translate japanese plot10_cg180_lyra_raise_sign_eec6ab1c:



    voice "voice/nvlbanzhang_28.ogg"
    nvlNone "「왜 갑자기? 두 사람, 오래 못 만났어?」"


translate japanese plot10_cg180_lyra_raise_sign_2717f3d1:



    voice "voice/nvlcygnus_23.ogg"
    nvlNone "「그래――줄곧 마도구를 찾고 있었거든.」{p}「룽화시에 돌아온 것도 얼마 안 됐어.」" (callback=nvl_page_voice, cb_page_voices=('voice/nvlcygnus_23.ogg', 'voice/nvlcygnus_24.ogg'))


translate japanese plot10_cg180_lyra_raise_sign_add27190:



    voice "voice/nvlcygnus_25.ogg"
    nvlNone "「그래. 시간은 참 빨라.」{p}「마녀에게 20년은 짧은 시간이니까.」" (callback=nvl_page_voice, cb_page_voices=('voice/nvlcygnus_25.ogg', 'voice/nvlcygnus_26.ogg'))


translate japanese plot10_cg180_lyra_raise_sign_ce604192:


    nvlNone "그렇게 말하는 마녀의 얼굴에는 아무 표정도 없었다."


translate japanese plot10_cg180_lyra_raise_sign_6f846771:


    nvlNone "말하는 걸 보니, 지난 20년의 여행에서도,\n아무것도 찾지 못한 듯했다."


translate japanese plot10_cg180_lyra_raise_sign_935deea3:


    nvlNone "어째서인지 가슴에 슬픔이 차올랐다."


translate japanese plot10_cg180_lyra_raise_sign_06e6e7e3:


    nvlNone "마녀 때문인지, 라이라 때문인지, 나도 모르겠다."


translate japanese plot10_cg180_lyra_raise_sign_303e1d39:


    nvlNone "몇 개를 먹었는지 모를 만큼 햄버거를 먹고서야,\n마녀는 마침내 만족했다."


translate japanese plot10_cg180_lyra_raise_sign_ea819818:


    nvlNone "헤어지기 전에는 전화번호도 알려 줬다."


translate japanese plot10_cg180_lyra_raise_sign_ddabf611:


    nvlNone "이런 이유로 연락처를 주고받는 사람도 있나."


translate japanese plot10_cg180_lyra_raise_sign_0a941552:


    nvlNone "휴대폰에 남은 번호를 바라봤다."


translate japanese plot10_cg180_lyra_raise_sign_ca6f5794:


    nvlNone "하늘을 올려다보며 길게 숨을 내쉬었다."


translate japanese plot10_cg180_lyra_raise_sign_0828857c:


    nvlNone "하얀 구름이 바람을 타고 푸른 하늘을 천천히 흘러갔다."


translate japanese plot10_cg180_lyra_raise_sign_9056a52f:


    nvlNone "다음에는 어디로 여행을 갈까. 라이라도 부르자."


translate japanese plot10_cg180_lyra_raise_sign_83373e44:


    nvlNone "생각해 보면 여행사에서 일하기로 한 것도,\n여러 곳의 사람과 생활을\n구경하는 걸 좋아해서였던 것 같다."


translate japanese plot10_cg180_lyra_raise_sign_5c4110a2:


    nvlNone "아, 【그 녀석｜마녀】도 불러 보자."


translate japanese plot10_cg180_lyra_raise_sign_ad08b71f:


    nvlNone "마녀의 말대로, 마음속 구멍은 내게 내려진 벌일지도 모른다."


translate japanese plot10_cg180_lyra_raise_sign_c72d482d:


    nvlNone "무엇을 넣어도 채워지지 않는다."


translate japanese plot10_cg180_lyra_raise_sign_6ccda8b1:


    nvlNone "그래도 후회하지 않는다."


translate japanese plot10_plotend_shortcuts_disabled_82371ddf:


    voice "voice/nvlequinox_01.ogg"
    chroniclenameless3 "【너｜나】는 사실 알고 있을 거야."


translate japanese plot10_plotend_shortcuts_disabled_877cd4c1:


    voice "voice/nvlequinox_02.ogg"
    chroniclenameless3 "그 구멍이 무엇인지."


translate japanese plot10_plotend_shortcuts_disabled_387cfc20:


    voice "voice/nvlequinox_03.ogg"
    chroniclenameless3 "하지만 【나｜너】는 알고 있을 거야."


translate japanese plot10_plotend_shortcuts_disabled_b03ed52d:


    voice "voice/nvlequinox_04.ogg"
    chroniclenameless3 "그런 미적지근한 후회에서 태어난 게 아니야."


translate japanese plot10_plotend_shortcuts_disabled_f7cf0000:


    voice "voice/nvlequinox_05.ogg"
    chroniclenameless3 "잊었어? 네 인생은 이제 곧 끝나."


translate japanese plot10_plotend_shortcuts_disabled_f000aa36:


    voice "voice/nvlequinox_06.ogg"
    chroniclenameless3 "목숨이 사라지기 직전에, 네가 나를 깨웠어."


translate japanese plot10_plotend_shortcuts_disabled_170a0c59:


    voice "voice/nvlequinox_07.ogg"
    chroniclenameless3 "자, 함께 메우자. 152년 동안 비어 있던 이 구멍을."


translate japanese plot10_plotend_shortcuts_disabled_f360f775:


    voice "voice/nvlequinox_08.ogg"
    chroniclenameless3 "【너｜나】는 악을 끝까지 관철하지도 못한 죄인이야."


translate japanese plot10_plotend_shortcuts_disabled_305ac4c9:


    voice "voice/nvlequinox_09.ogg"
    chroniclenameless3 "죄에서 도망치고는, 스스로 족쇄를 채웠지."


translate japanese plot10_plotend_shortcuts_disabled_010469af:


    voice "voice/nvlequinox_10.ogg"
    chroniclenameless3 "――더 깊이 파헤쳐 보자."


translate japanese plot10_plotend_shortcuts_disabled_2b59b644:


    voice "voice/nvlequinox_11.ogg"
    chroniclenameless3 "하지만 그게 정말 【너｜나】가 선택한 길일까?"


translate japanese plot10_plotend_shortcuts_disabled_e32f0f5f:


    voice "voice/nvlequinox_12.ogg"
    chroniclenameless3 "【너｜나】는 알고 있을 거야."


translate japanese plot10_plotend_shortcuts_disabled_cbbb3b46:


    voice "voice/nvlequinox_13.ogg"
    chroniclenameless3 "마음속에서 수없이 되풀이한 「만약」을."


translate japanese plot10_plotend_shortcuts_disabled_8a3be663:


    voice "voice/nvlequinox_14.ogg"
    chroniclenameless3 "다시 한번 선택하자."


translate japanese plot10_plotend_shortcuts_disabled_7d452fdb:


    voice "voice/nvlequinox_15.ogg"
    chroniclenameless3 "【너｜나】가 진정 바라던 건 해피 엔딩이 아니야."


translate japanese plot10_end2_shortcuts_restored_3a5a935c:


    "크윽――!" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot10_end2_shortcuts_restored_c2c160fc:


    "뒤섞인 기억이 흘러들어 와, 아주 짧은 순간에 인생 전체를 살아 낸 것 같았다."


translate japanese plot10_end2_shortcuts_restored_af7c025c:


    "아니. 그건 가짜 기억 같은 게 아니야."


translate japanese plot10_end2_shortcuts_restored_76efd2f4:


    "분명히 존재했던 미래."


translate japanese plot10_end2_shortcuts_restored_3af244f8:


    "내가 선택한 인생이 아니다."


translate japanese plot10_end2_shortcuts_restored_d29d748b:


    "장벽이 부서졌다."


translate japanese plot10_end2_shortcuts_restored_03f6277b:


    "마녀는 자신이 낼 수 있는 최대한의 힘으로 왕관을 떼어 내려 하고 있다."


translate japanese plot10_end2_shortcuts_restored_a37e3c4e:


    "라이라는 제 몸도 돌보지 않고 양손으로 장벽을 붙잡고 있다."


translate japanese plot10_end2_shortcuts_restored_73eb6f86:


    "이 뒤에 무슨 일이 일어날지, 나는 알고 있었다."


translate japanese plot10_end2_shortcuts_restored_3c3e101a:



    voice "voice/tianqin_2129.ogg"
    tianqin "절대로! 닫히게 두지 않아!"


translate japanese plot10_end2_shortcuts_restored_b1576d05:


    cygnus "라이라!"


translate japanese plot10_end2_shortcuts_restored_5fa06321:


    "눈앞에서 벌어지는 일은 기억과 완전히 같았다."


translate japanese plot10_end2_shortcuts_restored_dd512f5a:


    "이 뒤에 츠루기가…"


translate japanese plot10_end2_shortcuts_restored_cadce4bb:



    voice "voice/banzhang_785.ogg"
    chronicle "（미안해, 마녀.）"


translate japanese plot10_end2_shortcuts_restored_9341cc8a:



    voice "voice/banzhang_786.ogg"
    chronicle "（조금만 아파 줘야겠어.）"


translate japanese plot10_stone_second_begin_7bf35c05:


    "휙――"


translate japanese plot10_stone_second_begin_243d4e4e:


    "장벽 안쪽에서, 마력을 두른 날카로운 타일 조각이 갈라진 틈을 통과했다."


translate japanese plot10_stone_second_begin_15e67cd1:


    "마력에 밀려난 조각은 무시무시한 속도로 사각에서 시노스를 향해 날아갔다."


translate japanese plot10_stone_second_begin_e8acba51:



    voice "voice/cygnus_1233.ogg"
    cygnus "뭐――"


translate japanese plot10_end2_shortcuts_restored_f12bccbb:


    "푹――!"


translate japanese plot10_stone_second_impact_f324f510:



    voice "voice/cygnus_1234.ogg"
    cygnus "윽!"


translate japanese plot10_stone_second_impact_12e4a202:


    "허를 찔린 시노스는 반응하지 못했다."


translate japanese plot10_stone_second_impact_16914486:


    "어째서인지 타일 조각은 방어 마법을 손쉽게 뚫었다."


translate japanese plot10_stone_second_impact_09333da4:


    "알아차렸을 때는 오른쪽 눈에 극심한 통증이 일었고, 눈을 감싼 손가락 사이로 피가 넘쳐흐르고 있었다."


translate japanese plot10_end2_shortcuts_restored_9f4ac3c6:


    tianqin "아사요!"


translate japanese plot10_stone_second_end_1a6ae565:



    voice "voice/cygnus_1235.ogg"
    cygnus "내 걱정은 하지 마! 둘한테서 눈 떼지 마!"


translate japanese plot10_stone_second_end_d09c0115:



    voice "voice/cygnus_1236.ogg"
    cygnus "（큰일이야. 마력 연결이 끊어져――）"


translate japanese plot10_stone_second_end_753b0d59:


    "기습당해 극심한 통증에 시달리면서도, 시노스는 간신히 마력 제어를 유지했다."


translate japanese plot10_stone_second_end_9a4bcdc4:


    "그래도 아주 잠깐, 집중이 끊겼다."


translate japanese plot10_stone_second_end_53f9a75a:



    voice "voice/cygnus_1237.ogg"
    cygnus "（뭐지? 방금 건 평범한 파편이 아니야――）"


translate japanese plot10_stone_second_end_25a66a74:



    voice "voice/cygnus_1238.ogg"
    cygnus "（마력이 담겨 있어… 설마――）"


translate japanese plot10_stone_second_end_e443bd3d:


    "시노스의 생각이 맞았다."


translate japanese plot10_stone_second_end_e3cdb431:


    "평범한 타일이라면 방어 마법을 뚫을 수 없다."


translate japanese plot10_stone_second_end_8d4432b3:


    "하지만 방금 조각에는 특별한 마력이 가득 차 있었다."


translate japanese plot10_stone_second_end_cbf4ba7a:


    "불꽃의 창이 장벽을 꿰뚫었듯, 작고 날카로운 조각이 시노스의 방어 마법을 갈라 버렸다."


translate japanese plot10_stone_second_end_a3ced588:


    "시노스가 극심한 통증을 느낀 순간, 「시간의 왕관의 대마녀」가 각성했다."


translate japanese plot10_stone_second_end_538ad1fb:


    "반장은 시노스의 지배를 떨쳐 내고 왕관을 되찾았다."


translate japanese plot10_stone_second_end_b666d3cf:



    voice "voice/cygnus_1239.ogg"
    cygnus "（성장했어!?）"


translate japanese plot10_stone_second_end_6552916a:


    "시노스를 놀라게 한 건 방금 공격만이 아니었다."


translate japanese plot10_stone_second_end_8d64df48:


    "마법진 안에 있는 또 한 명의 마녀."


translate japanese plot10_stone_second_end_8e55cece:


    "그 「심핵」에서 피가 넘쳐흐르고 있었다."


translate japanese plot10_stone_second_end_097d8267:


    "같은 곳에서, 아까보다 거센 마력까지 흘러넘쳤다."


translate japanese plot10_stone_second_end_95a3c7a2:


    "시노스의 마력은 이제 그녀에게 전혀 닿지 않았다."


translate japanese plot10_stone_second_end_69e1d008:



    voice "voice/tianqin_2131.ogg"
    tianqin "（――츠루기다!）"


translate japanese plot10_stone_second_end_922efea1:


    "라이라는 누가 시노스를 공격했는지 곧바로 알아차렸다."


translate japanese plot10_stone_second_end_80f4d3e2:


    "평소의 자신이라면 츠루기가 움직이는 순간 반드시 눈치챘을 것이다."


translate japanese plot10_stone_second_end_de29dd3b:


    "하지만 지금은 장벽을 붙잡는 데 온 힘을 다하느라, 츠루기의 움직임까지 보지 못했다."


translate japanese plot10_stone_second_end_9a01bb77:



    voice "voice/tianqin_2132.ogg"
    tianqin "（츠루기는 어디에!?）"


translate japanese plot10_stone_second_end_9b68ee43:



    voice "voice/hecheng_382.ogg"
    hecheng2 "찾을 필요 없어. 여기 있으니까."


translate japanese plot10_stone_second_end_bd8c1b31:



    voice "voice/tianqin_2133.ogg"
    tianqin "뭐――!?"


translate japanese plot10_stone_second_end_1fe78494:


    "츠루기는 숨지 않았다. 반장 바로 뒤에 서 있었다."


translate japanese plot10_stone_second_end_77973f08:



    voice "voice/hecheng_383.ogg"
    hecheng "반장. 같이 죽을까?"


translate japanese plot10_stone_second_end_4cd53f69:


    "그렇게 말하며, 날카로운 타일 조각을 반장에게 내질렀다."


translate japanese plot10_stone_second_end_64fc677d:


    "하지만 그 날카로운 끝은 목의 동맥을 몇 센티미터 앞에 두고 멈췄다."


translate japanese plot10_stone_second_end_26d62853:



    voice "voice/banzhang_787.ogg"
    chronicle "정말 구제할 길이 없는 인간이네."


translate japanese plot10_stone_second_end_4473ac9c:



    voice "voice/hecheng_384.ogg"
    hecheng "후후――젠장…"


translate japanese plot10_stone_second_end_ca1227ff:


    "츠루기는 씁쓸하게 웃으며 불만스럽게 중얼거렸다."


translate japanese plot10_stone_second_end_182141cd:


    "아무리 힘을 줘도 손에 쥔 조각은 꿈쩍도 하지 않았다."


translate japanese plot10_stone_second_end_3ea7fa15:


    "이윽고 손뿐 아니라 온몸이 움직이지 않는다는 걸 느꼈다."


translate japanese plot10_stone_second_end_93b1a050:


    "거대한 힘에 짓눌려, 그 자리에서 움직일 수 없게 됐다."


translate japanese plot10_stone_second_end_9d850d5a:



    voice "voice/hecheng_385.ogg"
    hecheng "쳇. 또 마법이야? 진짜 시시하네."


translate japanese plot10_stone_second_end_643b114b:



    voice "voice/banzhang_788.ogg"
    chronicle "정말 마지막이야. 남길 말은 없어?"


translate japanese plot10_stone_second_end_2d127aa7:



    voice "voice/hecheng_386.ogg"
    hecheng "아아――맞다. 좋은 거 하나 더 알려 줄게."


translate japanese plot10_stone_second_end_4ac16f99:



    voice "voice/hecheng_387.ogg"
    hecheng "사실 네 엄마 이야기는 집에 한 번도 한 적 없어."


translate japanese plot10_stone_second_end_2dfee193:



    voice "voice/banzhang_789.ogg"
    chronicle "…"


translate japanese plot10_stone_second_end_66cdb840:


    "대마녀는 그저 한숨을 내쉬었다."


translate japanese plot10_stone_second_end_3b6d3918:


    "그 사실은 미래의 기억으로 이미 알고 있었다."


translate japanese plot10_stone_second_end_f0023d20:


    "다만 이런 순간에도 츠루기가 오직 나를 화나게 하려고 그 말을 꺼낼 줄은 몰랐다."


translate japanese plot10_stone_second_end_32e8007e:



    voice "voice/hecheng_388.ogg"
    hecheng "아하하하하… 내가 널 도와줄 거라고 진심으로 믿었어?"


translate japanese plot10_stone_second_end_3e7f86f4:



    voice "voice/hecheng_389.ogg"
    hecheng "네가 멋대로 믿어 버린 거야. 전부 자업자득이지."


translate japanese plot10_stone_second_end_dcdd20d9:



    voice "voice/hecheng_390.ogg"
    hecheng "하하하… 하하하하하하――"


translate japanese plot10_stone_second_end_bc1ebb21:



    voice "voice/cygnus_1240.ogg"
    cygnus "라이라! 이제 한계야! 더는 못 버텨!"


translate japanese plot10_stone_second_end_9983b1a2:



    voice "voice/tianqin_2134.ogg"
    tianqin "안 돼! 둘을 데리고 나와야 해!"


translate japanese plot10_end2_shortcuts_restored_a60fb3df:


    cygnus "라이라!!"


translate japanese plot10_stone_second_end_ec52f887:


    "반장이 시노스의 힘에서 벗어나자, 멈춰 있던 마법이 다시 움직이기 시작했다."


translate japanese plot10_stone_second_end_739ff82d:


    "발밑의 마법진은 점점 더 밝게 빛나며, 곧 완성될 것을 알렸다."


translate japanese plot10_end2_shortcuts_restored_005bb89b:


    tianqin "반장!"


translate japanese plot10_stone_second_end_41c39739:


    "라이라는 장벽의 틈으로 마법진 안에 들어가, 두 사람을 끌어내려 했다."


translate japanese plot10_stone_second_end_aece6b36:


    "하지만 한 걸음 들어가자마자 거대한 힘에 막혀, 더는 나아갈 수 없었다."


translate japanese plot10_end2_shortcuts_restored_7354a6e6:


    tianqin "크으으으윽――!"


translate japanese plot10_stone_second_end_ee8d3516:



    voice "voice/hecheng_391.ogg"
    hecheng "그런 시시한 저항은 이제 그만해."


translate japanese plot10_stone_second_end_a2215d93:



    voice "voice/hecheng_392.ogg"
    hecheng "우리랑 같이 멸망하자."


translate japanese plot10_stone_second_end_339f3362:


    "문득 반장이 라이라에게 손을 뻗었다."


translate japanese plot10_farewell_pan_left_return_84005078:



    voice "voice/tianqin_2137.ogg"
    tianqin "반장?"


translate japanese plot10_end2_shortcuts_restored_3e67f630:


    tianqin "으앗――!"


translate japanese plot10_farewell_pan_left_return_f5da5177:


    "강한 힘이 라이라를 날려 보내, 마법진에서 멀리 떨어뜨렸다."


translate japanese plot10_farewell_pan_left_return_5fac7bc4:


    "반장의 몸에서 뿜어져 나온 압도적인 마력이었다."


translate japanese plot10_end2_shortcuts_restored_29ba17e1:


    voice "voice/tianqin_2139.ogg"
    tianqin 0109 "으윽――! 반장!"


translate japanese plot10_farewell_pan_left_return_ad78339d:


    "라이라는 곧바로 일어나, 다시 마법진으로 뛰어들려 했다."


translate japanese plot10_end2_shortcuts_restored_36526ada:


    p10_farewell_text "마법이 발동하고, 시간이 멈췄다."


translate japanese plot10_end2_shortcuts_restored_e66e1153:


    nvl clear
    p10_farewell_text "멈춘 시간은 한순간 같으면서도, 미칠 것처럼 길었다."


translate japanese plot10_end2_shortcuts_restored_2d74a568:


    nvl clear
    p10_farewell_text "그리고 시곗바늘이 반대 방향으로 움직이기 시작했다."


translate japanese plot10_end2_shortcuts_restored_00f923d5:


    p10_huisu_text "증오도, 분노도,"


translate japanese plot10_end2_shortcuts_restored_0b869b59:


    nvl clear
    p10_huisu_text "그녀들이 존재한 흔적도, 모두 사라져 간다."


translate japanese plot10_end2_shortcuts_restored_1332fb9b:


    p10_huisu_text "노력하며 흘린 땀. 합격을 이뤄 낸 성적. 며칠씩 매달린 문제…"


translate japanese plot10_end2_shortcuts_restored_1b138b97:


    p10_huisu_text "친구와 마주 보며 웃던 얼굴. 트랙을 오가던 나날. 기억에 남은 모습…"


translate japanese plot10_end2_shortcuts_restored_7e1f0924:


    p10_huisu_text "부주의해서 베인 상처. 죽은 떠돌이 개. 뺨에 남은 따귀 자국…"


translate japanese plot10_end2_shortcuts_restored_9889e1e3:


    p10_huisu_text "모든 것이 마법과 함께 사라졌다."


translate japanese plot10_end2_shortcuts_restored_8855ffed:


    nvl clear
    p10_huisu_text "그녀들과 관련된 모든 것이 허무로 돌아가, 누구의 기억에도 남지 않는다."


translate japanese plot10_end2_shortcuts_restored_fc186342:


    p10_huisu_text "모든 흔적이 사라지고 나서야,"


translate japanese plot10_end2_shortcuts_restored_c702ef28:


    p10_huisu_text "거꾸로 돌던 바늘이 마침내 멈췄다."


translate japanese plot10_end2_shortcuts_restored_05d30242:


    nvl clear
    p10_huisu_text "다시, 시간이 흐르기 시작했다."


translate japanese plot10_end2_shortcuts_restored_82870f18:


    tianqin "반장!!"


translate japanese plot10_farewell_pan_left_return_78773d91:



    voice "voice/tianqin_2143.ogg"
    tianqin "어… 여기, 교실…?"


translate japanese plot10_farewell_pan_left_return_79686e11:



    voice "voice/xizhen_48.ogg"
    xizhen "왜 그래? 라이라, 깜짝 놀랐잖아."


translate japanese plot10_farewell_pan_left_return_435d0737:



    voice "voice/tianqin_2144.ogg"
    tianqin "어, 너희…"


translate japanese plot10_farewell_pan_left_return_4b0497a3:


    "왜 이 둘이 여기 있지?"


translate japanese plot10_farewell_pan_left_return_e1671032:


    "――교실이니까 두 사람이 있는 건 당연하다."


translate japanese plot10_farewell_pan_left_return_e2275fb6:



    voice "voice/tianqin_2145.ogg"
    tianqin "아, 아니야――뭔가 이상해…"


translate japanese plot10_farewell_pan_left_return_30fa72e1:



    voice "voice/tianqin_2146.ogg"
    tianqin "반장은?"


translate japanese plot10_farewell_pan_left_return_6e4af6aa:



    voice "voice/minying_48.ogg"
    minying "아직 잠이 덜 깼어?"


translate japanese plot10_farewell_pan_left_return_3bd6d4e3:



    voice "voice/minying_49.ogg"
    minying "반장은 너잖아, 라이라."


translate japanese plot10_farewell_pan_left_return_9abebd75:



    voice "voice/tianqin_2147.ogg"
    tianqin "어…?"


translate japanese plot10_farewell_pan_left_return_5b04a3d0:


    "맞다… 반장은 나지…"


translate japanese plot10_farewell_pan_left_return_bfb9298e:


    "뭐가… 다른 거지…"


translate japanese plot10_farewell_pan_left_return_64ec41d0:



    voice "voice/tianqin_2148.ogg"
    tianqin "반장… 아니. 아키는?"


translate japanese plot10_farewell_pan_left_return_1eb5d9c2:



    voice "voice/tianqin_2149.ogg"
    tianqin "아키는 어디 있어?"


translate japanese plot10_farewell_pan_left_return_4bf1ba87:


    "라이라의 질문에, 희진과 민영은 서로 얼굴을 마주 봤다."


translate japanese plot10_farewell_pan_left_return_10cfc455:



    voice "voice/xizhen_49.ogg"
    xizhen "아키라니…"


translate japanese plot10_farewell_pan_left_return_97aa233d:



    voice "voice/xizhen_50.ogg"
    xizhen "그게 누구야?"


translate japanese plot10_farewell_pan_left_return_af81b19e:



    voice "voice/yangxi_738.ogg"
    yangxi "라이라!"


translate japanese plot10_farewell_pan_left_return_4abb76e6:



    voice "voice/tianqin_2150.ogg"
    tianqin "히나타…"


translate japanese plot10_farewell_pan_left_return_e31375fd:



    voice "voice/yangxi_739.ogg"
    yangxi "가자."


translate japanese plot10_farewell_pan_left_return_6dcc638f:



    voice "voice/tianqin_2151.ogg"
    tianqin "어? 어디로?"


translate japanese plot10_end2_shortcuts_restored_07fba278:



    voice "voice/yangxi_740.ogg"
    yangxi "授業をサボる。"


translate japanese plot10_farewell_pan_left_return_87f667ce:



    voice "voice/tianqin_2152.ogg"
    tianqin "으음——"


translate japanese plot10_farewell_pan_left_return_5307ca1f:


    "뭐지… 기억이…"


translate japanese plot10_farewell_pan_left_return_24cfcb1a:



    voice "voice/yangxi_741.ogg"
    yangxi "라이라. 아까까지 중앙공원에 있었지?"


translate japanese plot10_farewell_pan_left_return_44ca4cfe:



    voice "voice/tianqin_2153.ogg"
    tianqin "아까…"


translate japanese plot10_end2_shortcuts_restored_3b68ae45:



    voice "voice/tianqin_2154.ogg"
    tianqin "そう、そうだよ！私、中央公園にいた！"


translate japanese plot10_farewell_pan_left_return_cb461f30:



    voice "voice/tianqin_2155.ogg"
    tianqin "거기서 반장이랑 츠루기를 만났고…"


translate japanese plot10_farewell_pan_left_return_e6e83b8c:



    voice "voice/tianqin_2156.ogg"
    tianqin "어라――왜… 갑자기 학교에 돌아와 있는 거야…"


translate japanese plot10_farewell_pan_left_return_acaef73c:



    voice "voice/yangxi_742.ogg"
    yangxi "나도 중앙공원으로 가던 중이었어. 그런데 너랑 똑같이, 정신 차려 보니 교실에 돌아와 있더라."


translate japanese plot10_farewell_pan_left_return_5a958a92:



    voice "voice/yangxi_743.ogg"
    yangxi "거기서 무슨 일 있었어?"


translate japanese plot10_farewell_pan_left_return_3ff78620:



    voice "voice/tianqin_2157.ogg"
    tianqin "반장이… 시노스의 힘으로 마법을 썼어…"


translate japanese plot10_farewell_pan_left_return_4a5332e1:



    voice "voice/tianqin_2158.ogg"
    tianqin "맞아! 그거야! 전부 생각났어!"


translate japanese plot10_farewell_pan_left_return_33f66e3c:



    voice "voice/yangxi_744.ogg"
    yangxi "그 반장이라는 건…"


translate japanese plot10_end2_shortcuts_restored_6f241488:



    voice "voice/tianqin_2159.ogg"
    tianqin "アキだよ！"


translate japanese plot10_farewell_pan_left_return_8ec899cf:



    voice "voice/yangxi_745.ogg"
    yangxi "알아… 하지만 내 기억에는…"


translate japanese plot10_farewell_pan_left_return_4ead877a:



    voice "voice/yangxi_746.ogg"
    yangxi "이상해. 어떻게 된 거지…"


translate japanese plot10_farewell_pan_left_return_4262e6fe:


    "그때 라이라의 스마트폰에서 알림음이 울렸다."


translate japanese plot10_farewell_pan_left_return_6f4cb2ba:



    voice "voice/tianqin_2160.ogg"
    tianqin "…시노스한테 메시지가 왔어."


translate japanese plot10_farewell_pan_left_return_5d29e89f:



    voice "voice/tianqin_2161.ogg"
    tianqin "일단 집에 가자."


translate japanese plot10_farewell_pan_left_return_cb1162e8:



    voice "voice/cygnus_1242.ogg"
    cygnus "역시 두 사람에게는 원래 기억이 남아 있군."


translate japanese plot10_farewell_pan_left_return_9b7faf76:



    voice "voice/tianqin_2162.ogg"
    tianqin "어? 원래 기억?"


translate japanese plot10_farewell_pan_left_return_9be07e1b:



    voice "voice/cygnus_1243.ogg"
    cygnus "그래. 다만… 상당히 혼란스러운 기억일 거야."


translate japanese plot10_farewell_pan_left_return_452e447e:



    voice "voice/tianqin_2163.ogg"
    tianqin "무슨 뜻이야? 대체 무슨 일이 있었던 거야?"


translate japanese plot10_farewell_pan_left_return_b03439f3:



    voice "voice/cygnus_1244.ogg"
    cygnus "그 소녀… 아키는 자신을 대가로 마법을 썼어."


translate japanese plot10_farewell_pan_left_return_58010343:



    voice "voice/cygnus_1245.ogg"
    cygnus "그 마법의 효과도 대가와 같았지."


translate japanese plot10_farewell_pan_left_return_c20ca7a5:



    voice "voice/cygnus_1246.ogg"
    cygnus "존재의 허무화… 즉, 아키와 츠루기의 존재를 완전히 지웠어."


translate japanese plot10_farewell_pan_left_return_f04eb78f:



    voice "voice/cygnus_1247.ogg"
    cygnus "두 사람은 처음부터 이 세계에 있었던 적이 없게 된 거야."


translate japanese plot10_farewell_pan_left_return_1f2e5210:



    voice "voice/yangxi_747.ogg"
    yangxi "하지만… 이 기억은 대체 뭐야…"


translate japanese plot10_farewell_pan_left_return_9b383de9:



    voice "voice/yangxi_748.ogg"
    yangxi "서로 모순되는 두 기억이 동시에 있는 것 같아…"


translate japanese plot10_farewell_pan_left_return_b51bb6a3:



    voice "voice/cygnus_1248.ogg"
    cygnus "나도 그 점이 이상해. 원래라면 둘 다 아키와 츠루기를 완전히 잊었어야 해."


translate japanese plot10_farewell_pan_left_return_8bae9bb2:



    voice "voice/cygnus_1249.ogg"
    cygnus "세계 자체가 두 사람이 존재하지 않았던 형태로 다시 만들어지거든."


translate japanese plot10_farewell_pan_left_return_6e7b2541:



    voice "voice/cygnus_1250.ogg"
    cygnus "하지만 어째서인지… 너희에게는 원래 세계의 기억이 남아 있어."


translate japanese plot10_farewell_pan_left_return_9fed0c93:



    voice "voice/yangxi_749.ogg"
    yangxi "잠깐. 그럼… 방금 아키가 이 세계를 바꿔 쓴 거야?"


translate japanese plot10_farewell_pan_left_return_7fabd30e:



    voice "voice/cygnus_1251.ogg"
    cygnus "믿기 어렵겠지만, 그런 셈이지."


translate japanese plot10_farewell_pan_left_return_444c4218:



    voice "voice/cygnus_1252.ogg"
    cygnus "이 새로운 세계에는 아키와 츠루기라는 사람이 없어."


translate japanese plot10_farewell_pan_left_return_07c199cf:



    voice "voice/cygnus_1253.ogg"
    cygnus "아마 우리 말고는 두 사람이 있었다는 걸 아는 이는 없을 거야."


translate japanese plot10_farewell_pan_left_return_d5ebe59f:


    "2주 후."


translate japanese plot10_farewell_pan_left_return_eae9b72e:



    voice "voice/tianqin_2164.ogg"
    tianqin "후우… 오늘 반장 일은 이걸로 끝인가."


translate japanese plot10_farewell_pan_left_return_2c5b46df:



    voice "voice/tianqin_2165.ogg"
    tianqin "드디어 쉴 수 있겠다――"


translate japanese plot10_farewell_pan_left_return_054b4e96:



    voice "voice/yangxi_750.ogg"
    yangxi "일은 잘돼 가시나요, 반장님?"


translate japanese plot10_farewell_pan_left_return_0549750b:



    voice "voice/tianqin_2166.ogg"
    tianqin "놀리지 말고 얼른 도와줘."


translate japanese plot10_farewell_pan_left_return_e54fac39:



    voice "voice/tianqin_2167.ogg"
    tianqin "이러다간 방과 후에도 집에 못 가겠어."


translate japanese plot10_farewell_pan_left_return_d1773eab:



    voice "voice/yangxi_751.ogg"
    yangxi "네, 네――"


translate japanese plot10_farewell_pan_left_return_792cf4c6:



    voice "voice/xizhen_51.ogg"
    xizhen "반장. 우리 체육 특기생들은 이따 훈련이 있어서."


translate japanese plot10_farewell_pan_left_return_9e4a8a86:



    voice "voice/minying_50.ogg"
    minying "다음 수업은 빠질게."


translate japanese plot10_farewell_pan_left_return_331e1b3a:



    voice "voice/tianqin_2168.ogg"
    tianqin "거짓말하지 마. 둘 다 그냥 수업 빠지고 싶은 거잖아."


translate japanese plot10_farewell_pan_left_return_8353dfc8:



    voice "voice/xizhen_52.ogg"
    xizhen "헤헤, 부탁해."


translate japanese plot10_farewell_pan_left_return_a450d375:



    voice "voice/minying_51.ogg"
    minying "내일 밀크티 살게."


translate japanese plot10_farewell_pan_left_return_757aea4d:



    voice "voice/tianqin_2169.ogg"
    tianqin "그렇다면 허락하지."


translate japanese plot10_farewell_pan_left_return_0370accf:



    voice "voice/tianqin_2170.ogg"
    tianqin "가 봐. 담임 선생님한테 걸리지 말고."


translate japanese plot10_farewell_pan_left_return_ad09aa13:



    voice "voice/xizhen_53.ogg"
    xizhen "고마워, 반장――"


translate japanese plot10_farewell_pan_left_return_a63b5603:



    voice "voice/yangxi_752.ogg"
    yangxi "그렇게 쉽게 수업 빠지게 해 줘도 정말 괜찮아?"


translate japanese plot10_farewell_pan_left_return_edaeb1c7:



    voice "voice/tianqin_2171.ogg"
    tianqin "괜찮아. 둘은 체육 특기생이잖아."


translate japanese plot10_farewell_pan_left_return_bde39fa4:



    voice "voice/yangxi_753.ogg"
    yangxi "…너 같은 애가 반장이 되다니, 아직도 믿기지 않아."


translate japanese plot10_farewell_pan_left_return_523af42f:



    voice "voice/tianqin_2172.ogg"
    tianqin "으음――사실 나도… 믿기지 않아."


translate japanese plot10_farewell_pan_left_return_0ad36b0c:


    "중앙공원에서 그 일이 있은 지 2주가 지났다."


translate japanese plot10_farewell_pan_left_return_46277345:


    "우리 반에서 그 일을 알고 있는 건 나와 히나타뿐이다."


translate japanese plot10_farewell_pan_left_return_cc7fc1a7:


    "나는 어째서인지 반장이 되어 있었다."


translate japanese plot10_farewell_pan_left_return_61e0ab43:


    "매일 반장 일로 바쁘게 뛰어다니고 있다."


translate japanese plot10_farewell_pan_left_return_7ecfea1c:


    "히나타는 원예부에 들어갔다."


translate japanese plot10_farewell_pan_left_return_96394423:


    "아키나와 둘이서 원예부를 꾸려 가고 있다."


translate japanese plot10_farewell_pan_left_return_d92c4ce0:


    "기억 속에서는 분명 우리가 갑자기 마음이 내켜 시작한 일이었다."


translate japanese plot10_farewell_pan_left_return_bd1a59c3:


    "하지만 왜 갑자기 그런 생각이 들었는지는 설명할 수 없었다."


translate japanese plot10_farewell_pan_left_return_2e9c9544:


    "시노스의 말대로 세계는 변해 있었다."


translate japanese plot10_farewell_pan_left_return_e2789539:


    "아키와 츠루기가 없어도 성립하는 세계로 바뀌었다."


translate japanese plot10_farewell_pan_left_return_e2d1e59e:


    "두 사람이 있던 흔적은 누가 봐도 이상하게 여기지 않을 형태로 바뀌어 있었다."


translate japanese plot10_farewell_pan_left_return_3dd18654:


    "살해당한 두 사람마저, 지금은 멀쩡한 모습으로 눈앞에 있다."


translate japanese plot10_farewell_pan_left_return_a993feab:


    "세계는 아키와 츠루기를 잊었다."


translate japanese plot10_farewell_pan_left_return_081a4b6e:


    "방과 후, 원예부."


translate japanese plot10_farewell_pan_left_return_ac17de7e:


    "괴롭힘 자체가 일어나지 않았기에, 식물들은 모두 건강하게 자라고 있었다."


translate japanese plot10_farewell_pan_left_return_aba3fbc0:


    "히나타가 직접 채소를 심은 밭도 푸르게 우거져 있었다."


translate japanese plot10_end2_shortcuts_restored_e163abfa:



    voice "voice/yangxi_754.ogg"
    yangxi "はあ…園芸部…"


translate japanese plot10_farewell_pan_left_return_75e37bbd:



    voice "voice/yangxi_755.ogg"
    yangxi "왜 내가 원예부를 돌보고 있는 거야…"


translate japanese plot10_farewell_pan_left_return_920fc9a7:



    voice "voice/tianqin_2173.ogg"
    tianqin "예전의 너한테 물어봐야겠지."


translate japanese plot10_end2_shortcuts_restored_b6f3cdd0:



    voice "voice/yangxi_756.ogg"
    yangxi "その記憶の私は、絶対に私じゃない。自分から面倒ごとを抱えるようなタイプじゃない…"


translate japanese plot10_farewell_pan_left_return_b388dce1:



    voice "voice/tianqin_2174.ogg"
    tianqin "알지, 알지――나도 반장이 됐잖아."


translate japanese plot10_farewell_pan_left_return_e254cbce:



    voice "voice/yangxi_757.ogg"
    yangxi "으… 조만간 전부 아키나한테 떠넘겨야지…"


translate japanese plot10_farewell_pan_left_return_0ffd8c91:



    voice "voice/xiaoxia_159.ogg"
    xiaoxia "아, 히나타 씨. 오셨군요."


translate japanese plot10_farewell_pan_left_return_fb3f0cbf:



    voice "voice/xiaoxia_160.ogg"
    xiaoxia "방금 지도 선생님께서 동아리 예산을 또 줄이겠다고 하셔서…"


translate japanese plot10_end2_shortcuts_restored_e87ddc2d:


    yangxi "뭐!? 아직도 그런 소리 하셔?"


translate japanese plot10_farewell_pan_left_return_d59d6d74:



    voice "voice/yangxi_759.ogg"
    yangxi "당장 담임 선생님께 말씀드리고 올게!"


translate japanese plot10_farewell_pan_left_return_5f9572d7:



    voice "voice/tianqin_2175.ogg"
    tianqin "이런… 당분간 아키나한테 맡기기는 어렵겠네."


translate japanese plot10_farewell_pan_left_return_d8216ece:


    voice "voice/npc3_19.ogg"
    npc3 "아키나, 가자."


translate japanese plot10_farewell_pan_left_return_424acb7c:



    voice "voice/xiaoxia_161.ogg"
    xiaoxia "아, 동화. 기다려――"


translate japanese plot10_farewell_pan_left_return_ff8fa612:



    voice "voice/xiaoxia_162.ogg"
    xiaoxia "저, 저기, 히나타 씨…"


translate japanese plot10_farewell_pan_left_return_8692b021:



    voice "voice/yangxi_760.ogg"
    yangxi "괜찮아, 먼저 가. 담임 선생님께는 내가 말씀드릴게."


translate japanese plot10_farewell_pan_left_return_709b8964:



    voice "voice/xiaoxia_163.ogg"
    xiaoxia "감사합니다――!"


translate japanese plot10_farewell_pan_left_return_a0b57040:


    "이 세계는 크게, 그리고 작게 변했다."


translate japanese plot10_farewell_pan_left_return_d78e6024:


    "다행히 아무도 모른다. 아는 건 우리뿐이다."


translate japanese plot10_farewell_pan_left_return_4cf72ad5:


    "불행히 아무도 모른다. 아는 건 우리뿐이다."


translate japanese plot10_farewell_pan_left_return_17c6c546:



    voice "voice/yangxi_761.ogg"
    yangxi "드디어 끝났네… 모처럼의 방과 후 시간을 다 날렸어."


translate japanese plot10_end2_shortcuts_restored_724ee8f9:



    voice "voice/tianqin_2176.ogg"
    tianqin "ヒナタちゃんとアキナちゃんの運営で、園芸部がここまで大きくなるなんて思わなかったよ。"


translate japanese plot10_farewell_pan_left_return_33835ddf:



    voice "voice/yangxi_762.ogg"
    yangxi "나도 놀랐어."


translate japanese plot10_end2_shortcuts_restored_323f194b:



    voice "voice/yangxi_763.ogg"
    yangxi "本当に、私がしたことなのか…"


translate japanese plot10_farewell_pan_left_return_4e9a0279:


    "히나타는 아직도 믿기지 않는 듯했다."


translate japanese plot10_farewell_pan_left_return_2d178571:


    "기억 자체는 틀리지 않았다. 우리 둘 다 알고 있었다."


translate japanese plot10_farewell_pan_left_return_06cec01f:


    "서로 어긋나는 두 기억에 아직 익숙하지 않을 뿐이었다."


translate japanese plot10_farewell_pan_left_return_b5216e5c:



    voice "voice/tianqin_2177.ogg"
    tianqin "아――저기 있는 사람…"


translate japanese plot10_farewell_pan_left_return_f7d857fb:



    voice "voice/yangxi_764.ogg"
    yangxi "왜 그래?"


translate japanese plot10_farewell_pan_left_return_cc067dd1:



    voice "voice/tianqin_2178.ogg"
    tianqin "반장… 아키 어머니 같아."


translate japanese plot10_farewell_pan_left_return_d56c1fd0:



    voice "voice/yangxi_765.ogg"
    yangxi "어? 어떻게?"


translate japanese plot10_farewell_pan_left_return_0466e847:



    voice "voice/tianqin_2179.ogg"
    tianqin "저기 봐."


translate japanese plot10_farewell_pan_left_return_999d4527:



    voice "voice/yangxi_766.ogg"
    yangxi "――정말이네."


translate japanese plot10_farewell_pan_left_return_6b711b4f:



    voice "voice/yangxi_767.ogg"
    yangxi "하지만…"


translate japanese plot10_farewell_pan_left_return_3eb240cd:



    voice "voice/tianqin_2180.ogg"
    tianqin "…잠깐 이야기 좀 하고 올게."


translate japanese plot10_farewell_pan_left_return_5288ef6f:



    voice "voice/yangxi_768.ogg"
    yangxi "잠깐만."


translate japanese plot10_farewell_pan_left_return_44ef9382:



    voice "voice/tianqin_2181.ogg"
    tianqin "알아! 분명 기억 못 하시겠지."


translate japanese plot10_farewell_pan_left_return_d33c2fd8:



    voice "voice/tianqin_2182.ogg"
    tianqin "그래도… 조금 이야기하고 싶어."


translate japanese plot10_farewell_pan_left_return_0d100c51:



    voice "voice/mama_83.ogg"
    mama3 "…"


translate japanese plot10_farewell_pan_left_return_bc1173c7:



    voice "voice/tianqin_2183.ogg"
    tianqin "안녕하세요. 누구 기다리세요?"


translate japanese plot10_farewell_pan_left_return_60e9dd32:



    voice "voice/mama_84.ogg"
    mama3 "아, 안녕하세요."


translate japanese plot10_farewell_pan_left_return_37f73d04:



    voice "voice/mama_85.ogg"
    mama3 "기다리는 건 아니에요. 그냥 지나가던 길이랍니다."


translate japanese plot10_farewell_pan_left_return_338b0c69:



    voice "voice/mama_86.ogg"
    mama3 "룽화 1고 학생인가요?"


translate japanese plot10_farewell_pan_left_return_9971bc8d:



    voice "voice/tianqin_2184.ogg"
    tianqin "네. 방금 학교가 끝났어요."


translate japanese plot10_farewell_pan_left_return_7cdf2729:



    voice "voice/mama_87.ogg"
    mama3 "그렇군요… 꽤 늦은 시간이네요."


translate japanese plot10_farewell_pan_left_return_00c37416:



    voice "voice/tianqin_2185.ogg"
    tianqin "아… 동아리 일이 있어서요."


translate japanese plot10_farewell_pan_left_return_ffbf5261:



    voice "voice/mama_88.ogg"
    mama3 "동아리라… 그립네요."


translate japanese plot10_farewell_pan_left_return_653a8a30:



    voice "voice/mama_89.ogg"
    mama3 "저도 예전에는 여러분처럼 매일 동아리 활동으로 바빠서, 늦게까지 학교에 있었어요."


translate japanese plot10_farewell_pan_left_return_d1906061:



    voice "voice/tianqin_2186.ogg"
    tianqin "예전에 이 학교에 다니셨어요?"


translate japanese plot10_farewell_pan_left_return_4bca28f9:



    voice "voice/mama_90.ogg"
    mama3 "네. 저도 룽화 1고 학생이었답니다."


translate japanese plot10_farewell_pan_left_return_7a6051a5:



    voice "voice/mama_91.ogg"
    mama3 "그래서 여길 지날 때마다 옛날 생각이 나요."


translate japanese plot10_farewell_pan_left_return_120d10df:



    voice "voice/tianqin_2187.ogg"
    tianqin "그렇군요…"


translate japanese plot10_end2_shortcuts_restored_63c7d60b:


    "女性は、校舎と帰り支度をする生徒たちを懐かしそうに見つめていた。"


translate japanese plot10_farewell_pan_left_return_759eacbb:


    "우리가 떠올리는 것은 서로 다르다. 그 사실이 조금 슬펐다."


translate japanese plot10_end2_shortcuts_restored_dd1ddce9:



    voice "voice/mama_92.ogg"
    mama3 "それじゃあ、私もそろそろ帰りますわね。"


translate japanese plot10_farewell_pan_left_return_598f9acb:



    voice "voice/mama_93.ogg"
    mama3 "공부 열심히 해요. 이 학교 학생들은 좋은 대학에 많이 가니까요."


translate japanese plot10_farewell_pan_left_return_b0a962d2:



    voice "voice/tianqin_2188.ogg"
    tianqin "네. 감사합니다."


translate japanese plot10_farewell_pan_left_return_07840ae9:



    voice "voice/mama_94.ogg"
    mama3 "아, 맞다. 저는 여행사에서 일해요."


translate japanese plot10_farewell_pan_left_return_2a6a67f2:



    voice "voice/mama_95.ogg"
    mama3 "졸업 여행을 계획하게 되면 전화 주세요."


translate japanese plot10_farewell_pan_left_return_c28c1ab7:



    voice "voice/mama_96.ogg"
    mama3 "왠지 인연이 있는 것 같으니, 그때는 조금 싸게 해 드릴게요."


translate japanese plot10_farewell_pan_left_return_35159d54:


    "여성은 웃으며 명함을 내밀었고, 나는 그것을 받았다."


translate japanese plot10_farewell_pan_left_return_09e866b5:


    "그리고 서로 손을 흔들며 조용히 헤어졌다."


translate japanese plot10_farewell_pan_left_return_056e6fb7:



    voice "voice/yangxi_769.ogg"
    yangxi "여전히 누구하고나 금방 친해지네. 사람 잘못 본 건 아니지?"


translate japanese plot10_farewell_pan_left_return_7ca3c0bf:



    voice "voice/tianqin_2189.ogg"
    tianqin "응… 역시 아키 어머니였어…"


translate japanese plot10_farewell_pan_left_return_89509c4a:



    voice "voice/tianqin_2190.ogg"
    tianqin "아키는 없어졌지만, 어머니는 사고를 당하지 않으신 거야…"


translate japanese plot10_farewell_pan_left_return_8a0aa572:



    voice "voice/yangxi_770.ogg"
    yangxi "그건 나쁜 일은 아닌 것 같아."


translate japanese plot10_end2_shortcuts_restored_c3ce279f:



    voice "voice/yangxi_771.ogg"
    yangxi "アキも、あのときそこまで考えていたのかもしれない。"


translate japanese plot10_farewell_pan_left_return_ea39f4eb:



    voice "voice/tianqin_2191.ogg"
    tianqin "으음. 어떨까…"


translate japanese plot10_end2_shortcuts_restored_43f278a6:



    voice "voice/yangxi_772.ogg"
    yangxi "もう、この話はやめよう。どこか遊びに行く？"


translate japanese plot10_farewell_pan_left_return_8de2d1e2:



    voice "voice/yangxi_773.ogg"
    yangxi "곧 기말고사잖아. 앞으로 놀 시간도 줄어들 텐데."


translate japanese plot10_farewell_pan_left_return_e03658d8:



    voice "voice/tianqin_2192.ogg"
    tianqin "아… 난 됐어."


translate japanese plot10_farewell_pan_left_return_2901be4a:



    voice "voice/tianqin_2193.ogg"
    tianqin "좀 더 혼자 생각하고 싶어."


translate japanese plot10_farewell_pan_left_return_3c379695:



    voice "voice/yangxi_774.ogg"
    yangxi "…그렇구나. 알겠어."


translate japanese plot10_farewell_pan_left_return_25152bb8:


    "한편, 중앙공원."


translate japanese plot10_farewell_pan_left_return_002098ab:


    "주위를 둘러보고 아무도 따라오지 않는 것을 확인한 뒤, 거목이 있는 안쪽으로 향했다."


translate japanese plot10_farewell_pan_left_return_74a95f9a:


    "거목 주변은 바리케이드로 둘러싸여 있었다."


translate japanese plot10_farewell_pan_left_return_bfb42555:


    "세계가 「변한」 탓에, 이곳에서 이상한 일이 일어났다는 걸 아무도 기억하지 못했다."


translate japanese plot10_farewell_pan_left_return_8a27eaf9:


    "2주 사이에 거목은 완전히 룽화시의 새로운 관광 명소가 됐다."


translate japanese plot10_farewell_pan_left_return_e1f8081d:


    "관광객이 줄기를 기다렸다가 투명화 마법으로 바리케이드를 넘어, 나무뿌리를 따라 안쪽으로 들어갔다."


translate japanese plot10_farewell_pan_left_return_e45b03ce:



    voice "voice/cygnus_1254.ogg"
    cygnus "으음…"


translate japanese plot10_farewell_pan_left_return_1f233745:


    "처음 접했을 때처럼 마력을 보내, 간단히 거목과 연결했다."


translate japanese plot10_farewell_pan_left_return_718bd3ae:



    voice "voice/cygnus_1255.ogg"
    cygnus "마력 반응은 정상. 강도는 중간 정도… 어제와 같네."


translate japanese plot10_farewell_pan_left_return_e10d9a05:


    "그날부터 거목 안에서는 마력이 흐르기 시작했다. 마치 잠에서 깬 것처럼."


translate japanese plot10_farewell_pan_left_return_662efea4:


    "그 {rb}대마녀{/rb}{rt}시간의 왕관{/rt}의 영향인지, 세계가 바뀌면서 거목까지 변한 것인지는 알 수 없었다."


translate japanese plot10_farewell_pan_left_return_48dcb7e9:


    "어쨌든 매일 이곳에 와서 상태를 기록한다."


translate japanese plot10_farewell_pan_left_return_ea249a9f:


    "결과는 늘 같았다. 마력은 있지만 이상은 없다. 겉으로 보면 그저 크게 자란 나무일 뿐이었다."


translate japanese plot10_farewell_pan_left_return_91390424:


    "다음에 자신을 바꿀 무언가가 찾아오기를 기다리는 듯했다."


translate japanese plot10_farewell_pan_left_return_c1880127:



    voice "voice/cygnus_1256.ogg"
    cygnus "이 나무는 대체 뭐지…"


translate japanese plot10_farewell_pan_left_return_b884317e:


    "기억 속에서는 나와 용사도 한 그루의 나무를 쫓아 움직였던 것 같다."


translate japanese plot10_farewell_pan_left_return_97df0829:


    "두 나무 사이에 연관이 있을까. 모르겠다."


translate japanese plot10_farewell_pan_left_return_1693d2c9:


    "그 후로 기억은 조금도 돌아오지 않았다."


translate japanese plot10_farewell_pan_left_return_e2ece4c8:



    voice "voice/cygnus_1257.ogg"
    cygnus "다른 단서는 없을까…"


translate japanese plot10_farewell_pan_left_return_fbf2e8fb:


    "아무리 생각해도 지금 상태를 바꿀 방법은 찾을 수 없었다."


translate japanese plot10_farewell_pan_left_return_4d4056ba:


    "모든 것이 이 나무처럼 계기를 기다리고 있다."


translate japanese plot10_farewell_pan_left_return_517b3a58:


    "이런 느낌은 싫다."


translate japanese plot10_farewell_pan_left_return_2120f88e:



    voice "voice/cygnus_1258.ogg"
    cygnus "…됐다. 오늘 저녁에 뭘 먹을지 생각하는 게 낫겠어."


translate japanese plot10_farewell_pan_left_return_cf31f7b7:



    voice "voice/cygnus_1259.ogg"
    cygnus "돌아가자."


translate japanese plot10_farewell_pan_left_return_e45b03ce_1:



    voice "voice/cygnus_1260.ogg"
    cygnus "으음…"


translate japanese plot10_farewell_pan_left_return_bf412dc5:



    voice "voice/cygnus_1261.ogg"
    cygnus "（치킨 카레랑 어향육사라…）"


translate japanese plot10_farewell_pan_left_return_f4d28ee9:


    "도시락 진열대 앞에서 한동안 망설였다."


translate japanese plot10_farewell_pan_left_return_7b952010:


    "오늘은 할인 도시락이 이렇게 많이 남아 있을 줄 몰랐다."


translate japanese plot10_end2_shortcuts_restored_fccdb3ad:


    "いつもなら、一つか二つしか残っていない。"


translate japanese plot10_farewell_pan_left_return_063c1a63:


    "선택지가 많으면 오히려 고르기 어려워진다."


translate japanese plot10_farewell_pan_left_return_7e8a9a64:



    voice "voice/cygnus_1262.ogg"
    cygnus "뭐, 됐어. 둘 다 먹을 수 있으니까. 둘 다 사자."


translate japanese plot10_farewell_pan_left_return_af83f3da:


    "이 세계에 온 지도 곧 한 달이 된다."


translate japanese plot10_farewell_pan_left_return_5faf8730:


    "이곳 생활에도 익숙해져서, 이 세계 사람들 눈에는 나도 이제 평범한 주민과 다르지 않을 것이다."


translate japanese plot10_farewell_pan_left_return_53c434c9:


    "가끔, 정말 가끔 상식을 잘못 이해할 때도 있다. 하지만 대단한 문제는 아니다."


translate japanese plot10_farewell_pan_left_return_cde27ca8:


    "내가 다른 세계에서 왔다고는 아무도 생각하지 않겠지."


translate japanese plot10_farewell_pan_left_return_9c976611:



    voice "voice/cygnus_1263.ogg"
    cygnus "이제 음료수… 싼 건 커피랑 꿀 홍차네."


translate japanese plot10_farewell_pan_left_return_4ebf48ec:



    voice "voice/cygnus_1264.ogg"
    cygnus "으음――커피로 하자."


translate japanese plot10_farewell_pan_left_return_317eafa5:



    voice "voice/cygnus_1265.ogg"
    cygnus "그러고 보니 라이라가 이 도시락에는 커피가 안 어울린다고 했었지…"


translate japanese plot10_farewell_pan_left_return_d7e47718:


    "내 몸은 마나로 이뤄져 있다. 먹지 않아도 문제없다."


translate japanese plot10_farewell_pan_left_return_6542913f:


    "그래도 이곳 음식은 싫지 않다. 현대 요리를 꽤 즐기고 있다."


translate japanese plot10_farewell_pan_left_return_72a61ded:



    voice "voice/cygnus_1266.ogg"
    cygnus "응… 이만큼 사면 충분하겠어."


translate japanese plot10_farewell_pan_left_return_cc5de188:



    voice "voice/cygnus_1267.ogg"
    cygnus "계산해 주세요."


translate japanese plot10_farewell_pan_left_return_89edba4e:



    voice "voice/tianying_0008.ogg"
    npc41 "도시락은 데워 드릴까요?"


translate japanese plot10_farewell_pan_left_return_2eeda3a3:



    voice "voice/cygnus_1268.ogg"
    cygnus "어…!"


translate japanese plot10_farewell_pan_left_return_1b9948ae:


    "나도 모르게 굳어 버렸다. 계산대에 있는 사람은 신입인지, 지금껏 본 적 없는 점원이었다."


translate japanese plot10_farewell_pan_left_return_59ed5b12:


    "하지만 처음 보는 점원이라 굳은 건 아니었다. 그 얼굴이 너무나――"


translate japanese plot10_farewell_pan_left_return_3f2b0673:


    "라이라와 닮아 있었다."


translate japanese plot10_farewell_pan_left_return_275a20dc:



    voice "voice/tianying_0009.ogg"
    npc41 "손님?"


translate japanese plot10_farewell_pan_left_return_a4b90c0c:



    voice "voice/cygnus_1269.ogg"
    cygnus "아, 네! 죄송해요, 데워 주세요…"


translate japanese plot10_farewell_pan_left_return_12b0c222:



    voice "voice/tianying_0010.ogg"
    npc41 "네. 잠시만 기다려 주세요."


translate japanese plot10_farewell_pan_left_return_d9203462:



    voice "voice/tianying_0011.ogg"
    npc41 "이쪽에 결제 코드를 보여 주세요."


translate japanese plot10_farewell_pan_left_return_301c03b2:



    voice "voice/cygnus_1270.ogg"
    cygnus "아, 네."


translate japanese plot10_farewell_pan_left_return_936c4298:



    voice "voice/cygnus_1271.ogg"
    cygnus "…"


translate japanese plot10_farewell_pan_left_return_edc219c6:


    "전자레인지 돌아가는 소리를 들으며, 나는 여전히 새 점원을 빤히 바라보고 있었다."


translate japanese plot10_farewell_pan_left_return_2d2af4e2:


    "정말 많이 닮았다."


translate japanese plot10_farewell_pan_left_return_70150ae1:



    voice "voice/tianying_0012.ogg"
    npc41 "손님."


translate japanese plot10_farewell_pan_left_return_cd38b4cf:



    voice "voice/cygnus_1272.ogg"
    cygnus "아, 네?"


translate japanese plot10_farewell_pan_left_return_882def0a:



    voice "voice/tianying_0013.ogg"
    npc41 "더 찾으시는 게 있으세요?"


translate japanese plot10_farewell_pan_left_return_ec906727:



    voice "voice/cygnus_1273.ogg"
    cygnus "아, 아니요. 괜찮아요."


translate japanese plot10_farewell_pan_left_return_745c1c2d:



    voice "voice/tianying_0014.ogg"
    npc41 "안색이 조금 안 좋으시네요, 손님."


translate japanese plot10_farewell_pan_left_return_620c88c9:



    voice "voice/cygnus_1274.ogg"
    cygnus "아, 그런가요…"


translate japanese plot10_farewell_pan_left_return_62440422:



    voice "voice/tianying_0015.ogg"
    npc41 "요즘 잠을 잘 못 주무세요?"


translate japanese plot10_farewell_pan_left_return_e47d25ca:



    voice "voice/cygnus_1275.ogg"
    cygnus "아뇨, 그런 건 아닌데…"


translate japanese plot10_farewell_pan_left_return_12693946:



    voice "voice/tianying_0016.ogg"
    npc41 "고민이 있으시면 제게 말씀하셔도 괜찮아요."


translate japanese plot10_farewell_pan_left_return_fc8f227f:



    voice "voice/cygnus_1276.ogg"
    cygnus "네?"


translate japanese plot10_farewell_pan_left_return_528e42b4:



    voice "voice/tianying_0017.ogg"
    npc41 "다만 지금은 일하는 중이니까,"


translate japanese plot10_farewell_pan_left_return_e2d13614:



    voice "voice/tianying_0018.ogg"
    npc41 "먼저 연락처를 드릴게요. 필요하시면 언제든 연락 주세요."


translate japanese plot10_farewell_pan_left_return_60fc828f:



    voice "voice/cygnus_1277.ogg"
    cygnus "아, 아니요! 괜찮아요. 마음만 받을게요."


translate japanese plot10_farewell_pan_left_return_d3a588d4:



    voice "voice/tianying_0019.ogg"
    npc41 "그런가요?"


translate japanese plot10_farewell_pan_left_return_7ebb7223:



    voice "voice/npc42_01.ogg"
    npc42 "정말！ 타카야！ 또 손님을 곤란하게 하고 있네！"


translate japanese plot10_farewell_pan_left_return_7ddb1752:


    voice "voice/tianying_0020.ogg"
    npc43 "이분이 뭔가 고민하시는 것 같아서…"


translate japanese plot10_farewell_pan_left_return_35d15d69:



    voice "voice/npc42_02.ogg"
    npc42 "그 고민의 원인이 너잖아!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot10_farewell_pan_left_return_e43a8023:



    voice "voice/npc42_03.ogg"
    npc42 "죄송합니다. 얘가 나쁜 사람은 아니에요."


translate japanese plot10_farewell_pan_left_return_ac02213c:



    voice "voice/npc42_04.ogg"
    npc42 "여기서 일한 지 얼마 안 돼서 아직 서툴러요."


translate japanese plot10_farewell_pan_left_return_178f437e:



    voice "voice/cygnus_1278.ogg"
    cygnus "아… 저는 괜찮아요."


translate japanese plot10_farewell_pan_left_return_3ab23868:


    "띵――"


translate japanese plot10_farewell_pan_left_return_852f14a7:


    voice "voice/tianying_0021.ogg"
    npc43 "도시락 데워졌습니다."


translate japanese plot10_farewell_pan_left_return_c6738403:


    voice "voice/tianying_0022.ogg"
    npc43 "또 오세요."


translate japanese plot10_farewell_pan_left_return_c419590d:



    voice "voice/cygnus_1279.ogg"
    cygnus "…이렇게까지 라이라를 닮은 사람이 있다니."


translate japanese plot10_farewell_pan_left_return_9df0dbcc:



    voice "voice/cygnus_1280.ogg"
    cygnus "게다가 똑같이 이상한 사람이야…"


translate japanese plot10_farewell_pan_left_return_cb2b926f:


    "그 일이 있은 지 2주가 지났다."


translate japanese plot10_farewell_pan_left_return_66f1bf94:


    "겉으로 보면 라이라는 평소처럼 잘 웃었다."


translate japanese plot10_farewell_pan_left_return_5a4ad13e:


    "하지만 나는 알고 있다. 라이라는 아직 그 일을 받아들이지 못했다."


translate japanese plot10_farewell_pan_left_return_7d49ae07:


    "요즘은 매일 귀가가 무척 늦다. 저녁도 만들지 않게 됐다."


translate japanese plot10_farewell_pan_left_return_d3e0d781:


    "지난 2주 동안 저녁은 줄곧 편의점 도시락이었다."


translate japanese plot10_farewell_pan_left_return_571cd547:


    "――물론, 불만은 전혀 없다."


translate japanese plot10_farewell_pan_left_return_b98bacc3:


    "모든 건 내 탓이다. 사과해야 할 사람은 나였다."


translate japanese plot10_farewell_pan_left_return_1803d57e:


    "――그때."


translate japanese plot10_farewell_pan_left_return_c3000528:


    "오랫동안 찾아온 마도구는 내 명령을 듣지 않고, 대기적이라 부를 만한 마법을 사용했다."


translate japanese plot10_farewell_pan_left_return_2251c52d:


    "두 소녀가 이 세계에 있었던 흔적을 모조리 지우는 마법이었다."


translate japanese plot10_farewell_pan_left_return_16577ed0:


    "육체도, 영혼도, 기억도…"


translate japanese plot10_farewell_pan_left_return_c9e292da:


    "모든 것이 마법이 발동하는 순간 사라졌다."


translate japanese plot10_farewell_pan_left_return_5d039662:


    "두 사람은 「허무」로 보내졌다. 누구도 관측할 수 없는 종말의 장소로."


translate japanese plot10_farewell_pan_left_return_86726022:


    "마법으로 사람을 없애는 것과는 다르다. 두 사람과 관련된 모든 것이 지워졌다."


translate japanese plot10_farewell_pan_left_return_122f47f8:


    "「현실을 바꾸는」 기적처럼, 세계 전체가 변했다."


translate japanese plot10_farewell_pan_left_return_4abd762d:


    "나와 라이라가 현장에 돌아갔을 때, 두 소녀는 이미 사라지고 없었다."


translate japanese plot10_farewell_pan_left_return_82475efb:


    "내 {rb}마도구{/rb}{rt}왕 관{/rt}도 어디에도 없었다."


translate japanese plot10_farewell_pan_left_return_46a1de52:


    "모든 힘을 써서 술식을 완성하고 마법을 발동해, {rb}대마녀{/rb}{rt}시간의 왕관{/rt}의 바람을 현실로 만든 듯했다."


translate japanese plot10_farewell_pan_left_return_bd37b98b:


    "그만큼 거대한 마법을 썼다면, 마도구가 사라져도 이상할 건 없다."


translate japanese plot10_farewell_pan_left_return_24648078:


    "그 후 라이라는 매일 아주 늦게 돌아오게 됐다."


translate japanese plot10_farewell_pan_left_return_3b9fb40e:


    "아직 그 일에서 벗어나지 못했다. 어딘가에서 기분을 풀고 있는 걸지도 모른다."


translate japanese plot10_farewell_pan_left_return_b75de5ab:



    voice "voice/cygnus_1281.ogg"
    cygnus "기분 전환이라…"


translate japanese plot10_farewell_pan_left_return_f0dce431:


    "문득, 라이라가 전에 데려가 준 곳이 떠올랐다."


translate japanese plot10_farewell_pan_left_return_ded88631:


    "어쩌면 거기에 있을지도 모른다."


translate japanese plot10_farewell_pan_left_return_13cbb8d8:



    voice "voice/tianqin_2194.ogg"
    tianqin "후우――…"


translate japanese plot10_farewell_pan_left_return_be462d7f:


    "철컥――!"


translate japanese plot10_farewell_pan_left_return_7ac02513:



    voice "voice/tianqin_2195.ogg"
    tianqin "응——?"


translate japanese plot10_farewell_pan_left_return_c86c41fb:



    voice "voice/cygnus_1282.ogg"
    cygnus "라이라!"


translate japanese plot10_farewell_pan_left_return_94715af5:



    voice "voice/tianqin_2196.ogg"
    tianqin "어? 시노스?"


translate japanese plot10_farewell_pan_left_return_dd7ce18e:



    voice "voice/cygnus_1283.ogg"
    cygnus "역시 여기 있었네."


translate japanese plot10_farewell_pan_left_return_f96ce9d6:



    voice "voice/tianqin_2197.ogg"
    tianqin "어? 웬일이야? 무슨 일 있어?"


translate japanese plot10_farewell_pan_left_return_7b55c6af:



    voice "voice/cygnus_1284.ogg"
    cygnus "아니, 아무 일도 없어…"


translate japanese plot10_farewell_pan_left_return_bf8b0c64:


    "생각해 보면, 볼일이 있어서 찾아온 건 아니었다."


translate japanese plot10_farewell_pan_left_return_d9136fa6:


    "그냥 변덕인가?"


translate japanese plot10_farewell_pan_left_return_1aa72f4d:



    voice "voice/tianqin_2198.ogg"
    tianqin "응…?"


translate japanese plot10_farewell_pan_left_return_eb6ec800:



    voice "voice/cygnus_1285.ogg"
    cygnus "…도시락 먹을래?"


translate japanese plot10_farewell_pan_left_return_8a76f6f6:



    voice "voice/tianqin_2199.ogg"
    tianqin "어――뭐?"


translate japanese plot10_farewell_pan_left_return_266da13a:



    voice "voice/cygnus_1286.ogg"
    cygnus "너무 많이 샀어. 두 개 있거든."


translate japanese plot10_farewell_pan_left_return_da12d67c:



    voice "voice/tianqin_2200.ogg"
    tianqin "으음――그럼 먹을게."


translate japanese plot10_farewell_pan_left_return_0b12c3dc:



    voice "voice/cygnus_1287.ogg"
    cygnus "치킨 카레랑 어향육사. 어느 쪽이 좋아?"


translate japanese plot10_farewell_pan_left_return_00900d8c:



    voice "voice/tianqin_2201.ogg"
    tianqin "어향육사!"


translate japanese plot10_farewell_pan_left_return_6b91f5bc:



    voice "voice/tianqin_2202.ogg"
    tianqin "후우――잘 먹었다, 잘 먹었어."


translate japanese plot10_farewell_pan_left_return_31e74457:



    voice "voice/cygnus_1288.ogg"
    cygnus "（그 양으로는 전혀 부족할 텐데…）"


translate japanese plot10_farewell_pan_left_return_698e3786:



    voice "voice/tianqin_2203.ogg"
    tianqin "미안해. 요즘 밥을 하나도 안 해 줬네."


translate japanese plot10_farewell_pan_left_return_4c20cda8:



    voice "voice/cygnus_1289.ogg"
    cygnus "괜찮아. 내 일은 내가 할 수 있어."


translate japanese plot10_farewell_pan_left_return_0888b48d:



    voice "voice/cygnus_1290.ogg"
    cygnus "이쪽 생활에는 이미 익숙해졌어."


translate japanese plot10_farewell_pan_left_return_68bfbb95:



    voice "voice/tianqin_2204.ogg"
    tianqin "그렇구나…"


translate japanese plot10_farewell_pan_left_return_be462d7f_1:


    "철컥――!"


translate japanese plot10_farewell_pan_left_return_60b9b6b5:


    "옥상 문이 다시 열렸다."


translate japanese plot10_farewell_pan_left_return_0dba1886:



    voice "voice/yangxi_775.ogg"
    yangxi "역시 여기 있었네."


translate japanese plot10_farewell_pan_left_return_2214e779:



    voice "voice/tianqin_2205.ogg"
    tianqin "어? 히나타?"


translate japanese plot10_farewell_pan_left_return_6d09c841:



    voice "voice/cygnus_1291.ogg"
    cygnus "안녕."


translate japanese plot10_farewell_pan_left_return_8a018074:



    voice "voice/yangxi_776.ogg"
    yangxi "시노스도 있었구나."


translate japanese plot10_farewell_pan_left_return_ff8c9af9:



    voice "voice/cygnus_1292.ogg"
    cygnus "뭐야? 내가 있으면 곤란해?"


translate japanese plot10_farewell_pan_left_return_4d2b0926:



    voice "voice/yangxi_777.ogg"
    yangxi "그런 말은 안 했어."


translate japanese plot10_farewell_pan_left_return_785fa3fa:



    voice "voice/tianqin_2206.ogg"
    tianqin "히나타는 어쩐 일로 여기 왔어?"


translate japanese plot10_farewell_pan_left_return_58c89e21:



    voice "voice/yangxi_778.ogg"
    yangxi "배고플 것 같아서 먹을 걸 가져왔어."


translate japanese plot10_farewell_pan_left_return_68891bb8:



    voice "voice/tianqin_2207.ogg"
    tianqin "에이—, 우리 방금 먹었는데—."


translate japanese plot10_farewell_pan_left_return_cd35077c:



    voice "voice/yangxi_779.ogg"
    yangxi "그럼 지금 먹을래? 햄버거인데."


translate japanese plot10_end2_shortcuts_restored_b7448c36:


    cygnus "먹을래!"


translate japanese plot10_end2_shortcuts_restored_d955d729:


    yangxi "왜 네가 대답해――!"


translate japanese plot10_farewell_pan_left_return_8d865afc:


    "그 뒤로 또, 셋이서 정신없이 먹었다."


translate japanese plot10_farewell_pan_left_return_d602f538:


    "도시락 용기와 포장지는 주변에 던져 둔 채였다."


translate japanese plot10_farewell_pan_left_return_2d937bff:


    "지금은 치울 마음이 들지 않았다."


translate japanese plot10_farewell_pan_left_return_2e0e1c88:


    "옥상 바닥에 누워 밤하늘을 올려다봤다."


translate japanese plot10_farewell_pan_left_return_fca8eed7:


    "초여름의 밤하늘에는 지난번 왔을 때보다 별이 더 많고, 밝게 보였다."


translate japanese plot10_farewell_pan_left_return_314f4598:


    "남동쪽에 늘어선 세 별이 유독 눈에 띄었다."


translate japanese plot10_farewell_pan_left_return_fc119509:


    "인터넷으로 찾아본 적이 있다. 이 세계에서는 「여름의 대삼각형」이라고 부른다."


translate japanese plot10_farewell_pan_left_return_f8630b60:


    "빛나는 세 별이 무언가 말을 건네는 듯했다."


translate japanese plot10_farewell_pan_left_return_9a6ae73f:


    "하지만 별 읽기에 관한 지식은 아무 쓸모도 없었다."


translate japanese plot10_farewell_pan_left_return_f4a56215:


    "나는 그저 낯선 하늘을 바라보고 있었다."


translate japanese plot10_farewell_pan_left_return_86a42c02:


    "두 사람도 나와 같은 풍경을 보고 있다."


translate japanese plot10_farewell_pan_left_return_9217ea5c:


    "무슨 생각을 하는지는 알 수 없다."


translate japanese plot10_farewell_pan_left_return_558599d2:


    "아무 생각도 하지 않는 걸지도 모른다."


translate japanese plot10_farewell_pan_left_return_0d6beed1:


    "아무도 입을 열지 않았다. 하지만 그 침묵은 조금도 괴롭지 않았다."


translate japanese plot10_farewell_pan_left_return_b82d4087:


    "그냥, 왠지 그런 기분이 들었다."


translate japanese plot10_farewell_pan_left_return_247350a6:


    "라이라는 무언가 말하고 싶어 한다. 아직 말로 꺼내지 못할 뿐이다."


translate japanese plot10_farewell_pan_left_return_cbead803:


    "생각을 누군가에게 전하기까지, 오랜 고민과 갈등이 필요할 때도 있다."


translate japanese plot10_farewell_pan_left_return_c99a51a3:


    "하루든, 일주일이든, 한 달이든."


translate japanese plot10_farewell_pan_left_return_35e399b7:


    "라이라가 말해 줄 때까지, 나는 얼마든지 기다리겠다."


translate japanese plot10_farewell_pan_left_return_75c619dc:


    "그녀가 나를 탓하지 않으리라는 건 안다."


translate japanese plot10_farewell_pan_left_return_7c0eb006:


    "그렇다고 도망쳐도 되는 건 아니다."


translate japanese plot10_farewell_pan_left_return_1180dc23:


    "내가 왔기에 이런 일이 벌어졌다."


translate japanese plot10_end2_shortcuts_restored_c6c4e5d6:


    "誰に責められなくても、私が背負うべき過ちだ。"


translate japanese plot10_farewell_pan_left_return_6f5cff08:



    voice "voice/tianqin_2208.ogg"
    tianqin "…미안해."


translate japanese plot10_farewell_pan_left_return_7fc63063:



    voice "voice/cygnus_1294.ogg"
    cygnus "응?"


translate japanese plot10_farewell_pan_left_return_bd32d89d:



    voice "voice/tianqin_2209.ogg"
    tianqin "걱정 끼쳐서."


translate japanese plot10_farewell_pan_left_return_63b3d531:



    voice "voice/cygnus_1295.ogg"
    cygnus "아니, 이건 내가 가져온 마도구 때문에…"


translate japanese plot10_farewell_pan_left_return_590ae83d:



    voice "voice/cygnus_1296.ogg"
    cygnus "사과해야 할 건 나야."


translate japanese plot10_farewell_pan_left_return_1dfae4f9:


    "라이라가 처음 꺼낸 말은 「미안해」였다."


translate japanese plot10_farewell_pan_left_return_1bde42f0:


    "가슴 깊은 곳이 콕 쑤셨다."


translate japanese plot10_farewell_pan_left_return_062ef89c:



    voice "voice/tianqin_2210.ogg"
    tianqin "…그래도 이번 일, 나쁜 일만 있었던 건 아닐지도 몰라."


translate japanese plot10_farewell_pan_left_return_6dea443a:


    "라이라는 그렇게 말하며 몸을 일으켰다."


translate japanese plot10_farewell_pan_left_return_daacfa5d:



    voice "voice/cygnus_1297.ogg"
    cygnus "어?"


translate japanese plot10_farewell_pan_left_return_4f281133:



    voice "voice/tianqin_2211.ogg"
    tianqin "계속 생각했어. 반장이 정말 잘못한 걸까 하고."


translate japanese plot10_farewell_pan_left_return_c2df7399:



    voice "voice/tianqin_2212.ogg"
    tianqin "시노스의 힘을 빌리지 않았다면 어떻게 됐을 것 같아?"


translate japanese plot10_farewell_pan_left_return_896baa61:



    voice "voice/tianqin_2213.ogg"
    tianqin "츠루기는 계속 반장을 괴롭히다가, 언젠가는 도망칠 곳도 없는 지경으로 몰아넣었겠지."


translate japanese plot10_farewell_pan_left_return_752cec96:



    voice "voice/tianqin_2214.ogg"
    tianqin "게다가 우리는 끝까지 아무것도 몰랐을 거야. 츠루기는 분명 전부 숨겼겠지."


translate japanese plot10_farewell_pan_left_return_9d4e4855:



    voice "voice/tianqin_2215.ogg"
    tianqin "잘못한 건 반장이 아니야. 츠루기야말로 모든 일의 원흉이야."


translate japanese plot10_farewell_pan_left_return_90a68ce2:



    voice "voice/tianqin_2216.ogg"
    tianqin "반장은 나와 달리 츠루기에게 맞설 수 없었어. 시키는 대로 할 수밖에 없었지."


translate japanese plot10_farewell_pan_left_return_b5dd80a2:



    voice "voice/tianqin_2217.ogg"
    tianqin "무서워서 맞서지 못하고, 맞서는 것조차 허락되지 않아. 그렇게 점점 더 빠져나올 수 없게 된 거야."


translate japanese plot10_end2_shortcuts_restored_e90ca22a:



    voice "voice/tianqin_2218.ogg"
    tianqin "委員長の記憶を見て、分かったんだ。委員長がどれだけ怒って、どれだけ苦しかったのか。"


translate japanese plot10_farewell_pan_left_return_c742036b:



    voice "voice/tianqin_2219.ogg"
    tianqin "하지만 시노스의 힘이 반장에게 계기를 줬어――"


translate japanese plot10_farewell_pan_left_return_98af4b7e:



    voice "voice/tianqin_2220.ogg"
    tianqin "…츠루기에게 맞설 수 있는 계기를."


translate japanese plot10_farewell_pan_left_return_e45b03ce_2:



    voice "voice/cygnus_1298.ogg"
    cygnus "으음…"


translate japanese plot10_farewell_pan_left_return_fab16fe5:


    "라이라에게 뭐라고 대답해야 할지 모르겠다."


translate japanese plot10_farewell_pan_left_return_2e2ef63e:


    "내 마음을 편하게 해 주려고 그렇게 말해 주는 것뿐일지도 모른다."


translate japanese plot10_farewell_pan_left_return_79d6c911:



    voice "voice/tianqin_2221.ogg"
    tianqin "내게는 반장을 막을 자격 따위 없었어."


translate japanese plot10_farewell_pan_left_return_ca4ed08a:



    voice "voice/tianqin_2222.ogg"
    tianqin "그건 반장이 스스로 선택한 일이야. 츠루기를 심판하기 위한 마지막 수단이었지."


translate japanese plot10_farewell_pan_left_return_016ab84d:



    voice "voice/tianqin_2223.ogg"
    tianqin "마음 한구석에서는 계속 그렇게 생각했어. 지금도 달라지지 않았고."


translate japanese plot10_farewell_pan_left_return_cfce064f:



    voice "voice/tianqin_2224.ogg"
    tianqin "그 마법이 발동했을 때, 안도하는 나도 있었어…"


translate japanese plot10_farewell_pan_left_return_2a3c4a5b:



    voice "voice/tianqin_2225.ogg"
    tianqin "그런 생각을 하는 나도 어딘가 이상한 걸까…"


translate japanese plot10_farewell_pan_left_return_51612015:



    voice "voice/cygnus_1299.ogg"
    cygnus "그래도 마지막에는 막고 싶었던 거잖아…"


translate japanese plot10_end2_shortcuts_restored_07eec020:



    voice "voice/tianqin_2226.ogg"
    tianqin "うん…やっぱり、悔しいよ。"


translate japanese plot10_end2_shortcuts_restored_982996ba:



    voice "voice/tianqin_2227.ogg"
    tianqin "…あれ？雨、降ってきた？"


translate japanese plot10_end2_shortcuts_restored_093f2100:


    "ライラが手で頬をぬぐう。"


translate japanese plot10_end2_shortcuts_restored_3366b53a:


    "見上げた空には雲ひとつない。雨など降るはずがなかった。"


translate japanese plot10_end2_shortcuts_restored_d4f1fdc0:



    voice "voice/tianqin_2228.ogg"
    tianqin "私が、もっとちゃんとできてたら…"


translate japanese plot10_end2_shortcuts_restored_d44cbc20:



    voice "voice/tianqin_2229.ogg"
    tianqin "う、うわああああ――――"


translate japanese plot10_end2_shortcuts_restored_78148a03:


    "いつも明るい少女が、泣き出した。"


translate japanese plot10_end2_shortcuts_restored_90312e1b:


    "もうこらえきれず、声を上げて泣いた。"


translate japanese plot10_end2_shortcuts_restored_2996052d:



    voice "voice/tianqin_2230.ogg"
    tianqin "うわああああ――――"


translate japanese plot10_end2_shortcuts_restored_7f3fe3ef:


    "ライラの泣き声が、夜の学校に響いた。"


translate japanese plot10_end2_shortcuts_restored_027d4304:


    "今はもう、気持ちを押し込めるときではなかった。"


translate japanese plot10_end2_shortcuts_restored_f8ba3d7e:



    voice "voice/tianqin_2231.ogg"
    tianqin "もっと早く、気づいてたら…"


translate japanese plot10_end2_shortcuts_restored_5c4ecb51:



    voice "voice/yangxi_781.ogg"
    yangxi "ライラ…"


translate japanese plot10_end2_shortcuts_restored_c652c801:


    "二人が抱き合うのを見ながら、私はどうしていいか分からず、そばに立っていた。"


translate japanese plot10_end2_shortcuts_restored_06431999:


    "こういう場面は苦手だ。ライラを慰める言葉なんて、なおさら出てこない。"


translate japanese plot10_end2_shortcuts_restored_81520e5b:


    "でも、ライラにはヒナタがいる。それでよかった。"


translate japanese plot10_end2_shortcuts_restored_52e106bb:



    voice "voice/tianqin_2232.ogg"
    tianqin "私がもっと早く気づいてたら！"


translate japanese plot10_end2_shortcuts_restored_0201b65c:



    voice "voice/tianqin_2233.ogg"
    tianqin "悔しいよ！"


translate japanese plot10_end2_shortcuts_restored_28b2880d:



    voice "voice/tianqin_2234.ogg"
    tianqin "委員長――！"


translate japanese plot10_end2_shortcuts_restored_e4ba1118:


    "ヒナタは何も言わず、ただライラを抱いていた。"


translate japanese plot10_end2_shortcuts_restored_72cf7fa6:


    "ライラが気持ちをすべて吐き出すまで、黙ってそばで聞いていた。"


translate japanese plot10_end2_shortcuts_restored_67e7d4d7:


    "こんなふうに、思っていることをまっすぐ言えるライラが、少しうらやましかった。"


translate japanese plot10_end2_shortcuts_restored_492ad72b:


    "そうだ。私も、悔しい。"


translate japanese plot10_end2_shortcuts_restored_50fac917:


    "記憶の中で、あの町を救えなかったときと同じ。"


translate japanese plot10_end2_shortcuts_restored_ba0139a0:


    "また、私が災いを連れてきた。"


translate japanese plot10_end2_shortcuts_restored_c30316d9:


    "もっとちゃんとできていれば、何かが変わっていたのだろうか。"


translate japanese plot10_end2_shortcuts_restored_41045c56:


    "あのときも、今も…"


translate japanese plot10_farewell_pan_left_return_d290b2d3:


    "라이라는 한동안 히나타의 품에서 계속 울었다."


translate japanese plot10_farewell_pan_left_return_73a53998:


    "조금 지나자 히나타가 다정하게 말을 건넸다."


translate japanese plot10_farewell_pan_left_return_80357512:



    voice "voice/yangxi_782.ogg"
    yangxi "조금 편해졌어?"


translate japanese plot10_farewell_pan_left_return_9bb68de6:



    voice "voice/tianqin_2235.ogg"
    tianqin "응… 미안해, 히나타…"


translate japanese plot10_farewell_pan_left_return_07205598:


    "히나타는 일어서서, 더는 아무 말도 하지 않았다."


translate japanese plot10_farewell_pan_left_return_1cf958d2:


    "그녀는 곁에 서 있던 내게 시선을 돌렸다."


translate japanese plot10_end2_shortcuts_restored_2754668e:



    voice "voice/yangxi_783.ogg"
    yangxi "私たちの記憶のこと…何か分かった？"


translate japanese plot10_farewell_pan_left_return_b1a362cf:



    voice "voice/cygnus_1300.ogg"
    cygnus "응. 대강은 알겠어. 둘 다 있으니 마침 잘됐네."


translate japanese plot10_farewell_pan_left_return_d139df89:



    voice "voice/cygnus_1301.ogg"
    cygnus "내 추측으로는, 아마…"


translate japanese plot10_farewell_pan_left_return_f4e9cd2b:



    voice "voice/cygnus_1302.ogg"
    cygnus "너희 둘 다 내 이름을 알고 있어서, 그 마법이 통하지 않은 것 같아."


translate japanese plot10_farewell_pan_left_return_fb3eca07:



    voice "voice/cygnus_1303.ogg"
    cygnus "그 때문에 두 세계의 기억이 모두 남은 거지."


translate japanese plot10_farewell_pan_left_return_afca7a88:



    voice "voice/yangxi_784.ogg"
    yangxi "아, 그러고 보니… 확실히 그런 일이 있었던 것 같아."


translate japanese plot10_end2_shortcuts_restored_e895aae7:



    voice "voice/yangxi_785.ogg"
    yangxi "でも、名前を知ってたことと、何の関係があるの？"


translate japanese plot10_farewell_pan_left_return_f6499974:



    voice "voice/cygnus_1304.ogg"
    cygnus "내 생각이 맞다면, 그 마법은 내 이름으로 발동했어."


translate japanese plot10_farewell_pan_left_return_e545440e:



    voice "voice/cygnus_1313.ogg"
    cygnus "즉, 실제로 마법을 발동한 건 그 {rb}마도구{/rb}{rt}왕 관{/rt} 자체야…"


translate japanese plot10_farewell_pan_left_return_2ba03a2e:



    voice "voice/tianqin_2236.ogg"
    tianqin "그럼 반장은… 돌아올 수 있어?"


translate japanese plot10_farewell_pan_left_return_9b610ece:



    voice "voice/cygnus_1306.ogg"
    cygnus "나는… 모르겠어, 라이라."


translate japanese plot10_farewell_pan_left_return_ae72741c:



    voice "voice/cygnus_1307.ogg"
    cygnus "만약 힘을 되찾는다면… 내가 이 세계에 끼친 영향을 되돌릴 수 있을지도 몰라."


translate japanese plot10_farewell_pan_left_return_af21ec4b:



    voice "voice/cygnus_1308.ogg"
    cygnus "이론상으로는 가능해. 하지만 희망은 희박해. 그 뒤에 무슨 일이 일어날지도 나조차 몰라."


translate japanese plot10_farewell_pan_left_return_19041054:



    voice "voice/cygnus_1309.ogg"
    cygnus "미안해, 라이라."


translate japanese plot10_farewell_pan_left_return_6ed3eab2:


    "내 생각을 그대로 전할 수밖에 없었다."


translate japanese plot10_farewell_pan_left_return_11090c8a:


    "라이라를 속여서 제멋대로 이용하는 짓은 할 수 없었다."


translate japanese plot10_farewell_pan_left_return_68bfbb95_1:



    voice "voice/tianqin_2237.ogg"
    tianqin "그렇구나…"


translate japanese plot10_end2_shortcuts_restored_9798fa67_1:


    voice "voice/banzhang_797.ogg"
    plot10_memory_chronicle "저를 잊지 마세요, 라이라 씨."


translate japanese plot10_end2_shortcuts_restored_c51b6c63_1:


    nvl clear
    voice "voice/banzhang_798.ogg"
    plot10_memory_chronicle "네가 바라는 대로…\n잘 살아 줘."


translate japanese plot10_end2_shortcuts_restored_374f0a1f:



    voice "voice/tianqin_2238.ogg"
    tianqin "でも、委員長は…最後にこう言ったの。自分の思うままに生きて、って。"


translate japanese plot10_farewell_pan_left_return_332b20e4:



    voice "voice/tianqin_2239.ogg"
    tianqin "설령 수억 분의 일이라 해도, 난 그 가능성을 붙잡고 싶어."


translate japanese plot10_farewell_pan_left_return_be6d4988:



    voice "voice/tianqin_2240.ogg"
    tianqin "그게 지금 내 마음이야."


translate japanese plot10_farewell_pan_left_return_34808bba:



    voice "voice/cygnus_1310.ogg"
    cygnus "라이라 씨…"


translate japanese plot10_farewell_pan_left_return_6bd3754a:



    voice "voice/tianqin_2241.ogg"
    tianqin "반장이 그렇게 말해 줬는데… 난 왜 잊고 있었을까."


translate japanese plot10_farewell_pan_left_return_ed618cdc:



    voice "voice/tianqin_2242.ogg"
    tianqin "언제까지고 여기 멈춰 있으면 안 되겠지."


translate japanese plot10_farewell_pan_left_return_08244f0e:


    "라이라는 일어나 크게 기지개를 켰다."


translate japanese plot10_farewell_pan_left_return_7a36b448:



    voice "voice/tianqin_2243.ogg"
    tianqin "후――, 하아――! 좋아, 결정했어!"


translate japanese plot10_farewell_pan_left_return_19060645:



    voice "voice/tianqin_2244.ogg"
    tianqin "시노스. 앞으로도 네가 힘을 되찾는 걸 돕게 해 줘."


translate japanese plot10_farewell_pan_left_return_d482a335:



    voice "voice/cygnus_1311.ogg"
    cygnus "하지만 방금 말한 대로…"


translate japanese plot10_farewell_pan_left_return_9eeea955:



    voice "voice/tianqin_2245.ogg"
    tianqin "응. 희망은 거의 없어. 그래도 아무것도 안 하고 있기는 싫어."


translate japanese plot10_farewell_pan_left_return_dbd75478:



    voice "voice/tianqin_2246.ogg"
    tianqin "그런 건 나답지 않잖아!"


translate japanese plot10_farewell_pan_left_return_90d1fc74:


    "라이라의 눈에서 망설임이 사라지고, 평소의 밝은 빛이 돌아왔다."


translate japanese plot10_farewell_pan_left_return_dfbb4631:


    "실컷 울고 나니 마음이 정리된 걸까."


translate japanese plot10_farewell_pan_left_return_36886554:


    "나는 모르겠다. 하지만 분명 나쁜 일은 아니다."


translate japanese plot10_farewell_pan_left_return_47672e8d:


    "히나타를 바라봤다. 그녀는 어떻게 생각하고 있을까."


translate japanese plot10_farewell_pan_left_return_d14eab83:


    "라이라를. 혹은 나를."


translate japanese plot10_farewell_pan_left_return_41c028e6:



    voice "voice/yangxi_786.ogg"
    yangxi "하아――정말. 너도 엄청 골치 아픈 일을 들고 왔네…"


translate japanese plot10_farewell_pan_left_return_e20914b1:



    voice "voice/cygnus_1312.ogg"
    cygnus "미안해…"


translate japanese plot10_farewell_pan_left_return_f1fc696c:



    voice "voice/tianqin_2247.ogg"
    tianqin "참, 히나타도. 시노스 탓하지 마."


translate japanese plot10_farewell_pan_left_return_05858c80:



    voice "voice/tianqin_2248.ogg"
    tianqin "여기까지 왔으니까 히나타도 도와줘."


translate japanese plot10_farewell_pan_left_return_067408e6:



    voice "voice/yangxi_787.ogg"
    yangxi "알았어. 정말 못 말린다니까."


translate japanese plot10_end2_shortcuts_restored_9a76e8e7:



    voice "voice/yangxi_788.ogg"
    yangxi "でも…私に何ができるのか分からないけど。"


translate japanese plot10_end2_shortcuts_restored_a5728fa8:



    voice "voice/yangxi_789.ogg"
    yangxi "魔法とか異世界とか…今でもまだ、飲み込めてない。"


translate japanese plot10_end2_shortcuts_restored_ab61ea00:



    voice "voice/yangxi_790.ogg"
    yangxi "世界まで変わったって言われても、全然ぴんとこない…"


translate japanese plot10_farewell_pan_left_return_da4d350e:



    voice "voice/yangxi_791.ogg"
    yangxi "왠지 엄청나게 큰 사건에 휘말린 것 같아…"


translate japanese plot10_farewell_pan_left_return_acb3c49f:



    voice "voice/tianqin_2249.ogg"
    tianqin "괜찮아! 우리라면 분명 어떻게든 할 수 있어!"


translate japanese plot10_farewell_pan_left_return_daadccac:



    voice "voice/yangxi_792.ogg"
    yangxi "네 말처럼 쉬우면 좋겠는데."


translate japanese plot10_farewell_pan_left_return_d068f8a7:



    voice "voice/yangxi_793.ogg"
    yangxi "불길한 예감이 들어. 앞으로 골치 아픈 일이 산더미처럼 생길 것 같아…"


translate japanese plot10_farewell_pan_left_return_8b57df87:



    voice "voice/tianqin_2250.ogg"
    tianqin "참, 너무 깊이 생각한다니까."


translate japanese plot10_farewell_pan_left_return_4b4a02e8:



    voice "voice/tianqin_2251.ogg"
    tianqin "자, 돌아가자!"


translate japanese plot10_end2_shortcuts_restored_94bd91b2:


    "アキ。"


translate japanese plot10_end2_shortcuts_restored_6435d65b:


    "ちゃんと見ててね。私、あきらめないから。"


translate japanese plot10_end2_shortcuts_restored_217118d4:


    "自分で決めたことを、最後までやり通す。"


translate japanese plot10_end2_shortcuts_restored_71a1cb57:


    "どこにいても、絶対に見つけるよ。"


translate japanese plot10_end2_shortcuts_restored_911b4c65:


    "絶対に…"


translate japanese plot10_end2_shortcuts_restored_ffe0234b:


    "（天意：ここで絵本風のEDを流す）"

















translate japanese plot10_end2_shortcuts_restored_b8bd33ea:



    voice "voice/hunter_77.ogg"
    monolith "次はどんな驚きを見せてくれるの？楽しみにしてる。"



translate japanese strings:


    old "完了。"
    new "끝났다."


    old "「不，还没完！」"
    new "「아니, 아직 끝나지 않았어!」"


    old "粗暴地打断了自己负面的思考，诗诺丝凝结着全身的魔力。"
    new "부정적인 생각을 억지로 떨쳐 내고, 시노스는 온몸의 마력을 모았다."


    old "需要打破这面坚不可摧的盾，需要打造的便是最锐利的矛。"
    new "아무리 단단한 방패라도, 가장 날카로운 창이라면 꿰뚫을 수 있다."


    old "「焰啊，听从我的请求……」"
    new "「불꽃이여, 나의 소원을 들어라…」"


    old "最强的魔法是什么？"
    new "가장 강한 마법은 무엇인가?"


    old "这个问题恐怕再争论个几千年都没有定论。"
    new "수천 년을 논해도 답은 나오지 않을 것이다."


    old "「灼烧生机、灼烧黑暗、灼烧光明……」"
    new "「생명을 태우고, 어둠을 태우고, 빛을 태워라…」"


    old "但如果说最强的破坏魔法。"
    new ""


    old "那恐怕只有在“那个人”创造出来的魔法中进行选取了。"
    new "「그 사람」이 만든 마법 중에서 고를 수밖에 없다."


    old "「请在我手中凝聚，将抵挡在我面前的阻碍焚灭殆尽。」"
    new "「내 손에 모여, 앞을 가로막는 모든 것을 불태워라.」"


    old "焰。"
    new "불꽃."


    old "在诗诺丝手上出现一团微弱的火苗。"
    new "시노스의 손에 작은 불이 나타났다."


    old "在下一瞬，这团火焰便在空中蔓延，变成一团熊熊烈火。"
    new "다음 순간, 불꽃은 하늘로 퍼져 거대하게 타올랐다."


    old "光。"
    new "빛."


    old "诗诺丝的手紧握成拳头，这团烈火也随之压缩。"
    new "시노스가 손을 힘껏 움켜쥐자, 거대한 불꽃도 함께 작게 압축됐다."


    old "在烈焰的中心，一个炽亮的光点在不断地翻腾。"
    new "불꽃 한가운데서 하얗게 빛나는 점이 격렬하게 움직였다."


    old "就像是正午的太阳，让人无法正视。"
    new "한낮의 태양처럼, 똑바로 바라볼 수 없었다."


    old "热。"
    new "열기."


    old "扑面而来的热浪。"
    new "뜨거운 바람이 정면으로 몰아쳤다."


    old "突如其来的温度差让气压也骤然变化。"
    new "온도가 급변하자 주변의 공기까지 거세게 요동쳤다."


    old "强风裹挟着热意呼啸而过。"
    new "강풍이 열기를 휘감고 지나갔다."


    old "随着诗诺丝唱出它的名字，最强的破坏魔法也就此成型。"
    new "시노스가 이름을 외치자, 가장 강한 파괴 마법이 형태를 얻었다."


    old "日珥般的火焰汇聚压缩，最终形成螺旋状的长枪。"
    new "태양의 홍염 같은 불꽃이 모여 가늘게 압축되더니, 나선형의 긴 창이 되었다."


    old "被冠以最强的魔法使之名——「戮王」所创造的{a=dictionary:dict_entry_93}魔法{/a}。"
    new ""


    old "——诗诺丝最强的矛。"
    new "――시노스가 가진, 가장 강력한 창."


    old "她的手向着球形屏障挥去，炎枪投出。"
    new "시노스는 구형 장벽을 향해 손을 휘둘러 불꽃의 창을 날렸다."


    old "炎枪的轨迹在空中留下了一道道火圈，熔化着触及到的一切。"
    new "창이 지나간 하늘에는 불의 고리가 남았고, 닿는 것은 모두 녹아내렸다."


    old "瓷砖、水泥、道路……纷纷软化、变形。"
    new "타일도, 콘크리트도, 도로도… 물러지며 형태를 잃었다."


    old "宛如投出了一轮烈阳。"
    new "마치 불타는 태양 그 자체를 던진 것 같았다."


    old "砰！"
    new "펑!"


    old "炎枪一端砸向了屏障，爆发出更强一股热浪。"
    new ""


    old "然后，这个魔法真正的破坏力才展现出来。"
    new "그리고 이 마법의 진정한 파괴력이 드러났다."


    old "「就是现在！」"
    new "「지금이다!」"


    old "诗诺丝再次握紧拳头，炎枪中心的白色光点突然膨胀，爆发出一股巨大的冲击力。"
    new "시노스가 다시 손을 움켜쥐자, 불꽃의 창 중심에 있던 하얀 점이 급격히 커지며 강력한 충격을 폭발시켰다."


    old "膨胀的光点推动着炎枪侵入屏障内部，与其内在力场对抗着。"
    new "팽창한 빛이 창을 장벽 안으로 밀어 넣으며, 안쪽에 있는 힘과 충돌했다."


    old "轰！！"
    new "콰앙!!"


    old "矛与盾互相挤压到极限时，强烈的爆炸应运而生，紧接着的是漫天的烟尘。"
    new "창과 방패가 한계까지 맞부딪친 순간, 거대한 폭발이 일어났고 주변은 연기와 흙먼지에 뒤덮였다."


    old "成功了！"
    new "성공했어!"


    old "「真厉害呢，魔女。」"
    new "대단하네요, 마녀."


    old "「只可惜——」"
    new "하지만 안타깝게도――"


    old "天琴俯下身，抓住路标的立杆。"
    new "라이라는 몸을 숙여 표지판의 기둥을 붙잡았다."


    old "她照着记忆里的动作，将它提起，随手挥舞了两下。"
    new "ライラは標識を拾い、記憶の中にある動きを真似して、軽く二度振った。"


    old "路标连同立杆，大约有十二公斤。"
    new "표지판과 기둥을 합치면,\n무게는 12킬로그램 정도."


    old "对天琴而言，作为武器刚刚好。"
    new "라이라에게는 무기로 딱 알맞았다."


    old "「握紧了！」"
    new "「꽉 잡아!」"


    old "说完，诗诺丝再次转换了自己的形态。"
    new "그 말과 함께 시노스는 다시 모습을 바꿨다."


    old "她将所有魔力，集中输出到天琴手中的路标上。"
    new "가진 마력을 전부 라이라의 표지판에 집중해서 흘려 넣었다."


    old "因为不再需要维持魔法，她连维持原本形态所需的魔力，也一并输出了过去。"
    new "더는 마법을 유지할 필요가 없다. 본래 모습을 유지하는 마력까지 모두 표지판으로 보냈다."


    old "路标接受了大量的魔力，\n开始发出亮蓝色的光芒。"
    new "막대한 마력을 받은 표지판이 밝은 푸른빛을 내기 시작했다."


    old "因为魔女契约的关系，诗诺丝对天琴用的所有魔法都会失效。"
    new "마녀의 계약 때문에, 시노스가 라이라에게 쓰는 마법은 전부 통하지 않는다."


    old "这也意味着她没有办法直接对天琴进行强化。"
    new "즉, 라이라의 몸을 직접 강화할 수는 없다."


    old "但如果能借助其他东西作为媒介，那两人依然能使出合力一击。"
    new "하지만 다른 물건을\n매개체로 삼으면, 두 사람의 힘을 합쳐 공격할 수 있다."


    old "就像现在这样。"
    new "지금처럼."


    old "「就是现在天琴！」"
    new "「지금이야, 라이라!」"


    old "「用全力打过去吧！」"
    new "「온 힘을 다해 내리쳐!」"


    old "天琴将路标高举头顶，绷紧了全身的肌肉。"
    new "ライラは標識を頭の上に上げ、全身に力を入れた。"


    old "看完ed并感动得涕泪横流"
    new "EDを見終えて感動の涙を流す"


    old "额外内容前日谈「终将重合的渐近线」已解锁。"
    new "追加コンテンツの前日譚「漸近線が重なるという宿命」が解放されました。"


    old "额外内容前日谈\n「终将重合的渐近线」已解锁。"
    new "추가 콘텐츠의 프리퀄\n「점근선이 겹치는 숙명」이\n해금되었습니다."


    old "您可以从主菜单的额外内容选项中，\n选择前日谈选项游玩。"
    new "메인 메뉴의 추가 콘텐츠에서\n프리퀄을 선택하면 플레이할 수 있습니다."


translate japanese plot10_farewell_pan_left_return_814d6d04:

    nvlNone "라이라가 손으로 뺨을 닦았다."


translate japanese plot10_farewell_pan_left_return_7ba97603:

    voice "voice/tianqin_2229.ogg"
    nvl_tianqin_dialogue "으, 으아아아아――――"


translate japanese plot10_farewell_pan_left_return_34962c0a:

    nvlNone "언제나 밝던 소녀가 울음을 터뜨렸다."


translate japanese plot10_end2_shortcuts_restored_80697a33:

    nvlNone "더는 참지 못하고,\n소리 내어 울었다."


translate japanese plot10_farewell_pan_left_return_8499db4a:

    nvlNone "라이라의 울음소리가,\n밤의 학교에 울려 퍼졌다."


translate japanese plot10_end2_shortcuts_restored_b5e896b4:

    nvlNone "지금은 더 이상 감정을\n억눌러 둘 때가 아니었다."


translate japanese plot10_farewell_pan_left_return_9007e7ad:

    voice "voice/tianqin_2232.ogg"
    nvl_tianqin_dialogue "내가 더 일찍 알아차렸더라면!"


translate japanese plot10_farewell_pan_left_return_e3550809:

    voice "voice/tianqin_2233.ogg"
    nvl_tianqin_dialogue "분해!"


translate japanese plot10_farewell_pan_left_return_49fd23ba:

    voice "voice/tianqin_2234.ogg"
    nvl_tianqin_dialogue "반장――!"


translate japanese plot10_farewell_pan_left_return_9f19e44b:

    nvlNone "올려다본 하늘에는 구름 한 점 없었다.\n비가 올 리 없었다."


translate japanese plot10_farewell_pan_left_return_9d7728d2:

    nvlNone "두 사람이 서로 껴안는 모습을 보며,\n나는 어찌할 바를 모르고,\n곁에 서 있었다."


translate japanese plot10_farewell_pan_left_return_835821d4:

    nvlNone "이런 상황에는 서툴다. 라이라를 위로할\n말은 더더욱 나오지 않았다."


translate japanese plot10_farewell_pan_left_return_81d52c00:

    nvlNone "히나타는 아무 말도 하지 않고,\n그저 라이라를 안고 있었다."


translate japanese plot10_end2_shortcuts_restored_0245cd1b:

    nvlNone "이렇게 생각하는 것을\n솔직하게 말할 수 있는 라이라가,\n조금 부러웠다."


translate japanese plot10_farewell_pan_left_return_adde5d94:

    nvlNone "기억 속에서,\n그 도시를 구하지 못했을 때와 같다."


translate japanese plot10_farewell_pan_left_return_be7abdb7:

    nvlNone "좀 더 제대로 했다면, 무언가 달라졌을까."


translate japanese plot10_cg180_lyra_raise_sign_18cc8130:

    nvlNone "ずっと悲しみの中で動けなくなると思っていた。"


translate japanese plot10_cg180_lyra_raise_sign_23ad52ac:

    nvlNone "過去に悩むことも、未来を不安に思うこともない。"



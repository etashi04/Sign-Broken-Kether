    voice "voice/cygnus_387.ogg"
    cygnus "……"


translate japanese plot3_d273ed24:



    voice "voice/cygnus_388.ogg"
    cygnus "（마도구가 근처에 있었다면…… 라이라가 알아차렸을 텐데……）"


translate japanese plot3_495d2c3b:



    voice "voice/cygnus_389.ogg"
    cygnus "……やはり漂流魔法の問題ね。"


translate japanese plot3_f14c9ae0:



    voice "voice/blackcat_14.ogg"
    blackcat "냐하하! 넌 정말 빈틈투성이야!"


translate japanese plot3_a172b294:



    voice "voice/blackcat_03.ogg"
    blackcat "아야!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_133b20ad:



    voice "voice/cygnus_390.ogg"
    cygnus "（……아니야, 그럴 리 없어. 내가 이런 데서 그런 실수를 할 리가 없어.）"


translate japanese plot3_65654298:



    voice "voice/cygnus_391.ogg"
    cygnus "（아주 확실한 자신이 없었다면 이 세계에 올 리 없어.）"


translate japanese plot3_7249410d:



    voice "voice/cygnus_392.ogg"
    cygnus "（하지만…… 표류 마법이 발동하는 동안 누군가 밖에서 간섭했다면 지금 상황도 가능해.）"


translate japanese plot3_f0baba63:



    voice "voice/cygnus_393.ogg"
    cygnus "（원래 세계에서 일어난 일인가? 아니면 이 세계에서?）"


translate japanese plot3_89767d1e:



    voice "voice/cygnus_394.ogg"
    cygnus "（아침에 느낀 마력의 흐름…… 역시 누군가 나를 노리고 있나?）"


translate japanese plot3_fcc1bf3f:



    voice "voice/cygnus_395.ogg"
    cygnus "（そして……あの巨樹も。）"


translate japanese plot3_e45b03ce_2:



    voice "voice/cygnus_396.ogg"
    cygnus "으음……"


translate japanese plot3_08155ae1:



    voice "voice/cygnus_397.ogg"
    cygnus "（考えても仕方ない。今はまず、魔導器を取り戻さないと。）"


translate japanese plot3_c500467b:



    voice "voice/cygnus_398.ogg"
    cygnus "라이라."


translate japanese plot3_f0e2e7e7_1:



    voice "voice/tianqin_609.ogg"
    tianqin "응?"


translate japanese plot3_baa84ca4:



    voice "voice/cygnus_399.ogg"
    cygnus "당분간은 계속 신세를 져야 할 것 같아."


translate japanese plot3_cfd96e20:



    voice "voice/tianqin_610.ogg"
    tianqin "이 정도는 괜찮아! 시노스가 있고 싶은 만큼 있어도 돼."


translate japanese plot3_4094bf76:



    voice "voice/tianqin_611.ogg"
    tianqin "그런데 앞으로는 어떻게 할 거야?"


translate japanese plot3_780d6f1c:



    voice "voice/cygnus_400.ogg"
    cygnus "먼저 그 마도구를 회수하러 가야겠어. 라이라, 나를 처음 만났던 곳을 알려 줘."


translate japanese plot3_e7c06e52:



    voice "voice/tianqin_612.ogg"
    tianqin "좋아! 휴대폰으로 보여 줄게."


translate japanese plot3_dddf13aa:



    voice "voice/tianqin_613.ogg"
    tianqin "집을 나와서 아파트 단지를 벗어나면 왼쪽으로 꺾고, 그 길로 쭉 가다가……"


translate japanese plot3_c6cb9e28:



    voice "voice/tianqin_614.ogg"
    tianqin "아, 맞다! 그 길에 모양이 엄청 특이한 치과가 있어. 아마 그 근처였을 거야."


translate japanese plot3_a861054d:



    voice "voice/cygnus_401.ogg"
    cygnus "「치과」?"


translate japanese plot3_31ae05b7:



    voice "voice/tianqin_615.ogg"
    tianqin "이를 전문으로 치료하는 곳이야."


translate japanese plot3_73feac7f:



    voice "voice/tianqin_616.ogg"
    tianqin "사진 찾아볼게."


translate japanese plot3_3be91f93:


    "곧 라이라는 인터넷에서 그 치과의 사진을 찾았다."


translate japanese plot3_e210523e:


    "치아 모양을 본떠 만든, 묘하게 눈에 띄는 건물이었다."


translate japanese plot3_e3b0336d:



    voice "voice/tianqin_617.ogg"
    tianqin "봐! 이거야!"


translate japanese plot3_da615c7e:



    voice "voice/cygnus_402.ogg"
    cygnus "알았어. 지금 갈게."


translate japanese plot3_16bc5d32:



    voice "voice/tianqin_618.ogg"
    tianqin "어, 잠깐, 잠깐! 이런 한밤중에 혼자 나가면 위험해!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_0372cec2:



    voice "voice/tianqin_619.ogg"
    tianqin "내일 아침에 가는 게 어때?"


translate japanese plot3_b67d4102:



    voice "voice/cygnus_403.ogg"
    cygnus "안 돼. 누가 마도구를 주우면 곤란해."


translate japanese plot3_802555ef:



    voice "voice/tianqin_620.ogg"
    tianqin "아직 아무도 시노스 물건을 못 찾았을 것 같은데?"


translate japanese plot3_6a35dc89:



    voice "voice/tianqin_621.ogg"
    tianqin "으음…… 그래도 그 마도구는 이 세계 물건이 아니잖아? 누가 주웠으면 벌써 소문났겠지?"


translate japanese plot3_ed3f995d:



    voice "voice/blackcat_13.ogg"
    blackcat "누가 주워도 상관없지. 이 세계 녀석들이 마도구를 다룰 수 있을 리 없다냥."


translate japanese plot3_936c4298_9:



    voice "voice/cygnus_404.ogg"
    cygnus "……"


translate japanese plot3_16eaa495:



    voice "voice/cygnus_405.ogg"
    cygnus "……그렇네. 그럼 내일 아침 일찍 찾으러 갈게."


translate japanese plot3_00a47643:


    "밤이 깊어지고, 모두 저마다 복잡한 생각을 품은 채 잠들었다."


translate japanese plot3_00e2631f:


    "원래 마녀에게는 수면이 필요 없었다. 하지만 지금은 마력을 아끼려고 밤마다 어쩔 수 없이 휴면 상태에 들어가야 했다."


translate japanese plot3_afb8e15b:


    "이세계에서 평범한 인간과 같은 침대에 누워 자는 것. 시노스에게도 어떤 의미에서는 아주 드문 경험이었다."


translate japanese plot3_71e08e60:



    voice "voice/tianqin_622.ogg"
    tianqin "……"


translate japanese plot3_c6ecbe64:



    voice "voice/tianqin_623.ogg"
    tianqin "으음…… 목말라……"


translate japanese plot3_014dedf7:



    voice "voice/tianqin_624.ogg"
    tianqin "물……"


translate japanese plot3_4a1a970d:



    voice "voice/tianqin_625.ogg"
    tianqin "컵…… 물……"


translate japanese plot3_3e67f630:



    voice "voice/tianqin_626.ogg"
    tianqin "으앗――!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_41a026c2:


    "졸린 눈을 비비던 라이라의 시야에 날카로운 시선이 들어왔다."


translate japanese plot3_b02017aa:


    "그 시선의 주인은 식탁 위에 앉아 이쪽을 빤히 노려보고 있었다."


translate japanese plot3_aa3cba97:



    blackcat "……"


translate japanese plot3_f211fbef:



    voice "voice/tianqin_627.ogg"
    tianqin "뭐, 뭐야…… 노리였구나……"


translate japanese plot3_69d47e66:



    voice "voice/tianqin_628.ogg"
    tianqin "안 자? 고양이는 잠을 많이 자야 하지 않아……?"


translate japanese plot3_aa3cba97_1:



    blackcat "……"


translate japanese plot3_3496e8c9:



    voice "voice/blackcat_12.ogg"
    blackcat "역시 이게 운명이라는 거냥."


translate japanese plot3_2f7bcf95:



    voice "voice/tianqin_629.ogg"
    tianqin "뭐?"


translate japanese plot3_dbdc514e:



    voice "voice/blackcat_07.ogg"
    blackcat "흥."


translate japanese plot3_a8bc6196:


    "노리는 라이라의 질문에 답하지 않고 식탁에서 가볍게 뛰어내려, 순식간에 어둠 속으로 사라졌다."


translate japanese plot3_c3732fe8:



    voice "voice/tianqin_630.ogg"
    tianqin "으음…… 역시 이상한 녀석이야……"


translate japanese plot3_e46b0a98:



    voice "voice/tianqin_631.ogg"
    tianqin "……아…… 졸려……"


translate japanese plot3_9564df4d:


    "다음 날 아침, 학교."


translate japanese plot3_1bebbfab:



    voice "voice/yangxi_195.ogg"
    yangxi "（아직 아무도 안 왔네.）"


translate japanese plot3_96e16825:


    "오전 6시 30분. 이제 막 열린 교문을 지나 이 시간에 등교하는 학생은 손에 꼽을 정도였다."


translate japanese plot3_c9c90b60:


    "히나타는 붐비는 곳을 몹시 싫어했다. 출근 시간의 혼잡을 피하려고 늘 일찍 일어나 지하철 첫차를 탔다."


translate japanese plot3_6f841043:


    "그래서 학교를 빼먹는 날만 아니면 항상 반에서 가장 먼저 도착했다."


translate japanese plot3_c38a8cef:



    voice "voice/yangxi_196.ogg"
    yangxi "（남은 숙제는…… 수학, 물리, 그리고 세계사인가.）"


translate japanese plot3_973f7039:



    voice "voice/yangxi_197.ogg"
    yangxi "（잘됐네, 시간 때우기에는 딱이야.）"


translate japanese plot3_30b3d293:


    "授業まで、まだ二時間ある。陽汐はちょうどその時間を使って残りの宿題を片付けるつもりだった。"


translate japanese plot3_c1207774:


    "평소에는 놀다가 시험 전에 벼락치기를 하는 라이라와는 달랐다. 성적만큼은 히나타가 명실상부한 우등생이었다."


translate japanese plot3_9f79ad48:


    "집안 사정으로 고등학교에 오기 전까지는 제대로 학교에 다닌 적이 없었다. 모든 수업을 가정교사에게 받았다."


translate japanese plot3_679debc3:


    "同級生たちが中学に通っていた頃、陽汐はすでに高校レベルの内容を習得していた。"


translate japanese plot3_6147b44f:


    "그러니 수업을 좀 빠져도 성적에는 영향이 없었다. 지금 학교에서 그녀에게 가르쳐 줄 것은 거의 남지 않았다."


translate japanese plot3_199489bf:



    voice "voice/yangxi_198.ogg"
    yangxi "물리는 오래 걸리겠네…… 나중에 해야겠다."


translate japanese plot3_1d61aabf:



    voice "voice/yangxi_199.ogg"
    yangxi "응——?"


translate japanese plot3_f1d89a83:



    voice "voice/yangxi_200.ogg"
    yangxi "（왠지…… 교실에서 이상한 냄새 나지 않아?）"


translate japanese plot3_feb0e7b1:



    voice "voice/yangxi_201.ogg"
    yangxi "（아니, 이건…… 썩는 냄새? 누가 어제 도시락을 치우는 걸 잊었나?）"


translate japanese plot3_9587d4f6:


    "수업 시간이 가까워지자 교실에 학생들이 늘어났다."


translate japanese plot3_6532ea56:



    voice "voice/yangxi_202.ogg"
    yangxi "（라이라 녀석, 일어났나? 답장을 전혀 안 하네.）"


translate japanese plot3_9c0dec73:



    voice "voice/yangxi_203.ogg"
    yangxi "（아, 읽음 떴다.）"


translate japanese plot3_e059d5a6:


    "잠시 뒤 라이라에게서 답장이 왔다."


translate japanese plot3_112e83ae:



    voice "voice/tianqin_sms.ogg"
    tianqin3 0311 "큰일 났어! 늦잠 잤다!" with Shake((0, 0, 0, 0), 0.5, dist=5)



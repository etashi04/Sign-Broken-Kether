    voice "voice/xiaoxia_76.ogg"
    xiaoxia "아, 아니에요!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_940e8ca9:



    voice "voice/xiaoxia_77.ogg"
    xiaoxia "예전에는…… 계속 그렇게 생각했어요. 하지만 지금은 달라요."


translate japanese plot3_d9e9f67b:



    voice "voice/xiaoxia_78.ogg"
    xiaoxia "이렇게 두 분과 직접 이야기하고 나서야…… 제가 계속 오해하고 있었다는 걸 깨달았어요."


translate japanese plot3_ea15a481:



    voice "voice/xiaoxia_79.ogg"
    xiaoxia "이 꽃은 오늘 도와주신 답례이면서…… 사과하는 마음도 담았어요……"


translate japanese plot3_f6209757:



    voice "voice/xiaoxia_80.ogg"
    xiaoxia "그러니까 부디 받아 주세요!"


translate japanese plot3_ba71b5e4:



    voice "voice/tianqin_557.ogg"
    tianqin "괜찮으니까 그렇게 긴장하지 마."


translate japanese plot3_72d2b970:



    voice "voice/tianqin_558.ogg"
    tianqin "나랑 히나타는 대충대충 사는 사람들이야. 아키나가 너무 진지하면 우리도 어쩔 줄 모르잖아."


translate japanese plot3_a549bd6e:



    voice "voice/yangxi_189.ogg"
    yangxi "대충 사는 건 너뿐이야."


translate japanese plot3_0955e7af:



    voice "voice/yangxi_190.ogg"
    yangxi "꽃 고마워."


translate japanese plot3_ed9265a8:



    voice "voice/yangxi_191.ogg"
    yangxi "내키면…… 또 꽃 돌보는 거 도와줄게."


translate japanese plot3_781a8644:



    voice "voice/xiaoxia_81.ogg"
    xiaoxia "네, 네! 오늘 정말 감사했어요!"


translate japanese plot3_736625e7:



    voice "voice/tianqin_559.ogg"
    tianqin "원예부 일로 도움이 필요하면 언제든 불러."


translate japanese plot3_617486c3:



    voice "voice/xiaoxia_82.ogg"
    xiaoxia "네! 고마워요!"


translate japanese plot3_cc265d79:



    voice "voice/yangxi_192.ogg"
    yangxi "……갔네."


translate japanese plot3_669bb077:



    voice "voice/tianqin_560.ogg"
    tianqin "응! 제대로 친구가 돼서 다행이다～"


translate japanese plot3_057200b8:



    voice "voice/yangxi_193.ogg"
    yangxi "ようやく昨日みたいにハムスターみたいにビクビクしてなかったね。"


translate japanese plot3_7b21866f:



    voice "voice/tianqin_561.ogg"
    tianqin "그건 히나타가 평소처럼 무뚝뚝하게 굴어서 그랬잖아."


translate japanese plot3_342b22c8:



    voice "voice/yangxi_194.ogg"
    yangxi "이게 내 분위기야."


translate japanese plot3_46c606f7:



    voice "voice/tianqin_562.ogg"
    tianqin "적당히 해!"


translate japanese plot3_936c4298_4:



    voice "voice/cygnus_287.ogg"
    cygnus "……"


translate japanese plot3_a6bb4c2f:


    "시노스는 오늘 밖에 오래 머물지 않고 일찍 집으로 돌아왔다."


translate japanese plot3_5a248438:


    "아침에 거목을 조사하던 중, 아주 희미한 「위화감」을 감지했기 때문이다."


translate japanese plot3_554eb20e:



    voice "voice/cygnus_288.ogg"
    cygnus "一瞬……ほんの一瞬だけ、魔力の流れを感じた。"


translate japanese plot3_27920115:



    voice "voice/cygnus_289.ogg"
    cygnus "하지만 쫓아오지는 않았어…… 눈치채지 못한 건가, 아니면……"


translate japanese plot3_ed870421:


    "주변의 기류가 바뀐 것을 알아차리자 시노스는 즉시 돌아와 상황에 대비하고 있었다."


translate japanese plot3_55599c68:


    "하지만 그 뒤로는 아무 일도 없었고, 그 마력의 기척도 안개처럼 사라졌다."


translate japanese plot3_e45b03ce:



    voice "voice/cygnus_290.ogg"
    cygnus "으음……"


translate japanese plot3_9056efd3:


    "탁——!"


translate japanese plot3_57061561:



    voice "voice/tianqin_563.ogg"
    tianqin "다, 녀왔어!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_e3963a29:



    voice "voice/cygnus_291.ogg"
    cygnus "（꽃……?）"


translate japanese plot3_d8fc907e:



    voice "voice/tianqin_564.ogg"
    tianqin "아, 이거? 우리 반 애들이 키운 꽃이야."


translate japanese plot3_4c9d8eba:



    voice "voice/cygnus_292.ogg"
    cygnus "너희 「학교」라는 곳에서는 농업도 가르쳐?"


translate japanese plot3_c4bc74c3:



    voice "voice/tianqin_565.ogg"
    tianqin "어? 그게 아니라, 원예부 애들이 키우는 거야."


translate japanese plot3_2bc924b5:



    voice "voice/cygnus_293.ogg"
    cygnus "원예부……?"


translate japanese plot3_6d859924:



    voice "voice/tianqin_566.ogg"
    tianqin "식물을 좋아하는 애들이 모여서 이것저것 키우고 정보도 나누는 곳이야."


translate japanese plot3_bf6db3c0:



    voice "voice/cygnus_294.ogg"
    cygnus "그렇구나, 「협회」 같은 거네."


translate japanese plot3_4229fa89:



    voice "voice/cygnus_295.ogg"
    cygnus "우리 세계에도 비슷한 조직이 있어. 예를 들면 「마법 협회」라고, 마법의 실용성을 연구하는 사람들 모임이지."


translate japanese plot3_2bfbf37a:



    voice "voice/tianqin_567.ogg"
    tianqin "음…… 뭐라고 해야 할까. 그런 느낌은 맞지만…… 우리 동아리는 시노스가 말한 「협회」에 비하면 훨씬 작아."


translate japanese plot3_59d2cee8:



    voice "voice/tianqin_568.ogg"
    tianqin "학교 안에서 취미를 즐기려고 모이는 작은 모임이니까."


translate japanese plot3_8319f78c:



    voice "voice/cygnus_296.ogg"
    cygnus "그럼 그 애들이 장차 농사를 지으려는 건 아니야?"


translate japanese plot3_3bfa1163:



    voice "voice/tianqin_569.ogg"
    tianqin "아마 아닐걸."


translate japanese plot3_a8461a45:



    voice "voice/cygnus_297.ogg"
    cygnus "……그럼 「원예부」의 존재 의의는?"


translate japanese plot3_d16d7823:



    voice "voice/tianqin_570.ogg"
    tianqin "시노스, 그런 문제가 아니라니까."


translate japanese plot3_56582530:



    voice "voice/tianqin_571.ogg"
    tianqin "「취미」는 말이야, 본업이 아닐 때 더 재미있는 거야!"


translate japanese plot3_14d7dcf5:



    voice "voice/cygnus_298.ogg"
    cygnus "……그런 거야?"


translate japanese plot3_188a5065:



    voice "voice/tianqin_572.ogg"
    tianqin "시노스 짱, 취미 있어?"


translate japanese plot3_290a8743:



    voice "voice/cygnus_299.ogg"
    cygnus "딱히 없어…… 굳이 말하면 지금은 이 세계를 연구하는 게 취미려나."


translate japanese plot3_08eb54cd:



    voice "voice/cygnus_300.ogg"
    cygnus "……그리고 이름 뒤에 짱 붙이지 마."


translate japanese plot3_764ecea1:



    voice "voice/tianqin_573.ogg"
    tianqin "그런데 그 취미가 「이 세계를 제대로 연구하지 않으면 죽는다!」는 상황이 되면……"


translate japanese plot3_8d6049dc:



    voice "voice/tianqin_574.ogg"
    tianqin "그건 더 이상 「취미」가 아니잖아?"


translate japanese plot3_193e3a3d:



    voice "voice/cygnus_301.ogg"
    cygnus "……그런가."


translate japanese plot3_050c9464:


    "오히려 지금 시노스가 처한 상황이 바로 그랬다."


translate japanese plot3_bf8af395:


    "이 세계의 정보를 서둘러 모으지 않으면 살아남는 것조차 위태로웠다."


translate japanese plot3_01f9f70a:



    voice "voice/cygnus_302.ogg"
    cygnus "（……뭐, 지금 상황이 그렇게 즐거운 것도 아니지만.）"


translate japanese plot3_722621ce:



    voice "voice/cygnus_303.ogg"
    cygnus "（魔理の研究が魔女としての共通の「趣味」であり、生計の手段でもあるっていうなら。）"


translate japanese plot3_77e5de14:



    voice "voice/cygnus_304.ogg"
    cygnus "（……「趣味」を本業にするのは、痛みと喜びの両方を孕むものだ。）"


translate japanese plot3_84fea05a:


    "꼬르르르——."


translate japanese plot3_0ed734d6:


    "절묘한 순간, 라이라의 배가 항의의 소리를 냈다."


translate japanese plot3_5c4543e0:



    voice "voice/tianqin_575.ogg"
    tianqin "えっと、晩ご飯の準備しなきゃ……シノスちゃん、お昼は食べた？"


translate japanese plot3_071ece0f:



    voice "voice/cygnus_305.ogg"
    cygnus "돌아와서 조금 먹었어."


translate japanese plot3_7ee821a8:



    voice "voice/cygnus_306.ogg"
    cygnus "残してくれた分は多すぎて、食べきれなかった。"


translate japanese plot3_799776b6:



    voice "voice/tianqin_576.ogg"
    tianqin "입에는 맞아?"


translate japanese plot3_01831601:



    voice "voice/cygnus_307.ogg"
    cygnus "응. 이 세계 음식은 꽤 좋아해."


translate japanese plot3_0133a699:


    "식사를 마칠 무렵, 시노스가 오늘의 성과를 이야기하기 시작했다."


translate japanese plot3_99156e0f:



    voice "voice/cygnus_308.ogg"
    cygnus "거목을 조사했지만, 거기서 마력은 느껴지지 않았어."


translate japanese plot3_5cf88d75:



    voice "voice/cygnus_309.ogg"
    cygnus "내 마력으로 생긴 것은 아닌 것 같아."


translate japanese plot3_cb189fc4:



    voice "voice/tianqin_577.ogg"
    tianqin "어어!? 그래도 그렇게 큰 나무가 갑자기 나타난 건 아무리 봐도 이상하잖아!"


translate japanese plot3_7c6dd225:



    voice "voice/cygnus_310.ogg"
    cygnus "알아. 나도 아직 판단할 수 없어."


translate japanese plot3_b6b7cd4f:



    voice "voice/cygnus_311.ogg"
    cygnus "적어도 지금으로서는 그 나무와 내가 잃은 힘의 관련성은 낮아."


translate japanese plot3_68bfbb95:



    voice "voice/tianqin_578.ogg"
    tianqin "그렇구나……"


translate japanese plot3_c0b15a9c:



    voice "voice/tianqin_579.ogg"
    tianqin "그럼 어떻게 해? 시노스랑 관계없는 거라면──"


translate japanese plot3_b69a10fd:



    voice "voice/cygnus_312.ogg"
    cygnus "응, 상황이 조금 예상 밖인 건 사실이야."


translate japanese plot3_27d82d98:



    voice "voice/cygnus_313.ogg"
    cygnus "하지만 아직 단서가 하나 남아 있어."


translate japanese plot3_e0c78dd1:



    voice "voice/cygnus_314.ogg"
    cygnus "이거야."


translate japanese plot3_5294e40d:


    "시노스는 책 한 권을 조심스레 식탁 위에 올려놓았다."


translate japanese plot3_593643cf:



    voice "voice/tianqin_580.ogg"
    tianqin "그 책은……?"


translate japanese plot3_4c371732:



    voice "voice/cygnus_315.ogg"
    cygnus "これは、私の力の源—— {a=dictionary:dict_entry_46}魔導書{/a}だ。"


translate japanese plot3_ad943603:



    voice "voice/tianqin_581.ogg"
    tianqin "오, 오오……?"


translate japanese plot3_5c83dddd:


    "シノスの口ぶりはそれなりに重みがあったが、机に置かれたその本は、とても彼女の言葉を裏付けられるような代物には見えなかった。"


translate japanese plot3_b5345345:


    "가죽 표지는 낡았고, 잠금쇠도 금방 떨어질 듯 헐거웠다."


translate japanese plot3_040edd31:


    "겉에는 아무 글자도 없었다. 박물관 깊숙한 곳에서 잠들어 있던 비장품 같았다."


translate japanese plot3_dcfbcfd4:



    voice "voice/cygnus_316.ogg"
    cygnus "나와 함께 이 세계로 온 물건은 이 책뿐이야."


translate japanese plot3_68976b84:



    voice "voice/cygnus_317.ogg"
    cygnus "하지만…… 이것에 관한 기억도 없어."


translate japanese plot3_93602cb9:



    voice "voice/cygnus_318.ogg"
    cygnus "이 세계에 오기 전에 내가 어떤 준비를 했는지…… 나도 잘 모르겠어."


translate japanese plot3_5863160f:



    voice "voice/cygnus_319.ogg"
    cygnus "그래도 계속 이 책을 가지고 있었으니 분명 어떤 의미가 있겠지."


translate japanese plot3_1f9c9122:



    voice "voice/cygnus_320.ogg"
    cygnus "내가 이 세계에 오려고 세운 계획의 일부거나…… 힘 자체를 봉인한 물건일 수도 있어."


translate japanese plot3_7c3b4fd0:



    voice "voice/tianqin_582.ogg"
    tianqin "그럼 열면 전부 알 수 있다는 거야?"


translate japanese plot3_a19aaa23:



    voice "voice/cygnus_321.ogg"
    cygnus "그렇게 간단하지 않아. 마력으로 봉인되어 있어서 쉽게는 열리지 않거든."


translate japanese plot3_b934dcc1:



    voice "voice/cygnus_322.ogg"
    cygnus "며칠 동안 봉인을 푸는 방법을 꽤 오래 연구했어. 이제야 확실히 열 수 있겠다는 생각이 들었지."


translate japanese plot3_b7fbce69:



    voice "voice/cygnus_323.ogg"
    cygnus "그래서 지금부터 마력을 넣어 봉인을 풀 거야."


translate japanese plot3_acfeac76:



    voice "voice/cygnus_324.ogg"
    cygnus "무슨 일이 생길지는 몰라. 기절할 수도 있고, 잠깐 헛소리를 할 수도 있어."


translate japanese plot3_3a953715:



    voice "voice/cygnus_325.ogg"
    cygnus "무슨 일이 생겨도…… 잠깐만 돌봐 줄래? 금방 회복할 거야."


translate japanese plot3_bdae00ab:



    voice "voice/tianqin_583.ogg"
    tianqin "흐음……"


translate japanese plot3_6411aa6a:



    voice "voice/tianqin_584.ogg"
    tianqin "——어, 잠깐!? 엄청 위험한 일 아니야!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_50f0dae9:



    voice "voice/cygnus_326.ogg"
    cygnus "아니, 위험하지는 않을 거야. 내가 어떤 반응을 보일지 모를 뿐이지."


translate japanese plot3_01af0fd1:



    voice "voice/cygnus_327.ogg"
    cygnus "（전에 마도서에 많은 마력을 넣어 뒀다면, 봉인을 푸는 순간 그 마력이 몸으로 흘러들겠지.）"


translate japanese plot3_abcc1a59:



    voice "voice/cygnus_328.ogg"
    cygnus "（数日間「マナ真空」の環境にいた身体は、きっとこんなにたくさんの魔力に慣れない。{a=dictionary:dict_entry_48}「マナ酔い」{/a}は避けられないようだ。）"


translate japanese plot3_7a4adf62:



    voice "voice/cygnus_329.ogg"
    cygnus "（最悪、{a=dictionary:dict_entry_47}「魔力ショック」{/a}もありえる。）"


translate japanese plot3_98305df3:



    voice "voice/cygnus_330.ogg"
    cygnus "（그런 상황이면 누군가 곁에 있는 편이 조금 든든하겠네.）"


translate japanese plot3_6034296f:



    voice "voice/cygnus_331.ogg"
    cygnus "이제 시작할게."


translate japanese plot3_6dc08901:



    voice "voice/tianqin_585.ogg"
    tianqin "잠깐만!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_7fc63063:



    voice "voice/cygnus_332.ogg"
    cygnus "응?"


translate japanese plot3_b6e0cb37:



    voice "voice/tianqin_586.ogg"
    tianqin "시노스가 쓰러지면…… 난 뭘 하면 돼?"


translate japanese plot3_1b70a9e7:



    voice "voice/cygnus_333.ogg"
    cygnus "침대로 옮겨 주면 충분해."


translate japanese plot3_68072d75:



    voice "voice/tianqin_587.ogg"
    tianqin "어? 그게 다야?"


translate japanese plot3_e29ffa81:



    voice "voice/cygnus_334.ogg"
    cygnus "그게 다야."


translate japanese plot3_ba530e86:



    voice "voice/tianqin_588.ogg"
    tianqin "병원에 데려가지 않아도——"


translate japanese plot3_e50467bc:



    voice "voice/cygnus_335.ogg"
    cygnus "후후. 이 세계의 의사로는 치료할 수 없어."


translate japanese plot3_e0f48544:



    voice "voice/cygnus_336.ogg"
    cygnus "많은 마력 때문에 혼수상태에 빠지는 건 너희가 보기에는 「평범한 잠」 같은 거야."


translate japanese plot3_813b7c99:



    voice "voice/tianqin_589.ogg"
    tianqin "그렇구나……"


translate japanese plot3_7dd3583d:



    voice "voice/cygnus_337.ogg"
    cygnus "내가 알아서 조절할 수 있어. 걱정 마."


translate japanese plot3_8bc6b1ad:



    voice "voice/tianqin_590.ogg"
    tianqin "으, 응! 잘 돌봐 줄게!"


translate japanese plot3_e817e4ab:



    voice "voice/cygnus_338.ogg"
    cygnus "……그렇게 긴장하지 않아도 돼."


translate japanese plot3_a050fc9c:



    voice "voice/cygnus_339.ogg"
    cygnus "그럼 시작한다."


translate japanese plot3_ad50e491:



    voice "voice/tianqin_591.ogg"
    tianqin "으으——!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot3_29ac8664:


    "시노스가 달래도 라이라의 긴장은 조금도 풀리지 않았다. 오히려 시노스보다 더 안절부절못했다."


translate japanese plot3_cb119f2c:



    voice "voice/cygnus_340.ogg"
    cygnus "（……완전히 어린애 취급이네.）"


translate japanese plot3_a376fe9c:


    "웅——"


translate japanese plot3_4b96e667:


    "시노스가 낡은 마도서에 마력을 불어넣자, 책은 부름에 응답하듯 희미한 빛을 발하기 시작했다."


translate japanese plot3_126ed705:



    voice "voice/cygnus_341.ogg"
    cygnus "크윽――!"


translate japanese plot3_845447f5:


    "魔力が注ぎ込まれるたびに、魔導書はより強いシルバーの光を放った。それはシノス自身の魔力の色だった。"


translate japanese plot3_0bd42fd6:



    voice "voice/tianqin_592.ogg"
    tianqin "우, 우와아——!?"


translate japanese plot3_c28e061a:


    "마침내 시노스가 불어넣은 마력이 봉인을 풀었다. 책의 잠금쇠가 「탁」 소리를 내며 열렸다."


translate japanese plot3_a0c83fd5:



    voice "voice/cygnus_342.ogg"
    cygnus "（나와라, 내 【힘｜마력】!）"


translate japanese plot3_442941ca:


    "……"


translate japanese plot3_936c4298_5:



    voice "voice/cygnus_343.ogg"
    cygnus "……"


translate japanese plot3_2a8562d3:


    "상황은 마녀의 예상대로 흘러가지 않았다."


translate japanese plot3_a046e531:


    "마나 멀미는커녕 봉인이 풀린 마도서에서는 마력의 기척조차 나오지 않았다."


translate japanese plot3_8ab10130:



    voice "voice/tianqin_593.ogg"
    tianqin "저기…… 시노스? 괜찮아?"


translate japanese plot3_ab9de11c:



    voice "voice/cygnus_344.ogg"
    cygnus "괜찮아……"


translate japanese plot3_c6009d50:



    voice "voice/cygnus_345.ogg"
    cygnus "（……이 안에 마력을 봉인한 건 아니었나?）"


translate japanese plot3_342ba5cb:



    voice "voice/blackcat_01.ogg"
    blackcat3 "야옹"


translate japanese plot3_d6bd99d6:



    voice "voice/gt_04.ogg"
    npc14 "!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_675de4d3:


    "고양이 울음소리가 들리고서야, 두 사람은 시노스에게 쏠려 있던 주의를 식탁 쪽으로 돌렸다."


translate japanese plot3_59e553df:


    "마도서가 있던 자리에 고양이 한 마리가 나타났다."


translate japanese plot3_33300e69:



    voice "voice/blackcat_06.ogg"
    blackcat2 "냐하아"


translate japanese plot3_98cad097:



    voice "voice/blackcat_14.ogg"
    blackcat2 "드디어 이 몸을 깨웠군. 자, 이 세계는 벌써 정복했느냐?"


translate japanese plot3_7bc1d5db_1:



    voice "voice/cygnus_346.ogg"
    cygnus "——!"


translate japanese plot3_f6f7a60f:



    voice "voice/tianqin_594.ogg"
    tianqin "마, 말을 했어!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_9e30ca8f:



    voice "voice/tianqin_595.ogg"
    tianqin "え、え？ちょっと待って？"


translate japanese plot3_1369a9c8:



    voice "voice/tianqin_596.ogg"
    tianqin "이상해! 지금까지 「야옹」 소리밖에 안 들렸는데…… 왜 머릿속에 직접 말을 거는 거야!?"


translate japanese plot3_ab10947a:


    "라이라는 혼란스러워하면서도, 이게 마법 때문이라는 사실만은 확신했다."


translate japanese plot3_743409c8:



    voice "voice/blackcat_05.ogg"
    blackcat2 "오……? 너는……"


translate japanese plot3_dfe5ab61:



    blackcat2 "……"


translate japanese plot3_e4d96025:



    voice "voice/tianqin_597.ogg"
    tianqin "아, 안녕. 나는 라이라라고——"


translate japanese plot3_c96727b3:



    voice "voice/blackcat_02.ogg"
    blackcat2 "이름을 물은 게 아니다! 네 이름에는 관심 없어!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_7f8d5add:



    voice "voice/tianqin_598.ogg"
    tianqin "어어어!?"


translate japanese plot3_3c60c079:



    voice "voice/blackcat_13.ogg"
    blackcat2 "너…… 이세계의 원주민이냐? 몸에서 마력의 흐름이 전혀 느껴지지 않는군."


translate japanese plot3_900b7505:



    voice "voice/blackcat_04.ogg"
    blackcat2 "흥, 재미있어. 그렇다면 표류 마법은 성공한 건가."


translate japanese plot3_d85e06fc:



    voice "voice/cygnus_347.ogg"
    cygnus "넌 설마……"


translate japanese plot3_b9de2a76:



    voice "voice/blackcat_07.ogg"
    blackcat2 "응? 왜 그러지? 설마 이 몸을 못 알아보는 건 아니겠지?"


translate japanese plot3_2e95dc20:



    voice "voice/blackcat_13.ogg"
    blackcat2 "이 몸은 신성한 혈통을 이어받아 모든 계통의 마법을 통달하고, 마왕마저 벌벌 떨게 하는——"


translate japanese plot3_3b07f42b:



    voice "voice/blackcat_15.ogg"
    blackcat "마도서의 자율 사역마, 노리 님이시다!\n{space=250}{image=burntgif}{w=0.2}{image=burntgif}{w=0.2}{image=burntgif}" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_936c4298_6:



    voice "voice/cygnus_348.ogg"
    cygnus "……"


translate japanese plot3_62088ed9:



    voice "voice/tianqin_599.ogg"
    tianqin "어……"


translate japanese plot3_344ca3d6:


    "검은 고양이의 호쾌한 자기소개를 들은 시노스와 라이라는 서로를 바라봤다."


translate japanese plot3_bc437694:


    "고양이가 아무리 자신만만하게 허풍을 떨어도,"


translate japanese plot3_f6f47eea:


    "겉모습은 아무리 봐도 평범한 검은 고양이였다."


translate japanese plot3_e45b03ce_1:



    voice "voice/cygnus_349.ogg"
    cygnus "으음……"


translate japanese plot3_09d620ff:



    voice "voice/blackcat_10.ogg"
    blackcat "우냐앗!? 뭐, 뭐 하는 거냐! 무례한 녀석!!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_9c4599a6:


    "시노스는 노리의 항의를 완전히 무시했다. 양손으로 검은 고양이를 단단히 누르고, 마력으로 몸을 살폈다."


translate japanese plot3_c44f0422:



    voice "voice/cygnus_350.ogg"
    cygnus "……응, 문제없어. 분명 나와 계약한 존재야."


translate japanese plot3_cedf5502:



    voice "voice/cygnus_351.ogg"
    cygnus "틀림없는 내 사역마야."


translate japanese plot3_334b1887:



    voice "voice/blackcat_06.ogg"
    blackcat "하아악!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_1188f8de:


    "노리는 필사적으로 시노스의 손에서 빠져나와, 등을 둥글게 말고 경계했다."


translate japanese plot3_ef77e075:



    voice "voice/blackcat_03.ogg"
    blackcat "뭐, 뭐냐! 진심으로 이 몸을 잊은 거야!?"


translate japanese plot3_97722733:



    voice "voice/cygnus_352.ogg"
    cygnus "응, 잊었어. 기억 상실이야."


translate japanese plot3_6b1be8f1:



    voice "voice/blackcat_09.ogg"
    blackcat "뭐?"


translate japanese plot3_c4f1701b:



    voice "voice/cygnus_353.ogg"
    cygnus "기억을 잃었어."


translate japanese plot3_3909a045:



    voice "voice/blackcat_07.ogg"
    blackcat "진짜? 정말? 농담 아니고?"


translate japanese plot3_7b5dfa18:



    voice "voice/cygnus_354.ogg"
    cygnus "같은 질문을 몇 번이고 반복하지 마. 내 인내심에도 한계가 있어."


translate japanese plot3_f3be5e7b:


    "이유는 몰랐지만 시노스는 이 검은 고양이에게만 유독 짜증이 나기 시작했다."


translate japanese plot3_4aa6dbde:



    voice "voice/blackcat_11.ogg"
    blackcat "기억 상실…… 기억을 잃었다고……"


translate japanese plot3_9cf437ed:



    voice "voice/blackcat_12.ogg"
    blackcat "기억을 잃었다니……"


translate japanese plot3_7226baa1:



    voice "voice/blackcat_04.ogg"
    blackcat "상실이래! 냐하하하하하! 꼴좋다!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_251b13f7:



    voice "voice/blackcat_14.ogg"
    blackcat "아무것도 기억 못 한다고! 그럼 바보가 된 거잖아!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_c10e8772:



    voice "voice/blackcat_15.ogg"
    blackcat "바보, 바보! 냐하하하하——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_18406e43:



    voice "voice/cygnus_355.ogg"
    cygnus "……라이라. 이 사역마, 쓸모없어."


translate japanese plot3_30aef972:



    voice "voice/cygnus_356.ogg"
    cygnus "붙잡아 줘. 지금부터 마력을 전부 써서 재로 만들 거야."


translate japanese plot3_b93ac61c:



    voice "voice/tianqin_600.ogg"
    tianqin "어어어!? 나도 휘말리는 거 아냐?"


translate japanese plot3_eba83b35:



    voice "voice/cygnus_357.ogg"
    cygnus "걱정 마. 내 마법은 너한테 안 통해."


translate japanese plot3_7b714a52:



    voice "voice/tianqin_601.ogg"
    tianqin "그렇지! 그러고 보니 그랬네."


translate japanese plot3_8553873b:



    voice "voice/blackcat_13.ogg"
    blackcat "자, 잠깐만! 자기 사역마를 그렇게 다룰 셈이야!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_d199c19e:



    voice "voice/cygnus_358.ogg"
    cygnus "기억을 잃어도 알아. 「쓸모 있는 것」과 「쓸모없는 것」 정도는 구별할 수 있거든."


translate japanese plot3_a49479ef:



    voice "voice/cygnus_359.ogg"
    cygnus "너는 후자야."


translate japanese plot3_e0592a9d:



    voice "voice/cygnus_360.ogg"
    cygnus "라이라, 시작할게. 절대 놓치지 마. 가구에 불붙으면 곤란하니까."


translate japanese plot3_fdef5755:



    voice "voice/tianqin_602.ogg"
    tianqin "알겠습니다—" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_6a401b51:



    voice "voice/blackcat_01.ogg"
    blackcat "냐갸갸갸갸악—!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_c267df05:



    voice "voice/blackcat_06.ogg"
    blackcat "자, 잠깐! 전에 네가 나한테 이것저것 당부한 게 있다고!"


translate japanese plot3_db1b2cd9:



    voice "voice/cygnus_361.ogg"
    cygnus "……정말이야?"


translate japanese plot3_3e37d9c0:



    voice "voice/blackcat_04.ogg"
    blackcat "진짜 진짜야! 정말이라니까! 그러니 놓으라고—!"


translate japanese plot3_e5bdab0a:



    voice "voice/tianqin_603.ogg"
    tianqin "시노스 장관님, 어떻게 할까요!"


translate japanese plot3_58fc30dd:



    voice "voice/cygnus_362.ogg"
    cygnus "……일단 놓아 줘."


translate japanese plot3_d89ea3c7:



    voice "voice/blackcat_08.ogg"
    blackcat "하아…… 하아…… 살았다……"


translate japanese plot3_d932f7a0:



    voice "voice/blackcat_11.ogg"
    blackcat "이렇게 함부로 다루는 주인은 들어 본 적도 없는데——"


translate japanese plot3_f0197c43:



    voice "voice/cygnus_363.ogg"
    cygnus "さあ、言いなさい。私が何を指示したのか。" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_983a7d89:



    voice "voice/blackcat_12.ogg"
    blackcat "아야, 아야! 알았다고! 그러니까 배 좀 그만 찔러!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_ddac631f:



    voice "voice/blackcat_03.ogg"
    blackcat "으음～～～ 네가 기억을 잃을 줄이야～"


translate japanese plot3_8335678b:



    voice "voice/blackcat_06.ogg"
    blackcat "지금 마력도 거의 안 남았지? 이 세계는 마나가 너무 희박해서 명상으로는 거의 회복도 못 하니까."


translate japanese plot3_7bc1d5db_2:



    voice "voice/cygnus_364.ogg"
    cygnus "——!"


translate japanese plot3_7257e546:



    voice "voice/cygnus_365.ogg"
    cygnus "그러면 내가 오기 전부터 이런 상황을 예상했다는 거야?"


translate japanese plot3_348d35ed:



    voice "voice/blackcat_13.ogg"
    blackcat "いや、それは違うな。お前が使ったのは一つの世界からもう一つの世界に漂流する魔法だぞ？副作用があって当然。"


translate japanese plot3_fd3c2f32:



    voice "voice/blackcat_14.ogg"
    blackcat "오히려 기억 상실이면 가벼운 편이지."


translate japanese plot3_1b61a72d:



    voice "voice/blackcat_07.ogg"
    blackcat "뭐, 기억은 차차 돌아올……지도 모르지. 아마도."


translate japanese plot3_936c4298_7:



    voice "voice/cygnus_366.ogg"
    cygnus "……"


translate japanese plot3_b3daaeec:


    "노리의 말처럼, 시노스의 기억은 아직 혼란스러웠지만 단편적인 장면은 떠올릴 수 있었다."


translate japanese plot3_8124b355:


    "시간이 지나면 잃어버린 기억이 돌아올 가능성도 있었다."


translate japanese plot3_b0394952:



    voice "voice/cygnus_367.ogg"
    cygnus "그러면…… 내 「힘」은 어떻게 된 거야?"


translate japanese plot3_4d7a70d7:



    voice "voice/cygnus_368.ogg"
    cygnus "원래는 세계 표류 수준의 마법을 쓸 수 있는데…… 지금의 나는 너무 약해."


translate japanese plot3_b24883cf:



    voice "voice/blackcat_04.ogg"
    blackcat "그건 표류 마법을 준비할 때…… 네가 직접 몸에서 힘을 떼어 냈기 때문이야."


translate japanese plot3_9cc08c75:



    voice "voice/cygnus_369.ogg"
    cygnus "……뭐?"


translate japanese plot3_c510ab4c:



    voice "voice/cygnus_370.ogg"
    cygnus "말도 안 돼…… 내가 그런 위험을 감수할 리 없는데."


translate japanese plot3_cd653652:



    voice "voice/blackcat_02.ogg"
    blackcat "네 마력이 너무 많아서 그렇잖아, 바보야!"


translate japanese plot3_e477e142:



    voice "voice/blackcat_03.ogg"
    blackcat "이 세계는 아주 특수해서…… 「이곳으로 오는 통로」가 아주, 아주, 아주 좁아."


translate japanese plot3_2cf26f75:



    voice "voice/blackcat_08.ogg"
    blackcat "통로를 아무리 넓혀도 네가 그대로는 절대로 통과할 수 없었어."


translate japanese plot3_0f5fea9e:



    voice "voice/blackcat_06.ogg"
    blackcat "だからお前は考えた。自分の魔力を四つの{a=dictionary:dict_entry_44}魔導器{/a}に分散し、それぞれを遅延の漂流魔法で順に送るっていう、めちゃくちゃ大胆な方法をな。"


translate japanese plot3_9ad932c3:



    voice "voice/cygnus_371.ogg"
    cygnus "（내가 생각해도 너무 멍청했어……!）" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_21b5bf5f:



    voice "voice/blackcat_15.ogg"
    blackcat "너도 스스로 너무 멍청하다고 생각하지!? 냐하하하하!"


translate japanese plot3_a34da711:



    voice "voice/cygnus_372.ogg"
    cygnus "지금…… 뭐라고 했어?"


translate japanese plot3_555e88d5:



    voice "voice/blackcat_11.ogg"
    blackcat "아, 아닙니다. 천재적인 생각이라고 말씀드렸을 뿐——"


translate japanese plot3_da599a3a:



    voice "voice/blackcat_12.ogg"
    blackcat "아야! 머리 좀 그만 때려!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_27d93fba:



    voice "voice/cygnus_373.ogg"
    cygnus "（그럼 마도구는 지금도 이쪽으로 표류해 오는 중……）"


translate japanese plot3_b27a00f4:



    voice "voice/cygnus_374.ogg"
    cygnus "하나 더. 내가 그만한 위험을 감수하면서까지 이 세계에 온 목적은 뭐야?"


translate japanese plot3_885f9e38:



    voice "voice/blackcat_05.ogg"
    blackcat "뭐? 내가 어떻게 알아. 이 몸한테 거기까지 말해 주진 않았잖아."


translate japanese plot3_083c0e0d:


    "펑—!"


translate japanese plot3_1c54cc98:


    "시노스는 손바닥에 거대한 불덩이를 만들고, 가장 무시무시한 미소로 사역마를 내려다봤다."


translate japanese plot3_11d9e387:



    voice "voice/cygnus_375.ogg"
    cygnus "……기억나게 도와줄까?"


translate japanese plot3_d3e414e2:



    voice "voice/blackcat_01.ogg"
    blackcat "으아아아악! 생각났어! 전부 생각났으니까!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_7607a466:



    voice "voice/blackcat_03.ogg"
    blackcat "분명 무슨 「나무」를 찾으러 온 거야! 그 이상은 몰라!"


translate japanese plot3_b5284ed5:



    voice "voice/tianqin_604.ogg"
    tianqin "중앙 공원의 거목이야!"


translate japanese plot3_07f1e470:



    voice "voice/cygnus_376.ogg"
    cygnus "……결국 다시 거기로 돌아오는구나."


translate japanese plot3_41247ffa:


    "결국 모든 것이 그 거목으로 이어졌다."


translate japanese plot3_92afed97:


    "그 사실에 시노스의 마음이 조금 무거워졌다."


translate japanese plot3_9ddbaeaa:



    voice "voice/blackcat_13.ogg"
    blackcat "하아, 하아—— 그러니까 얼른 불부터 꺼. 타면 큰일이라고."


translate japanese plot3_c5e28bbf:



    voice "voice/cygnus_377.ogg"
    cygnus "마지막 질문이야. 대답하면 일단 봐줄게."


translate japanese plot3_453b4d6d:



    voice "voice/blackcat_14.ogg"
    blackcat "なんでも聞け！なんでも答える！"


translate japanese plot3_0163b2e1:



    voice "voice/cygnus_378.ogg"
    cygnus "내가 너와 계약한 이유는 뭐지?"


translate japanese plot3_ca232462:



    voice "voice/blackcat_04.ogg"
    blackcat "당연하잖아! 이세계에 도착한 뒤 이 몸이 도와주기 위해서지."


translate japanese plot3_3082a525:



    voice "voice/cygnus_379.ogg"
    cygnus "역시 넌 「쓸모없는」 쪽이었네."


translate japanese plot3_de6ce87e:



    voice "voice/blackcat_01.ogg"
    blackcat "냐아아아아아——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_e288edee:


    "봉인을 푼 마도서가 힘을 돌려주지는 않았지만, 사역마의 정보 덕분에 앞으로 나아갈 방향은 분명해졌다."


translate japanese plot3_7160ba5e:



    voice "voice/cygnus_380.ogg"
    cygnus "내가 직접 힘을 떼어 낸 거였구나……"


translate japanese plot3_bb6f0ce9:



    voice "voice/tianqin_605.ogg"
    tianqin "그러니까…… 그럼 시노스의 그…… 「마도구」를 다 되찾으면 사건도 전부 해결할 수 있어?"


translate japanese plot3_dfbe5ac6:



    voice "voice/cygnus_381.ogg"
    cygnus "응, 내 마력을 전부 거기에 봉인했어."


translate japanese plot3_3c6bb575:



    voice "voice/tianqin_606.ogg"
    tianqin "그럼 그건 어디 있는데?"


translate japanese plot3_a9db3207:



    voice "voice/cygnus_382.ogg"
    cygnus "아까 말했듯이 마도구에는 내 마력이 봉인되어 있어. 나타난 곳에는 「【왜곡｜Error】」이 생길 가능성이 커."


translate japanese plot3_68b30964:



    voice "voice/cygnus_383.ogg"
    cygnus "초자연 현상이 있으면 다시 알려 줘."



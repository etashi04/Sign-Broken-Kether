    voice "voice/tianqin_632.ogg"
    tianqin "세——————이프!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_17407caf:


    "수업 시작 5분 전, 라이라가 겨우 교실로 뛰어들었다."


translate japanese plot3_784e4aeb:



    voice "voice/yangxi_206.ogg"
    yangxi "더 일찍 올 줄 알았는데."


translate japanese plot3_a63c6c9e:



    voice "voice/tianqin_633.ogg"
    tianqin "오는 길에 츠루기를 만났거든. 잠깐 얘기하다 보니 늦어졌어～!"


translate japanese plot3_5c95abd8:



    voice "voice/yangxi_207.ogg"
    yangxi "아, 걔."


translate japanese plot3_628c7754:


    "히나타는 츠루기의 자리를 바라봤다. 츠루기도 라이라와 마찬가지로 방금 교실에 들어온 참이었다."


translate japanese plot3_a335d753:



    voice "voice/yangxi_208.ogg"
    yangxi "걔는 늘 아슬아슬하게 오네."


translate japanese plot3_ad66a4d0:



    voice "voice/tianqin_634.ogg"
    tianqin "家が学校の近くだよ。ほら、学校の隣にある高級住宅街。"


translate japanese plot3_f1f93fa2:



    voice "voice/yangxi_209.ogg"
    yangxi "역시 부자네."


translate japanese plot3_bd4537b1:



    voice "voice/tianqin_635.ogg"
    tianqin "그러니까. 나도 그런 데 살고 싶다. 그럼 더 잘 수 있을 텐데."


translate japanese plot3_8762d54f:



    voice "voice/yangxi_210.ogg"
    yangxi "너는 늦잠 자고 그냥 학교에 안 올걸."


translate japanese plot3_2679af12:



    voice "voice/tianqin_636.ogg"
    tianqin "올 거거든!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot3_7ad09cca:



    voice "voice/tianqin_637.ogg"
    tianqin "（킁킁……）"


translate japanese plot3_6f41603a:



    voice "voice/tianqin_638.ogg"
    tianqin "응——?"


translate japanese plot3_dbd8b3b0:



    voice "voice/tianqin_639.ogg"
    tianqin "야, 교실에서 이상한 냄새 안 나?"


translate japanese plot3_ed4cd3cf:



    voice "voice/yangxi_211.ogg"
    yangxi "내가 왔을 때부터 이랬어. 누가 음식을 썩혔나 보지."


translate japanese plot3_87f667ce:



    voice "voice/tianqin_640.ogg"
    tianqin "으음——"


translate japanese plot3_75ad99ee:



    voice "voice/yangxi_212.ogg"
    yangxi "……설마 너는 아니지?"


translate japanese plot3_e45ba760:



    voice "voice/tianqin_641.ogg"
    tianqin "아니야! 난 음식 절대 안 버려!"


translate japanese plot3_4ea4032d:



    voice "voice/yangxi_213.ogg"
    yangxi "그렇지. 네 뱃속을 피해 간 음식은 본 적 없으니까."


translate japanese plot3_199a5f9c:



    voice "voice/tianqin_642.ogg"
    tianqin "너무 무섭게 말하지 마～!" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot3_fe4bf846:



    voice "voice/xizhen_03.ogg"
    xizhen "저기, 츠루기. 어제 훈련 끝나고 그 가게 들렀다며?"


translate japanese plot3_ce83ee1b:



    voice "voice/hecheng_31.ogg"
    hecheng "응. 마침 줄 선 사람이 없더라고."


translate japanese plot3_ae173989:



    voice "voice/hecheng_32.ogg"
    hecheng "요즘 그 가게 인터넷에서 인기잖아. 그런 기회가 또 없지."


translate japanese plot3_dc6f3806:



    voice "voice/xizhen_04.ogg"
    xizhen "에이! 그럼 같이 갈걸!"


translate japanese plot3_72938876:



    voice "voice/minying_03.ogg"
    minying "난 무리야. 어제 훈련하고 온몸이 쑤셔서……"


translate japanese plot3_98a88ba4:



    voice "voice/hecheng_33.ogg"
    hecheng "괜찮아. 다음에 시간 맞으면 같이 가자."


translate japanese plot3_ea246b45:



    voice "voice/minying_04.ogg"
    minying "응!"


translate japanese plot3_baa66e88:



    voice "voice/hecheng_34.ogg"
    hecheng "……그나저나 이 냄새는 뭐야?"


translate japanese plot3_86b9af2b:



    voice "voice/xizhen_05.ogg"
    xizhen "몰라. 우리 왔을 때부터 계속 났어."


translate japanese plot3_65f1e8db:



    voice "voice/hecheng_35.ogg"
    hecheng "……"


translate japanese plot3_1254eace:



    voice "voice/hecheng_36.ogg"
    hecheng "……잠깐."


translate japanese plot3_990a6be2:



    voice "voice/xizhen_06.ogg"
    xizhen "어?"


translate japanese plot3_65f1e8db_1:



    voice "voice/hecheng_37.ogg"
    hecheng "……"


translate japanese plot3_4ce23e58:


    "츠루기는 굳은 얼굴로 자기 자리로 향했다. 다가갈수록 불쾌한 썩은 냄새가 짙어졌다."


translate japanese plot3_a98ac555:



    voice "voice/xizhen_07.ogg"
    xizhen "츠루기?"


translate japanese plot3_70a9b95d:



    voice "voice/minying_05.ogg"
    minying "괘, 괜찮아?"


translate japanese plot3_0d8e03e3:



    voice "voice/hecheng_38.ogg"
    hecheng "너희는 뒤로 물러서."


translate japanese plot3_124f4b88:



    voice "voice/minying_06.ogg"
    minying "어, 네, 네……"


translate japanese plot3_22e6008d:


    nvlNone "사각……"


translate japanese plot3_5f01cb1b:


    nvlNone "츠루기의 가슴속에 묵직한 불안이 번졌다."


translate japanese plot3_3503a6da:


    nvlNone "그녀는 두려운 듯 조심스레 책상 안으로 손을 넣었다."


translate japanese plot3_783892fe:


    nvlNone "처음 만져진 건 자신의 교과서였다."


translate japanese plot3_52b3be57:


    nvlNone "하지만 섬뜩한 것은," with Shake((0, 0, 0, 0), 900, dist=-1.5)


translate japanese plot3_db5804a5:


    nvlNone "맨 위 교과서를 꺼내려 하자 그 위에 「무언가」 쌓여 있다는 느낌이 들었다는 점이었다." with Shake((0, 0, 0, 0), 900, dist=-1.5)


translate japanese plot3_749f138c:


    nvlNone "그 「무언가」는 뭘까?" with Shake((0, 0, 0, 0), 900, dist=-1.5)


translate japanese plot3_e9d08129:


    nvlNone "불안이 목까지 차올랐다." with Shake((0, 0, 0, 0), 900, dist=-1.5)


translate japanese plot3_83bb6d4a:

    voice "voice/npc_0013.ogg"

    nvlNone "「꺄아아아!!!」" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot3_d599060a:


    nvlNone "츠루기 뒤에 있던 여학생이 비명을 질렀고,"


translate japanese plot3_8b83095b:


    nvlNone "책상 속에는 흰쥐 몇 마리의 사체가 있었다."


translate japanese plot3_634ff5e3:


    nvlNone "하나같이 악취미가 느껴졌고,\n압정으로 교과서에 고정되어 있었다."


translate japanese plot3_49ee2b15:


    nvlNone "가운데의 쥐는 배가 갈라져, 텅 빈 복강이 드러나 있었다."


translate japanese plot3_8f422523:


    nvlNone "……"


translate japanese plot3_65f1e8db_4:



    voice "voice/hecheng_39.ogg"
    hecheng "……"


translate japanese plot3_53f8e81f:


    "츠루기는 흰쥐들을 털어 내지도 않고, 그저 묘한 눈으로 바라보고 있었다."


translate japanese plot3_a5259b35:


    "誰も声をかけられない。誰も助けようとしない。空気は凍りついたままだ。"


translate japanese plot3_8311ef98:


    "츠루기는 미동도 없이 쌓인 사체를 멍하니 내려다봤다."


translate japanese plot3_9459ef9a:



    voice "voice/tianqin_643.ogg"
    tianqin "츠루기, 내가 치워 줄게."


translate japanese plot3_c46cef17:


    "라이라는 곧 정신을 차리고 츠루기를 도우려고 한 걸음 다가갔다."


translate japanese plot3_fc72d7f4:



    voice "voice/hecheng_40.ogg"
    hecheng "아니…… 손대지 마." with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_990a6be2_1:



    voice "voice/tianqin_644.ogg"
    tianqin "え？"


translate japanese plot3_70d0de3d:



    voice "voice/hecheng_41.ogg"
    hecheng "내가 할게."


translate japanese plot3_e4a9bebb:



    voice "voice/tianqin_645.ogg"
    tianqin "그, 그래…… 알았어."


translate japanese plot3_2ac379c9:


    "츠루기는 담담하게 책을 들고 그대로 교실을 나갔다."


translate japanese plot3_36923c65:



    voice "voice/banzhang_46.ogg"
    banzhang "……"


translate japanese plot3_373bf3d1:



    voice "voice/xiaoxia_83.ogg"
    xiaoxia "……"


translate japanese plot3_be78bedf:


    "鶴城が出て行くと、教室内は一気にざわつきはじめた。"


translate japanese plot3_0776e013:



    voice "voice/npc6_04.ogg"
    npc6 "완전 겁먹은 거 맞지?"


translate japanese plot3_13be5015:



    voice "voice/npc7_04.ogg"
    npc7 "센 척하더라. 누구 보라고 그러는 건지."


translate japanese plot3_87ac7d8a:



    voice "voice/npc6_05.ogg"
    npc6 "그러게."


translate japanese plot3_f481df58:



    voice "voice/npc6_06.ogg"
    npc6 "다른 체육 특기생들이 그러는데, 츠루기는 나서기 좋아한다며. 맨날 거들먹거리더니 보복당한 거 아냐?"


translate japanese plot3_a090d7fb:



    voice "voice/npc7_05.ogg"
    npc7 "하하, 꼴좋다."


translate japanese plot3_ede6c737:



    voice "voice/tianqin_646.ogg"
    tianqin "야, 너희……"


translate japanese plot3_1836c8e5:



    voice "voice/yangxi_214.ogg"
    yangxi "（잠깐, 라이라.）"


translate japanese plot3_4b96c781:



    voice "voice/tianqin_647.ogg"
    tianqin "하지만 쟤네……"


translate japanese plot3_aa6c2484:



    voice "voice/yangxi_215.ogg"
    yangxi "지금 여기서 싸워 봐야 소용없어. 츠루기도 곧 돌아올 거야."


translate japanese plot3_71e08e60_1:



    voice "voice/tianqin_648.ogg"
    tianqin "……"


translate japanese plot3_7bda89fc:



    voice "voice/tianqin_649.ogg"
    tianqin "（왜 이런 일이 생긴 거야……）"


translate japanese plot3_118b1ad4:


    "한편 시노스는 라이라가 알려 준 대로 두 사람이 처음 만난 장소로 향하고 있었다."


translate japanese plot3_79c1debe:


    "노리가 소동을 일으킬까 봐 집에 남겨 두고 혼자 나온 참이었다."


translate japanese plot3_9c44c7ec_1:



    voice "voice/jiaozi_24.ogg"
    jiaozi "멍멍—"


translate japanese plot3_706f8484:


    "그렇다고 이번에 완전히 혼자인 건 아니었다. 집을 나서자마자 자오쯔가 줄곧 따라붙었기 때문이다."


translate japanese plot3_cd81fd42:


    "시노스에게서 라이라의 냄새가 난 탓일 것이다. 산책시켜 줄 거라고 착각하는 모양이었다."


translate japanese plot3_60a2a04a:



    voice "voice/cygnus_406.ogg"
    cygnus "쉿…… 자오쯔, 조용히 해. 이웃들에게 방해되잖아."


translate japanese plot3_8e82a85b:



    voice "voice/jiaozi_22.ogg"
    jiaozi "멍—"


translate japanese plot3_a5a6ced0:



    voice "voice/cygnus_407.ogg"
    cygnus "정말 따라올 줄이야. 라이라에게 네 얘기를 들어 둬서 다행이네."


translate japanese plot3_512eda93_1:



    voice "voice/jiaozi_26.ogg"
    jiaozi "멍."


translate japanese plot3_87874305:



    voice "voice/cygnus_408.ogg"
    cygnus "알았어, 알았어. 내 뒤를 따라와. 먼저 길부터 확인해야겠어."


translate japanese plot3_9c44c7ec:



    voice "voice/jiaozi_21.ogg"
    jiaozi "멍멍——"


translate japanese plot3_bf71feb9:



    voice "voice/cygnus_409.ogg"
    cygnus "으음…… 라이라가 말한 곳이면 이 근처일 텐데."


translate japanese plot3_bcc2d680:



    voice "voice/cygnus_410.ogg"
    cygnus "……치과라."


translate japanese plot3_a911da28:



    voice "voice/cygnus_411.ogg"
    cygnus "아…… 여기네."


translate japanese plot3_d7545273:


    "치과는 외관이 워낙 특이해서 시노스는 금세 찾아갈 수 있었다."


translate japanese plot3_3fae02b0:



    voice "voice/cygnus_412.ogg"
    cygnus "나랑 라이라는 이 근처에서 만났지……"


translate japanese plot3_936c4298_10:



    voice "voice/cygnus_413.ogg"
    cygnus "……"


translate japanese plot3_5762eb4e:


    "시노스는 거리를 오가며 마도구의 기척을 찾았다. 하지만 흔적은 발견하지 못했다."


translate japanese plot3_7aab18bf:


    "마도구는커녕 자신이 이 세계에 떨어지며 남겼을 마력의 흔적조차 완전히 사라져 있었다."


translate japanese plot3_62c9a782:


    "이 세계에서 마력은 대기 중에 방출되면 곧바로 분해되었다. 조금만 시간이 지나도 흔적이 남지 않았다."


translate japanese plot3_786eaa74:



    voice "voice/cygnus_414.ogg"
    cygnus "여기에는 없나……"


translate japanese plot3_04693292:


    "떨어진 곳을 찾지 못한 시노스는 거리의 좁은 골목을 전부 돌아봤지만, 마력 반응은 하나도 없었다."


translate japanese plot3_fe6cadb2:



    voice "voice/cygnus_415.ogg"
    cygnus "여기도 아니야……"


translate japanese plot3_b515d7b6:


    "오기 전부터 허탕을 칠 각오는 했지만, 실제로 아무것도 얻지 못하자 실망은 어쩔 수 없었다."


translate japanese plot3_e5d9bcb2:



    voice "voice/cygnus_416.ogg"
    cygnus "대체 어디에 버린 거지……"


translate japanese plot3_75612edd:



    voice "voice/jiaozi_25.ogg"
    jiaozi "멍…… 멍?"


translate japanese plot3_75201507:



    voice "voice/cygnus_417.ogg"
    cygnus "자오쯔? 왜 그래?"


translate japanese plot3_512eda93:



    voice "voice/jiaozi_23.ogg"
    jiaozi "멍—"


translate japanese plot3_13dfb15f:


    "자오쯔가 어디선가 주워 온 작은 공을 시노스의 발치에 굴려 놓았다."


translate japanese plot3_2b5c20be:



    voice "voice/cygnus_418.ogg"
    cygnus "……미안해, 자오쯔. 지금은 바빠서 놀아 줄 수 없어."


translate japanese plot3_979c3dac:



    voice "voice/jiaozi_27.ogg"
    jiaozi "멍……"


translate japanese plot3_70161c1d:


    "シノスの言葉を理解したように、餃子は悲しそうにボールをくわえ、すごすごと離れていった。"


translate japanese plot3_e1e45ed0:



    voice "voice/cygnus_419.ogg"
    cygnus "（……끝나면 조금 놀아 줘야겠어.）"


translate japanese plot3_280a4101:


    "한편 츠루기 사건의 소문은 교실에서 더욱 퍼져 나가고 있었다."


translate japanese plot3_fd25a1d2:



    voice "voice/npc6_07.ogg"
    npc6 "야, 츠루기 조퇴했대."


translate japanese plot3_6595d8df:



    voice "voice/npc7_06.ogg"
    npc7 "그러겠지. 그런 걸 보고 멀쩡할 사람이 어딨어."


translate japanese plot3_71a0f2aa:



    voice "voice/npc6_08.ogg"
    npc6 "좋겠다～ 나도 조퇴하고 싶다……"


translate japanese plot3_85fb5263:



    voice "voice/npc7_07.ogg"
    npc7 "그럼 내일 네 책상에도 쥐 넣어 줄까?"


translate japanese plot3_d04c9bef:



    voice "voice/npc6_09.ogg"
    npc6 "하하, 그 전에 네가 먼저 겁먹을걸?"


translate japanese plot3_8cb1be1e:



    voice "voice/tianqin_650.ogg"
    tianqin "야."


translate japanese plot3_86a68556:



    voice "voice/npc6_10.ogg"
    npc6 "뭐? 왜?"


translate japanese plot3_b7ffface:



    voice "voice/tianqin_651.ogg"
    tianqin "그런 건 농담으로 할 얘기가 아닌 것 같은데." with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_33550897:



    voice "voice/npc6_11.ogg"
    npc6 "……쳇, 재미없게."


translate japanese plot3_7721df25:



    voice "voice/npc7_08.ogg"
    npc7 "쳇, 잘난 척은."


translate japanese plot3_d40e022a:


    "라이라가 끼어들자 츠루기 이야기를 하던 학생들은 어색해하며 자리를 떠났다."


translate japanese plot3_4db4ad58:



    voice "voice/yangxi_216.ogg"
    yangxi "라이라."


translate japanese plot3_73364247:



    voice "voice/tianqin_652.ogg"
    tianqin "……저건 너무하잖아."


translate japanese plot3_8a7bbd9a:



    voice "voice/yangxi_217.ogg"
    yangxi "그만해. 츠루기를 감싸 줘도 걔한테 도움이 되는 건 없어."


translate japanese plot3_ef8b680d:



    voice "voice/yangxi_218.ogg"
    yangxi "우리 반 문제는 오늘 하루에 어떻게 될 일이 아니야."


translate japanese plot3_17adc0c7:



    voice "voice/tianqin_653.ogg"
    tianqin "……하아."


translate japanese plot3_2ec7f3f0:


    "이 반의 분위기는 조금도 화목하지 않았다."


translate japanese plot3_28c37f41:


    "명문 학교답게 성적뿐 아니라 집안 배경도 대단했다."


translate japanese plot3_b25657ad:


    "기업 임원, 정치인, 유력 인사의 자녀들이 많이 다녔다."


translate japanese plot3_91d17cce:


    "그래서 파벌 의식도 강했다."


translate japanese plot3_7499eede:


    "반에는 츠루기를 못마땅하게 여기는 사람도 많았다."


translate japanese plot3_8a4c5c96:


    "그런데도 아무도 이런 악질적인 짓을 하지 않았던 것은,"


translate japanese plot3_add1a060:


    "츠루기의 집안 역시 대단했기 때문이다. 지역에서도 이름난 부동산 재벌이라, 그녀를 화나게 하면 단순한 골칫거리로 끝나지 않았다."


translate japanese plot3_3963521f:


    "그 영향력 때문에 그녀는 동경과 반감을 동시에 샀다."


translate japanese plot3_7b066158:


    "이번 장난은 도화선이 되어, 반의 「츠루기를 싫어하는」 파벌을 단번에 불타오르게 했다."


translate japanese plot3_5b103bc8:


    "クラスの対立は、これまでになく険悪なものへと変わっていく。"


translate japanese plot3_09be4ff6:



    voice "voice/tianqin_654.ogg"
    tianqin "……그래서 우리 반에 그런 일이 있었다니까～"


translate japanese plot3_baea61c6:



    voice "voice/tianqin_655.ogg"
    tianqin "하아～ 다들 사이좋게 지내면 안 되나."


translate japanese plot3_e7339120:



    voice "voice/keke_34.ogg"
    keke "저기, 심심하다고 아무 때나 실험실에 좀 오지 마."


translate japanese plot3_24aacbb7:



    voice "voice/tianqin_656.ogg"
    tianqin "에이～ 코코 짱, 말 너무 심하게 하네."


translate japanese plot3_8ba95c05:



    voice "voice/tianqin_657.ogg"
    tianqin "그래도 내가 선배인데? "


translate japanese plot3_0978b2bc:



    voice "voice/keke_35.ogg"
    keke "그런 선배는 진심으로 필요 없거든."


translate japanese plot3_18c5b673:



    voice "voice/keke_36.ogg"
    keke "그리고 코코 짱이라고 부르지 말라니까!"


translate japanese plot3_1b1480d8:



    voice "voice/tianqin_658.ogg"
    tianqin "알았어, 알았어. 그렇게 화내지 마～"


translate japanese plot3_457a8de7:



    voice "voice/keke_37.ogg"
    keke "한참 어린 후배한테 푸념하는 게 부끄럽지도 않아!?"


translate japanese plot3_a7b91672:



    voice "voice/tianqin_659.ogg"
    tianqin "코코는 늘 한가해 보이니까."


translate japanese plot3_5a9ad9e8:



    voice "voice/keke_38.ogg"
    keke "한가할 리가 있나! 엄청 바쁘거든! 논문도 산더미야!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_4cc2b259:



    voice "voice/keke_39.ogg"
    keke "그리고 선배한테는 영원한 단짝이 있잖아? 그런 얘기는 걔한테 해!"


translate japanese plot3_4971126d:



    voice "voice/tianqin_660.ogg"
    tianqin "{a=dictionary:dict_entry_49}「ズッ友」{/a}……数年ぶりに聞いたよその文言。もう死語でしょ。"


translate japanese plot3_8e5b3efa:



    voice "voice/keke_40.ogg"
    keke "アンタに言われたくないわ！"


translate japanese plot3_fa026f3d:



    voice "voice/keke_41.ogg"
    keke "남 신경 쓸 시간 있으면 교과서라도 한 권 읽어."


translate japanese plot3_632a88f4:



    voice "voice/keke_42.ogg"
    keke "쓸데없는 동정심은 시간 낭비야."


translate japanese plot3_1cae590a:



    voice "voice/tianqin_661.ogg"
    tianqin "코코까지 왜 그렇게 말해—"


translate japanese plot3_13ddcad6:



    voice "voice/keke_43.ogg"
    keke "우린 학생이잖아. 골치 아픈 건 선생님한테 다 맡기면 돼."


translate japanese plot3_d6278c37:



    voice "voice/tianqin_662.ogg"
    tianqin "……하지만 난 아무것도 안 하고 있기는 싫어."


translate japanese plot3_1a3e84ad:



    voice "voice/tianqin_663.ogg"
    tianqin "눈앞에서 그런 일이 일어났는데 모른 척할 수는 없잖아."


translate japanese plot3_351873a2:



    voice "voice/keke_44.ogg"
    keke "（정말 이 사람은 스스로 골칫거리를 주우러 다닌다니까……）"


translate japanese plot3_d15eb05e:



    voice "voice/tianqin_664.ogg"
    tianqin "그나저나 코코, 뭐 해?"


translate japanese plot3_7efc7b73:



    voice "voice/keke_45.ogg"
    keke "아까 길에서 주운 흰쥐 해부 준비."


translate japanese plot3_d743d714:



    voice "voice/tianqin_665.ogg"
    tianqin "어?"


translate japanese plot3_3f677bd7:


    "라이라가 들여다보니, 코코는 정말로 화학 실험대에서 생물 해부를 할 생각이었다."


translate japanese plot3_97623e5f:



    voice "voice/tianqin_666.ogg"
    tianqin "화학 선생님이 보시면 완전 화내시겠다."


translate japanese plot3_17f45446:



    voice "voice/keke_46.ogg"
    keke "여긴 몇 년째 내 구역이잖아. 마음에 안 드셨으면 진작 쫓아내셨겠지."


translate japanese plot3_87dc49b1:



    voice "voice/keke_47.ogg"
    keke "그리고 아까 선배의 시시한 얘기 덕분에 이 흰쥐가 어디서 왔는지 알았어."


translate japanese plot3_d4c6d1a0:



    voice "voice/tianqin_667.ogg"
    tianqin "아! 잠깐…… 설마 쓰레기통에서 주워 온 건 아니지……"


translate japanese plot3_4e467a36:



    voice "voice/keke_48.ogg"
    keke "아니야! 길에 떨어져 있었어!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_fa0705b6:



    voice "voice/keke_49.ogg"
    keke "선배네 반 츠루기라는 애가 버리다가 떨어뜨린 거야."


translate japanese plot3_f9a0ba75:



    voice "voice/tianqin_668.ogg"
    tianqin "그래도 보통은 길에서 쥐를 주워 오지 않잖아…… 죽은 쥐는 더더욱……"


translate japanese plot3_5849e552:



    voice "voice/keke_50.ogg"
    keke "나도 주워서 버리려고 했어. 그런데 뭔가 이상하더라고."


translate japanese plot3_111dc9ae:



    voice "voice/tianqin_669.ogg"
    tianqin "이상해?"


translate japanese plot3_dd6a8491:



    voice "voice/keke_51.ogg"
    keke "이리 와서 해부하는 걸 보면 알아."


translate japanese plot3_bdd8a480:



    voice "voice/tianqin_670.ogg"
    tianqin "싫어, 안 볼래…… 냄새나."


translate japanese plot3_dd5bd676:



    voice "voice/keke_52.ogg"
    keke "괜찮아. 냄새 안 나게 처리해 놨어."


translate japanese plot3_4975ae24:


    "코코는 옆 생물 실험실에서 「빌린」 해부 도구를 일렬로 늘어놓았다."


translate japanese plot3_4733c4d5:



    voice "voice/keke_53.ogg"
    keke "자, 실험 시작할게."


translate japanese plot3_c366e77b:



    voice "voice/tianqin_671.ogg"
    tianqin "자, 잠깐! 그 흰쥐에 세균이나 바이러스 같은 건 없겠지?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_d26339f0:



    voice "voice/keke_54.ogg"
    keke "아…… 뭐, 아마…… 괜찮겠지."


translate japanese plot3_dbb20302:



    voice "voice/tianqin_672.ogg"
    tianqin "얼버무린 거지!?"


translate japanese plot3_6bc2d2a7:



    voice "voice/keke_55.ogg"
    keke "됐어. 소독은 제대로 했어."


translate japanese plot3_2640ad00:



    voice "voice/keke_56.ogg"
    keke "걱정되면 거기 알코올이라도 뿌려."


translate japanese plot3_edbcc0ef:



    voice "voice/tianqin_673.ogg"
    tianqin "으으…… 불안한데……"


translate japanese plot3_9f8e0877:


    "흰쥐는 해부대에 배를 드러낸 채 누워 있었고, 팔다리는 네 귀퉁이에 고정되어 있었다."


translate japanese plot3_2957f76d:


    "준비가 끝난 것을 확인한 코코는 능숙한 손길로 메스를 들어 흰쥐의 배를 갈랐다."


translate japanese plot3_985f64c5:



    voice "voice/tianqin_674.ogg"
    tianqin "으아아아악! 피비린내 나!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_b287d3a5:



    voice "voice/keke_57.ogg"
    keke "흠……"


translate japanese plot3_123d48be:


    "天琴が顔をしかめる一方、ココはまるで生物の{a=dictionary:dict_entry_50}実践授業{/a}を受けていたように、落ち着いて作業を続けた。"


translate japanese plot3_ef8730a9:



    voice "voice/tianqin_675.ogg"
    tianqin "왜 이런 걸 하는 거야?"


translate japanese plot3_86594542:



    voice "voice/keke_58.ogg"
    keke "호기심 때문이지."


translate japanese plot3_f40326a6:



    voice "voice/keke_59.ogg"
    keke "교과서에 나온 걸 실제로 해 보면 재미있지 않아?"


translate japanese plot3_be9d3310:



    voice "voice/tianqin_676.ogg"
    tianqin "전혀!"


translate japanese plot3_6d2b9d8e:



    voice "voice/keke_60.ogg"
    keke "음…… 역시 그렇네."


translate japanese plot3_661cb556:



    voice "voice/tianqin_677.ogg"
    tianqin "뭐, 뭐 찾았어?"


translate japanese plot3_fcf98ad8:



    voice "voice/keke_61.ogg"
    keke "이 쥐가 너무 가볍다 싶었더니 내장이 통째로 없어."


translate japanese plot3_2f7bcf95_1:



    voice "voice/tianqin_678.ogg"
    tianqin "뭐?"


translate japanese plot3_c5800b6d:


    "라이라가 해부대를 들여다보니 후배의 말대로 흰쥐의 복강은 텅 비어 있었다."


translate japanese plot3_d075304e:



    voice "voice/tianqin_679.ogg"
    tianqin "으, 잠깐…… 이게 어떻게 된 거야?"


translate japanese plot3_8ebb3dbd:



    voice "voice/keke_62.ogg"
    keke "내가 묻고 싶어."


translate japanese plot3_5bd46c28:



    voice "voice/keke_63.ogg"
    keke "게다가 겉에 상처도 없는데 어떻게 내장만 꺼낸 거지?"


translate japanese plot3_039a5dfa:



    voice "voice/keke_64.ogg"
    keke "그 츠루기가 흰쥐를 꺼냈을 때, 다른 이상한 일은 없었어?"


translate japanese plot3_aa15ff0f:



    voice "voice/tianqin_680.ogg"
    tianqin "없어. 다들 놀랐을 뿐이야."


translate japanese plot3_315ac956:



    voice "voice/keke_65.ogg"
    keke "흐음…… 이상하네. 내장만 사라지다니……"


translate japanese plot3_e74317cc:



    voice "voice/keke_66.ogg"
    keke "재미있어. 점점 더 흥미로워지는데."


translate japanese plot3_769ec83a:



    voice "voice/tianqin_681.ogg"
    tianqin "대체 뭐가 재미있다는 거야……"


translate japanese plot3_a2247bf6:


    "코코는 흰쥐를 표본으로 만들어 조심스럽게 포르말린에 담갔다. 이번 해부 실험에 무척 만족한 듯했다."


translate japanese plot3_e41b6f4e:


    "もちろん、これらは全部、彼女が教師の許可も取らず勝手にやったことだ。"


translate japanese plot3_513f8859:


    "교칙을 어기는 데에는 코코도 선배 못지않았다."


translate japanese plot3_ffbd5a3f:



    voice "voice/keke_67.ogg"
    keke "좋아, 완벽한 표본이야. 역시 천재인 나답네."


translate japanese plot3_98f73e98:



    voice "voice/keke_68.ogg"
    keke "대단하지? 멋있지? 천재 같지?"


translate japanese plot3_25f08696:



    voice "voice/tianqin_682.ogg"
    tianqin "……분명 선생님한테 혼날 거야."


translate japanese plot3_2a0483d8:



    voice "voice/keke_69.ogg"
    keke "내가 직접 만든 표본이라고? 선생님 것보다 분명 더 잘 만들었어."


translate japanese plot3_2a8b53d1:



    voice "voice/keke_70.ogg"
    keke "이렇게 완성도 높은 표본이면 오히려 수업 자료로 써서 고맙다고 하시겠지."


translate japanese plot3_12b12c30:



    voice "voice/tianqin_683.ogg"
    tianqin "휴우, 우등생의 특권이네."


translate japanese plot3_7f97d9c6:



    voice "voice/keke_71.ogg"
    keke "선배도 남 말 할 처지 아니거든? 성적 좋은 걸 믿고 맨날 땡땡이치면서."


translate japanese plot3_e6d5f686:



    voice "voice/tianqin_684.ogg"
    tianqin "아니거든! 나도 시험 전에는 열심히 공부해!"


translate japanese plot3_a11ab799:



    voice "voice/keke_72.ogg"
    keke "저기, 선배."


translate japanese plot3_eb0437bf:



    voice "voice/keke_73.ogg"
    keke "이 학교 애들 대부분은 선배보다 훨씬 열심히 공부해."


translate japanese plot3_2cacd38e:



    voice "voice/keke_74.ogg"
    keke "그 재능을 함부로 낭비하면 미움받는다고?"


translate japanese plot3_8b897bed:



    voice "voice/keke_75.ogg"
    keke "애초에 공부는 결국 재능과……"


translate japanese plot3_cd2b1142:



    voice "voice/tianqin_685.ogg"
    tianqin "알았어, 알았어! 잔소리 그만!"


translate japanese plot3_f5172498:


    "수업 종이 울렸다."


translate japanese plot3_73f8b646:



    voice "voice/tianqin_686.ogg"
    tianqin "아, 돌아가야겠다."


translate japanese plot3_ff53d0da:



    voice "voice/keke_76.ogg"
    keke "웬일이야. 선배가 스스로 다음 수업에 들어가다니."


translate japanese plot3_0cfa71b7:



    voice "voice/keke_77.ogg"
    keke "……설마 해부하는 거 보고 겁먹었어?"


translate japanese plot3_66c755a1:



    voice "voice/tianqin_687.ogg"
    tianqin "아니야! 다음은 수학이거든. 더 빠지면 담임 선생님한테 엄청 혼나."


translate japanese plot3_76cdc25a:



    voice "voice/keke_78.ogg"
    keke "하하, 꼴좋다."


translate japanese plot3_1c9faf5d:



    voice "voice/tianqin_688.ogg"
    tianqin "그럼 이따 봐. 수업 끝나면 올게."


translate japanese plot3_dbd31cfd:



    voice "voice/keke_79.ogg"
    keke "뭐!? 또 온다고?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_114030f3:


    "방과 후, 원예부."


translate japanese plot3_1c7c6cbf:



    voice "voice/tianqin_689.ogg"
    tianqin "좋아! 씨앗 다 뿌렸어."


translate japanese plot3_5e319760:



    voice "voice/xiaoxia_84.ogg"
    xiaoxia "라이라 씨가 도와주시니까 정말 빠르네요."


translate japanese plot3_8f9f8c77:



    voice "voice/tianqin_690.ogg"
    tianqin "헤헤, 별거 아니야."


translate japanese plot3_2f1430d0:



    voice "voice/tianqin_691.ogg"
    tianqin "아, 오늘은 반장도 왔네."


translate japanese plot3_807b4753:



    voice "voice/banzhang_47.ogg"
    banzhang "네. 오늘은 체육 특기생 쉬는 날이라서,"


translate japanese plot3_6de9b171:



    voice "voice/banzhang_48.ogg"
    banzhang "저도 도우러 왔어요."


translate japanese plot3_88fc12f6:



    voice "voice/yangxi_219.ogg"
    yangxi "하아…… 왜 나까지……"


translate japanese plot3_c2e51346:



    voice "voice/banzhang_49.ogg"
    banzhang "히나타 씨도 수고 많으세요."


translate japanese plot3_fbdc4ebc:


    "반장은 익숙한 손길로 괭이를 움직이며 라이라가 어제 갈아 놓은 땅을 넓혀 갔다."


translate japanese plot3_8c568ff3:


    "힘으로만 휘두르는 라이라와 달리, 반장은 힘을 거의 들이지 않고도 흙을 깔끔하게 뒤집었다."


translate japanese plot3_7821f25c:



    voice "voice/tianqin_692.ogg"
    tianqin "역시 반장이네. 나보다 훨씬 빠르다."


translate japanese plot3_3e3f5c6a:



    voice "voice/banzhang_50.ogg"
    banzhang "익숙해지면 누구나 할 수 있어요."


translate japanese plot3_0f116717:



    voice "voice/banzhang_51.ogg"
    banzhang "그보다 어제 도와주러 와 주셔서 고마워요."


translate japanese plot3_a352d170:



    voice "voice/tianqin_693.ogg"
    tianqin "아냐, 신경 쓰지 마～ 나랑 히나타는 어차피 한가했는걸～"


translate japanese plot3_f1824a1c:



    voice "voice/tianqin_694.ogg"
    tianqin "게다가 난 거의 힘으로만 파서 제대로 했는지도 모르겠어."


translate japanese plot3_43b47282:



    voice "voice/banzhang_52.ogg"
    banzhang "아니에요. 정말 도움이 됐어요!"


translate japanese plot3_3babccb3:



    voice "voice/banzhang_53.ogg"
    banzhang "라이라 씨는 정말 체력이 좋으시네요. 괭이를 제대로 휘두르지도 못하는 사람이 많은데, 처음부터 그렇게 많이 갈다니."


translate japanese plot3_cfe2b5b6:



    voice "voice/tianqin_695.ogg"
    tianqin "힘 하나는 자신 있으니까."


translate japanese plot3_5939a361:



    voice "voice/tianqin_696.ogg"
    tianqin "아, 그런데 반장이 괭이 들고 있는 건 좀 신선하다."


translate japanese plot3_72d567ee:



    voice "voice/banzhang_54.ogg"
    banzhang "어? 왜요?"


translate japanese plot3_44e0677d:



    voice "voice/tianqin_697.ogg"
    tianqin "えっと、その……委員長って、普段はおしとやかなイメージだったから？"


translate japanese plot3_b4266a65:



    voice "voice/banzhang_55.ogg"
    banzhang "얌전하다니……"


translate japanese plot3_74fff21b:



    voice "voice/banzhang_56.ogg"
    banzhang "오히려 저는 언제나 활기찬 라이라 씨가 부러워요."


translate japanese plot3_c63829d0:



    voice "voice/tianqin_698.ogg"
    tianqin "그런가? 헤헤."


translate japanese plot3_a5552229:



    voice "voice/yangxi_220.ogg"
    yangxi2 0104 "야! 거기 둘!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_f210252b:



    voice "voice/yangxi_221.ogg"
    yangxi2 "농땡이 피우지 말고 와서 도와줘!"


translate japanese plot3_94d6b24e:



    voice "voice/banzhang_57.ogg"
    banzhang "어머, 히나타 씨한테 들켰네요."


translate japanese plot3_a3775f1d:



    voice "voice/tianqin_699.ogg"
    tianqin "도와주러 가자."


translate japanese plot3_f28a735c:



    voice "voice/xiaoxia_85.ogg"
    xiaoxia "반장님, 점심때 관리인분이 쥐 잡으러 오셨어요."


translate japanese plot3_c23d3af5:



    voice "voice/xiaoxia_86.ogg"
    xiaoxia "흰쥐 문제는 이제 괜찮을 것 같아요."


translate japanese plot3_5cae557e:



    voice "voice/banzhang_58.ogg"
    banzhang "그래요…… 다행이네요."


translate japanese plot3_253d556b:



    voice "voice/tianqin_700.ogg"
    tianqin "쥐는 정말 무섭구나……"


translate japanese plot3_7960eaf7:



    voice "voice/yangxi_222.ogg"
    yangxi "원예부에는 확실히 천적이지."


translate japanese plot3_71e08e60_2:



    voice "voice/tianqin_701.ogg"
    tianqin "……"


translate japanese plot3_a2a87910:


    "흰쥐 이야기를 하자 라이라는 아침의 장난이 떠오를 수밖에 없었다."


translate japanese plot3_5b177068:



    voice "voice/tianqin_702.ogg"
    tianqin "（……츠루기는 지금 어떨까……）"


translate japanese plot3_3ec32e6a:



    voice "voice/hecheng_42.ogg"
    hecheng2 "야, 반장 있어?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_c6cb0336:



    voice "voice/hecheng_43.ogg"
    hecheng "……어, 너희가 왜 여기 있어?"


translate japanese plot3_13484178:



    voice "voice/tianqin_703.ogg"
    tianqin "어, 츠루기!?"


translate japanese plot3_95307794:


    "마침 생각하던 사람이 갑자기 나타나자 라이라는 놀랐다."


translate japanese plot3_8b565027:



    voice "voice/hecheng_44.ogg"
    hecheng "라이라랑 히나타에…… 원예부? 별난 조합이네."


translate japanese plot3_d3196e52:



    voice "voice/tianqin_704.ogg"
    tianqin "아, 오늘 원예부 일 도와주러 왔어."


translate japanese plot3_b3fc1a89:



    voice "voice/tianqin_705.ogg"
    tianqin "츠루기, 저기…… 괜찮아?"


translate japanese plot3_c817fb4e:



    voice "voice/hecheng_45.ogg"
    hecheng "뭐가?"


translate japanese plot3_840c066c:



    voice "voice/tianqin_706.ogg"
    tianqin "아침에, 그……"


translate japanese plot3_10916c08:



    voice "voice/hecheng_46.ogg"
    hecheng "아, 그 시시한 장난?"


translate japanese plot3_66006e69:



    voice "voice/hecheng_47.ogg"
    hecheng "별거 아니야. 전혀 신경 안 써."


translate japanese plot3_0b7f30b4:



    voice "voice/yangxi_223.ogg"
    yangxi "（……완전히 센 척이네.）"


translate japanese plot3_6333f0ac:



    voice "voice/tianqin_707.ogg"
    tianqin "다행이다. 괜찮다니 정말 다행이야."


translate japanese plot3_24fa8d6c:



    voice "voice/hecheng_48.ogg"
    hecheng "나 그렇게 약하지 않아."


translate japanese plot3_b178020f:



    voice "voice/hecheng_49.ogg"
    hecheng "그보다 반장 있어?"


translate japanese plot3_076a4d00:



    voice "voice/banzhang_59.ogg"
    banzhang "츠루기 씨, 여기 있어요……"


translate japanese plot3_ee2e4ef2:



    voice "voice/hecheng_50.ogg"
    hecheng "잘됐다. 같이 가 줄래? 김 선생님이 훈련 얘기 좀 상의하자고 부르셔."


translate japanese plot3_37b78a15:



    voice "voice/banzhang_60.ogg"
    banzhang "네."


translate japanese plot3_01988f15:



    voice "voice/banzhang_61.ogg"
    banzhang "……죄송하지만 아직 일이 조금 남아서요. 라이라 씨, 히나타 씨, 부탁해도 될까요?"


translate japanese plot3_f7a7a1f1:



    voice "voice/tianqin_708.ogg"
    tianqin "맡겨 둬! 반장은 체육 쪽 일 잘 보고 와!"


translate japanese plot3_c42e3b07:


    "시노스는 하루 종일 찾아다닌 끝에 겨우 집으로 돌아왔다."


translate japanese plot3_936c4298_11:



    voice "voice/cygnus_420.ogg"
    cygnus "……"


translate japanese plot3_df65818b:



    voice "voice/cygnus_421.ogg"
    cygnus "（결국 아무것도 못 찾았어…… 마도구도, 마법 술식의 흔적조차도……）"


translate japanese plot3_495d84a1:



    voice "voice/cygnus_422.ogg"
    cygnus "（단서가 하나도 없다니……）"


translate japanese plot3_7baf5a48:


    "天琴が言っていた通りをくまなく歩き回り、さらに周囲の道も調べた。だが、どこにも魔力の気配は感じられなかった。"


translate japanese plot3_6fdc0e44:



    voice "voice/cygnus_423.ogg"
    cygnus "（……뭘 놓친 걸까?）"


translate japanese plot3_a0d2fb22:



    voice "voice/cygnus_424.ogg"
    cygnus "（「나」의 평소 사고방식대로 다시 한번 생각해 봐.）"
































translate japanese plot3_85e755b1:



    voice "voice/cygnus_425.ogg"
    cygnus "젠장……"


translate japanese plot3_a2094ce4:



    voice "voice/cygnus_426.ogg"
    cygnus "노리! 어디 있어?"


translate japanese plot3_1c1ab816:


    "불러 봐도 사역마는 대답하지 않았다."


translate japanese plot3_feb7284f:



    voice "voice/cygnus_427.ogg"
    cygnus "……마력이 부족해서 휴면 중인가."


translate japanese plot3_6d4fdf67:



    voice "voice/tianqin_709.ogg"
    tianqin "다녀왔어—"


translate japanese plot3_936c4298_23:



    voice "voice/cygnus_428.ogg"
    cygnus "……"


translate japanese plot3_77a5193d:



    voice "voice/tianqin_710.ogg"
    tianqin "어, 시노스. 안색이 안 좋은데?"


translate japanese plot3_983069bd:



    voice "voice/tianqin_711.ogg"
    tianqin "우리 만났던 곳은 찾았어?"


translate japanese plot3_48e68375:


    "シノスは答えず、わずかに身じろぎして、天琴に思考を邪魔されないよう、少し距離を取った。"


translate japanese plot3_958ee775:



    voice "voice/tianqin_712.ogg"
    tianqin "아, 잘 안됐나 보네."


translate japanese plot3_d1080446:



    voice "voice/tianqin_713.ogg"
    tianqin "좋아! 이럴 때는 내가 기운 나는 밥을 만들어 줄게!"


translate japanese plot3_936c4298_24:



    voice "voice/cygnus_429.ogg"
    cygnus "……"


translate japanese plot3_2c89c5fd:


    "마녀는 여전히 시끄러운 여고생을 무시했다."


translate japanese plot3_0321a4fa:


    "그녀는 필사적으로 생각하며 기억을 더듬고 있었다."


translate japanese plot3_aa1c1e51:


    "「기억」이라는 바다에서 무언가 건져 올리려는 것처럼——"


translate japanese plot3_ef91d865:



    voice "voice/tianqin_714.ogg"
    tianqin 0116 "다 됐어—!"


translate japanese plot3_58925231:



    voice "voice/cygnus_430.ogg"
    cygnus 0104 "으아아!?"


translate japanese plot3_451e7174:


    "시노스는 전혀 예상하지 못했다. 라이라가 달려오더니, 아이를 번쩍 들어 올려 주듯 자신을 안아 높이 치켜든 것이다."


translate japanese plot3_8f6e5e0b:


    "생각에 잠겨 완전히 방심하던 시노스는 평소답지 않은 비명을 지르고 말았다."


translate japanese plot3_8ad5a7e0:



    voice "voice/tianqin_715.ogg"
    tianqin 0104 "날아라, 날아라～!"


translate japanese plot3_6c376a39:



    voice "voice/cygnus_431.ogg"
    cygnus 0105 "빨리 내려 줘!"


translate japanese plot3_9cb108e6:



    voice "voice/tianqin_716.ogg"
    tianqin 0105 "알았어, 알았어～"


translate japanese plot3_ff795980:


    "라이라는 더 장난치지 않고 시노스를 소파에 살며시 내려놓았다."


translate japanese plot3_5b7e8b38:



    voice "voice/cygnus_432.ogg"
    cygnus "하아…… 뭐 하는 거야."


translate japanese plot3_e4508c37:



    voice "voice/tianqin_717.ogg"
    tianqin "계속 인상을 쓰고 있길래. 조금이라도 기분 전환이 되면 좋겠다 싶어서."


translate japanese plot3_78139313:



    voice "voice/tianqin_718.ogg"
    tianqin "게다가 지금 잘 안 풀려도 어떻게든 될 거야. 걱정하지 않아도 돼."


translate japanese plot3_9eb0aefe:



    voice "voice/cygnus_433.ogg"
    cygnus "……넌 몰라."


translate japanese plot3_3a574d18:


    "지금의 시노스에게는 라이라의 낙천적인 태도가 아프게 와닿았다."


translate japanese plot3_a29da0b6:


    "가슴속에 쌓인 의문과 불안, 초조함이 점점 부풀어 올랐다."


translate japanese plot3_6ce1b4cd:


    "이성적이고 비관적인 그녀의 사고방식으로는 라이라의 낙관적인 말을 순순히 받아들일 수 없었다."


translate japanese plot3_f94cca6c:



    voice "voice/tianqin_719.ogg"
    tianqin "내가 있잖아. 도와줄게."


translate japanese plot3_3581b64e:



    voice "voice/cygnus_434.ogg"
    cygnus "장난하지 마! 네가 뭘 할 수 있는데!?" with Shake((0, 0, 0, 0), 0.5, dist=8)


translate japanese plot3_39b2aa2a:


    "그 말을 듣자 시노스는 저도 모르게 목소리를 높였다. 팽팽하게 억눌렸던 감정이 한꺼번에 쏟아져 나왔다."


translate japanese plot3_83f2da80:



    voice "voice/cygnus_435.ogg"
    cygnus "아……"


translate japanese plot3_937cac54:


    "말이 나오자마자 시노스는 후회했다."


translate japanese plot3_e53dcbd7:



    voice "voice/cygnus_436.ogg"
    cygnus "아니…… 미안해. 그런 뜻은……"


translate japanese plot3_e20914b1:



    voice "voice/cygnus_437.ogg"
    cygnus "미안해……"


translate japanese plot3_4407c075:


    "シノスはそっと顔を背け、天琴の表情を見る勇気が出なかった。"


translate japanese plot3_d7a424ad:


    "쌓이고 쌓인 압박을 마침내 버티지 못하고 무너진 것이었다."


translate japanese plot3_3f5ba0e0:


    "하지만 무슨 이유가 있든 라이라에게 감정을 쏟아부어서는 안 됐다."


translate japanese plot3_ce86ed07:


    "라이라가 도와주지 않았다면 지금쯤 어떻게 되었을지도 모르는데."


translate japanese plot3_9b896771:



    voice "voice/tianqin_720.ogg"
    tianqin "괜찮아, 시노스. 화 안 났어."


translate japanese plot3_32af16b1:



    voice "voice/tianqin_721.ogg"
    tianqin "응? 이쪽 좀 봐."


translate japanese plot3_07334f18:



    voice "voice/cygnus_438.ogg"
    cygnus "미안해…… 저기, 아까는 그만……"


translate japanese plot3_68d646bf:



    voice "voice/cygnus_439.ogg"
    cygnus "하면 안 될 말을……"


translate japanese plot3_3d8bd255:


    "차가운 태도를 유지하려던 마녀는 이제 무슨 말을 해야 할지도 몰랐다."


translate japanese plot3_6fad2afb:


    "もともと人付き合いが得意ではない彼女は、言えば言うほど状況を悪くしてしまう気がしてならなかった。"


translate japanese plot3_7040b368:



    voice "voice/tianqin_722.ogg"
    tianqin "아니야, 시노스 말이 맞아."


translate japanese plot3_3de774f8:



    voice "voice/tianqin_723.ogg"
    tianqin "난 마법이니 마나니 하나도 모르고, 정말 아무것도 못 하잖아."


translate japanese plot3_ae23c204:



    voice "voice/tianqin_724.ogg"
    tianqin "하지만 이 세계에 익숙해지는 것도, 힘을 되찾는 것도, 나라도 괜찮다면 최대한 도와줄게."


translate japanese plot3_bd3d1b31:



    voice "voice/tianqin_725.ogg"
    tianqin "그냥 시노스가 그렇게 혼자 끙끙 앓지 않았으면 좋겠어. 스스로를 너무 억누르지 말고."


translate japanese plot3_7c995da9:



    voice "voice/tianqin_726.ogg"
    tianqin "흔히 그러잖아? ‘어려움보다 해결 방법이 더 많다’고."


translate japanese plot3_9a518cfc:



    voice "voice/cygnus_440.ogg"
    cygnus "나는……"


translate japanese plot3_02543538:


    "말이 목에 걸렸다. 심하게 아픈 것 같았다."


translate japanese plot3_e7b77048:


    "天琴の何気ない言葉が、ふいに記憶の底に触れた気がした。"


translate japanese plot3_6c69fa29:


    "이제는 희미하게만 떠오르는 기억 조각 속에서, 누군가 같은 말을 해 주었던 것 같았다."


translate japanese plot3_f3d89084:



    voice "voice/tianqin_727.ogg"
    tianqin "어, 잠깐, 어? 내가 뭐 이상한 말 했어?"


translate japanese plot3_69807667:


    "시노스의 눈에 눈물이 맺히자 라이라도 당황했다."


translate japanese plot3_b092f711:


    "마녀는 생각보다 눈물이 많은 모양이었다."


translate japanese plot3_74b5091b:



    voice "voice/cygnus_441.ogg"
    cygnus "아니…… 나는……"



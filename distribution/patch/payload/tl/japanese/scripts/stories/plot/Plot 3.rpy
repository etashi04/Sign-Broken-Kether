    voice "voice/blackcat_02.ogg"
    blackcat "안 물어봤잖아!? 냐아아아아아아—!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_e3b91ea7:



    voice "voice/cygnus_386.ogg"
    cygnus "라이라, 나를 처음 만났을 때 근처에 특이한 물건이 있었어?"


translate japanese plot3_42324d65:



    voice "voice/tianqin_608.ogg"
    tianqin "으음? 딱히 없었는데…… 시노스 혼자 있었을걸……"



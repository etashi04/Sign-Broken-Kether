translate japanese plot3_7bc1a5bc:



    voice "voice/flame_09.ogg"
    ataset "こんな波動、【あの子｜アサヨ】に気づかれたら……次は本当に戦うことになるよ？"


translate japanese plot3_3e909194:



    voice "voice/hunter_13.ogg"
    monolith "心配ないわ。この程度の揺らぎ……あの「大魔女」に気取られるはずがない。"


translate japanese plot3_4dc4eeae:



    voice "voice/flame_10.ogg"
    ataset "やれやれ、そういうとこが自信家なんだよねぇ。"


translate japanese plot3_0060939b:


    "不意に、黒の魔女は仲間の体から妙な香りを嗅ぎ取った。"


translate japanese plot3_eb5a0c19:



    voice "voice/hunter_14.ogg"
    monolith "……どこへ行ってた？"


translate japanese plot3_753f416c:



    voice "voice/flame_11.ogg"
    ataset "向かいの銭湯だよ～。"


translate japanese plot3_89893bb6:



    voice "voice/flame_12.ogg"
    ataset "いやさ、この世界の風呂ってさ――"


translate japanese plot3_31ae87b0:



    voice "voice/hunter_15.ogg"
    monolith "ちょっと待って。バレてないよね？"


translate japanese plot3_ff92e8b5:


    "感嘆を始める前に、黑の魔女はピシャリと遮る。"


translate japanese plot3_11348eff:



    voice "voice/flame_13.ogg"
    ataset "もう、そんなヘマしないってば。"


translate japanese plot3_0afcd62c:



    voice "voice/hunter_16.ogg"
    monolith "はぁ……"


translate japanese plot3_24408daa:


    "黑之魔女は小さく嘆息し、再び先集まった情報へ没頭した。"


translate japanese plot3_648830ce:


    "価値のある情報を選り分けていくが、ただ一つ、目的の情報だけがどこにもない。"


translate japanese plot3_59e59da8:



    voice "voice/hunter_17.ogg"
    monolith "（……本当に巧みに隠れるわね、「【大魔女｜アサヨ】」。）"


translate japanese plot3_a4d0da8d:



    voice "voice/hunter_18.ogg"
    monolith "（でも舞台はもうすぐ整う。逃げたくても無駄だ。）"


translate japanese plot3_b00a3aab:



    voice "voice/hunter_19.ogg"
    monolith "（その時は、私を退屈させないでちょうだい。）"


translate japanese plot3_b2c38083:


    "플레이해 주셔서 감사합니다. 데모 버전은 여기까지입니다."


translate japanese plot3_9b36f831:


    "하지만 시노스와 라이라의 이야기는 이제 막 시작되었습니다."


translate japanese plot3_82edfa6b:


    "화면 중앙에 나타나는 「노리」를 클릭하여,{p}이 게임을 찜 목록에 추가해 주시면 감사하겠습니다."


translate japanese plot3_9080bdc9:


    "여러분의 응원은 제작에 큰 힘이 되며, 다음에 만나게 될 이야기를 더 멋지게 만들어 줍니다."


translate japanese plot3_a425d601:


    "『Sign: Broken Kether』의 후속 내용은 현재 열심히 제작 중입니다. 변함없는 성원에 진심으로 감사드립니다."



translate japanese plot3_00b302ef:



    voice "voice/yangxi_143.ogg"
    yangxi "신고라도 당하면 {a=dictionary:dict_entry_30}감금죄{/a}로 취급될 거라고……"


translate japanese plot3_48d99beb:



    voice "voice/tianqin_500.ogg"
    tianqin "음—— 아마도? 가출이랑 비슷하다고 해야 하나?"


translate japanese plot3_aa543190:



    voice "voice/cygnus_248.ogg"
    cygnus "{size=42}하——{w=0.5}하취——!{/size}" (what_slow_cps=0)


translate japanese plot3_6a09ce8a:



    voice "voice/cygnus_250.ogg"
    cygnus "……응, {a=dictionary:dict_entry_31}길 찾기 마법{/a}은 제대로 작동하고 있어."


translate japanese plot3_16fff116:


    "하지만 아직 교통수단을 이용하기는 어려웠으므로 시노스는 무리하지 않고 중앙 공원까지 걸어가기로 했다."


translate japanese plot3_f46749d3:



    voice "voice/cygnus_263.ogg"
    cygnus "지하를 달리는 열차…… {a=dictionary:dict_entry_32}마도열차{/a} 같은 걸까?"


translate japanese plot3_90cefbb3:


    "「열차」는 드물게 두 세계에 공통으로 쓰이는 말이었다."


translate japanese plot3_77ee6616:


    "다만 시노스의 세계에서는 「교통수단」이 아니라, {a=dictionary:dict_entry_33}고대 마도제국{/a}이 땅속 깊이 남긴 「유적」의 이름이었다."


translate japanese plot3_c041cfcc:


    "그런데도 마법 협회가 각지에 설치한 전이 마법진은 협회의 주요 수입원이었다."


translate japanese plot3_d41d8cd9:


    voice "voice/cygnus_268.ogg"


translate japanese plot3_d1a815be:



    voice "voice/cygnus_274.ogg"
    cygnus "아무도 못 본 것 같네. 그럼 {a=dictionary:dict_entry_34}투명화 마법{/a}을 쓸 필요도 없었잖아…… 마력 낭비야……"


translate japanese plot3_d94149a9:


    "연결된 순간 시노스의 마력은 거목 전체를 돌았고, 찾던 정보도 곧바로 얻을 수 있었다."


translate japanese plot3_d517c0b9:


    "이 거목 내부에도 이 세계의 다른 모든 것처럼 {a=dictionary:dict_entry_35}마력의 흐름{/a}이 전혀 없었다."


translate japanese plot3_ec6c7087:



    voice "voice/hunter_04.ogg"
    monolith_ns "역시 {a=dictionary:dict_entry_36}「대마녀」{/a}야. 위험을 감지하는 감각이 너무 예리해."


translate japanese plot3_b92b2952:



    voice "voice/hunter_05.ogg"
    monolith_ns "안 돼. 아직 마도구를 못 찾았어."


translate japanese plot3_86f03e07:


    "학생들의 체력을 키우기 위해 체육이 정식 주요 과목이 되었고, 고교 통합 시험에서도 큰 비중을 차지했다."


translate japanese plot3_d41d8cd9_1:


    voice "voice/banzhang_44.ogg"


translate japanese plot3_241f0f0a:


    "라이라가 괭이를 휘두를 때마다 단단하게 굳은 흙이 모래처럼 손쉽게 파헤쳐졌다."


translate japanese plot3_d8c780d2:


    "조금 떨어진 화단 끝에서, 새하얗고 어딘가 섬뜩한 쥐가 이쪽을 빤히 바라봤다."


translate japanese plot3_3a91945e:



    voice "voice/tianqin_541.ogg"
    tianqin "우와…… 저 쥐, 꽤 컸네."


translate japanese plot3_63a73498:



    voice "voice/yangxi_178.ogg"
    yangxi "게다가 {a=dictionary:dict_entry_37}흰쥐{/a}라니…… 드문데."


translate japanese plot3_ad354094:



    voice "voice/yangxi_193.ogg"
    yangxi "드디어 어제처럼 햄스터같이 얼어붙지는 않았네."


translate japanese plot3_3d168d85:



    voice "voice/cygnus_288.ogg"
    cygnus 0104 "한순간…… 아주 잠깐 마력의 흐름이 느껴졌어."


translate japanese plot3_0c2f6eab:



    voice "voice/cygnus_303.ogg"
    cygnus "（마법의 이치를 연구하는 게 마녀 공통의 「취미」이자 생계 수단이라면.）"


translate japanese plot3_8f1b7148:



    voice "voice/cygnus_304.ogg"
    cygnus "（……「취미」를 본업으로 삼는 데는 괴로움과 기쁨이 함께 따르는 법이지.）"


translate japanese plot3_38a9e85b:



    voice "voice/tianqin_575.ogg"
    tianqin "저, 저녁 준비해야겠다…… 시노스, 점심은 먹었어?"


translate japanese plot3_49ac72fc:



    voice "voice/cygnus_306.ogg"
    cygnus "남겨 준 양이 너무 많아서 다 먹지는 못했어."


translate japanese plot3_462dd0e1:



    voice "voice/cygnus_315.ogg"
    cygnus "내 힘의 근원인 {a=dictionary:dict_entry_38}마도서{/a}야."


translate japanese plot3_999ef0d9:


    "시노스의 말에는 나름 무게가 있었지만, 식탁 위의 책은 그 말을 뒷받침할 만한 물건으로 보이지 않았다."


translate japanese plot3_129b13e7:



    voice "voice/cygnus_328.ogg"
    cygnus "（며칠 동안 「마나 진공」 환경에 있던 몸은 분명 그렇게 많은 마력에 적응하지 못할 거야. {a=dictionary:dict_entry_39}「마나 멀미」{/a}는 피할 수 없겠네.）"


translate japanese plot3_c0a73bab:



    voice "voice/cygnus_329.ogg"
    cygnus "（최악의 경우 {a=dictionary:dict_entry_40}「마력 쇼크」{/a}도 가능해.）"


translate japanese plot3_1648e663:


    "마력이 흘러들 때마다 마도서는 더욱 밝은 은빛을 뿜었다. 시노스 자신의 마력 색이었다."


translate japanese plot3_de79abf7:



    voice "voice/tianqin_595.ogg"
    tianqin "어, 어? 잠깐만?"


translate japanese plot3_c65bd2ac:



    voice "voice/cygnus_363.ogg"
    cygnus "자, 말해. 내가 무슨 지시를 했지?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_e511446e:



    voice "voice/blackcat_13.ogg"
    blackcat "아니, 그건 아니지. 네가 쓴 건 한 세계에서 다른 세계로 표류하는 마법이라고? 부작용이 있는 게 당연해."


translate japanese plot3_7fcfbb82:



    voice "voice/blackcat_06.ogg"
    blackcat "그래서 넌 마력을 네 개의 {a=dictionary:dict_entry_41}마도구{/a}에 나눠 담고, 시간차를 둔 표류 마법으로 차례대로 보내는 아주 대담한 방법을 생각해 낸 거야."


translate japanese plot3_6712b00b:



    voice "voice/blackcat_14.ogg"
    blackcat "뭐든 물어봐! 뭐든 대답할게!"


translate japanese plot3_1d200891:



    voice "voice/cygnus_389.ogg"
    cygnus "……역시 표류 마법에 문제가 있었구나."


translate japanese plot3_d41d8cd9_2:


    voice "voice/cygnus_395.ogg"


translate japanese plot3_df096fe2:


    cygnus 0110 "（그리고…… 그 거목도.）"


translate japanese plot3_9ca44934:



    voice "voice/cygnus_397.ogg"
    cygnus "（생각해 봤자 소용없어. 지금은 우선 마도구를 되찾아야 해.）"


translate japanese plot3_0294a72d:


    "수업 시작까지 두 시간. 히나타는 그동안 남은 숙제를 끝낼 생각이었다."


translate japanese plot3_798adee7:


    "또래들이 중학교에 다닐 때 히나타는 이미 고등학교 수준의 내용을 익혔다."


translate japanese plot3_76d536aa:



    voice "voice/npc6_03.ogg"
    npc6 "야, 이상한 냄새 안 나?"


translate japanese plot3_7d22f86f:



    voice "voice/tianqin_634.ogg"
    tianqin "집이 학교 근처거든. 있잖아, 학교 바로 옆의 고급 주택가."


translate japanese plot3_65f1e8db_2:



    voice "voice/hecheng_39.ogg"
    hecheng "……"


translate japanese plot3_6ffcc2bc:


    "아무도 말을 걸지 못했다. 도와주려는 사람도 없었다. 공기는 얼어붙은 채였다."


translate japanese plot3_ea1039f6:



    voice "voice/tianqin_644.ogg"
    tianqin "어?"


translate japanese plot3_165dd686:


    "그녀가 나가자 교실은 순식간에 웅성거리기 시작했다."


translate japanese plot3_1ccf78f5:


    "말을 알아들은 듯 자오쯔는 서글프게 공을 물고 터덜터덜 멀어졌다."


translate japanese plot3_3582f024:


    "반 안의 대립은 그 어느 때보다 험악해져 갔다."


translate japanese plot3_8f33c54e:



    voice "voice/tianqin_660.ogg"
    tianqin "{a=dictionary:dict_entry_42}「영원한 단짝」{/a}이라니…… 몇 년 만에 듣네. 그거 한물간 말이잖아."


translate japanese plot3_efd745d6:



    voice "voice/keke_40.ogg"
    keke "선배한테 그런 말 듣고 싶지 않아!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_69c8cdc6:


    "라이라가 얼굴을 찌푸리는 동안, 코코는 생물 {a=dictionary:dict_entry_43}실습 수업{/a}이라도 듣는 듯 차분히 작업을 이어갔다."


translate japanese plot3_87ba51ec:


    "물론 전부 선생님 허락도 받지 않고 제멋대로 한 일이었다."


translate japanese plot3_66502084:



    voice "voice/tianqin_697.ogg"
    tianqin "음, 그게…… 반장은 평소에 얌전한 이미지라서?"


translate japanese plot3_e8aa7330:


    "라이라가 알려 준 거리를 샅샅이 걷고 주변 길까지 살폈지만, 어디에서도 마력의 기척은 없었다."


translate japanese plot3_936c4298_12:



    voice "voice/cygnus_428.ogg"
    cygnus "……"


translate japanese plot3_882f5fb7:


    "시노스는 대답하지 않았다. 생각을 방해받고 싶지 않아 몸을 살짝 움직여 라이라와 거리를 벌렸다."


translate japanese plot3_936c4298_13:



    voice "voice/cygnus_429.ogg"
    cygnus "……"


translate japanese plot3_456ccc49:


    "시노스는 조용히 고개를 돌렸다. 라이라의 표정을 볼 용기가 나지 않았다."


translate japanese plot3_6307089c:


    "원래 사람을 대하는 데 서툰 그녀는 말을 할수록 상황을 더 망칠 것만 같았다."


translate japanese plot3_f3be3c18:


    "라이라의 무심한 말이 문득 기억의 바닥에 닿은 듯했다."


translate japanese plot3_06b2814e:


    "집에서 가장 작은 방 안에서, 시노스는 왠지 마음을 놓을 수 있었다."


translate japanese plot3_174fdf5f:


    "목 안에서 아주 작은 흐느낌이 새어 나왔다. 라이라에게 들키지 않으려고 필사적으로 눌러 참았다."


translate japanese plot3_936c4298_15:



    voice "voice/cygnus_445.ogg"
    cygnus "……"


translate japanese plot3_1925f3a5:


    "밖에서 들려온 라이라의 말에 모처럼의 조용한 생각이 단번에 날아갔다."


translate japanese plot3_5d8c51d8:


    "온수기에서 데워진 물이 샤워기에서 따뜻한 안개처럼 쏟아졌다."


translate japanese plot3_68db3e3e:


    "그 기쁨은 얼마 전 「컴퓨터」를 사용했을 때에 못지않았다."


translate japanese plot3_e301e250:



    voice "voice/cygnus_69.ogg"
    cygnus 0306 "……"


translate japanese plot3_1950b18a:



    voice "voice/cygnus_474.ogg"
    cygnus 0306 "……응?"


translate japanese plot3_48e03dfa:


    "며칠 동안 라이라가 계속 이렇게 돌봐 주었기 때문이다."


translate japanese plot3_e301e250_1:



    voice "voice/cygnus_475.ogg"
    cygnus 0306 "……"


translate japanese plot3_47d2cf78:


    "기억의 바다 깊숙한 곳에서, 몸을 씻을 때면 곁에 분명 이런 사람이 있었던 것 같았다."


translate japanese plot3_44717bd3:



    voice "voice/hunter_31.ogg"
    monolith "들어가자."


translate japanese plot3_2eda0a55:



    voice "voice/hunter_32.ogg"
    monolith "여기가 이 세계에서 쓰는 내 공방이야."


translate japanese plot3_47fbfb27:



    voice "voice/flame_20.ogg"
    ataset "와～ 공방이라기보다는 다람쥐 굴 같네."


translate japanese plot3_59a6bd7b:



    voice "voice/flame_21.ogg"
    ataset "어느 세계에 가도 리스의 공방은 늘 어질러져 있다니까."


translate japanese plot3_f44bf604:



    voice "voice/flame_22.ogg"
    ataset "（우물우물…）"


translate japanese plot3_db4f048c:



    voice "voice/hunter_33.ogg"
    monolith "살 수만 있으면 충분해. 마법의 이치 연구는 그다음이야."


translate japanese plot3_b69245a8:



    voice "voice/flame_23.ogg"
    ataset "다른 마녀가 들으면 기절하겠다."


translate japanese plot3_fce279e8:



    voice "voice/hunter_34.ogg"
    monolith "흥. 나와 마주치지 않기를 빌어야 할걸."


translate japanese plot3_f3fdeb8e:



    voice "voice/flame_24.ogg"
    ataset "아, 나 이 마도서 좋아하는데. 이렇게 바닥에 그냥 놓다니……"


translate japanese plot3_3255cd68:



    voice "voice/flame_25.ogg"
    ataset "아깝네……"


translate japanese plot3_f44bf604_1:



    voice "voice/flame_26.ogg"
    ataset "（우물우물…）"


translate japanese plot3_ba586155:



    voice "voice/hunter_35.ogg"
    monolith "뭘 먹는 거야? 아까부터 계속 씹고 있네."


translate japanese plot3_3132c50f:



    voice "voice/flame_27.ogg"
    ataset "아～ 삼색 경단이야."



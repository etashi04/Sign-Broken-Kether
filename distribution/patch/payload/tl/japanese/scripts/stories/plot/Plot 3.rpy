    voice "voice/tianqin_522.ogg"
    tianqin "헤헤, 이런 일이 의외로 적성에 맞나 봐."


translate japanese plot3_289a226a:



    voice "voice/tianqin_523.ogg"
    tianqin "그런데 원예부 활동 장소가 이런 데 있었다니."


translate japanese plot3_6e62b0f6:


    "아키나가 두 사람을 데려온 곳은 운동장 끝, 덤불에 가려진 인적 드문 구역이었다."


translate japanese plot3_6fa95170:


    "고등학교 3년 내내 달리기를 하다 입구를 스쳐 보는 게 전부인 학생이 대부분이었다. 안쪽에 원예부가 있을 거라고는 생각도 못 했다."


translate japanese plot3_97a61069:



    voice "voice/xiaoxia_36.ogg"
    xiaoxia "여기는 조용하고 다른 사람에게 방해도 안 되니까요……"


translate japanese plot3_043d57cc:



    voice "voice/xiaoxia_37.ogg"
    xiaoxia "게다가 빈 땅도 넓어서, 학교에서 여기서 활동해도 된다고 해 줬어요."


translate japanese plot3_e702bfb1:



    voice "voice/tianqin_524.ogg"
    tianqin "그럼 아키나가 부장이야?"


translate japanese plot3_f79e6219:



    voice "voice/xiaoxia_38.ogg"
    xiaoxia "아, 아니에요…… 원예부에는 부장이 없어요. 아직 정식 동아리가 아니라서요."


translate japanese plot3_91375a2b:



    voice "voice/xiaoxia_39.ogg"
    xiaoxia "그냥 같은 취미를 가진 사람들끼리 모여서 활동할 장소를 찾았을 뿐이라……"


translate japanese plot3_2171a721:



    voice "voice/yangxi_162.ogg"
    yangxi "물 가져왔어."


translate japanese plot3_d806c035:



    voice "voice/xiaoxia_40.ogg"
    xiaoxia "아, 고마워요, 히나타 씨."


translate japanese plot3_d2668e02:



    voice "voice/xiaoxia_41.ogg"
    xiaoxia "라이라 씨가 흙을 다 고르면 물을 한 번 주면 돼요."


translate japanese plot3_5d63eb4e:



    voice "voice/gt_02.ogg"
    npc14 "오케이!\n알겠어."



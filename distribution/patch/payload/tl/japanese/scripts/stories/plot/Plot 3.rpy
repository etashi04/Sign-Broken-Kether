


translate japanese plot3_148830e0:


    "다음 날, 교실."


translate japanese plot3_7350ec26:



    voice "voice/yangxi_141.ogg"
    yangxi "뭐? 그 애가 아직 네 집에 있다고?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_d5926aac:



    voice "voice/tianqin_498.ogg"
    tianqin "헤헤, 그렇게 화내지 마. 잠깐 재워 주는 것뿐이라니까."


translate japanese plot3_7181eedb:



    voice "voice/yangxi_142.ogg"
    yangxi "그러니까 더 문제지."


translate japanese plot3_1bf37bea:



    voice "voice/yangxi_143.ogg"
    yangxi "もし通報されたら、完全に{a=dictionary:dict_entry_37}監禁罪{/a}だよ……"


translate japanese plot3_7d1413dd:



    voice "voice/tianqin_499.ogg"
    tianqin "그럴 리 없어! 그렇게 심각한 일도 아니고, 그 애는 나쁜 애가 아니야."


translate japanese plot3_29305d95:



    voice "voice/yangxi_144.ogg"
    yangxi "네가 경계심이 너무 없는 거야……"


translate japanese plot3_cce0bea1:



    voice "voice/yangxi_145.ogg"
    yangxi "대체 무슨 상황인데? 가출했어?"


translate japanese plot3_ddadc72d:



    voice "voice/tianqin_500.ogg"
    tianqin "うーん……多分、家出みたいなもの……かな？"


translate japanese plot3_c0b31a58:



    voice "voice/yangxi_146.ogg"
    yangxi "「아마도」? 「비슷하다」?"


translate japanese plot3_b465797b:



    voice "voice/tianqin_501.ogg"
    tianqin "으으…… 뭐……"


translate japanese plot3_4cf68495:


    "라이라의 애매한 말에 히나타의 의심은 더 커졌다."


translate japanese plot3_e36201f1:


    "그렇다고 자신이 받아 준 소녀가 이세계에서 왔다고 말할 수도 없었다. 그러면 히나타는 틀림없이 라이라의 머리가 이상해졌다고 생각할 것이다."


translate japanese plot3_cdcfd9ad:



    voice "voice/tianqin_502.ogg"
    tianqin "뭐, 뭐, 잠깐만 있을 거니까! 괜찮아!"


translate japanese plot3_1a02d7d4:



    voice "voice/yangxi_147.ogg"
    yangxi "……제발 이상한 일에 휘말리지 마."


translate japanese plot3_64b9afb3:



    voice "voice/yangxi_148.ogg"
    yangxi "아니, 아니구나. 너한텐 휘말리는 게 「평소대로」인가."


translate japanese plot3_6515e99f:



    voice "voice/tianqin_503.ogg"
    tianqin "아니라니까! 내가 잘 알아서 할게!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot3_10301755:



    voice "voice/cygnus_248.ogg"
    cygnus "{size=42}へっくしゅんー！{/size}" with vpunch


translate japanese plot3_97b32a1b:



    voice "voice/cygnus_249.ogg"
    cygnus "뭐지? 이 모습으로도 감기에 걸리다니……"


translate japanese plot3_b9890c22:


    "라이라 일행이 자기 이야기를 하고 있는 줄도 모른 채, 시노스는 두 번째 모험을 떠날 준비를 하고 있었다."


translate japanese plot3_17111756:


    "이곳에는 마물이 한 마리도 없었지만, 그녀에게 이번 모험은 상당한 도전이었다."


translate japanese plot3_e0d89242:


    "원래 세계와 너무도 달라서, 시노스는 행동 하나하나를 신중히 고를 수밖에 없었다."


translate japanese plot3_69f33265:



    voice "voice/cygnus_250.ogg"
    cygnus "……よし、{a=dictionary:dict_entry_38}道探しの魔法{/a}は正常に作動してる。"


translate japanese plot3_74f69fef:



    voice "voice/cygnus_251.ogg"
    cygnus "으…… 길 찾기 술식을 조금 고치는 것만으로도 마력이 계속 빠져나가네……"


translate japanese plot3_c551938e:


    "마나가 가득한 세계라면 이렇게 간단한 마법으로 소모감을 느낄 일은 없다."


translate japanese plot3_e6a48e06:


    "하지만 이곳은 달랐다. 몸 안에 저장한 마력을 써서 마법을 안정적으로 유지해야 했다."


translate japanese plot3_201b9338:


    "마력으로 살아가는 마녀에게 이 세계는 산소가 희박한 고지대처럼 살기 힘든 곳이다."


translate japanese plot3_d8e73391:



    voice "voice/cygnus_252.ogg"
    cygnus "나랑 이 세계는 너무 안 맞아……"


translate japanese plot3_de230b72:



    voice "voice/cygnus_253.ogg"
    cygnus "나는 대체 왜 여기 온 걸까……"


translate japanese plot3_a0ccc2e9:


    "시노스는 알 수 없었다. 기억에 그림자가 드리운 듯, 더는 아무것도 떠오르지 않았다."


translate japanese plot3_936c4298:



    voice "voice/cygnus_254.ogg"
    cygnus "……"


translate japanese plot3_92682d51:



    voice "voice/cygnus_255.ogg"
    cygnus "……생각해 봤자 소용없어. 나가서 단서라도 찾자."


translate japanese plot3_bf1782ab:



    voice "voice/cygnus_256.ogg"
    cygnus "우선은 그 나무네."


translate japanese plot3_936c4298_1:



    voice "voice/cygnus_257.ogg"
    cygnus "……"


translate japanese plot3_d1b30e48:


    "시노스는 동네 공원을 몇 바퀴나 돌았다. 남들의 눈길을 끌지 않는 것을 확인하고서야 조심스럽게 큰길로 나섰다."


translate japanese plot3_cbca1160:


    "라이라가 사 준 옷 덕분에, 그때의 로브 차림보다는 훨씬 인파에 잘 섞여 들었다."


translate japanese plot3_9b7840a9:



    voice "voice/cygnus_258.ogg"
    cygnus "（……응, 이 정도면 문제없겠네.）"


translate japanese plot3_280bda84:



    voice "voice/cygnus_259.ogg"
    cygnus "거목의 위치는……"


translate japanese plot3_5e732823:



    voice "voice/cygnus_260.ogg"
    cygnus "저쪽인가?"


translate japanese plot3_5d980a53:


    "빵빵"


translate japanese plot3_ae01c70e:


    "아침 거리는 무척 분주했다. 모두 회사나 학교에 빨리 도착하려고 애썼다."


translate japanese plot3_7ebe89b3:


    "길이 조금만 막혀도 뒤의 차들이 곧바로 경적을 울려, 앞차에게 빨리 앞으로 가라고 재촉했다."


translate japanese plot3_239c2b61:



    voice "voice/cygnus_261.ogg"
    cygnus "어디 보자…… 이 탈것들이 「자동차」인가……"


translate japanese plot3_704d5294:


    "라이라는 길에서 움직이는 쇳덩어리들이 이 세계의 주된 교통수단이라고 알려 주었다."


translate japanese plot3_f8ca049d:


    "마차에서 발전한 탈것이라는 점은 시노스의 짐작과 비슷했다."


translate japanese plot3_1743495c:


    "しかし、シノスには交通機関の利用がまだ難しかったため、彼女は無理をせず歩いて中央公園へ行くことにする。"


translate japanese plot3_dabebaea:



    voice "voice/cygnus_262.ogg"
    cygnus "분명 「자동차」 말고 「지하철」이라는 탈것도 있다고 했지."


translate japanese plot3_ec6bd231:



    voice "voice/cygnus_263.ogg"
    cygnus "地下に存在する列車……{a=dictionary:dict_entry_39}魔導列車{/a}みたいなものなのかしら？"


translate japanese plot3_094b9686:


    "「列車」は、珍しく二つの世界に共通する言葉だった。"


translate japanese plot3_09522503:


    "ただし、シノスの世界ではそれは「交通機関」ではなく、{a=dictionary:dict_entry_40}古代魔導帝国{/a}が地中深くに残した「遺跡」の名前だ。"


translate japanese plot3_f6bf93f2:


    "그 세계의 고고학자들도 고대인이 쓰던 탈것으로 추정했지만, 여러 세력이 마도 기술 연구를 엄격히 제한하는 탓에 마도열차는 끝내 복원되지 못했다."


translate japanese plot3_12d2ef52:



    voice "voice/cygnus_264.ogg"
    cygnus "（……혹시 그 옛 왕국의 기술은 이 세계의 과학과 마법이 융합된 건가?）"


translate japanese plot3_d76622b3:



    voice "voice/cygnus_265.ogg"
    cygnus "（흥미롭네. 다음에 라이라한테 「지하철」을 안내해 달라고 할까.）"


translate japanese plot3_3098447e:


    "오늘 중앙 공원은 어제보다 더 많은 사람으로 넘쳐 났다."


translate japanese plot3_13c76f79:


    "룽화시 시민뿐 아니라 아시아 각지에서 「호기심 많은 사람들」이 몰려들었다."


translate japanese plot3_ca519af3:


    "그중 많은 이가 인플루언서였다. 화제가 될 만한 사건을 감지하면 남에게 뒤처질까 봐 곧바로 세계 각지에서 모여드는 것이다."


translate japanese plot3_d5cab9b7:



    voice "voice/cygnus_266.ogg"
    cygnus "사람 정말 많네. 다 다른 곳에서 온 관광객인가?"


translate japanese plot3_6cef0bd1:



    voice "voice/cygnus_267.ogg"
    cygnus "하루 만에 이렇게 많은 사람을 모으다니, 이 세계 교통은 역시 그쪽 세계보다 무서울 정도로 발전했어."


translate japanese plot3_5319191f:


    "시노스의 세계에도 장거리를 이동하는 전이 마법은 있었지만, 준비에 오랜 시간이 들고 비용도 엄청나게 비쌌다."


translate japanese plot3_7b650cdc:


    "それでも、魔法協会が各地に設置した転移の魔法陣は、彼らの主要な収入源であり続けている。"


translate japanese plot3_675fa5dd:


    "이유는 단순했다. 전이 마법을 쓰면 수많은 위험 지대를 안전하게 통과해 목적지에 도착할 수 있었기 때문이다."


translate japanese plot3_de3fdf1f:


    cygnus "흥, 이 세계에 마법 협회가 있으면 장사 다 망하겠네."


translate japanese plot3_274b2c96:


    "인파에 몸을 숨길 수 있어 조금 안심한 시노스는 사람들을 따라 공원 안으로 들어갔다."


translate japanese plot3_9853a835:


    "하지만 공원에 들어서자마자 사람들의 발길이 멈췄다."


translate japanese plot3_2b49785a:



    voice "voice/cygnus_269.ogg"
    cygnus "……응?"


translate japanese plot3_47a83614:


    "의아해하던 시노스는 거목 뿌리 근처가 전부 통제선으로 둘러싸인 것을 보았다."


translate japanese plot3_510ecccc:



    voice "voice/cygnus_270.ogg"
    cygnus 0101 "……다들 저 울타리 때문에 못 가는 거네."


translate japanese plot3_dc468f03:


    "사실 그곳이 소방서에서 정한 출입 제한 구역이라는 것을 시노스는 몰랐다."


translate japanese plot3_9f9a266f:


    "지반이 무너질 우려가 있어 사람들이 거목에 너무 가까이 가지 못하게 한 것이다."


translate japanese plot3_eddcfdc4:



    voice "voice/cygnus_271.ogg"
    cygnus "다른 길을 찾아보자……"


translate japanese plot3_6b537737:


    "시노스는 바깥쪽을 한 바퀴 크게 돌았지만, 어디를 가든 통제선에 막혔다."


translate japanese plot3_bf46273f:



    voice "voice/cygnus_272.ogg"
    cygnus "……어쩔 수 없지. 몰래 들어가자."


translate japanese plot3_c441be76:


    "마침내 시노스는 사람이 적은 곳을 찾았다."


translate japanese plot3_551490ab:


    "그녀는 몰래 통제선 안으로 들어가, 다른 사람들이 놓아둔 사다리를 타고 무사히 뿌리 위에 올랐다."


translate japanese plot3_1a69a6fc:



    voice "voice/cygnus_273.ogg"
    cygnus "……후우, 어떻게든 들어왔네."


translate japanese plot3_a568a01a:



    voice "voice/cygnus_274.ogg"
    cygnus "誰にも見られてないみたいね。だったら、{a=dictionary:dict_entry_41}隠身魔法{/a}を使う必要なかったじゃない……魔力の無駄だ……"


translate japanese plot3_622897aa:



    voice "voice/cygnus_275.ogg"
    cygnus "좋아, 가자."


translate japanese plot3_4dce53f4:


    "시노스는 뿌리를 따라 거목의 밑동까지 걸어갔다."


translate japanese plot3_4e8f2350:


    "이곳은 더욱 북적였다. 자신처럼 몰래 통제선을 넘은 사람들이 전부 모여 있었다."


translate japanese plot3_61882e59:


    "사람들은 줄기를 에워싸고 있었다. 이 나무에 자신이 다녀갔다는 흔적을 남기려는 것만 같았다."


translate japanese plot3_cbc95b27:



    voice "voice/cygnus_276.ogg"
    cygnus 0101 "아까 저기에 뭔가 걸려 있어서 다행이었어. 안 그랬으면 지금 여기로 들어올 틈도 없었겠지."


translate japanese plot3_ddd1bb91:



    voice "voice/cygnus_277.ogg"
    cygnus 0106 "음…… 사람이 좀 적은 곳을 찾자."


translate japanese plot3_c06de4f4:


    "몇 분을 돌아다닌 뒤 시노스는 겨우 마음을 놓을 만한 장소를 찾았다."


translate japanese plot3_7daf069c:



    voice "voice/cygnus_278.ogg"
    cygnus "응, 여기로 하자."


translate japanese plot3_d35b3cc0:


    "시노스는 살며시 나무줄기에 손을 대고 눈을 감은 채 마력을 집중했다."


translate japanese plot3_51981621:


    "이 범상치 않은 거목과 마력으로 연결되면, 자신이 이 세계에 온 이유를 알아낼지도 몰랐다."


translate japanese plot3_0efa8558:


    "그렇게 생각하니 묘하게 긴장돼, 시노스는 저도 모르게 숨을 깊이 들이쉬었다."


translate japanese plot3_e3bbd6c7:



    voice "voice/cygnus_279.ogg"
    cygnus "【「동조」｜Synchro】"


translate japanese plot3_03b77f41:


    "몸에서 희미한 빛이 피어오르고, 몸 안의 적은 마력이 천천히 나무 내부로 흘러들었다."


translate japanese plot3_e802a00d:


    "지금 가진 마력의 양으로는 큰 기대를 할 수 없다——나무는 너무나 거대했다."


translate japanese plot3_c3f3b233:


    "이것이 정말 마력 때문에 생긴 「【왜곡｜Error】」이라면, 시노스의 미미한 마력 파동에는 반응조차 하지 않을 가능성이 컸다."


translate japanese plot3_b03f306c:


    "그래도 확인하지 않고는 견딜 수 없었다."


translate japanese plot3_e8dac5b0:


    "거목은 지금 시노스가 붙잡을 수 있는 유일한 단서였다. 쉽게 포기할 수는 없었다."


translate japanese plot3_936c4298_2:



    voice "voice/cygnus_280.ogg"
    cygnus "……"


translate japanese plot3_d7459063:


    "곧 시노스는 거목에서 돌아오는 마력의 반응을 감지했다."


translate japanese plot3_6a70e3e0:



    voice "voice/cygnus_281.ogg"
    cygnus "그럴 수가……"


translate japanese plot3_d9cf4a8c:


    "결과는 예상 밖이었다. 마력을 얼마 넣지도 않았는데 거목과 손쉽게 연결되었다."


translate japanese plot3_c278db31:


    "つながったその瞬間、シノスの魔力は巨樹全体を巡り、求めていた情報はすぐに得られた。"


translate japanese plot3_8eaac1c0:


    " この巨樹の内部には、この世界の他のものと同じく、{a=dictionary:dict_entry_42}魔力の流れ{/a}はまったく存在しなかった。"


translate japanese plot3_26ef2004:


    "즉 이 나무는 자신의 힘에 영향을 받은 것이 아니었다. 자연의 힘으로 이렇게 거대해진 것이었다."


translate japanese plot3_4be9930e:



    voice "voice/cygnus_282.ogg"
    cygnus "이건 정말…… 놀랍네."


translate japanese plot3_581810ac:


    "시노스는 손을 떼어 거목과의 마력 연결을 끊었다. 이제 이 나무가 정말 평범한 나무라는 것을――적어도 마법의 관점에서는 확신했다."


translate japanese plot3_0a684340:



    voice "voice/cygnus_283.ogg"
    cygnus "……내가 여기 온 건 정말 이 나무와는 관계없는 걸까?"


translate japanese plot3_2b0b5722:


    "결론은 나왔지만, 마녀는 이 정도의 우연을 믿기 어려웠다."


translate japanese plot3_d9c8d13d:


    "그 생각에 그녀는 저도 모르게 고개를 들어 나무 끝을 바라봤다."


translate japanese plot3_95f7e684:


    "어제 라이라가 봤던 것처럼 꼭대기는 전혀 보이지 않았다."


translate japanese plot3_12ed4594:


    "나무에서는 초월적인 신성함마저 느껴지는 듯했다."


translate japanese plot3_ec5f10fc:


    "하지만 시노스는 그 분위기가 싫었다. 오히려 왠지 이 나무에 혐오감마저 들기 시작했다."


translate japanese plot3_936c4298_3:



    voice "voice/cygnus_284.ogg"
    cygnus "……"


translate japanese plot3_66637fc4:



    voice "voice/cygnus_285.ogg"
    cygnus "（아니면 뭔가 놓치고 있는 건가……?）"


translate japanese plot3_7bc1d5db:



    voice "voice/cygnus_286.ogg"
    cygnus "——!"


translate japanese plot3_551a1924:


    " 시노스는 거목 아래에 오래 머무르지 않았다."


translate japanese plot3_8b8b8c14:


    "곧 인파 속에 섞여 시끄러운 곳을 빠져나왔다."


translate japanese plot3_8f7251c6:



    voice "voice/flame_01.ogg"
    ataset_ns "어, 달아나려는데! 빨리 따라가자!"


translate japanese plot3_a0a756f4:



    voice "voice/hunter_01.ogg"
    monolith_ns "침착해."


translate japanese plot3_28d97bc7:



    voice "voice/hunter_02.ogg"
    monolith_ns "흥…… 들켰군."


translate japanese plot3_3b3d8365:



    voice "voice/flame_02.ogg"
    ataset_ns "어머?"


translate japanese plot3_0d75f87e:



    voice "voice/hunter_03.ogg"
    monolith_ns "원래는 눈치채지 못하게 추적 술식을 새길 생각이었어. 그런데 손을 쓰기도 전에 알아차린 모양이군."


translate japanese plot3_846efd88:



    voice "voice/hunter_04.ogg"
    monolith_ns "さすが{a=dictionary:dict_entry_43}「大魔女」{/a}。危険への感知が鋭すぎる。"


translate japanese plot3_0af1adf7:



    voice "voice/flame_03.ogg"
    ataset_ns "그러니까 말했잖아. 그런 잔꾀 부리지 말고 얼른 잡아 버리면 됐을 텐데～?"


translate japanese plot3_817f76fd:



    voice "voice/hunter_05.ogg"
    monolith_ns "駄目だ。まだ魔導器を見つかっていない。"


translate japanese plot3_b49ee7a2:



    voice "voice/flame_04.ogg"
    ataset_ns "우리 목적은 마도구가 아니라 저 애 본인이지?"


translate japanese plot3_23b8ca86:



    voice "voice/hunter_06.ogg"
    monolith_ns "……빨리 돌아가고 싶으면 「장로」한테 직접 말해."


translate japanese plot3_7d4659cd:



    voice "voice/hunter_07.ogg"
    monolith_ns "대마녀가 될 기회가 눈앞에 있는데, 그렇게 쉽게 놓치고 싶진 않아."


translate japanese plot3_79ca106c:



    voice "voice/flame_05.ogg"
    ataset_ns "참～ 또 그 얘기야? 데리고 돌아가서 넘겨주면 끝인데～"


translate japanese plot3_6b7ed3f2:



    voice "voice/flame_06.ogg"
    ataset_ns "그래도 「장로」한테 연락 안 한 지 좀 됐네. 오늘 돌아가면 마침 보고도 할 수 있겠다～"


translate japanese plot3_114a1f01:



    voice "voice/hunter_08.ogg"
    monolith_ns "……경고하는데, 쓸데없는 말은 하지 마."


translate japanese plot3_22b0828f:



    voice "voice/flame_07.ogg"
    ataset_ns "알고 있다니까～"


translate japanese plot3_bb712924:


    "같은 시각, 학교에서는."


translate japanese plot3_b3e492fd:



    voice "voice/jinlaoshi_21.ogg"
    jinlaoshi "한 바퀴 더! 그 속도 유지해!"


translate japanese plot3_a8b5b916:


    "운동장에는 체육 선생님의 외침과 학생들의 거친 숨소리가 번갈아 울렸다."


translate japanese plot3_380b0386:


    "아침 햇볕은 아직 그리 강하지 않았지만, 체육 수업을 듣는 학생들에게는 충분히 괴로웠다."


translate japanese plot3_96f8e5aa:



    voice "voice/jinlaoshi_22.ogg"
    jinlaoshi "힘내, 힘내! 걷지 말고 뛰어!"


translate japanese plot3_2bc63d14:



    voice "voice/npc6_02.ogg"
    npc6 "하아, 하아…… 대체…… 체육 시험은 왜 보는 거야……"


translate japanese plot3_6def3198:



    voice "voice/npc7_02.ogg"
    npc7 "그, 그런 말 할 힘 있으면! 차라리, 아껴 둬……!"


translate japanese plot3_34f3d3f9:


    "대부분의 학생은 벌써 숨이 차서 불평도 끊어 가며 했다."


translate japanese plot3_1f5fef20:


    "지금의 모든 고등학생에게 가장 듣기 싫은 수업을 투표하게 한다면, 체육이 틀림없이 1위를 차지할 것이다."


translate japanese plot3_97822b96:


    "「체육 교육」은 「유토리 교육」의 흐름 속에서 유일하게 부담이 늘어난 과목이다."


translate japanese plot3_e7f22537:


    "이제 체육 수업은 주 6교시 이상이고, 그 절반은 체력 훈련이다."


translate japanese plot3_2c99e4f4:


    "体力向上のため、体育は主要科目になり、高校統一試験でも比重が大きい。"


translate japanese plot3_e17ad093:


    "예전에 「공부벌레」가 대접받던 시대에는 체육이 가장 경시되었다."


translate japanese plot3_edd78005:


    "이제는 교과 담당 교사가 체육 시간을 뺏는 일도 없다――오히려 학생들이 「체육 시간을 뺏어 주세요」 하고 바랄 정도다."


translate japanese plot3_44426e30:



    voice "voice/jinlaoshi_23.ogg"
    jinlaoshi "힘내, 힘내! 조금만 더!"


translate japanese plot3_45501eac:


    "학생들이 한창 불평하는 동안, 체육 특기생들은 벌써 한 바퀴나 앞서 결승선에 거의 다다랐다."


translate japanese plot3_eb8fafb4:



    voice "voice/jinlaoshi_24.ogg"
    jinlaoshi "좋아! 도착!"


translate japanese plot3_ebb88793:



    voice "voice/hecheng_28.ogg"
    hecheng "……후우."


translate japanese plot3_035a34bb:



    voice "voice/jinlaoshi_25.ogg"
    jinlaoshi "츠루기, 오늘도 괜찮네."


translate japanese plot3_0c88502f:



    voice "voice/hecheng_29.ogg"
    hecheng "요즘은 그럭저럭 괜찮아요."


translate japanese plot3_363e04fb:



    voice "voice/jinlaoshi_26.ogg"
    jinlaoshi "그 상태를 계속 유지하자."


translate japanese plot3_750702c2:



    voice "voice/hecheng_30.ogg"
    hecheng "알겠어요."


translate japanese plot3_3d185645:



    "늘 체력 훈련을 하는 체육 특기생들에게 800미터 달리기는 별것 아니었다."


translate japanese plot3_57928118:


    banzhang_ns "하…… 후——"


translate japanese plot3_401cf574:


    "두 번째로 도착한 학생 역시 체육 특기생인 반장이었다. 츠루기보다 아주 조금 늦었을 뿐이었다."


translate japanese plot3_a806622f:



    voice "voice/jinlaoshi_27.ogg"
    jinlaoshi "응, 아키도 컨디션이 좋네."


translate japanese plot3_bfe25db6:



    voice "voice/jinlaoshi_28.ogg"
    jinlaoshi "이대로면 너랑 츠루기는 체육 시험도 무난히 통과하겠어."


translate japanese plot3_cc8649b8:



    voice "voice/jinlaoshi_29.ogg"
    jinlaoshi "당분간 몸 관리 잘해. 알았지?"


translate japanese plot3_4b00273b:



    voice "voice/banzhang_45.ogg"
    banzhang "네, 김 선생님."


translate japanese plot3_d8ff1fed:


    "츠루기와 반장은 올해 체육 특기생 중 가장 기대를 모으는 두 학생이었다."


translate japanese plot3_19c8c158:


    "신체 능력도 뛰어나고 훈련도 부지런히 해, 장차 운동선수가 될 가능성이 컸다."


translate japanese plot3_7e476775:



    voice "voice/jinlaoshi_30.ogg"
    jinlaoshi "어?"


translate japanese plot3_9f3e1660:


    "세 번째로 결승선을 통과한 학생은 체육 선생님을 조금 놀라게 했다. 평소 체육 수업에 거의 오지 않는 학생이었다."


translate japanese plot3_ef36ab25:



    voice "voice/jinlaoshi_31.ogg"
    jinlaoshi "체육 특기생보다도 빠르다니——"


translate japanese plot3_4754b55d:



    voice "voice/jinlaoshi_32.ogg"
    jinlaoshi "히나타 씨."


translate japanese plot3_6d1dbc18:



    voice "voice/yangxi_149.ogg"
    yangxi "……후우."


translate japanese plot3_6e8e356c:


    "세 번째로 들어온 것은 히나타였다. 츠루기나 반장만큼 여유롭지는 않았지만, 다른 체육 특기생들을 앞질렀다."


translate japanese plot3_6bb17adc:



    voice "voice/xizhen_02.ogg"
    xizhen "하아, 하아…… 뭐야, 쟤…… 너무 빠르잖아."


translate japanese plot3_3f4d06f0:



    voice "voice/minying_02.ogg"
    minying "후…… 우리 체육 특기생보다 잘 뛰다니 어떻게……"


translate japanese plot3_9603437f:



    voice "voice/jinlaoshi_33.ogg"
    jinlaoshi "체육 시간에 잘 안 오면서도, 올 때마다 깜짝 놀라게 하는구나."


translate japanese plot3_c1e03041:



    voice "voice/yangxi_150.ogg"
    yangxi "빈정거리시는 거예요, 선생님?"


translate japanese plot3_20a880e7:



    voice "voice/jinlaoshi_34.ogg"
    jinlaoshi "하하, 그런 말을 할 리가 없잖아."


translate japanese plot3_f1cfa154:



    voice "voice/jinlaoshi_35.ogg"
    jinlaoshi "그래도 다음에도 계속 안 나오면 선생님도 곤란해."


translate japanese plot3_056cf4bc:



    voice "voice/yangxi_151.ogg"
    yangxi "내키면 올게요."


translate japanese plot3_8ec7aa7b:



    voice "voice/jinlaoshi_36.ogg"
    jinlaoshi "히나타 씨는 정말 거리낌이 없구나."


translate japanese plot3_d06897d6:



    voice "voice/jinlaoshi_37.ogg"
    jinlaoshi "있잖아, 진지하게 체육 특기생이 될 생각 없어?"


translate japanese plot3_0e892111:



    voice "voice/jinlaoshi_38.ogg"
    jinlaoshi "성적은 아키만큼 좋고, 체육 특기생이 되면 대학 추천 입학도 노려 볼 수 있어."


translate japanese plot3_177ea4d2:



    voice "voice/yangxi_152.ogg"
    yangxi "전 됐어요. 매일 죽어라 체력 훈련은 하기 싫거든요."


translate japanese plot3_de15d952:



    voice "voice/jinlaoshi_39.ogg"
    jinlaoshi "에이～ 너무 아깝잖아～"


translate japanese plot3_bc4923da:



    voice "voice/tianqin_504.ogg"
    tianqin "장거리 달리기 하느라 수고했어～"


translate japanese plot3_c6bc394d:



    voice "voice/yangxi_153.ogg"
    yangxi "체육 시간 내내 쉬는 네가 그런 말을 하니 왠지 열받는데……"


translate japanese plot3_39d62004:



    voice "voice/tianqin_505.ogg"
    tianqin "에에—, 몇 번이나 말했지만 체질 문제라니까, 체질!"


translate japanese plot3_531144ce:



    voice "voice/tianqin_506.ogg"
    tianqin "난 체육 시험도 못 보는 불쌍한 애라고?"


translate japanese plot3_b07bd89d:



    voice "voice/yangxi_154.ogg"
    yangxi "「몸이 너무 튼튼해서 신체검사에 불합격하는 바람에 체육 시험을 못 본다」고 말해 봐. 여기 애들 전부 웃다가 쓰러질걸."


translate japanese plot3_8abbc377:



    voice "voice/tianqin_507.ogg"
    tianqin "어쩔 수 없어, 사실인걸～"


translate japanese plot3_db14913b:



    voice "voice/tianqin_508.ogg"
    tianqin "의학적으로 보면 난 거의 1급 장애인 취급이라고?"


translate japanese plot3_817b21a5:



    voice "voice/yangxi_155.ogg"
    yangxi "네, 네. 어차피 거짓말이겠지."


translate japanese plot3_2d2110a3:



    voice "voice/tianqin_509.ogg"
    tianqin "진짜라니까——!"


translate japanese plot3_c870f0e5:



    voice "voice/jinlaoshi_40.ogg"
    jinlaoshi2 0104 "좋아! 다 뛴 학생들은 남은 시간 자유 활동 해!"


translate japanese plot3_2482b9b8:



    voice "voice/jinlaoshi_41.ogg"
    jinlaoshi2 "농구공이랑 축구공은 다 쓰면 기구실에 돌려놓고!"


translate japanese plot3_9683295b:


    "마지막 학생이 거친 숨을 몰아쉬며 결승선에 들어오고서야 체육 선생님은 자유 활동을 선언했다."


translate japanese plot3_6248500b:


    "대부분의 학생은 그늘에 쓰러지듯 주저앉았다. 기운이 남은 몇 명만 농구 코트로 달려갔다."


translate japanese plot3_16f1e997:



    voice "voice/tianqin_510.ogg"
    tianqin "좋아! 자유 시간이야!"


translate japanese plot3_ff46b863:



    voice "voice/tianqin_511.ogg"
    tianqin "있잖아, 배드민턴 안 칠래?"


translate japanese plot3_fd9904e4:



    voice "voice/yangxi_156.ogg"
    yangxi "그렇게 내 배드민턴에 대한 열정을 꺾고 싶어?"


translate japanese plot3_f1a29d1c:



    voice "voice/tianqin_512.ogg"
    tianqin "살살 할 테니까 괜찮아!"


translate japanese plot3_b6d0f0bb:



    voice "voice/yangxi_157.ogg"
    yangxi "네가 살살 해 주니까 더 짜증 난다고."


translate japanese plot3_9425c49c:



    voice "voice/tianqin_513.ogg"
    tianqin "그럼 전력으로 할게!"


translate japanese plot3_56beccdd:



    voice "voice/yangxi_158.ogg"
    yangxi "그것도 안 돼."


translate japanese plot3_3e6c8484:



    voice "voice/tianqin_514.ogg"
    tianqin "에에～ 히나타는 참 귀찮다니까……"


translate japanese plot3_9f21d53c:



    voice "voice/xiaoxia_27.ogg"
    xiaoxia3 "저, 저기!"


translate japanese plot3_f0e2e7e7:



    voice "voice/tianqin_515.ogg"
    tianqin "응?"


translate japanese plot3_eff93153:



    voice "voice/xiaoxia_28.ogg"
    xiaoxia "라이라 씨……"


translate japanese plot3_401f183f:



    voice "voice/tianqin_516.ogg"
    tianqin "어, 아키나. 왜?"


translate japanese plot3_53ff973f:



    voice "voice/tianqin_517.ogg"
    tianqin "설마 담임 선생님이 또 부르시는 건……?"


translate japanese plot3_0d3319f3:



    voice "voice/xiaoxia_29.ogg"
    xiaoxia "아, 아니에요……"


translate japanese plot3_40a3f434:



    voice "voice/xiaoxia_30.ogg"
    xiaoxia "저기, 부탁드리고 싶은 일이 있어서요…… 지금 시간 괜찮으세요……?"


translate japanese plot3_b581fce3:



    voice "voice/tianqin_518.ogg"
    tianqin "응? 괜찮지. 지금 자유 활동 시간이잖아."


translate japanese plot3_7232a1c7:



    voice "voice/tianqin_519.ogg"
    tianqin "히나타도 같이 갈래?"


translate japanese plot3_d36a5435:



    voice "voice/yangxi_159.ogg"
    yangxi "……어차피 할 일도 없고."


translate japanese plot3_d6a35682:



    voice "voice/yangxi_160.ogg"
    yangxi "나도 가도 돼? 방해만 안 되면."


translate japanese plot3_ac1a3b45:



    voice "voice/xiaoxia_31.ogg"
    xiaoxia "저, 전혀 방해 안 돼요……! 도와주실 분은 많을수록 좋아요……"


translate japanese plot3_bc94e104:



    voice "voice/yangxi_161.ogg"
    yangxi "그럼 나도 뭘 도울 수 있을지 가 볼게."


translate japanese plot3_bf6d5831:



    voice "voice/xiaoxia_32.ogg"
    xiaoxia "네, 네!"


translate japanese plot3_af53ef47:



    voice "voice/tianqin_520.ogg"
    tianqin "영——차——!"


translate japanese plot3_d7f28653:


    "파삭——!"


translate japanese plot3_5ac2669d:


    "天琴が鍬を振るうたび、固く締まった土がまるで砂のように簡単に掘り返されていく。"


translate japanese plot3_ed9a1ebc:



    voice "voice/xiaoxia_33.ogg"
    xiaoxia "와…… 라이라 씨는 정말 힘이 세네요."


translate japanese plot3_5bd2a602:



    voice "voice/tianqin_521.ogg"
    tianqin "하하, 힘센 것만은 내 장점이니까."


translate japanese plot3_ab66baf3:



    voice "voice/xiaoxia_34.ogg"
    xiaoxia "그, 그렇지 않아요……!"


translate japanese plot3_6c84dcea:



    voice "voice/xiaoxia_35.ogg"
    xiaoxia "라이라 씨가 안 와 주셨으면 오늘 흙 고르는 일은 전혀 진척이 없었을 거예요……."



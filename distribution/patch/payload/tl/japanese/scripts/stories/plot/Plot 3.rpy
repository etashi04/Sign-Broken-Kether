    voice "voice/tianqin_607.ogg"
    tianqin "오케이"


translate japanese plot3_3334bced:



    voice "voice/blackcat_09.ogg"
    blackcat "그리고 너…… 네가 「떨어진 곳」을 다시 한번 제대로 찾아봐."


translate japanese plot3_9c74e400:



    voice "voice/cygnus_384.ogg"
    cygnus "……무슨 뜻이야?"



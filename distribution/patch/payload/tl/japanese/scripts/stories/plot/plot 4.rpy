translate japanese plot4_memory_question_dd853605:



    voice "voice/banzhang_66.ogg"
    banzhang "죄송해요. 두 분이 여기 계신 게 보여서 그만 궁금해졌어요."


translate japanese plot4_memory_question_e47731d5:



    voice "voice/tianqin_963.ogg"

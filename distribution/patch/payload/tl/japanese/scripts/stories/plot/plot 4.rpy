translate japanese plot4_memory_question_63bda3ae:


    "라이라의 생각을 눈치챈 것인지, 히나타는 더 이상 캐묻지 않았다."


translate japanese plot4_memory_question_3cb9f3c7:



    voice "voice/tianqin_959.ogg"
    tianqin "고마워, 히나타!"


translate japanese plot4_memory_question_de41ef1f:



    voice "voice/banzhang_64.ogg"
    banzhang 0301 "라이라 씨, 히나타 씨……?"


translate japanese plot4_memory_question_4d7dbb97:


    "그때 갑자기 등 뒤에서 목소리가 들렸다."


translate japanese plot4_memory_question_66a77abc_1:



    voice "voice/tianqin_960.ogg"
    tianqin "으아아악!?" with Shake((0, 0, 0, 0), 0.8, dist=8)


translate japanese plot4_memory_question_29fd8104:



    voice "voice/banzhang_65.ogg"

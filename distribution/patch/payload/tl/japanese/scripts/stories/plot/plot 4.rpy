


translate japanese plot4_d45767d9:



    voice "voice/cygnus_490.ogg"
    cygnus "（{a=dictionary:dict_entry_51}탐지 마법{/a}, 전개.）"


translate japanese plot4_ae16a1da:



    voice "voice/cygnus_491.ogg"
    cygnus "（…아니야. 여기가 아니야.）"


translate japanese plot4_25a61bf1:



    voice "voice/tianqin_748.ogg"
    tianqin "하아암……"


translate japanese plot4_fcf899f4:


    "주말 이른 아침부터 시노스는 라이라를 이불 밖으로 끌어냈다."


translate japanese plot4_fd59da61:


    "어젯밤 라이라에게서 느낀 마력의 흔적을 확인하려고, 통학로를 따라가며 몇 번이고 탐지 마법을 펼쳤다."


translate japanese plot4_c4e5204e:



    voice "voice/tianqin_749.ogg"
    tianqin "아사요—— 아직 못 찾았어——?"


translate japanese plot4_f22e5dc9:



    voice "voice/cygnus_492.ogg"
    cygnus "아직은 아무것도 없어."


translate japanese plot4_42276961:



    voice "voice/tianqin_750.ogg"
    tianqin "졸려어——……"


translate japanese plot4_cb2ed36a:



    voice "voice/cygnus_493.ogg"
    cygnus "오늘은 쉬는 날이지? 잘됐네. 마도구 단서 찾는 데 같이 가 줘."


translate japanese plot4_9f5aec41:



    voice "voice/tianqin_751.ogg"
    tianqin "쉬는 날이니까 쉬고 싶은데～"


translate japanese plot4_1687986e:


    "시간이 이른 건 사실이었다. 거리에는 아침 운동을 막 마친 노인들이 눈에 띄었다."


translate japanese plot4_28b64b78:


    "고등학생이라면 아직 꿈나라에 있어도 이상하지 않을 시간이었다. 게다가 오늘은 주말이었다."


translate japanese plot4_ce48b8b7:



    voice "voice/jiaozi_05.ogg"
    jiaozi "멍멍——!"


translate japanese plot4_1f72c665:


    "반면 두 사람 뒤를 따르는 자오쯔는 유난히 신이 나 있었다. 아침부터 산책을 나온 게 기쁜 모양이었다."


translate japanese plot4_90ee8c50:



    voice "voice/tianqin_752.ogg"
    tianqin "자오쯔, 나도 너처럼 기운이 있으면 좋겠다……"


translate japanese plot4_53ae0e62:



    voice "voice/jiaozi_10.ogg"
    jiaozi "멍!"


translate japanese plot4_6c898702:



    voice "voice/cygnus_494.ogg"
    cygnus "자, 자오쯔랑 그만 놀고 앞으로 가자."


translate japanese plot4_48b70d39:



    voice "voice/cygnus_495.ogg"
    cygnus "마도구를 빨리 찾으면 그만큼 빨리 쉴 수 있어."


translate japanese plot4_87e5720e:



    voice "voice/tianqin_753.ogg"
    tianqin "네에——"


translate japanese plot4_47212bd8:



    voice "voice/cygnus_496.ogg"
    cygnus "여기도 아니야."


translate japanese plot4_5470f2b6:



    voice "voice/cygnus_497.ogg"
    cygnus "다음이야. 계속 가자."


translate japanese plot4_1e7a22b5:



    voice "voice/cygnus_498.ogg"
    cygnus "아니야."


translate japanese plot4_6341c2f5:



    voice "voice/cygnus_499.ogg"
    cygnus "여기에도 없어."


translate japanese plot4_71a91fbd:



    voice "voice/cygnus_500.ogg"
    cygnus "이쪽도 없어."


translate japanese plot4_1e1830f4:


    "시노스는 탐지 마법을 거듭 펼치며 라이라의 통학로를 하나씩 살폈다."


translate japanese plot4_e2c91876:


    "매우 지루하고 단조로운 작업이었다. 마력 소모를 줄이려고 장소를 옮길 때마다 탐지 마법을 새로 펼쳤다."


translate japanese plot4_5acb11f2:


    "하지만 아무리 지루해도 시노스는 견딜 수 있었다."


translate japanese plot4_ec131dab:


    "마도구를 되찾을 수만 있다면 무엇이든 시도할 생각이었다."


translate japanese plot4_f8a80e69:


    "열쇠를 잃어버린 아이처럼, 조금이라도 가능성이 있는 곳은 빠짐없이 뒤지고 있었다."


translate japanese plot4_cd9ed3c3:



    voice "voice/tianqin_754.ogg"
    tianqin "하아아암……"


translate japanese plot4_d3b8df2d:


    "반면 끌려다니는 라이라는 그렇지 못했다. 몇 번이고 커다랗게 하품했다."


translate japanese plot4_3acea692:



    voice "voice/cygnus_501.ogg"
    cygnus "여기도 없네……"


translate japanese plot4_0e2c86a6:



    voice "voice/cygnus_502.ogg"
    cygnus "이 근처는 전부 살펴봤어. 저 상점가 뒤에 있는 게 네 학교야?"


translate japanese plot4_0960cf39:



    voice "voice/tianqin_755.ogg"
    tianqin "응, 맞아."


translate japanese plot4_d10c8870:



    voice "voice/cygnus_503.ogg"
    cygnus "그럼 가자."


translate japanese plot4_77d5496a:



    voice "voice/tianqin_756.ogg"
    tianqin "잠깐! 학교에 가려고?"


translate japanese plot4_6eee268e:



    voice "voice/cygnus_504.ogg"
    cygnus "당연하지. 마도구가 있다면 우선 네 학교겠지."


translate japanese plot4_7f4ce2b8:



    voice "voice/tianqin_757.ogg"
    tianqin "으음, 오늘은 좀 어려울지도……"


translate japanese plot4_f961d78b:



    voice "voice/cygnus_505.ogg"
    cygnus "왜? 쉬는 날이면 사람이 없을 텐데."


translate japanese plot4_5b2c2d83:



    voice "voice/tianqin_758.ogg"
    tianqin "평소라면 그렇지만, 이번 2주는 특기생 집중 훈련 기간이거든. 이번 주말에도 학교에서 특별 훈련 중일 거야."


translate japanese plot4_92442616:



    voice "voice/cygnus_506.ogg"
    cygnus "그러니까… 전에 말했던 「체육 특기생」들 말이야?"


translate japanese plot4_4d50e8ae:



    voice "voice/tianqin_759.ogg"
    tianqin "체육 특기생뿐 아니라 미술이나 음악 특기생들도 있어."


translate japanese plot4_5ad104cf:



    voice "voice/tianqin_760.ogg"
    tianqin "이 2주 동안은 집에 안 가고 학교 기숙사에서 생활해."


translate japanese plot4_4f476793:



    voice "voice/cygnus_507.ogg"
    cygnus "그럼 학교가 비는 건 언제지?"


translate japanese plot4_693c31dd:



    voice "voice/tianqin_761.ogg"
    tianqin "다음 주 월요일쯤? 집중 훈련도 이번 주면 끝나니까."


translate japanese plot4_6acb6702:



    voice "voice/cygnus_508.ogg"
    cygnus "（그러니까 모레인가……）"


translate japanese plot4_92e14e4b:


    "솔직히 시노스는 1초도 기다리고 싶지 않았다. 하지만 사람이 있는 학교에서는 아무래도 탐지하기 어려웠다."


translate japanese plot4_5a202334:



    voice "voice/cygnus_509.ogg"
    cygnus "어쩔 수 없지. 조금 더 기다리자."


translate japanese plot4_d72ecc03:



    voice "voice/tianqin_762.ogg"
    tianqin "응. 월요일에 수업 끝나면 내가 학교 안을 안내해 줄게."


translate japanese plot4_1188cca2:


    "꼬르르르륵……"


translate japanese plot4_da8342a7:



    voice "voice/tianqin_763.ogg"
    tianqin "아, 그러고 보니 아직 아침도 안 먹었네."


translate japanese plot4_26496f06:



    voice "voice/tianqin_764.ogg"
    tianqin "마침 상점가까지 왔으니 뭐라도 먹고 갈까?"


translate japanese plot4_3985f43e:



    voice "voice/cygnus_510.ogg"
    cygnus "네게 맡길게."


translate japanese plot4_4bb0aee7:



    voice "voice/cygnus_511.ogg"
    cygnus "이, 이건 대체……"


translate japanese plot4_8effd65e:



    voice "voice/cygnus_512.ogg"
    cygnus "너무 마시써!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_f246145c:


    "시노스는 입가에 묻은 소스도 아랑곳하지 않고, 빵을 입에 가득 문 채 손에 든 음식을 극찬했다."


translate japanese plot4_0923948f:


    "옆의 라이라는 할 말을 잃을 지경이었다."


translate japanese plot4_95b23e3d:



    voice "voice/tianqin_765.ogg"
    tianqin 0203 "이거 그냥 평범한 {a=dictionary:dict_entry_52}햄버거{/a}인데…… 정말 그렇게 맛있어?"


translate japanese plot4_e87a6b6e:



    voice "voice/cygnus_513.ogg"
    cygnus 0105 "지금까지 먹어 본 모든 진미보다 맛있어!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_312bc012:



    voice "voice/tianqin_766.ogg"
    tianqin 0210 "내가 해 준 요리는 그렇게 칭찬 안 했으면서!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_490a1cb4:



    voice "voice/cygnus_514.ogg"
    cygnus 0101 "라이라의 요리도 맛있어. 하지만 이건 차원이 다른 맛이야."


translate japanese plot4_36f08bc4:



    voice "voice/cygnus_515.ogg"
    cygnus 0110 "빵으로 고기와 채소를 감싸고 소스를 바르다니…… 이런 조리법을 생각해 내다니 정말 상상력이 대단하군."


translate japanese plot4_a4e73286:



    voice "voice/cygnus_516.ogg"
    cygnus 0102 "한 입 베어 물면 햄버거 전체의 맛이 혀 위에서 꽃피어…… 정말 훌륭해."


translate japanese plot4_759090bf:



    voice "voice/tianqin_767.ogg"
    tianqin "어…… 그, 그래……?"


translate japanese plot4_837f18ab:


    "자신이 그토록 극찬한 음식이 이 세계 사람들이 간편함을 위해 만든 패스트푸드라는 사실을 시노스가 알 리 없었다."


translate japanese plot4_f27afd7f:


    "물론 라이라에게는 정성껏 만든 자신의 요리가 이런 햄버거에게 졌다는 사실이 더 못마땅했다."


translate japanese plot4_fcaaa938:


    "모처럼 나왔으니 평소에 잘 안 먹는 것을 먹여 주고 싶었을 뿐이었다."


translate japanese plot4_4d721a7e:


    "시노스가 이런 프랜차이즈 햄버거에 그토록 쉽게 빠져들 줄은 몰랐다."


translate japanese plot4_7903338c:



    voice "voice/cygnus_517.ogg"
    cygnus "햄버거 두 개만 더 시켜도 될까?"


translate japanese plot4_bd820709:



    voice "voice/tianqin_768.ogg"
    tianqin "또 먹어? 벌써 세 개나 먹었잖아. 평소보다 훨씬 많이 먹는데."


translate japanese plot4_49e25172:



    voice "voice/cygnus_518.ogg"
    cygnus "응. 오늘은 왠지 입맛이 도네."


translate japanese plot4_25fc6718:



    voice "voice/tianqin_769.ogg"
    tianqin "（윽! 상처받았어!）"


translate japanese plot4_c38bd495:



    voice "voice/tianqin_770.ogg"
    tianqin "알았어, 알았어. 어차피 나도 아직 부족하고."


translate japanese plot4_c3a606a7:


    "잠시 뒤 라이라는 쟁반 위에 산처럼 쌓인 햄버거를 가져왔다."


translate japanese plot4_6e6b71b2:


    "직원과 주변 손님들이 어안이 벙벙한 가운데, 두 사람은 그 산더미 같은 햄버거를 차례차례 먹어 치웠다."


translate japanese plot4_61bfaa36:


    "게다가 아직 아침 시간이었다."


translate japanese plot4_f3315a6c:



    voice "voice/tianqin_771.ogg"
    tianqin "후—— 잘 먹었다——"


translate japanese plot4_43b8e612:



    voice "voice/cygnus_519.ogg"
    cygnus "응. 정말 맛있었어."


translate japanese plot4_83f66079:



    voice "voice/tianqin_772.ogg"
    tianqin "입가가 소스 범벅이야. 자, 잘 닦아."


translate japanese plot4_574d9b3d:



    voice "voice/cygnus_520.ogg"
    cygnus "응? 그랬어? 실례했네."


translate japanese plot4_11073022:



    voice "voice/tianqin_773.ogg"
    tianqin "햄버거를 그렇게 좋아할 줄은 몰랐어."


translate japanese plot4_4f6f63b6:



    voice "voice/tianqin_774.ogg"
    tianqin "앞으로 요리할 시간이 없으면 햄버거를 사 오면 되겠다."


translate japanese plot4_d259bfc1:



    voice "voice/cygnus_521.ogg"
    cygnus "꼭 그렇게 해 줘!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_ce1074a1:



    voice "voice/tianqin_775.ogg"
    tianqin "그렇게 기대하지 마!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_945334c7:



    voice "voice/jiaozi_22.ogg"
    jiaozi 0103 "멍!"


translate japanese plot4_3b443c04:


    "가게 밖에서는 자오쯔가 애처로운 눈으로 두 사람을 바라보고 있었다."


translate japanese plot4_ee821cd1:



    voice "voice/tianqin_776.ogg"
    tianqin "아, 맞다! 자오쯔를 잊었네."


translate japanese plot4_c574303e:



    voice "voice/tianqin_777.ogg"
    tianqin "자오쯔 햄버거도 사 올게."


translate japanese plot4_f5e0e788:



    voice "voice/jiaozi_05.ogg"
    jiaozi 0102 "멍멍!"


translate japanese plot4_a7f7cf91:



    voice "voice/tianqin_778.ogg"
    tianqin "그럼 이제……"


translate japanese plot4_86bb6bfb:



    voice "voice/tianqin_779.ogg"
    tianqin "시노——"


translate japanese plot4_b028236e:



    voice "voice/tianqin_780.ogg"
    tianqin "크흠!…… 아사요, 이따 가고 싶은 곳 있어?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_4821568b:



    voice "voice/cygnus_522.ogg"
    cygnus "이 근처에서 아직 안 살펴본 건 네 학교뿐이야. 더 갈 곳은 없어."


translate japanese plot4_2a01650a:



    voice "voice/cygnus_523.ogg"
    cygnus "아까 졸리다고 했지? 그럼 오늘은 돌아가서 쉬자."


translate japanese plot4_7eb3ed75:



    voice "voice/tianqin_781.ogg"
    tianqin "아침부터 여기저기 끌려다녔더니 오히려 잠이 깨 버렸어……"


translate japanese plot4_12ee8988:



    voice "voice/tianqin_782.ogg"
    tianqin "그럼 나온 김에 이 근처를 조금 더 구경시켜 줄까?"


translate japanese plot4_92918161:



    voice "voice/cygnus_524.ogg"
    cygnus "그것도 좋겠네."


translate japanese plot4_17dfeadb:


    "라이라는 시노스를 데리고 근처 상점가와 슈퍼, 편의점 등 현대 사회의 시설들을 돌아봤다."


translate japanese plot4_107b983d:


    "이 세계의 편리한 생활은 시노스에게 놀라움의 연속이었다. 스마트폰 한 대만 있으면 거의 불편함 없이 살 수 있는 모양이었다."


translate japanese plot4_0c78b054:


    "마법을 쓸 수 없다는 점만 빼면 크게 불편한 것은 없었다."


translate japanese plot4_34831292:



    voice "voice/cygnus_525.ogg"
    cygnus "과학 기술이 이렇게 발전했다니…… 이 세계 사람들이 이룬 일은 정말 훌륭하네."


translate japanese plot4_722255bd:


    "시노스는 멀리 솟은 고층 빌딩을 올려다보며, 이 세계 사람들이 대체 어떻게 저 건물을 세웠을지 생각했다."


translate japanese plot4_10ece820:



    voice "voice/tianqin_783.ogg"
    tianqin "아하하, 우린 늘 이 안에서 살아서 그런지 오히려 그런 감동은 별로 없거든."


translate japanese plot4_6234a71b:



    voice "voice/cygnus_526.ogg"
    cygnus "이 세계에 온 뒤로는 줄곧 여유가 없었어. 이렇게 차분하게 이것저것 둘러보는 건 처음이야."


translate japanese plot4_592c076a:



    voice "voice/cygnus_527.ogg"
    cygnus "네 덕분에 이 세계에 대해 조금은 알게 됐어."


translate japanese plot4_f5ff03c5:



    voice "voice/tianqin_784.ogg"
    tianqin "후훗. 이 세계에는 아직도 시노스가 깜짝 놀랄 만한 게 잔뜩 있거든."


translate japanese plot4_5b1cabf6:



    voice "voice/cygnus_528.ogg"
    cygnus "여기도 그중 하나야?"


translate japanese plot4_a26bb40e:



    voice "voice/tianqin_785.ogg"
    tianqin "아, 아니. 여긴 내가 자주 오는 공원일 뿐이야. 딱히 특별한 곳은 아니고."


translate japanese plot4_d1e2202a:



    voice "voice/cygnus_529.ogg"
    cygnus "뭔가 대단한 비밀이라도 숨겨져 있는 줄 알았어."


translate japanese plot4_05a1959d:



    voice "voice/tianqin_786.ogg"
    tianqin "없어, 없어. 너희 세계에 비하면 이쪽은 훨씬 평범해."


translate japanese plot4_326ea173:



    voice "voice/cygnus_530.ogg"
    cygnus "후후…… 평범하다, 라……"


translate japanese plot4_d6b910de:


    "이 세계와 원래 있던 세계. 서로의 존재는 분명 상대방의 눈에 무척 특별하게 비칠 것이다."


translate japanese plot4_aec2e665:


    "그렇다면 무엇을 두고 「평범하다」고 하는 걸까. 지금의 시노스는 아직 그 답을 알지 못했다."


translate japanese plot4_e6300a6b:



    voice "voice/tianqin_787.ogg"
    tianqin "자, 보여 주고 싶었던 곳도 대충 다 돌았으니 이번에야말로 돌아갈까?"


translate japanese plot4_4540da67:



    voice "voice/cygnus_531.ogg"
    cygnus "응…"


translate japanese plot4_7bc1d5db:



    voice "voice/cygnus_532.ogg"
    cygnus "――!"


translate japanese plot4_90f08a3d:



    voice "voice/tianqin_788.ogg"
    tianqin "응? 아사요? 왜 그래?"


translate japanese plot4_a6e1cd12:



    voice "voice/cygnus_533.ogg"
    cygnus "잠깐. 마력 반응이 있어. 지금 위치를 찾는 중이야."


translate japanese plot4_e5f8fa72:



    voice "voice/tianqin_789.ogg"
    tianqin "뭐!? 정말!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_d47cd165:



    voice "voice/cygnus_534.ogg"
    cygnus "응. 상당히 강한 반응이야. 다만 이 근처는 아니야."


translate japanese plot4_c1906f9d:



    voice "voice/cygnus_535.ogg"
    cygnus "미안하지만 조금만 더 같이 가 줄래?"


translate japanese plot4_ee3695c2:



    voice "voice/tianqin_790.ogg"
    tianqin "섭섭하게 왜 그래. 애초에 아사요를 도와주려고 같이 온 건데."


translate japanese plot4_330df060:



    voice "voice/hunter_20.ogg"
    monolith "…"


translate japanese plot4_4402c0ae:



    voice "voice/hunter_21.ogg"
    monolith "（이상해. 탐지 마법에 반응이 없어.）"


translate japanese plot4_5e21f2f8:



    voice "voice/hunter_22.ogg"
    monolith "（방금까지 그렇게 강한 마력이 느껴졌는데…… 흔적이 전혀 남아 있지 않아.）"


translate japanese plot4_6e9c77bf:



    voice "voice/flame_14.ogg"
    ataset "아직도 못 찾았어～?"


translate japanese plot4_aa3e1536:



    voice "voice/hunter_23.ogg"
    monolith "재촉하지 마. 확인하러 온 거니까."


translate japanese plot4_2d5cb81d:



    voice "voice/flame_15.ogg"
    ataset "그래도～ 내 {a=dictionary:dict_entry_53}결계{/a}도 그렇게 오래는 못 버틴다고? 곧 누가 들어올지도 몰라."


translate japanese plot4_d84aad0a:



    voice "voice/hunter_24.ogg"
    monolith "됐으니까 조금만 더 기다려."


translate japanese plot4_190dbb19:



    voice "voice/hunter_25.ogg"
    monolith "계획에 없던 요소는 반드시 제거한다."


translate japanese plot4_f057fae9:



    voice "voice/hunter_26.ogg"
    monolith "（…역시 없어.）"


translate japanese plot4_9a951dd0:



    voice "voice/hunter_27.ogg"
    monolith "（이 작은 교회에 아직 뭔가 숨겨져 있다는 건가.）"


translate japanese plot4_ec55388e:



    voice "voice/flame_16.ogg"
    ataset "어머, 리스."


translate japanese plot4_098fe065:



    voice "voice/hunter_28.ogg"
    monolith "이번엔 또 뭐야. 결계가 한계야?"


translate japanese plot4_abe66bf2:



    voice "voice/flame_17.ogg"
    ataset "아니, 아니～ 그 애들이 오고 있어."


translate japanese plot4_4960a5a1:



    voice "voice/hunter_29.ogg"
    monolith "……쳇, 예상보다 빨라."


translate japanese plot4_85abda24:



    voice "voice/flame_18.ogg"
    ataset "어떡할까～?"


translate japanese plot4_aa901d95:



    voice "voice/hunter_30.ogg"
    monolith "마력의 흔적을 지운다. 가자."


translate japanese plot4_2f092915:



    voice "voice/flame_19.ogg"
    ataset "네～."


translate japanese plot4_3b7cdc7f:


    "두 사람이 떠나고 얼마 지나지 않아 라이라와 시노스도 이곳에 도착했다."


translate japanese plot4_b1351724:


    "시내에서 떨어진 이 교회는 오늘 꽤 북적이는 하루를 보내게 될 것 같았다."


translate japanese plot4_40f7d7a0:



    voice "voice/tianqin_791.ogg"
    tianqin "여기야?"


translate japanese plot4_404039be:



    voice "voice/cygnus_536.ogg"
    cygnus "응. 아까 느낀 마력 반응은 여기서 나왔어."


translate japanese plot4_fe3c533d:



    voice "voice/tianqin_792.ogg"
    tianqin "교회라…… 난 이런 곳에 한 번도 와 본 적 없어."


translate japanese plot4_62876fe8:


    "룽화시는 세계적으로 교회가 많은 도시로 알려져 있다. 하지만 라이라는 이런 장소에 특별한 관심을 가져 본 적이 없었다."


translate japanese plot4_b33bf3e9:



    voice "voice/cygnus_537.ogg"
    cygnus "그러고 보니 궁금한 게 있어. 너희 세계에는 신이 없잖아? 그런데 왜 교회가 있는 거야?"


translate japanese plot4_ea1039f6:



    voice "voice/tianqin_793.ogg"
    tianqin "어?"


translate japanese plot4_2a34a94d:



    voice "voice/cygnus_538.ogg"
    cygnus "그렇게 이상한 질문이었어?"


translate japanese plot4_90c9151f:



    voice "voice/tianqin_794.ogg"
    tianqin "아니, 그런 뜻이 아니라…… 애초에 신의 존재를 믿는 건 신자들뿐이잖아?"


translate japanese plot4_14525976:



    voice "voice/cygnus_539.ogg"
    cygnus "그게 아니야. 이 세계에는 신 자체가 존재하지 않을 텐데."


translate japanese plot4_151fada9:



    voice "voice/tianqin_795.ogg"
    tianqin "음…… 과학적으로 생각하면 그렇긴 하겠지."


translate japanese plot4_59cfc323:



    voice "voice/cygnus_540.ogg"
    cygnus "그러니까 이 세계 사람들은 실재하지 않는 신을 믿는다는 거야?"


translate japanese plot4_7d5c57ef:



    voice "voice/tianqin_796.ogg"
    tianqin "그런 논리가 아니야. 신이 있다고 믿으니까 그 신을 신앙하는 거라고."


translate japanese plot4_b4746e56:



    voice "voice/cygnus_541.ogg"
    cygnus "하지만 이 세계에는 신이 없잖아?"


translate japanese plot4_63945933:



    voice "voice/cygnus_542.ogg"
    cygnus "마나조차 없으니 신앙으로 신이 현현하는 일도 없을 테고."


translate japanese plot4_fe3b9eaf:



    voice "voice/tianqin_797.ogg"
    tianqin "그렇긴 할지도 모르지만…… 신자들은 정말로 신이 있다고 믿고 있어."


translate japanese plot4_144fbc43:



    voice "voice/tianqin_798.ogg"
    tianqin "――어? 잠깐. 그럼…… 아사요의 세계에는 정말 신이 있어?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_48d9aee4:



    voice "voice/cygnus_543.ogg"
    cygnus "응, 당연하지."


translate japanese plot4_2fb17b89:



    voice "voice/cygnus_544.ogg"
    cygnus "교회의 고리타분한 녀석들이 다루는 힘도 자신들이 믿는 「질서의 신」에게 받은 거야."


translate japanese plot4_2aafa548:



    voice "voice/cygnus_545.ogg"
    cygnus "게다가 마법사 중에도 마법의 이치를 신처럼 떠받드는 녀석이 적지 않아. 바보 같은 짓이지."


translate japanese plot4_a2adb58b:



    voice "voice/tianqin_799.ogg"
    tianqin "정말 신기하다……"


translate japanese plot4_8e231373:



    voice "voice/tianqin_800.ogg"
    tianqin "신이 실제로 나타나는 건 어떤 느낌일까. 한 번 보고 싶어!"


translate japanese plot4_74ec889c:



    voice "voice/cygnus_546.ogg"
    cygnus "아―― 별로 재미있는 건 아니야."


translate japanese plot4_5caef64b:



    voice "voice/tianqin_801.ogg"
    tianqin "아사요는 그 세계의 신을 만나 본 적 있어?"


translate japanese plot4_b04794e5:



    voice "voice/cygnus_547.ogg"
    cygnus "기억은 안 나지만…… 어렴풋한 느낌으로는 몇 번 있었을 거야. ……뭐, 어차피 따분한 경험이었겠지."


translate japanese plot4_a0b8b3fa:



    voice "voice/cygnus_548.ogg"
    cygnus "자, 잡담은 이쯤 하자. 먼저 들어갈게."


translate japanese plot4_0ce4a9cf:



    voice "voice/tianqin_802.ogg"
    tianqin "아, 들어가면 안에 있는 신자들 앞에서 방금 같은 소리 하면 안 돼!"


translate japanese plot4_011e4fb6:


    "두 사람이 교회 안으로 들어서자 사방이 고요했다."


translate japanese plot4_0d5855b6:


    "제단에도 성직자의 모습은 없었고, 예배당에는 나이 든 참배객 몇 명만 있었다. 사람들은 저마다 긴 의자에 앉아 손에 든 성서를 읽고 있어, 교회에 들어온 두 사람을 눈치채지 못한 듯했다."


translate japanese plot4_34f10fd9:



    voice "voice/cygnus_549.ogg"
    cygnus "무척 조용하네. 상상했던 것과는 꽤 달라."


translate japanese plot4_c08cebce:



    voice "voice/tianqin_803.ogg"
    tianqin "오늘은 토요일이니까. 본격적인 예배는 내일이거든."


translate japanese plot4_fa1ab2d2:



    voice "voice/cygnus_550.ogg"
    cygnus "역시 신이 없는 세계라서――"


translate japanese plot4_6f80c63a:



    voice "voice/tianqin_804.ogg"
    tianqin "쉿! 그러니까 그런 얘기는 그만하라니까!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_c149ce4d:


    "라이라의 안내를 받으며 시노스는 예배당을 한 바퀴 둘러보았다. 참배객들도 두 사람을 잠깐 바라볼 뿐, 특별히 신경 쓰는 기색은 없었다."


translate japanese plot4_3a16ce6f:



    voice "voice/tianqin_805.ogg"
    tianqin "뭐 좀 알아냈어?"


translate japanese plot4_f412feb5:



    voice "voice/cygnus_551.ogg"
    cygnus "아직. 그 마력 반응은 이 예배당에 있지 않을 거야."


translate japanese plot4_a9383cf1:



    voice "voice/cygnus_552.ogg"
    cygnus "안쪽으로 들어갈 수 있어?"


translate japanese plot4_4c8f39fc:



    voice "voice/tianqin_806.ogg"
    tianqin "저기는 관계자 외 출입 금지 아닐까."


translate japanese plot4_5f339b50:



    voice "voice/cygnus_553.ogg"
    cygnus "들키면 길을 잘못 들었다고 하면 돼."


translate japanese plot4_a6d0482b:



    voice "voice/tianqin_807.ogg"
    tianqin "그럼 나도 같이――"


translate japanese plot4_cf034e80:



    voice "voice/cygnus_554.ogg"
    cygnus "됐어. 넌 눈에 띄니까 나 혼자면 돼."


translate japanese plot4_f8c0d58e:



    voice "voice/tianqin_808.ogg"
    tianqin "너무해!"


translate japanese plot4_11d8a58f:



    voice "voice/hecheng_049.ogg"
    hecheng2 "라이라?"


translate japanese plot4_ea1039f6_1:



    voice "voice/tianqin_809.ogg"
    tianqin "어?"


translate japanese plot4_6475ded7:



    voice "voice/tianqin_810.ogg"
    tianqin "츠루기!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_08fffed2:


    "뒤돌아본 라이라는 그곳에 서 있는 반 친구를 알아보고 작게 소리쳤다. 그 소리에 예배당 안의 사람들이 일제히 이쪽으로 고개를 돌렸다."


translate japanese plot4_b9f10da3:



    voice "voice/hecheng_050.ogg"
    hecheng "조용히 해."


translate japanese plot4_1fb6625d:



    voice "voice/tianqin_811.ogg"
    tianqin "미안, 미안……"


translate japanese plot4_6613c325:



    voice "voice/hecheng_51.ogg"
    hecheng "여긴 웬일이야? 그리고 옆에 있는 애는?"


translate japanese plot4_74ac7a38:



    voice "voice/tianqin_812.ogg"
    tianqin "아…… 먼 친척 애야. 시…… 아사요라고 해."


translate japanese plot4_a8311cfb:



    voice "voice/tianqin_813.ogg"
    tianqin "종교 같은 데 관심이 있나 봐. 마침 기회가 돼서 구경시켜 주러 왔어."


translate japanese plot4_078bd15a:



    voice "voice/hecheng_52.ogg"
    hecheng "그렇구나."


translate japanese plot4_c12749c9:



    voice "voice/cygnus_555.ogg"
    cygnus "（아니야. 난 마법의 이치에 평생을 바칠 몸이야. 이 세계의 가공의 신 따위는 절대 믿지 않아.）"


translate japanese plot4_c96a7216:



    voice "voice/tianqin_814.ogg"
    tianqin "（쉿! 설정! 지금 건 아사요의 설정이야!）" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_f51687fa:



    voice "voice/tianqin_815.ogg"
    tianqin "그, 그런데 츠루기는? 넌 왜 여기 있어?"


translate japanese plot4_8924eb9e:



    voice "voice/hecheng_53.ogg"
    hecheng "부모님 따라왔어."


translate japanese plot4_1a606130:



    voice "voice/hecheng_54.ogg"
    hecheng "내일 예배는 사람이 많으니까. 붐비는 게 싫어서 하루 일찍 오신 모양이야."


translate japanese plot4_7f125561:



    voice "voice/tianqin_816.ogg"
    tianqin "（예배를 미리 드릴 수도 있는 거야…?）"


translate japanese plot4_97649815:



    voice "voice/tianqin_817.ogg"
    tianqin "부모님이 신자셔?"


translate japanese plot4_e0e812ca:



    voice "voice/hecheng_55.ogg"
    hecheng "아니겠지. 예배를 앞당겨 드리는 신자가 어디 있겠어."


translate japanese plot4_c08bf749:


    "그렇게 말하며 츠루기도 작게 웃었다."


translate japanese plot4_d2ad4617:



    voice "voice/tianqin_818.ogg"
    tianqin "그럼 왜 오신 건데?"


translate japanese plot4_33c9bd6f:



    voice "voice/hecheng_56.ogg"
    hecheng "그냥 위안 삼아 온 거지. 이 교회는 우리 집에서 건축 자금을 댔거든."


translate japanese plot4_76ccfd20:



    voice "voice/tianqin_819.ogg"
    tianqin "뭐! 정말?"


translate japanese plot4_6fb77c61:



    voice "voice/hecheng_57.ogg"
    hecheng "우리 집에서 돈을 댄 거라면 이 밖에도 얼마든지 있어."


translate japanese plot4_73b8a20a:



    voice "voice/tianqin_820.ogg"
    tianqin "그렇긴 하네. 역시 부자들의 세계는 잘 모르겠어."


translate japanese plot4_2468e598:



    voice "voice/cygnus_556.ogg"
    cygnus "저기, 라이라 언니."


translate japanese plot4_8572fd21:



    voice "voice/cygnus_557.ogg"
    cygnus "나 저쪽에서 잠깐 놀다 올게."


translate japanese plot4_10ae9902:



    voice "voice/tianqin_821.ogg"
    tianqin "아, 응. 알았어."


translate japanese plot4_8caa3f51:



    voice "voice/tianqin_822.ogg"
    tianqin "그래도 꼭 돌아와야 해, 알았지?"


translate japanese plot4_337907c9:



    voice "voice/cygnus_558.ogg"
    cygnus "응, 알았어."


translate japanese plot4_65f1e8db:



    voice "voice/hecheng_58.ogg"
    hecheng "…"


translate japanese plot4_192c6b4d:



    voice "voice/hecheng_59.ogg"
    hecheng "동생을 잘도 혼자 놔두네."


translate japanese plot4_870b6d8c:



    voice "voice/tianqin_823.ogg"
    tianqin "괜찮아. 저 애, 의외로 야무지거든."


translate japanese plot4_6055b2df:



    voice "voice/hecheng_60.ogg"
    hecheng "네가 나중에 부모가 돼서도 이럴까 봐 좀 걱정되네."


translate japanese plot4_e150ba0e:



    voice "voice/tianqin_824.ogg"
    tianqin "에이, 그렇게 걱정 안 해도 돼. 보기보다 훨씬 어른스러운 애니까."


translate japanese plot4_52616230:



    voice "voice/hecheng_61.ogg"
    hecheng "휴… 어른스럽다, 이거지."


translate japanese plot4_d27b61c5:



    voice "voice/hecheng_62.ogg"
    hecheng "저런 꼬맹이들은 눈만 떼면 바로 사고를 친다고."


translate japanese plot4_936c4298:



    voice "voice/cygnus_559.ogg"
    cygnus "…"


translate japanese plot4_7a0c0b1e:



    voice "voice/cygnus_560.ogg"
    cygnus "（드디어 떨어졌네.）"


translate japanese plot4_9e029e05:



    voice "voice/cygnus_561.ogg"
    cygnus "（자… 어떻게 안쪽으로 들어가지.）"


translate japanese plot4_41c8e2ac:



    voice "voice/cygnus_562.ogg"
    cygnus "（뒷문 하나쯤은 있을 텐데…）"


translate japanese plot4_74d0e51a:



    voice "voice/cygnus_563.ogg"
    cygnus "（응? 이 꽃은…）"


translate japanese plot4_a3d9f3e1:


    "라이라와 츠루기는 빈 긴 의자를 찾아 앉았다."


translate japanese plot4_0f83a4b3:


    "넓은 예배당은 두 사람이 더해졌어도 소란스러워지지 않고 엄숙한 분위기를 유지했다."


translate japanese plot4_ad23a46d:



    voice "voice/tianqin_825.ogg"
    tianqin "（왠지 어색하네…）"


translate japanese plot4_6a814e70:


    "라이라는 이 침묵을 깰 화제를 찾느라 머리를 열심히 굴렸다."


translate japanese plot4_c88ecf16:


    "어제 츠루기에게 일어난 일이 두 사람의 대화에 그림자를 드리우고 있었다."


translate japanese plot4_bef9a207:



    voice "voice/tianqin_826.ogg"
    tianqin "（으으음…）"


translate japanese plot4_3573daaf:



    voice "voice/tianqin_827.ogg"
    tianqin "저기, 츠루기. 오늘은 훈련 없어? 이번 주에는 체육 특기생들 다 학교에 있잖아?"


translate japanese plot4_0b8f57c6:



    voice "voice/hecheng_63.ogg"
    hecheng "뭐, 부모님이 억지로 데려오셨을 뿐이야. 끝나면 학교로 돌아가."


translate japanese plot4_08bc26ea:



    voice "voice/hecheng_64.ogg"
    hecheng "봐, 교복 그대로잖아."


translate japanese plot4_07e6d53d:



    voice "voice/tianqin_828.ogg"
    tianqin "그럼…… 부모님은?"


translate japanese plot4_c3ff7060:



    voice "voice/hecheng_65.ogg"
    hecheng "예배당 안쪽."


translate japanese plot4_ee4bee80:



    voice "voice/tianqin_829.ogg"
    tianqin "기도하고 계셔?"


translate japanese plot4_be88fa3b:



    voice "voice/hecheng_66.ogg"
    hecheng "지금은 참회 중이려나."


translate japanese plot4_9a031a11:



    voice "voice/tianqin_830.ogg"
    tianqin "참회?"


translate japanese plot4_bef80022:



    voice "voice/hecheng_67.ogg"
    hecheng "뭐라고 해야 하나. 평소 회사 일 때문에 스트레스가 많으시거든. 그래서 매주 여기 와서 수녀원장님께 이야기를 털어놓는 거야."


translate japanese plot4_aeb983f0:



    voice "voice/tianqin_831.ogg"
    tianqin "그렇구나. 어른들도 힘드네."


translate japanese plot4_b39e035b:



    voice "voice/hecheng_68.ogg"
    hecheng "우리도 이제 어린애라고 할 나이는 아니잖아."


translate japanese plot4_834bfc19:



    voice "voice/tianqin_832.ogg"
    tianqin "난 아직 고등학생인걸. 전혀 어른이 아니야."


translate japanese plot4_8cf1e417:



    voice "voice/hecheng_69.ogg"
    hecheng "후후…… 고등학생이냐 아니냐로 어른인지를 가르는 거야?"


translate japanese plot4_277dcbec:



    voice "voice/tianqin_833.ogg"
    tianqin "그렇지!"


translate japanese plot4_71e08e60:



    voice "voice/tianqin_834.ogg"
    tianqin "…"


translate japanese plot4_b5da695a:



    voice "voice/tianqin_835.ogg"
    tianqin "츠루기."


translate japanese plot4_7c6f297f:



    voice "voice/hecheng_70.ogg"
    hecheng "응?"


translate japanese plot4_2d9559b3:



    voice "voice/tianqin_836.ogg"
    tianqin "어제 일…… 괜찮아?"


translate japanese plot4_b63bdb12:



    voice "voice/hecheng_71.ogg"
    hecheng "아, 그 장난."


translate japanese plot4_7ef6be5c:



    voice "voice/tianqin_256.ogg"
    tianqin "응…"


translate japanese plot4_65f1e8db_1:



    voice "voice/hecheng_72.ogg"
    hecheng "…"


translate japanese plot4_c09612a5:



    voice "voice/hecheng_73.ogg"
    hecheng "괜찮다고 해도 넌 안 믿겠지."


translate japanese plot4_ed49a85d:



    voice "voice/hecheng_74.ogg"
    hecheng "솔직히 지금도 흰쥐 생각을 하면 기분이 나빠. 머릿속도 뒤죽박죽이고."


translate japanese plot4_4475cb1f:



    voice "voice/tianqin_838.ogg"
    tianqin "미안해……"


translate japanese plot4_c1e1c9ac:



    voice "voice/hecheng_75.ogg"
    hecheng "사과할 필요 없어. 조금 시간이 필요할 뿐이야."


translate japanese plot4_38ded657:



    voice "voice/tianqin_839.ogg"
    tianqin "그래도 정말 너무해. 우리 반에 그런 짓을 할 사람이 있을 줄은 몰랐어."


translate japanese plot4_efb65723:



    voice "voice/hecheng_76.ogg"
    hecheng "범인은 반드시 찾아낼 거야."


translate japanese plot4_0cf9874d:



    voice "voice/hecheng_77.ogg"
    hecheng "너도 알잖아. 우리 반엔 전부터 나를 아니꼽게 보는 녀석들이 있어."


translate japanese plot4_e152f4e3:



    voice "voice/hecheng_78.ogg"
    hecheng "솔직히 그건 나도 마찬가지지만."


translate japanese plot4_107255aa:



    voice "voice/hecheng_79.ogg"
    hecheng "다만 그 정도로 사이가 험악하진 않았어. 그런데 이번에는 갑자기 간이라도 커진 것 같더라."


translate japanese plot4_2151964c:



    voice "voice/tianqin_840.ogg"
    tianqin "담임 선생님께 말씀드렸어?"


translate japanese plot4_2da9cbb0:



    voice "voice/hecheng_80.ogg"
    hecheng "아니. 이건 내가 해결해."


translate japanese plot4_b34830bb:



    voice "voice/hecheng_81.ogg"
    hecheng "담임이 알아 봤자 달라질 건 없어. 대충 좋게좋게 넘어가려고 하겠지. 그게 어른들 방식이니까."


translate japanese plot4_2e6e001c:



    voice "voice/tianqin_841.ogg"
    tianqin "그렇지 않아. 우리 담임은 책임감 있으시잖아. 분명 도와주실 거야."


translate japanese plot4_7b5001cf:



    voice "voice/hecheng_82-83.ogg"
    hecheng "신경 써 줄 필요 없어. 그런 짓을 한 녀석에게는 그만한 대가를 치르게 할 거니까."


translate japanese plot4_55113f34:



    voice "voice/tianqin_842.ogg"
    tianqin "하지만…"


translate japanese plot4_7db0a904:



    voice "voice/npc3_07.ogg"
    npc47 "츠루기!"


translate japanese plot4_6270eea2:


    "교회 안쪽에서 부르는 목소리가 울려 퍼지며 라이라의 말을 끊었다. 하지만 예배당에 있던 사람들은 아무도 신경 쓰지 않았다. 마치 늘 있는 일이라는 듯이."


translate japanese plot4_719414a1:



    voice "voice/hecheng_84.ogg"
    hecheng "……엄마가 부르네."


translate japanese plot4_b7c36ed5:



    voice "voice/hecheng_85.ogg"
    hecheng "먼저 갈게."


translate japanese plot4_d9522f7f:



    voice "voice/tianqin_843.ogg"
    tianqin "츠루기, 잠깐……"


translate japanese plot4_45e221e3:


    "라이라의 목소리를 뒤로하고 츠루기는 그대로 교회 안쪽으로 걸어갔다."


translate japanese plot4_7f9c6fd4:


    "『관계자 외 출입 금지』라는 팻말이 앞을 가로막았다. 뒤따라가려던 라이라도 차마 그 너머로 들어갈 수는 없었다."


translate japanese plot4_5e76e389:



    voice "voice/cygnus_564.ogg"
    cygnus "다녀왔어."


translate japanese plot4_62088ed9:



    voice "voice/tianqin_844.ogg"
    tianqin "어……"


translate japanese plot4_34776cdc:



    voice "voice/cygnus_565.ogg"
    cygnus "……무슨 일 있었어?"


translate japanese plot4_aa364d86:



    voice "voice/tianqin_845.ogg"
    tianqin "아니. 그냥 학교 일로 조금 고민하고 있었어."


translate japanese plot4_88790888:



    voice "voice/tianqin_846.ogg"
    tianqin "너는 어땠어? 뭐 좀 찾았어?"


translate japanese plot4_ab6b6960:



    voice "voice/cygnus_566.ogg"
    cygnus "아니…… 여기에는 마력의 흔적이 전혀 남아 있지 않았어."


translate japanese plot4_0ef1e05c:



    voice "voice/cygnus_567.ogg"
    cygnus "방금까지만 해도 그렇게 강한 반응이었는데, 여기 오자마자 아무것도 느껴지지 않아."


translate japanese plot4_2e715548:



    voice "voice/cygnus_568.ogg"
    cygnus "마치 누군가 일부러 감춘 것 같아……"


translate japanese plot4_b7f6edd1:



    voice "voice/tianqin_847.ogg"
    tianqin "못 찾았어도 괜찮아. 월요일이 되면 학교도 안내해 줄게."


translate japanese plot4_69435390:



    voice "voice/tianqin_848.ogg"
    tianqin "의외로 학교에 단서가 있을지도 모르잖아?"


translate japanese plot4_9df29cad:



    voice "voice/cygnus_569.ogg"
    cygnus "……그러면 좋겠네."


translate japanese plot4_9c4c369a:



    voice "voice/tianqin_849.ogg"
    tianqin "그런데 손에 든 건……"


translate japanese plot4_c3f4087e:



    voice "voice/cygnus_570.ogg"
    cygnus "꽃 말이야? 아까 교회 밖에서 꺾었어."


translate japanese plot4_798f296b:



    voice "voice/cygnus_571.ogg"
    cygnus "왜인지는 모르겠지만 본 적이 있는 것 같아서."


translate japanese plot4_beb0c8cc:



    voice "voice/tianqin_850.ogg"
    tianqin "그거, 전에 내가 집에 가져온 꽃이잖아."


translate japanese plot4_ab1ef30d:



    voice "voice/cygnus_572.ogg"
    cygnus "……아. 생각났어."


translate japanese plot4_6b1e3da6:



    voice "voice/cygnus_573.ogg"
    cygnus "어디서 봤다 싶었어."


translate japanese plot4_7b071f93:



    voice "voice/tianqin_851.ogg"
    tianqin "후훗. 그럼 그 꽃도 집에서 키울까?"


translate japanese plot4_84b105ae:



    voice "voice/cygnus_574.ogg"
    cygnus "그러자."


translate japanese plot4_65f1e8db_2:



    voice "voice/hecheng_86.ogg"
    hecheng "…"


translate japanese plot4_038d2d98:



    voice "voice/npc25_01.ogg"
    npc25 "자, 이리 와서 제대로 기도하렴."


translate japanese plot4_14d2e37f:



    voice "voice/npc25_02.ogg"
    npc25 "경건한 마음으로 해야지. 다음 주에는 중요한 사업 협상이 있으니까."


translate japanese plot4_c1cc695e:



    voice "voice/npc25_03.ogg"
    npc25 "정성을 들이지 않으면 하느님도 도와주시지 않는단다."


translate japanese plot4_64dfd911:



    voice "voice/hecheng_87.ogg"
    hecheng "알았어요, 엄마."


translate japanese plot4_9c6d0abb:


    "부모님의 어설픈 신앙심을 보고 츠루기는 저도 모르게 웃음이 나올 뻔했다."


translate japanese plot4_8c8593ae:


    "두 사람이 이곳에 온 것은 신앙 때문이 아니었다. 그저 앞으로 사업이 잘되기를 바랄 뿐이었다."


translate japanese plot4_c90efc54:


    "물론 그런 경멸을 겉으로 드러내지는 않았다. 형식뿐인 이런 예배에는 이미 익숙해져 있었다."


translate japanese plot4_128da709:


    "츠루기는 말없이 부모님 뒤에 서서 수녀 앞에서 기도하는 시늉을 했다."


translate japanese plot4_65f1e8db_3:



    voice "voice/hecheng_86.ogg"
    hecheng "…"


translate japanese plot4_d558b907:



    voice "voice/hecheng_89.ogg"
    hecheng "（이 세상에 정말 신 같은 게 있기는 한 걸까?）"


translate japanese plot4_f5a16871:


    voice "voice/npc25_04.ogg"
    npc25 "안나 수녀님. 여기 다니기 시작한 뒤로 신기하게 일이 잘 풀리는 것 같아요."


translate japanese plot4_1f65436b:



    voice "voice/npc25_05.ogg"
    npc25 "분명 하느님께서 지켜봐 주고 계신 거겠죠."


translate japanese plot4_3cb5994c:



    voice "voice/npc26_01.ogg"
    npc26 "하느님께서는 언제나 모든 사람을 지켜보고 계십니다."


translate japanese plot4_442941ca:


    "…"


translate japanese plot4_4ad5abb6:



    voice "voice/hecheng_90.ogg"
    hecheng "하아……"


translate japanese plot4_170b9876:


    "부모님과 수녀의 지루한 대화가 끝나길 기다리며 츠루기는 교회 안을 정처 없이 돌아다녔다."


translate japanese plot4_1d0773b0:


    "입에서 나오는 말은 하나같이 거짓말뿐이었다."


translate japanese plot4_66083082:


    "부모님은 안심을 사기 위해 매주 빠짐없이 이곳을 찾는다."


translate japanese plot4_43ed8678:


    "교회는 교회대로 가문의 후원과 기부금을 원한다."


translate japanese plot4_c1c10a90:


    "서로의 속셈은 뻔히 보인다. 다만 아무도 입에 담지 않을 뿐이다."


translate japanese plot4_d0728059:



    voice "voice/hecheng_91.ogg"
    hecheng "（정말 지루하네… 어른들이란.）"


translate japanese plot4_d8a82b86:



    voice "voice/npc3_08.ogg"
    npc46 "찍찍——"


translate japanese plot4_d3dc258b:



    voice "voice/hecheng_92.ogg"
    hecheng "——!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_f266130e:


    "교회 구석에서 희미한 소리가 들리자 츠루기의 어깨가 살짝 굳었다."


translate japanese plot4_944cd6ff:


    "어떤 이유로, 그 울음소리에는 귀에 익은 구석이 있었다."


translate japanese plot4_a092de06:


    "시선을 돌린 곳―― 구석에 있는 고해실 앞에서 무언가가 이쪽을 노려보고 있었다."


translate japanese plot4_b85d9a16:


    "흰쥐였다."


translate japanese plot4_5ed9cf0f:


    "원예부에서 봤던 그 녀석과 꼭 닮은 흰쥐가 뒷발로 일어서서 츠루기를 빤히 바라보고 있었다."


translate japanese plot4_70e93f3e:



    voice "voice/hecheng_93.ogg"
    hecheng "뭐……"


translate japanese plot4_f7d2e677:


    "츠루기는 쥐를 쫓아내려고 발을 내디뎠지만, 두세 걸음 만에 멈춰 섰다."


translate japanese plot4_b21ec746:


    "머릿속을 스친 것은 책상 속에 쑤셔 넣어져 있던 수많은 흰쥐였다."


translate japanese plot4_fc26353d:


    "그때와 똑같았다. 눈앞의 한 마리에게서도 말로 할 수 없는 섬뜩함이 풍겼다."


translate japanese plot4_0d0f38da:


    "이 흰쥐는 들켰다는 걸 알 텐데도 도망치려 하지 않았다."


translate japanese plot4_3a404af7:


    "쥐는 그저 꼿꼿이 서서 츠루기를 마주 보고 있었다."


translate japanese plot4_fe6e980a:


    "마치 이 신성한 교회를 자신의 더러움으로 오염시키고, 신자들이 믿는 신을 비웃는 것만 같았다."


translate japanese plot4_695c9974:



    voice "voice/hecheng_94.ogg"
    hecheng "안나 수녀님, 저쪽에 쥐가 한 마리 있어요."


translate japanese plot4_f8ea004d:



    voice "voice/npc26_02.ogg"
    npc26 "네? 쥐라고요? 그럴 리가……"


translate japanese plot4_bc5399a9:



    voice "voice/hecheng_95.ogg"
    hecheng "방금 봤어요. 고해실 근처에 있었어요. 누구를 시켜서 처리하는 게 좋겠어요."


translate japanese plot4_d336b26e:



    voice "voice/npc26_03.ogg"
    npc26 "아, 알겠습니다. 바로 사람을 보내 확인하겠습니다."


translate japanese plot4_65f1e8db_4:



    voice "voice/hecheng_96.ogg"
    hecheng "…"


translate japanese plot4_b15ae3a0:



    voice "voice/hecheng_97.ogg"
    hecheng "（재수 없어.）"


translate japanese plot4_24397fe1:



    voice "voice/cygnus_575.ogg"
    cygnus "잘 먹었어."


translate japanese plot4_dc2154d4:



    voice "voice/tianqin_852.ogg"
    tianqin "어? 벌써? 아직 많이 남았는데."


translate japanese plot4_975b45f0:



    voice "voice/cygnus_576.ogg"
    cygnus "……이만큼을 다 먹을 수 있는 건 너 정도겠지."


translate japanese plot4_bbee54bf:



    voice "voice/tianqin_853.ogg"
    tianqin "정말! 난 남들보다 조금 더 먹을 뿐이라니까!"


translate japanese plot4_110e414c:



    voice "voice/cygnus_577.ogg"
    cygnus "（조금……?）"


translate japanese plot4_bd0ec6a9:


    "시노스는 식탁 가득 차려진 요리를 보고 고개를 저었다."


translate japanese plot4_6da4b2e7:


    "요 며칠 사이에 확실히 알게 됐다. 라이라의 식사량은 이 세계의 보통 사람과는 비교가 되지 않았다."


translate japanese plot4_618fa339:



    voice "voice/cygnus_578.ogg"
    cygnus "남은 건 네가 먹어도 돼. 난 먼저 씻을게."


translate japanese plot4_2c08338c:



    voice "voice/tianqin_854.ogg"
    tianqin "아, 온수기 켜 줄까?"


translate japanese plot4_4cb4b587:



    voice "voice/cygnus_579.ogg"
    cygnus "아니. 쓰는 법은 이제 알아."


translate japanese plot4_93caea86:



    voice "voice/tianqin_52.ogg"
    tianqin "후……"


translate japanese plot4_b7f0d931:



    voice "voice/tianqin_855.ogg"
    tianqin "오, 시노스. 다 씻었어?"


translate japanese plot4_26ef71cd:



    voice "voice/tianqin_856.ogg"
    tianqin "잠깐만 기다려. 운동이 조금 있으면 끝나거든."


translate japanese plot4_4eb15186:



    voice "voice/tianqin_857.ogg"
    tianqin "아흔여섯…… 아흔일곱……"


translate japanese plot4_72555bea:



    voice "voice/cygnus_581.ogg"
    cygnus "（또 시작이네…）"


translate japanese plot4_e75e4dfd:


    "욕실에서 나오자 거실에서 한 손으로 팔굽혀펴기를 하는 라이라가 눈에 들어왔다."


translate japanese plot4_f2fe000c:



    voice "voice/tianqin_858.ogg"
    tianqin "아흔여덟…… 아흔아홉――"


translate japanese plot4_2fd65853:



    voice "voice/tianqin_859.ogg"
    tianqin "――백! 후우!"


translate japanese plot4_f5bc787a:



    voice "voice/cygnus_582.ogg"
    cygnus "매일 하는 거야?"


translate japanese plot4_2457d18b:



    voice "voice/tianqin_860.ogg"
    tianqin "응, 그래. 이다음에는 반대 손으로도 백 번 하고."


translate japanese plot4_936c4298_1:



    voice "voice/cygnus_583.ogg"
    cygnus "…"


translate japanese plot4_physique_observation_3_74052bcc:



    voice "voice/cygnus_584.ogg"
    cygnus "（이 녀석… 어쩌면 신체 능력이 상당한 건가?）"


translate japanese plot4_physique_observation_3_f5b60178:



    voice "voice/tianqin_861.ogg"
    tianqin "시노스도 같이 운동할래?"


translate japanese plot4_physique_observation_3_9631d4f8:



    voice "voice/cygnus_585.ogg"
    cygnus "사양할게. 난 따라 할 엄두가 안 나."


translate japanese plot4_physique_observation_3_28b01801:



    voice "voice/tianqin_862.ogg"
    tianqin "에이. 괜찮아. 조금씩 하면 되잖아."


translate japanese plot4_physique_observation_3_844f586d:



    voice "voice/cygnus_586.ogg"
    cygnus "싫어. 난 컴퓨터 쓸 거야."


translate japanese plot4_physique_observation_3_07085acc:



    voice "voice/tianqin_863.ogg"
    tianqin "으윽……! 맨날 컴퓨터만 하면 안 돼. 가끔은 운동도 해야지."


translate japanese plot4_physique_observation_3_a0d65804:



    voice "voice/cygnus_587.ogg"
    cygnus "오늘은 하루 종일 마도구를 찾느라 걸어 다녔어. 운동이라면 충분해."


translate japanese plot4_physique_observation_3_9d173f37:



    voice "voice/cygnus_588.ogg"
    cygnus "참. 월요일에 학교에 데려가는 거 잊지 마."


translate japanese plot4_physique_observation_3_38fb6600:



    voice "voice/tianqin_864.ogg"
    tianqin "알았대도!"


translate japanese plot4_physique_observation_3_704351bb:



    voice "voice/gt_05.ogg"
    npc109 "…"


translate japanese plot4_physique_observation_3_d1130e3a:


    nvlNone "마을의 의뢰를 받고,\n우리는 대기 중을 떠도는 이상한 마나를 쫓고 있었다." with Dissolve(0.35)


translate japanese plot4_physique_observation_3_b1837294:


    nvlNone "그렇게 도착한 곳은 마을에서 멀리 떨어진 유적의 가장 깊은 곳이었다."


translate japanese plot4_physique_observation_3_ba4bf84c:


    nvlNone "그래도 신세를 진 마을 사람들에게 보답할 겸, 유적 안을 조사해 보기로 했다."


translate japanese plot4_physique_observation_3_5c3676e6:


    nvlNone "아무래도 「열쇠」를 찾는 일은\n한동안 또 진전이 없을 것 같았다."


translate japanese plot4_physique_observation_3_d41d8cd9:


    voice "voice/npc27_01.ogg"


translate japanese plot4_relic_golem_roar_742351f0:



    voice "voice/dorothea_05.ogg"
    dorothea "우와…… 왜 이렇게 {a=dictionary:dict_entry_54}그레임{/a}이 잔뜩 있는 거야……"


translate japanese plot4_relic_golem_roar_a5593da6:



    voice "voice/equinox_09.ogg"
    equinox "쉿! 그레임은 소리에 반응해."


translate japanese plot4_relic_golem_roar_9d28c46c:



    voice "voice/champion_09.ogg"
    champion "…"


translate japanese plot4_relic_golem_roar_7582000d:


    "우리 앞에는 유적의 중추로 이어지는 긴 통로가 뻗어 있었다."


translate japanese plot4_relic_golem_roar_9d71f092:


    "앞길을 가로막은 것은 함정도 장치도 아니었다. 이미 가동 중인 십여 기의 그레임이었다."


translate japanese plot4_relic_golem_roar_5f4623ba:



    voice "voice/champion_10.ogg"
    champion "아사요. 이 유적, 어떻게 생각해?"


translate japanese plot4_relic_golem_roar_73cc681e:



    voice "voice/equinox_10.ogg"
    equinox "음…… 들어올 때부터 느꼈지만 여기까지 와 보니 확신이 서."


translate japanese plot4_relic_golem_roar_ccdfc9c9:



    voice "voice/equinox_11.ogg"
    equinox "여긴 어느 마녀가 남긴 공방의 유적이야."


translate japanese plot4_relic_golem_roar_6cfd23e0:



    voice "voice/equinox_12.ogg"
    equinox "게다가 상당한 은둔자였겠지. 공방을 요새처럼 만들어 놨어."


translate japanese plot4_relic_golem_roar_17b9d280:



    voice "voice/champion_11.ogg"
    champion "그 마녀의 기척을 감지할 수 있나?"


translate japanese plot4_relic_golem_roar_025e7306:



    voice "voice/equinox_13.ogg"
    equinox "기척이 없어. 벌써 죽었을 거야. 시설도 오랫동안 방치돼 있고."


translate japanese plot4_relic_golem_roar_4115113c:



    voice "voice/equinox_14.ogg"
    equinox "원래라면 그레임은 휴면 상태로 움직이지 않아야 해. 이렇게 돌아다니는 게 아니야."


translate japanese plot4_relic_golem_roar_74ba1b0e:



    voice "voice/equinox_15.ogg"
    equinox "마나 농도 이상에 반응해서 멋대로 가동된 거겠지."


translate japanese plot4_relic_golem_roar_09f1b603:



    voice "voice/equinox_16.ogg"
    equinox "게다가 마물까지 생겨나기 시작했어. 이곳은 이미 마나에 의해 왜곡되고 있어."


translate japanese plot4_relic_golem_roar_45e7110c:



    voice "voice/champion_12.ogg"
    champion "그럼 얼른 해치우자."


translate japanese plot4_relic_golem_roar_45c01934:



    voice "voice/equinox_17.ogg"
    equinox "말은 쉽지. 어떻게?"


translate japanese plot4_relic_golem_roar_b1dbf6a6:



    voice "voice/equinox_18.ogg"
    equinox "이 수는 장난이 아니야. 마법으로 길은 뚫을 수 있지만 전부 쓰러뜨릴 수는 없어."


translate japanese plot4_relic_golem_roar_12e28473:



    voice "voice/champion_13.ogg"
    champion "그럴 필요 없어. 둘은 뒤를 맡아 줘."


translate japanese plot4_relic_golem_roar_68c9c292:



    voice "voice/equinox_19.ogg"
    equinox "뭐……"


translate japanese plot4_relic_golem_roar_a6037edf:


    "내가 질문을 꺼내기도 전에 용사는 회랑을 향해 일직선으로 뛰쳐나갔다."


translate japanese plot4_relic_golem_roar_2ccde822:



    voice "voice/npc27_02.ogg"
    npc27 "가아아아악!"


translate japanese plot4_relic_golem_roar_702417b2:


    "그레임이 반응하기도 전에 용사의 주먹이 두꺼운 외피를 꿰뚫었다."


translate japanese plot4_relic_golem_roar_1fa3e44e:


    "엄청난 충격은 그레임 내부의 핵까지 전해져 단번에 핵을 파괴했다."


translate japanese plot4_relic_golem_roar_21c81102:



    voice "voice/dorothea_06.ogg"
    dorothea "오오! 역시 용사! 멋져!"


translate japanese plot4_relic_golem_roar_52c819cf:



    voice "voice/equinox_20.ogg"
    equinox "말도 안 되네……"


translate japanese plot4_relic_golem_roar_165e8d9d:


    "쾅!" with Shake((0, 0, 0, 0), 0.55, dist=10)


translate japanese plot4_relic_golem_roar_831674ac:


    "우리의 감탄을 듣지도 못한 채, 다음 순간 용사는 또 몇 기의 그레임을 부숴 버렸다."


translate japanese plot4_relic_golem_roar_f3380b4b:


    "원래라면 일류 마법사조차 고전할 마법 조형물. 하지만 용사 앞에서는 흙덩이처럼 무르기만 했다."


translate japanese plot4_relic_golem_roar_48e1f433:


    "모든 것을 분쇄할 듯한 그레임의 거대한 주먹은 손쉽게 막혔고,"


translate japanese plot4_relic_golem_roar_9f725e31:


    "대신 휘둘러지는 용사의 주먹은 어떤 마법보다도 치명적이었다."


translate japanese plot4_relic_golem_roar_089a6864:


    "허리의 검을 뽑을 필요조차 없었다. 맨손만으로 그레임 무리를 짓뭉갰다."


translate japanese plot4_relic_golem_roar_6c03798e:



    voice "voice/equinox_21.ogg"
    equinox "（여전히 상식 밖이네…… 적이 아니라서 정말 다행이야.）"


translate japanese plot4_relic_golem_roar_3b9c032b:



    voice "voice/champion_14.ogg"
    champion "뭘 멍하니 있어. 따라와."


translate japanese plot4_relic_golem_roar_3d05ad1a:



    voice "voice/dorothea_07.ogg"
    dorothea "네에——"


translate japanese plot4_relic_golem_roar_b1c224de:


    "그 뒤로 우리가 나설 일은 거의 없었다. 용사 혼자 그레임을 전부 해치워 버렸다."


translate japanese plot4_relic_golem_roar_76d6a0de:


    "우리도 어렵지 않게 유적의 가장 깊은 곳에 도착했다."


translate japanese plot4_relic_golem_roar_7a21d571:



    voice "voice/champion_15.ogg"
    champion "어때. 뭐 좀 찾았어?"


translate japanese plot4_relic_golem_roar_5442889c:



    voice "voice/equinox_22.ogg"
    equinox "응, 이쪽에 있었어."


translate japanese plot4_relic_golem_roar_305dac00:



    voice "voice/champion_16.ogg"
    champion "이게 전에 말했던……"


translate japanese plot4_relic_golem_roar_caf47223:



    voice "voice/equinox_23.ogg"
    equinox "그래. 바로 그거야."


translate japanese plot4_relic_golem_roar_5d979f90:



    voice "voice/equinox_24.ogg"
    equinox "마법협회에서도 아직 정식 명칭을 정하지 않아서, 일단 멋대로 『마나 결정』이라고 부르고 있어."


translate japanese plot4_relic_golem_roar_ecaec92a:



    voice "voice/dorothea_08.ogg"
    dorothea "이름 짓는 감각이 너무 없네……"


translate japanese plot4_relic_golem_roar_435ce7ae:



    voice "voice/equinox_25.ogg"
    equinox "쓸데없는 참견이야." with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_relic_golem_roar_be2ca3ce:



    voice "voice/champion_17.ogg"
    champion "이게 마나 이상의 원인이야?"


translate japanese plot4_relic_golem_roar_5819fbaa:



    voice "voice/equinox_26.ogg"
    equinox "반대야."


translate japanese plot4_relic_golem_roar_2a1dfa51:



    voice "voice/equinox_27.ogg"
    equinox "대기 중의 마나가 불안정해지고 농도가 일정 수준 이상으로 높아진 곳에 생겨나는 거야."


translate japanese plot4_relic_golem_roar_c6ab06da:



    voice "voice/champion_18.ogg"
    champion "이걸 부수면 여기도 원래대로 돌아오는 거 아냐?"


translate japanese plot4_relic_golem_roar_b15b0103:



    voice "voice/equinox_28.ogg"
    equinox 0401 "아니, 용사. 아직 이해하지 못했구나."


translate japanese plot4_relic_golem_roar_fc03022e:



    voice "voice/equinox_29.ogg"
    equinox 0410 "이건 『결과』이지 『원인』이 아니야."


translate japanese plot4_relic_golem_roar_5b7c9d37:



    voice "voice/equinox_30.ogg"
    equinox 0404 "부수면 잠깐 농도가 낮아지겠지만, 마나는 다시 여기에 모여."


translate japanese plot4_relic_golem_roar_13a34bcc:



    voice "voice/equinox_31.ogg"
    equinox 0405 "농도가 일정 수준에 이르면 같은 자리에 새 결정이 생겨나. 마물도 다시 늘어나고."


translate japanese plot4_relic_golem_roar_496ecd12:



    voice "voice/champion_19.ogg"
    champion "……그렇구나."


translate japanese plot4_relic_golem_roar_f8d0bb6a:



    voice "voice/equinox_32.ogg"
    equinox "일단 이걸 가져가자."


translate japanese plot4_relic_golem_roar_ab554562:



    voice "voice/equinox_33.ogg"
    equinox "적어도 그 마을은 한동안 평화롭겠지."


translate japanese plot4_relic_golem_roar_ecbc8f3f:


    "돌아가는 길에 용사는 어딘가 침울한 표정을 짓고 있었다."


translate japanese plot4_relic_golem_roar_f2e48f0a:


    "의뢰를 근본적으로 해결하지 못한 게 마음에 걸리는 모양이었다."


translate japanese plot4_relic_golem_roar_c78178cd:


    "힘은 있는데 닿지 않는다. 그런 답답함을 안고 있는 것 같았다."


translate japanese plot4_relic_golem_roar_c547dfcf:



    voice "voice/equinox_34.ogg"
    equinox "（훗…）"


translate japanese plot4_relic_golem_roar_3b1dabdd:



    voice "voice/equinox_35.ogg"
    equinox "용사."


translate japanese plot4_relic_golem_roar_a3b32eb1:



    voice "voice/champion_20.ogg"
    champion "응?"


translate japanese plot4_relic_golem_roar_3af01e85:



    voice "voice/equinox_36.ogg"
    equinox "대기 중의 마나를 안정시키지는 못하지만,"


translate japanese plot4_relic_golem_roar_6f54c2c3:



    voice "voice/equinox_37.ogg"
    equinox "――이 정도는 할 수 있어."


translate japanese plot4_relic_ice_seal_text_907ccd1f:



    voice "voice/equinox_38.ogg"
    equinox "이러면 앞으로 여기에 마나 결정이 다시 생겨도, 함께 생겨나는 마물은 얼음 속에 갇힐 뿐이야."


translate japanese plot4_relic_ice_seal_text_2eb525b7:



    voice "voice/equinox_39.ogg"
    equinox "근처의 마물 수를 조금은 줄일 수 있겠지."


translate japanese plot4_relic_ice_seal_text_b0c0cf07:



    voice "voice/champion_21.ogg"
    champion "……고마워."


translate japanese plot4_relic_ice_seal_text_cabc5957:



    voice "voice/equinox_40.ogg"
    equinox "이 정도는 아무것도 아니야. 너도 결정을 양보해 줬잖아."


translate japanese plot4_relic_ice_seal_text_d51e9f2c:



    voice "voice/equinox_41.ogg"
    equinox "거래의 일부라고 생각하면 돼."


translate japanese plot4_relic_ice_seal_text_936c4298:



    voice "voice/cygnus_589.ogg"
    cygnus "…"


translate japanese plot4_relic_ice_seal_text_5a1330cf:



    voice "voice/cygnus_590.ogg"
    cygnus "……또 기억의 조각인가."


translate japanese plot4_relic_ice_seal_text_1701bc10:


    "마치 잊지 말라고 말하는 것처럼."


translate japanese plot4_relic_ice_seal_text_844f25da:


    "도로시아…… 용사……"


translate japanese plot4_relic_ice_seal_text_021c0d7e:


    "누구보다 잘 알아야 할 두 사람. 그런데 그녀들에 관한 일만은 도무지 기억나지 않는다."


translate japanese plot4_relic_ice_seal_text_0c68f1b8:


    "꿈에 나타나는 기억의 조각들은 때로는 선명하고, 때로는 흐릿하다."


translate japanese plot4_relic_ice_seal_text_cd739663:


    "나조차 저도 모르게 스스로에게 묻게 된다."


translate japanese plot4_memory_question_535496ba:



    voice "voice/tianqin_865.ogg"
    tianqin2 0302 "시노스으, 일어났어어?"


translate japanese plot4_memory_question_13614dd5:



    voice "voice/tianqin_866.ogg"
    tianqin2 0302 "아침 다 됐어어."


translate japanese plot4_memory_question_ef335861:



    voice "voice/cygnus_591.ogg"
    cygnus "알았어. 지금 갈게."


translate japanese plot4_memory_question_5385f725:


    "월요일. 룽화 제1고등학교 교무실."


translate japanese plot4_memory_question_ed650223:


    "아침 일찍부터 학년부장이 긴급회의를 열었다."


translate japanese plot4_memory_question_2631abf8:


    "좁은 교무실에 학년 담당 교사들이 모여, 모두 부장의 손에 들린 종이 한 장을 바라보고 있었다."


translate japanese plot4_memory_question_e8793475:



    voice "voice/npc28_01.ogg"
    npc28 "…"


translate japanese plot4_memory_question_fe98a2c0:



    voice "voice/npc28_02.ogg"
    npc28 "긴급회의인 만큼 서론은 생략하겠습니다."


translate japanese plot4_memory_question_b1fdbc2c:



    voice "voice/npc28_03.ogg"
    npc28 "이 선생님, 이 편지는 어떻게 받으셨습니까?"


translate japanese plot4_memory_question_c4dd6ccc:



    voice "voice/banzhuren_34.ogg"
    banzhuren "오늘 아침 출근해 보니 책상 위에 놓여 있었습니다."


translate japanese plot4_memory_question_dd2b6e04:


    "편지에는 평범한 이야기가 아니라 학생들 사이의 {a=dictionary:dict_entry_55}괴롭힘{/a}을 고발하는 내용이 적혀 있었다. 그래서 교사들의 이목을 끌고 있었다."


translate japanese plot4_memory_question_658d199e:



    voice "voice/npc28_04.ogg"
    npc28 "누가 보냈는지 짐작 가는 바가 있습니까?"


translate japanese plot4_memory_question_c0948a14:



    voice "voice/banzhuren_35.ogg"
    banzhuren "인쇄된 거라 필적으로 판단할 수도 없습니다. 누가 썼는지는……"


translate japanese plot4_memory_question_5115fff8:



    voice "voice/npc28_05.ogg"
    npc28 "문체를 보고 누가 썼는지 짐작 가는 학생은 없습니까?"


translate japanese plot4_memory_question_e3712322:



    voice "voice/banzhuren_36.ogg"
    banzhuren "딱히 짐작 가는 학생은 없습니다."


translate japanese plot4_memory_question_5af5cde4:



    voice "voice/banzhuren_37.ogg"
    banzhuren "게다가 내용도 상당히 모호합니다. 구체적인 학생 이름이나 사건은 전혀 적혀 있지 않습니다."


translate japanese plot4_memory_question_f625d6e5:



    voice "voice/npc28_06.ogg"
    npc28 "……알게 되는 게 있으면 반드시 신속히 학교에 보고해 주십시오."


translate japanese plot4_memory_question_e93e2a80:



    voice "voice/banzhuren_38.ogg"
    banzhuren "알겠습니다."


translate japanese plot4_memory_question_408f3426:



    voice "voice/npc28_07.ogg"
    npc28 "이 선생님. 반 학생들에게 지금보다 더 주의를 기울여 주십시오."


translate japanese plot4_memory_question_f3ec2c3b:



    voice "voice/banzhuren_39.ogg"
    banzhuren "…"


translate japanese plot4_memory_question_83f5edc7:



    voice "voice/npc28_08.ogg"
    npc28 "이 편지는 무슨 일이 있어도 외부에 알려져서는 안 됩니다."


translate japanese plot4_memory_question_73f61b44:



    voice "voice/npc28_09.ogg"
    npc28 "이런 소문으로 룽화 제1고등학교의 명예가 훼손되게 둘 수는 없습니다."


translate japanese plot4_memory_question_51886497:



    voice "voice/npc28_10.ogg"
    npc28 "작년 체육 특기생 사건도 얼마나 애써서 밖에 알려지지 않도록 수습했는지 잊지 마십시오."


translate japanese plot4_memory_question_3e8e0114:



    voice "voice/jinlaoshi_42.ogg"
    jinlaoshi "…"


translate japanese plot4_memory_question_b38d22a7:



    voice "voice/banzhuren_40.ogg"
    banzhuren "（……쳇.）"


translate japanese plot4_memory_question_829f44c8:



    voice "voice/npc28_11.ogg"
    npc28 "이상입니다. 각 담임은 반에 전달해 주십시오. 오늘 1교시 수업은 취소하고 {a=dictionary:dict_entry_56}학년 조회{/a}로 변경합니다."


translate japanese plot4_memory_question_0b66a1e8:



    voice "voice/npc28_12.ogg"
    npc28 "학생들에게 교풍과 교칙을 다시 한번 철저히 지도하겠습니다."


translate japanese plot4_memory_question_d41d8cd9:


    voice "voice/tianqin_867.ogg"


translate japanese plot4_memory_question_dfe59f43:


    tianqin "흐아암……"


translate japanese plot4_memory_question_1265d8d3:



    voice "voice/yangxi_224.ogg"
    yangxi "안녕."


translate japanese plot4_memory_question_3311e958:



    voice "voice/tianqin_868.ogg"
    tianqin "안녀엉."


translate japanese plot4_memory_question_69b48025:



    voice "voice/yangxi_225.ogg"
    yangxi "또 잠이 모자라?"


translate japanese plot4_memory_question_e6f14009:



    voice "voice/tianqin_869.ogg"
    tianqin "어제 TV 보느라 늦게 잤어……"


translate japanese plot4_memory_question_ab783373:



    voice "voice/yangxi_226.ogg"
    yangxi "……요즘도 TV 보는 고등학생이 있구나. 정년퇴직한 아저씨냐."


translate japanese plot4_memory_question_8e651eed:



    voice "voice/tianqin_870.ogg"
    tianqin "아니거든! 어제 드라마가 엄청 재밌었단 말이야!"


translate japanese plot4_memory_question_8d8c5243:



    voice "voice/yangxi_227.ogg"
    yangxi "아, 그 말투도 꽤 아저씨 같다."


translate japanese plot4_memory_question_47000bd4:



    voice "voice/tianqin_871.ogg"
    tianqin "하아암…… 오늘은 수업 시간에 푹 자야지……"


translate japanese plot4_memory_question_3d98a057:



    voice "voice/npc6_12.ogg"
    npc6 "1교시, 운동장 조회로 바뀐다던데."


translate japanese plot4_memory_question_19d7a342:



    voice "voice/npc7_09.ogg"
    npc7 "뭐, 진짜?"


translate japanese plot4_memory_question_5663ed72:



    voice "voice/npc6_13.ogg"
    npc6 "다른 반 애가 그러더라."


translate japanese plot4_memory_question_e6d34a4b:



    voice "voice/banzhang_62.ogg"
    banzhang "여러분, 잠깐 조용히 해 주세요!"


translate japanese plot4_memory_question_db2eb3b4:



    voice "voice/banzhang_63.ogg"
    banzhang "오늘 1교시는 학년 조회로 변경됐습니다. 종이 울리면 신속히 운동장으로 이동해 주세요."


translate japanese plot4_memory_question_5420601f:



    voice "voice/npc6_14.ogg"
    npc6 "아, 역시 그렇네."


translate japanese plot4_memory_question_d81eff58:



    voice "voice/npc7_10.ogg"
    npc7 "하…… 뭐야."


translate japanese plot4_memory_question_d11bc1eb:



    voice "voice/npc7_11.ogg"
    npc7 "이따 햇볕에 타 죽는 거 아냐?"


translate japanese plot4_memory_question_987aa740:



    voice "voice/npc6_15.ogg"
    npc6 "그러게. 귀찮게 진짜."


translate japanese plot4_memory_question_2f74a970:



    voice "voice/yangxi_228.ogg"
    yangxi "……거봐, 들었지."


translate japanese plot4_memory_question_d752d4b4:



    voice "voice/tianqin_872.ogg"
    tianqin "싫어어. 자고 싶단 말이야. 일부러 운동장까지 가서 일광욕하기 싫다고――."


translate japanese plot4_memory_question_de0e7e8a:



    voice "voice/npc28_13.ogg"
    npc28 "……최근 일부 학생의 교칙 위반이 확인되고 있습니다. 본교의 우수한 학습 환경에도 적지 않은 영향을 미치고 있습니다."


translate japanese plot4_memory_question_8c5a1000:



    voice "voice/npc28_14.ogg"
    npc28 "다시 한번 말씀드립니다. 학교는 배우는 곳입니다."


translate japanese plot4_memory_question_be4288fe:



    voice "voice/npc28_15.ogg"
    npc28 "규율 없이 질서는 성립하지 않습니다. 룽화 제1고등학교의 학습 환경을 어지럽히는 행위는 결코――"


translate japanese plot4_memory_question_69220250:



    voice "voice/npc6_16.ogg"
    npc6 "아, 왜 굳이 다 모아 놓고 교칙으로 잔소리하는 건데……"


translate japanese plot4_memory_question_484dc508:



    voice "voice/npc7_12.ogg"
    npc7 "몰라. 부장이 변덕이라도 부리나 보지. 아침부터 땡볕에 세워 놓다니 최악이야."


translate japanese plot4_memory_question_d1366c6f:


    "조회에서 학년부장은 편지에 대해 한마디도 꺼내지 않았다. 대신 교칙과 품행에 관한 이야기만 늘어놓았다."


translate japanese plot4_memory_question_1e48b6a5:


    "당연히 학생들은 거의 귀담아듣지 않았다. 여기저기서 하품이 터져 나왔다."


translate japanese plot4_memory_question_cc615f80:



    voice "voice/yangxi_229.ogg"
    yangxi "또 대머리가 시답잖은 소리 하네……"


translate japanese plot4_memory_question_6d72b5f7:



    voice "voice/tianqin_873.ogg"
    tianqin "하아암…… 얼마나 더 하는 거야…… 나 녹겠어……"


translate japanese plot4_memory_question_f3ec2c3b_1:



    voice "voice/banzhuren_41.ogg"
    banzhuren "…"


translate japanese plot4_memory_question_ec7f9667:



    voice "voice/jinlaoshi_43.ogg"
    jinlaoshi "이 선생님? 괜찮으세요?"


translate japanese plot4_memory_question_6f05d660:



    voice "voice/banzhuren_42.ogg"
    banzhuren "김 선생님."


translate japanese plot4_memory_question_84957372:



    voice "voice/jinlaoshi_44.ogg"
    jinlaoshi "안색이 별로 안 좋으신데요?"


translate japanese plot4_memory_question_690227f3:



    voice "voice/banzhuren_43.ogg"
    banzhuren "아침부터 운동장에 끌려 나와 햇볕을 쬐니 안색이 나빠질 수밖에."


translate japanese plot4_memory_question_6aa185f2:



    voice "voice/jinlaoshi_45.ogg"
    jinlaoshi "후후, 학생들도 똑같은 생각을 하고 있을 거예요."


translate japanese plot4_memory_question_46435235:



    voice "voice/banzhuren_44.ogg"
    banzhuren "하……"


translate japanese plot4_memory_question_99a616b3:



    voice "voice/jinlaoshi_46.ogg"
    jinlaoshi "아직 그 편지 생각 중이세요?"


translate japanese plot4_memory_question_fef70f64:



    voice "voice/banzhuren_45.ogg"
    banzhuren "네. 그 편지, 어쩌면 누군가가 보내는 도움 요청일지도 몰라요."


translate japanese plot4_memory_question_d0a38392:



    voice "voice/banzhuren_46.ogg"
    banzhuren "그걸 처음부터 부정하다니……"


translate japanese plot4_memory_question_11d28048:



    voice "voice/banzhuren_47.ogg"
    banzhuren "부장 그 사람은 정말 교사 자격이 없어요."


translate japanese plot4_memory_question_4b5268c6:



    voice "voice/jinlaoshi_47.ogg"
    jinlaoshi "확실히 내용이 조금 모호하긴 했으니까요…… 부장 선생님은 학생 장난이라고 생각하셨을지도요."


translate japanese plot4_memory_question_131c080d:



    voice "voice/jinlaoshi_48.ogg"
    jinlaoshi "이 선생님은 정말 괴롭힘이 일어나고 있다고 생각하세요?"


translate japanese plot4_memory_question_17497d6e:



    voice "voice/jinlaoshi_49.ogg"
    jinlaoshi "솔직히 선생님 반이 그런 일과는 가장 거리가 멀 줄 알았는데요."


translate japanese plot4_memory_question_d31aab82:



    voice "voice/banzhuren_48.ogg"
    banzhuren "최근 반 분위기가 조금 어색했어요."


translate japanese plot4_memory_question_6207729a:



    voice "voice/banzhuren_49.ogg"
    banzhuren "이번 주에 한번 살펴보려고 했는데, 오늘 아침 그 편지가 놓여 있더군요……"


translate japanese plot4_memory_question_24228fa4:



    voice "voice/jinlaoshi_50.ogg"
    jinlaoshi "그렇군요. 혹시 짐작 가는 일이 있으세요?"


translate japanese plot4_memory_question_0932bf16:



    voice "voice/banzhuren_50.ogg"
    banzhuren "정말 괴롭힘이 있다면 당연히 교사 눈에 띄지 않는 곳에서 하겠죠."


translate japanese plot4_memory_question_9fdc71e3:



    voice "voice/banzhuren_51.ogg"
    banzhuren "그 편지가 없었다면 나도 눈치채지 못했을지 몰라요."


translate japanese plot4_memory_question_ed87fb98:



    voice "voice/banzhuren_52.ogg"
    banzhuren "내용은 모호했어도 누군가 용기를 쥐어짜서 보낸 편지예요."


translate japanese plot4_memory_question_4647240a:



    voice "voice/banzhuren_53.ogg"
    banzhuren "그런 도움 요청을 외면할 수는 없어요."


translate japanese plot4_memory_question_f53e892f:



    voice "voice/jinlaoshi_51.ogg"
    jinlaoshi "그런데 어떻게 확인하시게요?"


translate japanese plot4_memory_question_638770ba:



    voice "voice/jinlaoshi_52.ogg"
    jinlaoshi "반 학생 전원과 개별 면담을 한다든가……"


translate japanese plot4_memory_question_73c7e911:



    voice "voice/banzhuren_54.ogg"
    banzhuren "안 돼요. 섣불리 움직이면 가해자를 자극하게 돼요. 그러면 피해를 당하는 아이는 더 입을 닫아 버릴 거예요."


translate japanese plot4_memory_question_e2f17f35:



    voice "voice/jinlaoshi_53.ogg"
    jinlaoshi "그럼……"


translate japanese plot4_memory_question_7ca4e0ab:



    voice "voice/banzhuren_55.ogg"
    banzhuren "음…… 이 일은 나한테 맡겨요. 신입은 쓸데없는 걱정 안 해도 되니까."


translate japanese plot4_memory_question_00e6161c:



    voice "voice/npc28_16.ogg"
    npc28 "……이상이 이번 학년 조회에서 전달하고자 했던 내용입니다."


translate japanese plot4_memory_question_9d494ce4:



    voice "voice/npc28_17.ogg"
    npc28 "교칙을 지키고, 교내에서 무슨 문제를 발견하면 반드시 선생님께 보고하세요."


translate japanese plot4_memory_question_d2d90f69:



    voice "voice/npc28_18.ogg"
    npc28 "그럼 해산. 각 반은 차례대로 교실로 돌아가도록."


translate japanese plot4_memory_question_e0b0e5fd:


    "해산이라는 말이 떨어지자 학생들 사이에서 안도의 소리가 새어 나왔다."


translate japanese plot4_memory_question_067aea5f:


    "결국 부장은 마지막까지 그 편지에 관해서는 입을 열지 않았다."


translate japanese plot4_memory_question_5b070582:



    voice "voice/tianqin_874.ogg"
    tianqin "대체 뭐 하자는 조회였어."


translate japanese plot4_memory_question_cf17a37e:



    voice "voice/tianqin_875.ogg"
    tianqin "아침부터 불러내고. 자려고 했는데."


translate japanese plot4_memory_question_afbabb74:



    voice "voice/yangxi_230.ogg"
    yangxi "저런 어른들은 가끔 정말 이해 안 되는 짓을 한다니까."


translate japanese plot4_memory_question_f448dc75:



    voice "voice/tianqin_876.ogg"
    tianqin "하, 시간 낭비잖아."


translate japanese plot4_memory_question_50cc51aa:



    voice "voice/banzhuren_56.ogg"
    banzhuren "이 소설의 배경은 작가 자신이 살았던 시대이기도 한 4세기 전의 {a=dictionary:dict_entry_57}유럽{/a}입니다."


translate japanese plot4_memory_question_f86ae8d5:



    voice "voice/banzhuren_57.ogg"
    banzhuren "당시 사회는 지금보다 훨씬 폐쇄적이었고――"


translate japanese plot4_memory_question_594adcdf:



    voice "voice/npc29_01.ogg"
    npc29 "흐아아암――"


translate japanese plot4_memory_question_7ca69394:


    "갑작스러운 학년 조회로 반 전체의 흐름이 완전히 흐트러져 있었다. 아무도 수업에 집중하지 못했다."


translate japanese plot4_memory_question_71d04dab:


    "담임 선생님 수업인데도 여기저기서 하품 소리가 들려왔다."


translate japanese plot4_memory_question_d0c63be9:


    "그래도 담임은 개의치 않았다. 처음부터 이렇게 될 줄 알고 있었기 때문이다."


translate japanese plot4_memory_question_e2e4a92a:


    "학생이 책상에 엎드려 곤히 자고 있어도 깨우려 하지 않았다."


translate japanese plot4_memory_question_d0844143:



    voice "voice/banzhuren_58.ogg"
    banzhuren "계급에 의한 지배가 짙게 남고, 국경으로 갈라진 사람들이 서로 대립하던 시대――"


translate japanese plot4_memory_question_4c396acf:



    voice "voice/banzhuren_59.ogg"
    banzhuren "이 작품은 그런 시대에 휘둘리며 변화를 두려워한 한 인간을――"


translate japanese plot4_memory_question_8e7ce314:


    "딩동댕동――"


translate japanese plot4_memory_question_84509aaa:



    voice "voice/banzhuren_60.ogg"
    banzhuren "오늘 수업은 여기까지."


translate japanese plot4_memory_question_5b704f1d:



    voice "voice/banzhuren_61.ogg"
    banzhuren "숙제는 이 소설의 감상문이야."


translate japanese plot4_memory_question_7761c420:



    voice "voice/banzhuren_62.ogg"
    banzhuren "인터넷에서 찾은 감상을 베끼는 건 금지. 꼭 자기 말로 쓰도록 해."


translate japanese plot4_memory_question_0c7e9a3a:



    voice "voice/banzhuren_63.ogg"
    banzhuren "복사해서 붙인 게 들키면 본문을 열 번 쓰게 할 거야."


translate japanese plot4_memory_question_428ea803:



    voice "voice/banzhuren_64.ogg"
    banzhuren "반장, 오후까지 칠판에 숙제 주제 적어 놔."


translate japanese plot4_memory_question_2529e939:



    voice "voice/npc30_01.ogg"
    npc30 "네! 알겠습니다!"


translate japanese plot4_memory_question_e258b816:



    voice "voice/banzhuren_65.ogg"
    banzhuren "그리고 라이라."


translate japanese plot4_memory_question_10f67368:



    voice "voice/tianqin_877.ogg"
    tianqin "Zzz…"


translate japanese plot4_memory_question_d82274bb:



    voice "voice/yangxi_231.ogg"
    yangxi 0101 "야. 너 부른다."


translate japanese plot4_memory_question_9beea0c5:



    voice "voice/tianqin_878.ogg"
    tianqin "네!? 아! 네, 선생님!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_memory_question_cdd7d31c:



    voice "voice/banzhuren_66.ogg"
    banzhuren "이따 교무실로 와."


translate japanese plot4_memory_question_b2cae057:



    voice "voice/tianqin_879.ogg"
    tianqin "네에? 또요?"


translate japanese plot4_memory_question_85026e12:



    voice "voice/banzhuren_67.ogg"
    banzhuren "뭐라고?"


translate japanese plot4_memory_question_6ec38205:



    voice "voice/tianqin_880.ogg"
    tianqin "알겠습니다! 바로 갈게요!"


translate japanese plot4_memory_question_daeb391f:



    voice "voice/tianqin_881.ogg"
    tianqin "운도 없지…… 왜 또 담임한테 불려 가는 거야."


translate japanese plot4_memory_question_20d589db:



    voice "voice/yangxi_232.ogg"
    yangxi "또 땡땡이치다 걸렸겠지."


translate japanese plot4_memory_question_a2f0b963:



    voice "voice/tianqin_882.ogg"
    tianqin "아니거든! 지난주는 학교에 잘 있었잖아!"


translate japanese plot4_memory_question_8ce4dc87:



    voice "voice/yangxi_233.ogg"
    yangxi "글쎄. 교칙 위반을 너무 많이 해서 짐작도 안 간다."


translate japanese plot4_memory_question_d2470e27:



    voice "voice/tianqin_883.ogg"
    tianqin "하아～…… 대체 무슨 일이지."


translate japanese plot4_memory_question_f4805a9b:



    voice "voice/tianqin_884.ogg"
    tianqin "실례합니다."


translate japanese plot4_memory_question_01d463a1:



    voice "voice/banzhuren_68.ogg"
    banzhuren "왜 불렀는지 알아?"


translate japanese plot4_memory_question_62088ed9:



    voice "voice/tianqin_885.ogg"
    tianqin "어……"


translate japanese plot4_memory_question_86a0460e:


    "그 한마디에 라이라의 머릿속에는 수많은 답이 떠올랐다."


translate japanese plot4_memory_question_4f2c2acc:



    voice "voice/tianqin_886.ogg"
    tianqin "……숙제 안 낸 거요?"


translate japanese plot4_memory_question_18f260fc:



    voice "voice/banzhuren_69.ogg"
    banzhuren "이번 학기에는 한 번도 안 냈지."


translate japanese plot4_memory_question_87d78011:



    voice "voice/tianqin_887.ogg"
    tianqin "오늘 그 일 때문에……"


translate japanese plot4_memory_question_c35ec07b:



    voice "voice/banzhuren_70.ogg"
    banzhuren "아니야."


translate japanese plot4_memory_question_66058a02:



    voice "voice/tianqin_888.ogg"
    tianqin "그럼 땡땡이요? 지난주 수학은 제대로 들어갔는데요!"


translate japanese plot4_memory_question_6994b03a:



    voice "voice/banzhuren_71.ogg"
    banzhuren "그것도 아닌데, 자각은 있구나."


translate japanese plot4_memory_question_fb6467ac:



    voice "voice/tianqin_889.ogg"
    tianqin "그럼 뭔데요!"


translate japanese plot4_memory_question_f3ec2c3b_2:



    voice "voice/banzhuren_72.ogg"
    banzhuren "…"


translate japanese plot4_memory_question_2b3452fb:



    voice "voice/banzhuren_73.ogg"
    banzhuren "옥상 열쇠 갖고 있어?"


translate japanese plot4_memory_question_76d31cd9:



    voice "voice/tianqin_890.ogg"
    tianqin "네? 갖고 있는데요……"


translate japanese plot4_memory_question_ac77d839:



    voice "voice/banzhuren_74.ogg"
    banzhuren "그럼 가자."


translate japanese plot4_memory_question_87dcb8b0:


    "옥상에 도착하자마자 담임 선생님은 교사다운 얼굴을 벗어 던졌다."


translate japanese plot4_memory_question_3a6068d0:


    "사람들 눈에 띄지 않는 옥상 반대편의 사각지대로 걸어갔다."


translate japanese plot4_memory_question_58ac8356:


    "코트 안주머니에서 담배와 라이터를 꺼내더니 태연하게 담배를 피우기 시작했다."


translate japanese plot4_memory_question_148b08a7:



    voice "voice/banzhuren_75.ogg"
    banzhuren "후우……"


translate japanese plot4_memory_question_9fbefb5a:


    "발밑에는 담배꽁초가 널려 있었다. 아무래도 이곳을 이용하는 건 그녀뿐이 아닌 모양이었다."


translate japanese plot4_memory_question_de23e98d:



    voice "voice/tianqin_891.ogg"
    tianqin "콜록, 콜록! 오자마자 담배부터 피우지 마세요!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_memory_question_b6bb3e86:



    voice "voice/tianqin_892.ogg"
    tianqin "그것도 학생 앞에서!"


translate japanese plot4_memory_question_9e227676:



    voice "voice/banzhuren_76.ogg"
    banzhuren "응? 네 앞이면 괜찮잖아. 어차피 날 선생님 취급도 안 하면서."


translate japanese plot4_memory_question_e64069bf:



    voice "voice/tianqin_893.ogg"
    tianqin "아니…… 우리 담임이 부장 같은 아저씨가 되는 건 보고 싶지 않달까……"


translate japanese plot4_memory_question_4fe99a19:



    voice "voice/banzhuren_77.ogg"
    banzhuren "훗…… 부장처럼, 이라……"


translate japanese plot4_memory_question_941198bd:



    voice "voice/banzhuren_78.ogg"
    banzhuren "어쩌면 나도 조금씩 내가 가장 싫어하는 어른에 가까워지고 있는지도 모르겠네."


translate japanese plot4_memory_question_71e08e60:



    voice "voice/tianqin_894.ogg"
    tianqin "…"


translate japanese plot4_memory_question_9057e1f1:



    voice "voice/tianqin_895.ogg"
    tianqin "그래서 대체 무슨 일인데요? 저한테 하실 말씀이라도 있어요?"


translate japanese plot4_memory_question_f3ec2c3b_3:



    voice "voice/banzhuren_79.ogg"
    banzhuren "…"


translate japanese plot4_memory_question_586f046e:



    voice "voice/banzhuren_80.ogg"
    banzhuren "우리 반에 괴롭힘이 있을지도 몰라."


translate japanese plot4_memory_question_87ca883c:



    voice "voice/tianqin_896.ogg"
    tianqin "네?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_memory_question_3b4c668b:



    voice "voice/banzhuren_81.ogg"
    banzhuren "확실한 증거는 아직 없지만, 오늘 아침 괴롭힘을 고발하는 편지가 왔어."


translate japanese plot4_memory_question_dad97a86:



    voice "voice/tianqin_897.ogg"
    tianqin "누가 썼는데요?"


translate japanese plot4_memory_question_7b4867f4:



    voice "voice/banzhuren_82.ogg"
    banzhuren "몰라. 인쇄된 데다 이름도 적혀 있지 않았어."


translate japanese plot4_memory_question_3838deb9:



    voice "voice/banzhuren_83.ogg"
    banzhuren "상당히 몰린 상황인 것 같아. 정작 중요한 부분은 거의 적지 못했더라. 어떻게 해야 할지 고민 중이야."


translate japanese plot4_memory_question_a6aaa6f5:



    voice "voice/tianqin_898.ogg"
    tianqin "음…… 그래서 저더러 뭘 하라고요?"


translate japanese plot4_memory_question_6fb8a506:



    voice "voice/banzhuren_84.ogg"
    banzhuren "조사해 줬으면 해."


translate japanese plot4_memory_question_88b635cb:



    voice "voice/tianqin_899.ogg"
    tianqin "네, 제가요!?"


translate japanese plot4_memory_question_651e8d46:



    voice "voice/banzhuren_85.ogg"
    banzhuren "거절하진 않을 거지?"


translate japanese plot4_memory_question_d4b1e740:



    voice "voice/tianqin_900.ogg"
    tianqin "아니…… 돕고 싶은 마음은 있는데요."


translate japanese plot4_memory_question_468e61aa:



    voice "voice/tianqin_901.ogg"
    tianqin "너무 갑작스러워서 아직 상황이 정리가 안 돼요."


translate japanese plot4_memory_question_447a3dc4:



    voice "voice/banzhuren_86.ogg"
    banzhuren "지난주 츠루기 일은 알아?"


translate japanese plot4_memory_question_f2acba73:



    voice "voice/tianqin_902.ogg"
    tianqin "――!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_memory_question_fb2de484:



    voice "voice/tianqin_903.ogg"
    tianqin "……그 악질적인 장난이요?"


translate japanese plot4_memory_question_dfa4f4a0:



    voice "voice/banzhuren_87.ogg"
    banzhuren "그래."


translate japanese plot4_memory_question_46bef20c:



    voice "voice/tianqin_904.ogg"
    tianqin "선생님은…… 그 편지를 쓴 게 츠루기라고 생각하세요?"


translate japanese plot4_memory_question_8f16d000:



    voice "voice/banzhuren_88.ogg"
    banzhuren "그럴 가능성은 있어."


translate japanese plot4_memory_question_68f02038:



    voice "voice/banzhuren_89.ogg"
    banzhuren "그 일 이후로 츠루기는 한 번도 나를 찾아오지 않았어."


translate japanese plot4_memory_question_e10640e7:



    voice "voice/banzhuren_90.ogg"
    banzhuren "다른 학생한테 듣고서야 알았을 정도야."


translate japanese plot4_memory_question_486fdf38:



    voice "voice/tianqin_905.ogg"
    tianqin "네!? 츠루기는 선생님한테 말씀 안 드렸어요!?"


translate japanese plot4_memory_question_dfa4f4a0_1:



    voice "voice/banzhuren_91.ogg"
    banzhuren "그래."


translate japanese plot4_memory_question_bd1e4bb0:



    voice "voice/tianqin_906.ogg"
    tianqin "그런데 그렇게 큰일이 있었는데…… 그럴 수가……"


translate japanese plot4_memory_question_cad963f4:



    voice "voice/banzhuren_92.ogg"
    banzhuren "이유는 잘 모르겠어. 하지만 그 애는 어른을 그다지 믿지 않는 것 같아."


translate japanese plot4_memory_question_93fe88fe:



    voice "voice/banzhuren_93.ogg"
    banzhuren "작문을 읽을 때도 계속 그렇게 느꼈어."


translate japanese plot4_memory_question_485921e8:



    voice "voice/banzhuren_94.ogg"
    banzhuren "나한테도, 부모님한테도…… 누구에게나 강한 거부감을 품고 있어."


translate japanese plot4_memory_question_61b6acc2:



    voice "voice/banzhuren_95.ogg"
    banzhuren "부모님께도 연락해서 이 일을 상의하려고 했는데, 전화가 전혀 안 되더라."


translate japanese plot4_memory_question_079c7da3:



    voice "voice/banzhuren_96.ogg"
    banzhuren "그래서 나는 이 편지가 그 애의 도움 요청일지도 모른다고 생각해."


translate japanese plot4_memory_question_d864b9be:



    voice "voice/tianqin_907.ogg"
    tianqin "음…… 그럼 제가 츠루기한테 이야기를 들어 보면 되겠네요?"


translate japanese plot4_memory_question_8023dbc2:



    voice "voice/banzhuren_97.ogg"
    banzhuren "응, 그럴 생각이야."


translate japanese plot4_memory_question_e80b9fd9:



    voice "voice/banzhuren_98.ogg"
    banzhuren "다만 오늘은 결석했으니 마음이 정리돼서 등교하면 부탁해."


translate japanese plot4_memory_question_6a2cf4bb:



    voice "voice/tianqin_908.ogg"
    tianqin "그렇구나…… 알았어요."


translate japanese plot4_memory_question_a5263eca:



    voice "voice/banzhuren_99.ogg"
    banzhuren "다른 질문은?"


translate japanese plot4_memory_question_55e0afc0:



    voice "voice/tianqin_909.ogg"
    tianqin "음…… 왜 저예요? 반장이나 체육 특기생들은 안 되나요?"


translate japanese plot4_memory_question_3b56f92c:



    voice "voice/tianqin_910.ogg"
    tianqin "츠루기도 걔들한테 더 편하게 이야기할 수 있지 않을까요?"


translate japanese plot4_memory_question_81af2d83:



    voice "voice/banzhuren_100.ogg"
    banzhuren "아니. 이 일에는 네가 가장 적합해."


translate japanese plot4_memory_question_ea1039f6:



    voice "voice/tianqin_911.ogg"
    tianqin "어?"


translate japanese plot4_memory_question_925cb152:



    voice "voice/banzhuren_101.ogg"
    banzhuren "우리 반에는 몇몇 무리가 있고, 서로 그다지 사이가 좋지 않아. 츠루기에게도 그 애를 중심으로 한 무리가 있고."


translate japanese plot4_memory_question_963cf8b1:



    voice "voice/banzhuren_102.ogg"
    banzhuren "어느 무리에도 속해 있지 않으면서 그 애와 이야기할 수 있는 학생이 필요해."


translate japanese plot4_memory_question_f7827aa7:



    voice "voice/banzhuren_103.ogg"
    banzhuren "그리고―― 너를 고른 가장 큰 이유는 다른 아이들보다 훨씬 어른스럽기 때문이야."


translate japanese plot4_memory_question_4cfbe0be:



    voice "voice/tianqin_912.ogg"
    tianqin "에헤헤～. 선생님, 저를 그렇게 보고 계셨구나."


translate japanese plot4_memory_question_92d17fbd:



    voice "voice/banzhuren_104.ogg"
    banzhuren "사실을 말했을 뿐이야. 넌 본성부터 나쁜 애는 아니니까."


translate japanese plot4_memory_question_842108f1:



    voice "voice/banzhuren_105.ogg"
    banzhuren "수업은 빼먹고, 숙제는 안 내고, 수업 시간에는 말을 안 듣고, 툭하면 거짓말이나 변명을 하지만――"


translate japanese plot4_memory_question_bc1037de:



    voice "voice/tianqin_913.ogg"
    tianqin "그만! 더는 말 안 하셔도 돼요!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_memory_question_138a4b98:



    voice "voice/banzhuren_106.ogg"
    banzhuren "아무튼. 츠루기가 돌아오면 친구로서 제대로 이야기를 들어 줘."


translate japanese plot4_memory_question_bd9d16bb:



    voice "voice/banzhuren_107.ogg"
    banzhuren "어떤 고민을 안고 있는지."


translate japanese plot4_memory_question_20f81862:



    voice "voice/banzhuren_108.ogg"
    banzhuren "나도 다시 직접 이야기해서 무슨 일이 있었는지 자세히 물어볼 생각이야."


translate japanese plot4_memory_question_664b9526:



    voice "voice/banzhuren_109.ogg"
    banzhuren "……말해 준다면, 말이지만."


translate japanese plot4_memory_question_7dbccfb7:



    voice "voice/tianqin_914.ogg"
    tianqin "네. 저도 노력해 볼게요."


translate japanese plot4_memory_question_f6957129:



    voice "voice/tianqin_915.ogg"
    tianqin "후——"


translate japanese plot4_memory_question_5c562821:



    voice "voice/yangxi_234.ogg"
    yangxi "또 선생님한테 혼났어?"


translate japanese plot4_memory_question_a95b1580:



    voice "voice/tianqin_916.ogg"
    tianqin "아니. 선생님이 조금 부탁하신 게 있어."


translate japanese plot4_memory_question_41fc4c61:



    voice "voice/yangxi_235.ogg"
    yangxi "부탁?"


translate japanese plot4_memory_question_441ddd28:



    voice "voice/tianqin_917.ogg"
    tianqin "쉿. 목소리 낮춰."


translate japanese plot4_memory_question_26d8712e:


    "라이라는 방금 담임에게 들은 이야기를 히나타에게 빠짐없이 전했다."


translate japanese plot4_memory_question_2d05745c:



    voice "voice/yangxi_236.ogg"
    yangxi "정말, 스스로 귀찮은 일에 끼어드는 걸 좋아한다니까."


translate japanese plot4_memory_question_19d45dda:



    voice "voice/tianqin_918.ogg"
    tianqin "그게 말이야, 선생님도 내가 거절하지 않을 거란 걸 알고 계셨던 거야."


translate japanese plot4_memory_question_cbf16210:



    voice "voice/tianqin_919.ogg"
    tianqin "게다가 선생님 부탁이 없었어도 난 츠루기를 돕고 싶었고."


translate japanese plot4_memory_question_7bd21307:



    voice "voice/yangxi_237.ogg"
    yangxi "하…… 역시. 완전히 담임 손바닥 안이네."


translate japanese plot4_memory_question_bfc07525:



    voice "voice/yangxi_238.ogg"
    yangxi "괴롭힘을 고발하는 편지라……"


translate japanese plot4_memory_question_44398d64:



    voice "voice/yangxi_239.ogg"
    yangxi "너희 둘은 그걸 쓴 게 츠루기라고 생각해?"


translate japanese plot4_memory_question_9ae80675:



    voice "voice/tianqin_920.ogg"
    tianqin "음…… 솔직히 아직 모르겠어."


translate japanese plot4_memory_question_3e00fc1a:



    voice "voice/tianqin_921.ogg"
    tianqin "그래서 선생님도 내 도움을 원하신 거고."


translate japanese plot4_memory_question_43e108c0:



    voice "voice/yangxi_240.ogg"
    yangxi "그래서 어떻게 할 건데?"


translate japanese plot4_memory_question_6e9d7f39:



    voice "voice/tianqin_922.ogg"
    tianqin "음…… 지금은 단서도 하나 없고 츠루기도 결석했으니까……"


translate japanese plot4_memory_question_31bab0fb:



    voice "voice/tianqin_923.ogg"
    tianqin "일단 우리 반을 잘 살펴볼게. 뭔가 눈에 띌지도 모르잖아."


translate japanese plot4_memory_question_d26e2ac9:



    voice "voice/hunter_09.ogg"
    monolith_ns "…"


translate japanese plot4_memory_question_e0bd2345:


    "검은 마녀는 자신의 손바닥에 펼쳐진 마법진을 가만히 바라보고 있었다."


translate japanese plot4_memory_question_0b41267b:


    "마법진의 중심에서 희미하게 흔들리는 마력의 흐름이 사방으로 스며 나와, 이세계의 은신처 전체를 채워 갔다."


translate japanese plot4_memory_question_4e87dc37:


    "극히 미약한 마력의 파문은 그녀의 제어에 따라 부딪치고, 겹치고, 일렁이더니 이윽고 좁은 공간 안에서 하나의 커다란 파도가 되어 퍼졌다."


translate japanese plot4_memory_question_b75b97ed:



    voice "voice/hunter_10.ogg"
    monolith_ns "가라."


translate japanese plot4_memory_question_ff974e5f:


    "마녀는 손안의 마법진을 흩어 버리고 마력의 흐름을 묶어 두던 족쇄를 풀었다."


translate japanese plot4_memory_question_513aa4e9:


    "속박이 사라지자 마력의 파도는 단숨에 사방으로 뻗어 나가 거리도, 지구도── 룽화시 전체를 감쌌다."


translate japanese plot4_memory_question_ad397592:



    voice "voice/hunter_11.ogg"
    monolith_ns "（으으음…）"


translate japanese plot4_memory_question_8e4614d3:


    "파도가 퍼져 나감과 동시에 방대한 정보가 그녀의 머릿속으로 쏟아져 들어왔다."


translate japanese plot4_memory_question_bc715408:


    "거리의 열기, 자동차 소음, 사람들의 호흡── 공원 구석에서 먹이를 나르는 개미의 미세한 소리까지."


translate japanese plot4_memory_question_79deead6:


    "마력이 닿은 곳이라면 어디든 감지할 수 있었다."


translate japanese plot4_memory_question_71b78871:


    "마치 도시 전체를 내려다보는 새로운 「눈」이 생겨난 것처럼, 그녀는 룽화시 구석구석을 살폈다."


translate japanese plot4_memory_question_2e6f47b5:



    voice "voice/flame_08.ogg"
    ataset_ns "이거 위험하지 않아? 리스."


translate japanese plot4_memory_question_cf669a31:



    voice "voice/hunter_12.ogg"
    monolith "……돌아왔구나."


translate japanese plot4_memory_question_7bc1a5bc:



    voice "voice/flame_09.ogg"
    ataset "이런 파동을 【그 애｜아사요】가 눈치채면…… 다음엔 정말 싸워야 할걸?"


translate japanese plot4_memory_question_3e909194:



    voice "voice/hunter_13.ogg"
    monolith "걱정 마. 이 정도 흔들림…… 그 「대마녀」가 알아챌 리 없어."


translate japanese plot4_memory_question_4dc4eeae:



    voice "voice/flame_10.ogg"
    ataset "에휴, 그런 데서 자신감이 넘친다니까."


translate japanese plot4_memory_question_0060939b:


    "문득 모코리스는 동료의 몸에서 묘한 향기를 맡았다."


translate japanese plot4_memory_question_eb5a0c19:



    voice "voice/hunter_14.ogg"
    monolith "……어디 갔다 왔어?"


translate japanese plot4_memory_question_753f416c:



    voice "voice/flame_11.ogg"
    ataset "맞은편 목욕탕～."


translate japanese plot4_memory_question_89893bb6:



    voice "voice/flame_12.ogg"
    ataset "있잖아, 이 세계의 목욕탕은――"


translate japanese plot4_memory_question_31ae87b0:



    voice "voice/hunter_15.ogg"
    monolith "잠깐. 들키지는 않았겠지?"


translate japanese plot4_memory_question_ff92e8b5:


    "감탄을 늘어놓기도 전에 검은 마녀가 단호하게 말을 끊었다."


translate japanese plot4_memory_question_11348eff:



    voice "voice/flame_13.ogg"
    ataset "참, 그런 실수는 안 한다니까."


translate japanese plot4_memory_question_0afcd62c:



    voice "voice/hunter_16.ogg"
    monolith "하아……"


translate japanese plot4_memory_question_24408daa:


    "검은 마녀는 작게 한숨을 내쉬고 다시 모아 둔 정보에 몰두했다."


translate japanese plot4_memory_question_6b3c0ddb:


    "가치 있는 정보를 가려냈지만, 단 하나 목표로 삼은 정보만은 어디에도 없었다."


translate japanese plot4_memory_question_59e59da8:



    voice "voice/hunter_17.ogg"
    monolith "（……정말 교묘하게 숨는군, 「【대마녀｜아사요】」.）"


translate japanese plot4_memory_question_a4d0da8d:



    voice "voice/hunter_18.ogg"
    monolith "（하지만 무대는 곧 완성돼. 도망치려 해도 소용없어.）"


translate japanese plot4_memory_question_b00a3aab:



    voice "voice/hunter_19.ogg"
    monolith "（그때는 날 지루하게 만들지 말아 줘.）"


translate japanese plot4_memory_question_8e7ce314_1:


    "딩동댕동――"


translate japanese plot4_memory_question_2b9f7e9b:


    "교내 방송에서 마지막 종이 울렸다. 기다리고 기다리던 방과 후가 드디어 찾아왔다."


translate japanese plot4_memory_question_6a3ae46d:


    "라이라는 드물게 하루 종일 교실에서 성실하게 수업을 받아, 비로소 평범한 학생처럼 보였다."


translate japanese plot4_memory_question_29aa84f7:


    "반의 상황을 파악하려고 오늘은 한 번도 교실을 빠져나가지 않았다."


translate japanese plot4_memory_question_3f29e0f7:



    voice "voice/tianqin_00924.ogg"
    tianqin "하아아아――!"


translate japanese plot4_memory_question_e9f1458c:


    "라이라는 크게 기지개를 켰다. 정신적 피로가 온몸에 달라붙어, 마치 모래 늪에 빠지는 것처럼 활력을 앗아 갔다."


translate japanese plot4_memory_question_939a7bfd:



    voice "voice/yangxi_241.ogg"
    yangxi "어땠어, 명탐정님. 뭐 좀 알아냈어?"


translate japanese plot4_memory_question_77093397:



    voice "voice/tianqin_925.ogg"
    tianqin "전혀 진전 없어ーー! 반은 정말 평소랑 똑같았단 말이야!"


translate japanese plot4_memory_question_9a316c4e:



    voice "voice/tianqin_926.ogg"
    tianqin "히나타는 뭐 눈치챈 거 없어?"


translate japanese plot4_memory_question_5384d57e:



    voice "voice/yangxi_242.ogg"
    yangxi "미안한데 그런 데는 관심 없었어."


translate japanese plot4_memory_question_09c771fa:



    voice "voice/tianqin_927.ogg"
    tianqin "에이, 너무해."


translate japanese plot4_memory_question_5204b748:



    voice "voice/tianqin_928.ogg"
    tianqin "그런 일이 있었는데……"


translate japanese plot4_memory_question_92ec3b0b:



    voice "voice/yangxi_243.ogg"
    yangxi "그래? 나랑은 상관없잖아."


translate japanese plot4_memory_question_ae1ecc70:



    voice "voice/yangxi_244.ogg"
    yangxi "내가 당한 일은 아니니까."


translate japanese plot4_memory_question_ed7f7d29:



    voice "voice/tianqin_929.ogg"
    tianqin "히나타!"


translate japanese plot4_memory_question_7d9255ce:



    voice "voice/yangxi_245.ogg"
    yangxi "그렇다고 나만 그렇게 생각하는 것도 아니잖아. 다들 그렇지 뭐."


translate japanese plot4_memory_question_094219eb:



    voice "voice/tianqin_930.ogg"
    tianqin "……분위기라는 건 이렇게 생겨나는 것 같아."


translate japanese plot4_memory_question_d89d40b6:



    voice "voice/tianqin_931.ogg"
    tianqin "다들 「나랑 상관없어」라고 생각하니까 그런 일이 생기는 거야."


translate japanese plot4_memory_question_a3201546:



    voice "voice/yangxi_246.ogg"
    yangxi "분위기라…… 그런 건 우리 몇 명이 바꿀 수 있는 게 아니잖아."


translate japanese plot4_memory_question_ad8348af:


    "「분위기」. 라이라는 그 말이 싫었다."


translate japanese plot4_memory_question_6fa0e1bf:


    "귀찮은 일에 휘말리기 싫어서 다들 입을 닫는다."


translate japanese plot4_memory_question_9bea8360:


    "나와는 상관없다.{p}내가 아니라서 다행이다.{p}……"


translate japanese plot4_memory_question_59a9ea7c:


    "그것이 집단의 공통된 인식이 되면, 그 생각은 썩은 공기처럼 퍼져 나간다."


translate japanese plot4_memory_question_3371d855:


    "그리고 누구나 그 분위기에 휩쓸리면서, 그 공통된 의식은 갈수록 더 굳건해진다."


translate japanese plot4_memory_question_58eb1291:



    voice "voice/yangxi_247.ogg"
    yangxi "츠루기한테는 물어봤어?"


translate japanese plot4_memory_question_395a203f:



    voice "voice/tianqin_932.ogg"
    tianqin "물어보려고 했는데 오늘 결석했잖아."


translate japanese plot4_memory_question_8266b185:



    voice "voice/tianqin_933.ogg"
    tianqin "메시지를 보낼 수도 있지만…… 어떻게 말을 꺼내야 할지 모르겠어서……"


translate japanese plot4_memory_question_04720976:



    voice "voice/yangxi_248.ogg"
    yangxi "그럼 그냥 그만두지 그래? 어차피 우리랑 상관없잖아."


translate japanese plot4_memory_question_66c75b2d:



    voice "voice/tianqin_934.ogg"
    tianqin "히나타!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot4_memory_question_617e222e:



    voice "voice/yangxi_249.ogg"
    yangxi "농담이야."


translate japanese plot4_memory_question_87f667ce:



    voice "voice/tianqin_935.ogg"
    tianqin "으음——"


translate japanese plot4_memory_question_2c7b9d55:



    voice "voice/tianqin_936.ogg"
    tianqin "뭐, 됐어. 일단 지금은 이 얘기 접어 두자."


translate japanese plot4_memory_question_376ec7fa:



    voice "voice/tianqin_937.ogg"
    tianqin "가자!"


translate japanese plot4_memory_question_11cffe9d:



    voice "voice/yangxi_250.ogg"
    yangxi "어디로?"


translate japanese plot4_memory_question_3a2fd445:



    voice "voice/tianqin_938.ogg"
    tianqin "기분 전환!"


translate japanese plot4_memory_question_c99d1c35:



    voice "voice/tianqin_939.ogg"
    tianqin "영차, 영차."


translate japanese plot4_memory_question_6c8c0392:


    "라이라는 괭이를 휘두르며 원예부에 남은 밭을 부지런히 갈고 있었다."


translate japanese plot4_memory_question_88372d20:



    voice "voice/xiaoxia_87.ogg"
    xiaoxia "라이라 씨, 오늘은 평소보다 더 열심이시네요."


translate japanese plot4_memory_question_9b352736:



    voice "voice/yangxi_251.ogg"
    yangxi "쟤 오늘 기분이 안 좋거든."


translate japanese plot4_memory_question_a1070c28:



    voice "voice/xiaoxia_88.ogg"
    xiaoxia "네, 그런가요……?"


translate japanese plot4_memory_question_dcbf3297:



    voice "voice/yangxi_252.ogg"
    yangxi "응. 기분이 가라앉을수록 체력을 다 써 버리려고 하거든."


translate japanese plot4_memory_question_cf7d0ba1:



    voice "voice/xiaoxia_89.ogg"
    xiaoxia "그렇다면 원예부가 의외로 잘 맞을지도 모르겠네요."


translate japanese plot4_memory_question_cbd2a5a9:



    voice "voice/yangxi_253.ogg"
    yangxi "이번에도 작심삼일만 아니면 말이지."


translate japanese plot4_memory_question_ece4dac6:



    voice "voice/tianqin_940.ogg"
    tianqin "후우…… 이걸로 다 갈았나?"


translate japanese plot4_memory_question_1761e742:



    voice "voice/xiaoxia_90.ogg"
    xiaoxia "라이라 씨, 수고하셨어요."


translate japanese plot4_memory_question_a61351bc:



    voice "voice/tianqin_941.ogg"
    tianqin "오, 아키나!"


translate japanese plot4_memory_question_0bd17e80:



    voice "voice/xiaoxia_91.ogg"
    xiaoxia "여기가 마지막 구역이에요. 밭갈이는 끝났으니 이제 쉬셔도 돼요."


translate japanese plot4_memory_question_f0c08245:



    voice "voice/tianqin_942.ogg"
    tianqin "괜찮아. 아직 멀쩡해. 일이 더 있어도 거뜬하다고!"


translate japanese plot4_memory_question_185a3ee5:



    voice "voice/xiaoxia_92.ogg"
    xiaoxia "라이라 씨는 정말 체력이 좋으시네요."


translate japanese plot4_memory_question_828213f4:



    voice "voice/tianqin_943.ogg"
    tianqin "에헤헤, 그거 말고는 내세울 게 없거든."


translate japanese plot4_memory_question_28022736:



    voice "voice/yangxi_254.ogg"
    yangxi 0105 "야, 슬슬 물 좀 가져와. 여긴 물 주기 시작할 거니까."


translate japanese plot4_memory_question_c10497b6:



    voice "voice/tianqin_944.ogg"
    tianqin "아이 아이, 써――!"


translate japanese plot4_memory_question_2e2fa091:



    voice "voice/tianqin_945.ogg"
    tianqin "히나타도 참. 「오기 싫어」라고 말한 것치고는 꽤 열심히 하잖아."


translate japanese plot4_memory_question_14067515:



    voice "voice/xiaoxia_93.ogg"
    xiaoxia "두 분이 도와주셔서 정말 큰 도움이 됐어요."


translate japanese plot4_memory_question_34015d79:



    voice "voice/npc31_01.ogg"
    npc31 "와! 이렇게 넓은 밭이 생겼네!"


translate japanese plot4_memory_question_54bf8cb6:



    voice "voice/npc32_01.ogg"
    npc32 "이제 꽃을 더 많이 심을 수 있겠다!"


translate japanese plot4_memory_question_e68b7063:



    voice "voice/npc33_01.ogg"
    npc33 "고마워, 아키나!"


translate japanese plot4_memory_question_34d126e6:



    voice "voice/xiaoxia_94.ogg"
    xiaoxia "아, 아니에요……! 제가 아니라 반 친구들이 도와주신 거예요……"


translate japanese plot4_memory_question_7cdab5c3:


    "방과 후가 되자 다른 부원들도 하나둘 모이기 시작했다. 운동장 구석의 조용한 한편은 순식간에 북적이기 시작했다."


translate japanese plot4_memory_question_c1b2a704:


    "아키나는 작업 지시와 전반적인 관리에 더해, 새로 들어온 부원들을 가르치느라 분주했다."


translate japanese plot4_memory_question_f21ae5d3:



    voice "voice/xiaoxia_95.ogg"
    xiaoxia "여러분, 서두르지 말고 한 분씩 해요."


translate japanese plot4_memory_question_b61757aa:


    "가르침을 받으려는 부원들이 몰려들어 아키나 주위에는 자연스레 사람들이 모였다."



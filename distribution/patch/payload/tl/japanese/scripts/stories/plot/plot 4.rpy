translate japanese plot4_memory_question_6bb72c36:



    voice "voice/tianqin_964.ogg"
    tianqin "지금 온 거야?"


translate japanese plot4_memory_question_6f99620d:



    voice "voice/banzhang_67.ogg"
    banzhang "네. 마침 체육 특기생 {a=dictionary:dict_entry_58}훈련{/a}이 끝난 참이에요."


translate japanese plot4_memory_question_1e90b1f1:



    voice "voice/tianqin_965.ogg"
    tianqin "수고했어. 훈련 끝나자마자 원예부까지 오다니 힘들겠다."


translate japanese plot4_memory_question_ee6362f6:



    voice "voice/banzhang_68.ogg"
    banzhang "그렇지 않아요. 원예부 활동은 제가 좋아서 하는 거니까요."


translate japanese plot4_memory_question_7c354d58:



    voice "voice/banzhang_69.ogg"
    banzhang "게다가 지금은 라이라 씨네도 도와주시고 있어서 정말 큰 힘이 돼요."



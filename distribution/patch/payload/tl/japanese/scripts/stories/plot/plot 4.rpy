translate japanese plot4_memory_question_f3d69939:



    voice "voice/yangxi_266.ogg"
    yangxi "사실이잖아. 오지랖."


translate japanese plot4_memory_question_aa8f81ee:



    voice "voice/tianqin_988.ogg"

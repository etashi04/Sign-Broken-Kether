translate japanese plot4_memory_question_e5eec20a:



    voice "voice/banzhang_85.ogg"
    banzhang "「장난」이라는 말로는 너무 가벼운 것 같아요. 정말 악질적인 짓이었어요."


translate japanese plot4_memory_question_675e187e:



    voice "voice/banzhang_86.ogg"

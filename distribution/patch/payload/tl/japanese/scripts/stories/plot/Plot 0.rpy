




















translate japanese plot0_423647f9:


    nvlNone "記憶の中の私は、姉さんに初めて外へ連れ出してもらっていた。"


translate japanese plot0_061d2276:


    nvlNone "初夏の午後。"








translate japanese plot0_789f7ce3:


    nvlNone "はしゃぎながら追いかけっこをしていた。"


translate japanese plot0_f01e6ee9:


    nvlNone "한편 모래밭 건너편에서는,"


translate japanese plot0_7d8a624b:


    nvlNone "그렇다면 나는 어느 쪽이었을까."


translate japanese plot0_3d13eb5c:


    nvlNone "これが、私にとって人生で初めてのお出かけだった。"


translate japanese plot0_bf233b90:


    nvlNone "それまで、私はずっと家で姉さんと一緒に過ごしていて、家の外に一歩も出たことがなかったのだ。"








translate japanese plot0_40a364a7:

    voice "voice/tianying_0001.ogg"

    nvlNone "「괜찮아. 여기 있기만 해도 돼.」"


translate japanese plot0_a2d7f5ab:


    nvlNone "언니는 그렇게 말해 주었다."


translate japanese plot0_7ee870a8:


    nvlNone "얼마 지나지 않아 우리 자매는 다른 어른들의 눈길을 끌었다."


translate japanese plot0_6f22b928:


    nvlNone "初めて話かけられた私はびっくりして、思わず姉さんの後ろに隠れた。{p}まるでモンスターに遭遇したかのように、体がこわばる。"


translate japanese plot0_2e0d93d1:

    voice "voice/npc_00002.ogg"

    nvlNone "「그러니? 부끄러워하지 않아도 돼.」"


translate japanese plot0_ba50f406:

    voice "voice/tianying_0003.ogg"

    nvlNone "「동생이 좀 낯을 가려서요.\n그래서 곁에 있어 주려고요.」"


translate japanese plot0_b01943b8:


    nvlNone "언니는 정말 멋있었다."


translate japanese plot0_3b1af60c:

    voice "voice/tianying_0004.ogg"

    nvlNone "「괜찮아. 여기서 구경만 해도 돼. 무섭지 않아.」"














translate japanese plot0_9c3018a3:

    voice "voice/tianqin_0001.ogg"

    nvlNone "「있잖아, 나도 쟤들이랑 놀고 싶어!」"


translate japanese plot0_95fef942:

    voice "voice/tianying_0005.ogg"

    nvlNone "「안 돼. 여기 있어.」"


translate japanese plot0_3c9c9e6f:


    voice "voice/tianying_0006.ogg"
    nvlNone "「절대 안 돼.」{p}언니는 단호하게 말했다.\n그 태도에 나는 조금 당황했다" (callback=nvl_page_voice, cb_page_voices=('voice/tianying_0006.ogg', None))


translate japanese plot0_443f0ff4:

    voice "voice/tianqin_0003.ogg"

    nvlNone "「언니, 미워!」"














translate japanese plot0_454cc982:


    nvlNone "지금 돌이켜 보면 그때의 나는 정말 제멋대로였다."


translate japanese plot0_9640417b:


    nvlNone "언니가 나를 지켜 주길 바라면서도, 나를 얽매는 건 싫었다."


translate japanese plot0_50e0ab65:

    voice "voice/npc_00004.ogg"

    nvlNone "「저기……」" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot0_c0dd1020:

    voice "voice/tianqin_0004.ogg"

    nvlNone "「어……?」"


translate japanese plot0_915d3e63:


    nvlNone "돌아본 순간, 나도 모르게 숨을 삼켰다."


translate japanese plot0_306a7280:

    voice "voice/npc_0005.ogg"

    nvlNone "「너, 너…… 나무 탈 줄 알아?」"


translate japanese plot0_6713b2e1:


    nvlNone "아이들은 나보다 더 쑥스러워하며,"


translate japanese plot0_4a76fae6:


    voice "voice/tianqin_0005.ogg"
    nvlNone "「나무 타기?」{p}나는 조금 어리둥절했다." (callback=nvl_page_voice, cb_page_voices=('voice/tianqin_0005.ogg', None))


translate japanese plot0_8a49701b:


    nvlNone "아이들이 가리키는 곳을 보니,{p}낮은 나뭇가지 위에서 새끼 고양이 한 마리가 떨고 있었다."


translate japanese plot0_b3d3d355:


    nvlNone "그리 높지 않은 나무라 어른을 부르면 금방 해결될 일이었다.{p}하지만 아이들은 자기들 힘으로 구하고 싶은 모양이었다."


translate japanese plot0_af56f09d:

    voice "voice/tianqin_0006.ogg"

    nvlNone "「내가 갈게. 별로 높지 않으니까 괜찮아.」"


translate japanese plot0_5f2d3440:


    nvlNone "어디서 솟아난 건지 나도 모를 자신감에, 나는 가슴을 툭 쳤다."


translate japanese plot0_f4895e6f:


    voice "voice/npc_0008.ogg"
    nvlNone "「저, 정말!? 고마워!」"

translate japanese plot0_0a61833c:


    voice "voice/npc_0009.ogg"
    nvlNone "「조심해!」"


translate japanese plot0_3d192678:


    voice "voice/tianqin_0007.ogg"
    nvlNone "「……그런데 나, 나무는 타 본 적 없어.」{p}나는 사실대로 털어놓았다." (callback=nvl_page_voice, cb_page_voices=('voice/tianqin_0007.ogg', None))


translate japanese plot0_9572f75c:

    voice "voice/npc_0010.ogg"

    nvlNone "「에에!?」" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot0_24f840b8:


    nvlNone "나는 나무를 타 본 적이 없었다. 오늘이 첫 외출이었으니까."


translate japanese plot0_9c649348:


    nvlNone "나는 나무줄기에 손을 짚고 단숨에 달라붙었다."


translate japanese plot0_cdc86254:

    voice "voice/npc_0011.ogg"

    nvlNone "「대단해!」" with Shake((0, 0, 0, 0), 0.5, dist=3)


translate japanese plot0_77c8d1a0:

    voice "voice/npc_0012.ogg"

    nvlNone "「한 번에 올라갔어!」"


translate japanese plot0_d6a29327:


    nvlNone "私の動きに、同じ年の子たちは目を丸くした。"


translate japanese plot0_c068055c:

    voice "voice/tianqin_0009.ogg"

    nvlNone "「후훗, 이 정도는 아무것도 아니야.」"


translate japanese plot0_932ca478:


    nvlNone "그러고는 우쭐해져서,"


translate japanese plot0_3efee4c3:


    nvlNone "눈앞의 새끼 고양이에게 무심코 손을 뻗고 말았다——"


translate japanese plot0_73084d8f:


    nvlNone "プチッ。"


translate japanese plot0_d70c9706:


    nvlNone "손안에서 들어 본 적 없는 소리가 났다."


translate japanese plot0_b791f4a1:


    nvlNone "温かくて、ぬるぬるとした液体が手のひらを伝い、顔にも服にも飛び散った。"


translate japanese plot0_d67dd970:


    nvlNone "마치 피가 든 풍선을 움켜쥐어 터뜨린 것 같았다."


translate japanese plot0_af43193a:


    nvlNone "등 뒤에서 아이들의 비명이 터지고, 발소리가 멀어져 갔다."


translate japanese plot0_7da1c14a:


    nvlNone "私の思考はぷつりと切れ、"


translate japanese plot0_8f422523:


    nvlNone "……"


translate japanese plot0_6e454e2a:


    nvlNone "그 뒤의 일은 잘 기억나지 않는다."


translate japanese plot0_90022d2b:


    nvlNone "언니는 어른들에게 몇 번이고, 몇 번이고 고개를 숙였다."


translate japanese plot0_b0dd8a5c:


    nvlNone "물론 어른들은 감정을 억누르고 있었지만,\n아이들은 달랐다."


translate japanese plot0_d63be6d6:


    "오후, 오락실."


translate japanese plot0_789ed7a8:



    voice "voice/tianqin_01.ogg"
    tianqin "으오오오오오오오오!" with Shake((0, 0, 0, 0), 0.5, dist=10)


translate japanese plot0_d2c79547:



    voice "voice/tianqin_02.ogg"
    tianqin "이번에야말로 꼭 뽑고 말겠어!"


translate japanese plot0_4749d892:



    voice "voice/yangxi_01.ogg"
    yangxi "후후."


translate japanese plot0_ebff1dc3:


    "인형 뽑기 기계 앞에서 여고생 둘이 유리 너머를 뚫어져라 노려보고 있었다."


translate japanese plot0_f4def6c5:


    "고무 집게를 조종하는 소녀는 이미 열 번도 넘게 도전했지만,"


translate japanese plot0_014765bf:


    "기계는 굶주린 짐승처럼 여전히 만족하지 못한 모양이었다. 집게는 늘 힘이 모자라 인형을 집었다가 떨어뜨리기만 했다."


translate japanese plot0_b2ee3943:


    "한편 옆에 선 소녀는 흥미진진하게 그 모습을 지켜보고 있었다. 친구의 돈 낭비 쇼를 구경하는 관객처럼."


translate japanese plot0_5fd920c0:


    tianqin "젠장, 아직도 {a=dictionary:dict_entry_1}「천장」{/a}이 아니야!?"


translate japanese plot0_d2b185f2:



    voice "voice/yangxi_02.ogg"
    yangxi "당연하지."


translate japanese plot0_dfda3322:


    yangxi "지금 네가 뽑는 인형은 인터넷에서 엄청 화제거든. 앞사람도 쉽게 포기하진 않았을걸."


translate japanese plot0_1397e4f9:



    voice "voice/tianqin_04.ogg"
    tianqin "으으으…… 그럴 리 없어! 한 번 더!"


translate japanese plot0_61081df4:



    voice "voice/tianqin_05.ogg"
    tianqin "이번에야말로 진짜다!"


translate japanese plot0_1112e656:


    "コインが投入されると同時に、機械が子どもっぽい音楽を鳴らし始めた。"


translate japanese plot0_7fc74bea:


    "最近流行中のアニメ『グラサンピッグ』の挿入歌——あのぬいぐるみのキャラクターソングだ。"


translate japanese plot0_d44d035a:


    "어린이를 대상으로 만든 애니메이션이었지만, 뜻밖에도 고등학생들에게 열렬한 인기를 누렸다."


translate japanese plot0_e0dec4b5:


    "물론 라이라도 그 “선글라스 돼지”의 열성 팬이었다."


translate japanese plot0_ea4abda4:


    "좋아하는 캐릭터의 인형을 갖고 싶다는 생각에 머리가 달아올라, 정신을 차려 보니 일주일 치 용돈을 모두 기계에 먹여 버린 뒤였다."


translate japanese plot0_036a43e2:


    tianqin "이번 한 판에 승부를 건다!"


translate japanese plot0_55357f34:



    voice "voice/tianqin_07.ogg"
    tianqin "얍!"


translate japanese plot0_2327e79d:


    "탁!" with Shake((0, 0, 0, 0), 0.5, dist=7)


translate japanese plot0_959f9c96:


    "힘껏 버튼을 내리치자 집게가 인형을 정확히 겨냥하며 내려갔다."


translate japanese plot0_1a5bb627:



    voice "voice/yangxi_04.ogg"
    yangxi "바보, 그렇게는 안 되는 게 뻔하잖아."


translate japanese plot0_b3fa4d03:


    "옆에 있던 소녀는 조용히 고개를 저었다. 이제 어떻게 될지 이미 알고 있었던 것이다."


translate japanese plot0_60f3817f:


    "인형은 잠깐 들려 올라갔지만, 곧 힘이 다한 듯 툭 떨어지고 말았다."


translate japanese plot0_573f956a:


    "아까와 다를 게 없었다."


translate japanese plot0_0b2aaea8:



    voice "voice/tianqin_08.ogg"
    tianqin "그, 그럴 수가……!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot0_7e044f86:



    voice "voice/yangxi_05.ogg"
    yangxi "힘은 아까보다 세졌지만, 천장까지는 여섯 번 정도 더 해야겠는데."


translate japanese plot0_0d243573:


    tianqin "에에에!?"


translate japanese plot0_0a05733a:



    voice "voice/tianqin_10.ogg"
    tianqin "히나타야～ 도와줘어어!"


translate japanese plot0_664be1c2:



    voice "voice/yangxi_06.ogg"
    yangxi "싫어."


translate japanese plot0_7d08c918:



    voice "voice/tianqin_11.ogg"
    tianqin "밀크티 사 줄게에!"


translate japanese plot0_27d967ed:



    voice "voice/yangxi_07.ogg"
    yangxi "……휴, 어쩔 수 없네."


translate japanese plot0_6ee611f1:



    voice "voice/yangxi_08.ogg"
    yangxi "선수 교체!"


translate japanese plot0_b8ed0a16:


    "사실 히나타는 처음부터 가장 좋은 집게 각도를 꿰뚫어 보고 있었다."


translate japanese plot0_8161e4ea:


    "그런데도 도와주지 않은 이유는──\n라이라가 완전히 두 손을 드는 모습을 보고 싶었기 때문이다."


translate japanese plot0_ec9f7673:



    voice "voice/yangxi_09.ogg"
    yangxi "（라이라가 열 번도 넘게 했으니까…… 이제 타이밍이랑 각도는 완벽할 텐데.）"


translate japanese plot0_1c394482:


    "동전이 들어가고 경쾌한 음악이 흐르기 시작했다. 히나타는 익숙한 손놀림으로 망설임 없이 집게를 아까의 위치에 맞췄다."


translate japanese plot0_68c3bab7:


    "派手な「釣り技」なんて必要ない。ただ、時間が自然に過ぎて、アームが自動で降りていくのを待つだけだった。"


translate japanese plot0_5110204b:


    "하지만 집게는 허공만 짚었다."


translate japanese plot0_ab1fb240:



    voice "voice/tianqin_12.ogg"
    tianqin "못 잡았잖아!?"


translate japanese plot0_62090c6a:



    voice "voice/yangxi_10.ogg"
    yangxi "아직 당황하지 마."


translate japanese plot0_064e7732:


    "집게가 오므라들며 올라가는 순간 기적이 일어났다. 인형 목에 달린 끈이 집게 끝에 절묘하게 걸린 것이다. 인형은 마치 느린 화면처럼 천천히 공중으로 낚여 올라갔다."


translate japanese plot0_0e54c07e:



    voice "voice/tianqin_13.ogg"
    tianqin "에에에!? 뭐야, 운이잖아!!"


translate japanese plot0_5ab76c4b:



    voice "voice/yangxi_11.ogg"
    yangxi "운이 아니라 실력이거든!"


translate japanese plot0_7e0b2788:


    "달그락, 하고 인형이 배출구에 떨어졌다."


translate japanese plot0_b00eb605:


    "「コングラチュレーション！」"


translate japanese plot0_69cfac69:



    voice "voice/tianqin_14.ogg"
    tianqin "선글라스 돼지다아아!"


translate japanese plot0_747364e2:



    voice "voice/yangxi_12.ogg"
    yangxi "크흠. ……아까 한 약속, 안 잊었지?"


translate japanese plot0_ccefa33e:



    voice "voice/tianqin_15.ogg"
    tianqin "알았어, 히나타. 밀크티 사 준다니까!"


translate japanese plot0_730ca80f:



    voice "voice/tianqin_16.ogg"
    tianqin "고마워～! 인형아, 잡혀 줘서 고맙다!"


translate japanese plot0_b70e4d11:


    npc1 "어서 오세요. 주문하시겠어요?"


translate japanese plot0_356c7b26:



    voice "voice/tianqin_17.ogg"
    tianqin "아이스 코코아 큰 걸로 펄 추가해 주세요. 가능하면 설탕도 많이요!"


translate japanese plot0_3d9823f8:



    voice "voice/npc1_02.ogg"
    npc1 "알겠습니다. 이쪽 손님은요?"


translate japanese plot0_a96f7a0b:



    voice "voice/yangxi_13.ogg"
    yangxi "당도 80퍼센트, 특대 사이즈에 밀크폼, 젤리랑 펄 둘 다 추가한 팥 말차 밀크티요."


translate japanese plot0_31c62810:



    voice "voice/tianqin_18.ogg"
    tianqin "……주, 주문!?"


translate japanese plot0_f7906b5b:



    voice "voice/npc1_03.ogg"
    npc1 "알겠습니다. 당도 80퍼센트, 특대 사이즈에 밀크폼, 젤리와 펄 둘 다 추가하고, 베이스는 팥 말차 밀크티 맞으시죠."


translate japanese plot0_b8a2f97b:



    voice "voice/tianqin_19.ogg"
    tianqin "저걸 알아들었다고!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot0_d317416f:



    voice "voice/yangxi_14.ogg"
    yangxi "뭐가 이상해? 평범하게 주문했는데?"


translate japanese plot0_2aad8927:



    voice "voice/tianqin_20.ogg"
    tianqin "평범하다니…… 저게 평범하다고!? 아무리 들어도 마법 영창이던데……"


translate japanese plot0_d66759b1:



    voice "voice/yangxi_15.ogg"
    yangxi "이거보다 한 단계 더 복잡한 것도 있어."


translate japanese plot0_85eb6721:



    voice "voice/tianqin_21.ogg"
    tianqin "한 단계 더 복잡하다고!?" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot0_18c6dd70:



    voice "voice/tianqin_22.ogg"
    tianqin "직원분 실력이 정말 대단하네……"


translate japanese plot0_73eb3741:



    voice "voice/yangxi_16.ogg"
    yangxi "익숙해지면 누구나 할 수 있어. 라이라도 여기서 알바하면 금방 잘하게 될걸?"


translate japanese plot0_779dd830:



    voice "voice/tianqin_23.ogg"
    tianqin "못 해, 못 해! 난 서툴러서……."


translate japanese plot0_a1e28b2c:



    voice "voice/tianqin_24.ogg"
    tianqin "분명 첫날부터 손님 머리에 음료를 쏟는 사진이 SNS에 퍼질걸."


translate japanese plot0_cdfa1008:



    voice "voice/tianqin_25.ogg"
    tianqin "아니면 레버를 있는 힘껏 당겨서 기계를 부순다든가……."


translate japanese plot0_e2584927:



    voice "voice/yangxi_17.ogg"
    yangxi "아…… 응, 상상이 가네."


translate japanese plot0_420cefd1:



    voice "voice/tianqin_26.ogg"
    tianqin "그렇지!"


translate japanese plot0_5ec4557c:



    voice "voice/npc1_04.ogg"
    npc1 "오래 기다리셨습니다! 주문하신 음료 나왔습니다."


translate japanese plot0_9eee6515:


    tianqin "오! 빠르네."


translate japanese plot0_b141e86d:


    "라이라 앞에 놓인 것은 지극히 평범한 아이스 코코아였다. 펄이 잔뜩 들어 있기는 했지만 겉보기에는 꽤 수수했다."


translate japanese plot0_3192fb88:


    "一方、陽汐の前にあるドリンクは——明らかに「普通」じゃなかった。"


translate japanese plot0_54df0660:


    "山のように盛られたミルクフォームだけでも、十分に視覚的なインパクトがある。"


translate japanese plot0_7d2728ad:


    "게다가 잔 안에는 토핑이 듬뿍 들어가, 칵테일처럼 알록달록한 층을 이루고 있었다."


translate japanese plot0_8d214ffe:



    voice "voice/tianqin_28.ogg"
    tianqin "이, 이게 바로! 「JK」에게 어울리는 밀크티구나!"


translate japanese plot0_95d25b56:



    voice "voice/tianqin_29.ogg"
    tianqin "한 수 배웠다!"


translate japanese plot0_14784212:



    voice "voice/yangxi_18.ogg"
    yangxi "……뭘 배웠다는 거야."


translate japanese plot0_0c84c9f9:



    voice "voice/yangxi_19.ogg"
    yangxi "（그나저나 {a=dictionary:dict_entry_2}「JK」{/a}는 이미 한물간 말 아니야?）"


translate japanese plot0_2e940f51:


    tianqin "넌 모른다니까! 네 밀크티 옆에 놓으니까 내 건 완전 촌뜨기 같잖아!"


translate japanese plot0_9885686e:



    voice "voice/yangxi_20.ogg"
    yangxi "뭐…… 요즘 아이스 코코아 마시는 사람이 드물기는 하지."


translate japanese plot0_4b75abab:



    voice "voice/tianqin_31.ogg"
    tianqin "어디서부터 배워야 하지…… 역시 먼저 저 충격적인 「밀크폼」에 도전해 볼까?"


translate japanese plot0_202a5ad0:



    voice "voice/tianqin_32.ogg"
    tianqin "그다음엔 복잡한 차를 베이스로 고르고, 마지막으로 토핑을 더는 못 올릴 만큼 쌓는 거야……!"


translate japanese plot0_9fe80442:



    voice "voice/tianqin_33.ogg"
    tianqin "좋아! 다음엔 완벽하게 주문하고 말겠어!"


translate japanese plot0_ccf78d05:



    voice "voice/yangxi_21.ogg"
    yangxi "무슨 소리야. 이런 건 그냥 네 입맛에 맞는 걸 고르면 되잖아."


translate japanese plot0_9742b6e7:



    voice "voice/tianqin_34.ogg"
    tianqin "아니야! 매번 아이스 코코아만 마시면 전혀 “청춘” 같지 않다고!"


translate japanese plot0_574ae6af:



    voice "voice/yangxi_22.ogg"
    yangxi "넌 참 별 의미도 없는 데 집착한다니까."


translate japanese plot0_3336cf3a:



    voice "voice/yangxi_23.ogg"
    yangxi "청춘이라……"


translate japanese plot0_f15f8304:



    voice "voice/yangxi_24.ogg"
    yangxi "「청춘」이라고 할 거면 학교에 꼬박꼬박 가서 공부하는 게 맞지 않아?"


translate japanese plot0_b13bda46:



    voice "voice/yangxi_25.ogg"
    yangxi "땡땡이치는 우리가 「청춘」을 말할 자격이 있어?"


translate japanese plot0_dab25b68:


    tianqin "아니지! 반항이야말로 청춘이지!"


translate japanese plot0_12357ef9:



    voice "voice/tianqin_36.ogg"
    tianqin "학교에서만 끝나는 고등학교 생활은 너무 재미없잖아!"


translate japanese plot0_9ef2eb26:



    voice "voice/yangxi_26.ogg"
    yangxi "……뭐, 일리는 있네. 교실에서 버섯이나 키우느니 바깥 공기를 쐬는 게 나을지도."


translate japanese plot0_17ebd31f:



    voice "voice/yangxi_27.ogg"
    yangxi "아, 맞다. 이번 학기 출석률은 계산해 봤어? 너 요즘 학교에 거의 안 갔잖아?"


translate japanese plot0_33b3abc5:



    voice "voice/yangxi_28.ogg"
    yangxi "난 출석률을 딱 좋게 맞춰 놓았고, 성적도 좋아서 주임 선생님한테 잔소리 들을 걱정은 없어."


translate japanese plot0_834ed5ad:



    voice "voice/tianqin_37.ogg"
    tianqin "아…… 출석…… 률?"


translate japanese plot0_e3cffce1:



    voice "voice/yangxi_29.ogg"
    yangxi "……설마 이제야 생각난 거야?"


translate japanese plot0_4666e446:



    voice "voice/tianqin_38.ogg"
    tianqin "아, 아니야, 아니야! 제대로 기억하고 있다니까!"


translate japanese plot0_25c4ef7c:



    voice "voice/tianqin_39.ogg"
    tianqin "괘, 괜차, 괜찮아! 하, 하하…"


translate japanese plot0_aee8966b:



    voice "voice/yangxi_30.ogg"
    yangxi "혀까지 꼬이네."


translate japanese plot0_315944e6:


    tianqin "괜찮아! 출석률 따위 한꺼번에 만회하면 되지!"


translate japanese plot0_96ea707f:



    voice "voice/yangxi_31.ogg"
    yangxi "그렇게 쉽게 만회할 수 있는 거야……?"


translate japanese plot0_4ad0eed7:



    voice "voice/tianqin_41.ogg"
    tianqin "으… 지난주에도 사흘이나 쉬었는데, 이렇게 되면…"


translate japanese plot0_dd6ae7ea:


    "말로는 전혀 신경 쓰지 않는다고 했지만, 라이라는 집에 도착하자마자 휴대폰 달력을 열고 이번 학기에 결석하고, 수업을 빼먹고, 조퇴한 날들을 하나씩 되짚었다."


translate japanese plot0_ca5b6da7:


    "もちろん、欠席日が多すぎて全部覚えられるわけもない。今計算した結果でも、一番楽観的なものだ。"


translate japanese plot0_4fe841a7:



    voice "voice/tianqin_42.ogg"
    tianqin "그러니까 학기 전반 출석률이 54.2%%…… 이 정도면 간신히 되겠지……?"


translate japanese plot0_79ca941d:


    tianqin "안 돼, 안 돼…… 역시 반장 출석 기록이랑 맞춰 봐야겠다니까."


translate japanese plot0_6ee30122:



    voice "voice/tianqin_44.ogg"
    tianqin "내일은 꼭 학교에 가야겠어……"


translate japanese plot0_b1215a40:


    "지금은 {a=dictionary:dict_entry_3}「유토리 교육」{/a}의 시대다."


translate japanese plot0_6131985b:


    "学校に行くことは本来学生の義務だけど、天琴は堂々とサボってしまう。それはこの「ゆとり教育の政策」が推奨されているおかげだ。"


translate japanese plot0_b227cd46:


    "一定の出席率を維持すれば、学校側は生徒の学習に過度に干渉しない。"


translate japanese plot0_6f90bcd4:



    voice "voice/tianqin_45.ogg"
    tianqin "내일 일은 내일 생각하면 되지!"


translate japanese plot0_b798fa35:


    "天琴にとって、それほど心配する必要はない。頻繁にサボっても成績は悪くない。"


translate japanese plot0_bb8e4618:


    "試験前にちょっと詰めれば、かなりいい点数が取れる。そんな学力を持つ天琴に、同級生は羨望の眼差しを向ける。"


translate japanese plot0_a3e38de5:


    "「ちゃんと勉強すれば、学年トップ10入り入りも余裕だろうな…」"


translate japanese plot0_0a4be287:


    "수많은 선생님이 라이라를 그렇게 평했지만, 정작 그녀의 관심은 공부에 있지 않았다."


translate japanese plot0_a86c5806:


    "유토리 교육 환경에서도 라이라는 학교에 얽매이는 것을 싫어했다."


translate japanese plot0_792ab5c5:



    voice "voice/tianqin_46.ogg"
    tianqin "모처럼의 청춘을 학교에서 허비하기는 아깝잖아."


translate japanese plot0_c0d1a5d9:



    voice "voice/tianqin_47.ogg"
    tianqin "뭐, 생각해 봤자 소용없고…… 일단 운동이나 하자."


translate japanese plot0_0340e3a5:



    voice "voice/tianqin_48.ogg"
    tianqin "아흔둘…… 아흔셋……"


translate japanese plot0_6a90f297:



    voice "voice/tianqin_49.ogg"
    tianqin "아흔넷…… 아흔다섯……"


translate japanese plot0_9ae9a816:


    "등은 땀에 흠뻑 젖었고, 이마의 땀방울은 바닥으로 뚝뚝 떨어졌다."


translate japanese plot0_11cdc923:


    "혼자 사니 신경 쓰는 사람도 없다."


translate japanese plot0_18111ad9:


    "라이라는 숫자를 세며 한 팔로 팔굽혀펴기를 하고 있었다. 언니가 내 준 매일의 숙제다."


translate japanese plot0_64de8193:


    "대부분의 또래라면 이 정도 강도의 운동은 해낼 수 없을 것이다."


translate japanese plot0_fb3c10df:


    "それでも彼女が軽々とこなせるのは、生まれつき少しだけ特別な体質のおかげだった。"


translate japanese plot0_66773cc6:



    voice "voice/npc2_01.ogg"
    npc2 "다음은 일기 예보입니다."


translate japanese plot0_e19f1d79:



    voice "voice/npc2_02.ogg"
    npc2 "따뜻한 기류의 영향으로 당분간 룽화시 여러 지역에 비가 예상됩니다."


translate japanese plot0_d6ec4ace:



    voice "voice/npc2_03.ogg"
    npc2 "시민 여러분께서는 외출하실 때 주의하시기 바랍니다…"


translate japanese plot0_5e0c1b06:



    voice "voice/npc2_04.ogg"
    npc2 "…"


translate japanese plot0_b0b54379:



    voice "voice/tianqin_50.ogg"
    tianqin "あれ？最近雨降るの？"


translate japanese plot0_1af556aa:



    voice "voice/tianqin_51.ogg"
    tianqin "그러고 보니 올해는 장마가 좀 늦네."


translate japanese plot0_f6957129:



    voice "voice/tianqin_52.ogg"
    tianqin "후——"


translate japanese plot0_891bd410:



    voice "voice/tianqin_53.ogg"
    tianqin "오늘 운동은 여기까지 할까."


translate japanese plot0_a487e160:



    voice "voice/tianqin_54.ogg"
    tianqin "아아, 심심해……"


translate japanese plot0_946ef9c5:



    voice "voice/tianqin_55.ogg"
    tianqin "밤에는 뭘 해야 할지 도무지 모르겠어……"


translate japanese plot0_6c5a8b0a:



    voice "voice/tianqin_56.ogg"
    tianqin "내 고등학교 생활, 이렇게 끝나 버리는 거야?"


translate japanese plot0_17b2ca1e:



    voice "voice/tianqin_57.ogg"
    tianqin "대학에 가면 더 재미없어지는 거 아냐…"


translate japanese plot0_a8eb2c13:


    "実際、この町の高校生たちは決してラクではない。ゆとり教育の影響下でも、"


translate japanese plot0_2b2838d6:


    "授業、友人関係、成績競争……思春期を抜けたばかりの高校生たちは、日々さまざまな壁にぶつかっている。"


translate japanese plot0_a5165b40:


    "라이라는 그저 전통적인 교육에 얽매이기 싫었을 뿐이지만, 주변에서는 이단아처럼 보였다."


translate japanese plot0_fcfa421b:



    voice "voice/tianqin_58.ogg"
    tianqin "뭐 재미있는 일 없을까?"


translate japanese plot0_dc06f0be:



    voice "voice/tianqin_59.ogg"
    tianqin "히나타도 밤에는 나가기 싫은 것 같고, 혼자 나가 봤자 재미없고……"


translate japanese plot0_15796966:



    voice "voice/tianqin_60.ogg"
    tianqin "모바일 게임이라도 할까?"


translate japanese plot0_5a611edb:



    voice "voice/tianqin_61.ogg"
    tianqin "잠깐만…… 반 애들이 다 하는 그 게임, 뭐였지…… 「벽람」 뭐시기…… 지령?"



translate japanese plot0_5ea66064:



    voice "voice/tianqin_62.ogg"
    tianqin "아, 찾았다, 찾았어! {a=dictionary:dict_entry_4}초인기 무료 소셜 게임{/a}이래."


translate japanese plot0_77a1b0bc:



    voice "voice/tianqin_63.ogg"
    tianqin "에—? 무료야? 누가 알바비를 전부 과금했다던 게 기억나는데…"


translate japanese plot0_1a1781f6:



    voice "voice/tianqin_64.ogg"
    tianqin "유료 게임 아니었어? 제목을 잘못 알았나…"


translate japanese plot0_96edea05:



    voice "voice/tianqin_65.ogg"
    tianqin "아아, 역시 재미없어!"


translate japanese plot0_386f9faf:


    "少し弄ったあと、天琴はスマホを横に置く。"


translate japanese plot0_6d5b8d35:


    "그러다 아까 본 일기 예보가 떠올랐다."


translate japanese plot0_dfa9139e:



    voice "voice/tianqin_66.ogg"
    tianqin "비…… 곧 오는구나……"


translate japanese plot0_940f41de:



    voice "voice/tianqin_67.ogg"
    tianqin "그럼 밖에 나가는 게 낫겠지? 길고양이라도 주워 올지 모르잖아……"


translate japanese plot0_9d0fbd74:



    voice "voice/tianqin_68.ogg"
    tianqin "으으—— 어쨌든 집에 있기는 싫어——"


translate japanese plot0_69078c20:


    "라이라는 오늘 밤 집에 틀어박혀 있고 싶지 않은 마음뿐이었다."


translate japanese plot0_3154ddcf:


    "마음속에서 자꾸만 밖으로 나가고 싶은 충동이 일었다."


translate japanese plot0_64b40e05:



    voice "voice/tianqin_69.ogg"
    tianqin "좋아, 나가자!"


translate japanese plot0_9b80fdae:



    voice "voice/jiaozi_01.ogg"
    jiaozi2 "멍멍!"


translate japanese plot0_3c14abeb:



    voice "voice/tianqin_70.ogg"
    tianqin "어! 자오쯔! 오늘은 놀러 안 나갔어?"


translate japanese plot0_8e82a85b:



    voice "voice/jiaozi_02.ogg"
    jiaozi "멍우우——"


translate japanese plot0_fe7512a2:


    "{a=dictionary:dict_entry_5}자오쯔{/a}는 이 근처에 자주 나타나는 떠돌이 사모예드였다."


translate japanese plot0_42e75715:


    "떠돌이 개지만 겉모습은 아주 깨끗했고, 털도 방금 씻은 것처럼 보송보송했다."


translate japanese plot0_1ad4d1bd:


    "このマンションの住人たちが、こっそり外で世話をして放し飼いしているらしい。"


translate japanese plot0_03e99cc1:



    voice "voice/tianqin_71.ogg"
    tianqin "그럼 같이 나갈래? 함께 가 주면 좋겠는데."


translate japanese plot0_3bb695c8:



    voice "voice/jiaozi_03.ogg"
    jiaozi 0101 "멍멍!"


translate japanese plot0_0459eac1:


    "라이라는 자오쯔를 데리고 동네 근처 거리를 산책하기 시작했다."


translate japanese plot0_73e3ad3b:


    "밤거리는 낮만큼 북적이지는 않아도 결코 쥐 죽은 듯 조용하지는 않았다."


translate japanese plot0_fe7b3bcb:


    "노점과 작은 식당들이 주택가 가장자리에 늘어서, 주민들의 생활에 방해가 되지 않을 만한 거리를 유지하고 있었다."


translate japanese plot0_06622dc2:


    "たまに酔っ払いが大声で歌い出すこともあるが、それも我慢できる程度だ。"


translate japanese plot0_0d8f84b1:


    "それ以外の場所は、しんとした静けさが漂っていた。"


translate japanese plot0_51bd0a32:


    tianqin "역시 날씨가 별로네. 구름도 엄청 두껍고…… 곧 비가 올 것 같아."


translate japanese plot0_a1f573bb:



    voice "voice/tianqin_73.ogg"
    tianqin "아…… 우산 안 가져왔는데……"


translate japanese plot0_c698cae9:



    voice "voice/tianqin_74.ogg"
    tianqin "그래도 여기까지 왔는데 이제 와서 가지러 돌아가기도 그렇고…… 안 오면 좋겠다."


translate japanese plot0_3ba81636:



    voice "voice/jiaozi_04.ogg"
    jiaozi 0101 "멍멍—— 멍우우——!"


translate japanese plot0_e2e15bee:



    voice "voice/tianqin_75.ogg"
    tianqin "안심해, 자오쯔! 비가 오면 전속력으로 뛰어 돌아갈 테니까!"


translate japanese plot0_f5e0e788:



    voice "voice/jiaozi_05.ogg"
    jiaozi 0102 "멍멍!"


translate japanese plot0_0e538a44:


    "라이라는 북적이는 곳을 피해 한 번도 가 본 적 없는 길을 골랐다."


translate japanese plot0_47f498b7:


    "家の近くなのに、まだ知らない通りがたくさんある——そんな小さな発見が、まるで宝探しのように感じられた。"


translate japanese plot0_b210be7c:



    voice "voice/tianqin_76.ogg"
    tianqin "여기 꽤 괜찮네. 자오쯔, 넌 어때?"


translate japanese plot0_e904fb21:



    voice "voice/jiaozi_06.ogg"
    jiaozi "멍우!"


translate japanese plot0_ab3ef100:


    "餃子は楽しそうに天琴のまわりをくるくる回る。どこへ行っても嬉しそうだ。"


translate japanese plot0_d304dc48:



    voice "voice/tianqin_77.ogg"
    tianqin "그럼 이 근처를 조금만 더 걸어 볼까."


translate japanese plot0_e108d48f:



    voice "voice/tianqin_78.ogg"
    tianqin "오—— 여기에 디저트 가게도 있었네. 히나타가 좋아할 만한 곳인데."


translate japanese plot0_d69a53c6:



    voice "voice/tianqin_79.ogg"
    tianqin "그런데 이런 곳에서 장사가 되려나? 이 근처엔 나이 든 분들이 많아서, 단걸 좋아하실 것 같진 않은데……"


translate japanese plot0_1081a2f0:



    voice "voice/tianqin_80.ogg"
    tianqin "아."


translate japanese plot0_2052f461:


    "薄暗い街灯の下、天琴は店の入口に立てかけられた看板に目を留めた。"


translate japanese plot0_44d78288:


    centertext "{size=+72}「파 격 할 인!」{/size}" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot0_63d6204f:



    voice "voice/tianqin_81.ogg"
    tianqin "장사가 좀 힘든가 보네."


translate japanese plot0_17ea94cd:



    voice "voice/tianqin_82.ogg"
    tianqin "다음에 히나타를 데려와 볼까. 그때까지 문 닫지 마."


translate japanese plot0_a30bc809:



    voice "voice/jiaozi_07.ogg"
    jiaozi "아우우——!"


translate japanese plot0_84b36d45:



    voice "voice/tianqin_83.ogg"
    tianqin "자, 잠깐, 자오쯔! 마음대로 뛰어가지 마!"


translate japanese plot0_51d70225:



    voice "voice/jiaozi_08.ogg"
    jiaozi "멍우, 멍멍!"


translate japanese plot0_2c10225b:



    voice "voice/tianqin_84.ogg"
    tianqin "아아…… 그렇구나. 편의점에 가고 싶었어?"


translate japanese plot0_949205e6:



    voice "voice/tianqin_85.ogg"
    tianqin "소시지라도 먹고 싶은 거지?"


translate japanese plot0_3b92dee9:



    voice "voice/jiaozi_09.ogg"
    jiaozi "멍멍!"


translate japanese plot0_10fc7b50:



    voice "voice/tianqin_86.ogg"
    tianqin "잠깐 기다려. 사 올 테니까. 가게 앞에서 얌전히 있어."


translate japanese plot0_df39a9ea:



    voice "voice/jiaozi_10.ogg"
    jiaozi "멍!"


translate japanese plot0_13a49554:



    voice "voice/jiaozi_11.ogg"
    jiaozi "헥헥——"


translate japanese plot0_0abac172:



    voice "voice/tianqin_87.ogg"
    tianqin "자, 천천히 먹어. 아무도 안 뺏어 가."


translate japanese plot0_a36706e3:



    voice "voice/jiaozi_12.ogg"
    jiaozi 0102 "머엉——"


translate japanese plot0_d0fc5abb:



    voice "voice/tianqin_88.ogg"
    tianqin "후훗, 왠지 언니 생각이 나네. 예전에도 이렇게 자오쯔한테 소시지를 주곤 했지."


translate japanese plot0_19c4c10f:



    voice "voice/tianqin_89.ogg"
    tianqin "지금쯤 뭐 하고 있을까…… 대학은 잘 다니고 있나?"


translate japanese plot0_979c3dac:



    voice "voice/jiaozi_13.ogg"
    jiaozi "멍우……"


translate japanese plot0_2eba5a16:



    voice "voice/tianqin_90.ogg"
    tianqin "자오쯔도 언니 보고 싶어?"


translate japanese plot0_95df28fd:



    voice "voice/tianqin_91.ogg"
    tianqin "곧 학기 말이라니까, 끝나면 분명 돌아올 거야."


translate japanese plot0_ff968ebe:



    voice "voice/tianqin_92.ogg"
    tianqin "그때 언니한테 더 먼 데까지 산책시켜 달라고 하자."


translate japanese plot0_3b92dee9_1:



    voice "voice/jiaozi_14.ogg"
    jiaozi "멍멍!"


translate japanese plot0_75a42b25:



    voice "voice/wildcat_01.ogg"
    wildcat "야옹"


translate japanese plot0_acce5a91:



    voice "voice/tianqin_93.ogg"
    tianqin "어! 정말 길고양이를 만났네!"


translate japanese plot0_743ec829:



    voice "voice/tianqin_94.ogg"
    tianqin "야옹아~ 곧 비가 올 거야. 나랑 집에 같이 갈래?"


translate japanese plot0_3b2572b5:



    voice "voice/wildcat_02.ogg"
    wildcat "야옹, 냐아——!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot0_1d5a3b89:



    voice "voice/tianqin_95.ogg"
    tianqin "으악! 위험하잖아, 성깔도 참 세네!"


translate japanese plot0_6b41b50f:


    "라이라는 몰랐다. 성격도 모르는 길고양이에게 갑자기 손을 대려는 건 아주 위험하다는 것을."


translate japanese plot0_8527ed30:



    voice "voice/jiaozi_15.ogg"
    jiaozi "그르——르릉! 멍멍멍!"


translate japanese plot0_59cf6782:



    voice "voice/tianqin_96.ogg"
    tianqin "자, 잠깐, 자오쯔! 놀라게 하지 마!"


translate japanese plot0_84a70c82:



    voice "voice/tianqin_97.ogg"
    tianqin "그냥 해 본 말이야. 진짜 키울 건 아니니까 질투하지 마."


translate japanese plot0_3955d742:



    voice "voice/jiaozi_16.ogg"
    jiaozi 0103 "멍우! 멍멍——"


translate japanese plot0_dc09f2ab:



    voice "voice/wildcat_03.ogg"
    wildcat "냐아—— 그르릉——!"


translate japanese plot0_1a6d715a:



    voice "voice/tianqin_98.ogg"
    tianqin "정말! 싸우지 마! 자오쯔, 가자!"


translate japanese plot0_0343301a:



    voice "voice/tianqin_99.ogg"
    tianqin "후우…… 이 근처는 거의 다 걸어 봤나. 가끔 모르는 길을 걸어 보는 것도 나쁘지 않네."


translate japanese plot0_cbfc21f8:



    voice "voice/tianqin_100.ogg"
    tianqin "……목표를 잃은 중년 아저씨 같다는 것만 빼면."


translate japanese plot0_be0ddff1:



    voice "voice/tianqin_101.ogg"
    tianqin "아아, 이건 전혀 청춘 같지 않아!"


translate japanese plot0_6feff128:



    voice "voice/tianqin_102.ogg"
    tianqin "다음엔 번화가 쪽에 가 봐야겠다."


translate japanese plot0_1e0f7960:



    voice "voice/jiaozi_17.ogg"
    jiaozi 0102 "멍우우——"


translate japanese plot0_fa652eb1:



    voice "voice/tianqin_103.ogg"
    tianqin "자오쯔, 벌써 돌아가고 싶어? 지금 몇 시지…"


translate japanese plot0_8d746892:



    voice "voice/tianqin_104.ogg"
    tianqin "어디 보자, 지금…… 열 시가 넘었네. 슬슬 돌아갈까."


translate japanese plot0_9e7f6137:



    voice "voice/tianqin_105.ogg"
    tianqin "내일은 학교도 가야 하니까 오늘은 여기까지 하자."


translate japanese plot0_e6d67457:



    voice "voice/jiaozi_18.ogg"
    jiaozi 0101 "멍! 멍!"


translate japanese plot0_bd414cd3:



    voice "voice/tianqin_106.ogg"
    tianqin "어? 자오쯔, 또 뛰어가면——!"


translate japanese plot0_83e7a60f:



    voice "voice/jiaozi_19.ogg"
    jiaozi "멍우…… 멍우……"


translate japanese plot0_d3bd4ddd:



    voice "voice/tianqin_107.ogg"
    tianqin "자, 잠깐만 기다리라니까! 자오쯔—!"


translate japanese plot0_ea1039f6:



    voice "voice/tianqin_108.ogg"
    tianqin "어?"


translate japanese plot0_5f1f7159:


    "자오쯔를 뒤쫓아 라이라는 거리 끝까지 달려갔다. 그곳에는 더는 아무도 이용하지 않는 작은 공원이 있었다."


translate japanese plot0_5f3d20f6:


    "희미한 가로등 불빛 아래서, 라이라는 공터에 누군가 앉아 있는 것을 발견했다."


translate japanese plot0_eafced5f:


    "次の瞬間、天琴はその人影と目が合った。"


translate japanese plot0_f774c67c:



    voice "voice/tianqin_109.ogg"
    tianqin 0213 "（어……? 여자아이?）"


translate japanese plot0_aa4c8024:


    "열 살 남짓 되어 보이는 소녀는 몹시 쇠약한 모습이었다."


translate japanese plot0_819d5105:


    "その服装も印象的だった――尖った帽子で頭をすっぽり隠し、体にはサイズの合わない、長くてゆったりしたローブを羽織っている。。"


translate japanese plot0_2c0c81ce:


    "마치 애니메이션 행사에서 돌아오는 코스프레 참가자 같았다."


translate japanese plot0_176f02dd:



    voice "voice/cygnus_01.ogg"
    cygnusnameless 0204 "——!"


translate japanese plot0_61e5f0cc:


    "라이라를 본 소녀는 조금 어이없다는 듯한 표정을 지었다."


translate japanese plot0_a984449b:



    voice "voice/tianqin_110.ogg"
    tianqin 0203 "저기…… 괜찮아?"


translate japanese plot0_42ed82e0:



    voice "voice/cygnus_02.ogg"
    cygnusnameless 0206 "……"


translate japanese plot0_f12ee48b:


    "少女は何かを言おうと唇を動かしたが、その声は天琴には届かなかった。"


translate japanese plot0_72f7e24b:



    voice "voice/jiaozi_20.ogg"
    jiaozi 0101 "멍멍!" with Shake((0, 0, 0, 0), 0.5, dist=5)


translate japanese plot0_c5288e09:


    tianqin 0203 "쉿! 놀라게 하지 마."


translate japanese plot0_1681c7f7:


    "少女は餃子の声を気にすることもなく、じっと天琴を見つめ続けた。"


translate japanese plot0_c485c67c:


    tianqin 0202 "저기, 괜찮아? 도와줄까?"


translate japanese plot0_911a08cb:



    voice "voice/cygnus_03.ogg"
    cygnusnameless 0206 "……하……인……"


translate japanese plot0_d9dd576b:



    voice "voice/tianqin_113.ogg"
    tianqin 0214 "뭐?"


translate japanese plot0_c33ae881:


    "소녀는 영문 모를 말을 한마디 하고는 그대로 무너지듯 쓰러졌다."


translate japanese plot0_c6cfc9fd:



    voice "voice/tianqin_114.ogg"
    tianqin 0213 "잠깐!? 괜찮아!?"


translate japanese plot0_4f311d9c:


    "返事はない。少女は地面に座ったまま眠ってしまった。"


translate japanese plot0_98bf7e63:



    voice "voice/tianqin_115.ogg"
    tianqin 0210 "……뭐, 뭐야, 이건……?"




translate japanese plot0_d3bd4778:


    nvlNone "철이 든 뒤로,\n언니가 처음 나를 데리고 놀러 나간 날이었다."


translate japanese plot0_f128d37d:


    nvlNone "아마 네댓 살쯤이었을 것이다."


translate japanese plot0_337de871:


    nvlNone "동네 공원에는,\n나와 비슷한 또래의 아이들이 잔뜩 모여 있었다."


translate japanese plot0_b4bc314e:


    nvlNone "숨바꼭질을 하기도 하고, 술래잡기를 하기도 했다."


translate japanese plot0_e747284e:


    nvlNone "그전까지 나는 줄곧 집에서 언니와 함께 지냈고,\n집 밖으로는 한 발짝도 나가 본 적이 없었다."


translate japanese plot0_f641d53b:


    nvlNone "다른 아이들은 부모님이 지켜보고 있었지만,"


translate japanese plot0_77c465bd:


    nvlNone "내 곁에는 겨우 두 살 위인 언니뿐이었다."


translate japanese plot0_6f6a0647:


    nvlNone "어른들이 다가와,"


translate japanese plot0_78b94a90:


    nvlNone "처음으로 낯선 사람이 말을 걸자 나는 잔뜩 겁을 먹었다.{p}마치 적이라도 만난 듯 언니 등 뒤에 매달렸다."


translate japanese plot0_6b79f596:



    voice "voice/npc_00003.ogg"
    nvlNone "「하하, 아주 의젓한 언니구나.」"


translate japanese plot0_b1df1e7b:


    nvlNone "시간이 지나면서 긴장도 조금씩 풀렸다."


translate japanese plot0_c90ff1bb:


    nvlNone "그러자 다른 아이들이\n가지고 노는 것에 관심이 생겼다."


translate japanese plot0_775b1b56:


    nvlNone "그런데도 나는 달려 나갔다."


translate japanese plot0_359333b4:


    nvlNone "공원 한구석에서 다른 구석까지——그래 봐야 아주 짧은 거리였다."


translate japanese plot0_0e1f929a:


    nvlNone "조금 토라졌을 뿐이라,"


translate japanese plot0_a8a0fbca:



    voice "voice/npc_0006.ogg"
    nvlNone "「저, 저쪽 나무!」"


translate japanese plot0_d41d8cd9:


    voice "voice/npc_0007.ogg"


translate japanese plot0_d41d8cd9_1:


    voice "voice/tianqin_0008.ogg"


translate japanese plot0_86fc7dda:


    nvlNone "내 움직임에 또래 아이들은 눈을 동그랗게 떴다."


translate japanese plot0_96cab201:


    nvlNone "미끈거리는 액체가 손에 잔뜩 묻고,\n얼굴과 옷에도 튀었다."


translate japanese plot0_a2903a36:


    nvlNone "머릿속이 뚝 끊기듯 새하얘졌다."


translate japanese plot0_a485ee87:


    nvlNone "아이들은 하나같이 겁에 질려 나를 바라봤다."


translate japanese plot0_d41d8cd9_2:


    voice "voice/tianqin_03.ogg"


translate japanese plot0_d41d8cd9_3:


    voice "voice/yangxi_03.ogg"


translate japanese plot0_c68fd631:


    "동전이 들어가자마자 기계에서 어린애 취향의 음악이 흘러나왔다."


translate japanese plot0_67132533:


    "요즘 유행하는 애니메이션 『선글라스 돼지』의 삽입곡——바로 저 인형의 캐릭터송이었다."


translate japanese plot0_d41d8cd9_4:


    voice "voice/tianqin_06.ogg"


translate japanese plot0_d41d8cd9_5:


    voice "voice/tianqin_09.ogg"


translate japanese plot0_49a427da:


    "화려한 「낚시 기술」은 필요 없었다. 그저 시간이 흘러 집게가 저절로 내려가기를 기다릴 뿐이었다."


translate japanese plot0_d41d8cd9_6:


    voice "voice/npc1_01.ogg"


translate japanese plot0_d41d8cd9_7:


    voice "voice/tianqin_27.ogg"


translate japanese plot0_7f4de487:


    "반면 히나타 앞의 음료는——누가 봐도 「평범」하지 않았다."


translate japanese plot0_c281691c:


    "산처럼 수북하게 올라간 밀크폼만으로도 눈길을 사로잡기에 충분했다."


translate japanese plot0_d41d8cd9_8:


    voice "voice/tianqin_30.ogg"


translate japanese plot0_d41d8cd9_9:


    voice "voice/tianqin_35.ogg"


translate japanese plot0_d41d8cd9_10:


    voice "voice/tianqin_40.ogg"


translate japanese plot0_b9e309c4:


    "물론 빠진 날이 하도 많아 전부 기억할 수는 없었다. 지금 나온 숫자는 어디까지나 가장 낙관적인 결과였다."


translate japanese plot0_d41d8cd9_11:


    voice "voice/tianqin_43.ogg"


translate japanese plot0_d290f7d0:


    "학교에 가는 것은 원래 학생의 의무지만, 라이라는 당당하게 땡땡이를 친다. 이 「유토리 교육 정책」이 장려되는 덕분이다."


translate japanese plot0_4452f8e8:


    "일정 출석률만 유지하면 학교는 학생의 학습에 지나치게 간섭하지 않는다."


translate japanese plot0_9ff6fff1:


    "사실 라이라는 크게 걱정할 필요가 없었다. 수업은 자주 빠져도 성적이 나쁜 편은 아니었다."


translate japanese plot0_7cffe2cb:


    "시험 직전에 조금만 벼락치기를 하면 상당히 좋은 점수를 받았기에, 반 친구들은 그런 학습 능력을 무척 부러워했다."


translate japanese plot0_02392cc2:


    "「제대로 공부하면 학년 10등 안에 드는 건 식은 죽 먹기겠는데…」"


translate japanese plot0_16759579:


    "그런데도 가볍게 해낼 수 있는 것은, 태어날 때부터 조금 특별했던 체질 덕분이었다."


translate japanese plot0_18a1ee07:



    voice "voice/tianqin_50.ogg"
    tianqin "응? 비가 오려나?"


translate japanese plot0_cb0b2d52:


    "사실 이 도시의 고등학생들은 결코 편하게 지내지 않는다. 유토리 교육의 영향 아래에서도,"


translate japanese plot0_2c9cb5bd:


    "수업, 교우 관계, 성적 경쟁…… 사춘기를 갓 벗어난 고등학생들은 날마다 갖가지 벽에 부딪히고 있다."


translate japanese plot0_b5ee7e98:


    "잠시 만지작거리던 라이라는 휴대폰을 옆에 놓았다."


translate japanese plot0_ee10ddb1:


    "이 아파트 주민들이 몰래 밖에서 돌보며 풀어 기르는 모양이었다."


translate japanese plot0_8bf16353:


    "가끔 취객이 근처에서 큰 소리로 노래를 부르긴 해도 참을 만한 수준이었다."


translate japanese plot0_1b3bc408:


    "그 밖의 장소들은 대체로 고요했다."


translate japanese plot0_d41d8cd9_12:


    voice "voice/tianqin_72.ogg"


translate japanese plot0_4668cf20:


    "집 근처인데도 아직 모르는 길이 많다——그런 작은 발견은 마치 보물찾기처럼 느껴졌다."


translate japanese plot0_75bc3af7:


    "자오쯔는 신이 나서 라이라 주위를 빙빙 돌았다. 어디로 데려가든 즐거워 보였다."


translate japanese plot0_fad44a6e:


    "희미한 가로등 아래서 라이라는 가게 입구에 세워진 간판에 눈길을 주었다."


translate japanese plot0_e77ab929:


    "그다음 순간, 그 사람과 눈이 마주쳤다."


translate japanese plot0_d5fd02cb:


    "차림새도 인상적이었다――뾰족한 모자로 머리를 푹 가리고, 몸에 맞지 않는 길고 헐렁한 로브를 걸치고 있었다."


translate japanese plot0_3910faf2:


    "소녀는 무언가 말하려 입술을 움직였지만, 라이라에게는 그 목소리가 들리지 않았다."


translate japanese plot0_fd4266cb:


    "소녀는 자오쯔의 소리에도 아랑곳하지 않고 라이라를 계속 빤히 바라보았다."


translate japanese plot0_ce379d0f:


    "대답은 없었다. 소녀는 바닥에 앉은 채로 잠들어 버렸다."
